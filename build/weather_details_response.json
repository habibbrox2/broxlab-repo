<script src="https://js.puter.com/v2/"></script>
<script type="module" src="/assets/ai-assistant/core/cache.js?v=1777022848"></script>
<script type="module" src="/assets/ai-assistant/core/cache-debug.js?v=1777022165"></script>
<script type="module" src="/ai/dist/assistant.js?v=1779202442"></script>
    
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Handle language toggle clicks
    const languageLinks = document.querySelectorAll('a[href*=\"?lang=\"]');
    languageLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            const url = new URL(this.href, window.location.origin);
            const newLang = url.searchParams.get('lang');
            if (!newLang) return;

            // Perform dynamic translation instead of page reload
            translatePageToLanguage(newLang).then(() => {
                // Update URL without reload
                const currentUrl = new URL(window.location.href);
                currentUrl.searchParams.set('lang', newLang);
                window.history.pushState({}, '', currentUrl.toString());

                // Sync site and chat language if available
                if (window.broxI18n?.setLanguage) {
                    window.broxI18n.setLanguage(newLang);
                }
                if (window.syncChatLanguage) {
                    window.syncChatLanguage(newLang);
                }

                // Update language display
                updateLanguageDisplay(newLang);
            }).catch(error => {
                console.error('Translation failed:', error);
                // Fallback to page reload
                window.location.href = this.href;
            });
        });
    });

    // Function to dynamically translate the page
    async function translatePageToLanguage(targetLang) {
        const translationCache = window.__broxClientTranslationCache = window.__broxClientTranslationCache || {};

        // Collect all translatable elements
        const translatableElements = document.querySelectorAll('[data-i18n], [data-i18n-title], [data-i18n-aria-label]');
        if (translatableElements.length === 0) {
            return; // No elements to translate
        }

        const itemsByText = {};
        const originalItems = [];

        const applyTranslation = (item, translated) => {
            if (item.attribute === 'textContent') {
                item.element.textContent = translated;
            } else if (item.attribute === 'title') {
                item.element.setAttribute('title', translated);
            } else if (item.attribute === 'ariaLabel') {
                item.element.setAttribute('aria-label', translated);
            }
        };

        const buildCacheKey = (text) => `${targetLang}::${text}`;

        translatableElements.forEach(el => {
            if (el.hasAttribute('data-i18n')) {
                const originalText = el.getAttribute('data-i18n');
                if (originalText && originalText.trim()) {
                    originalItems.push({ element: el, text: originalText.trim(), attribute: 'textContent' });
                }
            }
            if (el.hasAttribute('data-i18n-title')) {
                const originalText = el.getAttribute('data-i18n-title');
                if (originalText && originalText.trim()) {
                    originalItems.push({ element: el, text: originalText.trim(), attribute: 'title' });
                }
            }
            if (el.hasAttribute('data-i18n-aria-label')) {
                const originalText = el.getAttribute('data-i18n-aria-label');
                if (originalText && originalText.trim()) {
                    originalItems.push({ element: el, text: originalText.trim(), attribute: 'ariaLabel' });
                }
            }
        });

        if (originalItems.length === 0) {
            return;
        }

        originalItems.forEach(item => {
            const cacheKey = buildCacheKey(item.text);
            if (translationCache[cacheKey]) {
                applyTranslation(item, translationCache[cacheKey]);
            } else {
                itemsByText[item.text] = itemsByText[item.text] || [];
                itemsByText[item.text].push(item);
            }
        });

        const textsToTranslate = Object.keys(itemsByText);
        if (textsToTranslate.length === 0) {
            return;
        }

        const batchSize = 10;
        for (let i = 0; i < textsToTranslate.length; i += batchSize) {
            const batch = textsToTranslate.slice(i, i + batchSize);

            try {
                const response = await fetch('/api/translate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        texts: batch,
                        from: 'en',
                        to: targetLang
                    })
                });

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const result = await response.json();
                if (result.success && result.translations) {
                    batch.forEach(original => {
                        const translated = result.translations[original] || original;
                        const cacheKey = buildCacheKey(original);
                        translationCache[cacheKey] = translated;
                        const items = itemsByText[original] || [];
                        items.forEach(item => applyTranslation(item, translated));
                    });
                }
            } catch (error) {
                console.warn('Failed to translate batch:', batch, error);
            }
        }
    }

    // Function to update language display in the dropdown
    function updateLanguageDisplay(lang) {
        const langDisplay = document.querySelector('.brox-language-toggle .dropdown-toggle');
        if (langDisplay) {
            langDisplay.innerHTML = lang === 'bn' ? 'বাংলা' : 'EN';
        }
    }
});
</script>

</body>
