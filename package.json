{
  "name": "broxlab-frontend-build",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build:css": "node build/esbuild-css.mjs",
    "build:js": "node build/esbuild.config.js",
    "build:ai": "node build/esbuild-ai.mjs",
    "watch:ai": "node build/esbuild-ai.mjs --watch",
    "build:assistants": "node build/esbuild-assistants.mjs",
    "build:firebase:v2": "node build/esbuild-firebase.mjs",
    "build:rte": "node build/esbuild-rte.mjs",
    "build:app:dist": "node build/esbuild.config.js",
    "build": "npm run build:css && npm run build:js && npm run build:ai",
    "build:prod": "npm run build:css && npm run build:js && npm run build:ai && npm run build:rte && npm run build:assistants && npm run build:firebase:v2",
    "dev": "npm run build:css && npm run build:js && npm run build:ai",
    "dev:rte": "node build/esbuild-rte.mjs",
    "lint": "eslint public_html/assets/js/",
    "type-check": "node node_modules/typescript/bin/tsc -p build/tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "validate": "npm run lint --if-present && npm run type-check --if-present && npm test --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.41",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "lucide": "^1.3.0",
    "lucide-static": "^1.16.0",
    "playwright": "^1.60.0"
  }
}
