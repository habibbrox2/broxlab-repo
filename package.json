{
  "name": "BroxLab",
  "version": "2.0.0",
  "description": "Bengali-first mobile tech platform",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "npx npm-run-all --parallel dev:firebase:v2 dev:tailwind dev:app:dist",
    "build": "npm run clean:build && npx npm-run-all --sequential build:firebase:v2 build:app:dist build:css build:tailwind",
    "build:prod": "npm run clean:build && npx npm-run-all --sequential build:firebase:v2:prod build:app:dist build:css:prod build:tailwind && npm run check:assets",
    "build:css": "node build/esbuild-css.mjs --dev",
    "build:css:prod": "node build/esbuild-css.mjs",
    "serve": "serve public_html -l 8000",
    "lint": "eslint --no-error-on-unmatched-pattern --config build/eslint.config.cjs \"public_html/assets/js/**/*.js\" \"public_html/assets/firebase/v2/**/*.js\" \"public_html/assets/ai-assistant/**/*.js\" \"build/Scripts/**/*.mjs\" \"build/esbuild.config.js\" \"build/esbuild-firebase.mjs\"",
    "test": "vitest --config build/vitest.config.ts",
    "test:run": "vitest run --config build/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config build/vitest.config.ts",
    "e2e": "playwright test --config build/playwright.config.ts",
    "loadtest": "k6 run tests/load/loadtest.js",
    "node:start": "tsx src/index.ts",
    "ai-assistant": "npm run node:start",
    "ai-assistant:dev": "tsx watch src/index.ts",
    "rag:start": "npm run node:start",
    "rag:process": "npm run node:start -- --process",
    "rag:search": "npm run node:start -- --search",
    "nodes:start": "pm2 delete broxlab-node 2>nul || echo. && pm2 start src/ecosystem.config.cjs && pm2 save",
    "nodes:stop": "pm2 stop broxlab-node",
    "nodes:restart": "pm2 restart broxlab-node",
    "all:start": "npm run nodes:start",
    "reverse-proxy": "node src/reverse-proxy.js",
    "load-balancer": "node src/load-balancer.js",
    "servers:same-port": "node scripts/same-port-setup.js setup",
    "clean:build": "node -e \"require('fs').rmSync('public_html/assets/firebase/v2/dist', { recursive: true, force: true }); require('fs').rmSync('public_html/assets/ai-assistant/dist', { recursive: true, force: true }); require('fs').rmSync('public_html/assets/js/dist', { recursive: true, force: true })\"",
    "build:firebase:v2": "npm run clean:firebase:v2:dist && node build/esbuild-firebase.mjs",
    "build:firebase:v2:prod": "npm run clean:firebase:v2:dist && node build/esbuild-firebase.mjs --minify",
    "clean:firebase:v2:dist": "node -e \"require('fs').rmSync('public_html/assets/firebase/v2/dist', { recursive: true, force: true })\"",
    "dev:firebase:v2": "npm run clean:firebase:v2:dist && node build/esbuild-firebase.mjs --watch",
    "dev:app:dist": "node build/esbuild.config.js --target=app --watch --dev",
    "build:app:dist": "node build/esbuild.config.js --target=app",
    "dev:tailwind": "tailwindcss -c build/tailwind.config.js -i ./public_html/assets/css/tailwind-input.css -o ./public_html/assets/css/tailwind.css --watch",
    "build:tailwind": "tailwindcss -c build/tailwind.config.js -i ./public_html/assets/css/tailwind-input.css -o ./public_html/assets/css/tailwind.css --minify",
    "check:assets": "npm run naming:check -- --changed && npm run check:duplicates && npm run check:firebase:dist",
    "naming:check": "node build/Scripts/check-naming-conventions.mjs",
    "check:duplicates": "node build/Scripts/check-asset-duplicates.mjs",
    "check:firebase:dist": "node build/Scripts/check-firebase-dist-chunks.mjs"
  },
  "keywords": [
    "firebase",
    "fcm",
    "notifications",
    "auth",
    "pwa"
  ],
  "author": "BroxLab Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.86.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@google/generative-ai": "^0.24.1",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.2",
    "fastify": "^5.8.4",
    "firebase": "^12.9.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^2.0.9",
    "ioredis": "^5.10.0",
    "load-balancers": "^1.0.2",
    "marked": "^15.0.0",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0",
    "openai": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.9.155",
    "pino": "^8.19.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "sharp": "^0.33.5",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.0",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.11.24",
    "esbuild": "^0.27.3",
    "eslint": "^9.0.0",
    "globals": "^15.14.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "serve": "^14.2.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "not IE 11"
  ],
  "overrides": {
    "@langchain/core": "^1.1.33",
    "sharp": "^0.33.5",
    "picomatch": "^4.0.4"
  }
}
