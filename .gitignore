# ═══════════════════════════════════════════════════════════════════╗
# ║                    PROJECT .gitignore                            ║
# ║          GitHub Webhook → Enterprise Auto Deploy System          ║
# ═══════════════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────────────────────────────
#  1. DEPENDENCIES
# ─────────────────────────────────────────────────────────────────
/vendor/
/node_modules/

# ─────────────────────────────────────────────────────────────────
#  2. ENVIRONMENT & SECRETS
# ─────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.sample

# Firebase & Service Configs (secrets)
/Config/broxlab-firebase.json

# ─────────────────────────────────────────────────────────────────
#  3. LOGS & CACHE (development only)
# ─────────────────────────────────────────────────────────────────
*.log
/logs/
/cache/
/storage/logs/
/storage/cache/
/storage/tmp/
/storage/backups/
/storage/logs/deploy_jobs/
.tmp.*

# Uploads (user-generated content)
/uploads/
/public_html/uploads/
/public_html/assets/uploads/

# Database dumps/backups
/Database/
/*.sql

# Secrets / service configs
/Config/broxlab-firebase.json

# IDE / OS
/.vscode/
/.idea/
.DS_Store
Thumbs.db

# Archives
*.zip

# ============================================
# Deployment related (for development only)
# ============================================

# Temporary deployment scripts generated by the system
/deploy_*.ps1
/deploy_*.sh
/deploy_*.bat
/deploy_*.cmd

# Lock files for deployment
/deploy_lock.json
/deploy_ratelimit_*.json

# Progress files
/deploy_progress_*.json

# Backup files created during deployment
/backups/
public_html/backups/

# Deploy worker logs
/deploy_worker*.log

# ===========================================
# Webhook Deployment Files
# ===========================================

# Core webhook files (TRACKED - include in git)
!public_html/webhook/github.php      # Advanced webhook (database-based)      
!public_html/webhook/deploy.php       # Simple webhook (config-based)
!public_html/webhook/*.json           # Webhook settings

# Sensitive files (IGNORED - DO NOT commit)
!public_html/webhook/deploy_config.php # Contains DB passwords, secrets       
public_html/webhook/deploy.log        # Deployment logs

# Migration files
migrations/
# ===========================================
# Scripts folder - Keep core scripts, ignore generated
# ===========================================

# Ignore output files but keep core scripts
scripts/output/
scripts/temp/
scripts/logs/

# IDE specific in scripts
scripts/.idea/
scripts/.vscode/
# ─────────────────────────────────────────────────────────────────
#  4. USER UPLOADS (keep schema, ignore content)
# ─────────────────────────────────────────────────────────────────
>>>>>>> ai-sys
/uploads/
/public_html/uploads/
/public_html/assets/uploads/

# ─────────────────────────────────────────────────────────────────
#  5. BUILD ARTIFACTS
# ─────────────────────────────────────────────────────────────────
#/build/
#**/dist/
/.deploy/

# ─────────────────────────────────────────────────────────────────
#  6. IDE & OS FILES
# ─────────────────────────────────────────────────────────────────
/.vscode/
/.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ─────────────────────────────────────────────────────────────────
#  7. ARCHIVES
# ─────────────────────────────────────────────────────────────────
*.zip

# ═══════════════════════════════════════════════════════════════════╗
# ║              DEPLOYMENT SYSTEM (GitHub Webhook)                 ║
# ═══════════════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────────────────────────────
# Deployment Directories (Generated at runtime)
# ─────────────────────────────────────────────────────────────────
/deploys/                          # All deployment releases & cache
/deploy_lock
/deploy.last
sys_temp_dir/deploy*               # Temp lock files

# ─────────────────────────────────────────────────────────────────
# Deployment Config Files (contains secrets - DO NOT COMMIT)
# ─────────────────────────────────────────────────────────────────
scripts/.deploy-config
.deploy-config

# ─────────────────────────────────────────────────────────────────
# Webhook Core Files (TRACKED - very important!)
# ─────────────────────────────────────────────────────────────────
public_html/github.php
public_html/deploy_config.php

version_file.json                   # Version tracking (generated at runtime)

# ─────────────────────────────────────────────────────────────────
# Database Schema (TRACKED - required for git)
# ─────────────────────────────────────────────────────────────────
!Database/
!Database/*.sql

# Database Backups (generated during deploy, not tracked)
/Database/backups/
*.sql.backup

# ─────────────────────────────────────────────────────────────────
# Migrations (TRACKED - required for git)
# ─────────────────────────────────────────────────────────────────
!migrations/
!migrations/*.sql

# Migration status tracking (generated at runtime)
/migrations/.status

# ─────────────────────────────────────────────────────────────────
# SCRIPTS FOLDER
# ─────────────────────────────────────────────────────────────────
/scripts/output/
/scripts/temp/
/scripts/logs/
/scripts/.idea/
/scripts/.vscode/

# ─────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────
/Database/
db.sql

# ─────────────────────────────────────────────────────────────────
# Composer
# ─────────────────────────────────────────────────────────────────
composer.lock
package-lock.json

# ═══════════════════════════════════════════════════════════════════╗
# ║              Local development files                             ║
# ═══════════════════════════════════════════════════════════════════╝
.DS_Store
/tmp/
/temp/
