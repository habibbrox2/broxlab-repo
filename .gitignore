# ═══════════════════════════════════════════════════════════════════╗
# ║                    PROJECT .gitignore                            ║
# ║          GitHub Webhook → Enterprise Auto Deploy System          ║
# ───────────────────────────────────────────────────────────────────
# IMPORTANT: This file protects sensitive server data from being pushed to git
# Includes: secrets, database backups, user data, logs, cache, uploads
# ═══════════════════════════════════════════════════════════════════╝
# Test commit for deploy action
# Another test

# ─────────────────────────────────────────────────────────────────
#  1. DEPENDENCIES (Generated, not committed)
# ─────────────────────────────────────────────────────────────────
/vendor/
/node_modules/

yarn.lock

# ─────────────────────────────────────────────────────────────────
#  2. ENVIRONMENT & SECRETS - CRITICAL
# ─────────────────────────────────────────────────────────────────
# Never commit environment variables or credentials
.env
.env.*
!.env.example
!.env.sample
.env.local
.env.*.local

# API Keys and Service Credentials
/Config/broxlab-firebase.json
/Config/firebase-*.json
/Config/*.key
/Config/*.pem
/config/*.key
/config/*.pem

# SSH Keys
*.pem
*.ppk
*.key
id_rsa*
id_dsa*

# ─────────────────────────────────────────────────────────────────
#  3. DATABASE BACKUPS & DUMPS - CRITICAL
# ─────────────────────────────────────────────────────────────────
# Database backups contain sensitive production data
*.sql
*.sql.gz
*.sql.bak
*.sql.backup
*.db
*.sqlite
*.sqlite3
/Database/
/database_backups/
/backups/database/
/app/shared/backups/database/
*.database

# ─────────────────────────────────────────────────────────────────
#  4. RELEASE BACKUPS & DEPLOYMENT DATA
# ─────────────────────────────────────────────────────────────────
# Deployment releases (kept on production server only)
/releases/
/app/releases/
/app/releases_archive/
/app/current/
*.tar.gz
*.tgz
*.tar
*.zip

# Deployment backups (release snapshots)
/backups/
/app/backups/
/app/shared/backups/
backup_*.tar.gz
rollback_backup_*.tar.gz

# ─────────────────────────────────────────────────────────────────
#  5. LOGS & CACHE - SENSITIVE DATA
# ─────────────────────────────────────────────────────────────────
# Log files contain sensitive information (IPs, errors, traces)
*.log
*.log.*
/logs/
/storage/*
/storage/
/storage/logs/
/storage/cache/
/storage/tmp/
/storage/backups/
/cache/
/tmp/
/build/cache/

# Deployment logs
deployment.log
/app/shared/deployment.log
/app/shared/logs/

# ─────────────────────────────────────────────────────────────────
#  6. USER UPLOADS & GENERATED FILES
# ─────────────────────────────────────────────────────────────────
# User-generated content (images, files, documents)
/uploads/
/public_html/uploads/
/public_html/assets/uploads/
/app/shared/uploads/
/storage/uploads/

# Temporary files
*.tmp
.tmp.*
tmp/
temp/

# ─────────────────────────────────────────────────────────────────
#  7. RAG SYSTEM & PYTHON ENVIRONMENT (For production)
# ─────────────────────────────────────────────────────────────────
# Python virtual environments are server-specific
/rag_env/
/app/shared/rag_env/
/venv/
/env/
/.venv/
/python_env/

# RAG system cache and data
/py_system/cache/
/py_system/data/
/py_system/__pycache__/
/py_system/**/__pycache__/
*.pyc

# Legacy - kept for reference
/rag_system/
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ─────────────────────────────────────────────────────────────────
#  8. IDE & OS SPECIFIC FILES
# ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.project
.classpath
.c9/
*.sublime-workspace
.history/
.continue/
.kilocode/
.roo/

# ─────────────────────────────────────────────────────────────────
#  9. GENERATED ASSETS (Edit sources, run build - don't commit dist)
# ─────────────────────────────────────────────────────────────────
# These are generated by build process - only commit sources
/public_html/assets/**/dist/
/public_html/assets/js/dist/
/public_html/assets/css/dist/
/public_html/assets/firebase/**/dist/
dist/
/src/css/dist/
/src/js/dist/

# ─────────────────────────────────────────────────────────────────
#  10. DEPLOYMENT SCRIPTS OUTPUT (Temporary generation)
# ─────────────────────────────────────────────────────────────────
/deploy_*.ps1
/deploy_*.sh
/deploy_*.bat
/deploy_*.cmd
deploy_lock.json
deploy_ratelimit_*.json
deploy_progress_*.json

# ─────────────────────────────────────────────────────────────────
#  11. VERSION TRACKING & BUILD ARTIFACTS
# ─────────────────────────────────────────────────────────────────
/version*.json
version.json
version.txt
/app/shared/version.json

# Build artifacts
build/
dist/
.next/
out/

# ─────────────────────────────────────────────────────────────────
#  12. TESTING & COVERAGE
# ─────────────────────────────────────────────────────────────────
coverage/
.coverage
.phpunit.result.cache
phpunit.xml
jest.config.js.bak

# ─────────────────────────────────────────────────────────────────
#  13. LOCAL DEVELOPMENT ONLY (Never push)
# ─────────────────────────────────────────────────────────────────
.env.development
.env.test
.env.local
.docker-compose.override.yml
docker-compose.override.yml
Makefile.local
*.local.*

# ─────────────────────────────────────────────────────────────────
#  14. SYSTEM & RUNTIME FILES
# ─────────────────────────────────────────────────────────────────
# Node.js
.npm
npm-debug.log*
.node_repl_history

# PHP
.php_cs.cache
.phpstan.cache
.psalm.cache

# Python
.pytest_cache
.mypy_cache
.dmypy.json

# Git
.git/
.gitmodules

# ─────────────────────────────────────────────────────────────────
#  EXCEPTIONS (Files/Folders to ALWAYS commit)
# ─────────────────────────────────────────────────────────────────
# Even though above rules might match these, always keep them:

# Configuration Examples (safe for git)
!.env.example
!.env.sample
!.env.docker
!.env.ci

# Documentation
!docs/
!README.md
!SECURITY.md

# Build tools configuration (sources, not compiled)
!build/
!build/*.config.js
!build/*.mjs
!build/tailwind.config.js
!build/eslint.config.cjs

# Database schema files (for reference, not data)
!Database/*.sql

# Source code (keep everything in source directories)
!src/
!app/
!Config/
!public_html/

# ───────────────────────────────────────────────────────────────────
#  15. COMPLETE WEB-HOST REMOVAL FROM GIT
# ───────────────────────────────────────────────────────────────────
# web-host/ folder contains cPanel/server-specific files
# These files are now kept LOCAL ONLY and NEVER pushed to GitHub
# To restore any file to GitHub, remove the web-host/ entry below
/web-host/

# Exception: Keep these in web-host/
# - web-host/scripts/*.sh (deployment scripts)
# - web-host/.github/workflows/ (CI/CD)
# - web-host/DEPLOYMENT_SCRIPTS_GUIDE.md (documentation)
!/web-host/
!/web-host/scripts/
!/web-host/scripts/*.sh
!/web-host/.github/
!/web-host/.github/**
!/web-host/DEPLOYMENT_SCRIPTS_GUIDE.md
# ───────────────────────────────────────────────────────────────────
# ⚠️  NEVER COMMIT:
#   - .env files (use .env.example instead)
#   - Database backups (*.sql, *.sql.gz)
#   - Database credentials
#   - API keys or secret tokens
#   - SSH private keys
#   - Firebase service account files
#   - User uploads
#   - Production logs
#   - Cache files
#
# ✅ DO COMMIT:
#   - Source code (app/, src/, Config/, public_html/)
#   - Configuration examples (.env.example)
#   - Documentation (docs/, README.md)
#   - Build configuration (build/*.config.js)
#   - Dependencies metadata (package.json, composer.json)
#
# Check with: git status --porcelain
# Remember: This .gitignore is your first line of defense against accidentally exposing sensitive data. Always double-check before committing! 🔒