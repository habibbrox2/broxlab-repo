{% extends 'layout.twig' %}

{% block title %}{% if code %}{{ code }} {% endif %}{{ 'Error'|trans }} - {{ app_settings.site_name|default('BroxBhai') }}{% endblock %}

{% block meta_description %}{% if code == 404 %}{{ 'Page not found. The requested URL was not found on this server.'|trans }}{% elseif code == 403 %}{{ 'Access denied. You do not have permission to access this resource.'|trans }}{% elseif code == 500 %}{{ 'Internal server error. Something went wrong on our end.'|trans }}{% else %}{{ 'An error occurred while processing your request.'|trans }}{% endif %}{% endblock %}

{% block extra_head %}
{% if code in [403, 404, 500] %}
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
<meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
<meta name="bingbot" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
{% endif %}
{% endblock %}

{% block content %}
{% set c = code|default(500) %}
{% set meta = {
  403: { title: 'Access Denied'|trans, desc: 'You do not have permission to access this page.'|trans, icon: 'shield-alert' },
  404: { title: 'Page Not Found'|trans, desc: 'The page you requested could not be found.'|trans, icon: 'search-x' },
  500: { title: 'Server Error'|trans, desc: 'Something went wrong on our side. Please try again.'|trans, icon: 'server-crash' }
}[c]|default({ title: 'Unexpected Error'|trans, desc: 'An unexpected error occurred.'|trans, icon: 'triangle-alert' }) %}

<section class="relative overflow-hidden bg-slate-950 py-10 md:py-14 lg:py-20">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-indigo-500/30 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-cyan-400/20 blur-3xl"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.10),transparent_45%)]"></div>
  </div>

  <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="overflow-hidden rounded-3xl border border-white/10 bg-white/95 shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-950 p-8 text-white md:p-10">
          <div class="absolute right-0 top-0 h-40 w-40 translate-x-10 -translate-y-10 rounded-full bg-indigo-400/20 blur-2xl"></div>
          <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-white/80">
            <span class="h-2 w-2 rounded-full bg-rose-400"></span>{{ meta.title }}
          </span>
          <div class="mt-5 text-7xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-indigo-200 via-fuchsia-200 to-cyan-200 md:text-8xl">{{ c }}</div>
          <div class="mt-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl border border-white/20 bg-white/10 text-indigo-100">
            <i class="lucide lucide-{{ meta.icon }} text-3xl" aria-hidden="true"></i>
          </div>
        </div>

        <div class="p-7 md:p-10">
          <h1 class="text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl">{{ meta.title }}</h1>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 md:text-base">{{ message|default(meta.desc) }}</p>

          {% if details is defined and details %}
          <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
            <div class="flex items-start gap-2">
              <i class="lucide lucide-circle-alert mt-0.5 text-amber-600" aria-hidden="true"></i>
              <p><strong>{{ 'Error Details:'|trans }}</strong> {{ details }}</p>
            </div>
          </div>
          {% endif %}

          <div class="mt-6 flex flex-wrap gap-3">
            <a href="{{ home_url|default('/') }}" class="inline-flex items-center gap-2 rounded-full bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700">
              <i class="lucide lucide-house"></i>{{ 'Go Home'|trans }}
            </a>
            <button type="button" onclick="history.back()" class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
              <i class="lucide lucide-arrow-left"></i>{{ 'Go Back'|trans }}
            </button>
          </div>
        </div>
      </div>
    </div>

    {% if c == 404 %}
    <div class="mt-6 space-y-4">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">{{ 'Search'|trans }}</p>
        <p class="mt-2 text-sm text-slate-600">{{ 'Can\'t find what you\'re looking for?'|trans }}</p>
        <form action="/search" method="get" class="mt-4 flex flex-col gap-3 sm:flex-row">
          <div class="relative flex-1">
            <i class="lucide lucide-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
            <input type="text" name="q" class="h-11 w-full rounded-full border border-slate-300 bg-slate-50 px-10 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/20" placeholder="{{ 'Search our website...'|trans }}" aria-label="{{ 'Search'|trans }}">
          </div>
          <button type="submit" class="inline-flex h-11 items-center justify-center rounded-full bg-indigo-600 px-6 text-sm font-semibold text-white transition hover:bg-indigo-700">{{ 'Search'|trans }}</button>
        </form>
      </div>

      <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
        <a href="/" class="rounded-2xl border border-slate-200 bg-white p-4 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300">
          <div class="mx-auto inline-flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-100 text-indigo-600"><i class="lucide lucide-house"></i></div>
          <p class="mt-2 text-sm font-semibold text-slate-700">{{ 'Home'|trans }}</p>
        </a>
        <a href="/contact" class="rounded-2xl border border-slate-200 bg-white p-4 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-cyan-300">
          <div class="mx-auto inline-flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-100 text-cyan-700"><i class="lucide lucide-mail"></i></div>
          <p class="mt-2 text-sm font-semibold text-slate-700">{{ 'Contact'|trans }}</p>
        </a>
        <a href="/about-us" class="rounded-2xl border border-slate-200 bg-white p-4 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-rose-300">
          <div class="mx-auto inline-flex h-11 w-11 items-center justify-center rounded-xl bg-rose-100 text-rose-700"><i class="lucide lucide-info"></i></div>
          <p class="mt-2 text-sm font-semibold text-slate-700">{{ 'About'|trans }}</p>
        </a>
        <a href="/sitemap" class="rounded-2xl border border-slate-200 bg-white p-4 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-amber-300">
          <div class="mx-auto inline-flex h-11 w-11 items-center justify-center rounded-xl bg-amber-100 text-amber-700"><i class="lucide lucide-map"></i></div>
          <p class="mt-2 text-sm font-semibold text-slate-700">{{ 'Sitemap'|trans }}</p>
        </a>
      </div>
    </div>
    {% endif %}

    {% if show_trace|default(false) and trace is defined and trace %}
    <div class="mt-6 overflow-hidden rounded-2xl border border-rose-300 bg-slate-950 shadow-xl">
      <div class="flex items-center gap-2 border-b border-rose-400/30 bg-rose-500/10 px-4 py-3 text-sm font-semibold text-rose-300">
        <i class="lucide lucide-bug"></i>Debug Information - Development Mode
      </div>
      <pre class="max-h-80 overflow-auto p-4 text-xs leading-6 text-slate-200"><code>{{ trace }}</code></pre>
    </div>
    {% endif %}
  </div>

  {% if c == 404 %}
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"WebPage","@id": {{ canonical_url|default(current_url)|json_encode }},"url": {{ canonical_url|default(current_url)|json_encode }},"name":"{{ c }} {{ 'Error'|trans }} - {{ app_settings.site_name|default('BroxBhai') }}","description": {{ ('Page not found. The requested URL ' ~ (canonical_url|default(current_url)) ~ ' was not found.')|json_encode }},"isPartOf": {"@type":"WebSite","@id": {{ url|json_encode }}
  },"mainEntity": {"@type":"SearchAction","target": {{ (url ~ '/search?q={search_term_string}')|json_encode }},"query-input":"required name=search_term_string"
  }
  }
  </script>
  {% endif %}
</section>
{% endblock %}

