{% extends "layout.twig" %}

{% block title %}Weather in {{ weather.current.location_name|default('Selected Location') }}{% endblock %}

{% block meta_description %}Current weather and {{ weather.forecast_days }}-day forecast for {{ weather.current.location_name }}. Temperature, humidity, wind, and conditions.{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ asset('assets/css/weather.css') }}">
{% endblock %}

{% block content %}
<div class="container py-5">
    {# Breadcrumb #}
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ url }}">Home</a></li>
            <li class="breadcrumb-item"><a href="{{ path('weather.home') }}">Weather</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ weather.current.location_name|e }}</li>
        </ol>
    </nav>

    {# Header with Back Link #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold text-primary mb-1">
                <i class="bi bi-cloud-sun me-2"></i>Weather in {{ weather.current.location_name|e }}
            </h1>
            <p class="text-muted mb-0">
                Last updated: {{ 'now'|date('M d, Y h:i A') }}
            </p>
        </div>
        <a href="{{ path('weather.home') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Weather Home
        </a>
    </div>

    {# Alerts (if any) #}
    {% if weather.alerts is defined and weather.alerts|length > 0 %}
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Weather Alert:</strong>
            {% for alert in weather.alerts %}
                {{ alert.title|default('Weather warning') }} - {{ alert.description|default('') }}
            {% endfor %}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    {# Current Conditions Card #}
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary text-white py-3">
                    <h2 class="h5 mb-0"><i class="bi bi-info-circle me-2"></i>Current Conditions</h2>
                </div>
                <div class="card-body p-4">
                    {% include 'weather/partials/current-conditions.twig' with {weather: weather.current, location_name: weather.current.location_name, units: weather.units} %}
                </div>
            </div>
        </div>
    </div>

    {# Forecast Controls #}
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <h2 class="h4 fw-semibold mb-0">
                    <i class="bi bi-calendar-week me-2 text-info"></i>
                    {{ weather.forecast_days }}-Day Forecast
                </h2>
                <div class="d-flex gap-2">
                    {# Units toggle #}
                    <div class="btn-group" role="group" aria-label="Temperature units">
                        <a href="{{ path('weather.details') }}?location={{ location|url_encode }}&units=metric&forecast_days={{ weather.forecast_days }}"
                           class="btn btn-outline-primary btn-sm {{ units == 'metric' ? 'active' : '' }}">
                           °C
                        </a>
                        <a href="{{ path('weather.details') }}?location={{ location|url_encode }}&units=imperial&forecast_days={{ weather.forecast_days }}"
                           class="btn btn-outline-primary btn-sm {{ units == 'imperial' ? 'active' : '' }}">
                           °F
                        </a>
                    </div>
                    {# Forecast days selector #}
                    {% set dayOptions = [1,3,5,7] %}
                    <div class="btn-group" role="group" aria-label="Forecast days">
                        {% for d in dayOptions %}
                            <a href="{{ path('weather.details') }}?location={{ location|url_encode }}&units={{ units }}&forecast_days={{ d }}"
                               class="btn btn-outline-secondary btn-sm {{ weather.forecast_days == d ? 'active' : '' }}">
                                {{ d }}d
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Forecast Cards #}
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-{{ weather.forecast_days > 3 ? 4 : 3 }} g-4 mb-5">
        {% for day in weather.forecast %}
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small mb-2">
                            {{ day.date|date('l, M j') }}
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="me-3">
                                <i class="bi bi-{{ day.icon|replace({'d':'','n':''})|default('cloud') }} fs-2 text-primary"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="display-6 fw-bold text-dark">
                                    {{ day.temperature_day|round|int }}°
                                    <small class="fs-5 text-muted">{{ day.temperature_night|round|int }}°</small>
                                </div>
                                <div class="text-muted small">{{ day.description|title }}</div>
                            </div>
                        </div>
                        <div class="row text-center small text-muted">
                            <div class="col-4">
                                <i class="bi bi-droplet me-1"></i>{{ day.humidity }}%
                            </div>
                            <div class="col-4">
                                <i class="bi bi-wind me-1"></i>{{ day.wind_speed }} m/s
                            </div>
                            <div class="col-4">
                                <i class="bi bi-cloud-rain me-1"></i>{{ (day.pop * 100)|round }}%
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {# Hourly Forecast #}
    {% if weather.forecast[0].hourly is defined and weather.forecast[0].hourly|length > 0 %}
        <div class="row mb-5">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-info text-white py-3">
                        <h2 class="h5 mb-0"><i class="bi bi-clock me-2"></i>Hourly Forecast (Today)</h2>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Time</th>
                                        <th>Temperature</th>
                                        <th>Humidity</th>
                                        <th>Precipitation</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for hour in weather.forecast[0].hourly %}
                                        <tr>
                                            <td>{{ hour.time }}</td>
                                            <td>{{ hour.temp|round|int }}°</td>
                                            <td>{{ hour.humidity }}%</td>
                                            <td>{{ (hour.pop * 100)|round }}%</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# Cache Info #}
    {% if weather.request_metadata.cache_hit is defined %}
        <div class="text-center text-muted small">
            <i class="bi bi-clock-history me-1"></i>
            Data updated: {{ ('@' ~ weather.request_metadata.timestamp)|date('M j, Y g:i A') }}
        </div>
    {% endif %}
</div>
{% endblock %}

{% block extra_js %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Optional: enhance UI interactivity
});
</script>
{% endblock %}
