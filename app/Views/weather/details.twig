{% extends"layout.twig" %}

{% block title %}{{ 'Weather in'|trans }} {{ weather.current.location_name|default('Selected Location') }}{% endblock %}

{% block meta_description %}{{ 'Current weather and'|trans }} {{ weather.forecast_days }}-{{ 'day forecast for'|trans }} {{ weather.current.location_name }}. {{ 'Temperature, humidity, wind, and conditions.'|trans }}{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ asset('assets/css/weather.css') }}">
{% endblock %}

{% block content %}
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
 {# Breadcrumb #}
 <nav class="flex flex-wrap items-center gap-1 text-sm text-neutral-500 mb-4">
 <a href="{{ url }}" class="hover:text-neutral-700 transition-colors">{{ 'Home'|trans }}</a>
 <span class="text-neutral-300 mx-1">/</span>
 <a href="{{ path('weather.home') }}" class="hover:text-neutral-700 transition-colors">{{ 'Weather'|trans }}</a>
 <span class="text-neutral-300 mx-1">/</span>
 <span class="text-neutral-900 font-medium" aria-current="page">{{ weather.current.location_name|e }}</span>
 </nav>

 {# Header with Back Link #}
 <div class="flex items-center justify-between mb-4">
 <div>
 <h1 class="h2 font-bold text-indigo-600 mb-1">
 <i class="lucide lucide-cloud-sun mr-2" style="width:1.25em;height:1.25em;"></i>Weather in {{ weather.current.location_name|e }}
 </h1>
 <p class="text-neutral-500 mb-0">
 Last updated: {{ 'now'|date('M d, Y h:i A') }}
 </p>
 </div>
 <a href="{{ path('weather.home') }}" class="inline-flex items-center px-4 py-2 text-neutral-700 font-medium rounded-lg hover:bg-neutral-100 transition-colors">
 <i class="lucide lucide-arrow-left mr-1" style="width:1em;height:1em;"></i>{{ 'Back to Weather Home'|trans }}
 </a>
 </div>

 {# Alerts (if any) #}
 {% if weather.alerts is defined and weather.alerts|length > 0 %}
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 fade show" role="alert">
 <i class="lucide lucide-triangle-alert mr-2" style="width:1.25em;height:1.25em;"></i>
 <strong>Weather Alert:</strong>
 {% for alert in weather.alerts %}
 {{ alert.title|default('Weather warning') }} - {{ alert.description|default('') }}
 {% endfor %}
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition" data-brox-dismiss="alert" aria-label="Close"></button>
 </div>
 {% endif %}

 {# Current Conditions Card #}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-5">
 <div class="col-span-12">
 <div class="bg-white rounded-xl shadow-lg">
 <div class="px-5 py-3 bg-indigo-600 text-white rounded-t-xl">
 <h2 class="text-lg font-semibold mb-0"><i class="lucide lucide-info mr-2" style="width:1.25em;height:1.25em;"></i>{{ 'Current Conditions'|trans }}</h2>
 </div>
 <div class="p-4">
 {% include 'weather/partials/current-conditions.twig' with {weather: weather.current, location_name: weather.current.location_name, units: weather.units} %}
 </div>
 </div>
 </div>
 </div>

 {# Forecast Controls #}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
 <div class="col-span-12">
 <div class="flex flex-wrap items-center justify-between gap-3">
 <h2 class="text-lg font-semibold mb-0">
 <i class="lucide lucide-calendar-days mr-2 text-sky-600" style="width:1.25em;height:1.25em;"></i>
 {{ weather.forecast_days }}-{{ 'Day Forecast'|trans }}
 </h2>
 <div class="flex gap-2">
 {# Units toggle #}
 <div class="inline-flex rounded-lg border border-neutral-200 overflow-hidden" role="group" aria-label="{{ 'Temperature units'|trans }}">
 <a href="{{ path('weather.details') }}?location={{ location|url_encode }}&units=metric&forecast_days={{ weather.forecast_days }}"
 class="px-3 py-1.5 text-sm font-medium {{ units == 'metric' ? 'bg-indigo-600 text-white' : 'text-neutral-700 hover:bg-neutral-100' }} transition-colors">
 C
 </a>
 <a href="{{ path('weather.details') }}?location={{ location|url_encode }}&units=imperial&forecast_days={{ weather.forecast_days }}"
 class="px-3 py-1.5 text-sm font-medium border-l border-neutral-200 {{ units == 'imperial' ? 'bg-indigo-600 text-white' : 'text-neutral-700 hover:bg-neutral-100' }} transition-colors">
 F
 </a>
 </div>
 {# Forecast days selector #}
 {% set dayOptions = [1,3,5,7] %}
 <div class="inline-flex rounded-lg border border-neutral-200 overflow-hidden" role="group" aria-label="{{ 'Forecast days'|trans }}">
 {% for d in dayOptions %}
 <a href="{{ path('weather.details') }}?location={{ location|url_encode }}&units={{ units }}&forecast_days={{ d }}"
 class="px-3 py-1.5 text-sm font-medium {{ weather.forecast_days == d ? 'bg-indigo-600 text-white' : 'text-neutral-700 hover:bg-neutral-100' }} not loop.first 'border-l border-neutral-200' '' transition-colors">
 {{ d }}d
 </a>
 {% endfor %}
 </div>
 </div>
 </div>
 </div>
 </div>

 {# Forecast Cards #}
 <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-{{ weather.forecast_days > 3 ? 4 : }} gap-4 mb-5">
 {% for day in weather.forecast %}
 <div>
 <div class="bg-white rounded-xl shadow-sm h-full">
 <div class="p-4">
 <div class="text-neutral-500 text-sm mb-2">
 {{ day.date|date('l, M j') }}
 </div>
 <div class="flex items-center mb-3">
 <div class="mr-3">
 <i class="lucide lucide-{{ day.icon|replace({'d':'','n':''})|default('cloud') }} text-2xl text-indigo-600" style="width:1em;height:1em;"></i>
 </div>
 <div class="flex-1">
 <div class="text-3xl font-bold text-neutral-900">
 {{ day.temperature_day|round|int }}
 <small class="text-base text-neutral-500">{{ day.temperature_night|round|int }}</small>
 </div>
 <div class="text-neutral-500 text-sm">{{ day.description|title }}</div>
 </div>
 </div>
 <div class="grid grid-cols-3 text-center text-sm text-neutral-500">
 <div>
 <i class="lucide lucide-droplet mr-1" style="width:1em;height:1em;"></i>{{ day.humidity }}%
 </div>
 <div>
 <i class="lucide lucide-wind mr-1" style="width:1em;height:1em;"></i>{{ day.wind_speed }} m/s
 </div>
 <div>
 <i class="lucide lucide-cloud-rain mr-1" style="width:1em;height:1em;"></i>{{ (day.pop * 100)|round }}%
 </div>
 </div>
 </div>
 </div>
 </div>
 {% endfor %}
 </div>

 {# Hourly Forecast #}
 {% if weather.forecast[0].hourly is defined and weather.forecast[0].hourly|length > 0 %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-5">
 <div class="col-span-12">
 <div class="bg-white rounded-xl shadow-sm">
 <div class="px-5 py-3 bg-sky-500 text-white rounded-t-xl">
 <h2 class="text-lg font-semibold mb-0"><i class="lucide lucide-clock mr-2" style="width:1.25em;height:1.25em;"></i>Hourly Forecast (Today)</h2>
 </div>
 <div class="p-0">
 <div class="overflow-x-auto">
 <table class="w-full text-sm">
 <thead class="bg-neutral-100 text-neutral-700">
 <tr>
 <th>{{ 'Time'|trans }}</th>
 <th>{{ 'Temperature'|trans }}</th>
 <th>{{ 'Humidity'|trans }}</th>
 <th>{{ 'Precipitation'|trans }}</th>
 </tr>
 </thead>
 <tbody>
 {% for hour in weather.forecast[0].hourly %}
 <tr>
 <td>{{ hour.time }}</td>
 <td>{{ hour.temp|round|int }}</td>
 <td>{{ hour.humidity }}%</td>
 <td>{{ (hour.pop * 100)|round }}%</td>
 </tr>
 {% endfor %}
 </tbody>
 </table>
 </div>
 </div>
 </div>
 </div>
 </div>
 {% endif %}

 {# Cache Info #}
 {% if weather.request_metadata.cache_hit is defined %}
 <div class="text-center text-neutral-500 text-sm">
 <i class="lucide lucide-clock-history mr-1" style="width:1em;height:1em;"></i>
 Data updated: {{ ('@' ~ weather.request_metadata.timestamp)|date('M j, Y g:i A') }}
 </div>
 {% endif %}
</div>
{% endblock %}

{% block extra_js %}
<script>
document.addEventListener('DOMContentLoaded', function() {
 // Optional: enhance UI interactivity
});
</script>
{% endblock %}




