{# weather/partials/current-conditions.twig #}
{# Displays current weather conditions rounded-xl border border-slate-200 bg-white shadow-sm #}

{# Determine unit symbol #}
{% set unitSymbol = 'C' %}
{% if units is defined %}
 {% if units == 'imperial' %}
 {% set unitSymbol = 'F' %}
 {% elseif units == 'kelvin' %}
 {% set unitSymbol = ' K' %}
 {% else %}
 {% set unitSymbol = 'C' %}
 {% endif %}
{% elseif weather.units is defined %}
 {% if weather.units == 'imperial' %}
 {% set unitSymbol = 'F' %}
 {% elseif weather.units == 'kelvin' %}
 {% set unitSymbol = ' K' %}
 {% else %}
 {% set unitSymbol = 'C' %}
 {% endif %}
{% endif %}

{# Normalize payload fields so this partial works with nested `weather` objects #}
{% set weatherIcon = icon|default(weather.icon|default('cloud-sun')) %}
{% set weatherDescription = desc|default(weather.description|default(weather.main|default('Clear'))) %}
{% set weatherTemp = temp is defined ? temp : (weather.temperature|default(weather.temp|default(0))) %}
{% set weatherFeels = feels is defined ? feels : (weather.feels_like|default(weather.feels|default(weatherTemp))) %}
{% set weatherLocation = location|default(location_name|default(weather.location_name|default('Selected Location'))) %}
{% set weatherHumidity = humidity is defined ? humidity : (weather.humidity|default(0)) %}
{% set weatherWind = wind is defined ? wind : (weather.wind_speed|default(weather.wind|default(0))) %}
{% set windDeg = windDeg is defined ? windDeg : (weather.wind_deg|default(0)) %}
{% set weatherPressure = pressure is defined ? pressure : (weather.pressure|default(0)) %}
{% set weatherIconClass = 'cloud-sun' %}
{% if weatherIcon starts with '01' %}
 {% set weatherIconClass = 'sun-fill' %}
{% elseif weatherIcon starts with '02' %}
 {% set weatherIconClass = 'cloud-sun-fill' %}
{% elseif weatherIcon starts with '03' or weatherIcon starts with '04' %}
 {% set weatherIconClass = 'cloud-fill' %}
{% elseif weatherIcon starts with '09' or weatherIcon starts with '10' %}
 {% set weatherIconClass = 'cloud-rain-fill' %}
{% elseif weatherIcon starts with '11' %}
 {% set weatherIconClass = 'cloud-lightning-rain-fill' %}
{% elseif weatherIcon starts with '13' %}
 {% set weatherIconClass = 'cloud-snow-fill' %}
{% elseif weatherIcon starts with '50' %}
 {% set weatherIconClass = 'cloud-fog2-fill' %}
{% endif %}

{# Map wind degrees to direction #}
{% set windDir = 'N' %}
{% if windDeg >= 22.5 and windDeg < 67.5 %}{% set windDir = 'NE' %}
{% elseif windDeg >= 67.5 and windDeg < 112.5 %}{% set windDir = 'E' %}
{% elseif windDeg >= 112.5 and windDeg < 157.5 %}{% set windDir = 'SE' %}
{% elseif windDeg >= 157.5 and windDeg < 202.5 %}{% set windDir = 'S' %}
{% elseif windDeg >= 202.5 and windDeg < 247.5 %}{% set windDir = 'SW' %}
{% elseif windDeg >= 247.5 and windDeg < 292.5 %}{% set windDir = 'W' %}
{% elseif windDeg >= 292.5 and windDeg < 337.5 %}{% set windDir = 'NW' %}
{% endif %}

<div class="bg-white rounded-xl shadow-lg overflow-hidden">
 <div class="p-4">
 <div class="flex items-center">
 {# Weather Icon #}
 <div class="w-1/3 text-center">
 <div class="weather-icon-wrapper mb-2">
 <i class="lucide lucide-{{ weatherIconClass }} text-4xl text-indigo-600" style="width:1em;height:1em;"></i>
 </div>
 <div class="text-neutral-500 text-sm uppercase">{{ weatherDescription|title }}</div>
 </div>

 {# Temperature & Location #}
 <div class="w-5/12 text-center">
 <div class="text-5xl font-bold text-neutral-900 mb-0" style="font-size: 3rem;">
 {{ weatherTemp|round|int }}
 <small class="text-base text-neutral-500">{{ unitSymbol }}</small>
 </div>
 <div class="text-neutral-500">Feels like {{ weatherFeels|round|int }}{{ unitSymbol }}</div>
 <h4 class="text-lg font-medium mt-2">{{ weatherLocation }}</h4>
 </div>

 {# Additional Info #}
 <div class="w-1/4 text-center">
 <div class="space-y-1 text-sm">
 <div>
 <i class="lucide lucide-droplet text-indigo-600 mr-1" style="width:1em;height:1em;"></i>{{ weatherHumidity }}%
 </div>
 <div>
 <i class="lucide lucide-wind text-emerald-600 mr-1" style="width:1em;height:1em;"></i>{{ weatherWind }} m/s {{ windDir }}
 </div>
 <div>
 <i class="lucide lucide-gauge text-amber-600 mr-1" style="width:1em;height:1em;"></i>{{ weatherPressure }} hPa
 </div>
 </div>
 </div>
 </div>
 </div>
</div>




