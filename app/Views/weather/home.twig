{% extends "layout.twig" %}

{% block title %}Weather Winget - Home{% endblock %}

{% block meta_description %}Get current weather conditions and forecasts for cities worldwide. Check temperature, humidity, wind speed, and more.{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ asset('assets/css/weather.css') }}">
{% endblock %}

{% block content %}
<div class="container py-5">
    {# Breadcrumb #}
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ url }}">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Weather</li>
        </ol>
    </nav>

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">
            <i class="bi bi-cloud-sun-fill me-2"></i>Weather Winget
        </h1>
        <p class="lead text-muted">
            Real-time weather data and forecasts for any location worldwide.
        </p>
    </div>

    {# Search Form #}
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8">
            <form action="{{ path('weather.details', {location: ''}) }}" method="get" class="search-form">
                <div class="input-group input-group-lg shadow-sm">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-primary"></i>
                    </span>
                    <input type="text"
                           name="location"
                           class="form-control border-0 py-3"
                           placeholder="City name or coordinates (lat,lon)"
                           value="{{ weather_data.search_city|e }}"
                           aria-label="Search location"
                           required>
                    <button class="btn btn-primary px-4" type="submit">
                        Get Weather
                    </button>
                </div>
                <div class="form-text text-center mt-2">
                    Popular: 
                    <a href="{{ path('weather.details', {location: ''}) }}?location=London">London</a> | 
                    <a href="{{ path('weather.details', {location: ''}) }}?location=New York">New York</a> | 
                    <a href="{{ path('weather.details', {location: ''}) }}?location=Tokyo">Tokyo</a>
                </div>
            </form>
        </div>
    </div>

    {# Featured Weather #}
    {% if weather_data.featured_weather is not empty %}
        <div class="row mb-5">
            <div class="col-12">
                <h2 class="h3 fw-semibold mb-4">
                    <i class="bi bi-star-fill text-warning me-2"></i>Current Weather
                </h2>
                {% include 'weather/partials/current-conditions.twig' with {weather: weather_data.featured_weather.current, location_name: weather_data.featured_weather.current.location_name, units: weather_data.featured_weather.units} %}
            </div>
        </div>
    {% endif %}

    {# Popular Locations #}
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="h3 fw-semibold mb-4">
                <i class="bi bi-globe text-info me-2"></i>Popular Locations
            </h2>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                {% for loc in weather_data.popular_locations %}
                    <div class="col">
                        <a href="{{ path('weather.details', {location: loc.search}) }}" class="text-decoration-none">
                            <div class="card h-100 border-0 shadow-sm hover-lift">
                                <div class="card-body text-center">
                                    <h5 class="card-title">{{ loc.name }}</h5>
                                    <p class="text-muted small mb-0">{{ loc.country }}</p>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# Info Cards #}
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-info-circle me-2 text-primary"></i>About This Service</h5>
                    <p class="text-muted">
                        Weather Winget provides accurate, real-time weather data from trusted meteorological sources.
                        Get temperature, humidity, wind speed, pressure, UV index, and multi-day forecasts.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-lightning me-2 text-warning"></i>Features</h5>
                    <ul class="list-unstyled mb-0 text-muted">
                        <li><i class="bi bi-check text-success me-2"></i>Current conditions & forecasts</li>
                        <li><i class="bi bi-check text-success me-2"></i>Hourly breakdown available</li>
                        <li><i class="bi bi-check text-success me-2"></i>Multiple unit systems</li>
                        <li><i class="bi bi-check text-success me-2"></i>Weather alerts & warnings</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.querySelector('input[name="location"]');
    if (searchInput) {
        searchInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const location = encodeURIComponent(this.value.trim());
                if (location) {
                    window.location.href = '{{ path('weather.details', {location: ''}) }}' + location;
                }
            }
        });
    }
});
</script>
{% endblock %}
