{% extends"layout.twig" %}
{% import '_macros/flash.twig' as flash_macros %}
{% block title %}Reset Your Password - {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% set page_schema = {
 '@context': 'https://schema.org',
 '@type': 'WebApplication',
 'name': app_settings.site_name|default('BroxBhai'),
 'url': url
} %}
{% block schema %}
 <script type="application/ld+json">
{{ page_schema|schema_json }}
 </script>
{% endblock %}
{% block content %}
<div class="relative isolate flex min-h-screen items-center justify-center overflow-hidden bg-slate-50 px-4 py-10 sm:px-6 sm:py-14">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-24 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-indigo-500/15 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 h-80 w-80 rounded-full bg-cyan-500/10 blur-3xl"></div>
    <div class="absolute left-0 top-1/3 h-64 w-64 rounded-full bg-violet-500/10 blur-3xl"></div>
  </div>

  <div class="absolute left-1/2 top-6 -translate-x-1/2 sm:top-8">
    <a href="/" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/80 px-4 py-2 shadow-sm backdrop-blur transition hover:bg-white hover:shadow-md">
      <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-indigo-500 to-violet-600 text-white">
        <i class="lucide lucide-gauge h-4 w-4"></i>
      </div>
      <span class="text-sm font-bold text-slate-900">{{ app_settings.site_name|default("BroxBhai") }}</span>
    </a>
  </div>

  <section class="scroll-fade-in relative w-full max-w-[560px] overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_24px_80px_-30px_rgba(15,23,42,0.25)]">
        <div class="absolute left-0 right-0 top-0 h-1 bg-gradient-to-r from-indigo-500 via-violet-500 to-indigo-400"></div>
        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-6 py-5 sm:px-8 sm:py-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full bg-indigo-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.26em] text-indigo-700">
                <i class="lucide lucide-key" style="width:0.875em;height:0.875em;"></i>
                Forgot Password
              </div>
              <h2 class="mt-3 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">Reset your password</h2>
              <p class="mt-2 max-w-xl text-sm leading-6 text-slate-500">Enter your email and we'll send you a password reset link.</p>
            </div>
            <div class="hidden sm:flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-600/10 text-indigo-600">
              <i class="lucide lucide-key" style="width:1.5em;height:1.5em;"></i>
            </div>
          </div>
        </div>

        <div class="px-6 py-6 sm:px-8 sm:py-8">
          {% if error %}{{ flash_macros.render_flash({ message: error, type: 'danger' }) }}{% endif %}
          {% if success %}{{ flash_macros.render_flash({ message: success, type: 'success' }) }}{% endif %}
          <form method="POST"
            action="/forgot-password"
            id="forgotPasswordForm"
            class="space-y-5"
            novalidate>
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div class="space-y-1.5">
              <label for="email" class="block text-sm font-semibold text-slate-700">Email Address</label>
              <div class="relative">
                <i class="lucide lucide-mail absolute left-4 top-1/2 -translate-y-1/2" style="width:1.25em;height:1.25em;color:rgb(148 163 184);pointer-events:none;"></i>
                <input type="email"
                  class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-11 py-3.5 text-slate-900 shadow-sm transition focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-500/10"
                  id="email"
                  name="email"
                  value="{{ old_email }}"
                  placeholder="Enter your email address"
                  autocomplete="email"
                  required>
              </div>
              <p class="text-xs text-slate-500">Enter the email address associated with your account.</p>
              <div class="hidden text-xs text-red-500 mt-1" id="email-error">Please provide a valid email.</div>
            </div>

            <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 px-4 py-3.5 text-sm font-semibold text-white shadow-lg shadow-indigo-600/25 transition-all duration-200 hover:-translate-y-0.5 hover:from-indigo-700 hover:to-violet-700 focus:outline-none focus:ring-4 focus:ring-indigo-500/30 active:scale-[0.98]">
              <i class="lucide lucide-send" style="width:1.25em;height:1.25em;"></i>
              Send Reset Link
            </button>
          </form>

          <div class="mt-6 grid gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:grid-cols-2">
            <a href="/login" class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-slate-100 hover:shadow-md active:scale-[0.98]">
              <i class="lucide lucide-arrow-left" style="width:1em;height:1em;color:rgb(79 70 229);"></i>
              Back to Login
            </a>
            <a href="/register" class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-slate-100 hover:shadow-md active:scale-[0.98]">
              <i class="lucide lucide-user-plus" style="width:1em;height:1em;color:rgb(79 70 229);"></i>
              Create Account
            </a>
          </div>

          <div class="mt-5 space-y-3">
            <div class="rounded-2xl border border-sky-200 bg-sky-50 p-4">
              <h6 class="text-sm font-semibold text-sky-800 mb-2 flex items-center gap-2">
                <i class="lucide lucide-info" style="width:1em;height:1em;"></i>What happens next?
              </h6>
              <ol class="m-0 pl-4 text-sm text-sky-700 space-y-1">
                <li>We'll send a password reset link to your email</li>
                <li>The link expires in <strong>1 hour</strong> for security</li>
                <li>Click the link and create a new password</li>
                <li>You can then login with your new password</li>
              </ol>
            </div>
            <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4">
              <p class="m-0 text-sm text-amber-800">
                <strong><i class="lucide lucide-shield" style="width:1em;height:1em;"></i> Security:</strong>
                Never share your password reset link with anyone. If you didn't request this reset, you can safely ignore this email.
              </p>
            </div>
          </div>
        </div>
  </section>
</div>

<script>
(function() {
  const form = document.getElementById('forgotPasswordForm');
  if (!form) return;

  form.addEventListener('submit', function(e) {
    const email = document.getElementById('email');
    const errorEl = document.getElementById('email-error');
    if (!email.value || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
      e.preventDefault();
      email.classList.add('border-red-400', 'focus:border-red-500', 'focus:ring-red-500/10');
      if (errorEl) {
        errorEl.classList.remove('hidden');
        errorEl.textContent = email.value ? 'Please enter a valid email address.' : 'Please enter your email address.';
      }
    }
  });

  document.getElementById('email')?.addEventListener('input', function() {
    this.classList.remove('border-red-400', 'focus:border-red-500', 'focus:ring-red-500/10');
    document.getElementById('email-error')?.classList.add('hidden');
  });
})();
</script>
{% endblock %}




