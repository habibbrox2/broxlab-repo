{% extends"layout.twig" %}
{% import '_macros/flash.twig' as flash_macros %}
{% block title %}Reset Your Password - {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% set page_schema = {
 '@context': 'https://schema.org',
 '@type': 'WebApplication',
 'name': app_settings.site_name|default('BroxBhai'),
 'url': url
} %}
{% block schema %}
 <script type="application/ld+json">
{{ page_schema|schema_json }}
 </script>
{% endblock %}
{% block content %}
 <div class="auth-page auth-page-shell">
 <div class="auth-shell auth-shell-sm">
 <div class="auth-shell">
 <div class="auth-border-b border-slate-200 px-4 py-3 auth-shell-header text-center">
 <div class="auth-shell-icon text-white mb-2">
 <i class="lucide lucide-key"></i>
 </div>
 <h2 class="auth-shell-title mb-2">Forgot Password?</h2>
 <p class="auth-shell-subtitle mb-0">
 No worries! Enter your email and we'll send you a link to reset your password.
 </p>
 </div>
 <div class="auth-p-4 auth-shell-body">
 {% if error %}{{ flash_macros.render_flash({ message: error, type: 'danger' }) }}{% endif %}
 {% if success %}{{ flash_macros.render_flash({ message: success, type: 'success' }) }}{% endif %}
 <form method="POST"
 action="/forgot-password"
 id="forgotPasswordForm"
 novalidate>
 <!-- CSRF Token -->
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <!-- Email Field -->
 <div class="mb-4">
 <label for="email" class="block text-sm font-medium mb-1.5">Email Address</label>
 <input type="email"
 class="form-input"
 id="email"
 name="email"
 value="{{ old_email }}"
 placeholder="Enter your email address"
 required>
 <div class="text-xs text-slate-500 mt-1">Enter the email address associated with your account.</div>
 <div class="hidden text-xs text-red-500 mt-1 invalid-feedback">Please provide a valid email.</div>
 </div>
 <!-- Submit Button -->
 <button type="submit" class="btn-primary w-full">Send Reset Link</button>
 </form>
 <!-- Divider -->
 <hr class="my-4 border-slate-200">
 <!-- Help Links -->
 <div class="text-center text-sm">
 <p class="mb-2 text-slate-500">
 Remember your password? <a href="/login" class="text-indigo-600 font-medium hover:text-indigo-600/80">Login here</a>
 </p>
 <p class="mb-0 text-slate-500">
 Don't have an account? <a href="/register" class="text-indigo-600 font-medium hover:text-indigo-600/80">Create one</a>
 </p>
 </div>
 </div>
 </div>
 <div class="auth-shell-notes">
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200 auth-shell-note" role="alert">
 <h6 class="alert-heading text-sm font-semibold mb-2">
 <i class="lucide lucide-info mr-2"></i>What happens next?
 </h6>
 <ol class="mb-0 ps-3 text-sm">
 <li>We'll send a password reset link to your email</li>
 <li>The link expires in 1 hour for security</li>
 <li>Click the link and create a new password</li>
 <li>You can then login with your new password</li>
 </ol>
 </div>
 <!-- Security Note -->
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 auth-shell-note mt-3" role="alert">
 <small class="text-sm">
 <strong>Security:</strong> Never share your password reset link with anyone.
 If you didn't request this reset, you can safely ignore this email.
 </small>
 </div>
 </div>
 </div>
 </div>
 {# Inline script removed - use external JavaScript file instead #}
{% endblock %}




