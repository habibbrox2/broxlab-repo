{% extends"layout.twig" %}
{% import '_macros/flash.twig' as flash_macros %}
{% block title %}Two-Factor Authentication - {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% block content %}
 <div class="auth-page auth-page-shell">
 <div class="auth-shell auth-shell-md">
 <div class="auth-shell">
 <div class="auth-border-b border-slate-200 px-4 py-3 auth-shell-header text-center">
 <div class="auth-shell-icon text-white mb-2">
 <i class="lucide lucide-shield"></i>
 </div>
 <h2 class="auth-shell-title mb-2">Two-Factor Authentication</h2>
 <p class="auth-shell-subtitle mb-0">Enter the 6-digit code from your authenticator app</p>
 </div>
 <div class="auth-p-4 auth-shell-body">
 {% if error %}{{ flash_macros.render_flash({ message: error, type: 'danger' }) }}{% endif %}
 <form id="verify2faForm" novalidate>
 <!-- CSRF Token -->
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <!-- 2FA Code Field -->
 <div class="mb-4">
 <label for="code" class="block text-sm font-medium mb-1.5">6-Digit Code</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-4 py-3 text-base text-center focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="code"
 name="code"
 placeholder="000000"
 maxlength="6"
 pattern="[0-9]{6}"
 required
 inputmode="numeric">  <div class="text-xs text-neutral-400 mt-1">Check your authenticator app for the code</div>
 <div class="invalid-feedback">Please enter a valid 6-digit code.</div>
 </div>
 <!-- Submit Button -->
 <button type="submit"
 class="w-full inline-flex items-center justify-center px-5 py-3 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-600/90 transition-colors mb-3 text-lg"
 id="submitBtn">
 <span id="btnText">Verify Code</span>
 <span id="spinner"
 class="hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin ml-2 auth-hidden"
 role="status"
 aria-hidden="true"></span>
 </button>
 </form>
 <!-- Backup Code Option -->
 <hr class="my-4 border-slate-200">
 <div class="text-center">
 <p class="mb-3 text-neutral-500 text-sm">Don't have access to your authenticator?</p>
 <a href="#"
 class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-lg border border-neutral-300 text-neutral-700 font-medium hover:bg-neutral-100 transition-colors"
 id="backupCodeToggle">
 <i class="lucide lucide-key mr-2"></i>Use Backup Code
 </a>
 </div>
 <!-- Backup Code Form (Hidden) -->
 <form id="backupCodeForm" class="mt-3 auth-hidden" novalidate>
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <div class="mb-3">
 <label for="backup_code" class="block text-sm font-medium mb-1.5">Backup Code</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="backup_code"
 name="backup_code"
 placeholder="Enter a backup code"
 required>
 <p class="text-xs text-neutral-500 mt-1">Backup codes are 8 characters long</p>
 </div>
 <button type="submit" class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-lg border border-neutral-300 bg-white text-neutral-700 font-medium hover:bg-neutral-100 transition-colors">Verify Backup Code</button>
 </form>
 <!-- Help -->
 <div class="mt-4">
 <p class="text-neutral-500 mb-0">
 <a href="/login" class="text-indigo-600 hover:text-indigo-600/80 transition-colors">Back to login</a>
 </p>
 </div>
 </div>
 </div>
 <div class="auth-shell-notes">
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200 auth-shell-note" role="alert">
 <h6 class="text-sm font-semibold mb-2">
 <i class="lucide lucide-info mr-2"></i>What is 2FA?
 </h6>
 <p class="mb-0 text-sm">
 Two-Factor Authentication adds an extra layer of security to your account by requiring a code
 from your authenticator app in addition to your password.
 </p>
 </div>
 </div>
 </div>
 </div>
 {# Inline script removed - use external JavaScript file instead #}
{% endblock %}




