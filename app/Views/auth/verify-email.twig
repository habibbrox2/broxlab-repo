{% extends"layout.twig" %}
{% import '_macros/flash.twig' as flash_macros %}
{% block title %}Verify Your Email - {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% block content %}
 <div class="auth-page auth-page-shell">
 <div class="auth-shell auth-shell-md">
 <div class="auth-shell">
 <div class="auth-border-b border-slate-200 px-4 py-3 auth-shell-header text-center">
 <div class="auth-shell-icon text-white mb-2">
 <i class="lucide lucide-mail"></i>
 </div>
 <h2 class="auth-shell-title mb-2">Verify Your Email</h2>
 <p class="auth-shell-subtitle mb-0">
 We sent a verification code to <strong>{{ email }}</strong>
 </p>
 </div>
 <div class="auth-p-4 auth-shell-body">
 {% if error %}{{ flash_macros.render_flash({ message: error, type: 'danger' }) }}{% endif %}
 {% if success %}{{ flash_macros.render_flash({ message: success, type: 'success' }) }}{% endif %}
 
 <!-- One-time Verification Info -->
 <div class="rounded-lg border border-blue-200 bg-blue-50 p-4 mb-4" role="alert">
 <div class="flex gap-2">
 <i class="lucide lucide-info text-blue-500 mt-0.5"></i>
 <div>
 <strong class="block font-semibold text-blue-800 text-sm">Completing Verification</strong>
 <p class="mb-0 text-xs text-blue-700">After verifying your email, you'll be able to log in to your account.</p>
 </div>
 </div>
 </div>

 <form method="POST" action="/verify-email" id="verifyForm" novalidate>
 <!-- CSRF Token -->
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <input type="hidden" name="email" value="{{ email }}">
 <!-- Verification Token Field -->
 <div class="mb-4">
 <label for="verification_token" class="block text-sm font-medium mb-1.5">Verification Token</label>
 <input type="text"
 class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 placeholder:text-slate-400 hover:border-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 text-center"
 id="verification_token"
 name="verification_token"
 value="{{ token }}"
 placeholder="Enter token from email"
 maxlength="100"
 {% if token %}readonly{% else %}required{% endif %}>
 <div class="text-xs text-slate-500 mt-1">
 {% if token %}
 Token auto-populated from verification link
 {% else %}
 Check your email inbox and spam folder for the verification token.
 {% endif %}
 </div>
 <div class="hidden text-xs text-red-500 mt-1">Please enter a valid verification token.</div>
 </div>
 <!-- Submit Button -->
 <button type="submit"
 class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-500/30"
 id="submitBtn">
 <span id="btnText">Verify Email</span>
 <span id="spinner"
 class="hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin ml-2"
 role="status"
 aria-hidden="true"></span>
 </button>
 </form>
 <!-- Resend Link -->
 <hr class="my-4">
 <div class="text-center">
 <p class="mb-3 text-neutral-500">Didn't receive the token?</p>
 <form method="POST" action="/resend-verification-email" id="resendForm">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <input type="hidden" name="email" value="{{ email }}">
 <button type="submit" class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-lg border border-indigo-600 text-indigo-600 font-medium hover:bg-indigo-600/5 transition-colors">
 <i class="lucide lucide-rotate-cw mr-2"></i>Resend Verification Token
 </button>
 </form>
 </div>
 <!-- Resend Timer -->
 <div id="resendTimer"
 class="hidden text-center mt-3 text-red-500 text-sm">
 <i class="lucide lucide-hourglass mr-2"></i>Please wait <span id="timerSeconds">60</span> seconds before resending
 </div>
 <!-- Help -->
 <div class="mt-4 text-center text-sm">
 <p class="text-slate-500 mb-0">
 Wrong email? <a href="/register" class="text-indigo-600 font-medium hover:text-indigo-600/80">Create new account</a>
 </p>
 </div>
 </div>
 </div>
 <div class="auth-shell-notes">
 <div class="p-4 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 auth-shell-note" role="alert">
 <h6 class="text-sm font-semibold mb-2">
 <i class="lucide lucide-zap mr-2"></i>Next Step
 </h6>
 <p class="mb-0 text-sm">
 âœ“ Once verified, you'll be redirected to <strong>login</strong> where you can access your account immediately.
 </p>
 </div>
 
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200 auth-shell-note" role="alert">
 <h6 class="text-sm font-semibold mb-2">
 <i class="lucide lucide-help-circle mr-2"></i>Why verify your email?
 </h6>
 <ul class="mb-0 pl-3 text-sm">
 <li>Ensures we have your correct email address</li>
 <li>Helps secure your account</li>
 <li>Allows us to send important notifications</li>
 <li>Only takes a few seconds!</li>
 </ul>
 </div>
 <!-- Privacy Note -->
 <div class="p-4 rounded-lg bg-neutral-100 text-neutral-700 border border-neutral-200 auth-shell-note mt-3" role="alert">
 <small class="text-sm">We respect your privacy. Your email is used only for account security and important notifications.</small>
 </div>
 </div>
 </div>
 </div>
 {# Inline script removed - use external JavaScript file instead #}
{% endblock %}




