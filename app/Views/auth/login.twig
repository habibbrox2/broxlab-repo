{# Clean Login Template - Polished with Tailwind CSS and Lucide Icons #}
{% extends "layout.twig" %}
{% set suppress_layout_flash = true %}
{% block title %}Login - {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% set page_schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  'name': app_settings.site_name|default('BroxBhai'),
  'url': url
} %}
{% block schema %}
<script type="application/ld+json">
{{ page_schema|schema_json }}
</script>
{% endblock %}
{% block content %}
<div class="relative isolate overflow-hidden bg-slate-50 py-10 sm:py-14">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-indigo-500/10 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-cyan-500/10 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-stretch gap-6 lg:grid-cols-2">
      <aside class="relative hidden overflow-hidden rounded-[2rem] border border-slate-200 bg-gradient-to-br from-slate-950 via-indigo-950 to-violet-950 p-8 text-white shadow-2xl shadow-slate-950/20 lg:flex lg:flex-col lg:justify-between">
        <div class="absolute inset-0 opacity-20" aria-hidden="true">
          <div class="absolute -top-16 right-0 h-48 w-48 rounded-full bg-white/10 blur-3xl"></div>
          <div class="absolute bottom-0 left-0 h-48 w-48 rounded-full bg-cyan-300/10 blur-3xl"></div>
        </div>
        <div class="relative space-y-6">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.28em] text-indigo-100 backdrop-blur">
            <i class="lucide lucide-log-in h-3.5 w-3.5"></i>
            Welcome Back
          </div>
          <div class="space-y-3">
            <h1 class="text-4xl font-black tracking-tight text-white">Sign in and pick up right where you left off.</h1>
            <p class="max-w-xl text-sm leading-6 text-slate-300">
              Access your saved activity, service applications, and personalized updates with a clean, focused login flow.
            </p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
              <div class="mb-2 flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-cyan-200">
                <i class="lucide lucide-shield-check h-5 w-5"></i>
              </div>
              <p class="text-sm font-semibold text-white">Secure access</p>
              <p class="mt-1 text-xs leading-5 text-slate-300">Your account stays protected with modern authentication checks.</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
              <div class="mb-2 flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-violet-200">
                <i class="lucide lucide-bolt h-5 w-5"></i>
              </div>
              <p class="text-sm font-semibold text-white">Fast flow</p>
              <p class="mt-1 text-xs leading-5 text-slate-300">Resume your dashboard, saved drafts, and recent actions instantly.</p>
            </div>
          </div>
        </div>
        <div class="relative flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 text-indigo-200">
            <i class="lucide lucide-lock h-6 w-6"></i>
          </div>
          <div>
            <p class="text-sm font-semibold text-white">Account access</p>
            <p class="text-xs text-slate-300">Use your email or username to continue into the experience.</p>
          </div>
        </div>
      </aside>

      <section class="auth-card scroll-fade-in overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_24px_80px_-30px_rgba(15,23,42,0.25)]">
        <div class="border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-6 py-5 sm:px-8 sm:py-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full bg-indigo-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.26em] text-indigo-700">
                <i class="lucide lucide-log-in h-3.5 w-3.5"></i>
                Login
              </div>
              <h2 class="mt-3 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">Welcome back</h2>
              <p class="mt-2 max-w-xl text-sm leading-6 text-slate-500">Sign in to your {{ app_settings.site_name|default("BroxBhai") }} account and continue from where you stopped.</p>
            </div>
            <div class="hidden sm:flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-600/10 text-indigo-600">
              <i class="lucide lucide-log-in h-6 w-6"></i>
            </div>
          </div>
        </div>

        <div class="auth-card-body px-6 py-6 sm:px-8 sm:py-8">
          {% set oauth_status_message = error|default('') %}
          {% set oauth_status_type_raw = "danger" %}
          {% if oauth_status_message == '' and flash_message %}
            {% set oauth_status_message = flash_message.text|default(flash_message.message|default('')) %}
            {% set oauth_status_type_raw = flash_message.status|default(flash_message.type|default('info')) %}
          {% endif %}
          {% set oauth_status_type = oauth_status_type_raw in ['success', 'danger', 'warning', 'info']
            ? oauth_status_type_raw
            : 'info'
          %}
          <div id="oauth-status"
            class="auth-response auth-response--{{ oauth_status_type }} auth-response-hidden"
            role="status"
            aria-live="polite"
            data-initial-message="{{ oauth_status_message }}"
            data-initial-type="{{ oauth_status_type }}"></div>

          <form method="POST"
            action="/login"
            id="loginForm"
            class="space-y-5"
            data-redirect-url="{{ oauth_redirect }}"
            data-firebase-auth="{{ enable_firebase_oauth ? '1' : '0' }}"
            novalidate>
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            {% if oauth_redirect %}
              <input type="hidden" name="redirect" value="{{ oauth_redirect }}">
            {% endif %}

            <div class="space-y-1.5">
              <label for="username" class="block text-sm font-semibold text-slate-700">Email or Username</label>
              <div class="relative">
                <i class="lucide lucide-user absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 pointer-events-none"></i>
                <input type="text"
                  class="auth-form-input w-full rounded-2xl border border-slate-200 bg-slate-50 px-11 py-3.5 text-slate-900 shadow-sm transition focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-500/10"
                  id="username"
                  name="username"
                  value="{{ old_username|default(old_email|default('')) }}"
                  placeholder="Enter email or username"
                  autocomplete="username"
                  required>
              </div>
              <p class="text-xs text-slate-500">Use the email or username associated with your account.</p>
            </div>

            <div class="space-y-1.5">
              <label for="password" class="block text-sm font-semibold text-slate-700">Password</label>
              <div class="relative">
                <i class="lucide lucide-lock absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 pointer-events-none"></i>
                <input type="password"
                  class="auth-form-input--with-toggle w-full rounded-2xl border border-slate-200 bg-slate-50 px-11 py-3.5 pr-12 text-slate-900 shadow-sm transition focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-500/10"
                  id="password"
                  name="password"
                  placeholder="••••••••"
                  autocomplete="current-password"
                  required>
                <i class="lucide lucide-eye password-toggle-icon absolute right-4 top-1/2 h-5 w-5 -translate-y-1/2 cursor-pointer text-slate-400 transition hover:text-indigo-600"
                  id="passwordToggle"
                  role="button"
                  tabindex="0"
                  aria-label="Show password"
                  aria-controls="password"
                  aria-pressed="false"></i>
              </div>
            </div>

            {% if enable_remember_me %}
            <div class="flex items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
              <div class="flex items-center gap-3">
                <input type="checkbox"
                  class="auth-remember-checkbox h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
                  id="remember_me"
                  name="remember_me">
                <label class="auth-remember-label text-sm font-medium text-slate-700" for="remember_me">Remember me for 30 days</label>
              </div>
              <i class="lucide lucide-clock-3 h-4 w-4 text-slate-400"></i>
            </div>
            {% endif %}

            <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-4 py-3.5 text-sm font-semibold text-white shadow-lg shadow-indigo-600/20 transition-all duration-200 hover:-translate-y-0.5 hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-500/30 active:scale-[0.98]">
              <i class="lucide lucide-log-in h-5 w-5"></i>
              Sign In
            </button>
          </form>

          {% if enable_firebase_oauth %}
          <div class="my-6 flex items-center gap-3">
            <div class="h-px flex-1 bg-slate-200"></div>
            <div class="inline-flex items-center gap-2 rounded-full bg-slate-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">
              <i class="lucide lucide-sparkles h-3.5 w-3.5 text-indigo-500"></i>
              Continue with
            </div>
            <div class="h-px flex-1 bg-slate-200"></div>
          </div>

          <div id="auth-buttons" class="auth-oauth-buttons grid grid-cols-3 gap-3">
            <button type="button"
              class="auth-oauth-btn inline-flex h-12 w-full items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700"
              id="auth-google-btn"
              title="Sign in with Google"
              aria-label="Sign in with Google">
              <i class="lucide lucide-log-in h-5 w-5"></i>
            </button>
            <button type="button"
              class="auth-oauth-btn inline-flex h-12 w-full items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700"
              id="auth-facebook-btn"
              title="Sign in with Facebook"
              aria-label="Sign in with Facebook">
              <i class="lucide lucide-users h-5 w-5"></i>
            </button>
            <button type="button"
              class="auth-oauth-btn inline-flex h-12 w-full items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700"
              id="auth-guest-btn"
              title="Continue as Guest"
              aria-label="Continue as guest">
              <i class="lucide lucide-user h-5 w-5"></i>
            </button>
          </div>

          <div class="auth-buttons auth-buttons-hidden">
            <div id="firebaseui-auth-container"
              class="firebaseui-auth-container"
              {% if oauth_redirect %}data-redirect-url="{{ oauth_redirect }}"{% endif %}></div>
          </div>
          {% endif %}

          <div class="mt-6 grid gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:grid-cols-2">
            <a href="/forgot-password" class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">
              <i class="lucide lucide-help-circle h-4 w-4 text-indigo-600"></i>
              Forgot password?
            </a>
            <a href="/register{% if oauth_redirect %}?redirect={{ oauth_redirect|url_encode }}{% endif %}" class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">
              <i class="lucide lucide-user-plus h-4 w-4 text-indigo-600"></i>
              Create account
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

{# Login form handler #}
<script src="{{ asset('/assets/js/dist/auth/login.js') }}"
  defer
  type="module"></script>

{# Account conflict resolution modal #}
{% include 'auth/account-conflict-modal.twig' %}
{% endblock %}
