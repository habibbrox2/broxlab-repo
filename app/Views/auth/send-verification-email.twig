{% extends"layout.twig" %}
{% import '_macros/flash.twig' as flash_macros %}
{% block title %}Confirm Your Email - {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% block content %}
 <div class="auth-page auth-page-shell">
 <div class="auth-shell auth-shell-md">
 <div class="auth-shell">
 <div class="auth-border-b border-slate-200 px-4 py-3 auth-shell-header text-center">
 <div class="auth-shell-icon text-white mb-2">
 <i class="lucide lucide-shield-check"></i>
 </div>
 <h2 class="auth-shell-title mb-2">Verify Your Email</h2>
 {% if email %}
 <p class="auth-shell-subtitle mb-0">
 Complete verification for <strong>{{ email }}</strong>
 </p>
 {% else %}
 <p class="auth-shell-subtitle mb-0">We'll send a verification link to your email address.</p>
 {% endif %}
 </div>
 <div class="auth-p-4 auth-shell-body">
 {% if error %}{{ flash_macros.render_flash({ message: error, type: 'danger' }) }}{% endif %}
 {% if success %}{{ flash_macros.render_flash({ message: success, type: 'success' }) }}{% endif %}
 
 <!-- One-time Verification Info -->
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200 mb-4" role="alert">
 <div class="flex gap-2">
 <i class="lucide lucide-info mr-2 mt-1"></i>
 <div>
 <strong class="block font-semibold text-sm">One-time Verification</strong>
 <p class="mb-0 text-xs">After verifying your email once, you'll be able to log in to your account.</p>
 </div>
 </div>
 </div>

 <form method="POST" action="/resend-verification-email" novalidate>
 <!-- CSRF Token -->
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <!-- Email Field -->
 <div class="mb-4">
 <label for="email" class="block text-sm font-medium mb-1.5">Email Address</label>
 <input type="email"
 class="form-input"
 id="email"
 name="email"
 value="{{ email or old_email or '' }}"
 placeholder="Enter your email address"
 {% if email %}readonly{% else %}required{% endif %}>  <div class="text-xs text-slate-400 mt-1">
 {% if email %}
 <i class="lucide lucide-check-circle text-emerald-600 mr-1"></i>
 This is the email from your login. A verification link will be sent here.
 {% else %}
 Enter the email address associated with your account.
 {% endif %}
 </div>
 <div class="invalid-feedback">Please provide a valid email.</div>
 </div>
 <!-- Submit Button -->
 <button type="submit" class="btn-primary w-full text-base">
 <span id="btnText">
 {% if email %}
 Send Verification Email
 {% else %}
 Send Verification Email
 {% endif %}
 </span>
 <span id="spinner"
 class="hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin ml-2 auth-hidden"
 role="status"
 aria-hidden="true"></span>
 </button>
 </form>
 
 <!-- Fallback Token Display (if email failed) -->
 {% if show_fallback_token and verification_token %}
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 mt-4" role="alert">
 <div class="mb-3">
 <h6 class="text-sm font-semibold mb-2">
 <i class="lucide lucide-alert-triangle mr-2"></i>
 Email Not Received?
 </h6>
 <p class="mb-3 text-sm">
 If you haven't received a verification email, you can verify your email directly using the token below:
 </p>
 </div>
 
 <div class="mb-3 p-3 bg-neutral-100 rounded-lg">
 <div class="mb-2">
 <small class="text-neutral-500 block mb-1 text-xs">Your Verification Token:</small>
 <code style="font-size: 14px; word-break: break-all; display: block;">{{ verification_token }}</code>
 </div>
 <button type="button" class="inline-flex items-center px-3 py-1.5 rounded-lg border border-neutral-300 text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition-colors mt-2" onclick="copyToken(event)">
 <i class="lucide lucide-clipboard mr-1"></i> Copy Token
 </button>
 </div>
 
 <ol class="small mb-0 ps-3">
 <li>Copy the token above</li>
 <li>Click"Already have a verification token?" link below</li>
 <li>Paste the token in the verification form</li>
 <li>Click"Verify Email"</li>
 </ol>
 </div>
 {% endif %}
 
 <!-- Divider -->
 <hr class="my-4">
 <!-- Help Links -->
 <div class="auth-footer">
 <p class="mb-2">
 Already have a verification token?
 <a href="/verify-email" class="text-indigo-600 font-bold hover:text-indigo-600/80 transition-colors">Verify here</a>
 </p>
 <p class="mb-2">
 Need to login? <a href="/login" class="text-indigo-600 font-bold hover:text-indigo-600/80 transition-colors">Login</a>
 </p>
 <p class="mb-0">
 Don't have an account? <a href="/register" class="text-indigo-600 font-bold hover:text-indigo-600/80 transition-colors">Register</a>
 </p>
 </div>
 </div>
 </div>
 <div class="auth-shell-notes">
 <div class="p-4 rounded-lg bg-emerald-600-light text-emerald-600-dark border border-success auth-shell-note" role="alert">
 <h6 class="alert-heading">
 <i class="lucide lucide-check-circle mr-2"></i>After Verification
 </h6>
 <ul class="mb-0 ps-3 small">
 <li>âœ“ Your email will be verified (one-time only)</li>
 <li>âœ“ You'll be able to log in immediately</li>
 <li>âœ“ You won't need to verify again</li>
 <li>âœ“ Your account will be fully activated</li>
 </ul>
 </div>
 
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200 auth-shell-note" role="alert">
 <h6 class="alert-heading">
 <i class="lucide lucide-info mr-2"></i>How It Works
 </h6>
 <ol class="mb-0 ps-3 small">
 <li>We'll send a verification link to <strong>{{ email or 'your email' }}</strong></li>
 <li>Click the link in your email (or copy the token)</li>
 <li>Enter the token to complete verification</li>
 <li>You're done! Log in to your account</li>
 </ol>
 </div>
 
 <!-- Security Note -->
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 auth-shell-note" role="alert">
 <small>
 <strong>â³ Security:</strong> Verification links expire after 24 hours.
 If your link expires, you can request a new one here.
 </small>
 </div>
 </div>
 </div>
 </div>

 <script>
 function copyToken(event) {
 const tokenElement = document.querySelector('code');
 if (!tokenElement) {
 alert('Token not found on page');
 return;
 }
 
 const token = tokenElement.textContent.trim();
 if (!token) {
 alert('No token to copy');
 return;
 }
 
 navigator.clipboard.writeText(token).then(() => {
 const btn = event.target.closest('button');
 if (btn) {
 const originalText = btn.innerHTML;
 btn.innerHTML = '<i class="lucide lucide-check mr-1"></i> Copied!';
 btn.disabled = true;
 setTimeout(() => {
 btn.innerHTML = originalText;
 btn.disabled = false;
 }, 2000);
 }
 }).catch((err) => {
 console.error('Copy failed:', err);
 alert('Failed to copy token. Please copy manually.');
 });
 }
 </script>
{% endblock %}




