{% extends"layout.twig" %}
{% import '_macros/flash.twig' as flash_macros %}
{% block title %}Reset Your Password - {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% block content %}
 <div class="auth-page auth-page-shell">
 <div class="auth-shell auth-shell-sm">
 <div class="auth-shell">
 <div class="auth-border-b border-slate-200 px-4 py-3 auth-shell-header text-center">
 <div class="auth-shell-icon text-white mb-2">
 <i class="lucide lucide-shield"></i>
 </div>
 <h2 class="auth-shell-title mb-2">Reset Your Password</h2>
 <p class="auth-shell-subtitle mb-0">Enter your new password below.</p>
 </div>
 <div class="auth-p-4 auth-shell-body">
 {% if error %}{{ flash_macros.render_flash({ message: error, type: 'danger' }) }}{% endif %}
 {% if success %}{{ flash_macros.render_flash({ message: success, type: 'success' }) }}{% endif %}
 {% if token_valid %}
 <form method="POST" action="/reset-password" novalidate>
 <!-- CSRF Token -->
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <input type="hidden" name="token" value="{{ token }}">
 <!-- New Password Field -->
 <div class="mb-3">
 <label for="password" class="block text-sm font-medium mb-1.5">New Password</label>
 <input type="password"
 class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 placeholder:text-slate-400 hover:border-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
 id="password"
 name="password"
 autocomplete="new-password"
 required>
 <div class="text-xs text-slate-500 mt-1">Minimum 8 characters. Must include uppercase, lowercase, number, and special character.</div>
 <div id="passwordFeedback" class="text-xs text-slate-500 mt-1"></div>
 <div class="hidden text-xs text-red-500 mt-1">Password must meet all requirements.</div>
 </div>
 <!-- Confirm Password Field -->
 <div class="mb-4">
 <label for="confirm_password" class="block text-sm font-medium mb-1.5">Confirm Password</label>
 <input type="password"
 class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 placeholder:text-slate-400 hover:border-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
 id="confirm_password"
 name="confirm_password"
 autocomplete="new-password"
 required>
 <div id="confirmFeedback" class="text-xs text-slate-500 mt-1"></div>
 <div class="hidden text-xs text-red-500 mt-1">Passwords do not match.</div>
 </div>
 <!-- Submit Button -->
 <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-500/30">Reset Password</button>
 </form>
 <hr class="my-4 border-slate-200">
 <div class="text-center text-sm">
 <p class="mb-0 text-slate-500">
 Remember your password? <a href="/login" class="text-indigo-600 font-medium hover:text-indigo-600/80">Login here</a>
 </p>
 </div>
 {% else %}
 <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-700" role="alert">
 <strong class="block font-semibold mb-1">Invalid or Expired Token</strong>
 <p class="mb-3 text-sm">The password reset link is invalid or has expired.</p>
 <a href="/forgot-password" class="inline-flex items-center px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-600/90 transition-colors">Request a new link</a>
 </div>
 {% endif %}
 </div>
 </div>
 <div class="auth-shell-notes">
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200 auth-shell-note" role="alert">
 <h6 class="text-sm font-semibold mb-2">
 <i class="lucide lucide-shield mr-2"></i>Password Requirements
 </h6>
 <ul class="mb-0 pl-3 text-sm">
 <li id="req-length">Minimum 8 characters</li>
 <li id="req-upper">At least one uppercase letter (A-Z)</li>
 <li id="req-lower">At least one lowercase letter (a-z)</li>
 <li id="req-number">At least one number (0-9)</li>
 <li id="req-special">At least one special character (!@#$%^&*)</li>
 </ul>
 </div>
 <!-- Security Note -->
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 auth-shell-note mt-3" role="alert">
 <small class="text-sm">
 <strong>Security:</strong> Never use the same password as your other accounts.
 Make sure your new password is strong and unique.
 </small>
 </div>
 </div>
 </div>
 </div>
 {# Inline script removed - use external JavaScript file instead #}
{% endblock %}




