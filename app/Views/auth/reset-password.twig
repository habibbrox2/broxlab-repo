{% extends"layout.twig" %}
{% import '_macros/flash.twig' as flash_macros %}
{% block title %}Reset Your Password - {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% block content %}
<div class="relative isolate overflow-hidden bg-slate-50 py-10 sm:py-14">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-indigo-500/10 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-cyan-500/10 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-stretch gap-6 lg:grid-cols-2">
      <aside class="relative hidden overflow-hidden rounded-[2rem] border border-slate-200 bg-gradient-to-br from-slate-950 via-indigo-950 to-violet-950 p-8 text-white shadow-2xl shadow-slate-950/20 lg:flex lg:flex-col lg:justify-between">
        <div class="absolute inset-0 opacity-20" aria-hidden="true">
          <div class="absolute -top-16 right-0 h-48 w-48 rounded-full bg-white/10 blur-3xl"></div>
          <div class="absolute bottom-0 left-0 h-48 w-48 rounded-full bg-cyan-300/10 blur-3xl"></div>
        </div>
        <div class="relative space-y-6">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.28em] text-indigo-100 backdrop-blur">
            <i class="lucide lucide-shield" style="width:1em;height:1em;"></i>
            New Password
          </div>
          <div class="space-y-3">
            <h1 class="text-4xl font-black tracking-tight text-white">Choose a new password</h1>
            <p class="max-w-xl text-sm leading-6 text-slate-300">
              Create a strong password that you haven't used before. Make sure it's at least 8 characters with a mix of letters, numbers, and symbols.
            </p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
              <div class="mb-2 flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-cyan-200">
                <i class="lucide lucide-lock" style="width:1.25em;height:1.25em;"></i>
              </div>
              <p class="text-sm font-semibold text-white">Strong & secure</p>
              <p class="mt-1 text-xs leading-5 text-slate-300">Encrypted and hashed before storage.</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
              <div class="mb-2 flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-violet-200">
                <i class="lucide lucide-refresh-ccw" style="width:1.25em;height:1.25em;"></i>
              </div>
              <p class="text-sm font-semibold text-white">Renewed access</p>
              <p class="mt-1 text-xs leading-5 text-slate-300">Get back into your account right away.</p>
            </div>
          </div>
        </div>
        <div class="relative flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 text-indigo-200">
            <i class="lucide lucide-check-circle" style="width:1.5em;height:1.5em;"></i>
          </div>
          <div>
            <p class="text-sm font-semibold text-white">One last step</p>
            <p class="text-xs text-slate-300">Set your new password and you're all set to sign in.</p>
          </div>
        </div>
      </aside>

      <section class="scroll-fade-in overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_24px_80px_-30px_rgba(15,23,42,0.25)]">
        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-6 py-5 sm:px-8 sm:py-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full bg-indigo-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.26em] text-indigo-700">
                <i class="lucide lucide-shield" style="width:0.875em;height:0.875em;"></i>
                Reset Password
              </div>
              <h2 class="mt-3 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">Set a new password</h2>
              <p class="mt-2 max-w-xl text-sm leading-6 text-slate-500">Choose a strong password you haven't used before.</p>
            </div>
            <div class="hidden sm:flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-600/10 text-indigo-600">
              <i class="lucide lucide-shield" style="width:1.5em;height:1.5em;"></i>
            </div>
          </div>
        </div>

        <div class="px-6 py-6 sm:px-8 sm:py-8">
          {% if error %}{{ flash_macros.render_flash({ message: error, type: 'danger' }) }}{% endif %}
          {% if success %}{{ flash_macros.render_flash({ message: success, type: 'success' }) }}{% endif %}
          {% if token_valid %}
          <form method="POST" action="/reset-password" class="space-y-5" novalidate>
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="reset_token" value="{{ reset_token }}">

            <div class="space-y-1.5">
              <label for="password" class="block text-sm font-semibold text-slate-700">New Password</label>
              <div class="relative">
                <i class="lucide lucide-lock absolute left-4 top-1/2 -translate-y-1/2" style="width:1.25em;height:1.25em;color:rgb(148 163 184);pointer-events:none;"></i>
                <input type="password"
                  class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-11 py-3.5 text-slate-900 shadow-sm transition focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-500/10"
                  id="password"
                  name="password"
                  placeholder="••••••••"
                  autocomplete="new-password"
                  required>
                <i class="lucide lucide-eye password-toggle-icon absolute right-4 top-1/2" style="width:1.25em;height:1.25em;transform:translateY(-50%);cursor:pointer;color:rgb(148 163 184);transition:color 0.2s;"
                  id="passwordToggle"
                  role="button"
                  tabindex="0"
                  aria-label="Show password"
                  aria-controls="password"
                  aria-pressed="false"></i>
              </div>
              <p class="text-xs text-slate-500">Minimum 8 characters with uppercase, lowercase, number, and special character.</p>
            </div>

            <div class="space-y-1.5">
              <label for="confirm_password" class="block text-sm font-semibold text-slate-700">Confirm Password</label>
              <div class="relative">
                <i class="lucide lucide-lock absolute left-4 top-1/2 -translate-y-1/2" style="width:1.25em;height:1.25em;color:rgb(148 163 184);pointer-events:none;"></i>
                <input type="password"
                  class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-11 py-3.5 pr-12 text-slate-900 shadow-sm transition focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-500/10"
                  id="confirm_password"
                  name="confirm_password"
                  placeholder="••••••••"
                  autocomplete="new-password"
                  required>
              </div>
            </div>

            <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-4 py-3.5 text-sm font-semibold text-white shadow-lg shadow-indigo-600/20 transition-all duration-200 hover:-translate-y-0.5 hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-500/30 active:scale-[0.98]">
              <i class="lucide lucide-check-circle" style="width:1.25em;height:1.25em;"></i>
              Reset Password
            </button>
          </form>

          <div class="mt-5 flex justify-center">
            <a href="/login" class="inline-flex items-center gap-2 rounded-xl bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">
              <i class="lucide lucide-arrow-left" style="width:1em;height:1em;color:rgb(79 70 229);"></i>
              Back to Login
            </a>
          </div>
          {% else %}
          <div class="rounded-2xl border border-red-200 bg-red-50 p-6 text-center">
            <div class="mx-auto mb-3 flex h-16 w-16 items-center justify-center rounded-2xl bg-red-100 text-red-600">
              <i class="lucide lucide-alert-triangle" style="width:1.75em;height:1.75em;"></i>
            </div>
            <h3 class="text-lg font-bold text-red-800 mb-1">Invalid or Expired Link</h3>
            <p class="text-sm text-red-600 mb-4">This password reset link is invalid or has expired. Password reset links expire after 1 hour.</p>
            <a href="/forgot-password" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">
              <i class="lucide lucide-refresh-ccw" style="width:1em;height:1em;"></i>
              Request a New Link
            </a>
          </div>
          {% endif %}

          <div class="mt-5 space-y-3">
            <div class="rounded-2xl border border-sky-200 bg-sky-50 p-4">
              <h6 class="text-sm font-semibold text-sky-800 mb-2 flex items-center gap-2">
                <i class="lucide lucide-shield" style="width:1em;height:1em;"></i>Password Requirements
              </h6>
              <ul class="m-0 pl-4 text-sm text-sky-700 space-y-1" id="password-requirements">
                <li id="req-length">Minimum 8 characters</li>
                <li id="req-upper">At least one uppercase letter (A-Z)</li>
                <li id="req-lower">At least one lowercase letter (a-z)</li>
                <li id="req-number">At least one number (0-9)</li>
                <li id="req-special">At least one special character (!@#$%^&*)</li>
              </ul>
            </div>
            <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4">
              <p class="m-0 text-sm text-amber-800">
                <strong><i class="lucide lucide-shield" style="width:1em;height:1em;"></i> Security:</strong>
                Never reuse passwords across different accounts. Make sure your new password is strong and unique.
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

<script>
(function() {
  const passwordInput = document.getElementById('password');
  const confirmInput = document.getElementById('confirm_password');
  const toggle = document.getElementById('passwordToggle');

  // Password toggle visibility
  if (toggle && passwordInput) {
    toggle.addEventListener('click', function() {
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
      this.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
      this.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
    });
  }

  // Password matching validation
  if (confirmInput && passwordInput) {
    confirmInput.addEventListener('input', function() {
      if (this.value && this.value !== passwordInput.value) {
        this.classList.add('border-red-400', 'focus:border-red-500', 'focus:ring-red-500/10');
      } else {
        this.classList.remove('border-red-400', 'focus:border-red-500', 'focus:ring-red-500/10');
      }
    });
  }

  // Form validation
  const form = document.querySelector('form[action="/reset-password"]');
  if (form) {
    form.addEventListener('submit', function(e) {
      if (!passwordInput.value || passwordInput.value.length < 8) {
        e.preventDefault();
        passwordInput.classList.add('border-red-400', 'focus:border-red-500', 'focus:ring-red-500/10');
        return;
      }
      if (passwordInput.value !== confirmInput.value) {
        e.preventDefault();
        confirmInput.classList.add('border-red-400', 'focus:border-red-500', 'focus:ring-red-500/10');
      }
    });
  }
})();
</script>
{% endblock %}




