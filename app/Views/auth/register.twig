{# Register Template - Polished with Tailwind CSS and Lucide Icons #}
{% extends "layout.twig" %}
{% set suppress_layout_flash = true %}
{% block title %}Create Account - {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% set page_schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  'name': app_settings.site_name|default('BroxBhai'),
  'url': url
} %}
{% block schema %}
<script type="application/ld+json">
{{ page_schema|schema_json }}
</script>
{% endblock %}
{% block content %}
<div class="relative isolate overflow-hidden bg-slate-50 py-10 sm:py-14">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-violet-500/10 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-emerald-500/10 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-stretch gap-6 lg:grid-cols-2">
      <aside class="relative hidden overflow-hidden rounded-[2rem] border border-slate-200 bg-gradient-to-br from-slate-950 via-indigo-950 to-violet-950 p-8 text-white shadow-2xl shadow-slate-950/20 lg:flex lg:flex-col lg:justify-between">
        <div class="absolute inset-0 opacity-20" aria-hidden="true">
          <div class="absolute -top-16 right-0 h-48 w-48 rounded-full bg-white/10 blur-3xl"></div>
          <div class="absolute bottom-0 left-0 h-48 w-48 rounded-full bg-emerald-300/10 blur-3xl"></div>
        </div>
        <div class="relative space-y-6">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.28em] text-violet-100 backdrop-blur">
            <i class="lucide lucide-user-plus h-3.5 w-3.5"></i>
            Join Us
          </div>
          <div class="space-y-3">
            <h1 class="text-4xl font-black tracking-tight text-white">Create your account and keep everything in one place.</h1>
            <p class="max-w-xl text-sm leading-6 text-slate-300">
              Save your activity, track your service applications, and get a more tailored experience across the site.
            </p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
              <div class="mb-2 flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-cyan-200">
                <i class="lucide lucide-check-circle h-5 w-5"></i>
              </div>
              <p class="text-sm font-semibold text-white">Simple signup</p>
              <p class="mt-1 text-xs leading-5 text-slate-300">A clean form with just the essentials to get you started quickly.</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
              <div class="mb-2 flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-emerald-200">
                <i class="lucide lucide-shield-check h-5 w-5"></i>
              </div>
              <p class="text-sm font-semibold text-white">Safer access</p>
              <p class="mt-1 text-xs leading-5 text-slate-300">Password rules and confirmation keep your account setup secure.</p>
            </div>
          </div>
        </div>
        <div class="relative flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 text-violet-200">
            <i class="lucide lucide-sparkles h-6 w-6"></i>
          </div>
          <div>
            <p class="text-sm font-semibold text-white">One account, many tools</p>
            <p class="text-xs text-slate-300">From service applications to saved content, everything stays connected.</p>
          </div>
        </div>
      </aside>

      <section class="auth-card scroll-fade-in overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_24px_80px_-30px_rgba(15,23,42,0.25)]">
        <div class="border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-6 py-5 sm:px-8 sm:py-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full bg-violet-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.26em] text-violet-700">
                <i class="lucide lucide-user-plus h-3.5 w-3.5"></i>
                Register
              </div>
              <h2 class="mt-3 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">Create account</h2>
              <p class="mt-2 max-w-xl text-sm leading-6 text-slate-500">Join {{ app_settings.site_name|default("BroxBhai") }} today and set up your profile in a few minutes.</p>
            </div>
            <div class="hidden sm:flex h-14 w-14 items-center justify-center rounded-2xl bg-violet-600/10 text-violet-600">
              <i class="lucide lucide-user-plus h-6 w-6"></i>
            </div>
          </div>
        </div>

        <div class="auth-card-body px-6 py-6 sm:px-8 sm:py-8">
          {% set oauth_status_message = error|default('') %}
          {% set oauth_status_type_raw = "danger" %}
          {% if oauth_status_message == '' and success|default('') != '' %}
            {% set oauth_status_message = success %}
            {% set oauth_status_type_raw = "success" %}
          {% endif %}
          {% if oauth_status_message == '' and flash_message %}
            {% set oauth_status_message = flash_message.text|default(flash_message.message|default('')) %}
            {% set oauth_status_type_raw = flash_message.status|default(flash_message.type|default('info')) %}
          {% endif %}
          {% set oauth_status_type = oauth_status_type_raw in ['success', 'danger', 'warning', 'info'] ? oauth_status_type_raw : 'info' %}
          <div id="oauth-status"
            class="auth-response auth-response--{{ oauth_status_type }}"
            role="status"
            aria-live="polite"
            data-initial-message="{{ oauth_status_message }}"
            data-initial-type="{{ oauth_status_type }}"></div>

          <form method="POST"
            action="/register"
            id="registerForm"
            class="space-y-5"
            data-redirect-url="{{ oauth_redirect }}"
            data-firebase-auth="{{ enable_firebase_oauth ? '1' : '0' }}"
            novalidate>
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            {% if oauth_redirect %}
              <input type="hidden" name="redirect" value="{{ oauth_redirect }}">
            {% endif %}

            <div class="space-y-1.5">
              <label for="email" class="block text-sm font-semibold text-slate-700">Email Address</label>
              <div class="relative">
                <i class="lucide lucide-mail absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 pointer-events-none"></i>
                <input type="email"
                  class="auth-form-input w-full rounded-2xl border border-slate-200 bg-slate-50 px-11 py-3.5 text-slate-900 shadow-sm transition focus:border-violet-500 focus:bg-white focus:ring-4 focus:ring-violet-500/10"
                  id="email"
                  name="email"
                  value="{{ old_email }}"
                  placeholder="john@example.com"
                  required>
              </div>
              <p class="text-xs text-slate-500">We'll never share your email with anyone else.</p>
            </div>

            <div class="space-y-1.5">
              <label for="username" class="block text-sm font-semibold text-slate-700">Username</label>
              <div class="relative">
                <i class="lucide lucide-at-sign absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 pointer-events-none"></i>
                <input type="text"
                  class="auth-form-input w-full rounded-2xl border border-slate-200 bg-slate-50 px-11 py-3.5 text-slate-900 shadow-sm transition focus:border-violet-500 focus:bg-white focus:ring-4 focus:ring-violet-500/10"
                  id="username"
                  name="username"
                  value="{{ old_username }}"
                  placeholder="john_doe"
                  pattern="[a-zA-Z0-9._-]{3,30}"
                  required>
              </div>
              <p class="text-xs text-slate-500">3-30 characters. Letters, numbers, dots, hyphens, and underscores.</p>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div class="space-y-1.5">
                <label for="first_name" class="block text-sm font-semibold text-slate-700">First Name</label>
                <div class="relative">
                  <i class="lucide lucide-id-card absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 pointer-events-none"></i>
                  <input type="text"
                    class="auth-form-input w-full rounded-2xl border border-slate-200 bg-slate-50 px-11 py-3.5 text-slate-900 shadow-sm transition focus:border-violet-500 focus:bg-white focus:ring-4 focus:ring-violet-500/10"
                    id="first_name"
                    name="first_name"
                    value="{{ old_first_name }}"
                    placeholder="John">
                </div>
              </div>
              <div class="space-y-1.5">
                <label for="last_name" class="block text-sm font-semibold text-slate-700">Last Name</label>
                <div class="relative">
                  <i class="lucide lucide-id-card absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 pointer-events-none"></i>
                  <input type="text"
                    class="auth-form-input w-full rounded-2xl border border-slate-200 bg-slate-50 px-11 py-3.5 text-slate-900 shadow-sm transition focus:border-violet-500 focus:bg-white focus:ring-4 focus:ring-violet-500/10"
                    id="last_name"
                    name="last_name"
                    value="{{ old_last_name }}"
                    placeholder="Doe">
                </div>
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="password" class="block text-sm font-semibold text-slate-700">Password</label>
              <div class="relative">
                <i class="lucide lucide-lock absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 pointer-events-none"></i>
                <input type="password"
                  class="auth-form-input--with-toggle w-full rounded-2xl border border-slate-200 bg-slate-50 px-11 py-3.5 pr-12 text-slate-900 shadow-sm transition focus:border-violet-500 focus:bg-white focus:ring-4 focus:ring-violet-500/10"
                  id="password"
                  name="password"
                  placeholder="Enter a strong password"
                  autocomplete="new-password"
                  required>
                <i class="lucide lucide-eye password-toggle-icon absolute right-4 top-1/2 h-5 w-5 -translate-y-1/2 cursor-pointer text-slate-400 transition hover:text-violet-600"
                  id="passwordToggle"
                  role="button"
                  tabindex="0"
                  aria-label="Show password"
                  aria-controls="password"
                  aria-pressed="false"
                  data-toggle-password="password"></i>
              </div>

              <div class="rounded-2xl border border-violet-100 bg-violet-50/70 p-4">
                <div class="mb-3 flex items-center justify-between">
                  <p class="text-xs font-bold uppercase tracking-[0.22em] text-violet-700">Password Strength</p>
                  <i class="lucide lucide-shield h-4 w-4 text-violet-600"></i>
                </div>
                <div class="password-strength-container" id="strengthIndicator">
                  <span class="strength-bar" data-strength="1"></span>
                  <span class="strength-bar" data-strength="2"></span>
                  <span class="strength-bar" data-strength="3"></span>
                  <span class="strength-bar" data-strength="4"></span>
                </div>
                <div id="passwordFeedback" class="mt-2 text-xs text-slate-500"></div>
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="confirm_password" class="block text-sm font-semibold text-slate-700">Confirm Password</label>
              <div class="relative">
                <i class="lucide lucide-lock absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 pointer-events-none"></i>
                <input type="password"
                  class="auth-form-input--with-toggle w-full rounded-2xl border border-slate-200 bg-slate-50 px-11 py-3.5 pr-12 text-slate-900 shadow-sm transition focus:border-violet-500 focus:bg-white focus:ring-4 focus:ring-violet-500/10"
                  id="confirm_password"
                  name="confirm_password"
                  placeholder="Repeat password"
                  autocomplete="new-password"
                  required>
                <i class="lucide lucide-eye password-toggle-icon absolute right-4 top-1/2 h-5 w-5 -translate-y-1/2 cursor-pointer text-slate-400 transition hover:text-violet-600"
                  id="confirmPasswordToggle"
                  role="button"
                  tabindex="0"
                  aria-label="Show confirm password"
                  aria-controls="confirm_password"
                  aria-pressed="false"
                  data-toggle-password="confirm_password"></i>
              </div>
              <div id="confirmFeedback" class="text-xs text-slate-500"></div>
            </div>

            <div class="flex items-start gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
              <input type="checkbox"
                class="auth-terms-checkbox mt-1 h-4 w-4 rounded border-slate-300 text-violet-600 focus:ring-violet-500"
                id="terms"
                name="terms"
                required>
              <label class="auth-terms-label text-sm leading-6 text-slate-600" for="terms">
                I agree to the <a href="/terms" target="_blank" class="font-semibold text-violet-600 hover:text-violet-700">Terms & Conditions</a>
                and <a href="/privacy" target="_blank" class="font-semibold text-violet-600 hover:text-violet-700">Privacy Policy</a>
              </label>
            </div>

            <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-violet-600 px-4 py-3.5 text-sm font-semibold text-white shadow-lg shadow-violet-600/20 transition-all duration-200 hover:-translate-y-0.5 hover:bg-violet-700 focus:outline-none focus:ring-4 focus:ring-violet-500/30 active:scale-[0.98]" id="submitBtn">
              <i class="lucide lucide-user-plus h-5 w-5"></i>
              Create Account
            </button>
          </form>

          {% if enable_firebase_oauth %}
          <div class="my-6 flex items-center gap-3">
            <div class="h-px flex-1 bg-slate-200"></div>
            <div class="inline-flex items-center gap-2 rounded-full bg-slate-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">
              <i class="lucide lucide-sparkles h-3.5 w-3.5 text-violet-500"></i>
              Continue with
            </div>
            <div class="h-px flex-1 bg-slate-200"></div>
          </div>

          <div id="auth-buttons" class="auth-oauth-buttons grid grid-cols-3 gap-3">
            <button type="button"
              class="auth-oauth-btn inline-flex h-12 w-full items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:border-violet-200 hover:bg-violet-50 hover:text-violet-700"
              id="auth-google-btn"
              title="Sign up with Google"
              aria-label="Sign up with Google">
              <i class="lucide lucide-log-in h-5 w-5"></i>
            </button>
            <button type="button"
              class="auth-oauth-btn inline-flex h-12 w-full items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:border-violet-200 hover:bg-violet-50 hover:text-violet-700"
              id="auth-facebook-btn"
              title="Sign up with Facebook"
              aria-label="Sign up with Facebook">
              <i class="lucide lucide-users h-5 w-5"></i>
            </button>
            <button type="button"
              class="auth-oauth-btn inline-flex h-12 w-full items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:border-violet-200 hover:bg-violet-50 hover:text-violet-700"
              id="auth-guest-btn"
              title="Continue as Guest"
              aria-label="Continue as guest">
              <i class="lucide lucide-user h-5 w-5"></i>
            </button>
          </div>

          <div class="auth-buttons auth-buttons-hidden">
            <div id="firebaseui-auth-container"
              class="firebaseui-auth-container"
              {% if oauth_redirect %}data-redirect-url="{{ oauth_redirect }}"{% endif %}></div>
          </div>
          {% endif %}

          <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <p class="text-sm text-slate-600">
              Already have an account?
              <a href="/login{% if oauth_redirect %}?redirect={{ oauth_redirect|url_encode }}{% endif %}" class="inline-flex items-center gap-1 font-semibold text-violet-600 hover:text-violet-700">
                Sign in here
                <i class="lucide lucide-arrow-right h-4 w-4"></i>
              </a>
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

{# Register form handler #}
<script src="{{ asset('/assets/js/dist/auth/register.js') }}"
  defer
  type="module"></script>

{# Account conflict resolution modal #}
{% include 'auth/account-conflict-modal.twig' %}
{% endblock %}
