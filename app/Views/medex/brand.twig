{% extends 'layout.twig' %}

{% block title %}
    {{ brand.name }} - {{ current_lang == 'bn' ? 'হার্বাল মেডিসিন ব্র্যান্ড' : 'Herbal Medicine Brand' }} - {{ app_settings.site_name }}
{% endblock %}

{% block meta_description %}
    {{ current_lang == 'bn' ? brand.name ~ ' - একটি বাংলাদেশি হার্বাল মেডিসিন ব্র্যান্ড। জেনেরিক নাম, শক্তি, ডোজ ফর্ম ও দাম সহ বিস্তারিত তথ্য।' : brand.name ~ ' - A Bangladeshi herbal medicine brand by ' ~ (company.name|default('Pharmaceutical Company')) ~ '. Find generic name, strength, dosage form, and pricing.' }}
{% endblock %}

{% block meta_keywords %}medicine, {{ brand.name }}, {{ company.name|default('pharmaceutical') }}, herbal drug, generic medicine, drug information, Bangladesh medicine, {{ brand.generic|striptags|trim|default('') }}{% endblock %}

{% block og_image %}{{ app_settings.site_logo|default(url ~ 'assets/images/default-og-image.png') }}{% endblock %}

{% set breadcrumbs = [
    { label: 'MedEx', url: '/medex', icon: 'capsule' },
    { label: company.name|default('Company'), url: company._id ? '/medex/company/' ~ company._id : '/medex', icon: 'building' },
    { label: brand.name, icon: 'capsule' }
] %}
{% set page_schema = {
    '@context': 'https://schema.org',
    '@type': 'Product',
    'name': brand.name,
    'description': (brand.generic|default(brand.name ~ ' herbal medicine brand'))|striptags|trim|slice(0, 200),
    'url': current_url,
    'category': 'Herbal Medicine',
    'manufacturer': {
        '@type': 'Organization',
        'name': company.name|default('')
    },
    'isPartOf': {
        '@type': 'MedicalWebPage',
        'name': app_settings.site_name
    }
} %}
{% if brand.unit_price is defined and brand.unit_price is not empty %}
  {% set page_schema = page_schema|merge({
    'offers': {
      '@type': 'Offer',
      'price': brand.unit_price|float,
      'priceCurrency': 'BDT',
      'availability': 'https://schema.org/InStock'
    }
  }) %}
{% endif %}
{% block schema %}
  <script type="application/ld+json">
{{ page_schema|schema_json }}
  </script>
{% endblock %}

{% block content %}
<div class="container py-4">

{# Brand Header Card #}
<div class="medex-brand-header">
    <div class="row align-items-center">
        <div class="col-md-8">
            <div class="d-flex align-items-center mb-2">
                <i class="bi bi-capsule dosage-form-icon me-3"></i>
                <h1 id="medexBrandName" class="medex-brand-title mb-0">{{ brand.name }}</h1>
            </div>
            <span id="medexBrandStatus" class="text-muted small d-block mb-2">Loading live brand data…</span>
            {# Language indicator — visibility toggled by JS when BN data is available #}
            <div class="d-flex align-items-center gap-2 mt-2 mb-2" id="medexBrandLangToggle" style="display:none;">
                <small class="text-muted me-1" data-i18n-en="Bangla content available" data-i18n-bn="বাংলা কন্টেন্ট উপলব্ধ">{{ current_lang == 'bn' ? 'বাংলা কন্টেন্ট উপলব্ধ' : 'Bangla content available' }}</small>
                <i class="bi bi-check-circle-fill text-success small"></i>
            </div>
            {% if brand.generic %}
                <h4 id="medexBrandGeneric" class="medex-brand-meta">
                    <i class="bi bi-basket me-1"></i>
                    {{ brand.generic|striptags|trim }}
                </h4>
            {% endif %}
            {% if company %}
            <div class="mt-3">
                <a id="medexBrandCompanyLink" href="/medex/company/{{ company._id }}" class="medex-brand-company-badge">
                    <i class="bi bi-building"></i>
                    {{ company.name }}
                </a>
            </div>
            {% endif %}
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            {% if brand.unit_price is defined or brand.strip_price is defined %}
                <small class="text-muted d-block mb-2" data-i18n-en="Pricing" data-i18n-bn="মূল্য">Pricing</small>
                {% if brand.unit_price is defined and brand.unit_price is not empty %}
                    <span class="medex-price-badge">{{ brand.unit_price }}</span>
                {% endif %}
                {% if brand.strip_price is defined and brand.strip_price is not empty %}
                    <span class="medex-price-badge medex-price-badge--strip ms-1">{{ brand.strip_price }}</span>
                {% endif %}
            {% else %}
                <small class="text-muted d-block mb-2" data-i18n-en="Pricing" data-i18n-bn="মূল্য">Pricing</small>
                <span class="badge bg-light text-dark border">Contact supplier</span>
            {% endif %}

            <div class="mt-3">
                <button id="medex-refresh-button" type="button" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-arrow-repeat"></i> <span data-i18n-en="Refresh MedEx" data-i18n-bn="রিফ্রেশ মেডএক্স">{{ current_lang == 'bn' ? 'রিফ্রেশ মেডএক্স' : 'Refresh MedEx' }}</span>
                </button>
                <div id="medex-refresh-feedback" class="text-muted small mt-2"></div>
            </div>
        </div>
    </div>
</div>

{# Section Navigation (optional pills) #}
{% set sectionKeys = sections|keys %}
{% if sectionKeys|length > 1 %}
<div class="medex-section-nav">
    <span class="text-muted small fw-bold me-2" data-i18n-en="Quick jump:" data-i18n-bn="দ্রুত যান:">{{ current_lang == 'bn' ? 'দ্রুত যান:' : 'Quick jump:' }}</span>
    {% for key, section in sections %}
        <a href="#section-{{ key }}" class="medex-section-nav-btn" onclick="event.preventDefault(); document.getElementById('section-{{ key }}').scrollIntoView({behavior:'smooth'});">
            <i class="bi bi-chevron-right"></i> {{ section.title_en|length > 20 ? section.title_en|slice(0, 20) ~ '...' : section.title_en }}
        </a>
    {% endfor %}
</div>
{% endif %}

{# Content Sections (Accordion) #}
<div class="row">
    <div class="col-12">
        {% for key, section in sections %}
            <div class="medex-section{% if loop.first %} active{% endif %}" id="section-{{ key }}">
                <div class="medex-section-header" onclick="toggleSection('{{ key }}')" tabindex="0" role="button" aria-expanded="{{ loop.first ? 'true' : 'false' }}">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-chevron-down section-toggle" id="toggle-{{ key }}"></i>
                        <h6>{{ section.title_en }}</h6>
                        <span class="medex-section-badge">{{ section.title_bn }}</span>
                    </div>
                </div>
                <div class="medex-section-content{% if loop.first %} active{% endif %}" id="content-{{ key }}">
                    {% if section.content is not empty and section.content != '' %}
                        {{ section.content|nl2br }}
                    {% else %}
                        <p class="medex-section-empty">
                            <i class="bi bi-info-circle"></i>
                            Detailed information for this section is not yet available. Please check back later or contact the manufacturer.
                        </p>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>

{# Navigation Back #}
<nav class="mt-5 pt-4 border-top" aria-label="Page navigation">
    <div class="d-flex flex-wrap justify-content-between align-items-center">
        {% if company %}
        <a href="/medex/company/{{ company._id }}" class="medex-back-link">
            <i class="bi bi-arrow-left"></i> <span data-i18n-en="Back to {{ company.name }}" data-i18n-bn="{{ company.name }} এ ফিরে যান">{{ current_lang == 'bn' ? company.name ~ ' এ ফিরে যান' : 'Back to ' ~ company.name }}</span>
        </a>
        {% else %}
        <a href="/medex" class="medex-back-link">
            <i class="bi bi-arrow-left"></i> <span data-i18n-en="Back to Companies" data-i18n-bn="কোম্পানিতে ফিরে যান">{{ current_lang == 'bn' ? 'কোম্পানিতে ফিরে যান' : 'Back to Companies' }}</span>
        </a>
        {% endif %}
        <a href="/medex" class="medex-back-link">
            <i class="bi bi-house"></i> <span data-i18n-en="All Companies" data-i18n-bn="সকল কোম্পানি">{{ current_lang == 'bn' ? 'সকল কোম্পানি' : 'All Companies' }}</span>
        </a>
    </div>
</nav>

</div>
{% endblock %}

{% block extra_styles %}
<link rel="stylesheet" href="{{ asset('/assets/css/medex.css') }}">
<link rel="stylesheet" href="{{ asset('/assets/css/medex-theme.css') }}">
{% endblock %}

{% block extra_head %}
    {% set medexLangUrlBase = current_url|replace({'?lang=bn':'?','&lang=bn':'','?lang=en':'?','&lang=en':''})|replace({'?&':'?','&&':'&'})|trim('?&') %}
    {% set medexLangQuery = medexLangUrlBase matches('/\\?/') ? '&' : '?' %}
    <link rel="alternate" hreflang="en" href="{{ medexLangUrlBase }}{{ medexLangQuery }}lang=en">
    <link rel="alternate" hreflang="bn" href="{{ medexLangUrlBase }}{{ medexLangQuery }}lang=bn">
    <link rel="alternate" hreflang="x-default" href="{{ medexLangUrlBase }}{{ medexLangQuery }}lang=en">
{% endblock %}

{% block extra_scripts %}
<script src="{{ asset('/assets/js/medex-brand-page.js') }}"></script>
<script src="{{ asset('/assets/js/medex-route-fetch.js') }}"></script>
{% endblock %}

