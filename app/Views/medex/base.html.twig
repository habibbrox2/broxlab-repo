{% extends 'layout.twig' %}

{% block title %}
    {{ title|default(current_lang == 'bn' ? 'মেডএক্স - হার্বাল ফার্মাসিউটিক্যালস' : 'MedEx - Herbal Pharmaceuticals') }} - {{ app_settings.site_name }}
{% endblock %}

{% block meta_description %}
    {% if current_lang == 'bn' %}
        বাংলাদেশি হার্বাল ফার্মাসিউটিক্যাল কোম্পানি, ব্র্যান্ড, ও ডেটা আপডেট সহ MedEx ডেটাবেস দেখুন।
    {% else %}
        Explore Bangladesh herbal pharmaceutical companies, product brands, and MedEx dataset updates.
    {% endif %}
{% endblock %}

{% block extra_styles %}
<link rel="stylesheet" href="{{ asset('/assets/css/medex.css') }}">
<link rel="stylesheet" href="{{ asset('/assets/css/medex-theme.css') }}">
{% endblock %}

{% block extra_head %}
    {% set medexLangUrlBase = current_url|replace({'?lang=bn':'?','&lang=bn':'','?lang=en':'?','&lang=en':''})|replace({'?&':'?','&&':'&'})|trim('?&') %}
    {% set medexLangQuery = medexLangUrlBase contains '?' ? '&' : '?' %}
    <link rel="alternate" hreflang="en" href="{{ medexLangUrlBase }}{{ medexLangQuery }}lang=en">
    <link rel="alternate" hreflang="bn" href="{{ medexLangUrlBase }}{{ medexLangQuery }}lang=bn">
    <link rel="alternate" hreflang="x-default" href="{{ medexLangUrlBase }}{{ medexLangQuery }}lang=en">
{% endblock %}

{% block content %}
<div class="container py-4">
    {# Page Header #}
    <div class="row mb-4">
        <div class="col-12">
            {% set medexHeading = current_lang == 'bn' ? 'মেডএক্স ডেটাবেস' : 'MedEx Database' %}
            {% set medexSubheader = current_lang == 'bn' ? 'বাংলাদেশের হার্বাল ফার্মাসিউটিক্যাল কোম্পানির ডেটাবেস' : 'Herbal Pharmaceutical Companies in Bangladesh' %}
            <h1 class="h2 mb-0">
                <i class="bi bi-capsule me-2 text-primary"></i>
                {{ title|default(medexHeading) }}
            </h1>
            <p class="text-muted mt-2 mb-0">
                {{ medexSubheader }}
            </p>

            <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                {% for code,label in available_languages %}
                    <a href="{{ medexLangUrlBase }}{{ medexLangQuery }}lang={{ code }}" class="btn btn-sm {% if current_lang == code %}btn-primary{% else %}btn-outline-secondary{% endif %}">
                        {{ label }}
                    </a>
                {% endfor %}
            </div>
        </div>
    </div>

    {# Content block #}
    {% block page_content %}{% endblock %}
</div>

<div id="medex-collector-banner" style="position:fixed;bottom:18px;right:18px;z-index:1050;max-width:320px;box-shadow:0 8px 20px rgba(0,0,0,.16);border:1px solid rgba(0,0,0,.08);background:#fff;padding:14px 16px;border-radius:16px;font-family:system-ui, sans-serif;display:none;">
    <div style="display:flex;align-items:center;gap:12px;">
        <span style="font-size:1.2rem;">🧪</span>
        <div style="flex:1;">
            <strong>MedEx Browser Collector</strong>
            <div style="font-size:.86rem;color:#555;">Run the JS scraper from this page or open the dedicated collector UI.</div>
        </div>
    </div>
    <div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;">
        <a href="/medex-collector.html" class="btn btn-sm btn-success" style="flex:1;min-width:120px;">Open Collector</a>
        <button id="medex-collector-launch" type="button" class="btn btn-sm btn-outline-primary" style="flex:1;min-width:120px;">Run Collector</button>
    </div>
    <div id="medex-collector-banner-log" style="margin-top:10px;font-size:.78rem;color:#444;display:none;"></div>
</div>

<script src="{{ asset('/assets/js/medex-scraper.js') }}"></script>
<script>
(function() {
    if (!window.location || typeof window.location.pathname !== 'string') {
        return;
    }

    const path = window.location.pathname;
    if (!path.startsWith('/medex')) {
        return;
    }

    const storageKey = 'medex-auto-refresh-last-run';
    const intervalMs = 12 * 60 * 60 * 1000; // 12 hours
    const lastRun = parseInt(localStorage.getItem(storageKey) || '0', 10);
    if (Number.isFinite(lastRun) && Date.now() - lastRun < intervalMs) {
        return;
    }

    window.addEventListener('load', function() {
        localStorage.setItem(storageKey, Date.now().toString());
        const url = '/api/medex/refresh-all?auto=1';

        console.info('MedEx auto-refresh triggered for path:', path);
        console.debug('MedEx auto-refresh request URL:', url);

        fetch(url, {
            method: 'GET',
            credentials: 'same-origin',
            cache: 'no-store',
        })
        .then(function(response) {
            console.debug('MedEx auto-refresh response status:', response.status, response.statusText);
            if (!response.ok) {
                throw new Error('Network response was not ok: ' + response.status + ' ' + response.statusText);
            }
            return response.json();
        })
        .then(function(data) {
            console.info('MedEx auto refresh started successfully.');
            console.group('MedEx auto-refresh payload');
            console.log(data);
            console.groupEnd();
        })
        .catch(function(error) {
            console.warn('MedEx auto refresh failed:', error);
        });
    });
})();
</script>
<script>
(function() {
    if (!window.location || typeof window.location.pathname !== 'string') {
        return;
    }

    const path = window.location.pathname;
    if (!path.startsWith('/medex') || path === '/medex-collector.html' || path.startsWith('/medex-collector')) {
        return;
    }

    if (!window.MedexScraper) {
        console.info('MedEx scraper library not available; skipping browser collection.');
        return;
    }

    const collectionKey = 'medex-auto-collection-last-run';
    const dataCheckKey = 'medex-auto-collection-last-check';
    const cooldownMs = 30 * 24 * 60 * 60 * 1000; // 30 days
    const lastCollection = parseInt(localStorage.getItem(collectionKey) || '0', 10);
    const lastCheck = parseInt(localStorage.getItem(dataCheckKey) || '0', 10);

    async function isMedexDataMissing() {
        try {
            const response = await fetch('/api/medex/companies', {
                method: 'GET',
                credentials: 'same-origin',
                cache: 'no-store',
                headers: {
                    'Accept': 'application/json',
                },
            });

            if (!response.ok) {
                console.warn('MedEx health check failed with status', response.status);
                return true;
            }

            const json = await response.json().catch(() => ({}));
            if (!json.success) {
                console.warn('MedEx health check responded without success:', json);
                return true;
            }

            const count = Number(json.count || 0);
            const lastUpdated = String(json.last_updated || '').trim();
            if (count < 5 || !lastUpdated) {
                return true;
            }

            return false;
        } catch (err) {
            console.warn('MedEx health check exception:', err);
            return true;
        }
    }

    async function runAutoCollection() {
        if (Number.isFinite(lastCollection) && Date.now() - lastCollection < cooldownMs) {
            console.info('MedEx auto-collection deferred; last collection was within 30 days.');
            return;
        }

        localStorage.setItem(collectionKey, Date.now().toString());
        console.info('MedEx browser-side auto-collection starting on path:', path);

        const scraper = new window.MedexScraper({ rate: 700 });
        scraper.on('log', (msg) => console.info('[MedExScraper]', msg));
        scraper.on('progress', (data) => console.debug('[MedExScraper]', data));
        scraper.on('error', (err) => console.warn('[MedExScraper] error:', err));
        scraper.on('complete', async (result) => {
            console.info('[MedExScraper] collection complete:', result.count, 'companies found.');
            try {
                const uploadResult = await scraper.saveToServer({ auto: true, page: path }, { retries: 4, backoffBase: 1000, silent: true });
                console.info('[MedExScraper] upload complete:', uploadResult);
            } catch (uploadError) {
                console.warn('[MedExScraper] upload failed:', uploadError);
            }
        });

        scraper.run();
    }

    async function checkAndCollect() {
        if (Number.isFinite(lastCheck) && Date.now() - lastCheck < cooldownMs && Number.isFinite(lastCollection) && Date.now() - lastCollection < cooldownMs) {
            console.info('MedEx health check and collection cooldown still active.');
            return;
        }

        const missing = await isMedexDataMissing();
        localStorage.setItem(dataCheckKey, Date.now().toString());

        if (!missing) {
            console.info('MedEx auto-collection skipped; dataset looks healthy.');
            return;
        }

        await runAutoCollection();
    }

    checkAndCollect();
})();
</script>
<script>
(function() {
    const path = window.location.pathname || '';
    if (!path.startsWith('/medex') || path === '/medex-collector.html') {
        return;
    }

    const banner = document.getElementById('medex-collector-banner');
    const launchButton = document.getElementById('medex-collector-launch');
    const bannerLog = document.getElementById('medex-collector-banner-log');
    if (!banner || !launchButton) {
        return;
    }

    banner.style.display = 'block';

    launchButton.addEventListener('click', async function () {
        if (typeof window.MedexScraper !== 'function') {
            bannerLog.textContent = 'Collector script not loaded yet.';
            return;
        }

        launchButton.disabled = true;
        bannerLog.style.display = 'block';
        bannerLog.textContent = 'Starting collector...';

        const scraper = new window.MedexScraper({ rate: 700 });
        scraper.on('log', (msg) => {
            bannerLog.textContent = msg;
        });
        scraper.on('error', (err) => {
            bannerLog.textContent = 'Error: ' + (err.message || JSON.stringify(err));
            launchButton.disabled = false;
        });
        scraper.on('complete', async (result) => {
            bannerLog.textContent = 'Complete: ' + (result.count || 0) + ' companies';
            try {
                const uploadResult = await scraper.saveToServer({ auto: true, page: path }, { retries: 4, backoffBase: 1000, silent: true });
                bannerLog.textContent = 'Saved: ' + (uploadResult.response?.saved || uploadResult.response?.success ? 'yes' : 'no');
            } catch (uploadError) {
                bannerLog.textContent = 'Upload failed: ' + (uploadError.message || uploadError);
            }
            launchButton.disabled = false;
        });

        await scraper.run();
    });
})();
</script>
{% endblock %}
