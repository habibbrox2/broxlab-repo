{% extends 'medex/base.html.twig' %}

{% block extra_styles %}
{{ parent() }}
<style>
/* Additional page-specific tweaks if needed */
</style>
{% endblock %}

{% block page_content %}

{# Brand Header Card #}
<div class="medex-brand-header">
    <div class="row align-items-center">
        <div class="col-md-8">
            <div class="d-flex align-items-center mb-2">
                <i class="bi bi-capsule dosage-form-icon me-3"></i>
                <h1 class="medex-brand-title mb-0">{{ brand.name }}</h1>
            </div>
            {% if brand.generic %}
                <h4 class="medex-brand-meta">
                    <i class="bi bi-basket me-1"></i>
                    {{ brand.generic|striptags|trim }}
                </h4>
            {% endif %}
            {% if company %}
            <div class="mt-3">
                <a href="/medex/company/{{ company._id }}" class="medex-brand-company-badge">
                    <i class="bi bi-building"></i>
                    {{ company.name }}
                </a>
            </div>
            {% endif %}
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            {% if brand.unit_price is defined or brand.strip_price is defined %}
                <small class="text-muted d-block mb-2">Pricing</small>
                {% if brand.unit_price is defined and brand.unit_price is not empty %}
                    <span class="medex-price-badge">{{ brand.unit_price }}</span>
                {% endif %}
                {% if brand.strip_price is defined and brand.strip_price is not empty %}
                    <span class="medex-price-badge medex-price-badge--strip ms-1">{{ brand.strip_price }}</span>
                {% endif %}
            {% else %}
                <small class="text-muted d-block mb-2">Pricing</small>
                <span class="badge bg-light text-dark border">Contact supplier</span>
            {% endif %}

            <div class="mt-3">
                <button id="medex-refresh-button" type="button" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-arrow-repeat"></i> Refresh MedEx
                </button>
                <div id="medex-refresh-feedback" class="text-muted small mt-2"></div>
            </div>
        </div>
    </div>
</div>

{# Section Navigation (optional pills) #}
{% set sectionKeys = sections|keys %}
{% if sectionKeys|length > 1 %}
<div class="medex-section-nav">
    <span class="text-muted small fw-bold me-2">Quick jump:</span>
    {% for key, section in sections %}
        <a href="#section-{{ key }}" class="medex-section-nav-btn" onclick="event.preventDefault(); document.getElementById('section-{{ key }}').scrollIntoView({behavior:'smooth'});">
            <i class="bi bi-chevron-right"></i> {{ section.title_en|length > 20 ? section.title_en|slice(0, 20) ~ '...' : section.title_en }}
        </a>
    {% endfor %}
</div>
{% endif %}

{# Content Sections (Accordion) #}
<div class="row">
    <div class="col-12">
        {% for key, section in sections %}
            <div class="medex-section{% if loop.first %} active{% endif %}" id="section-{{ key }}">
                <div class="medex-section-header" onclick="toggleSection('{{ key }}')" tabindex="0" role="button" aria-expanded="{{ loop.first ? 'true' : 'false' }}">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-chevron-down section-toggle" id="toggle-{{ key }}"></i>
                        <h6>{{ section.title_en }}</h6>
                        <span class="medex-section-badge">{{ section.title_bn }}</span>
                    </div>
                </div>
                <div class="medex-section-content{% if loop.first %} active{% endif %}" id="content-{{ key }}">
                    {% if section.content is not empty and section.content != '' %}
                        {{ section.content|nl2br }}
                    {% else %}
                        <p class="medex-section-empty">
                            <i class="bi bi-info-circle"></i>
                            Detailed information for this section is not yet available. Please check back later or contact the manufacturer.
                        </p>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>

{# Navigation Back #}
<nav class="mt-5 pt-4 border-top" aria-label="Page navigation">
    <div class="d-flex flex-wrap justify-content-between align-items-center">
        <a href="/medex/company/{{ company._id }}" class="medex-back-link">
            <i class="bi bi-arrow-left"></i> Back to {{ company.name }}
        </a>
        <a href="/medex" class="medex-back-link">
            <i class="bi bi-house"></i> All Companies
        </a>
    </div>
</nav>

{% endblock %}

{% block extra_scripts %}
<script>
function toggleSection(key) {
    const content = document.getElementById('content-' + key);
    const toggle = document.getElementById('toggle-' + key);
    const isActive = content.classList.contains('active');

    // Close all sections first (optional: comment out to allow multiple open)
    document.querySelectorAll('.medex-section-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.section-toggle').forEach(el => el.classList.remove('rotated'));

    // Then toggle this one
    if (!isActive) {
        content.classList.add('active');
        toggle.classList.add('rotated');
    }
}

function expandAll() {
    document.querySelectorAll('.medex-section-content').forEach(el => el.classList.add('active'));
    document.querySelectorAll('.section-toggle').forEach(el => el.classList.add('rotated'));
}

function collapseAll() {
    document.querySelectorAll('.medex-section-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.section-toggle').forEach(el => el.classList.remove('rotated'));
}

document.addEventListener('DOMContentLoaded', function() {
    // Ensure first section is open
    // optional init

    const refreshButton = document.getElementById('medex-refresh-button');
    if (refreshButton) {
        refreshButton.addEventListener('click', function () {
            sendMedexRefreshRequest(this);
        });
    }
});

async function sendMedexRefreshRequest(button) {
    button.disabled = true;
    const originalText = button.innerHTML;
    button.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Refreshing...';

    const feedback = document.getElementById('medex-refresh-feedback');
    if (feedback) {
        feedback.textContent = '';
    }

    try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
        const body = new URLSearchParams({ csrf_token: csrfToken }).toString();

        const response = await fetch('/api/medex/refresh', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-CSRF-Token': csrfToken,
            },
            body,
        });

        const data = await response.json();
        if (!response.ok || !data.success) {
            throw new Error(data.error || 'Refresh failed');
        }

        if (feedback) {
            feedback.textContent = 'Refresh completed successfully.';
            setTimeout(() => {
                feedback.textContent = '';
            }, 5000);
        }
    } catch (error) {
        if (feedback) {
            feedback.textContent = String(error.message || 'Refresh failed');
        }
        console.error('MedEx refresh failed:', error);
    } finally {
        button.disabled = false;
        button.innerHTML = originalText;
    }
}
</script>
{% endblock %}

