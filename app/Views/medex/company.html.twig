{% extends 'medex/base.html.twig' %}

{% block page_content %}

{# Company Header with gradient background #}
<div class="medex-page-header">
    <div class="row align-items-center">
        <div class="col-12">
            <div class="d-flex align-items-center flex-wrap">
                <i class="bi bi-building medex-page-icon"></i>
                <div>
                    <h1 class="medex-page-title mb-1">{{ company.name }}</h1>
                    <p class="medex-page-subtitle mb-0">
                        Herbal Pharmaceutical Company
                        {% if company.headquarter %}
                            <span class="ms-2"><i class="bi bi-geo-alt"></i> {{ company.headquarter }}</span>
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

{# Quick Stats Row #}
<div class="row mb-4">
    <div class="col-lg-8">
        <div class="medex-card">
            <div class="medex-card-header">
                <i class="bi bi-info-circle"></i> Company Overview
            </div>
            <div class="medex-card-body">
                {% if company.overview %}
                    <div class="medex-overview-text">{{ company.overview|nl2br }}</div>
                {% endif %}

                <div class="medex-details-grid mt-4">
                    <div class="medex-detail-item">
                        <div class="medex-detail-label">Established</div>
                        <div class="medex-detail-value">{{ company.established|default('N/A') }}</div>
                    </div>
                    <div class="medex-detail-item">
                        <div class="medex-detail-label">Market Share</div>
                        <div class="medex-detail-value">{{ company.market_share|default('N/A') }}</div>
                    </div>
                    <div class="medex-detail-item">
                        <div class="medex-detail-label">Growth</div>
                        <div class="medex-detail-value">{{ company.growth|default('N/A') }}</div>
                    </div>
                    <div class="medex-detail-item">
                        <div class="medex-detail-label">Total Generics</div>
                        <div class="medex-detail-value">{{ company.total_generics|default(company.generics|default(0))|number_format }}</div>
                    </div>
                    <div class="medex-detail-item">
                        <div class="medex-detail-label">Total Brands</div>
                        <div class="medex-detail-value">{{ company.brands|default(brand_count)|number_format }}</div>
                    </div>
                    <div class="medex-detail-item">
                        <div class="medex-detail-label">Headquarter</div>
                        <div class="medex-detail-value small">{{ company.headquarter|default('N/A') }}</div>
                    </div>
                </div>

                {% if company.contact or company.fax %}
                <div class="mt-4 pt-3 border-top">
                    <div class="row g-3">
                        {% if company.contact %}
                        <div class="col-sm-6">
                            <label class="text-muted small fw-bold"><i class="bi bi-telephone me-1"></i>Contact</label>
                            <div class="fw-semibold small">{{ company.contact }}</div>
                        </div>
                        {% endif %}
                        {% if company.fax %}
                        <div class="col-sm-6">
                            <label class="text-muted small fw-bold"><i class="bi bi-fax me-1"></i>Fax</label>
                            <div class="fw-semibold small">{{ company.fax }}</div>
                        </div>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="medex-stats-card">
            <div class="medex-stats-number">{{ brand_count }}</div>
            <div class="medex-stats-label">Total Brands</div>
            <a href="#brands-section" class="btn btn-outline-success btn-sm mt-3">
                <i class="bi bi-capsule me-1"></i> View Products
            </a>
        </div>

        {% if company.headquarter_url %}
        <div class="medex-location-card">
            <a href="{{ company.headquarter_url }}" target="_blank" rel="noopener" class="text-decoration-none">
                <img src="https://image.thum.io/get/width=400/crop=800/300?{{ company.headquarter|url_encode }}" 
                     alt="Location map" class="medex-location-map" onerror="this.style.display='none'">
                <div class="medex-location-btn">
                    <i class="bi bi-geo-alt me-1"></i> Open in Google Maps
                </div>
            </a>
        </div>
        {% endif %}
    </div>
</div>

{# Back button #}
<div class="mb-4">
    <a href="/medex" class="medex-back-link">
        <i class="bi bi-arrow-left"></i> Back to all Companies
    </a>
</div>

{# Brands List Section #}
<div class="row" id="brands-section">
    <div class="col-12">
        <div class="medex-card">
            <div class="medex-card-header">
                <i class="bi bi-capsule"></i>
                Products & Brands
                <span class="badge bg-success float-end">{{ brand_count }}</span>
            </div>
            <div class="medex-card-body p-0">
                {% if brands is not empty %}
                <div class="medex-table-wrapper">
                    <table class="medex-table">
                        <thead>
                            <tr>
                                <th scope="col">Brand Name</th>
                                <th scope="col">Generic Name</th>
                                <th scope="col" class="text-center">Strength</th>
                                <th scope="col" class="text-center">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for brand in brands %}
                            <tr class="medex-hover-lift">
                                <td>
                                    <a href="/medex/brand/{{ brand._id }}" class="text-decoration-none fw-semibold medex-brand-name">
                                        <i class="bi bi-capsule me-1 text-success"></i>
                                        {{ brand.name }}
                                    </a>
                                </td>
                                <td class="medex-generic-name">
                                    {{ brand.generic|striptags|trim|nl2br }}
                                </td>
                                <td class="text-center">
                                    {% set genericText = brand.generic|striptags %}
                                    {% if genericText matches '/\d+\\s*(mg|g|mcg|ml)/i' %}
                                        <span class="medex-badge medex-badge--strength">
                                            {{ genericText|regex_find('/(\d+\\s*[a-zA-Z]+)/')[0]|default('Varies') }}
                                        </span>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    <a href="/medex/brand/{{ brand._id }}" class="medex-btn medex-btn--details">
                                        <i class="bi bi-file-medical"></i> View
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="medex-empty-state">
                    <i class="bi bi-capsule"></i>
                    <h4>No Brands Listed</h4>
                    <p>No brands are currently available for this company.</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# Bottom back link #}
<div class="mt-5 mb-4">
    <a href="/medex" class="medex-back-link">
        <i class="bi bi-arrow-left"></i> Back to all Companies
    </a>
</div>

{% endblock %}
