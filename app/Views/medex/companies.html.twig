{% extends 'medex/base.html.twig' %}

{% block page_content %}
{% set labelTotalCompanies = current_lang == 'bn' ? 'মোট কোম্পানি' : 'Total Companies' %}
{% set labelTotalBrands = current_lang == 'bn' ? 'মোট ব্র্যান্ড' : 'Total Brands' %}
{% set labelLastUpdated = current_lang == 'bn' ? 'শেষ আপডেট' : 'Last Updated' %}
{% set labelDatabaseStatus = current_lang == 'bn' ? 'ডেটাবেসের অবস্থা:' : 'Database Status:' %}
{% set labelSearchPlaceholder = current_lang == 'bn' ? 'কোম্পানি খুঁজুন...' : 'Search companies...' %}
{% set labelFilter = current_lang == 'bn' ? 'ফিল্টার' : 'Filter' %}
{% set labelExport = current_lang == 'bn' ? 'এক্সপোর্ট' : 'Export' %}
{% set labelDetailsPage = current_lang == 'bn' ? 'বিস্তারিত' : 'Details' %}

{# Stats Summary #}
<div class="row mb-4">
    <div class="col-md-4">
        <div class="medex-stats-card">
            <div class="medex-stats-number">{{ total_companies }}</div>
            <div class="medex-stats-label" data-i18n-en="Total Companies" data-i18n-bn="মোট কোম্পানি">{{ labelTotalCompanies }}</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="medex-stats-card">
            <div class="medex-stats-number" id="medexTotalBrands">{{ total_brands|number_format }}</div>
            <div class="medex-stats-label" data-i18n-en="Total Brands" data-i18n-bn="মোট ব্র্যান্ড">{{ labelTotalBrands }}</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="medex-stats-card">
            <div class="medex-stats-number">{{ last_updated ? last_updated|date('M d, Y') : 'N/A' }}</div>
            <div class="medex-stats-label" data-i18n-en="Last Updated" data-i18n-bn="শেষ আপডেট">{{ labelLastUpdated }}</div>
        </div>
    </div>
</div>

{# Info Banner #}
<div class="medex-info-banner" role="alert">
    <div class="d-flex align-items-center">
        <i class="bi bi-info-circle-fill me-3 fs-4"></i>
        <div>
            <strong>{{ labelDatabaseStatus }}</strong>
            <span data-i18n-en="{{ total_companies }} herbal pharmaceutical companies indexed." data-i18n-bn="{{ total_companies|number_format }} টি হার্বাল ফার্মাসিউটিক্যাল কোম্পানি সূচিপত্রভুক্ত">{{ current_lang == 'bn' ? total_companies|number_format ~ ' টি হার্বাল ফার্মাসিউটিক্যাল কোম্পানি সূচিপত্রভুক্ত' : total_companies ~ ' herbal pharmaceutical companies indexed.' }}</span>
            {% if last_updated %}
                <br><small class="text-muted">{{ current_lang == 'bn' ? 'শেষ আপডেট:' : 'Last updated:' }} {{ last_updated|date('M d, Y H:i') }}</small>
            {% endif %}
        </div>
    </div>
</div>

{# Filter Bar (for future search) #}
<div class="medex-filter-bar">
    <div class="input-group" style="flex: 1; min-width: 250px;">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
        <input id="medexSearchInput" type="text" class="form-control medex-filter-input border-start-0" placeholder="{{ labelSearchPlaceholder }}" aria-label="{{ labelSearchPlaceholder }}">
    </div>
    <button id="medexFilterBtn" class="btn btn-outline-secondary" type="button" data-i18n-en="Filter" data-i18n-bn="ফিল্টার">
        <i class="bi bi-funnel me-1"></i> <span data-i18n-en="Filter" data-i18n-bn="ফিল্টার">{{ labelFilter }}</span>
    </button>
    <button id="medexExportBtn" class="btn btn-primary medex-btn--primary" type="button" data-i18n-en="Export" data-i18n-bn="এক্সপোর্ট">
        <i class="bi bi-download me-1"></i> <span data-i18n-en="Export" data-i18n-bn="এক্সপোর্ট">{{ labelExport }}</span>
    </button>
    <a href="/medex/details" class="btn btn-outline-info ms-2" data-i18n-en="Details" data-i18n-bn="বিস্তারিত">
        <i class="bi bi-info-circle me-1"></i> <span data-i18n-en="Details" data-i18n-bn="বিস্তারিত">{{ labelDetailsPage }}</span>
    </a>
</div>
<div class="mt-3 mb-3">
    <div id="medexFetchStatus" class="text-muted">
        Loading latest MedEx data…
    </div>
</div>

{# Companies Card with Table #}
<div class="medex-card">
    <div class="medex-card-header">
        <i class="bi bi-building"></i>
        <span data-i18n-en="Herbal Pharmaceutical Companies" data-i18n-bn="হার্বাল ফার্মাসিউটিক্যাল কোম্পানি">{{ current_lang == 'bn' ? 'হার্বাল ফার্মাসিউটিক্যাল কোম্পানি' : 'Herbal Pharmaceutical Companies' }}</span>
        <span class="badge bg-success float-end">{{ total_companies }}</span>
    </div>
    <div class="medex-card-body p-0">
        <div class="medex-table-wrapper">
            <table class="medex-table">
                <thead>
                    <tr>
                        <th scope="col" class="text-center" style="width: 60px;">#</th>
                        <th scope="col"><span data-i18n-en="Company Name" data-i18n-bn="কোম্পানির নাম">Company Name</span></th>
                        <th scope="col" class="text-center" style="width: 100px;"><span data-i18n-en="Est." data-i18n-bn="প্রতিষ্ঠা">Est.</span></th>
                        <th scope="col" class="text-end" style="width: 120px;"><span data-i18n-en="Generics" data-i18n-bn="জেনেরিকস">Generics</span></th>
                        <th scope="col" class="text-end" style="width: 120px;"><span data-i18n-en="Brands" data-i18n-bn="ব্র্যান্ড">Brands</span></th>
                        <th scope="col" class="text-center" style="width: 120px;"><span data-i18n-en="Actions" data-i18n-bn="অ্যাকশন">Actions</span></th>
                    </tr>
                </thead>
                <tbody id="medexCompaniesTableBody">
                    {% if companies is not empty %}
                        {% for company in companies %}
                        <tr class="medex-hover-lift">
                            <td class="text-center fw-semibold text-muted">
                                {{ (pagination.current_page - 1) * pagination.per_page + loop.index }}
                            </td>
                            <td>
                                <a href="/medex/company/{{ company._id }}" class="company-name text-decoration-none">
                                    <strong>{{ company.name }}</strong>
                                    {% if company.headquarter %}
                                        <br><small class="text-muted"><i class="bi bi-geo-alt me-1"></i>{{ company.headquarter|slice(0, 50) }}{% if company.headquarter|length > 50 %}...{% endif %}</small>
                                    {% endif %}
                                </a>
                            </td>
                            <td class="text-center">
                                <span class="medex-badge medex-badge--established">
                                    {{ company.established|default('N/A') }}
                                </span>
                            </td>
                            <td class="text-end">
                                <span class="medex-badge medex-badge--generics">
                                    {{ company.generics|default(company.total_generics|default(0))|number_format }}
                                </span>
                            </td>
                            <td class="text-end">
                                <span class="medex-badge medex-badge--brands">
                                    {{ company.brands|default(0)|number_format }}
                                </span>
                            </td>
                            <td class="text-center">
                                <a href="/medex/company/{{ company._id }}" class="medex-btn medex-btn--view">
                                    <i class="bi bi-eye"></i> View
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                Loading latest MedEx data…
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# Pagination #}
<div class="medex-pagination-wrap">
    {% include 'medex/partials/_pagination.html.twig' with { pagination: pagination } only %}
</div>

{# Back to top spacing #}
<div class="mb-5"></div>

{% block extra_scripts %}
<script src="{{ asset('/assets/js/medex-route-fetch.js') }}"></script>
{% endblock %}

{% endblock %}
