{% extends 'medex/base.html.twig' %}

{% block page_content %}

{# Stats Summary #}
<div class="row mb-4">
    <div class="col-md-4">
        <div class="medex-stats-card">
            <div class="medex-stats-number">{{ total_companies }}</div>
            <div class="medex-stats-label">Total Companies</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="medex-stats-card">
            <div class="medex-stats-number">{{ total_brands|default(brand_count)|number_format }}</div>
            <div class="medex-stats-label">Total Brands</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="medex-stats-card">
            <div class="medex-stats-number">{{ last_updated ? last_updated|date('M d, Y') : 'N/A' }}</div>
            <div class="medex-stats-label">Last Updated</div>
        </div>
    </div>
</div>

{# Info Banner #}
<div class="medex-info-banner" role="alert">
    <div class="d-flex align-items-center">
        <i class="bi bi-info-circle-fill me-3 fs-4"></i>
        <div>
            <strong>Database Status:</strong>
            {{ total_companies }} herbal pharmaceutical companies indexed.
            {% if last_updated %}
                <br><small class="text-muted">Last updated: {{ last_updated|date('M d, Y H:i') }}</small>
            {% endif %}
        </div>
    </div>
</div>

{# Filter Bar (for future search) #}
<div class="medex-filter-bar">
    <div class="input-group" style="flex: 1; min-width: 250px;">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control medex-filter-input border-start-0" placeholder="Search companies..." aria-label="Search companies">
    </div>
    <button class="btn btn-outline-secondary" type="button" title="Filter" aria-label="Filter">
        <i class="bi bi-funnel me-1"></i> Filter
    </button>
    <button class="btn btn-primary medex-btn--primary" type="button" title="Export" aria-label="Export">
        <i class="bi bi-download me-1"></i> Export
    </button>
</div>

{# Companies Card with Table #}
<div class="medex-card">
    <div class="medex-card-header">
        <i class="bi bi-building"></i>
        Herbal Pharmaceutical Companies
        <span class="badge bg-success float-end">{{ total_companies }}</span>
    </div>
    <div class="medex-card-body p-0">
        {% if companies is not empty %}
        <div class="medex-table-wrapper">
            <table class="medex-table">
                <thead>
                    <tr>
                        <th scope="col" class="text-center" style="width: 60px;">#</th>
                        <th scope="col">Company Name</th>
                        <th scope="col" class="text-center" style="width: 100px;">Est.</th>
                        <th scope="col" class="text-end" style="width: 120px;">Generics</th>
                        <th scope="col" class="text-end" style="width: 120px;">Brands</th>
                        <th scope="col" class="text-center" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for company in companies %}
                    <tr class="medex-hover-lift">
                        <td class="text-center fw-semibold text-muted">
                            {{ (pagination.current_page - 1) * pagination.per_page + loop.index }}
                        </td>
                        <td>
                            <a href="/medex/company/{{ company._id }}" class="company-name text-decoration-none">
                                <strong>{{ company.name }}</strong>
                                {% if company.headquarter %}
                                    <br><small class="text-muted"><i class="bi bi-geo-alt me-1"></i>{{ company.headquarter|slice(0, 50) }}{% if company.headquarter|length > 50 %}...{% endif %}</small>
                                {% endif %}
                            </a>
                        </td>
                        <td class="text-center">
                            <span class="medex-badge medex-badge--established">
                                {{ company.established|default('N/A') }}
                            </span>
                        </td>
                        <td class="text-end">
                            <span class="medex-badge medex-badge--generics">
                                {{ company.generics|default(company.total_generics|default(0))|number_format }}
                            </span>
                        </td>
                        <td class="text-end">
                            <span class="medex-badge medex-badge--brands">
                                {{ company.brands|default(brand_count|default(0))|number_format }}
                            </span>
                        </td>
                        <td class="text-center">
                            <a href="/medex/company/{{ company._id }}" class="medex-btn medex-btn--view">
                                <i class="bi bi-eye"></i> View
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="medex-empty-state">
            <i class="bi bi-inbox"></i>
            <h4>No Companies Found</h4>
            <p>No pharmaceutical companies are currently indexed in the database.</p>
        </div>
        {% endif %}
    </div>
</div>

{# Pagination #}
{% include 'medex/partials/_pagination.html.twig' with { pagination: pagination } only %}

{# Back to top spacing #}
<div class="mb-5"></div>

{% endblock %}
