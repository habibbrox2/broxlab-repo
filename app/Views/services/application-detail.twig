{# templates/services/application-detail.twig #}
{% extends 'layout.twig' %}
{% block title %}Application #{{ application.id }} Details{% endblock %}
{% set breadcrumbs = [
 { 'label': 'Services', 'url': '/services', 'icon': 'award' },
 { 'label': 'My Applications', 'url': '/services/my-applications', 'icon': 'clipboard-list' },
 { 'label': 'Application #' ~ application.id, 'icon': 'file-lines' }
] %}
{% block content %}
 {% set payment_data = payment|default({}) %}
 {% if (payment_data is not iterable or payment_data is empty) and application.application_data is iterable %}
 {% set payment_data = application.application_data._payment|default(application.application_data.payment|default(application.application_data.payment_info|default({}))) %}
 {% endif %}
 <style>
 .hero-gradient {
 background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
 color: #fff;
 }
 .hero-gradient .application-detail-title,
 .hero-gradient .application-detail-subtitle {
 color: #fff;
 }
 .pre-wrap-break {
 white-space: pre-wrap;
 word-break: break-word;
 }
 .word-break-word {
 word-break: break-word;
 }
 .admin-notes-box {
 border: 1px solid rgba(13, 110, 253, 0.16);
 background: #f8fbff;
 }
 .admin-notes-pre {
 margin: 0;
 white-space: pre-wrap;
 word-break: break-word;
 font-family: inherit;
 color: #212529;
 }
 .timeline {
 position: relative;
 margin-left: 1.1rem;
 padding-left: 1.5rem;
 }
 .timeline::before {
 content:"";
 position: absolute;
 left: 0.5rem;
 top: 0;
 bottom: 0;
 width: 2px;
 background: #e9ecef;
 }
 .timeline-item {
 position: relative;
 margin-bottom: 1rem;
 }
 .timeline-item:last-child {
 margin-bottom: 0;
 }
 .timeline-marker {
 position: absolute;
 left: -1.55rem;
 top: 0.05rem;
 width: 1.4rem;
 height: 1.4rem;
 border-radius: 50%;
 display: inline-flex;
 align-items: center;
 justify-content: center;
 box-shadow: 0 0 0 3px #fff;
 z-index: 1;
 }
 .timeline-marker i {
 font-size: 0.72rem;
 }
 .doc-preview-frame {
 width: 100%;
 min-height: 70vh;
 border: 0;
 border-radius: 0.5rem;
 background: #fff;
 }
 .doc-preview-img {
 display: block;
 max-width: 100%;
 max-height: 76vh;
 margin: 0 auto;
 border-radius: 0.5rem;
 object-fit: contain;
 background: #fff;
 }
 </style>
 <!-- Hero Section -->
 <div class="hero-gradient py-5">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="flex items-center justify-between">
 <div>
 <h1 class="text-4xl font-bold mb-2 application-detail-title">Application Details</h1>
 <p class="mb-0 application-detail-subtitle">{{ application.service_name }}</p>
 </div>
 {% set status_colors = {"pending":"warning","processing":"info","approved":"success","rejected":"danger"} %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-{{ status_colors[application.status]|default("secondary") }} text-xs">
 {{ application.status|title }}
 </span>
 </div>
 </div>
 </div>
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <!-- Main Content -->
 <div class="lg:col-span-8">
 <!-- Status Timeline Card -->
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4">
 <div class="p-4">
 <h5 class=" font-bold mb-4">
 <i class="lucide lucide-list-checks text-indigo-600"></i> Application Status
 </h5>
 <div class="timeline">
 <div class="timeline-item">
 <div class="timeline-marker bg-emerald-600">
 <i class="lucide lucide-check text-white"></i>
 </div>
 <div class="timeline-content">
 <p class="mb-1">
 <strong>Submitted</strong>
 </p>
 <small class="text-slate-500">{{ application.created_at|date("M d, Y H:i") }}</small>
 </div>
 </div>
 {% if application.status == 'pending' %}
 <div class="timeline-item">
 <div class="timeline-marker bg-amber-500">
 <i class="lucide lucide-hourglass text-white"></i>
 </div>
 <div class="timeline-content">
 <p class="mb-1">
 <strong>Pending Review</strong>
 </p>
 <small class="text-slate-500">Waiting for admin review...</small>
 </div>
 </div>
 {% elseif application.status == 'processing' %}
 <div class="timeline-item">
 <div class="timeline-marker bg-emerald-600">
 <i class="lucide lucide-refresh-ccw text-white"></i>
 </div>
 <div class="timeline-content">
 <p class="mb-1">
 <strong>Under Processing</strong>
 </p>
 <small class="text-slate-500">Your application is being reviewed...</small>
 </div>
 </div>
 {% elseif application.status == 'approved' %}
 <div class="timeline-item">
 <div class="timeline-marker bg-emerald-600">
 <i class="lucide lucide-check-circle text-white"></i>
 </div>
 <div class="timeline-content">
 <p class="mb-1">
 <strong>Approved</strong>
 {% if approver %}by {{ approver.username }}{% endif %}
 </p>
 <small class="text-slate-500">{{ application.approved_at|date("M d, Y H:i") }}</small>
 </div>
 </div>
 {% elseif application.status == 'rejected' %}
 <div class="timeline-item">
 <div class="timeline-marker bg-red-600">
 <i class="lucide lucide-x-circle text-white"></i>
 </div>
 <div class="timeline-content">
 <p class="mb-1">
 <strong>Rejected</strong>
 </p>
 <small class="text-slate-500">{{ application.updated_at|date("M d, Y H:i") }}</small>
 {% if application.rejection_reason %}
 <p class="mt-2 mb-0">
 <strong class="text-red-600">Reason:</strong> {{ application.rejection_reason }}
 </p>
 {% endif %}
 </div>
 </div>
 {% endif %}
 </div>
 </div>
 </div>
 <!-- Application Data Card -->
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4">
 <div class="p-4">
 <h5 class=" font-bold mb-4">
 <i class="lucide lucide-clipboard text-indigo-600"></i> Submitted Information
 </h5>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 {% for field, value in application.application_data %}
 {% set normalized_field = field|lower %}
 {% if normalized_field not in ['_payment', 'payment', 'payment_info'] %}
 <div class="md:col-span-6 mb-4">                <div class="mb-5">

 {% set field_label = form_field_labels[field]|default(form_field_labels[normalized_field]|default('')) %}
 {% if field_label == '' %}
 {% set field_label = normalized_field == '_documents' ? 'Documents' : (field|replace({'_': ' ', '-': ' '})|title) %}
 {% endif %}
 <label class="small text-slate-500 text-uppercase font-semibold block mb-2">{{ field_label }}</label>
 {% if value is iterable %}
 {% if normalized_field == '_documents' %}
 {% if value|length > 0 %}
 <ul class="mb-0 ps-3">
 {% for doc in value %}
 <li class="mb-1">
 {% set doc_name = doc.name|default('Document ' ~ loop.index) %}
 {% if doc.url|default('') %}
 <div class="flex flex-wrap items-center gap-2">
 <a href="{{ doc.url }}" target="_blank" rel="noopener noreferrer">{{ doc_name }}</a>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-indigo-600 hover:bg-indigo-100 js-doc-preview"
 data-doc-url="{{ doc.url|e("html_attr") }}"
 data-doc-name="{{ doc_name|e("html_attr") }}"
 data-doc-mime="{{ doc.mime_type|default("") |e('html_attr') }}">
 <i class="lucide lucide-eye"></i> Preview
 </button>
 </div>
 {% else %}
 <span class="font-semibold">{{ doc_name }}</span>
 {% endif %}
 </li>
 {% endfor %}
 </ul>
 {% else %}
 <p class="mb-0 text-slate-900">N/A</p>
 {% endif %}
 {% else %}
 <pre class="bg-slate-100 rounded-xl p-2 small mb-0 pre-wrap-break">{{ value|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}</pre>
 {% endif %}
 {% else %}
 <p class="mb-0 text-slate-900 word-break-word">
 {% if value is same as(null) or value is same as('') %}
 N/A
 {% elseif value is same as(true) %}
 Yes
 {% elseif value is same as(false) %}
 No
 {% else %}
 {{ value }}
 {% endif %}
 </p>
 {% endif %}
 </div>
 </div>
 {% endif %}
 {% endfor %}
 </div>
 </div>
 </div>
 {% if payment_data is iterable and payment_data is not empty %}
 {% set payment_status = (payment_data.status|default('submitted'))|lower %}
 {% set payment_status_class = payment_status in ['paid', 'completed', 'success', 'approved'] ? 'success' : (payment_status in ['submitted', 'pending', 'pending_gateway', 'initiated', 'processing'] ? 'warning text-surface-dark' : (payment_status in ['failed', 'rejected', 'cancelled', 'error'] ? 'danger' : 'secondary')) %}
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4">
 <div class="p-4">
 <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
 <h5 class=" font-bold mb-0">
 <i class="lucide lucide-credit-card text-indigo-600"></i> Payment
 </h5>
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-{{ payment_status_class }} px-3 py-2 text-capitalize">{{ payment_data.status|default('Submitted') }}</span>
 </div>

 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 <div class="md:col-span-6">
 <small class="text-slate-500 text-uppercase font-semibold">Mode</small>
 <p class="mb-0 font-semibold text-capitalize">{{ payment_data.mode|default('manual') }}</p>
 </div>
 <div class="md:col-span-6">
 <small class="text-slate-500 text-uppercase font-semibold">Method / Gateway</small>
 <p class="mb-0 font-semibold text-capitalize">{{ payment_data.method|default(payment_data.gateway|default('N/A')) }}</p>
 </div>
 <div class="md:col-span-6">
 <small class="text-slate-500 text-uppercase font-semibold">Sender Number</small>
 <p class="mb-0 font-semibold">{{ payment_data.sender_number|default('N/A') }}</p>
 </div>
 <div class="md:col-span-6">
 <small class="text-slate-500 text-uppercase font-semibold">Payer Name</small>
 <p class="mb-0 font-semibold">{{ payment_data.payer_name|default('N/A') }}</p>
 </div>
 <div class="md:col-span-6">
 <small class="text-slate-500 text-uppercase font-semibold">Transaction ID</small>
 <p class="mb-0 font-semibold">{{ payment_data.transaction_id|default('N/A') }}</p>
 </div>
 <div class="md:col-span-6">
 <small class="text-slate-500 text-uppercase font-semibold">Amount</small>
 <p class="mb-0 font-semibold">
 {{ payment_data.currency|default('BDT') }} {{ payment_data.amount|default(0)|number_format(2, '.', ',') }}
 </p>
 </div>
 {% if payment_data.receiver_account|default('') %}
 <div class="md:col-span-6">
 <small class="text-slate-500 text-uppercase font-semibold">Receiver Account</small>
 <p class="mb-0 font-semibold">{{ payment_data.receiver_account }}</p>
 </div>
 {% endif %}
 {% if payment_data.submitted_at|default('') %}
 <div class="md:col-span-6">
 <small class="text-slate-500 text-uppercase font-semibold">Submitted At</small>
 <p class="mb-0 font-semibold">{{ payment_data.submitted_at|date('M d, Y H:i') }}</p>
 </div>
 {% endif %}
 {% if payment_data.instruction_message|default('') %}
 <div class="col-span-12">
 <small class="text-slate-500 text-uppercase font-semibold">Instruction</small>
 <p class="mb-0">{{ payment_data.instruction_message }}</p>
 </div>
 {% endif %}
 </div>

 <details class="mt-4">
 <summary class="small font-semibold text-indigo-600 cursor-pointer">View Raw Payment JSON</summary>
 <pre class="bg-slate-100 rounded-xl p-3 small mt-2 mb-0">{{ payment_data|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}</pre>
 </details>
 </div>
 </div>
 {% endif %}
 <!-- Admin Notes Card -->
 {% if application.admin_notes %}
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4">
 <div class="p-4">
 <h5 class=" font-bold mb-3">
 <i class="lucide lucide-files text-indigo-600"></i> Admin Notes
 </h5>
 <div class="p-4 rounded-lg bg-neutral-50 text-neutral-600 border border-neutral-200 rounded-xl mb-0 admin-notes-box">
 <pre class="admin-notes-pre">{{ application.admin_notes }}</pre>
 </div>
 </div>
 </div>
 {% endif %}
 <!-- Audit Log -->
 {% if audit_log and audit_log|length > 0 %}
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl">
 <div class="p-4">
 <h5 class=" font-bold mb-4">
 <i class="lucide lucide-clock-history text-indigo-600"></i> Audit Log
 </h5>
 <div class="overflow-x-auto">
 <table class="table align-middle mb-0">
 <thead class="table-light">
 <tr>
 <th class="ps-0">
 <i class="lucide lucide-calendar"></i> Date
 </th>
 <th>
 <i class="lucide lucide-list-checks"></i> Action
 </th>
 <th>
 <i class="lucide lucide-user"></i> User
 </th>
 <th class="text-right pe-0">Details</th>
 </tr>
 </thead>
 <tbody>
 {% for log in audit_log %}
 <tr>
 <td class="ps-0">
 <small>{{ log.created_at|date("M d, H:i") }}</small>
 </td>
 <td>
 <small><span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-100 text-surface-dark">{{ log.action_type }}</span></small>
 </td>
 <td>
 <small>{{ log.username ?? 'System' }}</small>
 </td>
 <td class="text-right pe-0">
 <small class="text-slate-500">{{ log.details }}</small>
 </td>
 </tr>
 {% endfor %}
 </tbody>
 </table>
 </div>
 </div>
 </div>
 {% endif %}
 </div>
 <!-- Sidebar -->
 <div class="lg:col-span-4">
 <!-- Summary Card -->
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4">
 <div class="p-4">
 <h5 class=" font-bold mb-4">
 <i class="lucide lucide-info text-indigo-600"></i> Summary
 </h5>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="col-span-12">
 <small class="text-slate-500 text-uppercase font-semibold">Application ID</small>
 <p class="mb-0 font-semibold">{{ application.id }}</p>
 </div>
 </div>
 <hr>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="col-span-12">
 <small class="text-slate-500 text-uppercase font-semibold">Service</small>
 <p class="mb-0">{{ application.service_name }}</p>
 </div>
 </div>
 <hr>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="col-span-12">
 <small class="text-slate-500 text-uppercase font-semibold">Submitted Date</small>
 <p class="mb-0">{{ application.created_at|date("M d, Y") }}</p>
 <small class="text-slate-500">{{ application.created_at|date("H:i") }}</small>
 </div>
 </div>
 <hr>
 {% if application.approved_at %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="col-span-12">
 <small class="text-slate-500 text-uppercase font-semibold">Approved Date</small>
 <p class="mb-0">{{ application.approved_at|date("M d, Y") }}</p>
 <small class="text-slate-500">{{ application.approved_at|date("H:i") }}</small>
 </div>
 </div>
 <hr>
 {% endif %}
 {% if application.status == 'approved' and not application.service_activated %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="col-span-12">
 <small class="text-slate-500 text-uppercase font-semibold">Activation Status</small>
 <p class="mb-0">
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-amber-500">Pending Activation</span>
 </p>
 </div>
 </div>
 {% elseif application.service_activated %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="col-span-12">
 <small class="text-slate-500 text-uppercase font-semibold">Activated</small>
 <p class="mb-0">{{ application.activated_at|date("M d, Y") }}</p>
 </div>
 </div>
 {% endif %}
 </div>
 </div>
 <!-- Status Badge Card -->
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4">
 <div class="p-4 text-center py-5">
 {% if application.status == 'approved' %}
 <div class="mb-3">
 <i class="lucide lucide-check-circle text-emerald-600 text-5xl"></i>
 </div>
 <h6 class="font-bold mb-2">Application Approved!</h6>
 <p class="text-slate-500 small mb-0">Congratulations! Your application has been approved.</p>
 {% elseif application.status == 'rejected' %}
 <div class="mb-3">
 <i class="lucide lucide-x-circle text-red-600 text-5xl"></i>
 </div>
 <h6 class="font-bold mb-2">Application Rejected</h6>
 <p class="text-slate-500 small mb-0">Unfortunately, your application was rejected.</p>
 {% elseif application.status == 'processing' %}
 <div class="mb-3">
 <i class="lucide lucide-refresh-ccw text-sky-600 text-5xl"></i>
 </div>
 <h6 class="font-bold mb-2">Under Review</h6>
 <p class="text-slate-500 small mb-0">Your application is being reviewed by our team.</p>
 {% else %}
 <div class="mb-3">
 <i class="lucide lucide-hourglass text-amber-600 text-5xl"></i>
 </div>
 <h6 class="font-bold mb-2">Pending Review</h6>
 <p class="text-slate-500 small mb-0">Waiting for admin review. Please check back later.</p>
 {% endif %}
 </div>
 </div>
 <!-- Help Card -->
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl">
 <div class="p-4">
 <h5 class=" font-bold mb-3">
 <i class="lucide lucide-help-circle text-indigo-600"></i> Need Help?
 </h5>
 <p class="text-slate-500 small mb-3">If you have questions about your application, please contact our support team.</p>
 <a href="/contact" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-indigo-600 hover:bg-indigo-100 w-full rounded-xl">
 <i class="lucide lucide-mail"></i> Contact Support
 </a>
 </div>
 </div>
 <!-- Action Buttons -->
 <div class="mt-4">
 <a href="/services/applications/{{ application.id }}/copy"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 w-full rounded-xl mb-2"
 target="_blank"
 rel="noopener">
 <i class="lucide lucide-file-pdf"></i> Application Copy (PDF)
 </a>
 {% if application.status == 'rejected' %}
 <a href="/services" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 w-full rounded-xl mb-2">
 <i class="lucide lucide-search"></i> Browse Services
 </a>
 {% endif %}
 <a href="/services/my-applications"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100 w-full rounded-xl">
 <i class="lucide lucide-arrow-left"></i> Back to Applications
 </a>
 </div>
 </div>
 </div>
 </div>
 <div class="modal fade"
 id="docPreviewModal"
 tabindex="-1"
 aria-labelledby="docPreviewModalLabel"
 aria-hidden="true">
 <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
 <div class="modal-content border-0 shadow-md">
 <div class="modal-header">
 <h5 class="modal-title" id="docPreviewModalLabel">Document Preview</h5>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition"
 data-brox-dismiss="modal"
 aria-label="Close"></button>
 </div>
 <div class="modal-body p-2 md:p-3" id="docPreviewBody">
 <div class="text-slate-500 small">Loading preview...</div>
 </div>
 <div class="modal-footer">
 <a href="#"
 target="_blank"
 rel="noopener noreferrer"
 id="docPreviewOpenLink"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
 <i class="lucide lucide-external-link"></i> Open in New Tab
 </a>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100"
 data-brox-dismiss="modal">Close</button>
 </div>
 </div>
 </div>
 </div>
 <script>
(() => {
 const notifyUser = (message, type = 'info', duration = 4000) => {
 if (typeof window.showMessage === 'function') {
 return window.showMessage(message, type, duration);
 }

 if (typeof window.showToast === 'function') {
 return window.showToast(message, type, duration);
 }

 if (typeof window.Swal !== 'undefined' && typeof window.Swal.fire === 'function') {
 const iconMap = {
 success: 'success',
 danger: 'error',
 error: 'error',
 warning: 'warning',
 info: 'info'
 };

 return window.Swal.fire({
 toast: true,
 position: 'top-end',
 icon: iconMap[type] || 'info',
 title: String(message),
 showConfirmButton: false,
 timer: Number(duration) > 0 ? Number(duration) : 3000
 });
 }

 console[type === 'danger' || type === 'error' ? 'error' : 'log'](message);
 return Promise.resolve();
 };

 const modalEl = document.getElementById('docPreviewModal');
 const titleEl = document.getElementById('docPreviewModalLabel');
 const bodyEl = document.getElementById('docPreviewBody');
 const openLinkEl = document.getElementById('docPreviewOpenLink');

 if (!modalEl) return;

 const modal = new broxUI.Modal(modalEl);

 const isImageByExt = (url) => /\.(png|jpe?g|gif|webp|bmp|svg|avif)$/i.test(url);
 const isPdfByExt = (url) => /\.pdf$/i.test(url);

 const detectType = (url, mime) => {
 const cleanUrl = (url || '').split('#')[0].split('?')[0];
 const mimeType = (mime || '').toLowerCase();
 if (mimeType.startsWith('image/')) return 'image';
 if (mimeType === 'application/pdf') return 'pdf';
 if (isImageByExt(cleanUrl)) return 'image';
 if (isPdfByExt(cleanUrl)) return 'pdf';
 return 'other';
 };

 const resetBody = () => {
 bodyEl.innerHTML = '';
 };

 document.addEventListener('click', (event) => {
 const trigger = event.target.closest('.js-doc-preview');
 if (!trigger) return;

 event.preventDefault();

 const url = (trigger.getAttribute('data-doc-url') || '').trim();
 const name = (trigger.getAttribute('data-doc-name') || 'Document Preview').trim();
 const mime = (trigger.getAttribute('data-doc-mime') || '').trim();

 if (!url) {
 notifyUser('Document preview URL is missing.', 'warning');
 return;
 }

 resetBody();
 titleEl.textContent = name;
 openLinkEl.href = url;

 const type = detectType(url, mime);
 if (type === 'image') {
 const img = document.createElement('img');
 img.src = url;
 img.alt = name;
 img.className = 'doc-preview-img';
 bodyEl.appendChild(img);
 } else if (type === 'pdf') {
 const frame = document.createElement('iframe');
 frame.src = url;
 frame.className = 'doc-preview-frame';
 frame.setAttribute('title', name);
 bodyEl.appendChild(frame);
 } else {
 bodyEl.innerHTML = `
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 mb-0">
 <div class="font-semibold mb-1">Preview is not available for this file type.</div>
 <div class="small text-slate-500">Use"Open in New Tab" to view or download this document.</div>
 </div>
 `;
 }

 modal.show();
 });
})();
 </script>
