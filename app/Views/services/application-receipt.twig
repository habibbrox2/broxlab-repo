{% extends 'layout.twig' %}
{% block title %}Application Receipt{% endblock %}
{% block content %}
 <style>
 .pre-wrap-break {
 white-space: pre-wrap;
 word-break: break-word;
 }
 .receipt-payment-box {
 background: #f8fbff;
 border-color: rgba(13, 110, 253, 0.22) !important;
 }
 </style>
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 justify-center">
 <div class="lg:col-span-9">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl">
 <div class="p-4 md:p-5">
 <div class="flex justify-between items-start flex-wrap gap-3 mb-4">
 <div>
 <h3 class="font-bold mb-1">
 <i class="lucide lucide-receipt mr-2"></i>Application Receipt
 </h3>
 <div class="text-slate-500">Receipt No: SRV-{{ application.id }}-{{ application.created_at|date("Ymd") }}</div>
 </div>
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-emerald-600-subtle text-emerald-600 px-3 py-2">Submitted</span>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3 mb-4">
 <div class="md:col-span-6">
 <div class="small text-slate-500">Service</div>
 <div class="font-semibold">{{ service.name|default("N/A") }}</div>
 </div>
 <div class="md:col-span-6">
 <div class="small text-slate-500">Submitted At</div>
 <div class="font-semibold">{{ application.created_at|date("d M Y, h:i A") }}</div>
 </div>
 <div class="md:col-span-6">
 <div class="small text-slate-500">Application ID</div>
 <div class="font-semibold">#{{ application.id }}</div>
 </div>
 <div class="md:col-span-6">
 <div class="small text-slate-500">Status</div>
 <div class="font-semibold text-capitalize">{{ application.status }}</div>
 </div>
 </div>
 {% if payment %}
 <div class="border rounded-2xl p-3 md:p-4 mb-4 receipt-payment-box">
 <h5 class="font-bold mb-3">
 <i class="lucide lucide-credit-card mr-2"></i>Payment Information
 </h5>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 <div class="md:col-span-6">
 <div class="small text-slate-500">Sender Number</div>
 <div class="font-semibold">{{ payment.sender_number|default(payment.payer_name|default('N/A') ) }}</div>
 </div>
 <div class="md:col-span-6">
 <div class="small text-slate-500">Method</div>
 <div class="font-semibold text-uppercase">{{ payment.method|default("N/A") }}</div>
 </div>
 <div class="md:col-span-6">
 <div class="small text-slate-500">Transaction ID</div>
 <div class="font-semibold">{{ payment.transaction_id|default("N/A") }}</div>
 </div>
 <div class="md:col-span-6">
 <div class="small text-slate-500">Amount</div>
 <div class="font-semibold">{{ payment.currency|default("USD") }} {{ payment.amount|default(0) |number_format(2) }}</div>
 </div>
 {% if payment.receiver_account|default('') %}
 <div class="md:col-span-6">
 <div class="small text-slate-500">Receiver Account</div>
 <div class="font-semibold">{{ payment.receiver_account }}</div>
 </div>
 {% endif %}
 </div>
 </div>
 {% endif %}
 {% if application.application_data is iterable %}
 <div class="border rounded-2xl p-3 md:p-4">
 <h5 class="font-bold mb-3">
 <i class="lucide lucide-file-text mr-2"></i>Submitted Information
 </h5>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 {% for key, value in application.application_data %}
 {% set normalized_key = key|lower %}
 {% if normalized_key != '_payment' %}
 <div class="md:col-span-6">
 {% set field_label = form_field_labels[key]|default(form_field_labels[normalized_key]|default('')) %}
 {% if field_label == '' %}
 {% set field_label = normalized_key == '_documents' ? 'Documents' : (key|replace({'_': ' ', '-': ' '})|title) %}
 {% endif %}
 <div class="small text-slate-500">{{ field_label }}</div>
 {% if value is iterable %}
 {% if normalized_key == '_documents' %}
 {% if value|length > 0 %}
 <ul class="mb-0 ps-3">
 {% for doc in value %}
 <li class="mb-1">
 {% set doc_name = doc.name|default('Document ' ~ loop.index) %}
 {% if doc.url|default('') %}
 <a href="{{ doc.url }}" target="_blank" rel="noopener noreferrer">{{ doc_name }}</a>
 {% else %}
 <span class="font-semibold">{{ doc_name }}</span>
 {% endif %}
 </li>
 {% endfor %}
 </ul>
 {% else %}
 <div class="font-semibold">N/A</div>
 {% endif %}
 {% else %}
 <pre class="bg-slate-100 rounded-xl p-2 small mb-0 pre-wrap-break">{{ value|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}</pre>
 {% endif %}
 {% else %}
 <div class="font-semibold">
 {% if value is same as(null) or value is same as('') %}
 N/A
 {% elseif value is same as(true) %}
 Yes
 {% elseif value is same as(false) %}
 No
 {% else %}
 {{ value }}
 {% endif %}
 </div>
 {% endif %}
 </div>
 {% endif %}
 {% endfor %}
 </div>
 </div>
 {% endif %}
 <div class="flex flex-wrap gap-2 mt-4">
 <a href="/services/receipt/{{ application.id }}/download"
 target="_blank"
 rel="noopener"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-indigo-600 hover:bg-indigo-100">
 <i class="lucide lucide-file-text mr-1"></i>Preview PDF
 </a>
 <a href="/services/receipt/{{ application.id }}/download?output=download"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
 <i class="lucide lucide-download mr-1"></i>Download PDF
 </a>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100"
 onclick="window.print()">
 <i class="lucide lucide-printer mr-1"></i>Print Receipt
 </button>
 {% if is_logged_in %}
 <a href="/services/my-applications" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
 <i class="lucide lucide-user mr-1"></i>My Applications
 </a>
 {% else %}
 <a href="/services" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
 <i class="lucide lucide-grid mr-1"></i>Back to Services
 </a>
 {% endif %}
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
{% endblock %}






