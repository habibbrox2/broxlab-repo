{% extends 'layout.twig' %}
{% block title %}{{ service.name }} - Apply for Service{% endblock %}
{% block meta_description %}{{ service.description|default('Professional ' ~ service.name ~ ' service')|striptags|slice(0, 160) }}{% endblock %}
{% block og_image %}{{ service.featured_image_url|default(app_settings.site_logo|default(url ~ 'assets/images/default-image.png')) }}{% endblock %}
{% block og_type %}website{% endblock %}
{% set page_schema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 'name': service.name,
 'description': (service.description|default(service.name ~ ' service'))|striptags|slice(0, 160),
 'url': current_url,
 'provider': {
 '@type': 'Organization',
 'name': app_settings.site_name,
 'url': url,
 'logo': service.featured_image_url|default(app_settings.site_logo|default(url ~ 'assets/images/default-image.png'))
 }
} %}
{% if service.is_premium is defined and service.is_premium %}
 {% set page_schema = page_schema|merge({
 'pricingRange': app_settings.currency_symbol|default('$') ~ (service.price is defined and service.price ? service.price|number_format(2, '.', ',') : '0')
 }) %}
{% endif %}
{% if service.status is defined and service.status %}
 {% set page_schema = page_schema|merge({
 'availability': 'https://schema.org/' ~ (service.status == 'active' ? 'InStock' : 'OutOfStock')
 }) %}
{% endif %}
{% block schema %}
 <script type="application/ld+json">
{{ page_schema|schema_json }}
 </script>
{% endblock %}
{% block extra_styles %}
 <link rel="stylesheet" href="{{ asset('assets/css/feed-discovery.css') }}?v={{ assets_version }}" media="print" onload="this.media='all'">
 <noscript><link rel="stylesheet" href="{{ asset('assets/css/feed-discovery.css') }}?v={{ assets_version }}"></noscript>
{% endblock %}
{% block content %}
 <div class="relative overflow-hidden bg-slate-50">
  <div class="pointer-events-none absolute inset-0 -z-10">
   <div class="absolute -top-32 left-1/2 h-[28rem] w-[28rem] -translate-x-1/2 rounded-full bg-indigo-500/10 blur-3xl"></div>
   <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-fuchsia-500/10 blur-3xl"></div>
  </div>
  <section class="relative isolate overflow-hidden bg-gradient-to-br from-slate-950 via-indigo-950 to-violet-950 text-white">
   <div class="absolute inset-0 -z-10 opacity-25">
    <div class="absolute left-0 top-0 h-full w-full bg-[radial-gradient(circle_at_top_left,_rgba(255,255,255,0.14),_transparent_30%),radial-gradient(circle_at_bottom_right,_rgba(168,85,247,0.12),_transparent_25%)]"></div>
   </div>
   <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="grid items-center gap-8 lg:grid-cols-[1.25fr_0.75fr]">
     <div class="space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.24em] text-indigo-200 backdrop-blur">
       <i class="lucide lucide-briefcase h-3.5 w-3.5"></i>
       Service Details
      </div>
      <div class="flex flex-wrap gap-2">
       {% if service.is_premium is defined and service.is_premium == 1 %}
        <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-300/20 bg-amber-400/10 px-3 py-1.5 text-xs font-semibold text-amber-100">
         <i class="lucide lucide-crown h-3.5 w-3.5"></i>
         is_premium: true
        </span>
       {% else %}
        <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-300/20 bg-emerald-400/10 px-3 py-1.5 text-xs font-semibold text-emerald-100">
         <i class="lucide lucide-check h-3.5 w-3.5"></i>
         is_premium: false
        </span>
       {% endif %}
      </div>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
       {% if service.icon %}
        <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-3xl border border-white/10 bg-white/10 shadow-2xl shadow-indigo-950/30 backdrop-blur">
         <i class="{{ service.icon }} text-4xl"></i>
        </div>
       {% endif %}
       <div class="min-w-0">
        <h1 class="text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl">{{ service.name }}</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-300 sm:text-base">
         {{ service.description|default('Professional service application and support')|striptags|slice(0, 180) }}
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
         {% if service.is_premium is defined and service.is_premium == 1 %}
          <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-300/20 bg-amber-400/10 px-3 py-1.5 text-xs font-semibold text-amber-100">
           <i class="lucide lucide-crown h-3.5 w-3.5"></i> Premium Service
          </span>
          {% if service.price is defined and service.price %}
           <span class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/10 px-3 py-1.5 text-xs font-semibold text-white">
            <i class="lucide lucide-circle-dollar-sign h-3.5 w-3.5 text-emerald-300"></i>
            {{ app_settings.currency_symbol|default('$') }}{{ service.price|number_format(2, '.', ',') }}
           </span>
          {% endif %}
         {% elseif service.is_premium is defined and service.is_premium == 0 or service.is_free is defined and service.is_free %}
          <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-300/20 bg-emerald-400/10 px-3 py-1.5 text-xs font-semibold text-emerald-100">
           <i class="lucide lucide-check h-3.5 w-3.5"></i> Free Service
          </span>
         {% endif %}
         {% if service.status == 'active' %}
          <span class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/10 px-3 py-1.5 text-xs font-semibold text-white/90">
           <i class="lucide lucide-badge-check h-3.5 w-3.5 text-emerald-300"></i> Active Now
          </span>
         {% endif %}
        </div>
       </div>
      </div>
      <div class="flex flex-wrap gap-3">
       {% if can_apply %}
        <a href="#applicationFormCard" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-5 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-black/20 transition hover:-translate-y-0.5 hover:bg-slate-100">
         <i class="lucide lucide-journal-check h-4 w-4"></i>
         Apply Now
        </a>
       {% endif %}
       <a href="/services" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/15 bg-white/5 px-5 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/10">
        <i class="lucide lucide-arrow-left h-4 w-4"></i>
        Back to Services
       </a>
      </div>
     </div>

     <div class="grid grid-cols-2 gap-3 sm:gap-4">
      <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
       <p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-300">Status</p>
       <p class="mt-2 text-xl font-black text-white">{{ service.status|default('unknown')|title }}</p>
       <p class="mt-1 text-sm text-slate-300">Current availability</p>
      </div>
      <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
       <p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-300">Type</p>
       <p class="mt-2 text-xl font-black text-white">
        {% if service.is_premium %}Premium{% else %}Free{% endif %}
       </p>
       <p class="mt-1 text-sm text-slate-300">Access model</p>
      </div>
      <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
       <p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-300">Categories</p>
       <p class="mt-2 text-xl font-black text-white">{{ service.categories|length|default(0) }}</p>
       <p class="mt-1 text-sm text-slate-300">Linked groups</p>
      </div>
      <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
       <p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-300">Tags</p>
       <p class="mt-2 text-xl font-black text-white">{{ service.tags|length|default(0) }}</p>
       <p class="mt-1 text-sm text-slate-300">Connected labels</p>
      </div>
     </div>
    </div>
   </div>
  </section>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
   <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
    <!-- Left Column: Enhanced Images & Info -->
    <div class="lg:col-span-5 xl:col-span-4 lg:sticky lg:top-6 self-start space-y-6">
    <!-- Enhanced Image Carousel with Modern Design -->
    {% if service.images and service.images|length > 0 %}
    <div id="serviceCarousel"
 class="carousel overflow-hidden rounded-[2rem] border border-slate-200/80 bg-white shadow-[0_24px_70px_-30px_rgba(15,23,42,0.35)]"
 data-brox-ride="carousel">
 <div class="relative w-full overflow-hidden">
 {% for image in service.images %}
 <div class="carousel-item {% if loop.first %}active{% endif %}">
 <div class="relative h-[360px]">
 {% set img_src = image is iterable
 ? (image.thumbnail_path ?? image.image_path ?? image.url ?? image.path ?? '')
 : (image|default(''))
 %}
 {% if not img_src and service.featured_image_url %}
 {% set img_src = service.featured_image_url %}
 {% endif %}
 {% if img_src %}
 <img src="{{ img_src }}"
 alt="{{ image is iterable ? (image.alt_text ?? service.name) : service.name }}"
 class="w-full h-full object-cover">
 {% else %}
 <div class="rounded-2xl flex items-center justify-center w-full h-full min-h-[360px] bg-slate-100">
 <i class="lucide lucide-image text-neutral-400 text-2xl opacity-25"></i>
 </div>
 {% endif %}
 <!-- Gradient Overlay -->
 <div class="absolute inset-0 bg-gradient-to-t from-slate-950/55 via-slate-950/5 to-transparent"></div>
 </div>
 {% if image is iterable and image.caption %}
 <div class="absolute bottom-0 left-0 right-0 block pb-5">
 <p class="mb-0 px-4 text-sm font-semibold text-white drop-shadow">{{ image.caption }}</p>
 </div>
 {% endif %}
 </div>
 {% endfor %}
 </div>
 {% if service.images|length > 1 %}
 <!-- Enhanced Carousel Controls -->
 <button class="absolute left-0 top-0 z-[5] flex h-full w-[12%] items-center justify-center"
 type="button"
 data-brox-target="#serviceCarousel"
 data-brox-slide="prev">
 <div class="flex items-center justify-center rounded-full bg-white/75 p-3">
 <i class="lucide lucide-chevron-left text-slate-700" style="width:1.25em;height:1.25em;"></i>
 </div>
 <span class="sr-only">Previous</span>
 </button>
 <button class="absolute right-0 top-0 z-[5] flex h-full w-[12%] items-center justify-center"
 type="button"
 data-brox-target="#serviceCarousel"
 data-brox-slide="next">
 <div class="flex items-center justify-center rounded-full bg-white/75 p-3">
 <i class="lucide lucide-chevron-right text-slate-700" style="width:1.25em;height:1.25em;"></i>
 </div>
 <span class="sr-only">Next</span>
 </button>
 <!-- Carousel Indicators -->
 <div class="absolute bottom-0 left-0 right-0 z-[5] mb-4 flex items-center justify-center gap-2">
 {% for image in service.images %}
 <button type="button"
 data-brox-target="#serviceCarousel"
 data-brox-slide-to="{{ loop.index0 }}"
 class="h-2.5 w-2.5 rounded-full border-0 bg-white/60 ring-1 ring-white/40 {% if loop.first %}active{% endif %}"
 aria-current="{% if loop.first %}true{% endif %}"
 aria-label="Slide {{ loop.index }}"></button>
 {% endfor %}
 </div>
 {% endif %}
 </div>
 {% elseif service.featured_image_url or (service.featured_image is defined and service.featured_image.image_path) %}
 <div class="overflow-hidden rounded-[2rem] border border-slate-200/80 bg-white shadow-[0_24px_70px_-30px_rgba(15,23,42,0.35)]">
 {% set feat_src = service.featured_image_url
 ?? (service.featured_image.image_path ?? service.featured_image.thumbnail_path ?? '')
 %}
 {% if feat_src %}
 <img src="{{ feat_src }}"
 alt="{{ service.featured_image.alt_text ?? service.name }}"
 class="h-[360px] w-full object-cover">
 {% else %}
 <div class="flex h-[360px] items-center justify-center bg-slate-100">
 <i class="lucide lucide-image text-neutral-400 text-2xl opacity-25"></i>
 </div>
 {% endif %}
 </div>
 {% else %}
 <div class="flex h-[360px] items-center justify-center rounded-[2rem] border border-slate-200/80 bg-white shadow-[0_24px_70px_-30px_rgba(15,23,42,0.35)]">
 <i class="lucide lucide-image text-neutral-400 text-2xl opacity-25"></i>
 </div>
 {% endif %}
 <!-- Enhanced Service Info Card -->
 <div class="rounded-[2rem] border border-slate-200/80 bg-white p-5 shadow-sm">
 <div class="space-y-5">
 <!-- Status with Icon and Color Coding -->
 <div class="mb-4">
 <h6 class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-slate-500">
 <i class="lucide lucide-activity mr-2"></i>Status
 </h6>
 {% if service.status == 'active' %}
 <div class="flex items-center gap-3 rounded-2xl border border-emerald-100 bg-emerald-50/80 p-3">
 <div class="flex h-11 w-11 items-center justify-center rounded-full bg-emerald-600">
 <i class="lucide lucide-check-circle text-white"></i>
 </div>
 <div>
 <div class="font-bold text-emerald-700">Active</div>
 <small class="text-slate-500">Service is currently available</small>
 </div>
 </div>
 {% elseif service.status == 'inactive' %}
 <div class="flex items-center gap-3 rounded-2xl border border-amber-100 bg-amber-50/80 p-3">
 <div class="flex h-11 w-11 items-center justify-center rounded-full bg-amber-500">
 <i class="lucide lucide-pause-circle text-white"></i>
 </div>
 <div>
 <div class="font-bold text-amber-700">Inactive</div>
 <small class="text-slate-500">Service temporarily unavailable</small>
 </div>
 </div>
 {% else %}
 <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-3">
 <div class="flex h-11 w-11 items-center justify-center rounded-full bg-slate-600">
 <i class="lucide lucide-archive text-white"></i>
 </div>
 <div>
 <div class="font-bold text-slate-700">Archived</div>
 <small class="text-slate-500">Service is no longer active</small>
 </div>
 </div>
 {% endif %}
 </div>
 <!-- Requirements with Modern Icons -->
 {% if service.requires_approval or service.auto_approve or service.requires_documents %}
 <div class="mb-4">
 <h6 class="uppercase font-bold mb-3 text-xs text-slate-500 tracking-wider">
 <i class="lucide lucide-clipboard-check mr-2"></i>Requirements
 </h6>
 <div class="flex flex-column gap-2">
 {% if service.requires_approval %}
 <div class="flex items-center gap-2 p-2 rounded-xl">
 <div class="rounded-full flex items-center justify-center w-8 h-8 bg-emerald-600">
 <i class="lucide lucide-check text-white"></i>
 </div>
 <span class="small">Admin approval required</span>
 </div>
 {% endif %}
 {% if service.auto_approve %}
 <div class="flex items-center gap-2 p-2 rounded-xl">
 <div class="rounded-full flex items-center justify-center w-8 h-8 bg-amber-500">
 <i class="lucide lucide-zap text-white"></i>
 </div>
 <span class="small">Auto-approved applications</span>
 </div>
 {% endif %}
 {% if service.requires_documents %}
 <div class="flex items-center gap-2 p-2 rounded-xl">
 <div class="rounded-full flex items-center justify-center w-8 h-8 bg-slate-600">
 <i class="lucide lucide-file-pdf text-white"></i>
 </div>
 <span class="small">Optional Documents</span>
 </div>
 {% endif %}
 </div>
 </div>
 {% endif %}
 {% include 'partials/content-rating.twig' with { content_type: 'service', content_id: service.id } %}
 <!-- Categories with Enhanced Styling -->
 {% if service.categories %}
 <div class="mb-4">
 <h6 class="uppercase font-bold mb-3 text-xs text-slate-500 tracking-wider">
 <i class="lucide lucide-folder mr-2"></i>Categories
 </h6>
 <div class="flex flex-wrap gap-2">
 {% for category in service.categories %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold px-3 py-2 bg-sky-100 text-sky-800">{{ category.name }}</span>
 {% endfor %}
 </div>
 </div>
 {% endif %}
 <!-- Tags with Enhanced Styling -->
 {% if service.tags %}
 <div class="mb-4">
 <h6 class="uppercase font-bold mb-3 text-xs text-slate-500 tracking-wider">
 <i class="lucide lucide-tags mr-2"></i>Tags
 </h6>
 <div class="flex flex-wrap gap-2">
 {% for tag in service.tags %}
 <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-neutral-100 text-neutral-800 ">#{{ tag.name }}</span>
 {% endfor %}
 </div>
 </div>
 {% endif %}
 </div>
 </div>
 <!-- Enhanced Quick Action Buttons -->
 {% if is_logged_in and user_application %}
 <div class="rounded-[2rem] border border-slate-200/80 bg-white p-5 shadow-sm">
 <div class="space-y-4">
 <div class="mb-3">
 <h6 class="font-bold mb-2">
 <i class="lucide lucide-check-circle mr-2"></i>Your Application Status
 </h6>
 </div>
 <div class="mb-3">
 {% if user_application.status == 'pending' %}
 <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
 <i class="lucide lucide-clock mr-1"></i> Pending Review
 </span>
 {% elseif user_application.status == 'processing' %}
 <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-sky-100 text-sky-800">
 <i class="lucide lucide-refresh-ccw mr-1"></i> Processing
 </span>
 {% elseif user_application.status == 'approved' %}
 <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
 <i class="lucide lucide-check-circle mr-1"></i> Approved
 </span>
 {% elseif user_application.status == 'rejected' %}
 <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
 <i class="lucide lucide-x-circle mr-1"></i> Rejected
 </span>
 {% endif %}
 </div>
 <a href="/services/applications/{{ user_application.id }}"
 class="inline-flex items-center justify-center w-full px-4 py-3 rounded-lg bg-neutral-900 text-white text-sm font-semibold hover:bg-neutral-800 transition-colors ">
 <i class="lucide lucide-eye mr-2"></i> View Application Details
 </a>
 </div>
 </div>
 {% endif %}
 {% if can_apply %}
 <a href="#applicationFormCard"
 class="inline-flex items-center justify-center w-full px-4 py-3 rounded-lg bg-indigo-600 text-white text-sm font-semibold relative overflow-hidden hover:bg-indigo-600/90 transition-all hover:scale-[1.02] hover:shadow-lg hover:shadow-indigo-500/25{% if user_application %} mt-4{% endif %}">
 <span class="relative z-10">
 <i class="lucide lucide-journal-check mr-2"></i> Fill Application Form
 </span>
 <!-- Shine Effect -->
 <div class="absolute inset-0"></div>
 </a>
 {% if not is_logged_in %}
 <small class="block mt-2 text-neutral-500">You can apply without login. Login users can track applications in profile.</small>
 {% endif %}
 {% endif %}
 </div>
 <!-- Right Column: Enhanced Description & Form -->
 <div class="lg:col-span-7">
 <!-- Enhanced Description Card -->
 {% if service.description %}
 <div class="rounded-[2rem] border border-slate-200/80 bg-white p-5 shadow-sm">
 <div class="space-y-4">
 <div class="flex items-center gap-3 mb-4">
 <div class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
 <i class="lucide lucide-info text-xl"></i>
 </div>
 <h5 class="font-bold mb-0">About This Service</h5>
 </div>
 <div class="rich-content rich-content--service-detail">
 {{ service.description|default("No description provided") |raw }}
 </div>
 </div>
 </div>
 {% endif %}
 <!-- Enhanced Metadata/Details Card -->
 {% if service.metadata and service.metadata|length > 0 %}
 <div class="rounded-[2rem] border border-slate-200/80 bg-white p-5 shadow-sm">
 <div class="space-y-4">
 <div class="flex items-center gap-3 mb-4">
 <div class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
 <i class="lucide lucide-list text-xl"></i>
 </div>
 <h5 class="font-bold mb-0">Service Details</h5>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 {% for key, value in service.metadata %}
 <div class="md:col-span-6">
 <div class="h-full rounded-2xl border border-slate-100 bg-slate-50 p-4">
 <div class="mb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400">{{ key|replace({"_":""}) }}</div>
 {% if value is iterable %}
 <div class="font-semibold text-slate-900">{{ value|json_encode }}</div>
 {% else %}
 <div class="font-semibold text-slate-900">{{ value }}</div>
 {% endif %}
 </div>
 </div>
 {% endfor %}
 </div>
 </div>
 </div>
 {% endif %}
 <!-- Enhanced Application Form -->
 {% if form_fields and form_fields|length > 0 %}
 <div id="applicationFormCard" class="rounded-[2rem] border border-slate-200/80 bg-white p-5 shadow-sm">
 <div class="space-y-5">
 <div class="flex items-center gap-3">
 <div class="flex h-11 w-11 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
 <i class="lucide lucide-file-text text-xl"></i>
 </div>
 <h5 class="font-bold mb-0">Application Form</h5>
 </div>
 <form id="applicationForm"
 method="POST"
 action="/services/apply"
 enctype="multipart/form-data">
 <input type="hidden" name="service_id" value="{{ service.id }}">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 {% if not is_logged_in %}
 <div class="mb-4 rounded-2xl border border-indigo-200 bg-indigo-50/60 p-4 md:p-5">
 <h6 class="mb-3 flex items-center gap-2 font-bold">
 <i class="lucide lucide-id text-indigo-600"></i>
 Guest Applicant Information
 </h6>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 <div class="col-span-12">
 <label for="guest_applicant_name" class="block text-sm font-semibold mb-1">
 Applicant Name <span class="text-red-600">*</span>
 </label>
 <input type="text"
 class="w-full rounded-lg border-2 border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="guest_applicant_name"
 name="guest_applicant_name"
 placeholder="Enter your full name"
 required>
 </div>
 <div class="md:col-span-6">
 <label for="guest_applicant_email" class="block text-sm font-semibold mb-1">
 Email <span class="text-red-600">*</span>
 </label>
 <input type="email"
 class="w-full rounded-lg border-2 border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="guest_applicant_email"
 name="guest_applicant_email"
 placeholder="example@email.com"
 required>
 </div>
