{# templates/services/my-applications.twig #}
{% extends 'layout.twig' %}
{% block title %}My Applications - Service Portal{% endblock %}
{% set breadcrumbs = [
 {"label":"Services","url":"/services","icon":"award"
 },
 {"label":"My Applications","icon":"clipboard-list"
 }
] %}
{% block content %}
 <style>
 .hero-gradient {
 background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
 color: #fff;
 }
 .hero-gradient h1 {
 color: #fff;
 text-shadow: 0 4px 16px rgba(0, 0, 0, 0.24);
 }
 </style>
 <!-- Hero Section -->
 <div class="hero-gradient py-5">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <h1 class="text-3xl md:text-4xl font-bold mb-0">
 <i class="lucide lucide-clipboard-check"></i> My Applications
 </h1>
 </div>
 </div>
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
 <!-- Statistics Cards -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3 mb-5">
 <div class="md:col-span-6 lg:col-span-3">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl text-center h-full">
 <div class="p-4 py-4">
 <i class="lucide lucide-hourglass text-amber-600 text-2xl mb-2 block"></i>
 <h6 class="text-slate-500 small text-uppercase">Pending</h6>
 <h3 class="font-bold mb-0">{{ stats.pending|default(0) }}</h3>
 </div>
 </div>
 </div>
 <div class="md:col-span-6 lg:col-span-3">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl text-center h-full">
 <div class="p-4 py-4">
 <i class="lucide lucide-rotate-ccw text-sky-600 text-2xl mb-2 block"></i>
 <h6 class="text-slate-500 small text-uppercase">Processing</h6>
 <h3 class="font-bold mb-0">{{ stats.processing|default(0) }}</h3>
 </div>
 </div>
 </div>
 <div class="md:col-span-6 lg:col-span-3">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl text-center h-full">
 <div class="p-4 py-4">
 <i class="lucide lucide-check-circle text-emerald-600 text-2xl mb-2 block"></i>
 <h6 class="text-slate-500 small text-uppercase">Approved</h6>
 <h3 class="font-bold mb-0">{{ stats.approved|default(0) }}</h3>
 </div>
 </div>
 </div>
 <div class="md:col-span-6 lg:col-span-3">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl text-center h-full">
 <div class="p-4 py-4">
 <i class="lucide lucide-x-circle text-red-600 text-2xl mb-2 block"></i>
 <h6 class="text-slate-500 small text-uppercase">Rejected</h6>
 <h3 class="font-bold mb-0">{{ stats.rejected|default(0) }}</h3>
 </div>
 </div>
 </div>
 </div>
 <!-- Applications Table/Cards -->
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl">
 <div class="p-4 p-0">
 <!-- Mobile Cards View -->
 <div class="sm:hidden">
 {% for application in applications %}
 <div class="border-bottom p-3 {% if not loop.last %}border-bottom{% endif %}">
 <div class="flex justify-between items-start mb-2">
 <h6 class="font-bold mb-0">
 <i class="lucide lucide-briefcase text-indigo-600"></i> {{ application.service_name }}
 </h6>
 {% if application.status == 'pending' %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-amber-500 text-surface-dark">Pending</span>
 {% elseif application.status == 'processing' %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-sky-500">Processing</span>
 {% elseif application.status == 'approved' %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-emerald-600">Approved</span>
 {% elseif application.status == 'rejected' %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-red-600">Rejected</span>
 {% else %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-600">{{ application.status }}</span>
 {% endif %}
 </div>
 <p class="text-slate-500 small mb-2">
 <i class="lucide lucide-calendar"></i> {{ application.created_at|date("M d, Y") }}
 </p>
 <p class="text-slate-500 small mb-3">
 <i class="lucide lucide-info"></i> ID: {{ application.id }}
 </p>
 <a href="/services/applications/{{ application.id }}"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-indigo-600 hover:bg-indigo-100 w-full">
 <i class="lucide lucide-eye"></i> View Details
 </a>
 </div>
 {% endfor %}
 </div>
 <!-- Desktop Table View -->
 <div class="hidden sm:block">
 <table class="w-full text-sm text-left">
 <thead class="bg-neutral-100 text-neutral-700">
 <tr>
 <th class="ps-4">
 <i class="lucide lucide-briefcase text-indigo-600"></i> Service
 </th>
 <th class="text-center">
 <i class="lucide lucide-tag"></i> Status
 </th>
 <th class="text-center">
 <i class="lucide lucide-calendar"></i> Submitted
 </th>
 <th class="text-center">
 <i class="lucide lucide-check"></i> Approved
 </th>
 <th class="text-right pe-4">
 <i class="lucide lucide-settings"></i> Actions
 </th>
 </tr>
 </thead>
 <tbody>
 {% for app in applications %}
 <tr>
 <td class="ps-4 font-semibold">
 <div class="flex items-center gap-2">
 <i class="lucide lucide-briefcase text-indigo-600"></i>
 <div>
 <div>{{ app.service_name }}</div>
 <small class="text-slate-500">ID: #{{ app.id }}</small>
 </div>
 </div>
 </td>
 <td class="text-center">
 {% set status_colors = {"pending": "warning","processing":"info","approved":"success","rejected":"danger"} %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-{{ status_colors[app.status]|default("secondary") }} text-white">{{ app.status|title }}</span>
 </td>
 <td class="text-center text-slate-500 small">{{ app.created_at|date("M d, Y") }}</td>
 <td class="text-center text-slate-500 small">
 {% if app.approved_at %}
 {{ app.approved_at|date("M d, Y") }}
 {% else %}
 <span class="text-slate-500">-</span>
 {% endif %}
 </td>
 <td class="text-right pe-4">
 <div class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition-group transition-group-sm" role="group">
 <a href="/services/applications/{{ app.id }}"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-indigo-600 hover:bg-indigo-100"
 title="View details">
 <i class="lucide lucide-eye"></i> View
 </a>
 {% if app.status == 'rejected' %}
 <a href="/services/view/{{ app.service_slug }}"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition transition-ghost-success"
 title="Reapply">
 <i class="lucide lucide-rotate-ccw"></i> Reapply
 </a>
 {% endif %}
 </div>
 </td>
 </tr>
 {% else %}
 <tr>
 <td colspan="5" class="text-center py-4 text-slate-500">
 <p>
 <i class="lucide lucide-inbox text-4xl mb-3 block"></i>
 </p>
 <p>You haven't submitted any applications yet.</p>
 <a href="/services" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 px-3 py-1.5 text-xs">
 <i class="lucide lucide-search"></i> Browse Services
 </a>
 </td>
 </tr>
 {% endfor %}
 </tbody>
 </table>
 </div>
 </div>
 </div>
 </div>
{% endblock %}






