{% extends 'layout.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block extra_styles %}
<style>
/* Critical JS-dependent styles only — kept minimal, no decorative styling */
.tray-item { position:relative; }
.tray-item.active { outline: 2px solid #6366f1; outline-offset: -2px; }
.tray-item.selected::after { content:''; position:absolute; inset:0; border:2px solid #22c55e; border-radius:8px; }
[data-tool-button].active { border-color: #6366f1; background: #eef2ff; }
.studio-preview-photo { position:absolute; border:1px solid #cbd5e1; background-size:cover; background-position:center; }
.toast { padding:0.75rem 1rem; border-radius:0.5rem; background:#1e293b; color:#fff; margin-top:0.5rem; min-width:200px; }
.toast-container { position:fixed; right:1rem; bottom:1rem; z-index:80; display:grid; gap:0.5rem; }
.toast.success { border-left:3px solid #22c55e; }
.toast.error { border-left:3px solid #ef4444; }
</style>
{% endblock %}

{% block content %}
{% set studio_link = studio_header_url|default('/studio') %}

<div class="max-w-full px-4 sm:px-6 lg:px-8 py-6" id="studioApp">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Brox Studio ID Photo Pro</h1>
      <p class="text-sm text-slate-500 mt-1">Passport, visa, job, exam, and print-ready photo workflow</p>
    </div>
    <div class="flex items-center gap-2">
      <button type="button" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors shadow-sm" onclick="undo()" id="undoBtn" disabled>
        <i class="lucide lucide-undo-2 w-4 h-4"></i><span>Undo</span>
      </button>
      <button type="button" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors shadow-sm" onclick="redo()" id="redoBtn" disabled>
        <i class="lucide lucide-redo w-4 h-4"></i><span>Redo</span>
      </button>
      <button type="button" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors shadow-sm" onclick="document.getElementById('imageUploadInput').click()">
        <i class="lucide lucide-upload w-4 h-4"></i><span>Upload</span>
      </button>
      <button type="button" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors shadow-sm" onclick="preparePrintReady()">
        <i class="lucide lucide-sparkles w-4 h-4"></i><span>Prepare</span>
      </button>
      <button type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 transition-colors shadow-sm" onclick="downloadImage()">
        <i class="lucide lucide-download w-4 h-4"></i><span>Export</span>
      </button>
      <button type="button" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-orange-200 bg-orange-50 text-sm font-medium text-orange-700 hover:bg-orange-100 transition-colors shadow-sm" onclick="openPrintSheetModal()">
        <i class="lucide lucide-printer w-4 h-4"></i><span>Print Sheet</span>
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-[1fr_380px] gap-6">
    {# Main workspace #}
    <div class="min-w-0">
      {# Preset info + guide controls #}
      <div class="flex items-center justify-between gap-4 p-4 mb-4 rounded-xl border border-slate-200 bg-white shadow-sm">
        <div>
          <h2 class="text-lg font-semibold text-slate-900" id="presetTitle">Bangladesh Passport</h2>
          <p class="text-sm text-slate-500" id="presetDescription">Choose a preset, align the face inside the guide box, then export or place on a print sheet.</p>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors" onclick="toggleGuides()">
            <i class="lucide lucide-crop w-3.5 h-3.5"></i><span id="guideToggleLabel">Hide Guides</span>
          </button>
          <button type="button" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors" onclick="fitToGuide()">
            <i class="lucide lucide-frame w-3.5 h-3.5"></i><span>Fit To Guide</span>
          </button>
          <button type="button" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors" onclick="centerSubject()">
            <i class="lucide lucide-align-center-horizontal w-3.5 h-3.5"></i><span>Center</span>
          </button>
        </div>
      </div>

      {# Canvas area #}
      <div class="relative rounded-xl border border-slate-200 bg-slate-50 overflow-hidden min-h-[50vh]" id="canvasArea">
        <div class="absolute inset-0 overflow-auto p-4 flex items-center justify-center" id="canvasScroll">
          <div class="relative" id="canvasContainer" style="display:none;">
            <canvas id="photoCanvas" class="max-w-full h-auto rounded-lg shadow-md bg-white"></canvas>
          </div>
        </div>

        {# Upload placeholder #}
        <div class="absolute inset-0 flex items-center justify-center cursor-pointer p-6" id="uploadPlaceholder" onclick="document.getElementById('imageUploadInput').click()">
          <div class="text-center max-w-sm">
            <i class="lucide lucide-cloud-upload text-5xl text-slate-300 mx-auto block mb-3"></i>
            <h3 class="text-lg font-semibold text-slate-700 mb-1">Drop or upload a portrait photo</h3>
            <p class="text-sm text-slate-500">Supports JPG, PNG, GIF, and WebP up to 10MB. Then choose a preset and align it like a real studio app.</p>
          </div>
        </div>

        {# Canvas HUD #}
        <div class="absolute left-3 right-3 bottom-3 flex justify-between gap-3 pointer-events-none">
          <div class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-white/90 border border-slate-200 shadow-sm text-xs">
            <strong class="text-slate-800" id="canvasModeBadge">Select Tool</strong>
            <span class="text-slate-500" id="toolHint">Move and align the subject inside the face guide.</span>
          </div>
          <div class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-white/90 border border-slate-200 shadow-sm text-xs">
            <strong class="text-slate-800" id="zoomLevel">100%</strong>
            <span class="text-slate-500" id="imageInfo">No image loaded</span>
          </div>
        </div>
      </div>

      {# Status bar #}
      <div class="flex items-center justify-between gap-4 mt-4 p-3 rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="flex items-center gap-1">
          <button type="button" class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors" onclick="zoomOut()" title="Zoom out">
            <i class="lucide lucide-minus w-4 h-4"></i>
          </button>
          <button type="button" class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors" onclick="zoomIn()" title="Zoom in">
            <i class="lucide lucide-plus w-4 h-4"></i>
          </button>
          <button type="button" class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors" onclick="resetZoom()" title="Reset zoom">
            <i class="lucide lucide-maximize w-4 h-4"></i>
          </button>
          <button type="button" class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors" onclick="rotateImage()" title="Rotate 90 degrees">
            <i class="lucide lucide-repeat w-4 h-4"></i>
          </button>
          <button type="button" class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors" onclick="flipImage('horizontal')" title="Flip horizontal">
            <i class="lucide lucide-flip-horizontal w-4 h-4"></i>
          </button>
          <button type="button" class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors" onclick="flipImage('vertical')" title="Flip vertical">
            <i class="lucide lucide-flip-vertical w-4 h-4"></i>
          </button>
        </div>
        <span class="text-xs text-slate-500" id="sessionMeta">Preset ready for export</span>
      </div>
    </div>

    {# Sidebar #}
    <aside class="space-y-4" id="studioSidebar">
      {# Studio Session #}
      <div class="rounded-xl border border-slate-200 bg-white shadow-sm p-4">
        <div class="mb-3">
          <strong class="text-sm font-semibold text-slate-900">Studio Session</strong>
          <p class="text-xs text-slate-500">Preset, tray, tools, adjustments, background, and print settings.</p>
        </div>
        <div class="mb-3">
          <label for="presetSelect" class="block text-xs font-medium text-slate-600 mb-1">ID Photo Preset</label>
          <select id="presetSelect" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700"></select>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Preset Details</label>
          <div class="grid grid-cols-2 gap-2" id="presetChipGrid"></div>
        </div>
      </div>

      {# Image Tray #}
      <div class="rounded-xl border border-slate-200 bg-white shadow-sm p-4">
        <h3 class="text-sm font-semibold text-slate-900 mb-1">Image Tray</h3>
        <p class="text-xs text-slate-500 mb-3">Keep multiple portraits and switch between them.</p>
        <div class="flex items-center gap-2 mb-3">
          <button type="button" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-xs font-medium hover:bg-indigo-700 transition-colors" onclick="document.getElementById('imageUploadInput').click()">
            <i class="lucide lucide-images w-3.5 h-3.5"></i><span>Add Photo</span>
          </button>
          <button type="button" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors" onclick="deleteCurrentImage()">
            <i class="lucide lucide-trash-2 w-3.5 h-3.5"></i><span>Delete Active</span>
          </button>
        </div>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(72px,1fr))] gap-2" id="imageTray"></div>
      </div>

      {# Editing Tools #}
      <div class="rounded-xl border border-slate-200 bg-white shadow-sm p-4">
        <h3 class="text-sm font-semibold text-slate-900 mb-1">Editing Tools</h3>
        <p class="text-xs text-slate-500 mb-3">Select, crop, retouch, annotate, and isolate the subject.</p>
        <div class="grid grid-cols-2 gap-2">
          <button type="button" class="flex flex-col items-start gap-0.5 p-3 rounded-lg border border-slate-200 bg-white text-left hover:bg-slate-50 transition-colors active" data-tool-button="select" onclick="setTool('select')">
            <i class="lucide lucide-mouse-pointer w-4 h-4 text-slate-600"></i>
            <strong class="text-xs font-semibold text-slate-800">Select</strong>
            <span class="text-[11px] text-slate-500">Move and scale</span>
          </button>
          <button type="button" class="flex flex-col items-start gap-0.5 p-3 rounded-lg border border-slate-200 bg-white text-left hover:bg-slate-50 transition-colors" data-tool-button="crop" onclick="setTool('crop')">
            <i class="lucide lucide-crop w-4 h-4 text-slate-600"></i>
            <strong class="text-xs font-semibold text-slate-800">Crop</strong>
            <span class="text-[11px] text-slate-500">Drag box with handles</span>
          </button>
          <button type="button" class="flex flex-col items-start gap-0.5 p-3 rounded-lg border border-slate-200 bg-white text-left hover:bg-slate-50 transition-colors" data-tool-button="brush" onclick="setTool('brush')">
            <i class="lucide lucide-paintbrush w-4 h-4 text-slate-600"></i>
            <strong class="text-xs font-semibold text-slate-800">Brush</strong>
            <span class="text-[11px] text-slate-500">Retouch and highlight</span>
          </button>
          <button type="button" class="flex flex-col items-start gap-0.5 p-3 rounded-lg border border-slate-200 bg-white text-left hover:bg-slate-50 transition-colors" data-tool-button="eraser" onclick="setTool('eraser')">
            <i class="lucide lucide-eraser w-4 h-4 text-slate-600"></i>
            <strong class="text-xs font-semibold text-slate-800">Eraser</strong>
            <span class="text-[11px] text-slate-500">Refine edges</span>
          </button>
          <button type="button" class="flex flex-col items-start gap-0.5 p-3 rounded-lg border border-slate-200 bg-white text-left hover:bg-slate-50 transition-colors" data-tool-button="text" onclick="setTool('text')">
            <i class="lucide lucide-type w-4 h-4 text-slate-600"></i>
            <strong class="text-xs font-semibold text-slate-800">Text</strong>
            <span class="text-[11px] text-slate-500">Add label</span>
          </button>
          <button type="button" class="flex flex-col items-start gap-0.5 p-3 rounded-lg border border-slate-200 bg-white text-left hover:bg-slate-50 transition-colors" data-tool-button="shape" onclick="setTool('shape')">
            <i class="lucide lucide-frame w-4 h-4 text-slate-600"></i>
            <strong class="text-xs font-semibold text-slate-800">Shape</strong>
            <span class="text-[11px] text-slate-500">Rectangle or circle</span>
          </button>
          <button type="button" class="flex flex-col items-start gap-0.5 p-3 rounded-lg border border-slate-200 bg-white text-left hover:bg-slate-50 transition-colors" onclick="bgRemove()">
            <i class="lucide lucide-wand-sparkles w-4 h-4 text-slate-600"></i>
            <strong class="text-xs font-semibold text-slate-800">Cutout</strong>
            <span class="text-[11px] text-slate-500">Remove background</span>
          </button>
          <button type="button" class="flex flex-col items-start gap-0.5 p-3 rounded-lg border border-slate-200 bg-white text-left hover:bg-slate-50 transition-colors" onclick="openPrintSheetModal()">
            <i class="lucide lucide-grid-3x3 w-4 h-4 text-slate-600"></i>
            <strong class="text-xs font-semibold text-slate-800">Print</strong>
            <span class="text-[11px] text-slate-500">Live sheet preview</span>
          </button>
        </div>

        <div class="mt-3">
          <label for="brushSizeSlider" class="block text-xs font-medium text-slate-600 mb-1">Brush / Eraser Size</label>
          <input id="brushSizeSlider" type="range" min="4" max="80" value="22" class="w-full">
        </div>
        <div class="grid grid-cols-2 gap-3 mt-3">
          <div>
            <label for="brushColorPicker" class="block text-xs font-medium text-slate-600 mb-1">Brush Color</label>
            <input id="brushColorPicker" type="color" value="#f97316" class="w-full h-9 rounded-lg border border-slate-200 cursor-pointer">
          </div>
          <div>
            <label for="foregroundScaleSlider" class="block text-xs font-medium text-slate-600 mb-1">Subject Scale</label>
            <input id="foregroundScaleSlider" type="range" min="40" max="220" value="100" class="w-full">
          </div>
        </div>
        <button type="button" class="mt-3 inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors" onclick="applyCrop()">
          <i class="lucide lucide-check-square w-3.5 h-3.5"></i><span>Apply Crop</span>
        </button>
      </div>

      {# Text & Shape #}
      <div class="rounded-xl border border-slate-200 bg-white shadow-sm p-4">
        <h3 class="text-sm font-semibold text-slate-900 mb-3">Text & Shape</h3>
        <div class="mb-3">
          <label for="textInputValue" class="block text-xs font-medium text-slate-600 mb-1">Text Content</label>
          <input id="textInputValue" type="text" value="ID PHOTO" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700">
        </div>
        <div class="grid grid-cols-2 gap-3 mb-3">
          <div>
            <label for="textSizeInput" class="block text-xs font-medium text-slate-600 mb-1">Text Size</label>
            <input id="textSizeInput" type="number" min="16" max="120" value="36" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700">
          </div>
          <div>
            <label for="textColorPicker" class="block text-xs font-medium text-slate-600 mb-1">Text Color</label>
            <input id="textColorPicker" type="color" value="#ffffff" class="w-full h-9 rounded-lg border border-slate-200 cursor-pointer">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="shapeTypeSelect" class="block text-xs font-medium text-slate-600 mb-1">Shape Type</label>
            <select id="shapeTypeSelect" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700">
              <option value="rect">Rectangle</option>
              <option value="circle">Circle</option>
            </select>
          </div>
          <div>
            <label for="shapeColorPicker" class="block text-xs font-medium text-slate-600 mb-1">Shape Color</label>
            <input id="shapeColorPicker" type="color" value="#38bdf8" class="w-full h-9 rounded-lg border border-slate-200 cursor-pointer">
          </div>
        </div>
      </div>

      {# Adjustments #}
      <div class="rounded-xl border border-slate-200 bg-white shadow-sm p-4">
        <h3 class="text-sm font-semibold text-slate-900 mb-3">Adjustments</h3>
        <div class="mb-2">
          <label for="brightnessSlider" class="block text-xs font-medium text-slate-600 mb-1">Brightness</label>
          <input id="brightnessSlider" type="range" min="-100" max="100" value="0" class="w-full">
        </div>
        <div class="mb-2">
          <label for="contrastSlider" class="block text-xs font-medium text-slate-600 mb-1">Contrast</label>
          <input id="contrastSlider" type="range" min="-100" max="100" value="0" class="w-full">
        </div>
        <div class="mb-3">
          <label for="saturationSlider" class="block text-xs font-medium text-slate-600 mb-1">Saturation</label>
          <input id="saturationSlider" type="range" min="-100" max="100" value="0" class="w-full">
        </div>
        <div class="flex items-center gap-2">
          <button type="button" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-xs font-medium hover:bg-indigo-700 transition-colors" onclick="applyAllFilters()">
            <i class="lucide lucide-check w-3.5 h-3.5"></i><span>Apply Preview</span>
          </button>
          <button type="button" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors" onclick="resetFilters()">
            <i class="lucide lucide-undo-2 w-3.5 h-3.5"></i><span>Reset</span>
          </button>
        </div>
      </div>

      {# Background & Guides #}
      <div class="rounded-xl border border-slate-200 bg-white shadow-sm p-4">
        <h3 class="text-sm font-semibold text-slate-900 mb-3">Background & Guides</h3>
        <div class="grid grid-cols-2 gap-3 mb-3">
          <div>
            <label for="backgroundColorPicker" class="block text-xs font-medium text-slate-600 mb-1">Solid Background</label>
            <input id="backgroundColorPicker" type="color" value="#ffffff" class="w-full h-9 rounded-lg border border-slate-200 cursor-pointer">
          </div>
          <div>
            <label for="guideOpacitySlider" class="block text-xs font-medium text-slate-600 mb-1">Guide Opacity</label>
            <input id="guideOpacitySlider" type="range" min="10" max="100" value="76" class="w-full">
          </div>
        </div>
        <div class="grid grid-cols-5 gap-2 mb-3" id="backgroundPresetGrid"></div>
        <div class="flex items-center gap-2">
          <button type="button" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors" onclick="clearBackgroundLayer()">
            <i class="lucide lucide-layers w-3.5 h-3.5"></i><span>Transparent</span>
          </button>
          <button type="button" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors" onclick="setBackgroundColor(document.getElementById('backgroundColorPicker').value)">
            <i class="lucide lucide-palette w-3.5 h-3.5"></i><span>Use Color</span>
          </button>
        </div>
      </div>

      {# Export & Print #}
      <div class="rounded-xl border border-slate-200 bg-white shadow-sm p-4">
        <h3 class="text-sm font-semibold text-slate-900 mb-3">Export & Print</h3>
        <div class="mb-3">
          <label for="printPageSize" class="block text-xs font-medium text-slate-600 mb-1">Paper Size</label>
          <select id="printPageSize" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700"></select>
        </div>
        <div class="grid grid-cols-2 gap-3 mb-3">
          <div>
            <label for="printOrientation" class="block text-xs font-medium text-slate-600 mb-1">Orientation</label>
            <select id="printOrientation" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700">
              <option value="portrait">Portrait</option>
              <option value="landscape">Landscape</option>
            </select>
          </div>
          <div>
            <label for="printLayout" class="block text-xs font-medium text-slate-600 mb-1">Layout</label>
            <select id="printLayout" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700">
              <option value="center">Centered Grid</option>
              <option value="wide">Wide Fit</option>
              <option value="compact">Compact</option>
            </select>
          </div>
        </div>
        <div class="mb-3">
          <label for="printSpacing" class="block text-xs font-medium text-slate-600 mb-1">Spacing (mm)</label>
          <input id="printSpacing" type="number" min="0" max="12" step="0.5" value="4" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700">
        </div>
        <div class="flex items-center gap-2">
          <button type="button" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-xs font-medium hover:bg-indigo-700 transition-colors" onclick="downloadImage()">
            <i class="lucide lucide-download w-3.5 h-3.5"></i><span>Download Active</span>
          </button>
          <button type="button" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-orange-200 bg-orange-50 text-orange-700 text-xs font-medium hover:bg-orange-100 transition-colors" onclick="openPrintSheetModal()">
            <i class="lucide lucide-file-text w-3.5 h-3.5"></i><span>Generate PDF</span>
          </button>
        </div>
      </div>
    </aside>
  </div>

  {# Print Sheet Modal #}
  <div class="fixed inset-0 p-4 hidden items-center justify-center bg-black/40 z-50" id="printSheetModal">
    <div class="w-full max-w-2xl rounded-xl border border-slate-200 bg-white shadow-xl p-5">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-lg font-semibold text-slate-900" style="margin:0;">Print Sheet Preview</h3>
          <p class="text-sm text-slate-500" style="margin:0.25rem 0 0;">Select tray images, confirm paper settings, then generate a PDF.</p>
        </div>
        <button type="button" class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors" onclick="closePrintSheetModal()">
          <i class="lucide lucide-x w-4 h-4"></i>
        </button>
      </div>

      <div class="min-h-[160px] rounded-xl border border-dashed border-slate-300 bg-slate-50 p-4 mb-4">
        <div class="w-full min-h-[118px] rounded-lg bg-white relative overflow-hidden" id="printSheetPreview"></div>
      </div>

      <div class="mb-4">
        <label class="block text-xs font-medium text-slate-600 mb-1">Selected Images</label>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(72px,1fr))] gap-2" id="printSheetImageList"></div>
      </div>

      <div class="flex items-center justify-end gap-2">
        <button type="button" class="px-4 py-2 rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors" onclick="closePrintSheetModal()">Cancel</button>
        <button type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 transition-colors" onclick="generatePrintSheet()">
          <i class="lucide lucide-download w-4 h-4"></i><span>Generate PDF</span>
        </button>
      </div>
    </div>
  </div>

  <input id="imageUploadInput" type="file" accept="image/jpeg,image/png,image/gif,image/webp" multiple hidden>
  <script id="studioConfigData" type="application/json">{{ studio_config_json|raw }}</script>
  <div class="toast-container" id="toastContainer"></div>
</div>
{% endblock %}

{% block extra_scripts %}
<script type="module" src="/assets/js/dist/photo-studio/editor.js"></script>
{% endblock %}
