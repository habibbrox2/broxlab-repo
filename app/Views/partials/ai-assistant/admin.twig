{# Premium Admin Copilot - command center layout #}
{# Keep all existing IDs for compatibility with admin assistant JS #}

<input type="file" id="adminAiFileInput" class="brox-ai-input-file hidden" accept="image/*,.pdf,.txt,.doc,.docx" multiple>

<div id="adminAiShell" class="brox-ai-copilot-sidebar brox-ai-hidden pointer-events-auto relative w-[min(100vw,56rem)] overflow-hidden rounded-none border-l border-white/10 bg-slate-950/96 text-slate-100 shadow-[0_35px_100px_rgba(2,6,23,0.5)] backdrop-blur-2xl lg:rounded-l-[2rem]" role="dialog" aria-labelledby="adminAiTitle" aria-modal="true">
 <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(59,130,246,0.18),transparent_30%),radial-gradient(circle_at_top_right,rgba(34,211,238,0.12),transparent_32%)]"></div>

 <div class="relative flex h-[100dvh] flex-col lg:h-screen">
  <div class="admin-assistant-chat-resizer absolute left-0 top-0 hidden h-full w-1 cursor-col-resize bg-cyan-400/35 lg:block" data-resizer="width" aria-hidden="true"></div>

  <div class="grid flex-1 grid-cols-1 overflow-hidden lg:grid-cols-[21rem_minmax(0,1fr)]">
   <aside id="adminAiSidebar" class="brox-ai-sidebar brox-ai-collapsed border-b border-white/10 bg-slate-950/90 lg:border-b-0 lg:border-r">
    <div class="border-b border-white/10 px-4 py-4">
     <div class="flex items-center justify-between gap-3">
      <div>
       <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-cyan-200/80">Command center</p>
       <h2 class="mt-1 text-base font-bold text-white">Brox AI Copilot</h2>
      </div>
      <button id="adminAiSidebarClose" class="brox-ai-icon-btn inline-flex h-10 w-10 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-slate-200 transition hover:bg-white/10 hover:text-white lg:hidden" aria-label="Close sidebar">
       <i class="lucide lucide-x text-[1rem]"></i>
      </button>
     </div>
     <div class="mt-4 grid grid-cols-2 gap-2">
      <div class="rounded-2xl border border-white/10 bg-white/[0.04] px-3 py-3">
       <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Context</p>
       <p class="mt-1 text-sm font-semibold text-white"><span id="adminAiContextModule">Global</span></p>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/[0.04] px-3 py-3">
       <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Saved state</p>
       <p id="adminAiSaveIndicator" class="mt-1 flex items-center gap-2 text-sm font-semibold text-emerald-200">
        <i class="lucide lucide-check-circle text-emerald-300"></i> Saved
       </p>
      </div>
     </div>
    </div>

    <div class="brox-ai-tabs flex h-full flex-col overflow-hidden">
     <div class="brox-ai-tabs-nav grid grid-cols-2 gap-2 border-b border-white/10 px-4 py-3">
      <button class="brox-ai-tabs-nav-item brox-ai-tabs-nav-item-active inline-flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/10 px-3 py-3 text-sm font-semibold text-white transition" data-tab="brox-ai-history-tab" aria-selected="true">
       <i class="lucide lucide-clock text-sm"></i> History
      </button>
      <button class="brox-ai-tabs-nav-item inline-flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-3 py-3 text-sm font-semibold text-slate-300 transition hover:bg-white/10 hover:text-white" data-tab="brox-ai-settings-tab" aria-selected="false">
       <i class="lucide lucide-sliders-horizontal text-sm"></i> Settings
      </button>
     </div>

     <div class="brox-ai-tabs-content flex min-h-0 flex-1 flex-col overflow-hidden">
      <div id="brox-ai-history-tab" class="brox-ai-tabs-panel brox-ai-tabs-panel-active min-h-0 flex-1 overflow-y-auto px-4 py-4" role="tabpanel">
       <div class="flex items-center justify-between rounded-2xl border border-white/10 bg-white/[0.04] px-3 py-3">
        <div>
         <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Chat history</p>
         <p class="text-sm font-semibold text-white">Recent sessions</p>
        </div>
        <button id="adminAiClearHistory" class="brox-ai-btn-secondary inline-flex items-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-3 py-2 text-xs font-semibold text-slate-200 transition hover:bg-rose-500/15 hover:text-rose-100" title="Clear all history">
         <i class="lucide lucide-trash-2 text-sm"></i> Clear
        </button>
       </div>
       <div id="adminAiHistory" class="brox-ai-history-list mt-3 space-y-2"></div>
       <div class="brox-ai-history-empty flex flex-col items-center justify-center rounded-[1.5rem] border border-dashed border-white/10 bg-white/[0.03] px-4 py-10 text-center text-slate-400">
        <i class="lucide lucide-inbox text-3xl text-slate-500"></i>
        <p class="mt-3 text-sm font-medium text-slate-300">No history yet</p>
        <p class="mt-1 text-xs leading-5 text-slate-500">Conversations will show up here after the first message.</p>
       </div>
      </div>

      <div id="brox-ai-settings-tab" class="brox-ai-tabs-panel min-h-0 flex-1 overflow-y-auto px-4 py-4" role="tabpanel">
       <div class="space-y-4">
        <div class="rounded-[1.5rem] border border-white/10 bg-white/[0.04] p-4">
         <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-cyan-200/80">Model routing</p>
         <div class="mt-3 space-y-3">
          <label class="block space-y-2">
           <span class="block text-sm font-semibold text-white">Provider</span>
           <div class="flex gap-2">
            <select id="adminAiProvider" class="brox-ai-setting-select min-w-0 flex-1 rounded-2xl border border-white/10 bg-slate-900/80 px-3 py-3 text-sm text-slate-100 outline-none transition focus:border-cyan-400/50 focus:ring-2 focus:ring-cyan-400/20"></select>
            <button id="adminAiRefreshModels" class="inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-slate-200 transition hover:bg-white/10 hover:text-white" type="button" title="Refresh models">
             <i class="lucide lucide-refresh-cw text-sm"></i>
            </button>
           </div>
          </label>
          <label class="block space-y-2">
           <span class="block text-sm font-semibold text-white">Model</span>
           <select id="adminAiModel" class="brox-ai-setting-select w-full rounded-2xl border border-white/10 bg-slate-900/80 px-3 py-3 text-sm text-slate-100 outline-none transition focus:border-cyan-400/50 focus:ring-2 focus:ring-cyan-400/20"></select>
          </label>
          <label class="block space-y-2">
           <span class="block text-sm font-semibold text-white">Response format</span>
           <select id="adminAiResponseFormat" class="brox-ai-setting-select w-full rounded-2xl border border-white/10 bg-slate-900/80 px-3 py-3 text-sm text-slate-100 outline-none transition focus:border-cyan-400/50 focus:ring-2 focus:ring-cyan-400/20">
            <option value="text">Text</option>
            <option value="markdown">Markdown</option>
            <option value="json">JSON</option>
           </select>
          </label>
         </div>
        </div>

        <div class="rounded-[1.5rem] border border-white/10 bg-white/[0.04] p-4">
         <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-cyan-200/80">Automation toggles</p>
         <div class="mt-3 space-y-3">
          <div class="brox-ai-setting-item flex items-center justify-between gap-3 rounded-2xl border border-white/10 bg-slate-950/60 px-3 py-3">
           <label class="brox-ai-setting-label text-sm font-semibold text-white" for="adminAiDarkModeToggle">Dark Mode</label>
           <button class="brox-ai-toggle-switch relative inline-flex h-7 w-14 items-center rounded-full bg-slate-700 transition" id="adminAiDarkModeToggle" title="Toggle dark mode" data-feature="dark-mode">
            <span class="brox-ai-toggle-slider absolute left-1 h-5 w-5 rounded-full bg-white shadow transition"></span>
           </button>
          </div>
          <div class="brox-ai-setting-item flex items-center justify-between gap-3 rounded-2xl border border-white/10 bg-slate-950/60 px-3 py-3">
           <label class="brox-ai-setting-label text-sm font-semibold text-white" for="adminAiAutoSaveToggle">Auto-Save</label>
           <button class="brox-ai-toggle-switch relative inline-flex h-7 w-14 items-center rounded-full bg-slate-700 transition" id="adminAiAutoSaveToggle" title="Toggle auto-save">
            <span class="brox-ai-toggle-slider absolute left-1 h-5 w-5 rounded-full bg-white shadow transition"></span>
           </button>
          </div>
          <div class="brox-ai-setting-item flex items-center justify-between gap-3 rounded-2xl border border-white/10 bg-slate-950/60 px-3 py-3">
           <label class="brox-ai-setting-label text-sm font-semibold text-white" for="adminAiResponseHealingToggle">Response healing</label>
           <button class="brox-ai-toggle-switch relative inline-flex h-7 w-14 items-center rounded-full bg-slate-700 transition" id="adminAiResponseHealingToggle" title="Toggle response healing">
            <span class="brox-ai-toggle-slider absolute left-1 h-5 w-5 rounded-full bg-white shadow transition"></span>
           </button>
          </div>
          <div class="brox-ai-setting-item flex items-center justify-between gap-3 rounded-2xl border border-white/10 bg-slate-950/60 px-3 py-3">
           <label class="brox-ai-setting-label text-sm font-semibold text-white" for="adminAiWebPluginToggle">Web plugin</label>
           <div class="brox-ai-setting-inline flex items-center gap-2">
            <select id="adminAiWebMaxResults" class="brox-ai-setting-select rounded-2xl border border-white/10 bg-slate-900/80 px-3 py-2 text-sm text-slate-100 outline-none transition focus:border-cyan-400/50 focus:ring-2 focus:ring-cyan-400/20">
             <option value="1">1</option>
             <option value="2">2</option>
             <option value="3">3</option>
             <option value="5">5</option>
             <option value="10">10</option>
            </select>
            <button class="brox-ai-toggle-switch relative inline-flex h-7 w-14 items-center rounded-full bg-slate-700 transition" id="adminAiWebPluginToggle" title="Enable web plugin">
             <span class="brox-ai-toggle-slider absolute left-1 h-5 w-5 rounded-full bg-white shadow transition"></span>
            </button>
           </div>
          </div>
          <div class="brox-ai-setting-item flex items-center justify-between gap-3 rounded-2xl border border-white/10 bg-slate-950/60 px-3 py-3">
           <label class="brox-ai-setting-label text-sm font-semibold text-white" for="adminAiPdfPluginToggle">PDF parser</label>
           <div class="brox-ai-setting-inline flex items-center gap-2">
            <select id="adminAiPdfEngine" class="brox-ai-setting-select rounded-2xl border border-white/10 bg-slate-900/80 px-3 py-2 text-sm text-slate-100 outline-none transition focus:border-cyan-400/50 focus:ring-2 focus:ring-cyan-400/20">
             <option value="pdf-text">pdf-text</option>
             <option value="mistral-ocr">mistral-ocr</option>
             <option value="native">native</option>
            </select>
            <button class="brox-ai-toggle-switch relative inline-flex h-7 w-14 items-center rounded-full bg-slate-700 transition" id="adminAiPdfPluginToggle" title="Enable PDF parser plugin">
             <span class="brox-ai-toggle-slider absolute left-1 h-5 w-5 rounded-full bg-white shadow transition"></span>
            </button>
           </div>
          </div>
          <label class="block space-y-2 rounded-2xl border border-white/10 bg-slate-950/60 px-3 py-3">
           <span class="block text-sm font-semibold text-white">Reasoning effort</span>
           <select id="adminAiReasoningEffort" class="brox-ai-setting-select w-full rounded-2xl border border-white/10 bg-slate-900/80 px-3 py-3 text-sm text-slate-100 outline-none transition focus:border-cyan-400/50 focus:ring-2 focus:ring-cyan-400/20">
            <option value="">Default</option>
            <option value="none">none</option>
            <option value="minimal">minimal</option>
            <option value="low">low</option>
            <option value="medium">medium</option>
            <option value="high">high</option>
            <option value="xhigh">xhigh</option>
           </select>
          </label>
         </div>
        </div>

        <div class="rounded-[1.5rem] border border-white/10 bg-white/[0.04] p-4">
         <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-cyan-200/80">Advanced</p>
         <div class="mt-3 space-y-3">
          <button id="adminAiEnhancePrompt" type="button" class="brox-ai-action-chip inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-cyan-400 to-indigo-500 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:brightness-110">
           <i class="lucide lucide-stars"></i> Enhance Prompt
          </button>
          <label class="block space-y-2">
           <span class="block text-sm font-semibold text-white">Advanced options JSON</span>
           <textarea id="adminAiAdvancedOptionsJson" rows="7" class="brox-ai-setting-json w-full rounded-2xl border border-white/10 bg-slate-900/80 px-4 py-3 text-sm font-mono text-slate-100 outline-none transition focus:border-cyan-400/50 focus:ring-2 focus:ring-cyan-400/20" placeholder='{"temperature":0.4}'></textarea>
          </label>
         </div>
        </div>
       </div>
      </div>
     </div>
    </div>
   </aside>

   <section class="brox-ai-chat-main flex min-w-0 flex-col overflow-hidden">
    <div class="border-b border-white/10 bg-white/[0.04] px-4 py-4 sm:px-5">
     <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
       <div class="mb-2 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-2 rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-cyan-200">
         <i class="lucide lucide-stars text-[0.9rem]"></i>
         Copilot
        </span>
        <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[11px] font-semibold text-slate-300" id="adminAiContextBadge">
         <i class="lucide lucide-folder text-[0.9rem]"></i>
         <span id="adminAiContextModule">Global</span>
        </span>
       </div>
       <h3 class="flex items-center gap-2 text-[1.1rem] font-bold tracking-tight text-white" id="adminAiTitle">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-2xl bg-gradient-to-br from-cyan-400 to-indigo-500 text-slate-950 shadow-lg shadow-cyan-500/25">
         <i class="lucide lucide-bot text-[1.05rem]"></i>
        </span>
        Brox Admin Copilot
       </h3>
       <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-slate-300">
        <span id="adminAiStatusText" class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-2.5 py-1 font-medium text-emerald-200">Ready</span>
        <span class="brox-ai-model-status inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-2.5 py-1 font-medium text-slate-200" id="adminAiModelStatus">
         <span class="brox-ai-status-indicator" id="adminAiModelStatusIndicator" title="Model status"></span>
         <span class="brox-ai-model-name" id="adminAiCurrentModel">Loading...</span>
        </span>
       </div>
      </div>

      <div class="flex shrink-0 items-center gap-2">
       <button id="adminAiHistoryToggle" class="brox-ai-icon-btn inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-slate-200 transition hover:bg-white/10 hover:text-white" title="Chat history" aria-label="Chat history">
        <i class="lucide lucide-clock text-[1rem]"></i>
       </button>
       <button id="adminAiMinimize" class="brox-ai-icon-btn inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-slate-200 transition hover:bg-white/10 hover:text-white" title="Minimize" aria-label="Minimize">
        <i class="lucide lucide-minus text-[1rem]"></i>
       </button>
       <button id="adminAiClose" class="brox-ai-icon-btn inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-slate-200 transition hover:bg-rose-500/15 hover:text-rose-100" title="Close Sidebar" aria-label="Close">
        <i class="lucide lucide-x text-[1rem]"></i>
       </button>
      </div>
     </div>
    </div>

    <div id="adminAiBody" class="brox-ai-body custom-scrollbar brox-ai-scrollbar relative flex-1 overflow-y-auto px-4 py-4 sm:px-5" role="log" aria-live="polite">
     <div class="brox-ai-welcome" id="adminAiWelcome">
      <div class="rounded-[1.75rem] border border-white/10 bg-gradient-to-br from-white/[0.06] via-white/[0.04] to-transparent p-5 shadow-[0_16px_40px_rgba(2,6,23,0.2)]">
       <div class="flex items-start gap-4">
        <div class="brox-ai-welcome-icon flex h-14 w-14 shrink-0 items-center justify-center rounded-[1.35rem] bg-gradient-to-br from-cyan-400 via-sky-400 to-indigo-500 text-slate-950 shadow-lg shadow-cyan-500/25">
         <i class="lucide lucide-stars text-[1.35rem]"></i>
        </div>
        <div class="min-w-0">
         <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-cyan-200/80">Welcome</p>
         <h4 class="mt-1 text-xl font-bold text-white">Welcome to Admin Copilot</h4>
         <p class="mt-1 text-sm leading-6 text-slate-300">Use slash commands, collect page context, or generate replies with the tools below.</p>
        </div>
       </div>

       <div class="brox-ai-welcome-commands mt-5 grid gap-2 sm:grid-cols-2">
        <button class="brox-ai-cmd-chip inline-flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-3 py-3 text-sm font-semibold text-slate-200 transition hover:bg-white/10 hover:text-white" data-cmd="/summarize">
         <i class="lucide lucide-text"></i> /summarize
        </button>
        <button class="brox-ai-cmd-chip inline-flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-3 py-3 text-sm font-semibold text-slate-200 transition hover:bg-white/10 hover:text-white" data-cmd="/analyze-logs">
         <i class="lucide lucide-file-text"></i> /analyze-logs
        </button>
        <button class="brox-ai-cmd-chip inline-flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-3 py-3 text-sm font-semibold text-slate-200 transition hover:bg-white/10 hover:text-white" data-cmd="/list-tools">
         <i class="lucide lucide-list-checks"></i> /list-tools
        </button>
        <button class="brox-ai-cmd-chip inline-flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-3 py-3 text-sm font-semibold text-slate-200 transition hover:bg-white/10 hover:text-white" data-cmd="/help">
         <i class="lucide lucide-help-circle"></i> /help
        </button>
       </div>
      </div>
     </div>

     <div class="thinking-indicator brox-ai-hidden mt-4" id="adminAiThinkingIndicator"></div>
     <div class="d-none mt-4 rounded-2xl border border-cyan-400/15 bg-cyan-400/10 px-4 py-3 text-sm text-cyan-100" id="adminAiTypingIndicator">
      <div class="flex items-center gap-2">
       <span class="inline-flex h-2.5 w-2.5 animate-pulse rounded-full bg-cyan-300"></span>
       Assistant is preparing a response...
      </div>
     </div>

     <div id="adminAiSlashMenu" class="brox-ai-slash-menu brox-ai-hidden absolute inset-x-4 top-4 z-20 rounded-[1.5rem] border border-white/10 bg-slate-950/98 shadow-[0_20px_50px_rgba(2,6,23,0.28)] backdrop-blur-xl" role="menu">
      <div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
       <span class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Commands</span>
       <button class="brox-ai-slash-close inline-flex h-8 w-8 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 transition hover:bg-white/10 hover:text-white" aria-label="Close menu">
        <i class="lucide lucide-x text-sm"></i>
       </button>
      </div>
      <ul class="brox-ai-slash-list max-h-80 overflow-y-auto p-2">
       <li class="brox-ai-slash-item flex cursor-pointer items-start gap-3 rounded-2xl px-3 py-3 transition hover:bg-white/5" data-cmd="/summarize" role="menuitem">
        <div class="brox-ai-slash-icon flex h-10 w-10 items-center justify-center rounded-2xl bg-cyan-400/10 text-cyan-200"><i class="lucide lucide-text"></i></div>
        <div class="brox-ai-slash-info">
         <strong class="block text-sm font-semibold text-white">/summarize</strong>
         <small class="block text-xs leading-5 text-slate-400">Summarize current page data</small>
        </div>
       </li>
       <li class="brox-ai-slash-item flex cursor-pointer items-start gap-3 rounded-2xl px-3 py-3 transition hover:bg-white/5" data-cmd="/analyze-logs" role="menuitem">
        <div class="brox-ai-slash-icon flex h-10 w-10 items-center justify-center rounded-2xl bg-cyan-400/10 text-cyan-200"><i class="lucide lucide-file-text"></i></div>
        <div class="brox-ai-slash-info">
         <strong class="block text-sm font-semibold text-white">/analyze-logs</strong>
         <small class="block text-xs leading-5 text-slate-400">Analyze system error logs</small>
        </div>
       </li>
       <li class="brox-ai-slash-item flex cursor-pointer items-start gap-3 rounded-2xl px-3 py-3 transition hover:bg-white/5" data-cmd="/clear-cache" role="menuitem">
        <div class="brox-ai-slash-icon flex h-10 w-10 items-center justify-center rounded-2xl bg-cyan-400/10 text-cyan-200"><i class="lucide lucide-trash-2"></i></div>
        <div class="brox-ai-slash-info">
         <strong class="block text-sm font-semibold text-white">/clear-cache</strong>
         <small class="block text-xs leading-5 text-slate-400">Clear system cache</small>
        </div>
       </li>
       <li class="brox-ai-slash-item flex cursor-pointer items-start gap-3 rounded-2xl px-3 py-3 transition hover:bg-white/5" data-cmd="/search-kb" role="menuitem">
        <div class="brox-ai-slash-icon flex h-10 w-10 items-center justify-center rounded-2xl bg-cyan-400/10 text-cyan-200"><i class="lucide lucide-book"></i></div>
        <div class="brox-ai-slash-info">
         <strong class="block text-sm font-semibold text-white">/search-kb</strong>
         <small class="block text-xs leading-5 text-slate-400">Search knowledge base</small>
        </div>
       </li>
       <li class="brox-ai-slash-item flex cursor-pointer items-start gap-3 rounded-2xl px-3 py-3 transition hover:bg-white/5" data-cmd="/web-search" role="menuitem">
        <div class="brox-ai-slash-icon flex h-10 w-10 items-center justify-center rounded-2xl bg-cyan-400/10 text-cyan-200"><i class="lucide lucide-globe"></i></div>
        <div class="brox-ai-slash-info">
         <strong class="block text-sm font-semibold text-white">/web-search</strong>
