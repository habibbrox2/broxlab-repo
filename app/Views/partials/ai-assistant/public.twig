{# Premium Public AI Assistant - conversational glassmorphism shell #}
{# Keep all existing IDs for compatibility with public assistant JS #}

<div id="publicAssistantWrapper" class="pointer-events-none fixed bottom-4 right-4 z-[9999] flex flex-col items-end gap-3 sm:bottom-5 sm:right-5">

 <button
  id="publicAssistantBtn"
  class="brox-ai-trigger-fab pointer-events-auto group relative inline-flex h-14 w-14 items-center justify-center overflow-hidden rounded-[1.35rem] border border-white/15 bg-slate-950/95 text-white shadow-[0_24px_60px_rgba(2,6,23,0.35)] backdrop-blur-xl transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_30px_80px_rgba(14,165,233,0.35)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400/80"
  title="Chat with Assistant"
  aria-label="Open Chat"
  type="button">
  <span class="brox-ai-fab-icon-open flex items-center justify-center">
   <i class="lucide lucide-message-square-more text-[1.35rem]"></i>
  </span>
  <span class="brox-ai-fab-icon-close hidden items-center justify-center">
   <i class="lucide lucide-x text-[1.35rem]"></i>
  </span>
  <span class="absolute inset-x-0 bottom-0 h-1 bg-gradient-to-r from-cyan-400 via-sky-400 to-indigo-500 opacity-90"></span>
 </button>

 <div
  id="publicAssistantChat"
  class="brox-ai-copilot-sidebar brox-ai-hidden pointer-events-auto relative w-[min(26.5rem,calc(100vw-1.25rem))] overflow-hidden rounded-[2rem] border border-white/12 bg-slate-950/95 text-slate-100 shadow-[0_35px_100px_rgba(2,6,23,0.45)] backdrop-blur-2xl"
  role="dialog"
  aria-labelledby="publicAssistantTitle"
  aria-modal="true">

  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(34,211,238,0.18),transparent_35%),radial-gradient(circle_at_bottom_left,rgba(59,130,246,0.16),transparent_30%)]"></div>
  <div class="relative flex h-[min(78vh,46rem)] flex-col">

   <div class="grid grid-cols-[minmax(0,1fr)_20rem] border-b border-white/10 lg:grid-cols-[minmax(0,1fr)_16.5rem]">
    <div class="brox-ai-chat-main flex min-w-0 flex-col overflow-hidden">
     <div class="border-b border-white/8 bg-white/[0.03] px-4 py-4 sm:px-5">
      <div class="flex items-start justify-between gap-3">
       <div class="min-w-0">
        <div class="mb-2 flex flex-wrap items-center gap-2">
         <span class="inline-flex items-center gap-2 rounded-full border border-cyan-400/25 bg-cyan-400/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-cyan-200">
          <i class="lucide lucide-sparkles text-[0.9rem]"></i>
          Public assistant
         </span>
         <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[11px] font-semibold text-slate-300">
          <i class="lucide lucide-globe-2 text-[0.9rem]"></i>
          Bilingual support
         </span>
        </div>
        <h3 class="flex items-center gap-2 text-[1.1rem] font-bold tracking-tight text-white" id="publicAssistantTitle">
         <span class="inline-flex h-9 w-9 items-center justify-center rounded-2xl bg-gradient-to-br from-cyan-400 to-indigo-500 text-slate-950 shadow-lg shadow-cyan-500/25">
          <i class="lucide lucide-bot text-[1.05rem]"></i>
         </span>
         Brox AI
        </h3>
        <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-slate-300">
         <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-2.5 py-1 font-medium text-emerald-200">
          <span id="publicAssistantStatusIndicator" class="h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(16,185,129,0.12)]"></span>
          <span id="publicAssistantStatusText">Online</span>
         </span>
         <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-2.5 py-1 font-medium text-slate-200" id="publicAssistantModelName">
          <i class="lucide lucide-award text-[0.9rem] text-cyan-300"></i>
          Claude 3 Haiku
         </span>
         <span id="publicAssistantModelStatusIndicator" class="brox-ai-status-indicator brox-ai-connecting" title="Model status"></span>
         <span class="inline-flex items-center gap-1 rounded-full border border-white/10 bg-white/5 px-2.5 py-1 font-medium text-slate-300" id="publicAssistantOpenRouterKeyStatus">
          <i class="lucide lucide-key-round text-[0.9rem]"></i>
          Provider keys ready
         </span>
         <span class="inline-flex items-center gap-1 rounded-full border border-amber-400/20 bg-amber-400/10 px-2.5 py-1 font-medium text-amber-200 d-none" id="publicAssistantFallbackBadge">
          <i class="lucide lucide-shield-alert text-[0.9rem]"></i>
          Fallback mode
         </span>
        </div>
       </div>

       <div class="flex shrink-0 items-start gap-2">
        <div class="inline-flex items-center gap-1 rounded-2xl border border-white/10 bg-white/5 p-1">
         <button id="publicAssistantLangBn" class="brox-ai-model-toggle rounded-xl px-3 py-1.5 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-slate-300 transition hover:bg-white/10" title="Bangla" aria-label="Switch to Bengali">BN</button>
         <button id="publicAssistantLangEn" class="brox-ai-model-toggle active rounded-xl bg-white/10 px-3 py-1.5 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-white transition" title="English" aria-label="Switch to English">EN</button>
        </div>
        <button id="publicAssistantModelToggle" class="brox-ai-icon-btn inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-slate-200 transition hover:bg-white/10 hover:text-white" title="Toggle Model Selector" aria-label="Toggle model selector">
         <i class="lucide lucide-chevron-down text-[1rem]"></i>
        </button>
        <button id="closePublicAssistant" class="brox-ai-icon-btn inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-slate-200 transition hover:bg-rose-500/15 hover:text-rose-100" title="Close Assistant" aria-label="Close assistant">
         <i class="lucide lucide-x text-[1rem]"></i>
        </button>
       </div>
      </div>
     </div>

     <div id="publicAssistantModelBar" class="brox-ai-model-bar brox-ai-collapsed border-b border-white/10 bg-white/[0.03] px-4 py-4 sm:px-5">
      <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
       <label class="space-y-1.5">
        <span id="publicAssistantModelLabel" class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400">Select model</span>
        <select id="publicAssistantProvider" class="brox-ai-model-select w-full rounded-2xl border border-white/10 bg-slate-900/80 px-3 py-3 text-sm text-slate-100 outline-none transition focus:border-cyan-400/50 focus:ring-2 focus:ring-cyan-400/20" aria-label="Select AI provider"></select>
       </label>
       <label class="space-y-1.5">
        <span class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400">Model</span>
        <select id="publicAssistantModel" class="brox-ai-model-select w-full rounded-2xl border border-white/10 bg-slate-900/80 px-3 py-3 text-sm text-slate-100 outline-none transition focus:border-cyan-400/50 focus:ring-2 focus:ring-cyan-400/20" aria-label="Select AI model">
         <option value="claude-3-haiku">Claude 3 Haiku</option>
        </select>
       </label>
      </div>
     </div>

     <div id="publicAssistantAgenticStatus" class="brox-ai-status-bar brox-ai-hidden border-b border-cyan-400/15 bg-cyan-400/10 px-4 py-3 text-sm text-cyan-100 sm:px-5">
      <span class="brox-ai-status-indicator brox-ai-thinking"></span>
      <span class="ai-status-detail">Thinking...</span>
     </div>

     <div id="publicAssistantPreChat" class="brox-ai-body brox-ai-prechat flex-1 overflow-y-auto px-4 py-4 sm:px-5">
      <div class="rounded-[1.75rem] border border-white/10 bg-white/[0.04] p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] sm:p-5">
       <div class="flex items-start gap-4">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-[1.35rem] bg-gradient-to-br from-cyan-400 via-sky-400 to-indigo-500 text-slate-950 shadow-lg shadow-cyan-500/25">
         <i class="lucide lucide-rocket text-[1.35rem]"></i>
        </div>
        <div class="min-w-0">
         <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-cyan-200/80">Welcome</p>
         <h4 class="mt-1 text-xl font-bold text-white">How can I help you today?</h4>
         <p class="mt-1 text-sm leading-6 text-slate-300">Start with a quick question or share your details to personalize the experience.</p>
        </div>
       </div>

       <div class="mt-4 grid gap-2 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/8 bg-slate-900/60 px-3 py-3">
         <div class="flex items-center gap-2 text-sm font-semibold text-white"><i class="lucide lucide-badge-info text-cyan-300"></i> Smart help</div>
         <p class="mt-1 text-xs leading-5 text-slate-400">Concise answers, friendly tone, and site-aware support.</p>
        </div>
        <div class="rounded-2xl border border-white/8 bg-slate-900/60 px-3 py-3">
         <div class="flex items-center gap-2 text-sm font-semibold text-white"><i class="lucide lucide-language text-sky-300"></i> Bangla + English</div>
         <p class="mt-1 text-xs leading-5 text-slate-400">Switch language instantly with the chips above.</p>
        </div>
        <div class="rounded-2xl border border-white/8 bg-slate-900/60 px-3 py-3">
         <div class="flex items-center gap-2 text-sm font-semibold text-white"><i class="lucide lucide-shield-check text-emerald-300"></i> Safe by design</div>
         <p class="mt-1 text-xs leading-5 text-slate-400">Sensitive actions stay outside the public assistant.</p>
        </div>
       </div>

       <div class="mt-5 space-y-4">
        <div class="brox-ai-step-name rounded-[1.5rem] border border-white/10 bg-slate-950/65 p-4 shadow-[0_16px_50px_rgba(2,6,23,0.25)]">
         <div class="brox-ai-form-group space-y-2">
          <label id="introNameLabel" for="introName" class="block text-sm font-semibold text-white">Your Name</label>
          <input type="text" id="introName" class="brox-ai-input w-full rounded-2xl border border-white/10 bg-slate-900/80 px-4 py-3 text-sm text-slate-100 placeholder:text-slate-400 outline-none transition focus:border-cyan-400/50 focus:ring-2 focus:ring-cyan-400/20" placeholder="Your name">
         </div>
         <div id="publicAssistantPreChatError" class="brox-ai-hidden mt-2 rounded-2xl border border-rose-400/20 bg-rose-400/10 px-4 py-3 text-sm text-rose-100" aria-live="polite"></div>
         <button class="brox-ai-primary-btn mt-3 inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-cyan-400 to-indigo-500 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:brightness-110" id="introNext1">
          <i class="lucide lucide-arrow-right"></i>
          Continue
         </button>
        </div>

        <div class="brox-ai-step-contact brox-ai-hidden rounded-[1.5rem] border border-white/10 bg-slate-950/65 p-4 shadow-[0_16px_50px_rgba(2,6,23,0.25)]">
         <div class="grid gap-3 sm:grid-cols-2">
          <div class="brox-ai-form-group space-y-2">
           <label id="introEmailLabel" for="introEmail" class="block text-sm font-semibold text-white">Email (optional)</label>
           <input type="email" id="introEmail" class="brox-ai-input w-full rounded-2xl border border-white/10 bg-slate-900/80 px-4 py-3 text-sm text-slate-100 placeholder:text-slate-400 outline-none transition focus:border-cyan-400/50 focus:ring-2 focus:ring-cyan-400/20" placeholder="Email (optional)">
          </div>
          <div class="brox-ai-form-group space-y-2">
           <label id="introMobileLabel" for="introMobile" class="block text-sm font-semibold text-white">Mobile (optional)</label>
           <input type="text" id="introMobile" class="brox-ai-input w-full rounded-2xl border border-white/10 bg-slate-900/80 px-4 py-3 text-sm text-slate-100 placeholder:text-slate-400 outline-none transition focus:border-cyan-400/50 focus:ring-2 focus:ring-cyan-400/20" placeholder="Mobile (optional)">
          </div>
         </div>
         <button class="brox-ai-primary-btn mt-3 inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-cyan-400 to-indigo-500 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:brightness-110" id="introNext2">
          <i class="lucide lucide-arrow-right"></i>
          Continue
         </button>
        </div>

        <div class="brox-ai-step-topic brox-ai-hidden rounded-[1.5rem] border border-white/10 bg-slate-950/65 p-4 shadow-[0_16px_50px_rgba(2,6,23,0.25)]">
         <div class="brox-ai-form-group space-y-3">
          <label id="introTopicLabel" class="block text-sm font-semibold text-white">What would you like to know about?</label>
          <div class="brox-ai-topic-grid grid gap-2 sm:grid-cols-2" id="introTopicOptions">
           <label class="brox-ai-topic-chip flex cursor-pointer items-center gap-2 rounded-2xl border border-white/10 bg-white/[0.04] px-3 py-3 text-sm text-slate-200 transition hover:border-cyan-400/40 hover:bg-cyan-400/10">
            <input class="intro-topic-option h-4 w-4 rounded border-slate-500 bg-transparent text-cyan-400 focus:ring-cyan-400/20" type="checkbox" value="general" checked>
            <span>General</span>
           </label>
           <label class="brox-ai-topic-chip flex cursor-pointer items-center gap-2 rounded-2xl border border-white/10 bg-white/[0.04] px-3 py-3 text-sm text-slate-200 transition hover:border-cyan-400/40 hover:bg-cyan-400/10">
            <input class="intro-topic-option h-4 w-4 rounded border-slate-500 bg-transparent text-cyan-400 focus:ring-cyan-400/20" type="checkbox" value="support">
            <span>Support</span>
           </label>
           <label class="brox-ai-topic-chip flex cursor-pointer items-center gap-2 rounded-2xl border border-white/10 bg-white/[0.04] px-3 py-3 text-sm text-slate-200 transition hover:border-cyan-400/40 hover:bg-cyan-400/10">
            <input class="intro-topic-option h-4 w-4 rounded border-slate-500 bg-transparent text-cyan-400 focus:ring-cyan-400/20" type="checkbox" value="billing">
            <span>Billing</span>
           </label>
           <label class="brox-ai-topic-chip flex cursor-pointer items-center gap-2 rounded-2xl border border-white/10 bg-white/[0.04] px-3 py-3 text-sm text-slate-200 transition hover:border-cyan-400/40 hover:bg-cyan-400/10">
            <input class="intro-topic-option h-4 w-4 rounded border-slate-500 bg-transparent text-cyan-400 focus:ring-cyan-400/20" type="checkbox" value="feedback">
            <span>Feedback</span>
           </label>
          </div>
         </div>
         <button class="brox-ai-primary-btn mt-3 inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-cyan-400 to-indigo-500 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:brightness-110" id="introStartChat">
          <i class="lucide lucide-sparkles"></i>
          Start Chat
         </button>
        </div>
       </div>
      </div>
     </div>

     <div id="publicAssistantMessages" class="brox-ai-body custom-scrollbar brox-ai-scrollbar d-none flex-1 overflow-y-auto px-4 py-4 sm:px-5" role="log" aria-live="polite">
      {# Messages injected here by assistant.js #}
     </div>

     <div id="publicAssistantThinkingIndicator" class="brox-ai-hidden border-t border-white/10 bg-slate-950/90 px-4 py-4 sm:px-5"></div>

     <div id="publicAssistantLoading" class="d-none border-t border-white/10 bg-slate-950/90 px-4 py-3 text-xs font-medium text-cyan-100 sm:px-5">
      <div class="flex items-center gap-2">
       <span class="inline-flex h-2.5 w-2.5 animate-pulse rounded-full bg-cyan-400"></span>
       Loading assistant resources...
      </div>
     </div>

     <div id="publicAssistantSuggestionPanel" class="brox-ai-suggestion-panel brox-ai-hidden absolute inset-x-4 bottom-[5.75rem] z-20 rounded-[1.35rem] border border-white/10 bg-slate-950/98 shadow-[0_20px_50px_rgba(2,6,23,0.28)] backdrop-blur-xl" role="listbox">
      <div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
       <span class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Suggestions</span>
       <button class="brox-ai-suggestion-close inline-flex h-8 w-8 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 transition hover:bg-white/10 hover:text-white" aria-label="Close suggestions">
        <i class="lucide lucide-x text-sm"></i>
       </button>
      </div>
      <ul class="brox-ai-suggestion-list max-h-72 overflow-y-auto p-2" id="publicAssistantSuggestions"></ul>
     </div>

     <div id="publicAssistantAttachmentPreview" class="brox-ai-attachment-preview brox-ai-hidden border-t border-white/10 bg-slate-950/90 px-4 py-3 sm:px-5">
      <div class="flex items-start gap-3">
       <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-cyan-400/10 text-cyan-200">
        <i class="lucide lucide-paperclip"></i>
       </div>
       <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2 text-sm text-slate-100">
         <div class="brox-ai-attachment-thumb flex h-10 w-10 items-center justify-center rounded-2xl bg-white/5" id="publicAssistantAttachmentThumb"></div>
         <span class="brox-ai-attachment-name font-medium" id="publicAssistantFileName">file.pdf</span>
         <span class="brox-ai-attachment-size text-xs text-slate-400" id="publicAssistantFileSize">0 KB</span>
        </div>
        <div class="brox-ai-attachment-progress brox-ai-hidden mt-2 h-1.5 rounded-full bg-white/10" id="publicAssistantAttachmentProgress">
         <span class="brox-ai-attachment-progress-bar block h-full rounded-full bg-gradient-to-r from-cyan-400 to-indigo-500" id="publicAssistantAttachmentProgressBar"></span>
        </div>
       </div>
       <button class="brox-ai-attachment-remove inline-flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 transition hover:bg-rose-500/15 hover:text-rose-100" id="publicAssistantRemoveAttachment" aria-label="Remove attachment">
        <i class="lucide lucide-x text-sm"></i>
       </button>
      </div>
     </div>

     <div id="publicAssistantQuickActions" class="brox-ai-quick-actions grid gap-2 border-t border-white/10 bg-white/[0.03] px-4 py-3 sm:grid-cols-2 sm:px-5" aria-label="Quick actions">
      <button type="button" class="brox-ai-action-chip inline-flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-3 py-2.5 text-sm font-semibold text-slate-200 transition hover:bg-white/10 hover:text-white" id="publicAssistantCollectData" title="Collect visible form fields">
       <i class="lucide lucide-clipboard"></i> Collect
      </button>
      <button type="button" class="brox-ai-action-chip inline-flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-3 py-2.5 text-sm font-semibold text-slate-200 transition hover:bg-white/10 hover:text-white" id="publicAssistantAutoFill" title="Auto-fill form (uses URL in input if present)">
       <i class="lucide lucide-wand-sparkles"></i> Auto-fill
      </button>
      <button type="button" class="brox-ai-action-chip inline-flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-3 py-2.5 text-sm font-semibold text-slate-200 transition hover:bg-white/10 hover:text-white" id="publicAssistantQuickSummarize" title="Summarize current page">
       <i class="lucide lucide-text"></i> Summarize
      </button>
      <button type="button" class="brox-ai-action-chip inline-flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-3 py-2.5 text-sm font-semibold text-slate-200 transition hover:bg-white/10 hover:text-white" id="publicAssistantClear" title="Clear chat history">
       <i class="lucide lucide-trash-2"></i> Clear
      </button>
     </div>

     <div id="publicAssistantFooter" class="brox-ai-footer border-t border-white/10 bg-slate-950/95 px-4 py-4 sm:px-5 d-none">
      <div class="input-group brox-ai-input-wrapper flex items-end gap-2 rounded-[1.4rem] border border-white/10 bg-white/[0.04] p-2 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)]">
       <button id="publicAssistantAttach" class="brox-ai-action-btn inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-slate-200 transition hover:bg-white/10 hover:text-white" title="Attach file" aria-label="Attach file">
        <i class="lucide lucide-paperclip text-[1rem]"></i>
       </button>
       <div class="brox-ai-input-container relative flex-1">
        <input type="text" id="publicAssistantInput" class="brox-ai-input w-full rounded-[1.2rem] border border-white/10 bg-slate-900/80 px-4 py-3 text-sm text-slate-100 placeholder:text-slate-400 outline-none transition focus:border-cyan-400/50 focus:ring-2 focus:ring-cyan-400/20" placeholder="Message Brox AI..." aria-label="Message input">
       </div>
       <button id="sendToPublicAssistant" class="brox-ai-send-btn inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-cyan-400 to-indigo-500 text-slate-950 transition hover:brightness-110" title="Send message" aria-label="Send">
        <i class="lucide lucide-send text-[1rem]"></i>
       </button>
      </div>
      <div class="brox-ai-input-hint mt-3 flex flex-wrap gap-2 text-[11px] text-slate-400">
       <span class="inline-flex items-center gap-1 rounded-full border border-white/10 bg-white/5 px-2.5 py-1"><kbd class="rounded-md border border-white/10 bg-slate-900/80 px-1.5 py-0.5 text-[10px] font-semibold text-slate-100">Enter</kbd> Send</span>
       <span class="inline-flex items-center gap-1 rounded-full border border-white/10 bg-white/5 px-2.5 py-1"><kbd class="rounded-md border border-white/10 bg-slate-900/80 px-1.5 py-0.5 text-[10px] font-semibold text-slate-100">Ctrl + Enter</kbd> Send</span>
       <span class="inline-flex items-center gap-1 rounded-full border border-white/10 bg-white/5 px-2.5 py-1"><kbd class="rounded-md border border-white/10 bg-slate-900/80 px-1.5 py-0.5 text-[10px] font-semibold text-slate-100">Shift + Enter</kbd> New line</span>
       <span class="inline-flex items-center gap-1 rounded-full border border-white/10 bg-white/5 px-2.5 py-1"><kbd class="rounded-md border border-white/10 bg-slate-900/80 px-1.5 py-0.5 text-[10px] font-semibold text-slate-100">/</kbd> Commands</span>
      </div>
     </div>
    </div>

