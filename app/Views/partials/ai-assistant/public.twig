{# Premium AI Assistant – Grok-Style Dark Theme (2026 Edition) #}
{# IMPORTANT: Uses unique 'brox-ai-' prefix for all classes to avoid conflicts #}
{# IDs align with assistant.js (BroxAssistant class) #}

<div id="publicAssistantWrapper" class="bb-assistant-public">

    {# ── Floating Action Button - Grok Style ── #}
    <button id="publicAssistantBtn" class="brox-ai-grok-fab" title="Chat with Assistant" aria-label="Open Chat">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
    </button>

    {# ── Chat Window Shell - Grok Style ── #}
    <div id="publicAssistantChat" class="brox-ai-grok-shell brox-ai-hidden">

        {# ── Header - Minimal Grok Style ── #}
        <div class="brox-ai-grok-header">
            <div class="brox-ai-grok-title">
                <span id="publicAssistantTitle">Brox AI</span>
                <span class="brox-ai-grok-badge" id="publicAssistantModelName">AI</span>
                <span class="brox-ai-status-indicator brox-ai-online" id="publicAssistantStatusIndicator"></span>
            </div>
            <div class="brox-ai-grok-controls">
                <button id="publicAssistantModelToggle" class="brox-ai-model-toggle" title="Toggle Model Selector">
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="brox-ai-lang-toggle">
                    <button type="button" id="publicAssistantLangBn" class="active">বাং</button>
                    <button type="button" id="publicAssistantLangEn">EN</button>
                </div>
                <button id="closePublicAssistant" class="brox-ai-grok-close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 6L6 18M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </div>

        {# ── Model Selector Bar ── #}
        <div id="publicAssistantModelBar" class="brox-ai-model-bar brox-ai-collapsed">
            <div class="brox-ai-model-bar-content">
                <label id="publicAssistantModelLabel" class="brox-ai-model-label">Select Model:</label>
                <select id="publicAssistantModel" class="brox-ai-model-select">
                    <option value="claude-3-haiku">Claude 3 Haiku</option>
                </select>
            </div>
        </div>

        {# ── Sidebar (Chat History) ── #}
        <div id="publicAssistantSidebar" class="brox-ai-sidebar brox-ai-collapsed">
            <div class="brox-ai-sidebar-header">
                <span>Chat History</span>
                <button id="toggleAiSidebar" class="brox-ai-icon-btn-sm" aria-label="Toggle history">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </div>
            <div id="publicAssistantHistory" class="brox-ai-history-list"></div>
        </div>

        {# ── GDPR Privacy Consent Modal ── #}
        <div id="publicAssistantGdpr" class="brox-ai-grok-modal brox-ai-hidden">
            <div class="brox-ai-grok-modal-content">
                <div class="brox-ai-grok-modal-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                </div>
                <h3>Privacy Notice</h3>
                <p id="gdprTextBn">আমরা আপনার তথ্য সংগ্রহ করি যাতে আপনাকে ভালোভাবে সাহায্য করতে পারি।</p>
                <p id="gdprTextEn" class="d-none">We collect your information to provide better assistance.</p>
                <div class="brox-ai-grok-consent-options">
                    <label class="brox-ai-grok-checkbox">
                        <input type="checkbox" id="gdprConsentData" checked>
                        <span>Data Collection</span>
                    </label>
                    <label class="brox-ai-grok-checkbox">
                        <input type="checkbox" id="gdprConsentAnalytics">
                        <span>Analytics</span>
                    </label>
                </div>
                <div class="brox-ai-grok-modal-actions">
                    <button class="brox-ai-grok-btn-secondary" id="gdprDecline">Later</button>
                    <button class="brox-ai-grok-btn-primary" id="gdprAccept">Accept</button>
                </div>
            </div>
        </div>

        {# ── Pre-chat Workflow ── #}
        <div id="publicAssistantPreChat" class="brox-ai-grok-body">
            <div class="brox-ai-grok-welcome">
                <div class="brox-ai-grok-logo">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                    </svg>
                </div>
                <h2>How can I help you today?</h2>
                
                {# Step 1: Name #}
                <div class="brox-ai-grok-form brox-ai-step-name">
                    <label id="introNameLabel" class="brox-ai-input-label">Your Name</label>
                    <input type="text" id="introName" class="brox-ai-grok-input" placeholder="Your name">
                    <button class="brox-ai-grok-btn-primary" id="introNext1">Continue</button>
                </div>
                
                {# Step 2: Contact (hidden initially) #}
                <div class="brox-ai-grok-form brox-ai-step-contact brox-ai-hidden">
                    <label id="introEmailLabel" class="brox-ai-input-label">Email (optional)</label>
                    <input type="email" id="introEmail" class="brox-ai-grok-input" placeholder="Email (optional)">
                    <label id="introMobileLabel" class="brox-ai-input-label">Mobile (optional)</label>
                    <input type="text" id="introMobile" class="brox-ai-grok-input" placeholder="Mobile (optional)">
                    <button class="brox-ai-grok-btn-primary" id="introNext2">Continue</button>
                </div>
                
                {# Step 3: Topics (hidden initially) #}
                <div class="brox-ai-grok-form brox-ai-step-topic brox-ai-hidden">
                    <label id="introTopicLabel" class="brox-ai-input-label">What would you like to know about?</label>
                    <p class="brox-ai-grok-topic-label">Select Topics (Multi-select)</p>
                    <div class="brox-ai-topic-grid" id="introTopicOptions">
                        <label class="brox-ai-topic-chip">
                            <input type="checkbox" value="general" checked>
                            <span>General</span>
                        </label>
                        <label class="brox-ai-topic-chip">
                            <input type="checkbox" value="support">
                            <span>Support</span>
                        </label>
                        <label class="brox-ai-topic-chip">
                            <input type="checkbox" value="billing">
                            <span>Billing</span>
                        </label>
                        <label class="brox-ai-topic-chip">
                            <input type="checkbox" value="feedback">
                            <span>Feedback</span>
                        </label>
                    </div>
                    <button class="brox-ai-grok-btn-primary" id="introStartChat">Start Chat</button>
                </div>
            </div>
        </div>

        {# ── Chat Messages Area ── #}
        <div id="publicAssistantMessages" class="brox-ai-grok-messages brox-ai-hidden">
            {# Messages injected here by assistant.js #}
        </div>

        {# ── Modern Thinking Indicator ── #}
        <div id="publicAssistantThinkingIndicator" class="thinking-indicator brox-ai-hidden">
            <div class="thinking-content">
                <span class="thinking-text">Thinking...</span>
                <div class="thinking-dots">
                    <span class="thinking-dot"></span>
                    <span class="thinking-dot"></span>
                    <span class="thinking-dot"></span>
                </div>
            </div>
        </div>

        {# ── Footer / Input Area ── #}
        <div class="brox-ai-grok-footer brox-ai-hidden" id="publicAssistantFooter">
            <div class="brox-ai-grok-suggestions brox-ai-hidden" id="publicAssistantSuggestions"></div>
            <div class="brox-ai-grok-quick-actions brox-ai-hidden" id="publicAssistantQuickActions"></div>
            
            <div class="brox-ai-grok-input-wrapper">
                <input type="text" id="publicAssistantInput" class="brox-ai-grok-input" placeholder="Message Brox AI...">
                <button class="brox-ai-grok-send" id="sendToPublicAssistant">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                    </svg>
                </button>
            </div>
        </div>
        
        {# Hidden elements for JS references #}
        <span id="publicAssistantStatusText" class="brox-ai-hidden">Online</span>
    </div>
</div>
