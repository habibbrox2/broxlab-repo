{# Share This Component #}
<div class="share-section rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4 bg-slate-100 p-4">
 <h5 class="mb-3 font-bold flex items-center">
 <i class="lucide lucide-share-2 mr-2 text-indigo-600"></i> Share This
 </h5>
 
 <div class="share-buttons flex flex-wrap gap-2">
 {# Twitter/X Share #}
 <a href="https://twitter.com/intent/tweet?url={{ url|default(request.url) }}&text={{ title|default('Check this out')|url_encode }}"
 target="_blank"
 rel="noopener noreferrer"
 class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-sky-50 hover:border-sky-300 hover:text-sky-600 shadow-sm"
 title="Share on Twitter/X"
 data-action="open-share" data-share="twitter" target="_blank">
 <i class="lucide lucide-share-2 mr-2"></i>Twitter/X
 </a>

 {# LinkedIn Share #}
 <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ url|default(request.url) }}"
 target="_blank"
 rel="noopener noreferrer"
 class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-blue-50 hover:border-blue-300 hover:text-blue-600 shadow-sm"
 title="Share on LinkedIn"
 data-action="open-share" data-share="linkedin" target="_blank">
 <i class="lucide lucide-briefcase mr-2"></i>LinkedIn
 </a>

 {# WhatsApp Share #}
 <a href="https://wa.me/?text={{ title|default('Check this out')|url_encode }}%20{{ url|default(request.url) }}"
 target="_blank"
 rel="noopener noreferrer"
 class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-emerald-50 hover:border-emerald-300 hover:text-emerald-600 shadow-sm"
 title="Share on WhatsApp"
 data-action="open-share" data-share="whatsapp" target="_blank">
 <i class="lucide lucide-message-circle mr-2"></i>WhatsApp
 </a>


 {# Email Share #}
 <a href="mailto:?subject={{ title|default('Check this out')|url_encode }}&body={{ description|default('I thought you might like this')|url_encode }}%0D%0A{{ url|default(request.url) }}"
 class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 hover:border-slate-300 shadow-sm"
 title="Share via Email">
 <i class="lucide lucide-mail mr-2"></i>Email
 </a>

 {# Copy Link #}
 <button type="button" 
 class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 hover:border-slate-300 shadow-sm"
 id="copyLinkBtn"
 title="Copy link to clipboard"
 data-action="copy-to-clipboard" data-url="{{ url|default(request.url) }}">
 <i class="lucide lucide-link mr-2"></i>Copy Link
 </button>
 </div>

 <small class="text-slate-500 block mt-3">
 <i class="lucide lucide-info mr-1"></i>Share this content with your friends and followers
 </small>
</div><script>
 function copyToClipboard(text) {
 const copyBtn = document.getElementById('copyLinkBtn');
 
 if (navigator.clipboard && navigator.clipboard.writeText) {
 navigator.clipboard.writeText(text).then(function() {
 showShareCopySuccess(copyBtn);
 }).catch(function() {
 fallbackShareCopy(text, copyBtn);
 });
 } else {
 fallbackShareCopy(text, copyBtn);
 }
 }
 
 function fallbackShareCopy(text, btn) {
 const textarea = document.createElement('textarea');
 textarea.value = text;
 textarea.style.position = 'fixed';
 textarea.style.opacity = '0';
 document.body.appendChild(textarea);
 textarea.select();
 try {
 document.execCommand('copy');
 showShareCopySuccess(btn);
 } catch (err) {
 alert('Failed to copy link. Please try again.');
 }
 document.body.removeChild(textarea);
 }
 
 function showShareCopySuccess(btn) {
 if (!btn) return;
 const originalText = btn.innerHTML;
 btn.innerHTML = '<i class="lucide lucide-check-circle mr-2"></i>Copied!';
 btn.classList.add('bg-emerald-600', 'text-white', 'hover-bg-emerald-700');
 btn.classList.remove('inline-flex', 'items-center', 'justify-center', 'gap-2', 'rounded-lg', 'px-4', 'py-2', 'text-sm', 'font-semibold', 'text-slate-600 hover:bg-slate-100');
 
 setTimeout(function() {
 btn.innerHTML = originalText;
 btn.classList.remove('bg-emerald-600', 'text-white', 'hover-bg-emerald-700');
 btn.classList.add('inline-flex', 'items-center', 'justify-center', 'gap-2', 'rounded-lg', 'px-4', 'py-2', 'text-sm', 'font-semibold', 'text-slate-600 hover:bg-slate-100');
 }, 2000);
 }


<script>
document.addEventListener("click", function(e) {
  var t = e.target.closest("[data-action]");
  if (!t) return;
  var a = t.getAttribute("data-action");
  if (a === "open-share") {
    var url = t.href;
    if (url) window.open(url, t.getAttribute("data-share") + "-share", "width=600,height=400");
    e.preventDefault();
  }
  if (a === "copy-to-clipboard") {
    copyToClipboard(t.getAttribute("data-url"));
  }
});
</script>
</script>





