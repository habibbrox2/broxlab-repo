{% set icon_map = {
 'home':'house',
 'user':'user',
 'users':'users',
 'tag':'tag',
 'tags':'tags',
 'folder':'folder',
 'folder-open':'folder-open',
 'file':'file',
 'file-lines':'file-text',
 'edit':'pencil',
 'list':'list',
 'star':'star',
 'info':'info',
 'check':'check-circle',
 'exclamation':'alert-circle',
 'question':'help-circle',
 'lock':'lock',
 'unlock':'lock-open',
 'bell':'bell',
 'cog':'settings',
 'envelope':'mail',
 'comment':'message-square',
 'calendar':'calendar',
 'chart':'bar-chart-3',
 'eye':'eye',
 'fire':'flame',
 'link':'link',
 'pen':'pencil',
 'mobile':'smartphone',
 'newspaper':'newspaper',
 'briefcase':'briefcase',
 'rocket':'rocket',
 'trending-up':'trending-up',
 'phone':'smartphone',
 'megaphone':'megaphone',
 'award':'award',
 'pencil-square':'pencil'
} %}

{% if breadcrumbs is defined and breadcrumbs|length > 0 %}
<nav aria-label="Breadcrumb" class="brox-breadcrumb-nav py-3">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <ol class="flex flex-wrap items-center gap-1.5 rounded-[1.5rem] border border-slate-200/80 bg-white/85 px-4 py-3 text-sm text-slate-500 shadow-[0_12px_40px_rgba(15,23,42,0.06)] backdrop-blur-xl mb-0" itemscope itemtype="https://schema.org/BreadcrumbList">

 {# Home #}
 <li itemprop="itemListElement"
 itemscope
 itemtype="https://schema.org/ListItem">
 <a href="/" itemprop="item" class="inline-flex items-center gap-1 text-indigo-600 hover:text-indigo-800 transition-colors">
 <i class="lucide lucide-house"></i>
 <span itemprop="name">Home</span>
 </a>
 <span class="mx-1 text-slate-300" aria-hidden="true">/</span>
 <meta itemprop="position" content="1">
 </li>

 {# Dynamic crumbs #}
 {% for crumb in breadcrumbs %}
 {% set position = loop.index + 1 %}

 {% if not loop.last %}
 <li itemprop="itemListElement"
 itemscope
 itemtype="https://schema.org/ListItem"
 class="flex items-center">

 <a href="{{ crumb.url }}" itemprop="item" class="inline-flex items-center gap-1 text-indigo-600 hover:text-indigo-800 transition-colors">
 {% if crumb.icon is defined %}
 <i class="lucide lucide-{{ icon_map[crumb.icon]|default(crumb.icon) }}"></i>
 {% endif %}
 <span itemprop="name">{{ crumb.label }}</span>
 </a>
 <span class="mx-1.5 text-slate-300" aria-hidden="true">/</span>
 <meta itemprop="position" content="{{ position }}">
 </li>
 {% else %}
 <li aria-current="page"
 itemprop="itemListElement"
 itemscope
 itemtype="https://schema.org/ListItem"
 class="flex items-center text-slate-700 font-medium">

 <span itemprop="item" class="inline-flex items-center gap-1">
 {% if crumb.icon is defined %}
 <i class="lucide lucide-{{ icon_map[crumb.icon]|default(crumb.icon) }}"></i>
 {% endif %}
 <span itemprop="name">{{ crumb.label }}</span>
 </span>
 <meta itemprop="url" content="{{ canonical_url }}">
 <meta itemprop="position" content="{{ position }}">
 </li>
 {% endif %}
 {% endfor %}
 </ol>
 </div>
</nav>
{% endif %}


