{% set item_type = item.type|default('content') %}
{% set item_title = item.title|default('Untitled') %}
{% set item_href = '' %}

{% if item_type == 'mobile' %}
  {% set item_href = '/mobiles/view/' ~ item.id %}
{% elseif item_type == 'post' %}
  {% set item_slug = item.slug|default(item.url|default(item.id)) %}
  {% set item_href = item.id ? '/posts/' ~ item.id ~ '/' ~ ('' ~ item_slug)|url_encode : '/posts/view/' ~ ('' ~ item_slug)|url_encode %}
{% elseif item_type == 'service' %}
  {% set item_slug = item.slug|default(item.url|default(item.id)) %}
  {% if item_slug is iterable %}
    {% set item_slug = item_slug|first %}
  {% endif %}
  {% set item_slug = (item_slug|default(''))|trim %}
  {% if '/' in item_slug %}
    {% set item_slug = item_slug|split('/')|last %}
  {% endif %}
  {% set item_href = '/services/view/' ~ item_slug %}
{% elseif item_type == 'category' %}
  {% set item_href = '/category/' ~ item.slug|default(item.id) %}
{% elseif item_type == 'tag' %}
  {% set item_href = '/tag/' ~ item.slug|default(item.id) %}
{% else %}
  {% set item_href = '/pages/view/' ~ item.url|default(item.slug|default(item.id)) %}
{% endif %}

{% set image_src = null %}
{% if item.images is defined and item.images|length > 0 %}
  {% set image_src = item.images|first %}
{% elseif item.image is defined and item.image %}
  {% set image_src = item.image %}
{% endif %}

{% if image_src is iterable %}
  {% if image_src.url is defined %}
    {% set image_src = image_src.url %}
  {% elseif image_src.path is defined %}
    {% set image_src = image_src.path %}
  {% else %}
    {% set image_src = image_src|first %}
  {% endif %}
{% endif %}

<div class="feed-item group/card">
  <article
    class="relative flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-[0_2px_16px_rgba(0,0,0,0.06)] ring-1 ring-black/5 transition-all duration-500 hover:-translate-y-1.5 hover:shadow-[0_20px_48px_rgba(99,102,241,0.18)] hover:ring-indigo-300/60"
    role="article"
    aria-label="Content item: {{ item_title }}"
  >

    {# ── Image Zone ──────────────────────────────────────── #}
    <div class="relative overflow-hidden bg-slate-100">

      {# Hover scrim #}
      <div class="absolute inset-0 z-10 bg-gradient-to-t from-black/60 via-black/10 to-transparent opacity-0 transition-opacity duration-500 group-hover/card:opacity-100 pointer-events-none"></div>

      {% if item.images is defined and item.images|length > 0 %}
        <div id="carousel{{ index }}" class="relative" data-brox-ride="carousel" aria-label="Image gallery for {{ item_title }}">
          {% for img in item.images %}
            <div class="w-full {% if loop.first %}block{% else %}hidden{% endif %}">
              <div class="aspect-[16/10] overflow-hidden">
                <img
                  src="{{ img|absolute_url }}"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover/card:scale-105"
                  alt="{{ item_title|striptags }} – Image {{ loop.index }}"
                  loading="lazy" decoding="async"
                >
              </div>
            </div>
          {% endfor %}

          {% if item.images|length > 1 %}
            <button
              class="absolute left-3 top-1/2 z-20 -translate-y-1/2 flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-slate-700 shadow-lg backdrop-blur-sm transition-all duration-200 hover:scale-110 hover:bg-white active:scale-95 opacity-0 group-hover/card:opacity-100"
              type="button" data-brox-target="#carousel{{ index }}" data-brox-slide="prev" aria-label="Previous image"
            >
              <i class="lucide lucide-chevron-left h-4 w-4" aria-hidden="true"></i>
            </button>
            <button
              class="absolute right-3 top-1/2 z-20 -translate-y-1/2 flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-slate-700 shadow-lg backdrop-blur-sm transition-all duration-200 hover:scale-110 hover:bg-white active:scale-95 opacity-0 group-hover/card:opacity-100"
              type="button" data-brox-target="#carousel{{ index }}" data-brox-slide="next" aria-label="Next image"
            >
              <i class="lucide lucide-chevron-right h-4 w-4" aria-hidden="true"></i>
            </button>
          {% endif %}
        </div>

      {% elseif image_src %}
        <div class="aspect-[16/10] overflow-hidden">
          <img
            src="{{ image_src|absolute_url }}"
            class="h-full w-full object-cover transition-transform duration-700 group-hover/card:scale-105"
            alt="Featured image for {{ item_title|striptags }}"
            loading="lazy" decoding="async"
          >
        </div>

      {% else %}
        <div class="flex aspect-[16/10] items-center justify-center bg-gradient-to-br from-slate-100 via-indigo-50/40 to-purple-50/40">
          <div class="text-center">
            <div class="mx-auto mb-2 flex h-14 w-14 items-center justify-center rounded-2xl bg-white/60 shadow-sm ring-1 ring-black/5">
              <i class="lucide lucide-image-off h-7 w-7 text-slate-300" aria-hidden="true"></i>
            </div>
            <p class="text-[11px] font-medium text-slate-400">No image</p>
          </div>
        </div>
      {% endif %}

      {# ── Top-left badges ── #}
      <div class="absolute left-3 top-3 z-20 flex flex-wrap gap-1.5">
        {% if item_type == 'service' and item.is_premium is defined %}
          {% if item.is_premium == 1 %}
            <span class="inline-flex items-center gap-1 rounded-full bg-gradient-to-r from-amber-400 to-orange-500 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white shadow-md">
              <i class="lucide lucide-crown w-2.5 h-2.5"></i>Premium
            </span>
          {% else %}
            <span class="inline-flex items-center gap-1 rounded-full bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-emerald-700 shadow-md ring-1 ring-emerald-200/60">
              <i class="lucide lucide-gift w-2.5 h-2.5"></i>Free
            </span>
          {% endif %}
        {% elseif item_type == 'mobile' and item.is_official is defined %}
          <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide shadow-md {{ item.is_official ? 'bg-emerald-500 text-white' : 'bg-white/90 text-slate-600 ring-1 ring-black/10' }}">
            <i class="lucide lucide-{{ item.is_official ? 'badge-check' : 'help-circle' }} w-2.5 h-2.5"></i>
            {{ item.is_official ? 'Official' : 'Unofficial' }}
          </span>
        {% endif %}
      </div>

      {# ── Top-right status badge ── #}
      {% if item_type == 'service' and item.status is defined %}
        <div class="absolute right-3 top-3 z-20">
          {% set s = item.status|lower %}
          <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white shadow-md {{ s == 'active' ? 'bg-emerald-500' : (s == 'inactive' ? 'bg-red-500' : 'bg-amber-500') }}">
            <span class="h-1.5 w-1.5 rounded-full bg-white/70 animate-pulse"></span>
            {{ item.status|capitalize }}
          </span>
        </div>
      {% endif %}

      {# ── Bottom category strip (visible on hover) ── #}
      <div class="absolute bottom-3 left-3 z-20 flex flex-wrap gap-1.5 translate-y-2 opacity-0 transition-all duration-300 group-hover/card:translate-y-0 group-hover/card:opacity-100">
        {% if item.categories is defined and item.categories|length > 0 %}
          {% set primary_category = item.categories|first %}
          <span class="inline-flex items-center gap-1 rounded-full bg-indigo-600 px-2.5 py-1 text-[10px] font-bold text-white shadow-md">
            <i class="lucide lucide-tag w-2.5 h-2.5"></i>{{ primary_category.name }}
          </span>
          {% if item.categories|length > 1 %}
            <span class="inline-flex items-center rounded-full bg-white/90 px-2 py-1 text-[10px] font-bold text-slate-700 shadow-md">
              +{{ item.categories|length - 1 }}
            </span>
          {% endif %}
        {% else %}
          <span class="inline-flex items-center gap-1 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-bold text-slate-700 shadow-md">
            <i class="lucide lucide-folder w-2.5 h-2.5"></i>{{ item_type|capitalize }}
          </span>
        {% endif %}
      </div>
    </div>

    {# ── Body ────────────────────────────────────────────── #}
    <div class="flex flex-1 flex-col gap-3 p-4">

      {# Type label #}
      <div class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>
        <span class="text-[9px] font-black uppercase tracking-widest text-indigo-500">{{ item_type }}</span>
        {% if item.categories is defined and item.categories|length > 0 %}
          <span class="text-[9px] text-slate-300">·</span>
          <span class="text-[9px] font-semibold uppercase tracking-widest text-slate-400 truncate">{{ item.categories|first.name }}</span>
        {% endif %}
      </div>

      {# Title #}
      <h3 class="line-clamp-2 text-sm font-extrabold leading-snug tracking-tight text-slate-900 transition-colors duration-200 group-hover/card:text-indigo-700">
        <a href="{{ item_href }}" class="no-underline text-inherit after:absolute after:inset-0 after:z-10">{{ item_title }}</a>
      </h3>

      {# Excerpt #}
      {% if item_type == 'mobile' and item.subtitle %}
        <p class="text-[11px] leading-relaxed text-slate-500 line-clamp-2">{{ item.subtitle }}</p>
      {% elseif item_type == 'service' %}
        {% set service_excerpt = item.rich_excerpt_html|default(item.description|default(item.subtitle|default(''))) %}
        {% if service_excerpt %}
          <p class="text-[11px] leading-relaxed text-slate-500 line-clamp-2 [&_*]:!text-[11px]">{{ service_excerpt|striptags|slice(0,120) }}…</p>
        {% endif %}
      {% elseif item.subtitle and item_type != 'mobile' %}
        <p class="text-[11px] leading-relaxed text-slate-500 line-clamp-2">{{ item.subtitle|striptags|trim }}</p>
      {% elseif item.description %}
        <p class="text-[11px] leading-relaxed text-slate-500 line-clamp-2">{{ item.description|striptags|trim }}</p>
      {% endif %}

      {% if item_type == 'mobile' and item.release_date %}
        <p class="text-[10px] font-semibold text-slate-400">
          <i class="lucide lucide-calendar-days w-3 h-3 inline -mt-0.5"></i>
          Released {{ item.release_date|date('M d, Y') }}
        </p>
      {% endif %}

      {# Tags / Categories pills #}
      {% if item.tags is defined and item.tags|length > 0 %}
        <div class="flex flex-wrap gap-1">
          {% for tag in item.tags|slice(0, 3) %}
            <span class="inline-flex items-center gap-0.5 rounded-md bg-indigo-50 px-2 py-0.5 text-[10px] font-semibold text-indigo-600 ring-1 ring-indigo-200/60">
              <i class="lucide lucide-hash w-2.5 h-2.5"></i>{{ tag.name }}
            </span>
          {% endfor %}
        </div>
      {% elseif item.categories is defined and item.categories|length > 0 %}
        <div class="flex flex-wrap gap-1">
          {% for category in item.categories|slice(0, 3) %}
            <span class="inline-flex items-center gap-0.5 rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-600 ring-1 ring-slate-200/60">
              <i class="lucide lucide-folder w-2.5 h-2.5"></i>{{ category.name }}
            </span>
          {% endfor %}
        </div>
      {% endif %}

      {# CTA button #}
      <div class="mt-auto pt-1">
        <a
          href="{{ item_href }}"
          class="relative z-20 inline-flex w-full items-center justify-center gap-1.5 overflow-hidden rounded-xl bg-slate-900 px-4 py-2.5 text-[11px] font-bold uppercase tracking-wider text-white shadow-sm transition-all duration-300 hover:bg-indigo-600 hover:shadow-md hover:shadow-indigo-500/30 active:scale-[0.97]"
        >
          {% if item_type == 'mobile' %}Specs
          {% elseif item_type == 'post' %}Read Article
          {% elseif item_type == 'service' %}View Details
          {% elseif item_type in ['category','tag'] %}Browse
          {% else %}Explore
          {% endif %}
          <i class="lucide lucide-arrow-right h-3.5 w-3.5 transition-transform duration-200 group-hover/card:translate-x-0.5" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    {# ── Footer ──────────────────────────────────────────── #}
    <div class="flex items-center justify-between border-t border-slate-100 bg-slate-50/60 px-4 py-2.5">
      <span class="flex items-center gap-1.5 text-[10px] font-medium text-slate-400">
        <i class="lucide lucide-clock-3 w-3 h-3 flex-shrink-0"></i>
        {% if item.published_at is defined and item.published_at %}
          <time datetime="{{ item.published_at|date('Y-m-d') }}">{{ item.published_at|time_ago }}</time>
        {% elseif item.created_at is defined and item.created_at %}
          <time datetime="{{ item.created_at|date('Y-m-d') }}">{{ item.created_at|time_ago }}</time>
        {% else %}
          <span>Recently added</span>
        {% endif %}
      </span>

      {% if item_type == 'mobile' and (item.official_price or item.unofficial_price) %}
        <span class="inline-flex items-center gap-1 rounded-lg bg-emerald-500 px-2.5 py-1 text-[10px] font-bold text-white shadow-sm">
          <i class="lucide lucide-coins w-2.5 h-2.5"></i>
          {{ item.official_price ? (item.official_price|number_format(0,'.',',')) : (item.unofficial_price|number_format(0,'.',',')) }}
        </span>
      {% elseif item_type == 'service' and item.price %}
        <span class="inline-flex items-center gap-1 rounded-lg bg-emerald-500 px-2.5 py-1 text-[10px] font-bold text-white shadow-sm">
          <i class="lucide lucide-tag w-2.5 h-2.5"></i>{{ item.price }}
        </span>
      {% endif %}
    </div>

  </article>
</div>
