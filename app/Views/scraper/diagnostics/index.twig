{% extends 'admin/layout.twig' %}

{% block title %}Scraper Diagnostics{% endblock %}

{% block head %}
<style>
    .diagnostic-card {
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        background-color: #f8f9fa;
    }
    .diagnostic-card h5 {
        border-bottom: 1px solid #dee2e6;
        padding-bottom: 0.5rem;
        margin-bottom: 1rem;
        color: #495057;
    }
    .test-result {
        background-color: white;
        border: 1px solid #e9ecef;
        border-radius: 0.25rem;
        padding: 1rem;
        margin-top: 1rem;
        font-family: 'Courier New', monospace;
        white-space: pre-wrap;
        max-height: 400px;
        overflow-y: auto;
    }
    .success { color: #28a745; }
    .error { color: #dc3545; }
    .warning { color: #ffc107; }
    .btn-test {
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
    }
    .form-group {
        margin-bottom: 1rem;
    }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">
                    <i class="bi bi-tools me-2"></i>Scraper Diagnostics
                </h1>
                <a href="/admin/scraper" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Scraper
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- CSS Selector Tester -->
            <div class="diagnostic-card">
                <h5><i class="bi bi-megaphone me-2"></i>CSS Selector Tester</h5>
                <div class="form-group">
                    <label for="selector-test-url" class="form-label">URL to Test</label>
                    <input type="url" class="form-control" id="selector-test-url" placeholder="https://example.com">
                </div>
                <div class="form-group">
                    <label for="selector-test-selectors" class="form-label">CSS Selectors (JSON)</label>
                    <textarea class="form-control" id="selector-test-selectors" rows="6" placeholder='{"title": "h1", "content": ".article-body", "image": "img"}'>
{
  "title": "h1.story-details-headline",
  "content": ".story-element.story-element--text",
  "image": ".story-element.story-element--image img",
  "date": ".story-publish-time",
  "author": ".story-byline",
  "category": ".story-section",
  "tags": ".story-tags a"
}
</textarea>
                </div>
                <button class="btn btn-primary btn-test" id="run-selector-test">
                    <i class="bi bi-play me-1"></i>Run Selector Test
                </button>
                <div id="selector-test-result" class="test-result"></div>
            </div>

            <!-- Service Tester -->
            <div class="diagnostic-card">
                <h5><i class="bi bi-speedometer2 me-2"></i>Service Tester</h5>
                <div class="form-group">
                    <label for="service-test-url" class="form-label">URL to Test</label>
                    <input type="url" class="form-control" id="service-test-url" placeholder="https://example.com">
                </div>
                <div class="form-group">
                    <label class="form-check-label">
                        <input type="checkbox" class="form-check-input" id="test-all-services">
                        Test All Services (PhpScraper, Panther, Roach, PHP Spider)
                    </label>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <button class="btn btn-success btn-test w-100" id="test-php-scraper">
                            <i class="bi bi-megaphone me-1"></i>PhpScraper
                        </button>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-info btn-test w-100" id="test-panther">
                            <i class="bi bi-browser-chrome me-1"></i>Panther
                        </button>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-warning btn-test w-100" id="test-roach">
                            <i class="bi bi-arrow-repeat me-1"></i>Roach
                        </button>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-danger btn-test w-100" id="test-php-spider">
                            <i class="bi bi-spider me-1"></i>PHP Spider
                        </button>
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary btn-test w-100" id="run-all-service-tests">
                        <i class="bi bi-play-circle me-1"></i>Run All Service Tests
                    </button>
                </div>
                <div id="service-test-result" class="test-result"></div>
            </div>

            <!-- System Diagnostics -->
            <div class="diagnostic-card">
                <h5><i class="bi bi-pc-display me-2"></i>System Diagnostics</h5>
                <button class="btn btn-outline-primary btn-test" id="run-system-diagnostics">
                    <i class="bi bi-stats me-1"></i>Run System Diagnostics
                </button>
                <div id="system-diagnostics-result" class="test-result"></div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Information Panel -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Diagnostic Information</h5>
                </div>
                <div class="card-body">
                    <h6>Available Tools:</h6>
                    <ul class="small mb-3">
                        <li><strong>CSS Selector Tester:</strong> Test CSS selectors against live websites</li>
                        <li><strong>Service Tester:</strong> Test individual scraping services</li>
                        <li><strong>System Diagnostics:</strong> Check overall scraper system health</li>
                    </ul>

                    <h6>How to Use:</h6>
                    <ol class="small">
                        <li>Enter a URL to test against</li>
                        <li>Configure selectors or select services to test</li>
                        <li>Click the appropriate test button</li>
                        <li>Review results in the output panels</li>
                    </ol>

                    <h6>Common Test URLs:</h6>
                    <ul class="small mb-0">
                        <li><code>https://www.prothomalo.com/</code></li>
                        <li><code>https://www.bdnews24.com/</code></li>
                        <li><code>https://www.gsmarena.com.bd/</code></li>
                        <li><code>https://httpbin.org/html</code> (test)</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // CSS Selector Tester
    document.getElementById('run-selector-test').addEventListener('click', function() {
        const url = document.getElementById('selector-test-url').value.trim();
        const selectorsText = document.getElementById('selector-test-selectors').value.trim();
        
        if (!url) {
            alert('Please enter a URL to test');
            return;
        }
        
        if (!selectorsText) {
            alert('Please enter CSS selectors to test');
            return;
        }
        
        let selectors;
        try {
            selectors = JSON.parse(selectorsText);
        } catch (e) {
            alert('Invalid JSON in selectors field');
            return;
        }
        
        // Show loading state
        const resultDiv = document.getElementById('selector-test-result');
        resultDiv.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Running test...';
        
        // Send AJAX request
        fetch('/api/v1/scraper/diagnostics/css-selector', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ url: url, selectors: selectors })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                resultDiv.innerHTML = '<pre class="success">' + data.result + '</pre>';
            } else {
                resultDiv.innerHTML = '<pre class="error">Error: ' + data.error + '</pre>';
            }
        })
        .catch(error => {
            resultDiv.innerHTML = '<pre class="error">Request failed: ' + error.message + '</pre>';
        });
    });

    // Service Tester - Individual services
    const serviceTests = [
        { btnId: 'test-php-scraper', service: 'php_scraper' },
        { btnId: 'test-panther', service: 'panther' },
        { btnId: 'test-roach', service: 'roach' },
        { btnId: 'test-php-spider', service: 'php_spider' }
    ];

    serviceTests.forEach(test => {
        document.getElementById(test.btnId).addEventListener('click', function() {
            const url = document.getElementById('service-test-url').value.trim();
            
            if (!url) {
                alert('Please enter a URL to test');
                return;
            }
            
            // Show loading state
            const resultDiv = document.getElementById('service-test-result');
            resultDiv.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Running ' + test.service + ' test...';
            
            // Send AJAX request
            fetch('/api/v1/scraper/diagnostics/service', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ url: url, service: test.service })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    resultDiv.innerHTML = '<pre class="success">' + data.result + '</pre>';
                } else {
                    resultDiv.innerHTML = '<pre class="error">Error: ' + data.error + '</pre>';
                }
            })
            .catch(error => {
                resultDiv.innerHTML = '<pre class="error">Request failed: ' + error.message + '</pre>';
            });
        });
    });

    // Service Tester - All services
    document.getElementById('run-all-service-tests').addEventListener('click', function() {
        const url = document.getElementById('service-test-url').value.trim();
        
        if (!url) {
            alert('Please enter a URL to test');
            return;
        }
        
        // Show loading state
        const resultDiv = document.getElementById('service-test-result');
        resultDiv.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Running all service tests...';
        
        // Send AJAX request
        fetch('/api/v1/scraper/diagnostics/services', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ url: url })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                resultDiv.innerHTML = '<pre class="success">' + data.result + '</pre>';
            } else {
                resultDiv.innerHTML = '<pre class="error">Error: ' + data.error + '</pre>';
            }
        })
        .catch(error => {
            resultDiv.innerHTML = '<pre class="error">Request failed: ' + error.message + '</pre>';
        });
    });

    // System Diagnostics
    document.getElementById('run-system-diagnostics').addEventListener('click', function() {
        // Show loading state
        const resultDiv = document.getElementById('system-diagnostics-result');
        resultDiv.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Running system diagnostics...';
        
        // Send AJAX request
        fetch('/api/v1/scraper/diagnostics/system', {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                resultDiv.innerHTML = '<pre class="success">' + data.result + '</pre>';
            } else {
                resultDiv.innerHTML = '<pre class="error">Error: ' + data.error + '</pre>';
            }
        })
        .catch(error => {
            resultDiv.innerHTML = '<pre class="error">Request failed: ' + error.message + '</pre>';
        });
    });
});
</script>
{% endblock %}