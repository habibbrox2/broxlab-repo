{% extends 'admin/layout.twig' %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block stylesheets %}
<style>
    .preset-result {
        display: none;
    }
    .preset-result.show {
        display: block;
    }
    .selector-group {
        margin-bottom: 1rem;
    }
    .selector-group label {
        font-weight: 500;
        color: #495057;
    }
    .confidence-bar {
        height: 8px;
        border-radius: 4px;
        background: #e9ecef;
        overflow: hidden;
    }
    .confidence-fill {
        height: 100%;
        background: #28a745;
        transition: width 0.3s ease;
    }
    .ai-prefill-result {
        display: none;
    }
    .ai-prefill-result.show {
        display: block;
    }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">
                    <i class="bi bi-magic me-2"></i>
                    AI Preset Generator
                </h1>
                <div>
                    <a href="/admin/scraper" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Dashboard
                    </a>
                </div>
            </div>
            <p class="text-muted mb-4">
                Automatically analyze any website and generate optimized scraping presets with CSS selectors.
                The AI will detect the content type and suggest the best selectors for extraction.
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Generate Preset</h5>
                </div>
                <div class="card-body">
                    <form id="presetGeneratorForm">
                        <div class="mb-3">
                            <label for="url" class="form-label">Website URL <span class="text-danger">*</span></label>
                            <input type="url" 
                                   class="form-control" 
                                   id="url" 
                                   name="url" 
                                   placeholder="https://example.com" 
                                   required
                                   pattern="https?://.+">
                            <div class="form-text">
                                Enter the full URL of the website you want to generate a preset for.
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Options</label>
                            <div class="alert alert-info py-2 px-3 mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                This page always uses the live analyzer, so results are based on real page content.
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary" id="generateBtn">
                            <i class="bi bi-magic me-1"></i>
                            Generate Preset
                        </button>
                        <button type="button" class="btn btn-outline-warning ms-2" id="aiPrefillBtn">
                            <i class="bi bi-broadcast me-1"></i>
                            AI Auto Fill
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Tips</h5>
                </div>
                <div class="card-body">
                    <ul class="mb-0 ps-3">
                        <li>Use a specific page URL (e.g., an article page for news sites)</li>
                        <li>The page should have clear content structure</li>
                        <li>Avoid login-protected pages</li>
                        <li>Results may take 10-30 seconds</li>
                        <li>Review generated selectors before saving</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading State -->
    <div class="row mt-4" id="loadingState" style="display: none;">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
                    <h5>Analyzing Website...</h5>
                    <p class="text-muted mb-0">
                        The AI is analyzing the website structure and generating selectors.
                        This may take up to 30 seconds.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Results -->
    <div class="row mt-4 preset-result" id="resultSection">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Generated Preset</h5>
                    <div>
                        <span class="badge bg-success" id="contentTypeBadge"></span>
                        <span class="badge bg-info" id="confidenceBadge"></span>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Summary -->
                    <div class="alert alert-success mb-4" id="successAlert" style="display: none;">
                        <i class="bi bi-check-circle me-2"></i>
                        <strong>Success!</strong> Preset generated with <span id="confidenceText"></span> confidence.
                    </div>

                    <!-- Error -->
                    <div class="alert alert-danger mb-4" id="errorAlert" style="display: none;">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        <strong>Error:</strong> <span id="errorText"></span>
                    </div>

                    <!-- Preset Form -->
                    <form id="presetForm" method="POST" action="/admin/scraper/sources/save" style="display: none;">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="id" id="presetId">
                        <input type="hidden" name="url" id="presetUrl">
                        <input type="hidden" name="website_preset_key" id="presetKey">
                        <input type="hidden" name="type" id="presetSourceType" value="scrape">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Preset Name</label>
                                <input type="text" class="form-control" name="name" id="presetName" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Content Type</label>
                                <select class="form-select" name="content_type" id="presetContentType">
                                    <option value="articles">Articles</option>
                                    <option value="pages">Pages</option>
                                    <option value="mobiles">Mobiles</option>
                                    <option value="services">Services</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Generated Selectors</label>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 150px;">Field</th>
                                            <th>Selector</th>
                                            <th style="width: 100px;">Confidence</th>
                                        </tr>
                                    </thead>
                                    <tbody id="selectorsTable">
                                        <!-- Dynamically populated -->
                                    </tbody>
                                </table>
                            </div>
                            <div class="form-text">
                                These selectors were generated by AI. You can edit them before saving.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Advanced Configuration (JSON)</label>
                            <textarea class="form-control font-monospace" name="advance_config" id="advanceConfig" rows="4" placeholder='{"timeout": 30, "retry_attempts": 3}'></textarea>
                            <div class="form-text">
                                Optional: Advanced configuration in JSON format.
                            </div>
                        </div>

                        <div class="mb-3 form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="is_active" id="isActive" checked>
                            <label class="form-check-label" for="isActive">
                                Active (enable automatic scraping)
                            </label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save me-1"></i>
                                Save as Source
                            </button>
                            <button type="button" class="btn btn-outline-secondary" onclick="copyToClipboard()">
                                <i class="bi bi-clipboard me-1"></i>
                                Copy JSON
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- AI Auto Fill Results -->
<div class="row mt-4 ai-prefill-result" id="aiPrefillSection">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">AI Auto Fill</h5>
                <div class="d-flex gap-2">
                    <span class="badge bg-success" id="aiSourceTypeBadge"></span>
                    <span class="badge bg-info" id="aiConfidenceBadge"></span>
                </div>
            </div>
            <div class="card-body">
                <div class="alert alert-info mb-4" id="aiPrefillStatus">
                    <i class="bi bi-info-circle me-2"></i>
                    Run AI auto fill to detect real selectors and configuration from the live page.
                </div>

                <div id="aiPrefillSummary" class="row g-3 mb-4"></div>
                <div id="aiPrefillNotes" class="mb-4"></div>

                <div class="row g-3 mb-4">
                    <div class="col-lg-6">
                        <div class="border rounded p-3 h-100">
                            <h6 class="mb-3">Selectors</h6>
                            <div id="aiPrefillSelectors" class="d-grid gap-2"></div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="border rounded p-3 h-100">
                            <h6 class="mb-3">Configuration</h6>
                            <div id="aiPrefillConfig" class="d-grid gap-2"></div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mb-4">
                    <button type="button" class="btn btn-success" id="applyAiPrefillBtn">
                        <i class="bi bi-arrow-down-circle me-1"></i>
                        Apply Suggestions
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="clearAiPrefillBtn">
                        <i class="bi bi-x-circle me-1"></i>
                        Clear
                    </button>
                </div>

                <div>
                    <h6 class="mb-3">Raw AI Response</h6>
                    <pre id="aiPrefillRaw" class="bg-light border rounded p-3 small mb-0" style="max-height: 320px; overflow: auto;"></pre>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JSON Export Modal -->
<div class="modal fade" id="jsonModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Preset JSON</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <pre id="jsonContent" class="bg-light p-3 rounded" style="max-height: 400px; overflow-y: auto;"></pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="copyJson()">Copy</button>
            </div>
        </div>
    </div>
</div>

<script>
let generatedPreset = null;
let generatedAiPrefill = null;

const aiPrefillSection = document.getElementById('aiPrefillSection');
const aiPrefillBtn = document.getElementById('aiPrefillBtn');
const applyAiPrefillBtn = document.getElementById('applyAiPrefillBtn');
const clearAiPrefillBtn = document.getElementById('clearAiPrefillBtn');
const aiPrefillStatus = document.getElementById('aiPrefillStatus');
const aiSourceTypeBadge = document.getElementById('aiSourceTypeBadge');
const aiConfidenceBadge = document.getElementById('aiConfidenceBadge');
const aiPrefillSummary = document.getElementById('aiPrefillSummary');
const aiPrefillNotes = document.getElementById('aiPrefillNotes');
const aiPrefillSelectors = document.getElementById('aiPrefillSelectors');
const aiPrefillConfig = document.getElementById('aiPrefillConfig');
const aiPrefillRaw = document.getElementById('aiPrefillRaw');
const generateBtn = document.getElementById('generateBtn');
const presetGeneratorForm = document.getElementById('presetGeneratorForm');

async function runLiveAnalyzer() {
    const url = document.getElementById('url').value.trim();

    if (!url) {
        alert('Please enter a URL');
        return;
    }

    document.getElementById('loadingState').style.display = 'block';
    document.getElementById('resultSection').classList.remove('show');
    aiPrefillSection.classList.add('show');
    aiPrefillStatus.className = 'alert alert-info mb-4';
    aiPrefillStatus.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Analyzing live page for real selectors and config...';

    return new Promise(async (resolve) => {
        const originalGenerateHtml = generateBtn ? generateBtn.innerHTML : '';
        const originalAiHtml = aiPrefillBtn ? aiPrefillBtn.innerHTML : '';
        if (generateBtn) {
            generateBtn.disabled = true;
            generateBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Analyzing...';
        }
        if (aiPrefillBtn) {
            aiPrefillBtn.disabled = true;
            aiPrefillBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Analyzing...';
        }

        try {
            const response = await fetch('/admin/scraper/ai/source-prefill', {
                method: 'POST',
                headers: {
                    'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
                },
                body: new FormData(presetGeneratorForm)
            });

            const data = await response.json();
            document.getElementById('loadingState').style.display = 'none';

            if (data.success) {
                generatedAiPrefill = data;
                generatedPreset = data;
                renderAiPrefillResult(data);
                applyAiPrefill(data);
                aiPrefillStatus.className = 'alert alert-success mb-4';
                aiPrefillStatus.innerHTML = '<i class="bi bi-check-circle me-2"></i>Real live analysis applied to the form.';
                resolve(data);
            } else {
                generatedAiPrefill = data;
                generatedPreset = data;
                renderAiPrefillResult(data);
                aiPrefillStatus.className = 'alert alert-warning mb-4';
                aiPrefillStatus.innerHTML = `<i class="bi bi-exclamation-triangle me-2"></i>${escapeHtml(data.error || 'AI analysis returned no usable suggestions')}`;
                resolve(data);
            }
        } catch (err) {
            document.getElementById('loadingState').style.display = 'none';
            aiPrefillStatus.className = 'alert alert-danger mb-4';
            aiPrefillStatus.innerHTML = `<i class="bi bi-exclamation-triangle me-2"></i>${escapeHtml(err.message || 'AI analysis failed')}`;
            resolve(null);
        } finally {
            if (generateBtn) {
                generateBtn.disabled = false;
                generateBtn.innerHTML = originalGenerateHtml;
            }
            if (aiPrefillBtn) {
                aiPrefillBtn.disabled = false;
                aiPrefillBtn.innerHTML = originalAiHtml;
            }
        }
    });
}

if (presetGeneratorForm) {
    presetGeneratorForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        await runLiveAnalyzer();
    });
}

if (aiPrefillBtn) {
    aiPrefillBtn.addEventListener('click', async function() {
        await runLiveAnalyzer();
    });
}

function displayPresetResult(preset) {
    document.getElementById('resultSection').classList.add('show');
    document.getElementById('presetForm').style.display = 'block';
    document.getElementById('successAlert').style.display = 'block';
    document.getElementById('errorAlert').style.display = 'none';

    // Set summary info
    document.getElementById('contentTypeBadge').textContent = preset.content_type?.label() || preset.content_type || 'Unknown';
    const confidence = Math.round((preset.confidence || 0) * 100);
    document.getElementById('confidenceBadge').textContent = confidence + '% Confidence';
    document.getElementById('confidenceText').textContent = confidence + '%';

    // Fill form fields
    const siteName = new URL(preset.url).hostname.replace('www.', '');
    document.getElementById('presetName').value = siteName + ' Scraper';
    document.getElementById('presetUrl').value = preset.url;
    document.getElementById('presetKey').value = preset.name || siteName;
    document.getElementById('presetContentType').value = preset.content_type?.value || 'articles';
    document.getElementById('advanceConfig').value = JSON.stringify(preset.config || {}, null, 2);

    // Populate selectors table
    const tbody = document.getElementById('selectorsTable');
    tbody.innerHTML = '';

    const selectors = preset.selectors || {};
    const fields = [
        { key: 'title', label: 'Title' },
        { key: 'content', label: 'Content' },
        { key: 'excerpt', label: 'Excerpt' },
        { key: 'date', label: 'Date' },
        { key: 'author', label: 'Author' },
        { key: 'image', label: 'Image' },
        { key: 'category', label: 'Category' },
        { key: 'tags', label: 'Tags' }
    ];

    fields.forEach(field => {
        if (selectors[field.key] && selectors[field.key].length > 0) {
            const selector = selectors[field.key][0]; // Take first selector
            const confidence = preset.confidence ? Math.round(preset.confidence * 100) : 50;
            
            const row = document.createElement('tr');
            row.innerHTML = `
                <td><strong>${field.label}</strong></td>
                <td>
                    <code class="d-block" style="font-size: 0.9em;">${selector}</code>
                </td>
                <td>
                    <div class="confidence-bar">
                        <div class="confidence-fill" style="width: ${confidence}%"></div>
                    </div>
                    <small>${confidence}%</small>
                </td>
            `;
            tbody.appendChild(row);
        }
    });

    if (tbody.children.length === 0) {
        tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No selectors generated</td></tr>';
    }
}

function buildMiniStat(label, value, tone = 'primary') {
    return `
        <div class="col-md-3">
            <div class="border rounded p-3 h-100">
                <div class="text-uppercase small text-muted fw-semibold">${escapeHtml(label)}</div>
                <div class="h5 mb-0 text-${tone}">${escapeHtml(value)}</div>
            </div>
        </div>
    `;
}

function renderAiPrefillResult(result = {}) {
    if (!aiPrefillSection) {
        return;
    }

    aiPrefillSection.classList.add('show');

    const sourceType = result.source_type || 'unknown';
    const confidence = Math.round((result.confidence || 0) * 100);
    if (aiSourceTypeBadge) {
        aiSourceTypeBadge.textContent = sourceType.toUpperCase();
    }
    if (aiConfidenceBadge) {
        aiConfidenceBadge.textContent = confidence + '% Confidence';
    }
    if (aiPrefillSummary) {
        aiPrefillSummary.innerHTML = [
            buildMiniStat('Result', result.success ? 'Ready' : 'Failed', result.success ? 'success' : 'danger'),
            buildMiniStat('Source Type', sourceType, 'primary'),
            buildMiniStat('Content Type', result.content_type || 'articles', 'info'),
            buildMiniStat('Browser', result.use_browser ? 'Enabled' : 'Disabled', result.use_browser ? 'warning' : 'success')
        ].join('');
    }

    const notes = [];
    if (Array.isArray(result.suggestions)) {
        result.suggestions.forEach(item => notes.push({ type: 'info', text: item }));
    }
    if (Array.isArray(result.warnings)) {
        result.warnings.forEach(item => notes.push({ type: 'warning', text: item }));
    }
    if (aiPrefillNotes) {
        if (notes.length) {
            aiPrefillNotes.innerHTML = `
                <div class="border rounded p-3 bg-light">
                    <div class="small text-uppercase fw-semibold text-muted mb-2">AI Notes</div>
                    <div class="d-grid gap-2">
                        ${notes.map(note => `
                            <div class="border rounded p-2 bg-white">
                                <span class="badge text-bg-${note.type === 'warning' ? 'warning' : 'info'} me-2">${escapeHtml(note.type)}</span>
                                <span class="small">${escapeHtml(note.text || '')}</span>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        } else {
            aiPrefillNotes.innerHTML = '<div class="text-muted small">No additional AI notes were returned.</div>';
        }
    }
}

function renderAiPrefillSelectors(result = {}) {
    const selectors = result.selectors || {};
    const candidates = result.selector_candidates || {};
    const entries = Object.entries(selectors);

    if (!aiPrefillSelectors) {
        return;
    }

    if (!entries.length) {
        aiPrefillSelectors.innerHTML = '<div class="text-muted small">No reliable selectors were detected.</div>';
        return;
    }

    aiPrefillSelectors.innerHTML = entries.map(([key, selector]) => {
        const candidateList = Array.isArray(candidates[key]) ? candidates[key] : [];
        const top = candidateList[0] || {};
        const confidence = Math.round((top.confidence || 0) * 100);
        const sample = top.sample_text ? `<div class="small text-muted mt-2">${escapeHtml(top.sample_text)}</div>` : '';
        return `
            <div class="border rounded p-3 bg-white">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                    <div class="fw-semibold">${escapeHtml(key)}</div>
                    <span class="badge text-bg-success">${confidence}%</span>
                </div>
                <code class="d-block small">${escapeHtml(selector)}</code>
                ${sample}
            </div>
        `;
    }).join('');
}

function renderAiPrefillConfig(result = {}) {
    const advanceConfig = result.advance_config || {};
    const pagination = result.pagination || {};
    const items = [];

    if (advanceConfig && Object.keys(advanceConfig).length) {
        items.push({ label: 'Advance Config', value: JSON.stringify(advanceConfig, null, 2) });
    }
    if (pagination && (pagination.type || pagination.selector || pagination.pattern)) {
        items.push({ label: 'Pagination', value: JSON.stringify(pagination, null, 2) });
    }
    if (result.source_type) {
        items.push({ label: 'Source Type', value: result.source_type });
    }
    if (result.content_type) {
        items.push({ label: 'Content Type', value: result.content_type });
    }

    if (!aiPrefillConfig) {
        return;
    }

    if (!items.length) {
        aiPrefillConfig.innerHTML = '<div class="text-muted small">No config suggestions were returned.</div>';
        return;
    }

    aiPrefillConfig.innerHTML = items.map(item => `
        <div class="border rounded p-3 bg-white">
            <div class="small text-uppercase fw-semibold text-muted mb-2">${escapeHtml(item.label)}</div>
            <pre class="small mb-0" style="white-space: pre-wrap;">${escapeHtml(item.value)}</pre>
        </div>
    `).join('');
}

function applyAiPrefill(result = {}) {
    const sourceType = String(result.source_type || '').trim();
    const contentType = String(result.content_type || '').trim();
    const selectors = result.selectors || {};
    const advanceConfig = result.advance_config || {};
    const pagination = result.pagination || {};
    const presetUrl = document.getElementById('presetUrl');
    const presetName = document.getElementById('presetName');
    const presetKey = document.getElementById('presetKey');
    const form = document.getElementById('presetForm');

    if (!form) return;

    const typeField = document.getElementById('presetSourceType');
    if (typeField && sourceType) {
        typeField.value = sourceType;
    }
    if (document.getElementById('presetContentType') && contentType) {
        document.getElementById('presetContentType').value = contentType;
    }
    if (presetUrl && result.url) {
        presetUrl.value = result.url;
    }
    try {
        if (result.url) {
            const host = new URL(result.url).hostname.replace(/^www\./, '');
            if (presetName) {
                presetName.value = host + ' Scraper';
            }
            if (presetKey) {
                presetKey.value = host;
            }
        }
    } catch (error) {
        // Ignore invalid URL formatting in the analyzer response.
    }

    if (sourceType === 'api') {
        document.getElementById('selectorsTable').innerHTML = '<tr><td colspan="3" class="text-center text-muted">API source detected. Selectors are intentionally left empty.</td></tr>';
        document.getElementById('advanceConfig').value = JSON.stringify(advanceConfig || {}, null, 2);
    } else {
        if (selectors && Object.keys(selectors).length) {
            const tbody = document.getElementById('selectorsTable');
            const rows = Object.entries(selectors).map(([key, selector]) => {
                const top = (result.selector_candidates && result.selector_candidates[key] && result.selector_candidates[key][0]) || {};
                const confidence = Math.round((top.confidence || 0) * 100);
                return `
                    <tr>
                        <td><strong>${escapeHtml(key)}</strong></td>
                        <td><code class="d-block" style="font-size: 0.9em;">${escapeHtml(selector)}</code></td>
                        <td>
                            <div class="confidence-bar">
                                <div class="confidence-fill" style="width: ${confidence}%"></div>
                            </div>
                            <small>${confidence}%</small>
                        </td>
                    </tr>
                `;
            }).join('');
            tbody.innerHTML = rows || '<tr><td colspan="3" class="text-center text-muted">No selectors generated</td></tr>';
        }
        if (advanceConfig && Object.keys(advanceConfig).length) {
            document.getElementById('advanceConfig').value = JSON.stringify(advanceConfig, null, 2);
        }
        if (pagination && pagination.type && pagination.type !== 'none') {
            const paginationHint = `Detected pagination: ${pagination.type}${pagination.selector ? ' (' + pagination.selector + ')' : ''}`;
            const notes = document.createElement('div');
            notes.className = 'alert alert-info mt-3 mb-0';
            notes.innerHTML = `<i class="bi bi-info-circle me-2"></i>${escapeHtml(paginationHint)}`;
            const existing = document.getElementById('aiPaginationNote');
            if (existing) existing.remove();
            notes.id = 'aiPaginationNote';
            form.appendChild(notes);
        }
    }
}

function showAiPrefillError(message) {
    aiPrefillSection.classList.add('show');
    if (aiPrefillStatus) {
        aiPrefillStatus.className = 'alert alert-danger mb-4';
        aiPrefillStatus.innerHTML = `<i class="bi bi-exclamation-triangle me-2"></i>${escapeHtml(message || 'AI analysis failed')}`;
    }
}

if (applyAiPrefillBtn) {
    applyAiPrefillBtn.addEventListener('click', function() {
        if (!generatedAiPrefill) {
            return;
        }
        applyAiPrefill(generatedAiPrefill);
        if (aiPrefillStatus) {
            aiPrefillStatus.className = 'alert alert-success mb-4';
            aiPrefillStatus.innerHTML = '<i class="bi bi-check-circle me-2"></i>AI suggestions applied to the form.';
        }
    });
}

if (clearAiPrefillBtn) {
    clearAiPrefillBtn.addEventListener('click', function() {
        generatedAiPrefill = null;
        if (aiPrefillSection) aiPrefillSection.classList.remove('show');
        if (aiPrefillSummary) aiPrefillSummary.innerHTML = '';
        if (aiPrefillNotes) aiPrefillNotes.innerHTML = '';
        if (aiPrefillSelectors) aiPrefillSelectors.innerHTML = '';
        if (aiPrefillConfig) aiPrefillConfig.innerHTML = '';
        if (aiPrefillRaw) aiPrefillRaw.textContent = '';
        if (aiPrefillStatus) {
            aiPrefillStatus.className = 'alert alert-info mb-4';
            aiPrefillStatus.innerHTML = '<i class="bi bi-info-circle me-2"></i>Run AI auto fill to detect real selectors and configuration from the live page.';
        }
    });
}

function showError(message) {
    document.getElementById('resultSection').classList.add('show');
    document.getElementById('presetForm').style.display = 'none';
    document.getElementById('successAlert').style.display = 'none';
    document.getElementById('errorAlert').style.display = 'block';
    document.getElementById('errorText').textContent = message;
}

function copyToClipboard() {
    if (!generatedPreset) return;
    
    const json = JSON.stringify(generatedPreset, null, 2);
    navigator.clipboard.writeText(json).then(() => {
        alert('Preset JSON copied to clipboard!');
    }).catch(err => {
        console.error('Failed to copy:', err);
        alert('Failed to copy to clipboard');
    });
}

function copyJson() {
    const jsonContent = document.getElementById('jsonContent').textContent;
    navigator.clipboard.writeText(jsonContent).then(() => {
        alert('JSON copied to clipboard!');
    }).catch(err => {
        console.error('Failed to copy:', err);
    });
}
</script>
{% endblock %}
