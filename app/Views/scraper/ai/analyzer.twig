{% extends 'admin/layout.twig' %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block stylesheets %}
<style>
    .selector-card {
        transition: transform 0.2s;
    }
    .selector-card:hover {
        transform: translateY(-2px);
    }
    .confidence-high { color: #28a745; }
    .confidence-medium { color: #ffc107; }
    .confidence-low { color: #dc3545; }
    .sample-preview {
        max-height: 200px;
        overflow-y: auto;
        font-size: 0.85em;
    }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">
                    <i class="bi bi-search me-2"></i>
                    AI Scraper Analyzer
                </h1>
                <div>
                    <a href="/admin/scraper" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Dashboard
                    </a>
                </div>
            </div>
            <p class="text-muted mb-4">
                Analyze any website's HTML structure and get AI-powered CSS selector suggestions.
                Paste HTML content or provide a URL to analyze.
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Analyze Website</h5>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs mb-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="url-tab" data-bs-toggle="tab" data-bs-target="#url-tab-pane" type="button" role="tab">
                                <i class="bi bi-link me-1"></i>By URL
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="html-tab" data-bs-toggle="tab" data-bs-target="#html-tab-pane" type="button" role="tab">
                                <i class="bi bi-code me-1"></i>By HTML
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content" id="myTabContent">
                        <!-- URL Tab -->
                        <div class="tab-pane fade show active" id="url-tab-pane" role="tabpanel">
                            <form id="analyzerUrlForm">
                                <div class="mb-3">
                                    <label for="analyzeUrl" class="form-label">Website URL <span class="text-danger">*</span></label>
                                    <input type="url" 
                                           class="form-control" 
                                           id="analyzeUrl" 
                                           name="url" 
                                           placeholder="https://example.com/article" 
                                           required
                                           pattern="https?://.+">
                                    <div class="form-text">
                                        Enter a specific page URL (e.g., an article, product page, etc.)
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary" id="analyzeUrlBtn">
                                    <i class="bi bi-search me-1"></i>
                                    Analyze URL
                                </button>
                            </form>
                        </div>

                        <!-- HTML Tab -->
                        <div class="tab-pane fade" id="html-tab-pane" role="tabpanel">
                            <form id="analyzerHtmlForm">
                                <div class="mb-3">
                                    <label for="analyzeHtml" class="form-label">HTML Content <span class="text-danger">*</span></label>
                                    <textarea class="form-control font-monospace" 
                                              id="analyzeHtml" 
                                              name="html" 
                                              rows="10" 
                                              placeholder="Paste HTML content here..." 
                                              required></textarea>
                                    <div class="form-text">
                                        Paste the HTML source of the page you want to analyze.
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary" id="analyzeHtmlBtn">
                                    <i class="bi bi-search me-1"></i>
                                    Analyze HTML
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">How it works</h5>
                </div>
                <div class="card-body">
                    <ol class="mb-0 ps-3">
                        <li>Provide a URL or paste HTML content</li>
                        <li>AI analyzes the page structure</li>
                        <li>Get suggested CSS selectors for:
                            <ul>
                                <li>Article/Content container</li>
                                <li>Title</li>
                                <li>Content body</li>
                                <li>Date, Author, Image, etc.</li>
                            </ul>
                        </li>
                        <li>Copy selectors to your scraper source</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading State -->
    <div class="row" id="loadingState" style="display: none;">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
                    <h5>Analyzing...</h5>
                    <p class="text-muted mb-0">
                        The AI is analyzing the page structure. This may take a few seconds.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Results -->
    <div class="row mt-4" id="resultSection" style="display: none;">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Analysis Results</h5>
                    <div>
                        <span class="badge bg-success" id="siteTypeBadge"></span>
                        <span class="badge bg-info" id="confidenceBadge"></span>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Success Alert -->
                    <div class="alert alert-success mb-4" id="successAlert" style="display: none;">
                        <i class="bi bi-check-circle me-2"></i>
                        <strong>Analysis Complete!</strong>
                    </div>

                    <!-- Error Alert -->
                    <div class="alert alert-danger mb-4" id="errorAlert" style="display: none;">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        <strong>Error:</strong> <span id="errorText"></span>
                    </div>

                    <!-- Results Container -->
                    <div id="analysisResults" style="display: none;">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="card-title">Site Type</h6>
                                        <p class="card-text h4 mb-0" id="siteTypeText"></p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="card-title">Confidence</h6>
                                        <p class="card-text h4 mb-0" id="confidenceText"></p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h6 class="mb-3">Recommended Selectors</h6>
                        <div class="row" id="selectorsGrid">
                            <!-- Dynamically populated -->
                        </div>

                        <div class="mt-4">
                            <button class="btn btn-primary" onclick="copyAllSelectors()">
                                <i class="bi bi-clipboard me-1"></i>
                                Copy All Selectors
                            </button>
                            <button class="btn btn-outline-secondary ms-2" onclick="exportJSON()">
                                <i class="bi bi-download me-1"></i>
                                Export JSON
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JSON Export Modal -->
<div class="modal fade" id="jsonModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Analysis Results (JSON)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <pre id="jsonContent" class="bg-light p-3 rounded" style="max-height: 400px; overflow-y: auto; font-size: 0.85em;"></pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="copyJson()">Copy</button>
            </div>
        </div>
    </div>
</div>

<script>
let analysisResult = null;

// URL Form
document.getElementById('analyzerUrlForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const url = document.getElementById('analyzeUrl').value.trim();
    if (!url) return;
    
    await runAnalysis({ url: url });
});

// HTML Form
document.getElementById('analyzerHtmlForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const html = document.getElementById('analyzeHtml').value.trim();
    if (!html) return;
    
    await runAnalysis({ html: html });
});

async function runAnalysis(data) {
    // Show loading
    document.getElementById('loadingState').style.display = 'block';
    document.getElementById('resultSection').style.display = 'none';
    document.getElementById('analyzeUrlBtn').disabled = true;
    document.getElementById('analyzeHtmlBtn').disabled = true;

    try {
        const response = await fetch('/admin/scraper/ai/analyzer/run', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify(data)
        });

        const result = await response.json();
        
        // Hide loading
        document.getElementById('loadingState').style.display = 'none';
        
        if (result.success) {
            analysisResult = result;
            displayAnalysisResult(result);
        } else {
            showError(result.error || 'Analysis failed');
        }
    } catch (err) {
        document.getElementById('loadingState').style.display = 'none';
        showError('Network error: ' + err.message);
    } finally {
        document.getElementById('analyzeUrlBtn').disabled = false;
        document.getElementById('analyzeHtmlBtn').disabled = false;
    }
}

function displayAnalysisResult(result) {
    document.getElementById('resultSection').style.display = 'block';
    document.getElementById('successAlert').style.display = 'block';
    document.getElementById('errorAlert').style.display = 'none';
    document.getElementById('analysisResults').style.display = 'block';

    // Site type
    const siteType = result.site_type || 'generic';
    document.getElementById('siteTypeBadge').textContent = siteType;
    document.getElementById('siteTypeText').textContent = siteType;

    // Confidence
    const confidence = Math.round((result.confidence || 0) * 100);
    document.getElementById('confidenceBadge').textContent = confidence + '%';
    document.getElementById('confidenceText').innerHTML = `
        <div class="progress" style="height: 20px;">
            <div class="progress-bar ${confidence >= 70 ? 'bg-success' : confidence >= 40 ? 'bg-warning' : 'bg-danger'}" 
                 role="progressbar" 
                 style="width: ${confidence}%">
                ${confidence}%
            </div>
        </div>
    `;

    // Selectors
    const selectorsGrid = document.getElementById('selectorsGrid');
    selectorsGrid.innerHTML = '';

    const recommended = result.recommended_selectors || result.recommendedSelectors || {};
    const selectorTypes = [
        { key: 'article', label: 'Article Container', icon: 'bi-file-earmark-text' },
        { key: 'title', label: 'Title', icon: 'bi-type-h1' },
        { key: 'content', label: 'Content', icon: 'bi-textarea' },
        { key: 'excerpt', label: 'Excerpt', icon: 'bi-text' },
        { key: 'date', label: 'Date', icon: 'bi-calendar' },
        { key: 'author', label: 'Author', icon: 'bi-person' },
        { key: 'image', label: 'Image', icon: 'bi-image' },
        { key: 'category', label: 'Category', icon: 'bi-tag' },
        { key: 'tags', label: 'Tags', icon: 'bi-tags' }
    ];

    selectorTypes.forEach(type => {
        if (recommended[type.key] && recommended[type.key].length > 0) {
            const selector = recommended[type.key][0]; // Best selector
            const score = selector.score || 0.5;
            const scorePercent = Math.round(score * 100);
            
            const col = document.createElement('div');
            col.className = 'col-md-6 mb-3';
            col.innerHTML = `
                <div class="card selector-card h-100">
                    <div class="card-body">
                        <h6 class="card-title">
                            <i class="bi ${type.icon} me-1"></i> ${type.label}
                        </h6>
                        <code class="d-block mb-2 p-2 bg-light rounded" style="font-size: 0.9em;">${selector.selector}</code>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">Confidence: <span class="${score >= 0.7 ? 'confidence-high' : score >= 0.4 ? 'confidence-medium' : 'confidence-low'}">${scorePercent}%</span></small>
                            <button class="btn btn-sm btn-outline-primary" onclick="copyToClipboard('${selector.selector.replace(/'/g, "\\'")}')">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                        ${selector.sample_text ? '<small class="text-muted d-block mt-2 sample-preview">Sample: ' + escapeHtml(selector.sample_text.substring(0, 100)) + '...</small>' : ''}
                    </div>
                </div>
            `;
            selectorsGrid.appendChild(col);
        }
    });

    if (selectorsGrid.children.length === 0) {
        selectorsGrid.innerHTML = '<div class="col-12"><div class="alert alert-warning">No selectors were generated. Try with a different page.</div></div>';
    }
}

function showError(message) {
    document.getElementById('resultSection').style.display = 'block';
    document.getElementById('successAlert').style.display = 'none';
    document.getElementById('errorAlert').style.display = 'block';
    document.getElementById('errorText').textContent = message;
    document.getElementById('analysisResults').style.display = 'none';
}

function copyAllSelectors() {
    if (!analysisResult) return;
    
    const selectors = analysisResult.recommended_selectors || analysisResult.recommendedSelectors || {};
    const json = JSON.stringify(selectors, null, 2);
    
    navigator.clipboard.writeText(json).then(() => {
        alert('All selectors copied to clipboard!');
    }).catch(err => {
        console.error('Failed to copy:', err);
        alert('Failed to copy to clipboard');
    });
}

function exportJSON() {
    if (!analysisResult) return;
    
    const json = JSON.stringify(analysisResult, null, 2);
    document.getElementById('jsonContent').textContent = json;
    
    const modal = new bootstrap.Modal(document.getElementById('jsonModal'));
    modal.show();
}

function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(() => {
        alert('Copied to clipboard!');
    }).catch(err => {
        console.error('Failed to copy:', err);
    });
}

function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}
</script>
{% endblock %}
