{% extends 'admin/layout.twig' %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block head %}
<style>
    .collection-card {
        transition: transform 0.2s ease-in-out;
    }
    .collection-card:hover {
        transform: translateY(-2px);
    }
    .progress-ring {
        transform: rotate(-90deg);
    }
    .progress-ring circle {
        stroke-dasharray: 283;
        stroke-dashoffset: 283;
        transition: stroke-dashoffset 0.5s ease;
    }
    .progress-ring.success circle {
        stroke: #28a745;
    }
    .progress-ring.warning circle {
        stroke: #ffc107;
    }
    .progress-ring.danger circle {
        stroke: #dc3545;
    }
    .source-item {
        opacity: 0;
        animation: fadeInUp 0.5s ease forwards;
    }
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-1">
                        <i class="bi bi-collection me-2"></i>{{ pageTitle }}
                    </h1>
                    <p class="text-muted mb-0">Manually collect data from scraping sources</p>
                </div>
                <div>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#startCollectionModal">
                        <i class="bi bi-play-circle me-1"></i>Start Collection
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4" id="statsCards">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3">
                                <i class="bi bi-diagram-3 fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="card-title mb-1">Total Sources</h6>
                            <h4 class="mb-0" id="totalSources">-</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-success bg-opacity-10 text-success rounded-circle p-3">
                                <i class="bi bi-check-circle fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="card-title mb-1">Active Sources</h6>
                            <h4 class="mb-0" id="activeSources">-</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-info bg-opacity-10 text-info rounded-circle p-3">
                                <i class="bi bi-collection fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="card-title mb-1">Today's Collections</h6>
                            <h4 class="mb-0" id="todayCollections">-</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                                <i class="bi bi-database fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="card-title mb-1">Items Collected Today</h6>
                            <h4 class="mb-0" id="todayItems">-</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Collection Options -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Quick Collection Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <button type="button" class="btn btn-outline-primary w-100 collection-card" onclick="startQuickCollection('all')">
                                <i class="bi bi-play-circle-fill fs-4 mb-2"></i>
                                <div>
                                    <strong>Collect All</strong>
                                    <br><small class="text-muted">Run all active sources</small>
                                </div>
                            </button>
                        </div>
                        <div class="col-md-3">
                            <button type="button" class="btn btn-outline-success w-100 collection-card" onclick="startQuickCollection('category')">
                                <i class="bi bi-folder-fill fs-4 mb-2"></i>
                                <div>
                                    <strong>By Category</strong>
                                    <br><small class="text-muted">Select sources by category</small>
                                </div>
                            </button>
                        </div>
                        <div class="col-md-3">
                            <button type="button" class="btn btn-outline-info w-100 collection-card" onclick="startQuickCollection('sources')">
                                <i class="bi bi-list-check fs-4 mb-2"></i>
                                <div>
                                    <strong>Select Sources</strong>
                                    <br><small class="text-muted">Choose specific sources</small>
                                </div>
                            </button>
                        </div>
                        <div class="col-md-3">
                            <button type="button" class="btn btn-outline-secondary w-100 collection-card" onclick="showRecentCollections()">
                                <i class="bi bi-clock-history fs-4 mb-2"></i>
                                <div>
                                    <strong>Recent Jobs</strong>
                                    <br><small class="text-muted">View collection history</small>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Collection Progress (hidden by default) -->
    <div class="row mb-4" id="collectionProgress" style="display: none;">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Collection Progress</h5>
                    <button type="button" class="btn-close" onclick="hideCollectionProgress()"></button>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <div class="progress-ring me-3" style="width: 60px; height: 60px;">
                                    <svg width="60" height="60">
                                        <circle cx="30" cy="30" r="25" stroke="#e9ecef" stroke-width="4" fill="none"/>
                                        <circle cx="30" cy="30" r="25" stroke-width="4" fill="none" id="progressCircle"/>
                                    </svg>
                                </div>
                                <div>
                                    <h6 class="mb-0" id="progressText">Initializing...</h6>
                                    <small class="text-muted" id="progressSubtext">Preparing sources</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 text-end">
                            <div class="row">
                                <div class="col-4">
                                    <h4 class="mb-0 text-primary" id="sourcesProcessed">0</h4>
                                    <small class="text-muted">Processed</small>
                                </div>
                                <div class="col-4">
                                    <h4 class="mb-0 text-success" id="itemsCollected">0</h4>
                                    <small class="text-muted">Items</small>
                                </div>
                                <div class="col-4">
                                    <h4 class="mb-0 text-warning" id="timeElapsed">0s</h4>
                                    <small class="text-muted">Time</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="progress mb-3" id="collectionProgressBar">
                        <div class="progress-bar" role="progressbar" style="width: 0%"></div>
                    </div>

                    <div id="collectionResults" class="mt-3" style="display: none;">
                        <h6>Results:</h6>
                        <div id="resultsList" class="list-group"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Collections -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Recent Collections</h5>
                </div>
                <div class="card-body">
                    <div id="recentCollections">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2 text-muted">Loading recent collections...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Start Collection Modal -->
<div class="modal fade" id="startCollectionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Start Data Collection</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="collectionForm">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

                    <div class="mb-3">
                        <label class="form-label">Collection Type</label>
                        <select class="form-select" name="type" id="collectionType" required>
                            <option value="sources">Specific Sources</option>
                            <option value="category">By Category</option>
                            <option value="all">All Active Sources</option>
                        </select>
                    </div>

                    <div class="mb-3" id="sourcesSelection" style="display: none;">
                        <label class="form-label">Select Sources</label>
                        <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                            {% for source in sources %}
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="source_ids[]" value="{{ source.id }}" id="source{{ source.id }}">
                                <label class="form-check-label" for="source{{ source.id }}">
                                    <strong>{{ source.name }}</strong>
                                    <br><small class="text-muted">{{ source.url|truncate(50) }}</small>
                                </label>
                            </div>
                            {% endfor %}
                        </div>
                        <div class="mt-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAllSources()">Select All</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearAllSources()">Clear All</button>
                        </div>
                    </div>

                    <div class="mb-3" id="categorySelection" style="display: none;">
                        <label class="form-label">Select Category</label>
                        <select class="form-select" name="category_id" id="categorySelect">
                            <option value="">Choose a category...</option>
                            {% for category in categories %}
                            <option value="{{ category.id }}">{{ category.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitCollection()">Start Collection</button>
            </div>
        </div>
    </div>
</div>

<script>
// Global variables
let collectionInterval;
let startTime;

// CSRF token helper
const getCsrfToken = () => {
    const hiddenInput = document.querySelector('#collectionForm input[name="csrf_token"]');
    if (hiddenInput && hiddenInput.value) {
        return hiddenInput.value;
    }
    return document.querySelector('meta[name="csrf-token"]')?.content || '';
};

document.addEventListener('DOMContentLoaded', function() {
    loadCollectionStatus();
    setupCollectionTypeHandlers();
});

function loadCollectionStatus() {
    fetch('/api/v1/scraper/collect/status')
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                document.getElementById('totalSources').textContent = data.data.stats.total_sources;
                document.getElementById('activeSources').textContent = data.data.stats.active_sources;
                document.getElementById('todayCollections').textContent = data.data.stats.total_collections_today;
                document.getElementById('todayItems').textContent = data.data.stats.total_items_today;

                updateRecentCollections(data.data.recent_activity);
            }
        })
        .catch(error => {
            console.error('Error loading collection status:', error);
        });
}

function updateRecentCollections(collections) {
    const container = document.getElementById('recentCollections');

    if (!collections || collections.length === 0) {
        container.innerHTML = '<p class="text-muted mb-0">No recent collections found.</p>';
        return;
    }

    let html = '<div class="list-group">';
    collections.forEach(collection => {
        const statusBadge = getStatusBadge(collection.status);
        const createdAt = new Date(collection.created_at).toLocaleString();

        html += `
            <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="mb-1">${collection.type} Collection</h6>
                        <p class="mb-1 text-muted small">${createdAt}</p>
                        <p class="mb-0 small">Items: ${collection.total_items || 0}</p>
                    </div>
                    <span class="badge ${statusBadge.class}">${statusBadge.text}</span>
                </div>
            </div>
        `;
    });
    html += '</div>';

    container.innerHTML = html;
}

function getStatusBadge(status) {
    switch (status) {
        case 'completed':
            return { class: 'bg-success', text: 'Completed' };
        case 'running':
            return { class: 'bg-primary', text: 'Running' };
        case 'failed':
            return { class: 'bg-danger', text: 'Failed' };
        case 'queued':
            return { class: 'bg-warning', text: 'Queued' };
        default:
            return { class: 'bg-secondary', text: status };
    }
}

function setupCollectionTypeHandlers() {
    document.getElementById('collectionType').addEventListener('change', function() {
        const type = this.value;
        document.getElementById('sourcesSelection').style.display = type === 'sources' ? 'block' : 'none';
        document.getElementById('categorySelection').style.display = type === 'category' ? 'block' : 'none';
    });
}

function selectAllSources() {
    document.querySelectorAll('#sourcesSelection input[type="checkbox"]').forEach(cb => cb.checked = true);
}

function clearAllSources() {
    document.querySelectorAll('#sourcesSelection input[type="checkbox"]').forEach(cb => cb.checked = false);
}

function startQuickCollection(type) {
    if (type === 'all') {
        startCollection('all', []);
    } else if (type === 'category') {
        // Show category selection modal
        const modal = new bootstrap.Modal(document.getElementById('startCollectionModal'));
        document.getElementById('collectionType').value = 'category';
        document.getElementById('collectionType').dispatchEvent(new Event('change'));
        modal.show();
    } else if (type === 'sources') {
        const modal = new bootstrap.Modal(document.getElementById('startCollectionModal'));
        document.getElementById('collectionType').value = 'sources';
        document.getElementById('collectionType').dispatchEvent(new Event('change'));
        modal.show();
    }
}

function submitCollection() {
    const form = document.getElementById('collectionForm');
    const formData = new FormData(form);
    const type = formData.get('type');

    let targetIds = [];
    if (type === 'sources') {
        formData.getAll('source_ids[]').forEach(id => targetIds.push(parseInt(id)));
    } else if (type === 'category') {
        const categoryId = formData.get('category_id');
        if (categoryId) {
            targetIds = [parseInt(categoryId)];
        }
    }

    if (type !== 'all' && targetIds.length === 0) {
        alert('Please select sources or a category.');
        return;
    }

    // Hide modal
    const modal = bootstrap.Modal.getInstance(document.getElementById('startCollectionModal'));
    modal.hide();

    startCollection(type, targetIds);
}

function startCollection(type, targetIds) {
    // Show progress
    document.getElementById('collectionProgress').style.display = 'block';
    startTime = Date.now();

    // Initialize progress
    updateProgress(0, 'Initializing collection...', 'Preparing sources');

    const requestData = {
        type: type,
        target_ids: targetIds,
        options: {},
        csrf_token: getCsrfToken()
    };

    fetch('/api/v1/scraper/collect/start', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
        },
        body: JSON.stringify(requestData)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showCollectionResults(data.data);
        } else {
            updateProgress(100, 'Collection Failed', data.error);
            document.getElementById('progressCircle').className = 'progress-ring danger';
        }
    })
    .catch(error => {
        console.error('Collection error:', error);
        updateProgress(100, 'Collection Failed', 'Network error occurred');
        document.getElementById('progressCircle').className = 'progress-ring danger';
    });

    // Update time elapsed
    collectionInterval = setInterval(() => {
        const elapsed = Math.floor((Date.now() - startTime) / 1000);
        document.getElementById('timeElapsed').textContent = elapsed + 's';
    }, 1000);
}

function updateProgress(percentage, text, subtext) {
    document.getElementById('progressText').textContent = text;
    document.getElementById('progressSubtext').textContent = subtext;

    const circle = document.getElementById('progressCircle');
    const offset = 283 - (283 * percentage / 100);
    circle.style.strokeDashoffset = offset;

    document.querySelector('#collectionProgressBar .progress-bar').style.width = percentage + '%';

    if (percentage === 100) {
        clearInterval(collectionInterval);
    }
}

function showCollectionResults(data) {
    updateProgress(100, 'Collection Completed!', `Collected ${data.total_items} items`);

    document.getElementById('sourcesProcessed').textContent = data.sources.length;
    document.getElementById('itemsCollected').textContent = data.total_items;

    document.getElementById('progressCircle').className = 'progress-ring success';

    // Show results
    const resultsList = document.getElementById('resultsList');
    resultsList.innerHTML = '';

    data.results.forEach((result, index) => {
        const resultItem = document.createElement('div');
        resultItem.className = `list-group-item source-item ${result.success ? 'list-group-item-success' : 'list-group-item-danger'}`;
        resultItem.style.animationDelay = `${index * 0.1}s`;

        resultItem.innerHTML = `
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="mb-1">${result.source_name}</h6>
                    <p class="mb-1 small text-muted">${result.execution_time}s execution time</p>
                    ${result.error ? `<p class="mb-0 small text-danger">${result.error}</p>` : ''}
                </div>
                <div class="text-end">
                    <span class="badge ${result.success ? 'bg-success' : 'bg-danger'}">${result.success ? 'Success' : 'Failed'}</span>
                    <br><small class="text-muted">${result.items_collected} items</small>
                </div>
            </div>
        `;

        resultsList.appendChild(resultItem);
    });

    document.getElementById('collectionResults').style.display = 'block';

    // Reload stats
    setTimeout(() => {
        loadCollectionStatus();
    }, 2000);
}

function hideCollectionProgress() {
    document.getElementById('collectionProgress').style.display = 'none';
    clearInterval(collectionInterval);
}

function showRecentCollections() {
    // Scroll to recent collections section
    document.getElementById('recentCollections').scrollIntoView({ behavior: 'smooth' });
}
</script>

{% endblock %}
