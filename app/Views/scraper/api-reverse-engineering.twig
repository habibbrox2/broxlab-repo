{% extends 'admin/layout.twig' %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block stylesheets %}
<style>
    .api-card {
        transition: transform 0.2s;
    }
    .api-card:hover {
        transform: translateY(-2px);
    }
    .method-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
    }
    .method-get { background: #28a745; color: white; }
    .method-post { background: #0d6efd; color: white; }
    .method-put { background: #ffc107; color: black; }
    .method-patch { background: #6f42c1; color: white; }
    .method-delete { background: #dc3545; color: white; }
    .method-options { background: #6c757d; color: white; }
    .method-head { background: #20c997; color: black; }
    .status-2xx { color: #28a745; }
    .status-3xx { color: #ffc107; }
    .status-4xx { color: #dc3545; }
    .status-5xx { color: #dc3545; }
    .json-preview {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 1rem;
        font-family: 'Courier New', monospace;
        font-size: 0.85rem;
        max-height: 300px;
        overflow-y: auto;
    }
    .schema-view {
        font-size: 0.85rem;
    }
    .endpoint-item {
        border-left: 3px solid transparent;
        transition: all 0.2s;
    }
    .endpoint-item:hover {
        border-left-color: #0d6efd;
        background: #f8f9fa;
    }
    .param-badge {
        font-size: 0.7rem;
    }
    .loading-spinner {
        display: inline-block;
        width: 1rem;
        height: 1rem;
        border: 2px solid #f3f3f3;
        border-top: 2px solid #0d6efd;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }
    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">
                    <i class="bi bi-diagram-3 me-2"></i>
                    API Reverse Engineering
                </h1>
                <div>
                    <a href="/admin/scraper" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Dashboard
                    </a>
                </div>
            </div>
            <p class="text-muted mb-4">
                Analyze REST APIs to discover endpoints, test HTTP methods, and extract response schemas.
                Perfect for understanding undocumented APIs or reverse engineering third-party services.
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-globe me-2"></i>API Endpoint Analysis
                    </h5>
                </div>
                <div class="card-body">
                    <form id="analyzeEndpointForm">
                        <div class="mb-3">
                            <label for="apiUrl" class="form-label">API Endpoint URL <span class="text-danger">*</span></label>
                            <input type="url" 
                                   class="form-control" 
                                   id="apiUrl" 
                                   name="url" 
                                   placeholder="https://api.example.com/v1/users" 
                                   required>
                            <div class="form-text">
                                Enter the full API endpoint URL including path and query parameters.
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="customHeaders" class="form-label">Custom Headers (JSON)</label>
                            <textarea class="form-control font-monospace" 
                                      id="customHeaders" 
                                      rows="3" 
                                      placeholder='{"Authorization": "Bearer token", "Accept": "application/json"}'></textarea>
                            <div class="form-text">
                                Optional: Add custom headers as JSON (e.g., Authorization, API keys)
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="requestTimeout" class="form-label">Timeout (seconds)</label>
                                <input type="number" 
                                       class="form-control" 
                                       id="requestTimeout" 
                                       value="30" 
                                       min="5" 
                                       max="120">
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" id="analyzeBtn">
                                <i class="bi bi-search me-1"></i> Analyze Endpoint
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="clearResults">
                                <i class="bi bi-x-lg me-1"></i> Clear
                            </button>
                        </div>
                    </form>

                    <div id="analysisResults" class="mt-4" style="display: none;">
                        <hr>
                        <h6 class="mb-3">
                            <i class="bi bi-clipboard-data me-2"></i>Analysis Results
                        </h6>
                        <div id="analysisContent"></div>
                    </div>

                    <div id="analysisError" class="alert alert-danger mt-4" style="display: none;"></div>
                    
                    <div id="analysisLoading" class="text-center py-4" style="display: none;">
                        <div class="loading-spinner"></div>
                        <p class="mt-2 text-muted">Analyzing endpoint...</p>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-hdd-network me-2"></i>Discover Endpoints
                    </h5>
                </div>
                <div class="card-body">
                    <form id="discoverEndpointsForm">
                        <div class="mb-3">
                            <label for="baseApiUrl" class="form-label">Base API URL <span class="text-danger">*</span></label>
                            <input type="url" 
                                   class="form-control" 
                                   id="baseApiUrl" 
                                   name="base_url" 
                                   placeholder="https://api.example.com" 
                                   required>
                            <div class="form-text">
                                Enter the base URL of the API to discover available endpoints.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="discoveryHeaders" class="form-label">Custom Headers (JSON)</label>
                            <textarea class="form-control font-monospace" 
                                      id="discoveryHeaders" 
                                      rows="3" 
                                      placeholder='{"Authorization": "Bearer token"}'></textarea>
                        </div>

                        <button type="submit" class="btn btn-info" id="discoverBtn">
                            <i class="bi bi-radioactive me-1"></i> Discover Endpoints
                        </button>
                    </form>

                    <div id="discoveryResults" class="mt-4" style="display: none;">
                        <hr>
                        <h6 class="mb-3">
                            <i class="bi bi-list-ul me-2"></i>Discovered Endpoints
                            <span class="badge bg-secondary" id="endpointCount">0</span>
                        </h6>
                        <div id="discoveredEndpointsList"></div>
                    </div>

                    <div id="discoveryError" class="alert alert-danger mt-4" style="display: none;"></div>
                    
                    <div id="discoveryLoading" class="text-center py-4" style="display: none;">
                        <div class="loading-spinner"></div>
                        <p class="mt-2 text-muted">Discovering endpoints... (this may take a while)</p>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-signpost-2 me-2"></i>Test HTTP Methods
                    </h5>
                </div>
                <div class="card-body">
                    <form id="testMethodsForm">
                        <div class="mb-3">
                            <label for="testMethodsUrl" class="form-label">Endpoint URL <span class="text-danger">*</span></label>
                            <input type="url" 
                                   class="form-control" 
                                   id="testMethodsUrl" 
                                   name="url" 
                                   placeholder="https://api.example.com/users/1" 
                                   required>
                            <div class="form-text">
                                Test which HTTP methods are supported by this endpoint.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="methodTestHeaders" class="form-label">Custom Headers (JSON)</label>
                            <textarea class="form-control font-monospace" 
                                      id="methodTestHeaders" 
                                      rows="3" 
                                      placeholder='{"Authorization": "Bearer token"}'></textarea>
                        </div>

                        <button type="submit" class="btn btn-warning" id="testMethodsBtn">
                            <i class="bi bi-braces me-1"></i> Test Methods
                        </button>
                    </form>

                    <div id="methodsResults" class="mt-4" style="display: none;">
                        <hr>
                        <h6 class="mb-3">
                            <i class="bi bi-gear me-2"></i>Supported Methods
                        </h6>
                        <div id="methodsResultsContent"></div>
                    </div>

                    <div id="methodsError" class="alert alert-danger mt-4" style="display: none;"></div>
                    
                    <div id="methodsLoading" class="text-center py-4" style="display: none;">
                        <div class="loading-spinner"></div>
                        <p class="mt-2 text-muted">Testing HTTP methods...</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-question-circle me-2"></i>How It Works
                    </h5>
                </div>
                <div class="card-body">
                    <h6>1. Endpoint Analysis</h6>
                    <p class="small text-muted">
                        Enter an API URL to analyze response headers, content type, and extract JSON schema from the response.
                    </p>
                    
                    <h6>2. Discover Endpoints</h6>
                    <p class="small text-muted">
                        Provide a base API URL to automatically discover available endpoints by testing common patterns.
                    </p>
                    
                    <h6>3. Test Methods</h6>
                    <p class="small text-muted">
                        Test which HTTP methods (GET, POST, PUT, DELETE, etc.) are supported by a specific endpoint.
                    </p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-lightbulb me-2"></i>Tips
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled small">
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-1"></i>
                            Include auth headers for protected APIs
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-1"></i>
                            Use the full URL with query parameters
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-1"></i>
                            Check OpenAPI/Swagger docs automatically
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-1"></i>
                            Schema is extracted from JSON responses
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

    // Helper to show/hide elements
    function showLoading(id) {
        document.getElementById(id + 'Loading').style.display = 'block';
        document.getElementById(id + 'Results')?.style.display = 'none';
        document.getElementById(id + 'Error').style.display = 'none';
    }

    function hideLoading(id) {
        document.getElementById(id + 'Loading').style.display = 'none';
    }

    function showError(id, message) {
        hideLoading(id);
        const errorEl = document.getElementById(id + 'Error');
        errorEl.textContent = message;
        errorEl.style.display = 'block';
    }

    function showResults(id, html) {
        hideLoading(id);
        document.getElementById(id + 'Error').style.display = 'none';
        const resultsEl = document.getElementById(id + 'Results');
        const contentEl = document.getElementById(id + 'Content') || document.getElementById('discoveredEndpointsList') || document.getElementById('methodsResultsContent');
        
        if (contentEl) {
            contentEl.innerHTML = html;
        }
        resultsEl.style.display = 'block';
    }

    // Parse headers from JSON textarea
    function parseHeaders(textareaId) {
        const value = document.getElementById(textareaId)?.value?.trim();
        if (!value) return {};
        try {
            return JSON.parse(value);
        } catch (e) {
            return {};
        }
    }

    // Format JSON for display
    function formatJson(str) {
        try {
            const obj = JSON.parse(str);
            return JSON.stringify(obj, null, 2);
        } catch (e) {
            return str;
        }
    }

    // Get method badge class
    function getMethodBadgeClass(method) {
        return 'method-' + method.toLowerCase();
    }

    // Get status class
    function getStatusClass(status) {
        if (status >= 200 && status < 300) return 'status-2xx';
        if (status >= 300 && status < 400) return 'status-3xx';
        if (status >= 400 && status < 500) return 'status-4xx';
        return 'status-5xx';
    }

    // ================== ANALYZE ENDPOINT ==================
    document.getElementById('analyzeEndpointForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const url = document.getElementById('apiUrl').value;
        const headers = parseHeaders('customHeaders');
        const timeout = parseInt(document.getElementById('requestTimeout').value) || 30;

        if (!url) {
            showError('analysis', 'Please enter a URL');
            return;
        }

        showLoading('analysis');

        try {
            const response = await fetch('/api/v1/scraper/api-reverse-engineering/analyze-endpoint', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken
                },
                body: JSON.stringify({ url, headers, timeout })
            });

            const data = await response.json();

            if (data.success && data.analysis) {
                const a = data.analysis;
                let html = `
                    <div class="api-card card">
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong>URL:</strong> <code>${a.url}</code>
                                </div>
                                <div class="col-md-6">
                                    <strong>Method:</strong> <span class="method-badge ${getMethodBadgeClass(a.method)}">${a.method}</span>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong>Status Code:</strong> <span class="${getStatusClass(a.status_code)}">${a.status_code}</span>
                                </div>
                                <div class="col-md-6">
                                    <strong>Content Type:</strong> ${a.content_type}
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong>Response Size:</strong> ${a.response_size} bytes
                                </div>
                                <div class="col-md-6">
                                    <strong>Is API:</strong> ${a.is_api_endpoint ? '<span class="text-success">Yes</span>' : '<span class="text-muted">No</span>'}
                                </div>
                            </div>
                `;

                // Parameters
                if (a.parameters && Object.keys(a.parameters).length > 0) {
                    html += `<h6 class="mt-3">Parameters</h6><ul class="list-group mb-3">`;
                    for (const [type, params] of Object.entries(a.parameters)) {
                        if (Array.isArray(params) && params.length > 0) {
                            html += `<li class="list-group-item"><strong>${type}:</strong> `;
                            params.forEach(p => {
                                html += `<span class="badge bg-secondary param-badge me-1">${p.name} (${p.type})</span>`;
                            });
                            html += `</li>`;
                        }
                    }
                    html += `</ul>`;
                }

                // Schema
                if (a.schema) {
                    html += `
                        <h6 class="mt-3">Response Schema</h6>
                        <pre class="json-preview">${formatJson(JSON.stringify(a.schema))}</pre>
                    `;
                }

                html += `</div></div>`;
                showResults('analysis', html);
            } else {
                showError('analysis', data.error || 'Analysis failed');
            }
        } catch (err) {
            showError('analysis', 'Network error: ' + err.message);
        }
    });

    // ================== DISCOVER ENDPOINTS ==================
    document.getElementById('discoverEndpointsForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const baseUrl = document.getElementById('baseApiUrl').value;
        const headers = parseHeaders('discoveryHeaders');

        if (!baseUrl) {
            showError('discovery', 'Please enter a base URL');
            return;
        }

        showLoading('discovery');

        try {
            const response = await fetch('/api/v1/scraper/api-reverse-engineering/discover-endpoints', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken
                },
                body: JSON.stringify({ base_url: baseUrl, headers })
            });

            const data = await response.json();

            if (data.success) {
                document.getElementById('endpointCount').textContent = data.total_discovered || 0;
                
                if (data.endpoints && data.endpoints.length > 0) {
                    let html = '<div class="list-group">';
                    data.endpoints.forEach(ep => {
                        html += `
                            <div class="list-group-item endpoint-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="method-badge ${getMethodBadgeClass(ep.method)} me-2">${ep.method}</span>
                                        <code>${ep.url}</code>
                                        ${ep.description ? `<small class="text-muted d-block">${ep.description}</small>` : ''}
                                    </div>
                                    <span class="${getStatusClass(ep.status_code)}">${ep.status_code}</span>
                                </div>
                            </div>
                        `;
                    });
                    html += '</div>';
                    showResults('discovery', html);
                } else {
                    showResults('discovery', '<p class="text-muted">No endpoints discovered. Try a different base URL.</p>');
                }
            } else {
                showError('discovery', data.error || 'Discovery failed');
            }
        } catch (err) {
            showError('discovery', 'Network error: ' + err.message);
        }
    });

    // ================== TEST METHODS ==================
    document.getElementById('testMethodsForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const url = document.getElementById('testMethodsUrl').value;
        const headers = parseHeaders('methodTestHeaders');

        if (!url) {
            showError('methods', 'Please enter a URL');
            return;
        }

        showLoading('methods');

        try {
            const response = await fetch('/api/v1/scraper/api-reverse-engineering/test-methods', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken
                },
                body: JSON.stringify({ url, headers })
            });

            const data = await response.json();

            if (data.success && data.methods) {
                let html = '<div class="row">';
                for (const [method, result] of Object.entries(data.methods)) {
                    const supported = result.supported;
                    const status = result.status_code;
                    
                    html += `
                        <div class="col-md-4 col-sm-6 mb-3">
                            <div class="card ${supported ? 'border-success' : 'border-secondary'}">
                                <div class="card-body text-center">
                                    <span class="method-badge ${getMethodBadgeClass(method)} mb-2 d-block">${method}</span>
                                    ${supported 
                                        ? `<span class="${getStatusClass(status)} fw-bold">${status}</span>`
                                        : '<span class="text-muted">Not Supported</span>'
                                    }
                                </div>
                            </div>
                        </div>
                    `;
                }
                html += '</div>';
                showResults('methods', html);
            } else {
                showError('methods', data.error || 'Method testing failed');
            }
        } catch (err) {
            showError('methods', 'Network error: ' + err.message);
        }
    });

    // Clear buttons
    document.getElementById('clearResults').addEventListener('click', function() {
        document.getElementById('analyzeEndpointForm').reset();
        document.getElementById('analysisResults').style.display = 'none';
        document.getElementById('analysisError').style.display = 'none';
    });
});
</script>
{% endblock %}