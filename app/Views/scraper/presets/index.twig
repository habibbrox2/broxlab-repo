{# templates/scraper/presets/index.twig #}
{% extends "layouts/admin.twig" %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-list"></i> Scraper Presets
                    </h3>
                    <div class="card-tools">
                        <a href="/admin/scraper/presets/create" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> Create Preset
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    {% if presets %}
                        {% for category in categories %}
                        <div class="mb-4">
                            <h4 class="text-primary">
                                <i class="fas fa-folder"></i> {{ category|title }} Presets
                            </h4>
                            <div class="row">
                                {% for preset in presets %}
                                    {% if preset.category == category %}
                                    <div class="col-md-4 mb-3">
                                        <div class="card h-100">
                                            <div class="card-header">
                                                <h5 class="card-title mb-0">
                                                    <i class="{{ preset.icon }}"></i> {{ preset.name }}
                                                </h5>
                                            </div>
                                            <div class="card-body">
                                                <p class="card-text">{{ preset.description }}</p>
                                                <div class="mb-2">
                                                    <small class="text-muted">
                                                        <strong>Type:</strong> {{ preset.content_type|title }}
                                                    </small>
                                                </div>
                                                {% if preset.example_urls %}
                                                <div class="mb-2">
                                                    <small class="text-muted">
                                                        <strong>Examples:</strong> {{ preset.example_urls|length }} URLs
                                                    </small>
                                                </div>
                                                {% endif %}
                                            </div>
                                            <div class="card-footer">
                                                <div class="btn-group btn-group-sm w-100">
                                                    <a href="/admin/scraper/presets/{{ preset.key }}" class="btn btn-info">
                                                        <i class="fas fa-eye"></i> View
                                                    </a>
                                                    <a href="/admin/scraper/presets/{{ preset.key }}/edit" class="btn btn-warning">
                                                        <i class="fas fa-edit"></i> Edit
                                                    </a>
                                                    <button class="btn btn-danger delete-preset" data-key="{{ preset.key }}" data-name="{{ preset.name }}">
                                                        <i class="fas fa-trash"></i> Delete
                                                    </button>
                                                </div>
                                                <div class="mt-2">
                                                    <form method="POST" action="/admin/scraper/presets/{{ preset.key }}/apply" class="d-inline">
                                                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                                        <input type="hidden" name="name" value="{{ preset.name }} (Applied)">
                                                        <button type="submit" class="btn btn-success btn-sm w-100">
                                                            <i class="fas fa-play"></i> Apply Preset
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                        {% endfor %}
                    {% else %}
                        <div class="text-center py-5">
                            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                            <h4>No Presets Found</h4>
                            <p class="text-muted">Get started by creating your first scraper preset.</p>
                            <a href="/admin/scraper/presets/create" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Create Your First Preset
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Delete Preset</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the preset "<strong id="deletePresetName"></strong>"?</p>
                <p class="text-danger">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Delete Preset</button>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    let deleteKey = '';
    let deleteName = '';

    // Delete Preset
    $('.delete-preset').click(function() {
        deleteKey = $(this).data('key');
        deleteName = $(this).data('name');
        $('#deletePresetName').text(deleteName);
        $('#deleteModal').modal('show');
    });

    // Confirm Delete
    $('#confirmDelete').click(function() {
        $.ajax({
            url: '/admin/scraper/presets/' + deleteKey,
            method: 'DELETE',
            data: {
                csrf_token: '{{ csrf_token }}'
            },
            success: function(response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert('Delete failed: ' + response.error);
                }
            },
            error: function() {
                alert('Delete request failed');
            }
        });
    });

    // Apply Preset
    $('form[action*="/apply"]').submit(function(e) {
        e.preventDefault();
        const form = $(this);
        const submitBtn = form.find('button[type="submit"]');

        submitBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Applying...');

        $.post(form.attr('action'), form.serialize())
        .done(function(response) {
            if (response.success) {
                alert('Preset applied successfully! Source "' + response.source_name + '" created.');
                window.location.href = '/admin/scraper/sources/' + response.source_id + '/edit';
            } else {
                alert('Apply failed: ' + response.error);
            }
        })
        .fail(function() {
            alert('Apply request failed');
        })
        .always(function() {
            submitBtn.prop('disabled', false).html('<i class="fas fa-play"></i> Apply Preset');
        });
    });
});
</script>
{% endblock %}