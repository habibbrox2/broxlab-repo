{% extends 'admin/layout.twig' %}

{% block title %}Create Scraper Preset{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="mb-4 d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-1"><i class="bi bi-plus-circle me-2"></i>Create Scraper Preset</h1>
                    <p class="text-muted mb-0">Define a reusable preset for your scraper sources.</p>
                </div>
                <a href="/admin/scraper/presets" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Presets
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="POST" action="/admin/scraper/presets/create">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

                        <div class="mb-3">
                            <label class="form-label">Preset Key</label>
                            <input type="text" class="form-control" name="preset_key" required placeholder="unique_key">
                            <div class="form-text">Lowercase, snake_case key used for API references.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Preset Name</label>
                            <input type="text" class="form-control" name="preset_name" required placeholder="WordPress Standard">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" name="description" rows="2" placeholder="Describe the preset purpose"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Content Type</label>
                            <select class="form-select" name="content_type">
                                {% for type in contentTypes %}
                                    <option value="{{ type }}">{{ type|capitalize }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Test URL</label>
                            <input type="url" class="form-control" name="selector_test_url" placeholder="https://example.com/article">
                            <div class="form-text">Optional URL used only for selector testing.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Selectors (JSON)</label>
                            <textarea class="form-control monospace" name="selectors" rows="4" placeholder='{"title":"...", "content": "..."}'></textarea>
                            <div class="form-text">Provide selectors in JSON format (title, content, date, author etc.).</div>
                            <div class="mt-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm me-2" id="testSelectorsBtn">
                                    <i class="bi bi-gear me-1"></i>Test selectors
                                </button>
                                <span id="selectorTestFeedback" class="text-muted"></span>
                            </div>
                            <div class="mt-3" id="selectorTestResults" style="display:none;"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Advanced Configuration (JSON)</label>
                            <textarea class="form-control monospace" name="advance_config" rows="3" placeholder='{"pagination":"button"}'></textarea>
                            <div class="form-text">Optional advance config (JSON) for throttling, headers, etc.</div>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" type="checkbox" id="is_default" name="is_default">
                            <label class="form-check-label" for="is_default">Mark as Default</label>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>
                            Create Preset
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script>
        (function () {
            const testBtn = document.getElementById('testSelectorsBtn');
            const selectorsField = document.querySelector('textarea[name="selectors"]');
            const feedback = document.getElementById('selectorTestFeedback');
            const resultsContainer = document.getElementById('selectorTestResults');

            if (!testBtn || !selectorsField) {
                return;
            }

            const csrfToken = '{{ csrf_token }}';

            testBtn.addEventListener('click', async function () {
                const selectorsJson = selectorsField.value.trim();
                if (!selectorsJson) {
                    feedback.textContent = 'Enter selectors before testing.';
                    return;
                }

                let selectorsObj;
                try {
                    selectorsObj = JSON.parse(selectorsJson);
                } catch (err) {
                    feedback.textContent = 'Selectors must be valid JSON.';
                    return;
                }

                feedback.textContent = 'Testing selectors...';
                resultsContainer.style.display = 'none';
                resultsContainer.innerHTML = '';
                testBtn.disabled = true;

                try {
                    const response = await fetch('/api/v1/scraper/presets/test-selectors', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': csrfToken
                        },
                        body: JSON.stringify({
                            url: document.querySelector('input[name="selector_test_url"]')?.value || '',
                            selectors: selectorsObj,
                            max_samples: 5
                        })
                    });

                    const data = await response.json();
                    if (!data.success) {
                        feedback.textContent = data.error || 'Selector test failed';
                        return;
                    }

                    feedback.textContent = 'Selector test completed';
                    resultsContainer.style.display = 'block';
                    const items = [];
                    for (const [name, result] of Object.entries(data.results || {})) {
                        const pass = result.success && result.matched;
                        const status = pass ? '✅' : '⚠️';
                        const count = result.count ?? result.matches_count ?? 0;
                        items.push(`
                            <div class="mb-2">
                                <strong>${name}</strong> ${status} (${count} matches)
                                ${result.message ? `<div class="text-muted small">${result.message}</div>` : ''}
                            </div>
                        `);
                    }
                    resultsContainer.innerHTML = items.join('');
                } catch (error) {
                    feedback.textContent = 'Selector test failed: ' + (error.message || 'Unknown error');
                } finally {
                    testBtn.disabled = false;
                }
            });
        })();
    </script>
{% endblock %}
