{% extends 'admin/layout.twig' %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="mb-4 d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-1">{{ preset.icon }} {{ preset.name }}</h1>
                    <p class="text-muted mb-0">Preset Key: {{ preset.key }} • Category: {{ preset.category|title }}</p>
                </div>
                <div>
                    <a href="/admin/scraper/presets" class="btn btn-outline-secondary me-2">
                        <i class="bi bi-arrow-left me-1"></i>Back to Presets
                    </a>
                    <div class="btn-group">
                        <a href="/admin/scraper/presets/{{ preset.key }}/edit" class="btn btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i>Edit Preset
                        </a>
                        <button type="button" class="btn btn-outline-danger" onclick="deletePreset()">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Description</h5>
                </div>
                <div class="card-body">
                    <p class="mb-0">{{ preset.description }}</p>
                </div>
            </div>

            <!-- Configuration -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-gear me-2"></i>Configuration</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Type:</dt>
                                <dd class="col-sm-8">{{ preset.type|title }}</dd>

                                <dt class="col-sm-4">Content Type:</dt>
                                <dd class="col-sm-8">{{ preset.content_type|title }}</dd>

                                <dt class="col-sm-4">Category:</dt>
                                <dd class="col-sm-8">{{ preset.category|title }}</dd>

                                <dt class="col-sm-4">Fetch Interval:</dt>
                                <dd class="col-sm-8">{{ preset.config.fetch_interval ?? 'N/A' }} minutes</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Delay:</dt>
                                <dd class="col-sm-8">{{ preset.config.delay ?? 'N/A' }} seconds</dd>

                                <dt class="col-sm-4">Max Pages:</dt>
                                <dd class="col-sm-8">{{ preset.config.max_pages ?? 'N/A' }}</dd>

                                <dt class="col-sm-4">Pagination:</dt>
                                <dd class="col-sm-8">{{ preset.config.pagination_type ?? 'N/A'|title }}</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Selectors -->
            {% if preset.config %}
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-code me-2"></i>CSS Selectors</h5>
                </div>
                <div class="card-body">
                    <pre class="bg-light p-3 rounded"><code>{{ preset.config|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Example URLs -->
            {% if preset.example_urls %}
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-link me-2"></i>Example URLs</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        {% for url in preset.example_urls %}
                        <a href="{{ url }}" target="_blank" class="list-group-item list-group-item-action" rel="noopener noreferrer">
                            <small>{{ url }}</small>
                            <i class="bi bi-box-arrow-up-right ms-1"></i>
                        </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% endif %}

            <!-- Actions -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-tools me-2"></i>Actions</h5>
                </div>
                <div class="card-body">
                    <form method="POST" action="/admin/scraper/presets/{{ preset.key }}/apply" class="mb-3">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="name" value="{{ preset.name }} (Applied)">
                        <button type="submit" class="btn btn-success w-100 mb-2">
                            <i class="bi bi-play me-1"></i>Apply Preset
                        </button>
                    </form>
                    <a href="/admin/scraper/ai/analyzer?url={{ preset.example_urls[0] }}" class="btn btn-info w-100 mb-2">
                        <i class="bi bi-robot me-1"></i>Test with AI Analyzer
                    </a>
                    <a href="/admin/scraper/ai/preset-generator" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-magic me-1"></i>Create Similar Preset
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Preset</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the preset "<strong>{{ preset.name }}</strong>"?</p>
                <p class="text-danger">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete Preset</button>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script>
function deletePreset() {
    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
    modal.show();
}

function confirmDelete() {
    fetch('/admin/scraper/presets/{{ preset.key }}', {
        method: 'DELETE',
        headers: {
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            window.location.href = '/admin/scraper/presets';
        } else {
            alert('Error: ' + (data.error || 'Failed to delete preset'));
        }
    })
    .catch(error => {
        console.error('Delete error:', error);
        alert('Failed to delete preset');
    });
}

// Handle preset apply
document.querySelector('form[action*="/apply"]').addEventListener('submit', function(e) {
    e.preventDefault();
    const form = this;
    const submitBtn = form.querySelector('button[type="submit"]');

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="bi bi-spinner bi-spin me-1"></i>Applying...';

    fetch(form.action, {
        method: 'POST',
        body: new FormData(form)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Preset applied successfully! Source "' + data.source_name + '" created.');
            window.location.href = '/admin/scraper/sources/' + data.source_id + '/edit';
        } else {
            alert('Apply failed: ' + (data.error || 'Unknown error'));
        }
    })
    .catch(error => {
        console.error('Apply error:', error);
        alert('Failed to apply preset');
    })
    .finally(() => {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="bi bi-play me-1"></i>Apply Preset';
    });
});
</script>
{% endblock %}