    liveTestEngineFailure.innerHTML = `
        <div class="border rounded p-3 bg-danger-subtle">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <h6 class="mb-1">Engine Failure</h6>
                    <div class="small text-muted">The scraper engine stopped before producing usable data.</div>
                </div>
                <span class="badge text-bg-danger">
                    <i class="bi bi-exclamation-octagon me-1"></i>engine
                </span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-lg-6">
                    <div class="border rounded p-3 bg-white h-100">
                        <div class="small text-uppercase fw-semibold text-muted mb-2">Strategy</div>
                        <div class="d-grid gap-1 small">
                            <div><strong>Strategy used:</strong> ${escapeHtml(strategy.strategy_used || 'auto')}</div>
                            <div><strong>Library used:</strong> ${escapeHtml(strategy.library_used || 'unknown')}</div>
                            <div><strong>Mode:</strong> ${escapeHtml(strategy.browser_mode || 'unknown')}</div>
                            <div><strong>Dynamic extraction:</strong> ${escapeHtml(strategy.extract_dynamic || 'no')}</div>
                            <div><strong>Wait selector:</strong> ${escapeHtml(strategy.wait_for_element || 'none')}</div>
                            <div><strong>JS wait:</strong> ${escapeHtml(strategy.wait_for_js || 0)} ms</div>
                            <div><strong>Timeout:</strong> ${escapeHtml(strategy.timeout || 0)} s</div>
                            <div><strong>Max depth:</strong> ${escapeHtml(strategy.max_depth || 1)}</div>
