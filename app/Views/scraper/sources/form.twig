{% extends 'admin/layout.twig' %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block head %}
<style>
    .form-section {
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .form-section h5 {
        border-bottom: 1px solid #dee2e6;
        padding-bottom: 0.5rem;
        margin-bottom: 1rem;
        color: #495057;
    }
    .json-editor {
        font-family: 'Courier New', monospace;
        min-height: 120px;
    }
    .api-selector-disabled {
        opacity: 0.58;
        filter: saturate(0.85);
        position: relative;
    }
    .api-selector-disabled .form-control,
    .api-selector-disabled .form-select,
    .api-selector-disabled .form-text {
        pointer-events: none;
    }
    .api-selector-disabled::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 0.375rem;
        background: rgba(255, 255, 255, 0.08);
        pointer-events: none;
    }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-1">
                        <i class="bi bi-{{ source ? 'pencil' : 'plus-circle' }} me-2"></i>{{ pageTitle }}
                    </h1>
                    <p class="text-muted mb-0">
                        {{ source ? 'Edit the configuration for this scraping source' : 'Create a new web scraping source' }}
                    </p>
                </div>
                <div>
                    <a href="/admin/scraper/sources" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back to Sources
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
<form id="sourceForm" method="POST" action="/admin/scraper/sources/save">
                 {% if source %}
                     <input type="hidden" name="_method" value="PUT">
                     <input type="hidden" name="id" value="{{ source.id }}">
                 {% endif %}
                 <input type="hidden" name="csrf_token" value="{{ csrf_token ?? generateCsrfToken() }}">

                <!-- Basic Information -->
                <div class="form-section">
                    <h5><i class="bi bi-info-circle me-2"></i>Basic Information</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="name" class="form-label">Source Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="name" name="name" value="{{ source.name ?? '' }}" required>
                            <div class="form-text">A descriptive name for this scraping source</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="url" class="form-label">URL <span class="text-danger">*</span></label>
                            <input type="url" class="form-control" id="url" name="url" value="{{ source.url ?? '' }}" required>
                            <div class="form-text">The main URL to scrape from</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="type" class="form-label">Source Type <span class="text-danger">*</span></label>
                            <select class="form-select" id="type" name="type" required>
                                <option value="">Select Type</option>
                                <option value="rss" {{ (source.type ?? '') == 'rss' ? 'selected' : '' }}>RSS Feed</option>
                                <option value="html" {{ (source.type ?? '') == 'html' ? 'selected' : '' }}>HTML Page</option>
                                <option value="api" {{ (source.type ?? '') == 'api' ? 'selected' : '' }}>API Endpoint</option>
                                <option value="scrape" {{ (source.type ?? 'scrape') == 'scrape' ? 'selected' : '' }}>Web Scraper</option>
                                <option value="xml" {{ (source.type ?? '') == 'xml' ? 'selected' : '' }}>XML Feed</option>
                            </select>
                            <div class="mt-2" id="sourceTypeHint">
                                {% if (source.type ?? '') == 'api' %}
                                    <span class="badge bg-info-subtle text-info border border-info-subtle me-2">API Source</span>
                                    <span class="small text-muted">This source is JSON-driven. It uses an API endpoint instead of HTML selectors.</span>
                                {% elseif 'alljobs.teletalk.com.bd' in (source.url ?? '') %}
                                    <span class="badge bg-success-subtle text-success border border-success-subtle me-2">Teletalk Source</span>
                                    <span class="small text-muted">Teletalk is currently configured as a structured source.</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="content_type" class="form-label">Content Type <span class="text-danger">*</span></label>
                            <select class="form-select" id="content_type" name="content_type" required>
                                <option value="">Select Content Type</option>
                                <option value="articles" {{ (source.content_type ?? 'articles') == 'articles' ? 'selected' : '' }}>Articles</option>
                                <option value="pages" {{ (source.content_type ?? '') == 'pages' ? 'selected' : '' }}>Pages</option>
                                <option value="mobiles" {{ (source.content_type ?? '') == 'mobiles' ? 'selected' : '' }}>Mobile Devices</option>
                                <option value="services" {{ (source.content_type ?? '') == 'services' ? 'selected' : '' }}>Services</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="category_id" class="form-label">Category</label>
                            <select class="form-select" id="category_id" name="category_id">
                                <option value="">No Category</option>
                                {% for category in categories %}
                                    <option value="{{ category.id }}" {{ (source.category_id ?? '') == category.id ? 'selected' : '' }}>
                                        {{ category.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Scraping Configuration -->
                <div class="form-section">
                    <h5><i class="bi bi-gear me-2"></i>Scraping Configuration</h5>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label for="fetch_interval" class="form-label">Fetch Interval (seconds)</label>
                            <input type="number" class="form-control" id="fetch_interval" name="fetch_interval" value="{{ source.fetch_interval ?? 3600 }}" min="60">
                            <div class="form-text">How often to check for updates</div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="scrape_depth" class="form-label">Scrape Depth</label>
                            <input type="number" class="form-control" id="scrape_depth" name="scrape_depth" value="{{ source.scrape_depth ?? 1 }}" min="1" max="10">
                            <div class="form-text">How many levels deep to scrape</div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="max_pages" class="form-label">Max Pages</label>
                            <input type="number" class="form-control" id="max_pages" name="max_pages" value="{{ source.max_pages ?? 50 }}" min="1">
                            <div class="form-text">Maximum pages to scrape</div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="delay" class="form-label">Delay (seconds)</label>
                            <input type="number" class="form-control" id="delay" name="delay" value="{{ source.delay ?? 2 }}" min="0" step="0.1">
                            <div class="form-text">Delay between requests</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="use_browser" name="use_browser" value="1" {{ (source.use_browser ?? 0) == 1 ? 'checked' : '' }}>
                                <label class="form-check-label" for="use_browser">
                                    Use Browser Rendering
                                </label>
                                <div class="form-text">Use headless browser for JavaScript-heavy sites</div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="ssl_verify" name="ssl_verify" value="1" {{ (source.ssl_verify ?? 1) == 1 ? 'checked' : '' }}>
                                <label class="form-check-label" for="ssl_verify">
                                    Verify SSL Certificates
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pagination Settings -->
                <div class="form-section">
                    <h5><i class="bi bi-arrow-right-circle me-2"></i>Pagination Settings</h5>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="pagination_type" class="form-label">Pagination Type</label>
                            <select class="form-select" id="pagination_type" name="pagination_type">
                                <option value="none" {{ (source.pagination_type ?? 'none') == 'none' ? 'selected' : '' }}>None</option>
                                <option value="link" {{ (source.pagination_type ?? '') == 'link' ? 'selected' : '' }}>Link-based</option>
                                <option value="query" {{ (source.pagination_type ?? '') == 'query' ? 'selected' : '' }}>Query Parameter</option>
                                <option value="scroll" {{ (source.pagination_type ?? '') == 'scroll' ? 'selected' : '' }}>Infinite Scroll</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="pagination_selector" class="form-label">Pagination Selector</label>
                            <input type="text" class="form-control" id="pagination_selector" name="pagination_selector" value="{{ source.pagination_selector ?? '' }}">
                            <div class="form-text">CSS selector for pagination links</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="pagination_pattern" class="form-label">Pagination Pattern</label>
                            <input type="text" class="form-control" id="pagination_pattern" name="pagination_pattern" value="{{ source.pagination_pattern ?? '' }}">
                            <div class="form-text">URL pattern for pagination (e.g., ?page={page})</div>
                        </div>
                    </div>
                </div>

                <!-- Proxy Settings -->
                <div class="form-section">
                    <h5><i class="bi bi-shield me-2"></i>Proxy Settings</h5>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="proxy_enabled" name="proxy_enabled" value="1" {{ (source.proxy_enabled ?? 0) == 1 ? 'checked' : '' }}>
                                <label class="form-check-label" for="proxy_enabled">
                                    Enable Proxy
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="proxy_provider" class="form-label">Proxy Provider</label>
                            <select class="form-select" id="proxy_provider" name="proxy_provider">
                                <option value="">No Proxy</option>
                                <option value="brightdata" {{ (source.proxy_provider ?? '') == 'brightdata' ? 'selected' : '' }}>Bright Data</option>
                                <option value="oxylabs" {{ (source.proxy_provider ?? '') == 'oxylabs' ? 'selected' : '' }}>Oxylabs</option>
                                <option value="smartproxy" {{ (source.proxy_provider ?? '') == 'smartproxy' ? 'selected' : '' }}>Smart Proxy</option>
                                <option value="custom" {{ (source.proxy_provider ?? '') == 'custom' ? 'selected' : '' }}>Custom</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="timeout" class="form-label">Timeout (seconds)</label>
                            <input type="number" class="form-control" id="timeout" name="timeout" value="{{ source.timeout ?? 30 }}" min="5" max="300">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="proxy_config" class="form-label">Proxy Configuration</label>
                        <textarea class="form-control json-editor" id="proxy_config" name="proxy_config" rows="3">{{ source.proxy_config ?? '' }}</textarea>
                        <div class="form-text">JSON configuration for proxy settings</div>
                    </div>
                </div>

                <!-- Advanced Configuration -->
                <div class="form-section" id="selectorSection">
                    <h5><i class="bi bi-code-slash me-2"></i>Advanced Configuration</h5>
                    <div class="alert alert-info py-2 px-3 small mb-3 d-none" id="apiSelectorNotice">
                        <i class="bi bi-info-circle me-1"></i>
                        API sources use JSON extraction, so selector inputs are visually disabled to reduce confusion.
                    </div>
                    <div class="mb-3">
                        <label for="selectors" class="form-label">CSS Selectors</label>
                        <textarea class="form-control json-editor" id="selectors" name="selectors" rows="6">{{ source.selectors ? source.selectors|json_encode(constant('JSON_PRETTY_PRINT')) : '' }}</textarea>
                        <div class="form-text">JSON object defining CSS selectors for content extraction</div>
                    </div>
                    <div class="mb-3">
                        <label for="advance_config" class="form-label">Advanced Config</label>
                        <textarea class="form-control json-editor" id="advance_config" name="advance_config" rows="6">{{ source.advance_config ? source.advance_config|json_encode(constant('JSON_PRETTY_PRINT')) : '' }}</textarea>
                        <div class="form-text">JSON object for advanced scraping configuration</div>
                    </div>
<div class="mb-3">
                         <label for="presets" class="form-label">Presets</label>
                         <select class="form-select" id="presets" name="presets">
                             <option value="">No Preset</option>
                             {% for preset in presets %}
                                 <option value="{{ preset.key }}" {{ (source.presets ?? '') == preset.key ? 'selected' : '' }}>
                                     {{ preset.name }}
                                 </option>
                             {% endfor %}
                         </select>
                         <div class="form-text">
                             <span id="presetAutoHint" data-default-hint="Select a preset configuration for this source">
                                 Select a preset configuration for this source
                             </span>
                         </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <a href="/admin/scraper/sources" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </a>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-outline-warning" id="aiPrefillBtn">
                            <i class="bi bi-magic me-1"></i>AI Auto Fill
                        </button>
                        <button type="button" class="btn btn-outline-info" id="liveTestBtn">
                            <i class="bi bi-broadcast me-1"></i>Test Live Data
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>{{ source ? 'Update Source' : 'Create Source' }}
                        </button>
                    </div>
                </div>
            </form>

            <div class="card mt-4 d-none" id="liveTestResultCard">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-activity me-2"></i>Live Test Result</h5>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="clearLiveTestBtn">
                        <i class="bi bi-x-circle me-1"></i>Clear
                    </button>
                </div>
                <div class="card-body">
                    <div id="liveTestStatus" class="alert alert-info mb-4">
                        <i class="bi bi-info-circle me-2"></i>Run a live test to verify selectors, pagination and scraping settings.
                    </div>
                    <div id="liveTestSummary" class="row g-3 mb-4"></div>
                    <div id="liveTestConfig" class="row g-3 mb-4"></div>
                    <div id="liveTestSelectorAudit" class="mb-4"></div>
                    <div id="liveTestDiagnosis" class="mb-4"></div>
                    <div id="liveTestEngineFailure" class="mb-4"></div>
                    <div class="row g-3 mb-4">
                        <div class="col-lg-6">
                            <div class="border rounded p-3 h-100">
                                <h6 class="mb-3">Configuration Checks</h6>
                                <div id="liveTestChecks" class="d-grid gap-2"></div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="border rounded p-3 h-100">
                                <h6 class="mb-3">Sample Extracted Items</h6>
                                <div id="liveTestSamples" class="d-grid gap-3"></div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <h6 class="mb-3">Raw Response</h6>
                        <pre id="liveTestRaw" class="bg-light border rounded p-3 small mb-0" style="max-height: 320px; overflow: auto;"></pre>
                    </div>
                </div>
            </div>

            <div class="card mt-4 d-none" id="aiPrefillResultCard">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-magic me-2"></i>AI Source Suggestions</h5>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="clearAiPrefillBtn">
                        <i class="bi bi-x-circle me-1"></i>Clear
                    </button>
                </div>
                <div class="card-body">
                    <div id="aiPrefillStatus" class="alert alert-info mb-4">
                        <i class="bi bi-info-circle me-2"></i>Run AI analysis to detect real selectors and configuration hints from the live page.
                    </div>
                    <div id="aiPrefillSummary" class="row g-3 mb-4"></div>
                    <div id="aiPrefillSuggestions" class="mb-4"></div>
                    <div class="row g-3 mb-4">
                        <div class="col-lg-6">
                            <div class="border rounded p-3 h-100">
                                <h6 class="mb-3">Selectors to Apply</h6>
                                <div id="aiPrefillSelectors" class="d-grid gap-2"></div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="border rounded p-3 h-100">
                                <h6 class="mb-3">Config to Apply</h6>
                                <div id="aiPrefillConfig" class="d-grid gap-2"></div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <button type="button" class="btn btn-success" id="applyAiPrefillBtn">
                            <i class="bi bi-arrow-down-circle me-1"></i>Apply Suggestions
                        </button>
                    </div>
                    <div>
                        <h6 class="mb-3">Raw AI Response</h6>
                        <pre id="aiPrefillRaw" class="bg-light border rounded p-3 small mb-0" style="max-height: 320px; overflow: auto;"></pre>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Help & Tips</h6>
                </div>
                <div class="card-body">
                    <h6>Source Types:</h6>
                    <ul class="small mb-3">
                        <li><strong>RSS:</strong> For RSS/Atom feeds</li>
                        <li><strong>HTML:</strong> For static HTML pages</li>
                        <li><strong>API:</strong> For JSON/XML APIs</li>
                        <li><strong>Scrape:</strong> For dynamic web scraping</li>
                    </ul>

                    <h6>Content Types:</h6>
                    <ul class="small mb-3">
                        <li><strong>Articles:</strong> News, blog posts</li>
                        <li><strong>Pages:</strong> General web pages</li>
                        <li><strong>Mobiles:</strong> Mobile device data</li>
                        <li><strong>Services:</strong> Service listings</li>
                    </ul>

                    <h6>Pagination:</h6>
                    <ul class="small mb-0">
                        <li><strong>Link-based:</strong> Next page links</li>
                        <li><strong>Query:</strong> ?page=1, ?page=2</li>
                        <li><strong>Scroll:</strong> Infinite scroll loading</li>
                    </ul>
                </div>
            </div>

            {% if source %}
            <div class="card mt-3">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-clock me-2"></i>Source Status</h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="border-end">
                                <h4 class="text-{{ source.is_active == 1 ? 'success' : 'warning' }}">
                                    {{ source.is_active == 1 ? 'Active' : 'Inactive' }}
                                </h4>
                                <small class="text-muted">Status</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <h4 class="text-info">
                                {% if source.last_fetched_at %}
                                    {{ source.last_fetched_at|date('M j, H:i') }}
                                {% else %}
                                    Never
                                {% endif %}
                            </h4>
                            <small class="text-muted">Last Fetched</small>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
const sourceForm = document.getElementById('sourceForm');
const liveTestBtn = document.getElementById('liveTestBtn');
const clearLiveTestBtn = document.getElementById('clearLiveTestBtn');
const liveTestResultCard = document.getElementById('liveTestResultCard');
const liveTestStatus = document.getElementById('liveTestStatus');
const liveTestSummary = document.getElementById('liveTestSummary');
const liveTestConfig = document.getElementById('liveTestConfig');
const liveTestSelectorAudit = document.getElementById('liveTestSelectorAudit');
const liveTestDiagnosis = document.getElementById('liveTestDiagnosis');
const liveTestEngineFailure = document.getElementById('liveTestEngineFailure');
const liveTestChecks = document.getElementById('liveTestChecks');
const liveTestSamples = document.getElementById('liveTestSamples');
const liveTestRaw = document.getElementById('liveTestRaw');
const aiPrefillBtn = document.getElementById('aiPrefillBtn');
const clearAiPrefillBtn = document.getElementById('clearAiPrefillBtn');
const aiPrefillResultCard = document.getElementById('aiPrefillResultCard');
const aiPrefillStatus = document.getElementById('aiPrefillStatus');
const aiPrefillSummary = document.getElementById('aiPrefillSummary');
const aiPrefillSuggestions = document.getElementById('aiPrefillSuggestions');
const aiPrefillSelectors = document.getElementById('aiPrefillSelectors');
const aiPrefillConfig = document.getElementById('aiPrefillConfig');
const aiPrefillRaw = document.getElementById('aiPrefillRaw');
const applyAiPrefillBtn = document.getElementById('applyAiPrefillBtn');
const sourceTypeSelect = document.getElementById('type');
const sourceTypeHint = document.getElementById('sourceTypeHint');
const selectorSection = document.getElementById('selectorSection');
const apiSelectorNotice = document.getElementById('apiSelectorNotice');

function escapeHtml(value) {
    return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function validateJsonFields() {
    const jsonFields = ['selectors', 'advance_config', 'proxy_config'];
    let isValid = true;

    jsonFields.forEach(fieldId => {
        const field = document.getElementById(fieldId);
        if (!field) {
            return;
        }

        if (field.value.trim()) {
            try {
                JSON.parse(field.value);
                field.classList.remove('is-invalid');
            } catch (error) {
                field.classList.add('is-invalid');
                isValid = false;
            }
        } else {
            field.classList.remove('is-invalid');
        }
    });

    return isValid;
}

function formatJsonEditors() {
    document.querySelectorAll('.json-editor').forEach(field => {
        field.addEventListener('blur', function() {
            if (this.value.trim()) {
                try {
                    const parsed = JSON.parse(this.value);
                    this.value = JSON.stringify(parsed, null, 2);
                    this.classList.remove('is-invalid');
                } catch (error) {
                    this.classList.add('is-invalid');
                }
            } else {
                this.classList.remove('is-invalid');
            }
        });
    });
}

function renderSourceTypeHint() {
    if (!sourceTypeHint || !sourceTypeSelect) {
        return;
    }

    const type = (sourceTypeSelect.value || '').toLowerCase();
    const sourceUrl = document.getElementById('url')?.value || '';

    if (type === 'api') {
        sourceTypeHint.innerHTML = `
            <span class="badge bg-info-subtle text-info border border-info-subtle me-2">API Source</span>
            <span class="small text-muted">This source is JSON-driven. It uses an API endpoint instead of HTML selectors.</span>
        `;
        if (selectorSection) {
            selectorSection.classList.add('api-selector-disabled');
        }
        if (apiSelectorNotice) {
            apiSelectorNotice.classList.remove('d-none');
        }
        return;
    }

    if (sourceUrl.includes('alljobs.teletalk.com.bd')) {
        sourceTypeHint.innerHTML = `
            <span class="badge bg-success-subtle text-success border border-success-subtle me-2">Teletalk Source</span>
            <span class="small text-muted">Teletalk is configured as a structured source. If the type changes to API, the live tester will switch to JSON extraction.</span>
        `;
        if (selectorSection) {
            selectorSection.classList.remove('api-selector-disabled');
        }
        if (apiSelectorNotice) {
            apiSelectorNotice.classList.add('d-none');
        }
        return;
    }

    sourceTypeHint.innerHTML = '';
    if (selectorSection) {
        selectorSection.classList.remove('api-selector-disabled');
    }
    if (apiSelectorNotice) {
        apiSelectorNotice.classList.add('d-none');
    }
}

function buildStatCard(label, value, tone = 'primary') {
    return `
        <div class="col-md-3">
            <div class="border rounded p-3 h-100">
                <div class="text-uppercase small text-muted fw-semibold">${escapeHtml(label)}</div>
                <div class="h4 mb-0 text-${tone}">${escapeHtml(value)}</div>
            </div>
        </div>
    `;
}

function renderAiPrefillSummary(result = {}) {
    const summary = [
        ['Result', result.success ? 'Ready' : 'Failed', result.success ? 'success' : 'danger'],
        ['Source Type', result.source_type || 'unknown', 'primary'],
        ['Content Type', result.content_type || 'articles', 'info'],
        ['Confidence', `${Math.round((result.confidence || 0) * 100)}%`, 'warning'],
        ['Browser', result.use_browser ? 'Enabled' : 'Disabled', result.use_browser ? 'warning' : 'success']
    ];

    aiPrefillSummary.innerHTML = summary.map(([label, value, tone]) => buildStatCard(label, value, tone)).join('');
}

function renderAiPrefillSuggestions(result = {}) {
    const suggestions = Array.isArray(result.suggestions) ? result.suggestions : [];
    const warnings = Array.isArray(result.warnings) ? result.warnings : [];
    const items = [...suggestions.map(msg => ({ type: 'suggestion', message: msg })), ...warnings.map(msg => ({ type: 'warning', message: msg }))];

    if (!items.length) {
        aiPrefillSuggestions.innerHTML = '<div class="text-muted small">No additional AI suggestions were returned.</div>';
        return;
    }

    aiPrefillSuggestions.innerHTML = `
        <div class="border rounded p-3 bg-light">
            <div class="small text-uppercase fw-semibold text-muted mb-2">AI Notes</div>
            <div class="d-grid gap-2">
                ${items.map(item => `
                    <div class="border rounded p-2 bg-white">
                        <span class="badge text-bg-${item.type === 'warning' ? 'warning' : 'info'} me-2">${escapeHtml(item.type)}</span>
                        <span class="small">${escapeHtml(item.message || '')}</span>
                    </div>
                `).join('')}
            </div>
        </div>
    `;
}

function renderAiPrefillSelectors(result = {}) {
    const selectors = result.selectors || {};
    const candidates = result.selector_candidates || {};
    const entries = Object.entries(selectors);

    if (!entries.length) {
        aiPrefillSelectors.innerHTML = '<div class="text-muted small">No reliable selectors were detected.</div>';
        return;
    }

    aiPrefillSelectors.innerHTML = entries.map(([key, selector]) => {
        const candidateList = Array.isArray(candidates[key]) ? candidates[key] : [];
        const top = candidateList[0] || {};
        const confidence = Math.round((top.confidence || 0) * 100);
        const sample = top.sample_text ? `<div class="small text-muted mt-2">${escapeHtml(top.sample_text)}</div>` : '';
        return `
            <div class="border rounded p-3 bg-white">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                    <div class="fw-semibold">${escapeHtml(key)}</div>
                    <span class="badge text-bg-success">${confidence}%</span>
                </div>
                <code class="d-block small">${escapeHtml(selector)}</code>
                ${sample}
            </div>
        `;
    }).join('');
}

function renderAiPrefillConfig(result = {}) {
    const advanceConfig = result.advance_config || {};
    const pagination = result.pagination || {};
    const items = [];

    if (advanceConfig && Object.keys(advanceConfig).length) {
        items.push({ label: 'Advance Config', value: JSON.stringify(advanceConfig, null, 2) });
    }
    if (pagination && (pagination.type || pagination.selector || pagination.pattern)) {
        items.push({ label: 'Pagination', value: JSON.stringify(pagination, null, 2) });
    }
    if (result.source_type) {
        items.push({ label: 'Source Type', value: result.source_type });
    }
    if (result.content_type) {
        items.push({ label: 'Content Type', value: result.content_type });
    }

    if (!items.length) {
        aiPrefillConfig.innerHTML = '<div class="text-muted small">No config suggestions were returned.</div>';
        return;
    }

    aiPrefillConfig.innerHTML = items.map(item => `
        <div class="border rounded p-3 bg-white">
            <div class="small text-uppercase fw-semibold text-muted mb-2">${escapeHtml(item.label)}</div>
            <pre class="small mb-0" style="white-space: pre-wrap;">${escapeHtml(item.value)}</pre>
        </div>
    `).join('');
}

function setFieldValueIfPresent(fieldId, value, overwrite = true) {
    const field = document.getElementById(fieldId);
    if (!field || value === undefined || value === null || value === '') {
        return;
    }

    if (!overwrite && String(field.value || '').trim() !== '') {
        return;
    }

    field.value = String(value);
}

function mergeJsonValue(fieldId, suggestion) {
    const field = document.getElementById(fieldId);
    if (!field || !suggestion || typeof suggestion !== 'object') {
        return;
    }

    let current = {};
    const raw = String(field.value || '').trim();
    if (raw !== '') {
        try {
            const parsed = JSON.parse(raw);
            if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
                current = parsed;
            }
        } catch (error) {
            current = {};
        }
    }

    field.value = JSON.stringify({ ...current, ...suggestion }, null, 2);
}

function applyAiPrefill(result = {}) {
    const sourceType = String(result.source_type || '').trim();
    const contentType = String(result.content_type || '').trim();
    const selectors = result.selectors || {};
    const advanceConfig = result.advance_config || {};
    const pagination = result.pagination || {};

    if (sourceType) {
        sourceTypeSelect.value = sourceType;
    }
    if (contentType) {
        document.getElementById('content_type').value = contentType;
    }
    if (typeof result.use_browser === 'boolean') {
        document.getElementById('use_browser').checked = result.use_browser;
    }

    if (sourceType === 'api') {
        document.getElementById('selectors').value = '';
        document.getElementById('pagination_type').value = 'none';
        document.getElementById('pagination_selector').value = '';
        document.getElementById('pagination_pattern').value = '';
    } else if (selectors && Object.keys(selectors).length) {
        document.getElementById('selectors').value = JSON.stringify(selectors, null, 2);
    }
    if (advanceConfig && Object.keys(advanceConfig).length) {
        mergeJsonValue('advance_config', advanceConfig);
    }

    if (pagination && pagination.type) {
        document.getElementById('pagination_type').value = pagination.type;
    }
    if (pagination && pagination.selector) {
        document.getElementById('pagination_selector').value = pagination.selector;
    }
    if (pagination && pagination.pattern) {
        document.getElementById('pagination_pattern').value = pagination.pattern;
    }

    renderSourceTypeHint();
}

function renderAiPrefillResult(result = {}) {
    if (!aiPrefillResultCard) {
        return;
    }

    aiPrefillResultCard.classList.remove('d-none');
    renderAiPrefillSummary(result);
    renderAiPrefillSuggestions(result);
    renderAiPrefillSelectors(result);
    renderAiPrefillConfig(result);
    aiPrefillRaw.textContent = JSON.stringify(result ?? {}, null, 2);
}

function resetAiPrefillCard() {
    if (!aiPrefillResultCard) {
        return;
    }

    aiPrefillResultCard.classList.add('d-none');
    aiPrefillStatus.className = 'alert alert-info mb-4';
    aiPrefillStatus.innerHTML = '<i class="bi bi-info-circle me-2"></i>Run AI analysis to detect real selectors and configuration hints from the live page.';
    aiPrefillSummary.innerHTML = '';
    aiPrefillSuggestions.innerHTML = '';
    aiPrefillSelectors.innerHTML = '';
    aiPrefillConfig.innerHTML = '';
    aiPrefillRaw.textContent = '';
}

function renderConfiguration(configuration = {}) {
    const map = [
        ['Source Type', configuration.source_type || 'n/a', 'primary'],
        ['Content Type', configuration.content_type || 'n/a', 'info'],
        ['Timeout', `${configuration.timeout ?? 30}s`, 'secondary'],
        ['Scrape Depth', configuration.scrape_depth ?? 1, 'secondary'],
        ['Max Pages', configuration.max_pages ?? 1, 'secondary'],
        ['Delay', `${configuration.delay ?? 0}s`, 'secondary'],
        ['Pagination', configuration.pagination_type || 'none', 'secondary'],
        ['Browser', configuration.use_browser ? 'Enabled' : 'Disabled', configuration.use_browser ? 'warning' : 'success'],
        ['SSL Verify', configuration.ssl_verify ? 'Enabled' : 'Disabled', configuration.ssl_verify ? 'success' : 'warning'],
        ['Selectors', `${configuration.selectors_count || 0} group(s)`, 'success'],
        ['Proxy', configuration.proxy_enabled ? (configuration.proxy_provider || 'Enabled') : 'Disabled', configuration.proxy_enabled ? 'warning' : 'success']
    ];

    liveTestConfig.innerHTML = map.map(([label, value, tone]) => buildStatCard(label, value, tone)).join('');
}

function renderSummary(result) {
    const summary = [
        ['Result', result.success ? 'Success' : 'Failed', result.success ? 'success' : 'danger'],
        ['Items Found', result.items_found ?? 0, 'primary'],
        ['Library', result.library_used || 'unknown', 'info'],
        ['Strategy', result.strategy_used || 'auto', 'secondary'],
        ['Duration', `${result.duration ?? 0}s`, 'warning']
    ];

    liveTestSummary.innerHTML = summary.map(([label, value, tone]) => buildStatCard(label, value, tone)).join('');
}

function renderSelectorAudit(audit = {}, summary = {}) {
    const checks = Array.isArray(audit) ? audit : [];
    const total = summary.total ?? checks.length ?? 0;
    const passed = summary.passed ?? 0;
    const warnings = summary.warnings ?? 0;
    const failed = summary.failed ?? 0;
    const fetchedHtml = summary.fetched_html ? 'Yes' : 'No';

    const header = `
        <div class="border rounded p-3 mb-3 bg-light">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h6 class="mb-1">Selector Validation</h6>
                    <div class="small text-muted">Each selector group is tested against the live page and marked as pass, warn, or fail.</div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge text-bg-success">Passed ${escapeHtml(passed)}</span>
                    <span class="badge text-bg-warning">Warnings ${escapeHtml(warnings)}</span>
                    <span class="badge text-bg-danger">Failed ${escapeHtml(failed)}</span>
                    <span class="badge text-bg-secondary">Total ${escapeHtml(total)}</span>
                    <span class="badge text-bg-info">HTML ${escapeHtml(fetchedHtml)}</span>
                </div>
            </div>
        </div>
    `;

    if (!checks.length) {
        liveTestSelectorAudit.innerHTML = header + '<div class="text-muted small">No selector groups were configured.</div>';
        return;
    }

    const cards = checks.map(check => {
        const tone = check.status === 'pass' ? 'success' : (check.status === 'warn' ? 'warning' : (check.status === 'fail' ? 'danger' : 'secondary'));
        const icon = check.status === 'pass' ? 'check-circle' : (check.status === 'warn' ? 'exclamation-triangle' : (check.status === 'fail' ? 'x-circle' : 'info-circle'));
        const samples = Array.isArray(check.sample_values) ? check.sample_values : [];

        return `
            <div class="border rounded p-3 mb-2">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <div class="fw-semibold">${escapeHtml(check.label || check.key || 'Selector')}</div>
                            <span class="badge text-bg-${tone}">
                                <i class="bi bi-${icon} me-1"></i>${escapeHtml(check.status || 'info')}
                            </span>
                        </div>
                        <div class="small text-muted mb-1">${escapeHtml(check.selector || 'No selector configured')}</div>
                        <div class="small">${escapeHtml(check.message || '')}</div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted text-uppercase fw-semibold">Matches</div>
                        <div class="h5 mb-0">${escapeHtml(check.count ?? 0)}</div>
                    </div>
                </div>
                ${samples.length ? `
                    <div class="mt-3">
                        <div class="small text-uppercase fw-semibold text-muted mb-2">Samples</div>
                        <div class="d-flex flex-wrap gap-2">
                            ${samples.map(sample => `<span class="badge text-bg-light border text-dark">${escapeHtml(sample)}</span>`).join('')}
                        </div>
                    </div>
                ` : ''}
            </div>
        `;
    }).join('');

    liveTestSelectorAudit.innerHTML = header + `<div class="d-grid gap-2">${cards}</div>`;
}

function renderDiagnosis(diagnosis = {}) {
    const items = Array.isArray(diagnosis.items) ? diagnosis.items : [];
    if (!items.length) {
        liveTestDiagnosis.innerHTML = '<div class="text-muted small">No configuration issues were detected.</div>';
        return;
    }

    const tone = diagnosis.status === 'error' ? 'danger' : 'warning';
    const icon = diagnosis.status === 'error' ? 'x-circle' : 'exclamation-triangle';

    liveTestDiagnosis.innerHTML = `
        <div class="border rounded p-3 bg-${tone}-subtle">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <div>
                    <h6 class="mb-1">Why it failed</h6>
                    <div class="small text-muted">${escapeHtml(diagnosis.headline || 'There are selector or configuration issues that need attention.')}</div>
                </div>
                <span class="badge text-bg-${tone}">
                    <i class="bi bi-${icon} me-1"></i>${escapeHtml(diagnosis.status || 'warning')}
                </span>
            </div>
            <div class="d-grid gap-2">
                ${items.map(item => `
                    <div class="border rounded p-2 bg-white">
                        <div class="small fw-semibold">${escapeHtml(item.level || 'info').toUpperCase()}</div>
                        <div class="small text-muted">${escapeHtml(item.message || '')}</div>
                    </div>
                `).join('')}
            </div>
        </div>
    `;
}

function renderEngineFailure(engineFailure = {}) {
    if (!engineFailure.show) {
