    liveTestSummary.innerHTML = '';
    liveTestConfig.innerHTML = '';
    liveTestSelectorAudit.innerHTML = '';
    liveTestDiagnosis.innerHTML = '';
    liveTestEngineFailure.innerHTML = '';
    liveTestChecks.innerHTML = '';
    liveTestSamples.innerHTML = '';
    liveTestRaw.textContent = '';
}

if (sourceForm) {
    sourceForm.addEventListener('submit', function(e) {
        if (!validateJsonFields()) {
            e.preventDefault();
            alert('Please fix the JSON syntax errors in the highlighted fields.');
            return false;
        }

        const submitBtn = this.querySelector('button[type="submit"]');
        submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Saving...';
        submitBtn.disabled = true;
    });
}

formatJsonEditors();
renderSourceTypeHint();

if (sourceTypeSelect) {
    sourceTypeSelect.addEventListener('change', renderSourceTypeHint);
}

const sourceUrlInput = document.getElementById('url');
if (sourceUrlInput) {
    sourceUrlInput.addEventListener('input', renderSourceTypeHint);
}

if (aiPrefillBtn && sourceForm) {
    aiPrefillBtn.addEventListener('click', async function() {
        if (!validateJsonFields()) {
            alert('Please fix the JSON syntax errors before running AI analysis.');
            return;
        }

        const originalHtml = aiPrefillBtn.innerHTML;
        const formData = new FormData(sourceForm);
        formData.set('url', document.getElementById('url')?.value || '');

        if (aiPrefillResultCard) {
            aiPrefillResultCard.classList.remove('d-none');
        }
        aiPrefillStatus.className = 'alert alert-info mb-4';
        aiPrefillStatus.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Analyzing live page for real selectors and config suggestions...';
        aiPrefillSummary.innerHTML = '';
        aiPrefillSuggestions.innerHTML = '';
        aiPrefillSelectors.innerHTML = '';
        aiPrefillConfig.innerHTML = '';
        aiPrefillRaw.textContent = '';
        aiPrefillBtn.disabled = true;
        aiPrefillBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Analyzing...';

        try {
            const prefillEndpoints = [
                '/admin/scraper/ai/source-prefill',
                '/api/v1/scraper/ai/source-prefill'
            ];
            let response = null;
            for (const endpoint of prefillEndpoints) {
                response = await fetch(endpoint, {
                    method: 'POST',
                    body: formData
                });
                if (response.ok || response.status !== 404) {
                    break;
                }
            }

            const data = await response.json();
            if (data.success) {
                renderAiPrefillResult(data);
                applyAiPrefill(data);
                aiPrefillStatus.className = 'alert alert-success mb-4';
                aiPrefillStatus.innerHTML = '<i class="bi bi-check-circle me-2"></i>AI suggestions were applied from real live page analysis.';
            } else {
                renderAiPrefillResult(data);
                aiPrefillStatus.className = 'alert alert-warning mb-4';
                aiPrefillStatus.innerHTML = `<i class="bi bi-exclamation-triangle me-2"></i>${escapeHtml(data.error || 'AI analysis returned no usable suggestions')}`;
            }
        } catch (error) {
            aiPrefillStatus.className = 'alert alert-danger mb-4';
            aiPrefillStatus.innerHTML = `<i class="bi bi-exclamation-triangle me-2"></i>${escapeHtml(error.message || 'AI analysis failed')}`;
        } finally {
            aiPrefillBtn.disabled = false;
            aiPrefillBtn.innerHTML = originalHtml;
        }
    });
}

if (liveTestBtn && sourceForm) {
    liveTestBtn.addEventListener('click', async function() {
        if (!validateJsonFields()) {
            alert('Please fix the JSON syntax errors before running the live test.');
            return;
        }

        const originalHtml = liveTestBtn.innerHTML;
        const formData = new FormData(sourceForm);

        formData.set('max_items', '5');
        formData.set('timeout', '30');

        showLiveTestCard();
        liveTestStatus.className = 'alert alert-info mb-4';
        liveTestStatus.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Running live test...';
        liveTestSummary.innerHTML = '';
        liveTestConfig.innerHTML = '';
        liveTestSelectorAudit.innerHTML = '';
        liveTestDiagnosis.innerHTML = '';
        liveTestEngineFailure.innerHTML = '';
        liveTestChecks.innerHTML = '';
        liveTestSamples.innerHTML = '';
        liveTestRaw.textContent = '';
        liveTestBtn.disabled = true;
        liveTestBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Testing...';

        try {
            const response = await fetch('/admin/scraper/sources/test-live', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();
            const result = data.result || {};
            if (Object.keys(result).length) {
                renderSummary(result);
                renderConfiguration(result.configuration || {});
                renderSelectorAudit(result.selector_checks || [], result.selector_summary || {});
                renderDiagnosis(result.diagnosis || {});
                renderEngineFailure(result.engine_failure || {});
                renderChecks(result.checks || []);
                renderSamples(result.samples || []);
                renderRawResponse(result);
            }

            if (!response.ok || !data.success) {
                throw new Error(data.error || 'Live test failed');
            }

            liveTestStatus.className = 'alert alert-success mb-4';
            liveTestStatus.innerHTML = '<i class="bi bi-check-circle me-2"></i>Live test completed successfully';
        } catch (error) {
            liveTestStatus.className = 'alert alert-danger mb-4';
            liveTestStatus.innerHTML = `<i class="bi bi-exclamation-triangle me-2"></i>${escapeHtml(error.message || 'Live test failed')}`;
        } finally {
            liveTestBtn.disabled = false;
            liveTestBtn.innerHTML = originalHtml;
        }
    });
}

if (clearLiveTestBtn) {
    clearLiveTestBtn.addEventListener('click', resetLiveTestCard);
}

if (applyAiPrefillBtn) {
    applyAiPrefillBtn.addEventListener('click', function() {
        if (!aiPrefillRaw || !aiPrefillRaw.textContent) {
            return;
        }

        try {
            const result = JSON.parse(aiPrefillRaw.textContent);
            applyAiPrefill(result);
            aiPrefillStatus.className = 'alert alert-success mb-4';
            aiPrefillStatus.innerHTML = '<i class="bi bi-check-circle me-2"></i>AI suggestions applied to the form.';
        } catch (error) {
            alert('Could not apply AI suggestions: invalid response data.');
        }
    });
}

if (clearAiPrefillBtn) {
    clearAiPrefillBtn.addEventListener('click', resetAiPrefillCard);
}
</script>

{% endblock %}
