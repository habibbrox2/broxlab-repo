                        <div class="small mb-2"><strong>Raw error:</strong> ${escapeHtml(rawError || 'No raw error was returned')}</div>
                        <div class="small"><strong>Inferred cause:</strong> ${escapeHtml(inferredCause)}</div>
                    </div>
                </div>
            </div>

            <div>
                <div class="small text-uppercase fw-semibold text-muted mb-2">Suggested Fixes</div>
                <div class="d-grid gap-2">
                    ${fixes.length ? fixes.map(fix => `
                        <div class="border rounded p-2 bg-white">
                            <div class="fw-semibold small">${escapeHtml(fix.title || 'Fix')}</div>
                            <div class="small text-muted">${escapeHtml(fix.detail || '')}</div>
                        </div>
                    `).join('') : '<div class="text-muted small">No specific fixes available.</div>'}
                </div>
            </div>
        </div>
    `;
}

function renderChecks(checks = []) {
    if (!checks.length) {
        liveTestChecks.innerHTML = '<div class="text-muted small">No checks returned.</div>';
        return;
    }

    liveTestChecks.innerHTML = checks.map(check => {
        const badgeTone = check.status === 'pass' ? 'success' : (check.status === 'warn' ? 'warning' : (check.status === 'fail' ? 'danger' : 'info'));
        const icon = check.status === 'pass' ? 'check-circle' : (check.status === 'warn' ? 'exclamation-triangle' : (check.status === 'fail' ? 'x-circle' : 'info-circle'));
        return `
            <div class="border rounded p-3 bg-light">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="fw-semibold">${escapeHtml(check.label || 'Check')}</div>
                        <div class="small text-muted">${escapeHtml(check.message || '')}</div>
                    </div>
                    <span class="badge text-bg-${badgeTone}">
                        <i class="bi bi-${icon} me-1"></i>${escapeHtml(check.status || 'info')}
                    </span>
                </div>
            </div>
        `;
    }).join('');
}

function renderSamples(samples = []) {
    if (!samples.length) {
        liveTestSamples.innerHTML = '<div class="text-muted small">No sample items were extracted.</div>';
        return;
    }

    liveTestSamples.innerHTML = samples.map((sample, index) => {
        const title = sample.title || sample.name || `Item ${index + 1}`;
        const url = sample.url || '';
        const excerpt = sample.excerpt || '';
        const excerptPreview = excerpt ? escapeHtml(excerpt.slice(0, 240)) : '';
        return `
            <div class="border rounded p-3">
                <div class="fw-semibold mb-1">${escapeHtml(title)}</div>
                ${url ? `<div class="small mb-2"><a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(url)}</a></div>` : ''}
                ${excerpt ? `<div class="small text-muted">${excerptPreview}</div>` : '<div class="small text-muted">No excerpt available.</div>'}
            </div>
        `;
    }).join('');
}

function renderRawResponse(result) {
    liveTestRaw.textContent = JSON.stringify(result ?? {}, null, 2);
}

