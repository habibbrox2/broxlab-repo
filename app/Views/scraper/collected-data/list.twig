{% extends 'admin/layout.twig' %}

{% block title %}Collected Data{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="mb-4 d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-1"><i class="bi bi-file-earmark-text me-2"></i>Collected Data</h1>
                    <p class="text-muted mb-0">View and manage scraped articles and content</p>
                </div>
                <div>
                    <a href="/admin/scraper" class="btn btn-outline-secondary me-2">
                        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
                    </a>
                    <button type="button" class="btn btn-primary" onclick="exportData()">
                        <i class="bi bi-download me-1"></i>Export
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Overview -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="text-center">
                                <h4 class="text-primary mb-1">{{ statusCounts.all }}</h4>
                                <small class="text-muted">Total</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center">
                                <h4 class="text-warning mb-1">{{ statusCounts.pending }}</h4>
                                <small class="text-muted">Pending</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center">
                                <h4 class="text-info mb-1">{{ statusCounts.processing }}</h4>
                                <small class="text-muted">Processing</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center">
                                <h4 class="text-success mb-1">{{ statusCounts.completed }}</h4>
                                <small class="text-muted">Completed</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <form method="GET" action="/admin/scraper/collected-data" class="row g-3">
                        <div class="col-md-3">
                            <label for="status" class="form-label">Status</label>
                            <select name="status" id="status" class="form-select">
                                <option value="">All Status</option>
                                <option value="pending" {{ filters.status == 'pending' ? 'selected' : '' }}>Pending</option>
                                <option value="processing" {{ filters.status == 'processing' ? 'selected' : '' }}>Processing</option>
                                <option value="completed" {{ filters.status == 'completed' ? 'selected' : '' }}>Completed</option>
                                <option value="failed" {{ filters.status == 'failed' ? 'selected' : '' }}>Failed</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="source" class="form-label">Source</label>
                            <select name="source" id="source" class="form-select">
                                <option value="">All Sources</option>
                                {% for source in sources %}
                                    <option value="{{ source.id }}" {{ filters.source == source.id ? 'selected' : '' }}>
                                        {{ source.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="content_type" class="form-label">Content Type</label>
                            <select name="content_type" id="content_type" class="form-select">
                                <option value="">All Types</option>
                                <option value="article" {{ filters.content_type == 'article' ? 'selected' : '' }}>Article</option>
                                <option value="blog" {{ filters.content_type == 'blog' ? 'selected' : '' }}>Blog</option>
                                <option value="product" {{ filters.content_type == 'product' ? 'selected' : '' }}>Product</option>
                                <option value="job" {{ filters.content_type == 'job' ? 'selected' : '' }}>Job</option>
                                <option value="event" {{ filters.content_type == 'event' ? 'selected' : '' }}>Event</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="search" class="form-label">Search</label>
                            <input type="text" name="search" id="search" class="form-control"
                                   value="{{ filters.search }}" placeholder="Title or content...">
                        </div>

                        <div class="col-12">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="bi bi-search me-1"></i>Filter
                            </button>
                            <a href="/admin/scraper/collected-data" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Clear
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Articles Table -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Articles ({{ pagination.total }})</h5>
                    <div class="d-flex align-items-center gap-2">
                        <select id="limitSelect" class="form-select form-select-sm" style="width: auto;">
                            <option value="10" {{ filters.limit == 10 ? 'selected' : '' }}>10 per page</option>
                            <option value="20" {{ filters.limit == 20 ? 'selected' : '' }}>20 per page</option>
                            <option value="50" {{ filters.limit == 50 ? 'selected' : '' }}>50 per page</option>
                            <option value="100" {{ filters.limit == 100 ? 'selected' : '' }}>100 per page</option>
                        </select>
                    </div>
                </div>
                <div class="card-body p-0">
                    {% if articles %}
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Title</th>
                                        <th>Source</th>
                                        <th>Status</th>
                                        <th>Content Type</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for article in articles %}
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="flex-shrink-0 me-3">
                                                        {% if article.image_url %}
                                                            <img src="{{ article.image_url }}" alt=""
                                                                 class="rounded" style="width: 40px; height: 40px; object-fit: cover;">
                                                        {% else %}
                                                            <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                                                 style="width: 40px; height: 40px;">
                                                                <i class="bi bi-file-earmark-text text-muted"></i>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <h6 class="mb-1">
                                                            <a href="#" onclick="viewArticle({{ article.id }})" class="text-decoration-none">
                                                                {{ article.title|truncate(60) }}
                                                            </a>
                                                        </h6>
                                                        <small class="text-muted">{{ article.url|truncate(80) }}</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">{{ article.source_name|default('Unknown') }}</span>
                                            </td>
                                            <td>
                                                <span class="badge
                                                    {% if article.status == 'completed' %}bg-success
                                                    {% elseif article.status == 'processing' %}bg-info
                                                    {% elseif article.status == 'failed' %}bg-danger
                                                    {% else %}bg-warning{% endif %}">
                                                    {{ article.status|title }}
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark">{{ article.content_type|default('article')|title }}</span>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    {{ article.created_at|date('M j, Y H:i') }}
                                                </small>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-outline-primary"
                                                            onclick="viewArticle({{ article.id }})">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-info"
                                                            onclick="editArticle({{ article.id }})">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger"
                                                            onclick="deleteArticle({{ article.id }})">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="text-center py-5">
                            <i class="bi bi-inbox fs-1 text-muted mb-3"></i>
                            <h5 class="text-muted">No articles found</h5>
                            <p class="text-muted mb-0">Try adjusting your filters or check if scraping jobs are running.</p>
                        </div>
                    {% endif %}
                </div>

                <!-- Pagination -->
                {% if pagination.pages > 1 %}
                    <div class="card-footer">
                        <nav aria-label="Article pagination">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                {% if pagination.page > 1 %}
                                    <li class="page-item">
                                        <a class="page-link" href="?page={{ pagination.page - 1 }}{% for key, value in filters %}&{{ key }}={{ value }}{% endfor %}">
                                            Previous
                                        </a>
                                    </li>
                                {% endif %}

                                {% for page_num in range(max(1, pagination.page - 2), min(pagination.pages, pagination.page + 2)) %}
                                    <li class="page-item {{ page_num == pagination.page ? 'active' : '' }}">
                                        <a class="page-link" href="?page={{ page_num }}{% for key, value in filters %}&{{ key }}={{ value }}{% endfor %}">
                                            {{ page_num }}
                                        </a>
                                    </li>
                                {% endfor %}

                                {% if pagination.page < pagination.pages %}
                                    <li class="page-item">
                                        <a class="page-link" href="?page={{ pagination.page + 1 }}{% for key, value in filters %}&{{ key }}={{ value }}{% endfor %}">
                                            Next
                                        </a>
                                    </li>
                                {% endif %}
                            </ul>
                        </nav>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Mobiles Section -->
    {% if mobiles %}
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Mobile Specifications</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Brand</th>
                                    <th>Price</th>
                                    <th>Rating</th>
                                    <th>Source</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for mobile in mobiles %}
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                {% if mobile.image_url %}
                                                    <img src="{{ mobile.image_url }}" alt="{{ mobile.name }}"
                                                         class="rounded me-3" style="width: 40px; height: 40px; object-fit: cover;">
                                                {% endif %}
                                                <div>
                                                    <h6 class="mb-0">{{ mobile.name }}</h6>
                                                    <small class="text-muted">{{ mobile.model|default('') }}</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>{{ mobile.brand|default('Unknown') }}</td>
                                        <td>
                                            {% if mobile.price %}
                                                ${{ mobile.price }}
                                            {% else %}
                                                <span class="text-muted">N/A</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if mobile.rating %}
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-star-fill me-1"></i>{{ mobile.rating }}/5
                                                </span>
                                            {% else %}
                                                <span class="text-muted">N/A</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">{{ mobile.source_name|default('Unknown') }}</span>
                                        </td>
                                        <td>
                                            <a href="/admin/scraper/mobiles/{{ mobile.id }}" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye me-1"></i>View
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<!-- Article View Modal -->
<div class="modal fade" id="articleModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Article Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="articleContent">
                <!-- Article content will be loaded here -->
            </div>
        </div>
    </div>
</div>

<script>
function viewArticle(id) {
    fetch(`/admin/scraper/articles/${id}/json`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                document.getElementById('articleContent').innerHTML = `
                    <h4>${data.article.title}</h4>
                    <p class="text-muted">Source: ${data.article.source_name} | Created: ${new Date(data.article.created_at).toLocaleString()}</p>
                    <div class="mb-3">
                        <strong>URL:</strong> <a href="${data.article.url}" target="_blank" rel="noopener noreferrer">${data.article.url}</a>
                    </div>
                    <div class="mb-3">
                        <strong>Content:</strong>
                        <div class="border rounded p-3" style="max-height: 400px; overflow-y: auto;">
                            ${data.article.content || 'No content available'}
                        </div>
                    </div>
                    ${data.article.image_url ? `<div class="mb-3"><strong>Image:</strong><br><img src="${data.article.image_url}" class="img-fluid rounded" style="max-width: 300px;"></div>` : ''}
                `;
                new bootstrap.Modal(document.getElementById('articleModal')).show();
            } else {
                alert('Failed to load article details');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Failed to load article details');
        });
}

function editArticle(id) {
    window.location.href = `/admin/scraper/articles/${id}/edit`;
}

function deleteArticle(id) {
    if (confirm('Are you sure you want to delete this article?')) {
        fetch(`/admin/scraper/articles/${id}`, {
            method: 'DELETE',
            headers: {
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Failed to delete article');
            }
        });
    }
}

function exportData() {
    const params = new URLSearchParams(window.location.search);
    window.open(`/admin/scraper/collected-data/export?${params.toString()}`, '_blank');
}

// Handle limit change
document.getElementById('limitSelect').addEventListener('change', function() {
    const url = new URL(window.location);
    url.searchParams.set('limit', this.value);
    url.searchParams.set('page', '1'); // Reset to first page
    window.location.href = url.toString();
});
</script>
{% endblock %}
