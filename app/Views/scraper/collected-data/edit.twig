{% extends 'admin/layout.twig' %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="mb-4 d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-1"><i class="bi bi-pencil-square me-2"></i>{{ pageTitle }}</h1>
                    <p class="text-muted mb-0">Article ID: {{ article.id }} • Source: {{ article.source_id }}</p>
                </div>
                <div>
                    <a href="/admin/scraper/collected-data/{{ article.id }}" class="btn btn-outline-secondary me-2">
                        <i class="bi bi-eye me-1"></i>View Article
                    </a>
                    <a href="/admin/scraper/collected-data" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>

    <form id="editArticleForm" method="POST" action="/admin/scraper/articles/{{ article.id }}/edit">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        
        <div class="row">
            <!-- Main Content -->
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-body-text me-2"></i>Article Content</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="title" class="form-label">Title *</label>
                            <input type="text" class="form-control" id="title" name="title" value="{{ article.title|default('') }}" required>
                        </div>

                        <div class="mb-3">
                            <label for="excerpt" class="form-label">Excerpt</label>
                            <textarea class="form-control" id="excerpt" name="excerpt" rows="3">{{ article.excerpt|default('') }}</textarea>
                        </div>

                        <div class="mb-3">
                            <label for="content" class="form-label">Content *</label>
                            <textarea class="form-control" id="content" name="content" rows="15" required>{{ article.content|default('') }}</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Status & Metadata -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Status & Metadata</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="status" class="form-label">Status</label>
                            <select class="form-select" id="status" name="status">
                                <option value="collected" {{ article.status == 'collected' ? 'selected' : '' }}>Collected</option>
                                <option value="processed" {{ article.status == 'processed' ? 'selected' : '' }}>Processed</option>
                                <option value="failed" {{ article.status == 'failed' ? 'selected' : '' }}>Failed</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="author" class="form-label">Author</label>
                            <input type="text" class="form-control" id="author" name="author" value="{{ article.author|default('') }}">
                        </div>

                        <div class="mb-3">
                            <label for="image_url" class="form-label">Image URL</label>
                            <input type="url" class="form-control" id="image_url" name="image_url" value="{{ article.image_url|default('') }}">
                        </div>
                    </div>
                </div>

                <!-- Categories & Tags -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-tags me-2"></i>Categories & Tags</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="categories" class="form-label">Categories (JSON array)</label>
                            <textarea class="form-control" id="categories" name="categories" rows="3" placeholder='["News", "Technology"]'>{{ article.categories_json|default('[]') }}</textarea>
                            <div class="form-text">Enter categories as JSON array</div>
                        </div>

                        <div class="mb-3">
                            <label for="tags" class="form-label">Tags (JSON array)</label>
                            <textarea class="form-control" id="tags" name="tags" rows="3" placeholder='["tag1", "tag2"]'>{{ article.tags_json|default('[]') }}</textarea>
                            <div class="form-text">Enter tags as JSON array</div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="card">
                    <div class="card-body">
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                        <button type="button" class="btn btn-outline-secondary w-100" onclick="window.history.back()">
                            <i class="bi bi-x-lg me-1"></i>Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
document.getElementById('editArticleForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    // Validate JSON fields
    try {
        if (document.getElementById('categories').value.trim()) {
            JSON.parse(document.getElementById('categories').value);
        }
        if (document.getElementById('tags').value.trim()) {
            JSON.parse(document.getElementById('tags').value);
        }
    } catch (error) {
        alert('Invalid JSON in categories or tags field');
        return;
    }
    
    // Submit via AJAX
    const formData = new FormData(this);
    fetch(this.action, {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Article updated successfully');
            window.location.href = '/admin/scraper/collected-data/' + {{ article.id }};
        } else {
            alert('Error: ' + (data.error || 'Failed to update article'));
        }
    })
    .catch(error => {
        console.error('Update error:', error);
        alert('Failed to update article');
    });
});
</script>
{% endblock %}</content>
<parameter name="filePath">app/Views/scraper/collected-data/edit.twig