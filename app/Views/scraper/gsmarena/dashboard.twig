{% extends 'admin/layout.twig' %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row mb-3">
        <div class="col">
            <h1 class="h3 mb-1"><i class="bi bi-globe2 me-2"></i>{{ pageTitle }}</h1>
            <p class="text-muted">Monitor the GSMArena scrapers and trigger manual runs.</p>
        </div>
    </div>

    <div class="row g-3">
        {% for key, entry in {'news':'News','devices':'Devices','bd':'Bangladesh'} %}
            {% set status = statuses[key] ?? {} %}
            <div class="col-md-4">
                <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-0">{{ entry }} Scraper</h5>
                                <small class="text-muted">{{ status.timestamp ?? 'Not run yet' }}</small>
                            </div>
                            <button class="btn btn-sm btn-outline-primary gsmarena-run-btn" data-type="{{ key }}">
                                Run Now
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="small text-muted">Scraped</div>
                                <div class="fw-bold">{{ status.stats.total_scraped|default(0) }}</div>
                            </div>
                            <div class="col-6">
                                <div class="small text-muted">Saved</div>
                                <div class="fw-bold">{{ status.stats.saved|default(0) }}</div>
                            </div>
                        </div>
                        <div class="row g-3 mt-3">
                            <div class="col-6">
                                <div class="small text-muted">Pages</div>
                                <div class="fw-bold">{{ status.stats.pages|default(0) }}</div>
                            </div>
                            <div class="col-6">
                                <div class="small text-muted">Errors</div>
                                <div class="fw-bold text-danger">{{ status.stats.errors|default(0) }}</div>
                            </div>
                        </div>
                        {% if status.source_id %}
                            <div class="mt-3">
                                <a href="/admin/scraper/sources/{{ status.source_id }}" class="text-decoration-none">
                                    Manage source
                                </a>
                            </div>
                        {% endif %}
                        <div class="mt-2">
                            <small class="text-muted">Last update: {{ status.timestamp|default('never') }}</small>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="row mt-4">
        <div class="col">
            <div class="alert alert-info">
                You can use the GSMArena run API to trigger scrapes via cron or the API. Use the forms below to set additional parameters.
            </div>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Max Pages</label>
            <input type="number" class="form-control" id="gsmarenaMaxPages" value="5" min="1" max="50">
        </div>
        <div class="col-md-2 align-self-end">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="gsmarenaTestMode">
                <label class="form-check-label" for="gsmarenaTestMode">
                    Test Mode
                </label>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script>
        document.querySelectorAll('.gsmarena-run-btn').forEach(function (button) {
            button.addEventListener('click', async function () {
                const type = button.dataset.type;
                const maxPages = document.getElementById('gsmarenaMaxPages').value || 5;
                const testMode = document.getElementById('gsmarenaTestMode').checked;
                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Running';

                const response = await fetch('/api/v1/scraper/gsmarena/run', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': '{{ csrf_token }}'
                    },
                    body: JSON.stringify({ type, max_pages: Number(maxPages), test: testMode })
                });

                const data = await response.json();
                button.disabled = false;
                button.textContent = 'Run Now';

                if (!data.success) {
                    alert(data.error || 'Failed to trigger scraper');
                    return;
                }

                if (data.result && data.result.status) {
                    alert('Run scheduled: ' + data.result.status.timestamp);
                }
            });
        });
    </script>
{% endblock %}
