{% extends 'admin/layout.twig' %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-1">
                        <i class="bi bi-file-earmark-text me-2"></i>{{ pageTitle }}
                    </h1>
                    <p class="text-muted mb-0">Monitor and review scraper logs</p>
                </div>
                <div>
                    <a href="/admin/scraper/dashboard" class="btn btn-outline-secondary me-2">
                        <i class="bi bi-house me-1"></i>Dashboard
                    </a>
                    <form method="POST" action="/admin/scraper/logs/clear" style="display: inline;">
                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to clear all logs? This action cannot be undone.')">
                            <i class="bi bi-trash me-1"></i>Clear All Logs
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-info bg-opacity-10 text-info rounded-circle p-3">
                                <i class="bi bi-info-circle fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="card-title mb-1">Info Logs</h6>
                            <h4 class="mb-0">{{ stats.info|default(0) }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                                <i class="bi bi-exclamation-triangle fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="card-title mb-1">Warning Logs</h6>
                            <h4 class="mb-0">{{ stats.warning|default(0) }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3">
                                <i class="bi bi-x-circle fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="card-title mb-1">Error Logs</h6>
                            <h4 class="mb-0">{{ stats.error|default(0) }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle p-3">
                                <i class="bi bi-file-earmark-text fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="card-title mb-1">Total Logs</h6>
                            <h4 class="mb-0">{{ pagination.total }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <form method="GET" class="row g-3">
                        <div class="col-md-3">
                            <label for="level_filter" class="form-label">Log Level</label>
                            <select name="level" id="level_filter" class="form-select">
                                <option value="">All Levels</option>
                                <option value="info" {{ filters.level == 'info' ? 'selected' : '' }}>Info</option>
                                <option value="warning" {{ filters.level == 'warning' ? 'selected' : '' }}>Warning</option>
                                <option value="error" {{ filters.level == 'error' ? 'selected' : '' }}>Error</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="source_filter" class="form-label">Source</label>
                            <select name="source_id" id="source_filter" class="form-select">
                                <option value="">All Sources</option>
                                {% for source in sources %}
                                    <option value="{{ source.id }}" {{ filters.source_id == source.id ? 'selected' : '' }}>
                                        {{ source.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="limit_filter" class="form-label">Per Page</label>
                            <select name="limit" id="limit_filter" class="form-select">
                                <option value="50" {{ filters.limit == 50 ? 'selected' : '' }}>50</option>
                                <option value="100" {{ filters.limit == 100 ? 'selected' : '' }}>100</option>
                                <option value="200" {{ filters.limit == 200 ? 'selected' : '' }}>200</option>
                                <option value="500" {{ filters.limit == 500 ? 'selected' : '' }}>500</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">&nbsp;</label>
                            <div>
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="bi bi-search me-1"></i>Filter
                                </button>
                                <a href="/admin/scraper/logs" class="btn btn-outline-secondary">
                                    <i class="bi bi-x-circle me-1"></i>Clear Filters
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Logs Table -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Logs ({{ pagination.total }} total)</h5>
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-info" onclick="refreshLogs()">
                            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    {% if logs %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Level</th>
                                        <th>Message</th>
                                        <th>Source</th>
                                        <th>Job Type</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for log in logs %}
                                        <tr>
                                            <td>
                                                <code>#{{ log.id }}</code>
                                            </td>
                                            <td>
                                                <span class="badge bg-
                                                    {% if log.level == 'error' %}danger
                                                    {% elseif log.level == 'warning' %}warning
                                                    {% else %}info{% endif %}">
                                                    {{ log.level|capitalize }}
                                                </span>
                                            </td>
                                            <td>
                                                <div class="text-truncate" style="max-width: 400px;" title="{{ log.message }}">
                                                    {{ log.message|truncate(60) }}
                                                </div>
                                            </td>
                                            <td>
                                                {% if log.source_name %}
                                                    <a href="/admin/scraper/sources/{{ log.source_id }}" class="text-decoration-none">
                                                        {{ log.source_name }}
                                                    </a>
                                                {% else %}
                                                    <span class="text-muted">N/A</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if log.job_type %}
                                                    <span class="badge bg-secondary">{{ log.job_type|capitalize }}</span>
                                                {% else %}
                                                    <span class="text-muted">-</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    {{ log.created_at|date('M j, H:i') }}
                                                </small>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="/admin/scraper/logs/{{ log.id }}" class="btn btn-outline-primary" title="View Details">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        {% if pagination.pages > 1 %}
                            <div class="d-flex justify-content-center mt-4">
                                <nav aria-label="Logs pagination">
                                    <ul class="pagination">
                                        {% if pagination.page > 1 %}
                                            <li class="page-item">
                                                <a class="page-link" href="?page={{ pagination.page - 1 }}{% if filters.level %}&level={{ filters.level }}{% endif %}{% if filters.source_id %}&source_id={{ filters.source_id }}{% endif %}{% if filters.limit %}&limit={{ filters.limit }}{% endif %}">
                                                    Previous
                                                </a>
                                            </li>
                                        {% endif %}

                                        {% set start_page = max(1, pagination.page - 2) %}
                                        {% set end_page = min(pagination.pages, pagination.page + 2) %}
                                        {% for page_num in start_page..end_page %}
                                            <li class="page-item {{ page_num == pagination.page ? 'active' : '' }}">
                                                <a class="page-link" href="?page={{ page_num }}{% if filters.level %}&level={{ filters.level }}{% endif %}{% if filters.source_id %}&source_id={{ filters.source_id }}{% endif %}{% if filters.limit %}&limit={{ filters.limit }}{% endif %}">
                                                    {{ page_num }}
                                                </a>
                                            </li>
                                        {% endfor %}

                                        {% if pagination.page < pagination.pages %}
                                            <li class="page-item">
                                                <a class="page-link" href="?page={{ pagination.page + 1 }}{% if filters.level %}&level={{ filters.level }}{% endif %}{% if filters.source_id %}&source_id={{ filters.source_id }}{% endif %}{% if filters.limit %}&limit={{ filters.limit }}{% endif %}">
                                                    Next
                                                </a>
                                            </li>
                                        {% endif %}
                                    </ul>
                                </nav>
                            </div>
                        {% endif %}
                    {% else %}
                        <div class="text-center py-5">
                            <i class="bi bi-file-earmark-text text-muted" style="font-size: 3rem;"></i>
                            <h5 class="mt-3 text-muted">No Logs Found</h5>
                            <p class="text-muted">There are no logs matching your current filters.</p>
                            <a href="/admin/scraper/logs" class="btn btn-primary">
                                <i class="bi bi-x-circle me-1"></i>Clear Filters
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function refreshLogs() {
    location.reload();
}

// Auto-refresh every 30 seconds
setInterval(function() {
    if (!document.hidden) {
        location.reload();
    }
}, 30000);
</script>

{% endblock %}