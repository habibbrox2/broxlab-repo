<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <title>Rich Text Editor Demo</title>
 <meta name="viewport" content="width=device-width, initial-scale=1">

<!-- Google Material Icons -->
<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">


 <!-- Optional: Editor base styles -->
 <!-- RTE Cache Busting: Forces reload when files are modified -->
 {% set rte_version = getRTEVersion() %}
 <link href="/rtceditor/editor.css?v={{ rte_version }}" rel="stylesheet">
 <script src="/rtceditor/editor.bundle.js?v={{ rte_version }}" defer></script>
 {% if rte_debug is defined and rte_debug %}
 <script src="/rtceditor/editor.debug.js?v={{ rte_version }}" defer></script>
 {% endif %}
</head>
<body>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="lg:col-span-8 mx-auto">

 <!-- Header -->
 <div class="mb-5 text-center">
 <h1>Rich Text Editor Demo</h1>
 <p class="text-slate-500">A fully custom WYSIWYG editor built with vanilla JavaScript, HTML, and CSS</p>
 </div>

 <!-- Editor Form -->
 <form id="editorForm" class="rounded-xl border border-slate-200 bg-white shadow-sm">
 <div class="p-4">

 <!-- Title Field -->
 <div class="mb-3">
 <label for="articleTitle" class="block text-sm font-medium text-slate-700 mb-1">Article Title</label>
 <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="articleTitle" name="article_title" placeholder="Enter article title">
 </div>

 <!-- Rich Text Editor -->
 <div class="mb-3">
 <label class="block text-sm font-medium text-slate-700 mb-1">Article Content</label>
 {% include 'partials/editor.twig' with {
 'editorId': 'articleEditor',
 'editorName': 'article_content',
 'editorClass': 'editor-demo',
 'initialContent': '<h1>Main Heading (H1)</h1>\n<h2>Section Heading (H2)</h2>\n<h3>Sub Heading (H3)</h3>\n\n<p>You can <strong>bold</strong>, <em>italic</em>, <u>underline</u>, <s>strike</s>, use <span style="color:red">colors</span> and <span style="background-color:yellow">backgrounds</span>.</p>\n\n<p style="text-align:center">Center aligned text</p>\n<p style="text-align:right">Right aligned text</p>\n\n<ul><li>Unordered list</li><li>Another item</li></ul>\n<ol><li>Ordered list</li><li>Second item</li></ol>\n\n<blockquote>A blockquote example</blockquote>\n\n<p>Inline code: <code>&lt;div&gt;Hello&lt;/div&gt;</code></p>\n<pre><code>console.log("Hello Editor");</code></pre>',
 'darkMode': false,
 'rtl': false
 } %}
 </div>

 <!-- Info Section -->
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200 hidden" id="contentInfo">
 <small>
 <span id="wordCount">0</span> words •
 <span id="charCount">0</span> characters
 </small>
 </div>
 </div>

 <!-- Form Actions -->
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm-footer bg-slate-100 flex flex-wrap gap-2">
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700"><i class="lucide lucide-save"></i> Save</button>
 <button type="reset" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200"><i class="lucide lucide-redo-2"></i> Reset</button>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100" id="viewHtml"><i class="lucide lucide-code"></i> View HTML</button>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-sky-600 hover:bg-sky-100" id="runSmokeTest"><i class="lucide lucide-flask-conical"></i> Smoke Test</button>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-amber-600 hover:bg-amber-100" id="runValidation"><i class="lucide lucide-check-circle"></i> Validation</button>
 </div>
 </form>

 <!-- Messages -->
 <div id="successMessage" class="p-4 rounded-lg bg-emerald-600-light text-emerald-600-dark border border-success hidden mt-3"><span id="successText"></span></div>
 <div id="errorMessage" class="p-4 rounded-lg bg-red-600-light text-red-600-dark border border-danger hidden mt-3"><span id="errorText"></span></div>

 <!-- HTML Output -->
 <div id="htmlOutput" class="rounded-xl border border-slate-200 bg-white shadow-sm mt-4 hidden">
 <div class="border-b border-slate-200 px-4 py-3 flex justify-between">
 <strong>Generated HTML</strong>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-100" id="closeHtml">Close</button>
 </div>
 <div class="p-4">
 <pre id="htmlContent" class="bg-slate-100 p-3 rounded" style="max-height:400px;overflow:auto"></pre>
 </div>
 </div>

 </div>
 </div>
</div>

<!-- Demo Logic -->
<script>
document.addEventListener('DOMContentLoaded', () => {
 const setupEditorHandlers = (editor) => {
 document.getElementById('viewHtml').onclick = () => {
 document.getElementById('htmlContent').textContent = editor.getContent();
 document.getElementById('htmlOutput').classList.remove('hidden');
 };
 document.getElementById('closeHtml').onclick = () => {
 document.getElementById('htmlOutput').classList.add('hidden');
 };
 const updateStats = () => {
 const text = editor.getContent().replace(/<[^>]*>/g, '');
 document.getElementById('wordCount').textContent = text.split(/\s+/).filter(Boolean).length;
 document.getElementById('charCount').textContent = text.length;
 document.getElementById('contentInfo').classList.remove('hidden');
 };
 document.getElementById('articleEditor').addEventListener('input', updateStats);
 updateStats();
 };
 if (window.editor_articleEditor) setupEditorHandlers(window.editor_articleEditor);
 document.addEventListener('rte:ready', e => {
 if (e.detail.editorId === 'articleEditor') setupEditorHandlers(e.detail.editor);
 });
});
</script>

<style>
.editor-demo { margin: 0; }
</style>

</body>
</html>





