{% extends 'layout.twig' %}

{% block title %}{{ job.title }} - {{ job.organization }}{% endblock %}

{% set breadcrumbs = [
  { label: 'Jobs', url: '/jobs', icon: 'briefcase' },
  { label: job.title, url: null, icon: 'file-text' }
] %}

{% block content %}
<div class="job-detail-page py-4 py-lg-5">
  <div class="container">
    <div class="row">
      <!-- Left Side - Job Details -->
      <div class="col-12 col-sm-12 col-md-12 col-lg-8 col-xl-8 col-2xl-8">
        <div class="right-side-details">
          <!-- Ad Space -->
          <ins class="adsbygoogle" data-ad-client="ca-pub-1392747164623642" data-ad-slot="4847743471" data-ad-format="horizontal" data-full-width-responsive="true" style="display: block;"></ins>
          
          <!-- Top Card -->
          <div class="top-card-wrapper py-[15px] px-[10px] md:py-[30px] md:px-[20px] block text-center md:text-left w-full m-auto sm:block md:block lg:block xl:flex 2xl:flex xl:justify-between 2xl:justify-between">
            <div class="company-info block sm:block md:block lg:block xl:flex 2xl:flex">
              <div class="card-logo mx-auto md:mr-[15px] flex-shrink-0 mb-2 sm:mb-0 md:mb-0 lg:mb-0 xl:mb-0 2xl:mb-0">
                {% if job.image_url %}
                  <img class="h-full w-full" src="{{ job.image_url }}" alt="{{ job.organization }} Logo">
                {% else %}
                  <img class="h-full w-full" src="/assets/images/default-job-logo.png" alt="{{ job.organization }} Logo">
                {% endif %}
              </div>
              <div class="card-info-wrapper lg:min-w-[450px] xl:min-w-[450px] 2xl:min-w-[450px] max-w-[450px]">
                <div class="card-info">
                  <h3 class="card-title font-extrabold">{{ job.title }}</h3>
                  <p class="card-about mb-4 text-[#060606] text-semibold text-[14px]">{{ job.organization }}</p>
                </div>
                <div class="block sm:flex md:flex lg:flex xl:flex 2xl:flex">
                  <div class="card-badge mb-2.5 min-w-[140px]">
                    <span class="badge bg-[#71bd44]">Status: Live</span>
                  </div>
                  <div class="job-no">
                    <p>ADV NO: {{ job.job_id }}</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="card-action block sm:block md:block lg:block xl:flex 2xl:flex xl:items-center 2xl:items-center xl:justify-center 2xl:justify-center">
              <div class="wish-list-btn">
                <a class="rounded-[24px] inline-block px-[28px] py-[10px] mb-[10px] bg-[#fdaa29] min-w-[170px] max-w-[170px] text-[18px] border border-[#fdaa29] text-[#fff]" href="/login?id={{ job.id }}&jobId={{ job.job_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13.337" height="12.465" viewBox="0 0 17.337 16.465" class="inline-block">
                    <path id="love-svgrepo-com" d="M18.033,4.327a5.036,5.036,0,0,0-3.9-1.828,4.983,4.983,0,0,0-3.467,1.261A4.983,4.983,0,0,0,7.2,2.5,5.036,5.036,0,0,0,3.3,4.327,6.666,6.666,0,0,0,2.183,10.1c.914,4.721,7.771,8.595,8.06,8.753a.867.867,0,0,0,.844,0c.291-.162,7.147-4.036,8.06-8.753A6.656,6.656,0,0,0,18.033,4.327ZM17.449,9.77c-.647,3.338-5.346,6.442-6.783,7.324C8.642,15.873,4.477,12.8,3.888,9.77a5.009,5.009,0,0,1,.753-4.339A3.31,3.31,0,0,1,7.2,4.233,3.027,3.027,0,0,1,9.9,5.506a.871.871,0,0,0,1.525.01,3.024,3.024,0,0,1,2.708-1.283,3.31,3.31,0,0,1,2.565,1.2A5.016,5.016,0,0,1,17.449,9.77Z" transform="translate(-1.997 -2.497)" fill="#fff"></path>
                  </svg>
                  <span>&nbsp; Wish list</span>
                </a>
              </div>
              <a class="border-none text-center min-w-[170px] rounded-[24px] px-[30px] py-[10px] bg-[#007456] text-[#fff] text-[18px] inline-block mt-2 sm:mt-0 md:mt-0 lg:mt-0 xl:mt-0 2xl:mt-0" href="{{ job.url }}" target="_blank" rel="noopener noreferrer">&nbsp; Apply now &nbsp;</a>
            </div>
          </div>
          
          <!-- Job Info -->
          <div class="job-info-wrapper bg-[#ecf1ff] block sm:block md:block lg:block xl:flex 2xl:flex xl:items-center 2xl:items-center xl:justify-between 2xl:justify-between py-3 px-2">
            <div class="application-start flex items-center mb-2 sm:mb-0 md:mb-0 lg:mb-0 xl:mb-0 2xl:mb-0">
              <div class="app-icon mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="17.306" height="19.778" viewBox="0 0 17.306 19.778">
                  <path id="Icon_awesome-calendar-alt" data-name="Icon awesome-calendar-alt" d="M0,17.924a1.855,1.855,0,0,0,1.854,1.854h13.6a1.855,1.855,0,0,0,1.854-1.854V7.417H0Zm12.361-7.571a.465.465,0,0,1,.464-.464H14.37a.465.465,0,0,1,.464.464V11.9a.465.465,0,0,1-.464.464H12.825a.465.465,0,0,1-.464-.464Zm0,4.944a.465.465,0,0,1,.464-.464H14.37a.465.465,0,0,1,.464.464v1.545a.465.465,0,0,1-.464.464H12.825a.465.465,0,0,1-.464-.464ZM7.417,10.352a.465.465,0,0,1,.464-.464H9.425a.465.465,0,0,1,.464.464V11.9a.465.465,0,0,1-.464.464H7.88a.465.465,0,0,1-.464-.464Zm0,4.944a.465.465,0,0,1,.464-.464H9.425a.465.465,0,0,1,.464.464v1.545a.465.465,0,0,1-.464.464H7.88a.465.465,0,0,1-.464-.464ZM2.472,10.352a.465.465,0,0,1,.464-.464H4.481a.465.465,0,0,1,.464.464V11.9a.465.465,0,0,1-.464.464H2.936a.465.465,0,0,1-.464-.464Zm0,4.944a.465.465,0,0,1,.464-.464H4.481a.465.465,0,0,1,.464.464v1.545a.465.465,0,0,1-.464.464H2.936a.465.465,0,0,1-.464-.464ZM15.451,2.472H13.6V.618A.62.62,0,0,0,12.979,0H11.743a.62.62,0,0,0-.618.618V2.472H6.181V.618A.62.62,0,0,0,5.563,0H4.326a.62.62,0,0,0-.618.618V2.472H1.854A1.855,1.855,0,0,0,0,4.326V6.181H17.306V4.326A1.855,1.855,0,0,0,15.451,2.472Z" fill="#007456"></path>
                </svg>
              </div>
              <div class="application-action">
                <h6>Application Start Date</h6>
                <span>{{ job.scraped_at|date('Y-m-d H:i A') }}</span>
              </div>
            </div>
            <div class="application-end flex items-center mb-2 sm:mb-0 md:mb-0 lg:mb-0 xl:mb-0 2xl:mb-0">
              <div class="app-icon mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="17.306" height="19.778" viewBox="0 0 17.306 19.778">
                  <path id="Icon_awesome-calendar-alt" data-name="Icon awesome-calendar-alt" d="M0,17.924a1.855,1.855,0,0,0,1.854,1.854h13.6a1.855,1.855,0,0,0,1.854-1.854V7.417H0Zm12.361-7.571a.465.465,0,0,1,.464-.464H14.37a.465.465,0,0,1,.464.464V11.9a.465.465,0,0,1-.464.464H12.825a.465.465,0,0,1-.464-.464Zm0,4.944a.465.465,0,0,1,.464-.464H14.37a.465.465,0,0,1,.464.464v1.545a.465.465,0,0,1-.464.464H12.825a.465.465,0,0,1-.464-.464ZM7.417,10.352a.465.465,0,0,1,.464-.464H9.425a.465.465,0,0,1,.464.464V11.9a.465.465,0,0,1-.464.464H7.88a.465.465,0,0,1-.464-.464Zm0,4.944a.465.465,0,0,1,.464-.464H9.425a.465.465,0,0,1,.464.464v1.545a.465.465,0,0,1-.464.464H7.88a.465.465,0,0,1-.464-.464ZM2.472,10.352a.465.465,0,0,1,.464-.464H4.481a.465.465,0,0,1,.464.464V11.9a.465.465,0,0,1-.464.464H2.936a.465.465,0,0,1-.464-.464Zm0,4.944a.465.465,0,0,1,.464-.464H4.481a.465.465,0,0,1,.464.464v1.545a.465.465,0,0,1-.464.464H2.936a.465.465,0,0,1-.464-.464ZM15.451,2.472H13.6V.618A.62.62,0,0,0,12.979,0H11.743a.62.62,0,0,0-.618.618V2.472H6.181V.618A.62.62,0,0,0,5.563,0H4.326a.62.62,0,0,0-.618.618V2.472H1.854A1.855,1.855,0,0,0,0,4.326V6.181H17.306V4.326A1.855,1.855,0,0,0,15.451,2.472Z" fill="#007456"></path>
                </svg>
              </div>
              <div class="application-action">
                <h6>Application End Date</h6>
                <span>{{ job.updated_at|date('Y-m-d H:i A') }}</span>
              </div>
            </div>
            <div class="app-view flex items-center">
              <div class="app-icon mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="13.5" viewBox="0 0 18 13.5">
                  <path id="Icon_open-eye" data-name="Icon open-eye" d="M9.067,0C3.375,0,0,6.75,0,6.75S3.375,13.5,9.067,13.5C14.625,13.5,18,6.75,18,6.75S14.625,0,9.067,0ZM9,2.25a4.5,4.5,0,1,1-4.5,4.5A4.5,4.5,0,0,1,9,2.25ZM9,4.5a2.25,2.25,0,1,0,2.25,2.25,2.849,2.849,0,0,0-.135-.63A1.113,1.113,0,1,1,9.63,4.635,1.97,1.97,0,0,0,9,4.5Z" fill="#007456"></path>
                </svg>
              </div>
              <div class="application-action">
                <h6>Viewed By</h6>
                <span>{{ job.openings|default(0) }}</span>
              </div>
            </div>
          </div>
          
          <!-- Job Description / Details -->
          <div class="job-description-wrapper mt-4">
            <div class="card">
              <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">Job Details</h5>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <strong>Organization:</strong>
                    <p>{{ job.organization }}</p>
                  </div>
                  <div class="col-md-6 mb-3">
                    <strong>Job Title:</strong>
                    <p>{{ job.title }}</p>
                  </div>
                  <div class="col-md-6 mb-3">
                    <strong>Job ID:</strong>
                    <p>{{ job.job_id }}</p>
                  </div>
                  <div class="col-md-6 mb-3">
                    <strong>Openings:</strong>
                    <p>{{ job.openings|default('N/A') }}</p>
                  </div>
                  <div class="col-md-6 mb-3">
                    <strong>Posted Date:</strong>
                    <p>{{ job.scraped_at|date('Y-m-d') }}</p>
                  </div>
                  <div class="col-md-6 mb-3">
                    <strong>Last Updated:</strong>
                    <p>{{ job.updated_at|date('Y-m-d') }}</p>
                  </div>
                </div>
                <div class="mt-4">
                  <a href="{{ job.url }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                    <i class="bi bi-box-arrow-up-right me-2"></i>View Original Job Posting
                  </a>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Read Before Apply -->
          <div class="read-before-apply-wrapper mt-4">
            <div class="read-before-apply">
              <div class="top-content flex justify-between items-center">
                <div class="heading">
                  <h1 class="title">Read Before Apply</h1>
                </div>
                <div class="follow-btn-wrapper">
                  <a class="text-white inline-block bg-[#fdaa29] text-[12px] mb-[20px] px-[10px] lg:px-[15px] py-[5px] rounded-[22px] mt-4" href="/login?id={{ job.id }}&jobId={{ job.job_id }}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="8.4" height="8.4" viewBox="0 0 10.4 10.4">
                      <path id="Path_2655" data-name="Path 2655" d="M436.967,329.723h-3.9v-3.9a.417.417,0,0,0-.433-.433h-.867a.417.417,0,0,0-.433.433v3.9h-3.9a.417.417,0,0,0-.433.433v.867a.418.418,0,0,0,.433.433h3.9v3.9a.418.418,0,0,0,.433.433h.867a.418.418,0,0,0,.433-.433v-3.9h3.9a.418.418,0,0,0,.433-.433v-.867a.417.417,0,0,0-.433-.433Z" transform="translate(-427 -325.39)" fill="#fff"></path>
                    </svg>
                    <span> follow </span>
                  </a>
                </div>
              </div>
              <div class="apply-info">
                <p>Teletalk Job does not charge any fee at any stage of the recruitment process. Please note that Teletalk Job is an equal employment organization. Any form of persuasion will disqualify the candidature.</p>
                <p class="deadline">Application Deadline: {{ job.updated_at|date('Y-m-d H:i A') }}</p>
                <a class="apply-online" href="{{ job.url }}" target="_blank" rel="noopener noreferrer">Apply Online</a>
              </div>
              <div class="organization-info">
                <h2>Organization Information</h2>
                <p>{{ job.organization }}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Right Side - Sidebar -->
      <div class="col-12 col-sm-12 col-md-12 col-lg-4 col-xl-4 col-2xl-4">
        <div class="sidebar">
          <!-- Ad Space -->
          <ins class="adsbygoogle" data-ad-client="ca-pub-1392747164623642" data-ad-slot="4847743471" data-ad-format="vertical" data-full-width-responsive="true" style="display: block;"></ins>
          
          <!-- Related Jobs -->
          <div class="card mt-4">
            <div class="card-header bg-primary text-white">
              <h5 class="card-title mb-0">Related Jobs</h5>
            </div>
            <div class="card-body">
              <p class="text-muted">More jobs from {{ job.organization }}</p>
              <a href="/api/teletalk/jobs?organization={{ job.organization|url_encode }}" class="btn btn-outline-primary btn-sm">
                View All Jobs
              </a>
            </div>
          </div>
          
          <!-- Quick Links -->
          <div class="card mt-4">
            <div class="card-header bg-secondary text-white">
              <h5 class="card-title mb-0">Quick Links</h5>
            </div>
            <div class="card-body">
              <ul class="list-unstyled">
                <li class="mb-2">
                  <a href="/jobs" class="text-decoration-none">
                    <i class="bi bi-list-ul me-2"></i>All Jobs
                  </a>
                </li>
                <li class="mb-2">
                  <a href="/about-us" class="text-decoration-none">
                    <i class="bi bi-info-circle me-2"></i>About Us
                  </a>
                </li>
                <li class="mb-2">
                  <a href="/contact" class="text-decoration-none">
                    <i class="bi bi-envelope me-2"></i>Contact Us
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
