{# app/Views/public/calculators.twig
 Calculator directory – mirrors the category-gallery style of Calculator.net #}
{% extends 'layout.twig' %}

{% block title %}{{ t('Online Calculators') }} | {{ app_settings.site_name|default('BroxLab') }}{% endblock %}
{% block meta_description %}{{ current_lang == 'bn' ? 'ফাইন্যান্স, গণিত, স্বাস্থ্য এবং ফিটনেসের জন্য বিনামূল্যে অনলাইন ক্যালকুলেটর। সঠিক, দ্রুত ফলাফল - কোন সাইন-আপের প্রয়োজন নেই।' : 'Free online calculators for finance, math, health & fitness. Accurate, instant results — no sign-up required.' }}{% endblock %}
{% block meta_keywords %}calculator, online calculator, finance calculator, BMI calculator, loan calculator, mortgage calculator, GPA calculator{% endblock %}

{% set breadcrumbs = [
 { label: current_lang == 'bn' ? 'ক্যালকুলেটর' : 'Calculators' }
] %}

{% block extra_styles %}
<style>
 .calc-card {
 transition: transform 0.22s ease, box-shadow 0.22s ease;
 border-radius: 14px;
 }
 .calc-card:hover {
 transform: translateY(-5px);
 box-shadow: 0 8px 32px rgba(0,0,0,0.12) !important;
 }
 .calc-card .icon-circle {
 width: 56px;
 height: 56px;
 border-radius: 50%;
 display: flex;
 align-items: center;
 justify-content: center;
 font-size: 1.5rem;
 flex-shrink: 0;
 }
 .calc-card .calc-card-title {
 font-weight: 700;
 font-size: 1.05rem;
 margin-bottom: 0.35rem;
 }
 .calc-card .calc-card-text {
 font-size: 0.89rem;
 color: #6c757d;
 }
 @media(max-width:575px){
 .cat-badge { margin-bottom: 1.2rem; }
 }
</style>
{% endblock %}

{% block content %}
<section class="py-5">

 {# ── Hero ── #}
 <div class="bg-indigo-600 text-white rounded-2xl p-5 mb-5 relative overflow-hidden">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-3 relative z-1">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 items-center">
 <div class="lg:col-span-8">
 <h1 class="text-4xl font-bold mb-3">
 <i class="lucide lucide-calculator mr-3"></i>{{ t('Online Calculators') }}
 </h1>
 <p class="lead mb-0">
 {{ t('Free, accurate calculators for everyday needs — finance, math, health & fitness.') }}
 <br>
 {{ t('Pick a category and start calculating instantly.') }}
 </p>
 </div>
 <div class="lg:col-span-4 text-center">
 <div class="text-6xl opacity-75"><i class="lucide lucide-calculator"></i></div>
 </div>
 </div>
 </div>
 <i class="lucide lucide-dot absolute top-0 right-0 text-white opacity-10" style="font-size:20rem;line-height:1"></i>
 </div>

 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

 {# ── Stats bar ── #}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3 mb-5">
 <div class="col-span-6 md:col-span-3">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 text-center py-3">
 <div class="text-xl font-bold text-indigo-600">{{ total_calculators }}</div>
 <div class="text-slate-500 text-sm" data-i18n="Calculators">{{ t('Calculators') }}</div>
 </div>
 </div>
 <div class="col-span-6 md:col-span-3">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 text-center py-3">
 <div class="text-xl font-bold text-emerald-600">{{ groups|length }}</div>
 <div class="text-slate-500 text-sm" data-i18n="Categories">{{ t('Categories') }}</div>
 </div>
 </div>
 <div class="col-span-6 md:col-span-3">
 {% set totalPosts = stats.total_posts|default(0)|int %}
 {% set totalUsers = stats.total_users|default(0)|int %}
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 text-center py-3">
 <div class="text-xl font-bold text-sky-600">{{ totalPosts }}</div>
 <div class="text-slate-500 text-sm" data-i18n="Articles">{{ t('Articles') }}</div>
 </div>
 </div>
 <div class="col-span-6 md:col-span-3">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 text-center py-3">
 <div class="text-xl font-bold text-amber-600">{{ totalUsers }}</div>
 <div class="text-slate-500 text-sm" data-i18n="Users">{{ t('Users') }}</div>
 </div>
 </div>
 </div>

 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="lg:col-span-4">
 {% set current_type = 'all' %}
 {% include 'public/partials/calculator-sidebar.twig' with {'groups': groups, 'current_type': current_type} %}
 </div>
 <div class="lg:col-span-8">
 {# ── Category Groups ── #}
 {% for groupKey, group in groups %}
 {% set catLabel = group.label %}
 {% set items = group.items %}

 <div class="mb-5">
 <div class="flex items-center mb-4">
 {% set catIcon = {  'calculator': 'lucide lucide-calculator text-indigo-600',
  'converter': 'lucide lucide-arrow-left-right text-emerald-600',
  }[groupKey] ?? 'lucide lucide-grid' %}
 <h2 class="h3 font-bold mb-0 mr-3">
 <i class="{{ catIcon }} mr-2"></i>{{ catLabel }}
 </h2>
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-600 cat-badge">{{ items|length }} {{ t('tools') }}</span>
 </div>

 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 {% for item in items %}
 {% set bgColor = {
 'calculator': 'bg-indigo-600-subtle text-indigo-600',
 'converter': 'bg-emerald-600-subtle text-emerald-600',
 }[item.category] ?? 'bg-slate-600-subtle text-slate-600' %}

 <div class="col-span-12 sm:col-span-6 lg:col-span-4 xl:col-span-3">
 <a href="/calculators/{{ item.type }}"
 class="rounded-xl border border-slate-200 bg-white shadow-sm calc-card border-0 h-full no-underline p-3 flex items-start gap-3">

 <div class="icon-circle {{ bgColor }}"><i class="{{ item.icon }}"></i></div>

 <div class="flex-grow-1">
 <div class="calc-card-title text-slate-900 mb-1">{{ item.label }}</div>
 <div class="calc-card-text">
 <i class="lucide lucide-arrow-right-circle mr-1"></i>{{ t('Start Calculating') }}
 </div>
 </div>
 </a>
 </div>
 {% endfor %}
 </div>
 </div>
 {% endfor %}

 </div>
 </div>

 {# ── Subscribe CTA ── #}
 <div class="bg-slate-100 rounded-2xl p-5 text-center mt-5">
 <h3 class="font-bold mb-2">
 <i class="lucide lucide-rss text-red-600 mr-2"></i>{{ t('Stay Updated') }}
 </h3>
 <p class="text-slate-500 mb-3">{{ t('New calculators and tools are added regularly. Subscribe to our newsletter so you don\'t miss a thing.') }}</p>
 <div class="inline-flex gap-2 flex-wrap justify-center">
 <a href="/newsletter" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-red-600 text-white hover:bg-red-700"><i class="lucide lucide-mail mr-1"></i>{{ t('Subscribe') }}</a>
 <a href="/" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100">{{ t('Back to Home') }}</a>
 </div>
 </div>

 </div>
</section>
{% endblock %}






