{# app/Views/public/calculators.twig
   Calculator directory – mirrors the category-gallery style of Calculator.net  #}
{% extends 'layout.twig' %}

{% block title %}Online Calculators | {{ app_settings.site_name|default('BroxLab') }}{% endblock %}
{% block meta_description %}Free online calculators for finance, math, health & fitness. Accurate, instant results — no sign-up required.{% endblock %}
{% block meta_keywords %}calculator, online calculator, finance calculator, BMI calculator, loan calculator, mortgage calculator, GPA calculator{% endblock %}

{% set breadcrumbs = [
  { label: 'Calculators' }
] %}

{% block extra_styles %}
<style>
  .calc-card {
    transition: transform 0.22s ease, box-shadow 0.22s ease;
    border-radius: 14px;
  }
  .calc-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.12) !important;
  }
  .calc-card .icon-circle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  .calc-card .card-title {
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }
  .calc-card .card-text {
    font-size: 0.89rem;
    color: #6c757d;
  }
  .calc-card .card-link {
    font-size: 0.87rem;
    font-weight: 600;
    color: var(--bs-primary);
    text-decoration: none;
  }
  .calc-card .card-link:hover { text-decoration: underline; }
  .cat-badge {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  @media(max-width:575px){
    .cat-badge{margin-bottom:1.2rem}
  }
</style>
{% endblock %}

{% block content %}
<section class="py-5">

  {# ── Hero ── #}
  <div class="bg-primary text-white rounded-4 p-5 mb-5 position-relative overflow-hidden">
    <div class="container py-3 position-relative z-1">
      <div class="row align-items-center g-4">
        <div class="col-lg-8">
          <h1 class="display-5 fw-bold mb-3">
            <i class="bi bi-calculator-fill me-3"></i>Online Calculators
          </h1>
          <p class="lead mb-0">
            Free, accurate calculators for everyday needs — finance, math, health &amp; fitness.
            Pick a category and start calculating instantly.
          </p>
        </div>
        <div class="col-lg-4 text-center">
          <div class="display-1 opacity-75"><i class="bi bi-calculator-fill"></i></div>
        </div>
      </div>
    </div>
    <i class="bi bi-dot position-absolute top-0 end-0 text-white opacity-10" style="font-size:20rem;line-height:1"></i>
  </div>

  <div class="container">

    {# ── Stats bar ── #}
    <div class="row g-3 mb-5">
      <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
          <div class="display-6 fw-bold text-primary">{{ total_calculators }}</div>
          <div class="text-muted small">Calculators</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
          <div class="display-6 fw-bold text-success">{{ groups|length }}</div>
          <div class="text-muted small">Categories</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        {% set totalPosts   = stats.total_posts|default(0)|int %}
        {% set totalUsers   = stats.total_users|default(0)|int %}
        <div class="card border-0 shadow-sm text-center py-3">
          <div class="display-6 fw-bold text-info">{{ totalPosts }}</div>
          <div class="text-muted small">Articles</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
          <div class="display-6 fw-bold text-warning">{{ totalUsers }}</div>
          <div class="text-muted small">Users</div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-4">
        {% set current_type = 'all' %}
        {% include 'public/partials/calculator-sidebar.twig' with {'groups': groups, 'current_type': current_type} %}
      </div>
      <div class="col-lg-8">
        {# ── Category Groups ── #}
        {% for groupKey, group in groups %}
          {% set catLabel  = group.label %}
          {% set items     = group.items %}

          <div class="mb-5">
        <div class="d-flex align-items-center mb-4">
          {% set catIcon = {
            'calculator': 'bi-calculator text-primary',
            'converter':  'bi-arrow-left-right text-success',
          }[groupKey] ?? 'bi-grid' %}
          <h2 class="h3 fw-bold mb-0 me-3">
            <i class="bi {{ catIcon }} me-2"></i>{{ catLabel }}
          </h2>
          <span class="badge bg-secondary cat-badge">{{ items|length }} tools</span>
        </div>

        <div class="row g-3">
          {% for item in items %}
            {% set bgColor = {
              'calculator': 'bg-primary-subtle text-primary',
              'converter':  'bg-success-subtle text-success',
            }[item.category] ?? 'bg-secondary-subtle text-secondary' %}

            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
              <a href="/calculators/{{ item.type }}"
                 class="card calc-card border-0 shadow-sm h-100 text-decoration-none p-3 d-flex align-items-start gap-3">

                <div class="icon-circle {{ bgColor }}"><i class="bi {{ item.icon }}"></i></div>

                <div class="flex-grow-1">
                  <div class="card-title text-dark mb-1">{{ item.label }}</div>
                  <div class="card-text">
                    <i class="bi bi-arrow-right-circle me-1"></i>Start Calculating
                  </div>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endfor %}

      </div>
    </div>

    {# ── Subscribe CTA ── #}
    <div class="bg-light rounded-4 p-5 text-center mt-5">
      <h3 class="fw-bold mb-2">
        <i class="bi bi-rss text-danger me-2"></i>Stay Updated
      </h3>
      <p class="text-muted mb-3">New calculators and tools are added regularly. Subscribe to our newsletter so you don't miss a thing.</p>
      <div class="d-inline-flex gap-2 flex-wrap justify-content-center">
        <a href="/newsletter" class="btn btn-danger"><i class="bi bi-envelope me-1"></i>Subscribe</a>
        <a href="/" class="btn btn-outline-secondary">Back to Home</a>
      </div>
    </div>

  </div>
</section>
{% endblock %}
