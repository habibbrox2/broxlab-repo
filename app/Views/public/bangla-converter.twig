{% extends 'layout.twig' %}

{% block title %}Bangla Converter - Unicode to Bijoy | {{ app_settings.site_name|default('BroxBhai') }}{% endblock %}

{% set breadcrumbs = [
  { label: 'Bangla Converter', url: '/bangla-converter', icon: 'translate' }
] %}

{% block content %}
<div class="page-bangla-converter public-static-page">
  <section class="hero-section public-page-hero public-hero--converter position-relative py-5 mb-4 overflow-hidden">
    <div class="container">
      <div class="row align-items-center g-4">
        <div class="col-lg-8">
          <h1 class="display-4 fw-bold text-theme-strong mb-3">
            <i class="bi bi-translate me-2"></i>Bangla Converter
          </h1>
          <p class="lead text-theme-strong fs-5 mb-0">
            Convert Bangla text between Unicode and Bijoy formats instantly.
          </p>
        </div>
        <div class="col-lg-4 text-center">
          <div class="public-hero-icon text-theme-strong" aria-hidden="true">
            <i class="bi bi-arrow-left-right"></i>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container py-4 py-lg-5">
    <div class="row">
      <div class="col-lg-10 mx-auto">
        <div class="card public-surface-card border-0 shadow-sm">
          <div class="card-header bg-primary text-white">
            <h2 class="h4 mb-0">
              <i class="bi bi-arrow-left-right me-2"></i>Bangla Text Converter
            </h2>
          </div>
          <div class="card-body p-4">
            <div class="row g-4">
              <!-- Unicode Input -->
              <div class="col-md-6">
                <h5 class="fw-bold mb-3 text-primary">
                  <i class="bi bi-input-cursor me-2"></i>Unicode Input
                </h5>
                <textarea
                  id="unicode-input"
                  class="form-control"
                  rows="8"
                  placeholder="আপনার ইউনিকোড বাংলা টেক্সট এখানে লিখুন... (Unicode Bangla text here...)"
                  style="font-family: 'Noto Sans Bengali', Arial, sans-serif; font-size: 16px;"
                ></textarea>
                <div class="mt-2">
                  <button id="unicode-to-bijoy" class="btn btn-primary me-2">
                    <i class="bi bi-arrow-right me-1"></i>Convert to Bijoy
                  </button>
                  <button id="clear-unicode" class="btn btn-outline-secondary">
                    <i class="bi bi-trash me-1"></i>Clear
                  </button>
                </div>
              </div>

              <!-- Bijoy Output -->
              <div class="col-md-6">
                <h5 class="fw-bold mb-3 text-success">
                  <i class="bi bi-output me-2"></i>Bijoy Output
                </h5>
                <textarea
                  id="bijoy-output"
                  class="form-control"
                  rows="8"
                  placeholder="বিজয় টেক্সট এখানে লিখুন... (Bijoy text here...)"
                  style="font-family: 'SutonnyMJ', monospace; font-size: 16px;"
                ></textarea>
                <div class="mt-2">
                  <button id="bijoy-to-unicode" class="btn btn-success me-2">
                    <i class="bi bi-arrow-left me-1"></i>Convert to Unicode
                  </button>
                  <button id="clear-bijoy" class="btn btn-outline-secondary">
                    <i class="bi bi-trash me-1"></i>Clear
                  </button>
                </div>
              </div>
            </div>

            <hr class="my-4">

            <!-- Instructions -->
            <div class="row">
              <div class="col-12">
                <h5 class="fw-bold mb-3">
                  <i class="bi bi-info-circle me-2"></i>How to Use
                </h5>
                <div class="alert alert-info">
                  <ul class="mb-0">
                    <li><strong>Unicode to Bijoy:</strong> Paste your Unicode Bangla text in the left box and click "Convert to Bijoy"</li>
                    <li><strong>Bijoy to Unicode:</strong> Paste your Bijoy text in the right box and click "Convert to Unicode"</li>
                    <li><strong>Note:</strong> Bijoy output may not display correctly without Bijoy fonts installed</li>
                    <li><strong>Tip:</strong> Use SutonnyMJ font for proper Bijoy text display</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Info Cards -->
        <div class="row mt-4 g-3">
          <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body text-center p-4">
                <div class="text-primary mb-3">
                  <i class="bi bi-globe display-4"></i>
                </div>
                <h6 class="fw-bold">Unicode (UTF-8)</h6>
                <p class="text-muted small mb-0">
                  Modern standard used on websites, mobile apps, and modern software.
                  Compatible with all platforms and devices.
                </p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body text-center p-4">
                <div class="text-success mb-3">
                  <i class="bi bi-fonts display-4"></i>
                </div>
                <h6 class="fw-bold">Bijoy (ANSI)</h6>
                <p class="text-muted small mb-0">
                  Legacy encoding used in printing presses, newspapers, and older
                  Bangladeshi software. Requires specific fonts to display correctly.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Include converter JavaScript -->
<script src="/assets/js/bangla-converter.js"></script>

<style>
/* Custom styles for converter */
#unicode-input, #bijoy-output {
  resize: vertical;
  min-height: 200px;
}

.public-hero--converter .public-hero-icon {
  font-size: 4rem;
  opacity: 0.8;
}

@media (max-width: 768px) {
  .display-4 {
    font-size: 2rem;
  }
}
</style>
{% endblock %}
