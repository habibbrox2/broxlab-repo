{% extends 'layout.twig' %}

{% block title %}All Categories | Browse Content by Categories | {{ app_settings.site_name|default('BroxBhai') }}{% endblock %}

{% set breadcrumbs = [
 { label: 'Categories', url: '/categories', icon: 'folder' }
] %}

{% set page_schema = {
 '@context': 'https://schema.org',
 '@type': 'CollectionPage',
 'name': 'All Categories',
 'description': 'Browse all categories on ' ~ (app_settings.site_name|default('BroxBhai')) ~ '. Find content organized by categories.',
 'url': current_url
} %}
{% block schema %}
 <script type="application/ld+json">
{{ page_schema|schema_json }}
 </script>
{% endblock %}

{% block content %}
<div class="public-static-page py-6 md:py-10">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <section class="hero-section mb-6 bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 text-white">
   <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
     <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-white/90">
      <i class="lucide lucide-folder h-3.5 w-3.5" aria-hidden="true"></i>
      Categories archive
     </div>
     <h1 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">Browse categories</h1>
     <p class="mt-3 max-w-2xl text-sm leading-7 text-white/85 sm:text-base">
      Search and browse the full category archive to find content grouped by topic.
     </p>
    </div>
    <div class="rounded-[1.75rem] border border-white/15 bg-white/10 px-5 py-4 text-center shadow-[0_20px_50px_rgba(15,23,42,0.22)] backdrop-blur-xl">
     <div class="text-xs font-semibold uppercase tracking-[0.2em] text-white/75">Total</div>
     <div class="mt-2 text-3xl font-bold">{{ total_categories|default(categories|length) }}</div>
     <div class="mt-1 text-sm text-white/75">categories available</div>
    </div>
   </div>
  </section>

  <div class="listing-header">
   <h2><i class="lucide lucide-folder-open text-indigo-600" aria-hidden="true"></i>Category archive</h2>
   <p>Search, sort, and explore every category in one place.</p>
  </div>

  <!-- Filter Toolbar (glassmorphism) -->
  <form method="get" class="rounded-2xl border border-slate-200/60 bg-white/85 shadow-lg backdrop-blur-xl p-5 mb-6 dark:border-slate-700/60 dark:bg-slate-900/85">
   <div class="flex flex-wrap items-center gap-3">
    <!-- Search -->
    <div class="relative flex-1 min-w-[200px]">
     <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none dark:text-slate-500" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
     </svg>
     <input type="search" name="search" value="{{ search|default('') }}" placeholder="Search categories..." class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-3 text-sm text-slate-900 placeholder-slate-400 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:placeholder-slate-500 dark:focus:border-indigo-400">
    </div>
    <!-- Per Page -->
    <select name="per_page" onchange="this.form.submit()" class="rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/15 appearance-none cursor-pointer dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" aria-label="Items per page">
     {% for opt in [6, 12, 24, 48] %}
     <option value="{{ opt }}" {% if per_page == opt %}selected{% endif %}>{{ opt }}</option>
     {% endfor %}
    </select>
    <!-- Sort -->
    <select name="sort" onchange="this.form.submit()" class="rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/15 appearance-none cursor-pointer dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" aria-label="Sort categories">
     <option value="name" {% if sort == 'name' %}selected{% endif %}>Name (A-Z)</option>
     <option value="latest" {% if sort == 'latest' %}selected{% endif %}>Newest</option>
     <option value="count" {% if sort == 'count' %}selected{% endif %}>Most Items</option>
    </select>
   </div>
  </form>

  {% if categories|length > 0 %}
  <div class="listing-grid mb-5">
   {% for category in categories %}
   {% include 'partials/content-card.twig' with { item: {
    title: category.name,
    subtitle: category.description|default('Explore items in this category'),
    id: category.id|default(category.slug),
    slug: category.slug,
    url: category.slug,
    type: 'category',
    created_at: category.created_at|default('now'),
    count: category.count|default(0),
    categories: [],
    tags: []
   }, index: loop.index } %}
   {% endfor %}
  </div>

  {% if total_pages > 1 %}
  <div class="pagination-container">
   <div class="pagination">
    {% if current_page > 1 %}
    <a class="pagination-link" href="?page={{ current_page - 1 }}&per_page={{ per_page|default(12) }}&search={{ search|default('') }}&sort={{ sort|default('name') }}" aria-label="Previous page">
     <i class="lucide lucide-chevron-left" aria-hidden="true"></i>
    </a>
    {% else %}
    <span class="pagination-link disabled" aria-hidden="true">
     <i class="lucide lucide-chevron-left" aria-hidden="true"></i>
    </span>
    {% endif %}

    {% set startPage = current_page > 2 ? current_page - 2 : 1 %}
    {% set endPage = current_page + 2 > total_pages ? total_pages : current_page + 2 %}

    {% if startPage > 1 %}
    <a class="pagination-link" href="?page=1&per_page={{ per_page|default(12) }}&search={{ search|default('') }}&sort={{ sort|default('name') }}">1</a>
    {% if startPage > 2 %}
    <span class="pagination-link disabled" aria-hidden="true">...</span>
    {% endif %}
    {% endif %}

    {% for i in range(startPage, endPage) %}
    {% if i == current_page %}
    <span class="pagination-link active" aria-current="page">{{ i }}</span>
    {% else %}
    <a class="pagination-link" href="?page={{ i }}&per_page={{ per_page|default(12) }}&search={{ search|default('') }}&sort={{ sort|default('name') }}">{{ i }}</a>
    {% endif %}
    {% endfor %}

    {% if endPage < total_pages %}
    {% if endPage < total_pages - 1 %}
    <span class="pagination-link disabled" aria-hidden="true">...</span>
    {% endif %}
    <a class="pagination-link" href="?page={{ total_pages }}&per_page={{ per_page|default(12) }}&search={{ search|default('') }}&sort={{ sort|default('name') }}">{{ total_pages }}</a>
    {% endif %}

    {% if current_page < total_pages %}
    <a class="pagination-link" href="?page={{ current_page + 1 }}&per_page={{ per_page|default(12) }}&search={{ search|default('') }}&sort={{ sort|default('name') }}" aria-label="Next page">
     <i class="lucide lucide-chevron-right" aria-hidden="true"></i>
    </a>
    {% else %}
    <span class="pagination-link disabled" aria-hidden="true">
     <i class="lucide lucide-chevron-right" aria-hidden="true"></i>
    </span>
    {% endif %}
   </div>
  </div>
  {% endif %}
  {% else %}
  <div class="surface-card text-center">
   <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-slate-100 text-slate-400">
    <i class="lucide lucide-inbox h-7 w-7" aria-hidden="true"></i>
   </div>
   <h3 class="text-xl font-bold text-slate-900">No categories found</h3>
   <p class="mt-2 text-sm text-slate-600">
    {% if search %}
    No categories match your search criteria.
    {% else %}
    There are currently no categories available.
    {% endif %}
   </p>
  </div>
  {% endif %}
 </div>
</div>
{% endblock %}

