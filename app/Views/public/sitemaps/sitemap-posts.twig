<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for item in items %}
  <url>
    <loc>{{ (base_url()|trim('/', 'right')) }}/posts/{{ item.id }}/{{ (item.slug|default(item.url|default(item.id)))|url_encode }}</loc>
    <lastmod>{{ item.updated_at|date('Y-m-d') }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  {% endfor %}
</urlset>
