{% extends 'layout.twig' %}

{% block title %}FAQ - {{ t('Frequently Asked Questions') }} | {{ app_settings.site_name|default('BroxBhai') }}{% endblock %}

{% set breadcrumbs = [
 { label: 'FAQ', url: '/faq', icon: 'question' }
] %}

{% set faq_items = [
 {
  '@type': 'Question',
  'name': 'What is BroxBhai?',
  'acceptedAnswer': {
   '@type': 'Answer',
   'text': 'BroxBhai is a comprehensive platform for mobile device reviews, tech news, and gadget discussions with detailed reviews, comparisons, and guides.'
  }
 },
 {
  '@type': 'Question',
  'name': 'How can I submit a review?',
  'acceptedAnswer': {
   '@type': 'Answer',
   'text': 'Create an account, go to your dashboard, click Submit Review, and include detailed information with images if possible.'
  }
 },
 {
  '@type': 'Question',
  'name': 'How do I report inappropriate content?',
  'acceptedAnswer': {
   '@type': 'Answer',
   'text': 'Use the report button on the content or contact us directly with details about the issue.'
  }
 },
 {
  '@type': 'Question',
  'name': 'Can I edit my profile?',
  'acceptedAnswer': {
   '@type': 'Answer',
   'text': 'Yes. After login, open your profile settings to update personal information and profile picture.'
  }
 },
 {
  '@type': 'Question',
  'name': 'How often is content updated?',
  'acceptedAnswer': {
   '@type': 'Answer',
   'text': 'We publish news, reviews, and guides regularly. Subscribe to our newsletter for the latest updates.'
  }
 },
 {
  '@type': 'Question',
  'name': 'Is BroxBhai free to use?',
  'acceptedAnswer': {
   '@type': 'Answer',
   'text': 'Yes. Most content on BroxBhai is available free of charge, though some services may require registration or premium access.'
  }
 }
] %}

{% set page_schema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 'mainEntity': faq_items
} %}

{% block schema %}
 <script type="application/ld+json">
{{ page_schema|schema_json }}
 </script>
{% endblock %}

{% block content %}
<div class="public-static-page py-6 md:py-10">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <section class="hero-section mb-6 bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 text-white">
   <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
     <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-white/90">
      <i class="lucide lucide-help-circle h-3.5 w-3.5" aria-hidden="true"></i>
      <span data-i18n="Help center">{{ t('Help center') }}</span>
     </div>
     <h1 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl" data-i18n="Frequently Asked Questions">{{ t('Frequently Asked Questions') }}</h1>
     <p class="mt-3 max-w-2xl text-sm leading-7 text-white/85 sm:text-base" data-i18n="Find answers to common questions about the platform, accounts, publishing, and updates.">
      {{ t('Find answers to common questions about the platform, accounts, publishing, and updates.') }}
     </p>
    </div>
    <div class="public-hero-icon" aria-hidden="true">
     <i class="lucide lucide-help-circle"></i>
    </div>
   </div>
  </section>

  <div class="listing-header">
   <h2><i class="lucide lucide-message-circle-question text-indigo-600" aria-hidden="true"></i><span data-i18n="FAQ">{{ t('FAQ') }}</span></h2>
   <p data-i18n="Quick answers to the most common questions.">{{ t('Quick answers to the most common questions.') }}</p>
  </div>

  <div class="grid gap-6 lg:grid-cols-12">
   <div class="lg:col-span-8">
    <div id="faqAccordion" class="space-y-3">
     {% for item in [
      { title: 'What is BroxBhai?', body: 'BroxBhai is a platform for mobile reviews, tech news, and gadget discussions.' },
      { title: 'How can I submit a review?', body: 'Create an account, open your dashboard, and submit a review with detailed information and images.' },
      { title: 'How do I report inappropriate content?', body: 'Use the report button on the content or <a href="/contact" class="text-indigo-600 hover:text-indigo-700 underline">contact us</a> directly.' },
      { title: 'Can I edit my profile?', body: 'Yes. After login, open your profile settings to update personal information and profile picture.' },
      { title: 'How often is content updated?', body: 'We publish news, reviews, and guides regularly. Subscribe to our newsletter for the latest updates.' },
      { title: 'Is BroxBhai free to use?', body: 'Yes. Most content is free, though some services may require registration or premium access.' },
      { title: 'How can I delete my account?', body: 'Request account deletion from account settings. This action cannot be undone.' },
      { title: 'Do you accept guest posts?', body: 'Yes. We welcome guest posts from experienced reviewers and tech writers. Please <a href="/contact" class="text-indigo-600 hover:text-indigo-700 underline">contact us</a> with your proposal.' }
     ] %}
     {% set faq_id = 'faq' ~ loop.index %}
     <article class="faq-card overflow-hidden">
      <button class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left text-sm font-semibold text-slate-900 transition hover:bg-slate-50" type="button" data-brox-toggle="collapse" data-brox-target="#{{ faq_id }}" aria-expanded="{{ loop.first ? 'true' : 'false' }}" aria-controls="{{ faq_id }}">
       <span data-i18n="{{ item.title }}">{{ t(item.title) }}</span>
       <i class="lucide lucide-chevron-down h-4 w-4 text-slate-400 transition-transform" aria-hidden="true"></i>
      </button>
      <div id="{{ faq_id }}" class="collapse {% if loop.first %}show{% endif %}" data-brox-parent="#faqAccordion">
       <div class="px-5 py-4 text-sm leading-7 text-slate-600">
        {{ item.body|raw }}
       </div>
      </div>
     </article>
     {% endfor %}
    </div>
   </div>

   <aside class="lg:col-span-4">
    <div class="support-card">
     <h3 class="text-lg font-bold text-slate-900" data-i18n="Need more help?">{{ t('Need more help?') }}</h3>
     <p class="mt-2 text-sm leading-7 text-slate-600" data-i18n="If you still need assistance, send us a message and we will get back to you as soon as we can.">
      {{ t('If you still need assistance, send us a message and we will get back to you as soon as we can.') }}
     </p>
     <a href="/contact" class="mt-4 inline-flex items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">
      <i class="lucide lucide-send h-4 w-4" aria-hidden="true"></i>
      <span data-i18n="Contact us">{{ t('Contact us') }}</span>
     </a>
    </div>
   </aside>
  </div>
 </div>
</div>
{% endblock %}
