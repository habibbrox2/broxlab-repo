{% extends 'layout.twig' %}

{% block title %}Advertise With {{ app_settings.site_name|default('BroxBhai') }} - Reach Tech Enthusiasts{% endblock %}

{% set breadcrumbs = [
 { label: 'Advertise', url: '/advertise', icon: 'megaphone' }
] %}

{% block content %}
<div class="public-static-page py-6 md:py-10">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <section class="hero-section mb-6 bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 text-white">
   <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
     <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-white/90">
      <i class="lucide lucide-megaphone h-3.5 w-3.5" aria-hidden="true"></i>
      Advertising
     </div>
     <h1 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">Advertise with us</h1>
     <p class="mt-3 max-w-2xl text-sm leading-7 text-white/85 sm:text-base">
      Reach tech enthusiasts, mobile shoppers, and gadget lovers on {{ app_settings.site_name|default('BroxBhai') }}.
     </p>
     <a href="#inquiry-form" class="mt-5 inline-flex items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">
      <i class="lucide lucide-send h-4 w-4" aria-hidden="true"></i>
      Get Started
     </a>
    </div>
    <div class="public-hero-icon" aria-hidden="true">
     <i class="lucide lucide-trending-up"></i>
    </div>
   </div>
  </section>

  <div class="grid gap-6 lg:grid-cols-12">
   <section class="surface-card lg:col-span-7">
    <h2 class="text-2xl font-bold text-slate-900">Why advertise with {{ app_settings.site_name|default('BroxBhai') }}?</h2>
    <p class="mt-3 text-sm leading-7 text-slate-600">
     Connect with readers who actively compare devices, follow tech updates, and explore digital services.
    </p>

    <div class="mt-6 grid gap-3">
     {% for point in [
      { icon: 'users', title: 'Large Audience', text: 'Connect with ' ~ stats.total_users ~ ' active members.' },
      { icon: 'messages-square', title: 'Engaged Community', text: 'Reach readers participating in comments and discussions.' },
      { icon: 'newspaper', title: 'Quality Content', text: stats.total_posts ~ ' published posts and reviews.' },
      { icon: 'smartphone', title: 'Mobile Focused', text: 'Ideal for tech, mobile, telecom, and digital service campaigns.' },
      { icon: 'layout-dashboard', title: 'Flexible Options', text: 'Banner ads, sponsored articles, newsletter sponsorships, and more.' }
     ] %}
     <div class="flex items-start gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4">
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-indigo-600 shadow-sm">
       <i class="lucide lucide-{{ point.icon }} h-4 w-4" aria-hidden="true"></i>
      </div>
      <div>
       <h3 class="text-sm font-bold text-slate-900">{{ point.title }}</h3>
       <p class="mt-1 text-sm text-slate-600">{{ point.text }}</p>
      </div>
     </div>
     {% endfor %}
    </div>
   </section>

   <aside class="lg:col-span-5">
    <div class="stats-cards">
     <div>
      <h3 class="counter mb-1 text-3xl font-bold text-slate-900" data-target="{{ stats.total_posts }}">0</h3>
      <p class="text-sm text-slate-500">Articles</p>
     </div>
     <div>
      <h3 class="counter mb-1 text-3xl font-bold text-slate-900" data-target="{{ stats.total_users }}">0</h3>
      <p class="text-sm text-slate-500">Members</p>
     </div>
     <div>
      <h3 class="counter mb-1 text-3xl font-bold text-slate-900" data-target="{{ stats.total_mobiles }}">0</h3>
      <p class="text-sm text-slate-500">Reviews</p>
     </div>
     <div>
      <h3 class="counter mb-1 text-3xl font-bold text-slate-900" data-target="{{ stats.total_comments }}">0</h3>
      <p class="text-sm text-slate-500">Discussions</p>
     </div>
    </div>
   </aside>
  </div>

  <section id="inquiry-form" class="mt-6">
   <div class="mx-auto max-w-3xl">
    <div class="surface-card">
     <h2 class="text-2xl font-bold text-slate-900">Advertising inquiry</h2>
     <p class="mt-2 text-sm text-slate-600">Tell us about your campaign goals and we will respond with suitable options.</p>

     {% if success %}
     <div class="mt-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700" role="alert">
      {{ success }}
     </div>
     {% endif %}

     {% if errors %}
     <div class="mt-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
      <ul class="list-disc space-y-1 pl-5">
       {% for error in errors %}
       <li>{{ error }}</li>
       {% endfor %}
      </ul>
     </div>
     {% endif %}

     <form method="POST" action="/advertise" class="mt-6">
      <div class="grid gap-4 sm:grid-cols-2">
       <div>
        <label for="name" class="mb-2 block text-sm font-semibold text-slate-700">Your Name *</label>
        <input type="text" id="name" name="name" value="{{ old.name ?? '' }}" required>
       </div>
       <div>
        <label for="email" class="mb-2 block text-sm font-semibold text-slate-700">Email Address *</label>
        <input type="email" id="email" name="email" value="{{ old.email ?? '' }}" required>
       </div>
      </div>

      <div>
       <label for="company" class="mb-2 block text-sm font-semibold text-slate-700">Company Name *</label>
       <input type="text" id="company" name="company" value="{{ old.company ?? '' }}" required>
      </div>

      <div>
       <label for="budget" class="mb-2 block text-sm font-semibold text-slate-700">Budget Range *</label>
       <select id="budget" name="budget" required>
        <option value="">Select Budget</option>
        <option value="under-5k" {% if old.budget == 'under-5k' %}selected{% endif %}>Under 5,000 BDT</option>
        <option value="5k-10k" {% if old.budget == '5k-10k' %}selected{% endif %}>5,000 - 10,000 BDT</option>
        <option value="10k-25k" {% if old.budget == '10k-25k' %}selected{% endif %}>10,000 - 25,000 BDT</option>
        <option value="25k-50k" {% if old.budget == '25k-50k' %}selected{% endif %}>25,000 - 50,000 BDT</option>
        <option value="50k+" {% if old.budget == '50k+' %}selected{% endif %}>50,000+ BDT</option>
       </select>
      </div>

      <div>
       <label for="message" class="mb-2 block text-sm font-semibold text-slate-700">Your Message *</label>
       <textarea id="message" name="message" rows="6" required>{{ old.message ?? '' }}</textarea>
       <p class="mt-2 text-xs text-slate-500">Tell us about your advertising goals and interests.</p>
      </div>

      <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">
       <i class="lucide lucide-send h-4 w-4" aria-hidden="true"></i>
       Submit Inquiry
      </button>
     </form>
    </div>
   </div>
  </section>

  <div class="mt-6 grid gap-4 md:grid-cols-2">
   <div class="info-card">
    <h3 class="text-lg font-bold text-slate-900"><i class="lucide lucide-columns mr-2 text-indigo-600" aria-hidden="true"></i>Available Ad Spaces</h3>
    <ul class="mt-4 space-y-2 text-sm text-slate-600">
     <li>Homepage Banner</li>
     <li>Sidebar Advertisement</li>
     <li>Sponsored Articles</li>
     <li>Category Page Banners</li>
     <li>Newsletter Sponsorship</li>
    </ul>
   </div>

   <div class="support-card">
    <h3 class="text-lg font-bold text-slate-900"><i class="lucide lucide-help-circle mr-2 text-indigo-600" aria-hidden="true"></i>Campaign Support</h3>
    <p class="mt-4 text-sm leading-7 text-slate-600">
     Category, tag, and audience-focused placements are available. Reporting and campaign guidance can be arranged for sponsored packages.
    </p>
   </div>
  </div>
 </div>
</div>

<script>
function animateCounter(element, target, duration = 2000) {
 const increment = target / (duration / 16);
 let current = 0;
 const timer = setInterval(() => {
  current += increment;
  if (current >= target) {
   element.textContent = target.toLocaleString();
   clearInterval(timer);
  } else {
   element.textContent = Math.floor(current).toLocaleString();
  }
 }, 16);
}

document.querySelectorAll('.counter').forEach((counter) => {
 const observer = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
   if (entry.isIntersecting && !entry.target.dataset.animated) {
    const target = parseInt(entry.target.dataset.target, 10);
    animateCounter(entry.target, Number.isNaN(target) ? 0 : target);
    entry.target.dataset.animated = 'true';
    observer.unobserve(entry.target);
   }
  });
 });
 observer.observe(counter);
});
</script>
{% endblock %}

