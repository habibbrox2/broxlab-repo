{% extends 'layout.twig' %}

{% block title %}Government Jobs - Teletalk{% endblock %}

{% set breadcrumbs = [
 { label: 'Jobs', url: '/jobs', icon: 'briefcase' }
] %}

{% block content %}
<div class="jobs-page public-static-page py-6 md:py-10">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <section class="hero-section mb-6 overflow-hidden bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 text-white">
   <div class="flex items-start justify-between gap-6">
    <div class="max-w-3xl">
     <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-indigo-100">
      <i class="lucide lucide-briefcase h-3.5 w-3.5" aria-hidden="true"></i>
      Live Openings
     </div>
     <h1 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">Government Jobs - Teletalk</h1>
     <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-300 sm:text-base">
      Browse the latest government job opportunities from Teletalk with fast filtering and a cleaner reading experience.
     </p>
    </div>
    <div class="hidden rounded-[1.75rem] border border-white/10 bg-white/10 p-5 text-right shadow-[0_20px_50px_rgba(15,23,42,0.25)] backdrop-blur-xl md:block">
     <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-300">Openings</div>
     <div class="mt-2 text-3xl font-bold text-white">{{ total|default(0) }}</div>
     <div class="mt-1 text-sm text-slate-300">{{ jobs|length }} shown on this page</div>
    </div>
   </div>
  </section>

  <section class="search-panel mb-6">
   <form method="GET" action="/jobs" class="grid grid-cols-1 gap-4 lg:grid-cols-12">
    <div class="lg:col-span-6">
     <label for="search" class="mb-2 block text-sm font-semibold text-slate-700">Search Jobs</label>
     <input type="text" id="search" name="search" placeholder="Search by title or organization..." value="{{ search|e }}">
    </div>
    <div class="lg:col-span-4">
     <label for="organization" class="mb-2 block text-sm font-semibold text-slate-700">Organization</label>
     <select id="organization" name="organization">
      <option value="">All Organizations</option>
      {% for org in organizations %}
      <option value="{{ org|e }}" {% if selected_organization == org %}selected{% endif %}>{{ org|e }}</option>
      {% endfor %}
     </select>
    </div>
    <div class="lg:col-span-2 lg:self-end">
     <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">
      <i class="lucide lucide-search" aria-hidden="true"></i>
      Search
     </button>
    </div>
   </form>
  </section>

  <div class="mb-4 flex flex-wrap items-center justify-between gap-3 text-sm text-slate-500">
   <p class="mb-0">
    Showing <span class="font-semibold text-slate-900">{{ jobs|length }}</span> of <span class="font-semibold text-slate-900">{{ total }}</span> jobs
    {% if search %}<span class="ml-1">for â€œ{{ search|e }}â€</span>{% endif %}
    {% if selected_organization %}<span class="ml-1">in {{ selected_organization|e }}</span>{% endif %}
   </p>
   {% if search or selected_organization %}
   <a href="/jobs" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2 font-semibold text-slate-700 shadow-sm hover:bg-slate-50">
    <i class="lucide lucide-rotate-ccw h-4 w-4" aria-hidden="true"></i>
    Clear filters
   </a>
   {% endif %}
  </div>

  {% if jobs|length > 0 %}
  <div class="listing-grid">
   {% for job in jobs %}
   <article class="group overflow-hidden rounded-[1.75rem] border border-slate-200/80 bg-white/90 shadow-[0_18px_50px_rgba(15,23,42,0.08)] backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:shadow-[0_28px_70px_rgba(15,23,42,0.14)]">
    <div class="flex items-start gap-4 p-5">
     {% if job.image_url %}
     <img src="{{ job.image_url }}" alt="{{ job.organization }}" class="h-14 w-14 rounded-2xl border border-slate-200 bg-slate-50 object-contain p-2">
     {% else %}
     <div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-slate-200 bg-slate-50 text-slate-400">
      <i class="lucide lucide-building-2 h-5 w-5" aria-hidden="true"></i>
     </div>
     {% endif %}

     <div class="min-w-0 flex-1">
      <span class="mb-2 inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-emerald-700">Live</span>
      <h2 class="line-clamp-2 text-base font-bold tracking-tight text-slate-900 group-hover:text-indigo-600">
       <a href="/jobs/{{ job.id }}" class="no-underline text-inherit hover:text-indigo-600">{{ job.title|truncate(50) }}</a>
      </h2>
      <p class="mt-1 text-sm text-slate-500">{{ job.organization }}</p>
     </div>
    </div>

    <div class="px-5 pb-5">
     <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4 text-sm">
      <span class="inline-flex items-center gap-2 text-slate-500">
       <i class="lucide lucide-clock-3 h-4 w-4" aria-hidden="true"></i>
       {{ job.scraped_at|time_ago }}
      </span>
      <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">ID: {{ job.job_id }}</span>
     </div>

     <div class="mt-4">
      <a href="/jobs/{{ job.id }}" class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-slate-950 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-600">
       View Details
       <i class="lucide lucide-arrow-right h-4 w-4" aria-hidden="true"></i>
      </a>
     </div>
    </div>
   </article>
   {% endfor %}
  </div>

  {% if total_pages > 1 %}
  <nav aria-label="Jobs pagination" class="mt-8">
   <ul class="pagination">
    {% if page > 1 %}
    <li class="page-item">
     <a class="page-link" href="?page={{ page - 1 }}{% if search %}&search={{ search|url_encode }}{% endif %}{% if selected_organization %}&organization={{ selected_organization|url_encode }}{% endif %}" aria-label="Previous">
      <i class="lucide lucide-chevron-left" aria-hidden="true"></i>
     </a>
    </li>
    {% endif %}

    {% set start_page = max(2, page - 2) %}
    {% set end_page = min(total_pages - 1, page + 2) %}
    <li class="page-item {% if page == 1 %}active{% endif %}">
     {% if page == 1 %}
     <span class="page-link">1</span>
     {% else %}
     <a class="page-link" href="?page=1{% if search %}&search={{ search|url_encode }}{% endif %}{% if selected_organization %}&organization={{ selected_organization|url_encode }}{% endif %}">1</a>
     {% endif %}
    </li>
    {% if start_page > 2 %}
    <li class="page-item disabled">
     <span class="page-link">...</span>
    </li>
    {% endif %}
    {% if start_page <= end_page %}
    {% for i in range(start_page, end_page) %}
    <li class="page-item {% if i == page %}active{% endif %}">
     {% if i == page %}
     <span class="page-link">{{ i }}</span>
     {% else %}
     <a class="page-link" href="?page={{ i }}{% if search %}&search={{ search|url_encode }}{% endif %}{% if selected_organization %}&organization={{ selected_organization|url_encode }}{% endif %}">{{ i }}</a>
     {% endif %}
    </li>
    {% endfor %}
    {% endif %}
    {% if end_page < total_pages - 1 %}
    <li class="page-item disabled">
     <span class="page-link">...</span>
    </li>
    {% endif %}
    <li class="page-item {% if page == total_pages %}active{% endif %}">
     {% if page == total_pages %}
     <span class="page-link">{{ total_pages }}</span>
     {% else %}
     <a class="page-link" href="?page={{ total_pages }}{% if search %}&search={{ search|url_encode }}{% endif %}{% if selected_organization %}&organization={{ selected_organization|url_encode }}{% endif %}">{{ total_pages }}</a>
     {% endif %}
    </li>

    {% if page < total_pages %}
    <li class="page-item">
     <a class="page-link" href="?page={{ page + 1 }}{% if search %}&search={{ search|url_encode }}{% endif %}{% if selected_organization %}&organization={{ selected_organization|url_encode }}{% endif %}" aria-label="Next">
      <i class="lucide lucide-chevron-right" aria-hidden="true"></i>
     </a>
    </li>
    {% endif %}
   </ul>
  </nav>
  {% endif %}
  {% else %}
  <div class="surface-card text-center">
   <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-slate-100 text-slate-400">
    <i class="lucide lucide-inbox h-7 w-7" aria-hidden="true"></i>
   </div>
   <h2 class="text-xl font-bold text-slate-900">No jobs found</h2>
   <p class="mt-2 text-sm text-slate-600">
    {% if search or selected_organization %}
    Clear the filters to see the full jobs list.
    {% else %}
    No jobs are available right now.
    {% endif %}
   </p>
   {% if search or selected_organization %}
   <div class="mt-4">
    <a href="/jobs" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700">
     Reset filters
    </a>
   </div>
   {% endif %}
  </div>
  {% endif %}
 </div>
</div>
{% endblock %}

