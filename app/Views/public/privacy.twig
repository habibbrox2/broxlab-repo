{% extends 'layout.twig' %}

{% block title %}Privacy Policy - {{ app_settings.site_name|default('BroxBhai') }}{% endblock %}

{% set breadcrumbs = [
 { label: 'Privacy Policy', url: '/privacy', icon: 'lock' }
] %}

{% block content %}
<div class="public-static-page py-6 md:py-10">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <section class="hero-section mb-6 bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 text-white">
   <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
     <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-white/90">
      <i class="lucide lucide-shield h-3.5 w-3.5" aria-hidden="true"></i>
      Data protection
     </div>
     <h1 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">Privacy Policy</h1>
     <p class="mt-3 max-w-2xl text-sm leading-7 text-white/85 sm:text-base">
      Learn what information we collect, how we use it, and how we protect your privacy.
     </p>
    </div>
    <div class="public-hero-icon" aria-hidden="true">
     <i class="lucide lucide-shield"></i>
    </div>
   </div>
  </section>

  <div class="mx-auto max-w-4xl">
   <div class="mb-6 rounded-2xl border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-700" role="alert">
    <i class="lucide lucide-info mr-2" aria-hidden="true"></i>
    <strong>Last Updated:</strong> {{ 'now'|date('F d, Y') }}
   </div>

   <article class="prose prose-sm">
    <h2>Introduction</h2>
    <p>
     {{ app_settings.site_name|default('BroxBhai') }} ("we", "us", or "our") operates this website.
     This page explains how we collect, use, and protect your personal data.
    </p>

    <h2>Information Collection and Use</h2>
    <p>We collect certain types of information to provide and improve our services.</p>

    <h3>Types of Data Collected</h3>
    <ul>
     <li><strong>Personal Data:</strong> Name, email address, and phone number.</li>
     <li><strong>Usage Data:</strong> Browser type, IP address, pages visited, and time spent.</li>
     <li><strong>Cookies:</strong> Cookies and similar technologies to improve user experience.</li>
    </ul>

    <h2>Use of Data</h2>
    <p>We use collected data for the following purposes:</p>
    <ul>
     <li>To provide and maintain our service.</li>
     <li>To notify you about important updates.</li>
     <li>To provide customer support.</li>
     <li>To analyze usage and improve platform quality.</li>
     <li>To detect, prevent, and resolve technical issues.</li>
    </ul>

    <h2>Security of Data</h2>
    <p>
     We apply industry-standard safeguards, but no internet transmission or storage system is fully secure.
    </p>

    <h2>Changes to This Privacy Policy</h2>
    <p>
     We may update this policy periodically. Updates will be posted on this page with a revised date.
    </p>

    <h2>Contact Us</h2>
    <p>
     If you have any questions about this Privacy Policy, please <a href="/contact">contact us</a>.
    </p>
   </article>
  </div>
 </div>
</div>
{% endblock %}

