{% extends 'layout.twig' %}

{% block title %}Support Us - Help Keep {{ app_settings.site_name|default('BroxBhai') }} Running{% endblock %}

{% set breadcrumbs = [
 { label: 'Support Us', url: '/donate', icon: 'heart-pulse' }
] %}

{% block content %}
<div class="public-static-page py-6 md:py-10">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <section class="hero-section mb-6 bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-900 text-white">
   <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
     <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-white/90">
      <i class="lucide lucide-heart h-3.5 w-3.5" aria-hidden="true"></i>
      Support our mission
     </div>
     <h1 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">Help keep {{ app_settings.site_name|default('BroxBhai') }} running</h1>
     <p class="mt-3 max-w-2xl text-sm leading-7 text-white/85 sm:text-base">
      Your contribution keeps the platform free, accurate, and available for everyone.
     </p>
     <a href="#donate-form" class="mt-5 inline-flex items-center justify-center gap-2 rounded-2xl bg-amber-400 px-5 py-3 text-sm font-semibold text-slate-950 shadow-[0_14px_35px_rgba(251,191,36,0.25)] transition hover:-translate-y-0.5 hover:bg-amber-300">
      <i class="lucide lucide-gift h-4 w-4" aria-hidden="true"></i>
      Donate now
     </a>
    </div>
    <div class="rounded-[1.75rem] border border-white/15 bg-white/10 px-5 py-4 text-center shadow-[0_20px_50px_rgba(15,23,42,0.22)] backdrop-blur-xl">
     <div class="text-xs font-semibold uppercase tracking-[0.2em] text-white/75">Raised</div>
     <div class="mt-2 text-3xl font-bold">à§³{{ donation_total|default(0)|number_format(0) }}</div>
     {% set goal = settings.donation_goal_monthly|default(0) %}
     {% set pct = goal > 0 ? (donation_total|default(0) / goal) * 100 : 0 %}
     <div class="mt-3 h-2 overflow-hidden rounded-full bg-white/15">
      <div class="h-full rounded-full bg-amber-400" style="width:{{ pct > 100 ? 100 : pct|round }}%"></div>
     </div>
     <div class="mt-2 text-sm text-white/75">{{ pct|round }}% of monthly goal</div>
    </div>
   </div>
  </section>

  <div class="grid gap-4 md:grid-cols-3 mb-6">
   <div class="stat-card text-center">
    <i class="lucide lucide-users mx-auto mb-2 h-7 w-7 text-indigo-600" aria-hidden="true"></i>
    <div class="text-2xl font-bold text-slate-900">{{ donation_count|default(0)|number_format }}</div>
    <div class="text-sm text-slate-500">Contributors</div>
   </div>
   <div class="stat-card text-center">
    <i class="lucide lucide-newspaper mx-auto mb-2 h-7 w-7 text-emerald-600" aria-hidden="true"></i>
    <div class="text-2xl font-bold text-slate-900">{{ settings.total_posts|default(0)|number_format }}</div>
    <div class="text-sm text-slate-500">Articles Published</div>
   </div>
   <div class="stat-card text-center">
    <i class="lucide lucide-smartphone mx-auto mb-2 h-7 w-7 text-amber-600" aria-hidden="true"></i>
    <div class="text-2xl font-bold text-slate-900">{{ settings.total_mobiles|default(0)|number_format }}</div>
    <div class="text-sm text-slate-500">Phone Reviews</div>
   </div>
  </div>

  {% if success %}
  <div class="mb-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700" role="alert">
   <i class="lucide lucide-check-circle mr-2" aria-hidden="true"></i>{{ success }}
  </div>
  {% endif %}
  {% if server_error %}
  <div class="mb-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
   <i class="lucide lucide-alert-triangle mr-2" aria-hidden="true"></i>{{ server_error }}
  </div>
  {% endif %}
  {% if errors %}
  <div class="mb-4 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700" role="alert">
   <ul class="list-disc space-y-1 pl-5">
    {% for err in errors %}
    <li>{{ err }}</li>
    {% endfor %}
   </ul>
  </div>
  {% endif %}

  <div class="grid gap-6 lg:grid-cols-12" id="donate-form">
   <div class="lg:col-span-7">
    <div class="surface-card">
     <h2 class="text-2xl font-bold text-slate-900">Make a donation</h2>
     <p class="mt-2 text-sm text-slate-600">Choose an amount and payment method that works for you.</p>

     <form method="POST" action="/donate" novalidate class="mt-6">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

      <div class="grid gap-4 sm:grid-cols-2">
       <div>
        <label class="mb-2 block text-sm font-semibold text-slate-700">Your Name <span class="text-red-600">*</span></label>
        <input type="text" name="donor_name" value="{{ old.donor_name ?? '' }}" required>
       </div>
       <div>
        <label class="mb-2 block text-sm font-semibold text-slate-700">Email (optional)</label>
        <input type="email" name="donor_email" value="{{ old.donor_email ?? '' }}" placeholder="you@example.com">
       </div>
      </div>

      <div>
       <label class="mb-2 block text-sm font-semibold text-slate-700">Phone Number <span class="text-red-600">*</span></label>
       <input type="tel" name="donor_phone" value="{{ old.donor_phone ?? '' }}" placeholder="01XXXXXXXXX" required>
      </div>

      <div>
       <label class="mb-2 block text-sm font-semibold text-slate-700">Amount (BDT) <span class="text-red-600">*</span></label>
       <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-6">
        {% for amt in [50, 100, 200, 500, 1000, 2000] %}
        <button type="button" class="rounded-2xl border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm font-semibold text-indigo-700 transition hover:border-indigo-500 hover:bg-indigo-100" data-amount="{{ amt }}">
         {{ amt }}
        </button>
        {% endfor %}
       </div>
       <input type="number" id="amount-input" name="donation_amount" min="1" step="1" value="{{ old.donation_amount ?? '' }}" placeholder="Or enter a custom amount" class="mt-3">
      </div>

      <div>
       <label class="mb-2 block text-sm font-semibold text-slate-700">Payment Method <span class="text-red-600">*</span></label>
       <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4" id="method-selector">
        <button type="button" class="donation-method rounded-2xl border border-slate-200 bg-white p-4 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-200" data-method="bkash">
         <div class="text-sm font-semibold text-slate-900">bKash</div>
         <div class="text-xs text-slate-500">Mobile payment</div>
         <input type="radio" name="donation_method" value="bkash" hidden>
        </button>
        <button type="button" class="donation-method rounded-2xl border border-slate-200 bg-white p-4 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-200" data-method="nagad">
         <div class="text-sm font-semibold text-slate-900">Nagad</div>
         <div class="text-xs text-slate-500">Mobile payment</div>
         <input type="radio" name="donation_method" value="nagad" hidden>
        </button>
        <button type="button" class="donation-method rounded-2xl border border-slate-200 bg-white p-4 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-200" data-method="stripe">
         <div class="text-sm font-semibold text-slate-900">Card</div>
         <div class="text-xs text-slate-500">Visa / Mastercard</div>
         <input type="radio" name="donation_method" value="stripe" hidden>
        </button>
        <button type="button" class="donation-method rounded-2xl border border-slate-200 bg-white p-4 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-200" data-method="handcash">
         <div class="text-sm font-semibold text-slate-900">Direct</div>
         <div class="text-xs text-slate-500">Cash support</div>
         <input type="radio" name="donation_method" value="handcash" hidden>
        </button>
       </div>
      </div>

      <div id="bkash-panel" class="hidden rounded-[1.5rem] border border-rose-200 bg-rose-50 p-4">
       <h3 class="text-base font-bold text-slate-900">bKash donation</h3>
       <p class="mt-2 text-sm text-slate-600">Send <strong id="bkash-amt-label">à§³500</strong> to:</p>
       <div id="bkash-num" class="mt-3 cursor-pointer rounded-2xl border border-rose-200 bg-white px-4 py-3 text-center text-lg font-bold tracking-[0.2em] text-rose-700" data-bkash="{{ settings.donation_bkash_number|default('') }}" title="Tap to copy">
        {% if settings.donation_bkash_number|default('') %}
        {{ settings.donation_bkash_number }}
        {% else %}
        â€” Not configured â€”
        {% endif %}
       </div>
       {% if not settings.donation_bkash_number|default('') %}
       <p class="mt-2 text-sm text-red-600">bKash number is not configured. Please contact the site admin.</p>
       {% endif %}
       <div class="mt-4 space-y-2 text-sm text-slate-600">
        <p class="flex gap-2"><span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-indigo-600 text-xs font-bold text-white">1</span> Send money to the number above.</p>
        <p class="flex gap-2"><span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-indigo-600 text-xs font-bold text-white">2</span> Copy the TrxID from your payment message.</p>
        <p class="flex gap-2"><span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-indigo-600 text-xs font-bold text-white">3</span> Paste the TrxID below and submit this form.</p>
       </div>
       <div class="mt-4">
        <label class="mb-2 block text-sm font-semibold text-slate-700">bKash Transaction ID (TrxID)</label>
        <input type="text" id="bkash-trxid-input" name="bkash_trxid" placeholder="e.g. CID7K8LMNOP9QRS2">
       </div>
      </div>

      <div>
       <label class="mb-2 block text-sm font-semibold text-slate-700">Add a Note (optional)</label>
       <textarea name="donor_note" rows="3" placeholder="Leave a message...">{{ old.donor_note ?? '' }}</textarea>
      </div>

      <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">
       <i class="lucide lucide-send h-4 w-4" aria-hidden="true"></i>
       Donate â€” à§³<span id="submit-amt">{{ old.donation_amount|default('0') }}</span>
      </button>
     </form>
    </div>
   </div>

   <aside class="lg:col-span-5 space-y-4">
    {% if settings.donation_goals_html|default('') %}
    <div class="info-card">
     <h3 class="text-lg font-bold text-slate-900">Where your donation goes</h3>
     <div class="mt-3 text-sm text-slate-600">{{ settings.donation_goals_html|raw }}</div>
     <div class="mt-4">
      <div class="flex items-center justify-between text-sm text-slate-600">
       <span>Monthly goal</span>
       <span>à§³{{ goal|number_format }}</span>
      </div>
      <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100">
       <div class="h-full rounded-full bg-indigo-600" style="width:{{ pct > 100 ? 100 : pct|round }}%"></div>
      </div>
     </div>
    </div>
    {% endif %}

    <div class="support-card">
     <h3 class="text-lg font-bold text-slate-900">Recent supporters</h3>
     <div class="mt-4 space-y-3">
      {% if recent_donations %}
      {% for donation in recent_donations %}
      <div class="flex items-center gap-3 rounded-2xl bg-slate-50 px-4 py-3">
       <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-indigo-600 to-violet-600 font-bold text-white">
        {{ (donation.donor_name ?? '?')|slice(0,1)|upper }}
       </div>
       <div class="min-w-0">
        <div class="truncate text-sm font-semibold text-slate-900">{{ donation.donor_name }}</div>
        <div class="text-xs text-slate-500">{{ donation.method|capitalize }}</div>
       </div>
       <div class="ml-auto text-sm font-bold text-emerald-600">à§³{{ donation.amount|number_format(0) }}</div>
      </div>
      {% endfor %}
      {% else %}
      <div class="rounded-2xl bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">
       <i class="lucide lucide-gift mx-auto mb-2 h-6 w-6 text-slate-400" aria-hidden="true"></i>
       Be the first to support us!
      </div>
      {% endif %}
     </div>
    </div>

    <div class="support-card">
     <h3 class="text-lg font-bold text-slate-900">Corporate sponsorship</h3>
     <p class="mt-2 text-sm leading-7 text-slate-600">Reach thousands of tech and mobile lovers with a featured sponsorship.</p>
     <a href="/advertise" class="mt-4 inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-900 transition hover:bg-slate-50">
      <i class="lucide lucide-megaphone h-4 w-4" aria-hidden="true"></i>
      Advertise with us
     </a>
    </div>
   </aside>
  </div>
 </div>
</div>

<script>
(function () {
 const amountInput = document.getElementById('amount-input');
 const submitAmount = document.getElementById('submit-amt');
 const bkashPanel = document.getElementById('bkash-panel');
 const bkashNumber = document.getElementById('bkash-num');
 const bkashAmountLabel = document.getElementById('bkash-amt-label');
 const bkashTrxInput = document.getElementById('bkash-trxid-input');
 const form = document.querySelector('form[action="/donate"]');
 const methods = document.querySelectorAll('.donation-method');
 const quickAmountButtons = document.querySelectorAll('[data-amount]');

 let selectedMethod = '';

 function formatAmount(amount) {
  const numericAmount = Number(amount) || 0;
  return `à§³${numericAmount.toLocaleString()}`;
 }

 function syncLabels(amount) {
  const label = formatAmount(amount);
  if (submitAmount) submitAmount.textContent = Number(amount) || 0;
  if (bkashAmountLabel) bkashAmountLabel.textContent = label;
 }

 function setMethod(methodButton) {
  methods.forEach((button) => button.classList.remove('ring-2', 'ring-indigo-500', 'border-indigo-500'));
  methodButton.classList.add('ring-2', 'ring-indigo-500', 'border-indigo-500');
  const radio = methodButton.querySelector('input[type="radio"]');
  if (radio) radio.checked = true;
  selectedMethod = methodButton.dataset.method;
  if (bkashPanel) bkashPanel.classList.toggle('hidden', selectedMethod !== 'bkash');
}

 quickAmountButtons.forEach((button) => {
  button.addEventListener('click', () => {
   const amount = button.dataset.amount;
   if (amountInput) amountInput.value = amount;
   syncLabels(amount);
  });
 });

 methods.forEach((button) => {
  button.addEventListener('click', () => setMethod(button));
 });

 if (amountInput) {
  amountInput.addEventListener('input', () => syncLabels(amountInput.value));
  syncLabels(amountInput.value || 0);
 }

 if (bkashNumber) {
  bkashNumber.addEventListener('click', async () => {
   const number = bkashNumber.dataset.bkash;
   if (!number) return;
   try {
    await navigator.clipboard.writeText(number);
    const original = bkashNumber.textContent;
    bkashNumber.textContent = 'Copied!';
    setTimeout(() => {
     bkashNumber.textContent = original;
    }, 1500);
   } catch (error) {
    console.error('Unable to copy bKash number', error);
   }
  });
 }

 if (form) {
  form.addEventListener('submit', (event) => {
   const amount = parseFloat(amountInput?.value || '0');
   const method = selectedMethod || (document.querySelector('input[name="donation_method"]:checked')?.value || '');

   if (!amount || amount <= 0) {
    alert('Please enter a valid donation amount.');
    event.preventDefault();
    return;
   }

   if (!method) {
    alert('Please select a payment method.');
    event.preventDefault();
    return;
   }

   if (method === 'bkash' && bkashTrxInput && !bkashTrxInput.value.trim()) {
    alert('Please enter the bKash Transaction ID.');
    event.preventDefault();
   }
  });
 }
})();
</script>
{% endblock %}

