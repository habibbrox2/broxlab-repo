{% extends 'layout.twig' %}

{% block title %}Support Us – Help Keep {{ app_settings.site_name|default('BroxBhai') }} Running{% endblock %}
{% set breadcrumbs = [
  { label: 'Support Us', url: '/donate', icon: 'heart-pulse' }
] %}

{% block extra_styles %}
<style>
  .donate-hero {
    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);
    color: #fff; position: relative; overflow: hidden;
  }
  .donate-hero::after {
    content:''; position:absolute; inset:0;
    background: radial-gradient(circle at 80% 20%, rgba(251,191,36,.22) 0%, transparent 55%);
    pointer-events: none;
  }
  .donate-hero .pos-rel { position:relative; z-index:1; }
  .support-stat {
    text-align:center; padding:1.4rem 1rem;
    background:rgba(255,255,255,.06); border-radius:1rem;
    border:1px solid rgba(255,255,255,.12);
  }
  .support-stat .big { font-size:2rem; font-weight:800; color:#fbbf24; line-height:1; }
  .support-stat .lbl  { font-size:.85rem; opacity:.8; margin-top:.4rem; }
  .method-card {
    border:2px solid transparent; border-radius:1.25rem;
    cursor:pointer; transition:all .2s;
  }
  .method-card:hover   { transform:translateY(-3px); }
  .method-card.active  { border-color:#4338ca; box-shadow:0 0 0 3px rgba(67,56,202,.18); }
  .quick-amount-group button {
    transition:all .15s; border:2px solid rgba(99,102,241,.2);
    background:rgba(99,102,241,.06); color:#4338ca; font-weight:700;
    border-radius:.75rem; padding:.6rem 1.4rem; width:100%;
  }
  .quick-amount-group button:hover,
  .quick-amount-group button:focus {
    background:rgba(99,102,241,.14); border-color:#4338ca;
  }
  .bkash-number-display {
    font-size:1.5rem; font-weight:700; letter-spacing:.2em;
    border:2px dashed #e53e3e; border-radius:.6rem; padding:.5rem 1rem;
    color:#c53030; background:#fff5f5; text-align:center; cursor:pointer;
    user-select:all;
  }
  .note-para { font-size:.85rem; color:#6b7280; margin-top:.4rem; }
  .guidance-panel {
    background:#f9f5ff; border:1px solid #e0d7fe; border-radius:.75rem;
    padding:1rem 1.25rem;
  }
  .guidance-step { display:flex; align-items:flex-start; gap:.6rem; margin-bottom:.6rem; }
  .guidance-step:last-child { margin-bottom:0; }
  .step-badge {
    flex-shrink:0; width:1.75rem; height:1.75rem;
    background:#6366f1; color:#fff;
    border-radius:50%; display:flex; align-items:center; justify-content:center;
    font-weight:700; font-size:.8rem;
  }
  .recent-donor {
    display:flex; align-items:center; gap:.7rem;
    padding:.7rem 1rem; background:#f8fafc; border-radius:.75rem; margin-bottom:.5rem;
  }
  .donor-avatar {
    width:2.4rem; height:2.4rem;
    background:linear-gradient(135deg,#6366f1,#8b5cf6);
    color:#fff; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-weight:700; font-size:.85rem; flex-shrink:0;
  }
  .recent-donor .amt { font-weight:700; color:#059669; margin-left:auto; white-space:nowrap; }
  .icon-circle { display:flex; align-items:center; justify-content:center; }
</style>
{% endblock %}

{% block content %}
<div class="page-donate">

  <section class="donate-hero py-5 mb-5">
    <div class="container donate-hero pos-rel">
      <div class="row align-items-center">
        <div class="col-lg-7">
          <h1 class="display-5 fw-bold mb-3">
            <i class="bi bi-heart-fill me-2 text-warning"></i>Support Our Mission
          </h1>
          <p class="lead mb-4 opacity-90">
            Your contribution keeps {{ app_settings.site_name|default('BroxBhai') }} free, accurate,
            and available for everyone. Every donation helps cover server costs and keeps us creating.
          </p>
          <a href="#donate-form" class="btn btn-warning btn-lg fw-bold rounded-pill px-5">
            <i class="bi bi-heart me-2"></i>Donate Now
          </a>
        </div>
        <div class="col-lg-5 text-center mt-4 mt-lg-0">
          <div class="support-stat bg-white bg-opacity-10 rounded-4 p-4 border border-white border-opacity-20">
            <div class="big">৳{{ donation_total|default(0)|number_format(0) }}</div>
            <div class="lbl">Total Raised</div>
            <hr class="border-white border-opacity-20 my-3">
            {% set goal = (settings.donation_goal_monthly|default(0)|default(0)) %}
            <div class="big">৳{{ goal|number_format(0) }}</div>
            <div class="lbl">Monthly Goal</div>
            <div class="mt-3">
              {% set pct = goal > 0 ? (donation_total|default(0) / goal) * 100 : 0 %}
              <div class="progress" style="height:6px;background:rgba(255,255,255,.2)">
                <div class="progress-bar bg-warning" style="width:{{ pct > 100 ? 100 : pct|round }}%"></div>
              </div>
              <small class="opacity-75">{{ pct|round }}% of monthly goal</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container py-2 pb-5">

    {# ── Quick Stats ── #}
    <div class="row g-3 mb-5">
      <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 p-4 text-center">
          <i class="bi bi-people-fill text-primary fs-3 mb-2"></i>
          <h3 class="h5 fw-bold mb-0">{{ donation_count|default(0)|number_format }}</h3>
          <small class="text-muted">Contributors</small>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 p-4 text-center">
          <i class="bi bi-newspaper text-success fs-3 mb-2"></i>
          <h3 class="h5 fw-bold mb-0">{{ settings.total_posts|default(0)|number_format }}</h3>
          <small class="text-muted">Articles Published</small>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 p-4 text-center">
          <i class="bi bi-phone-fill text-warning fs-3 mb-2"></i>
          <h3 class="h5 fw-bold mb-0">{{ settings.total_mobiles|default(0)|number_format }}</h3>
          <small class="text-muted">Phone Reviews</small>
        </div>
      </div>
    </div>

    {% if success %}
      <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>{{ success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endif %}
    {% if server_error %}
      <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ server_error }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endif %}
    {% if errors %}
      <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-4" role="alert">
        <ul class="mb-0">{% for err in errors %}<li>{{ err }}</li>{% endfor %}</ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endif %}

    <div class="row g-4" id="donate-form">
      {# ── LEFT: FORM ── #}
      <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5">
          <h3 class="h4 fw-bold mb-4">
            <i class="bi bi-gift-fill text-danger me-2"></i>Make a Donation
          </h3>
          <form method="POST" action="/donate" novalidate>
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <div class="mb-3">
              <label class="form-label fw-semibold">Your Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="donor_name"
                     value="{{ old.donor_name ?? '' }}" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Email (optional)</label>
              <input type="email" class="form-control" name="donor_email"
                     value="{{ old.donor_email ?? '' }}">
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Phone Number <span class="text-danger">*</span></label>
              <input type="tel" class="form-control" name="donor_phone"
                     value="{{ old.donor_phone ?? '' }}" required placeholder="01XXXXXXXXX">
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Amount (BDT) <span class="text-danger">*</span></label>
              <div class="row g-2 quick-amount-group mb-2">
                {% for amt in [50, 100, 200, 500, 1000, 2000] %}
                <div class="col-4 col-sm-2">
                  <button type="button" class="w-100"
                          onclick="setAmount(this)">{{ amt }}</button>
                </div>
                {% endfor %}
              </div>
              <input type="number" id="amount-input" class="form-control fw-bold"
                     name="donation_amount" min="1" step="1"
                     value="{{ old.donation_amount ?? '' }}"
                     placeholder="Or enter a custom amount" required>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Payment Method <span class="text-danger">*</span></label>
              <div class="row g-2" id="method-selector">
                <div class="col-6 col-md-3">
                  <div class="method-card card h-100 p-2 text-center"
                       data-method="bkash" onclick="selectMethod(this)">
                    <div class="method-icon"><span style="font-weight:900;color:#e53e3e">bK</span></div>
                    <span class="fw-bold d-block mt-1 small">bKash</span>
                    <input type="radio" name="donation_method" value="bkash" hidden>
                  </div>
                </div>
                <div class="col-6 col-md-3">
                  <div class="method-card card h-100 p-2 text-center"
                       data-method="nagad" onclick="selectMethod(this)">
                    <div class="method-icon"><span style="font-weight:900;color:#d97706">N</span></div>
                    <span class="fw-bold d-block mt-1 small">Nagad</span>
                    <input type="radio" name="donation_method" value="nagad" hidden>
                  </div>
                </div>
                <div class="col-6 col-md-3">
                  <div class="method-card card h-100 p-2 text-center"
                       data-method="stripe" onclick="selectMethod(this)">
                    <div class="method-icon"><i class="bi bi-credit-card-2-front text-primary"></i></div>
                    <span class="fw-bold d-block mt-1 small">Card</span>
                    <input type="radio" name="donation_method" value="stripe" hidden>
                  </div>
                </div>
                <div class="col-6 col-md-3">
                  <div class="method-card card h-100 p-2 text-center"
                       data-method="handcash" onclick="selectMethod(this)">
                    <div class="method-icon"><i class="bi bi-cash-coin text-success"></i></div>
                    <span class="fw-bold d-block mt-1 small">Direct</span>
                    <input type="radio" name="donation_method" value="handcash" hidden>
                  </div>
                </div>
              </div>
            </div>

            {# bKash guidance #}
            <div id="bkash-panel" class="guidance-panel mb-3 d-none">
              <h5 class="ft-bold"><i class="bi bi-telephone-outbound me-2 text-danger"></i>bKash Donation</h5>
              <p class="note-para mt-2">Send <strong id="bkash-amt-label">৳500</strong> to:</p>
              <span class="bkash-number-display" id="bkash-num"
                    data-bkash="{{ settings.donation_bkash_number|default('') }}"
                    title="Tap to copy">
                {% if settings.donation_bkash_number|default('') %}
                  {{ settings.donation_bkash_number }}
                {% else %}— Not configured —{% endif %}
              </span>
              {% if not settings.donation_bkash_number|default('') %}
                <small class="text-danger d-block mt-2">
                  bKash number is not configured. Please contact the site admin.
                </small>
              {% endif %}
              <div class="guidance-step mt-3">
                <span class="step-badge">1</span>
                <span>Open bKash &#8594; Send Money to the number above.</span>
              </div>
              <div class="guidance-step">
                <span class="step-badge">2</span>
                <span>Enter <strong id="step-amt">৳500</strong> and complete the payment.</span>
              </div>
              <div class="guidance-step">
                <span class="step-badge">3</span>
                <span>Copy the bKash Transaction ID (TrxID) from your message.</span>
              </div>
              <div class="guidance-step">
                <span class="step-badge">4</span>
                <span>Paste the TrxID in the field below and submit this form.</span>
              </div>
              <div class="mb-3 mt-3">
                <label class="form-label fw-semibold">bKash Transaction ID (TrxID) <span class="text-danger">*</span></label>
                <input type="text" id="bkash-trxid-input" class="form-control font-monospace"
                       name="bkash_trxid" placeholder="e.g. CID7K8LMNOP9QRS2">
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Add a Note (optional)</label>
              <textarea class="form-control" name="donor_note" rows="2"
                        placeholder="Leave a message…">{{ old.donor_note ?? '' }}</textarea>
            </div>

            <button type="submit"
                    class="btn btn-primary btn-lg w-100 rounded-pill fw-bold">
              <i class="bi bi-send-fill me-2"></i>Donate — ৳<span id="submit-amt">{{ old.donation_amount|default('0') }}</span>
            </button>
          </form>
        </div>
      </div>

      {# ── RIGHT SIDEBAR ── #}
      <div class="col-lg-5">
        <div class="flex-column gap-3 d-flex">

          {% if settings.donation_goals_html|default('') %}
          <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold"><i class="bi bi-bullseye text-primary me-2"></i>Where Your Donation Goes</h5>
            {{ settings.donation_goals_html|raw }}
            <div class="mt-3">
              <strong>Monthly Goal:</strong> ৳{{ goal|number_format }}
              <div class="progress mt-1">
                <div class="progress-bar bg-primary"
                     style="width:{{ (pct > 100 ? 100 : pct)|round }}%"></div>
              </div>
              <small class="text-muted">
                ৳{{ donation_total|default(0)|number_format(0) }} donated of ৳{{ goal|number_format }}
              </small>
            </div>
          </div>
          {% endif %}

          <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-people text-success me-2"></i>Recent Supporters</h5>
            {% if recent_donations %}
              {% for d in recent_donations %}
              <div class="recent-donor">
                <div class="donor-avatar">{{ (d.donor_name ?? '?')|slice(0,1)|upper }}</div>
                <div>
                  <div class="fw-semibold small mb-0">{{ d.donor_name }}</div>
                  <small class="text-muted mb-0">{{ d.method|capitalize }}</small>
                </div>
                <span class="amt fw-bold">৳{{ d.amount|number_format(0) }}</span>
              </div>
              {% endfor %}
            {% else %}
              <div class="text-center py-3 text-muted">
                <i class="bi bi-gift fs-4 d-block mb-2"></i>
                <small>Be the first to support us!</small>
              </div>
            {% endif %}
          </div>

          <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
            <h5 class="fw-bold"><i class="bi bi-megaphone-fill text-danger me-2"></i>Corporate Sponsorship</h5>
            <p class="small text-muted mb-3">
              Reach thousands of tech &amp; mobile lovers. <a href="/advertise" class="fw-bold text-primary">Advertise with us &rarr;</a>
            </p>
            <a href="/advertise" class="btn btn-outline-danger btn-sm rounded-pill">Advertise</a>
          </div>

        </div>
      </div>

    </div><!-- /row -->
  </div><!-- /container -->
</div><!-- /page-donate -->

<script>
  // ── Quick-amount pick ──
  function setAmount(btn) {
    const v = btn.textContent.trim();
    document.getElementById('amount-input').value = v;
    document.querySelectorAll('.quick-amount-group button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    syncLabels(parseFloat(v));
  }
  document.getElementById('amount-input').addEventListener('input', function () {
    syncLabels(parseFloat(this.value) || 0);
  });

  // ── Method selector ──
  function selectMethod(card) {
    card.closest('#method-selector').querySelectorAll('.method-card').forEach(c => c.classList.remove('active'));
    card.classList.add('active');
    card.querySelector('input').checked = true;
    const m = card.dataset.method;
    document.getElementById('bkash-panel').classList.toggle('d-none', m !== 'bkash');
  }

  // ── Live label sync ──
  function syncLabels(amt) {
    const fmt = '৳' + (Number.isFinite(amt) ? amt.toLocaleString() : '0');
    const el = document.getElementById('bkash-amt-label');
    const se = document.getElementById('step-amt');
    const su = document.getElementById('submit-amt');
    if (el) el.textContent = fmt;
    if (se) se.textContent = fmt;
    if (su) su.textContent = fmt;
  }

  // ── Validation before submit ──
  document.querySelector('form').addEventListener('submit', function (e) {
    const amt    = parseFloat(document.getElementById('amount-input').value || '0');
    const method = document.querySelector('input[name="donation_method"]:checked');
    if (amt <= 0)          { alert('Please enter a valid donation amount.');                      e.preventDefault(); }
    if (!method || !method.value) { alert('Please select a payment method.');                       e.preventDefault(); }
    if (method && method.value === 'bkash') {
      if (!document.getElementById('bkash-trxid-input').value.trim()) {
        alert('Please enter the bKash Transaction ID.');
        e.preventDefault();
      }
    }
  });

  // ── Copy bKash number on tap ──
  document.getElementById('bkash-num')?.addEventListener('click', function () {
    const num = this.dataset.bkash;
    if (!num) return;
    navigator.clipboard.writeText(num).then(() => {
      const orig = this.textContent;
      this.textContent = 'Copied!';
      setTimeout(() => { this.textContent = orig; }, 1800);
    });
  });
</script>
{% endblock %}
