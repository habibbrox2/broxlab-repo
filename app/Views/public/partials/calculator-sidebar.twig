{# app/Views/public/partials/calculator-sidebar.twig #}
<div class="calculator-sidebar bg-white rounded-2xl shadow-sm border border-1 p-3">
 <div class="flex items-center justify-between mb-3">
 <div>
 <h5 class="mb-1 font-bold">{{ current_lang == 'bn' ? 'ক্যালকুলেটর হাব' : 'Calculator hub' }}</h5>
 <p class="text-xs text-slate-500 mb-0">{{ current_lang == 'bn' ? 'এক ক্লিকে ক্যালকুলেটর ও কনভার্টার মধ্যে স্যুইচ করুন।' : 'Jump between calculators and converters with one click.' }}</p>
 </div>
 </div>

 <div class="flex flex-col calculator-nav">
 <a href="/calculators"
 class="flex items-center justify-between rounded-xl px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-slate-900 {% if current_type is not defined or current_type == 'all' %}bg-slate-900 text-white hover:bg-slate-800 hover:text-white{% endif %}">
 <div class="flex items-center justify-between">
 <div>
 <div class="font-semibold">{{ current_lang == 'bn' ? 'সমস্ত ক্যালকুলেটর' : 'All Calculators' }}</div>
 <small class="text-slate-500">{{ current_lang == 'bn' ? 'পূর্ণ লাইব্রেরি ব্রাউজ করুন' : 'Browse the full library' }}</small>
 </div>
 <i class="lucide lucide-grid"></i>
 </div>
 </a>

 {% for groupKey, group in groups %}
 {% set groupIcon = {
 'calculator': 'icon-calculator',
 'converter': 'icon-arrow-left-right',
 }[groupKey] | default('icon-grid') %}
 <div class="mt-4">
 <div class="flex items-center text-uppercase text-slate-500 text-xs font-semibold mb-2">
 <i class="bi {{ groupIcon }} mr-2" aria-hidden="true"></i>{{ group.label }}
 </div>
 {% for item in group.items %}
 <a href="/calculators/{{ item.type }}"
 class="flex items-center justify-between rounded-xl px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-slate-900 {% if item.type == current_type %}bg-indigo-50 font-semibold text-indigo-700{% endif %}">
 <span class="text-xs mb-0">{{ item.label }}</span>
 {% if item.type == current_type %}
 <i class="lucide lucide-check"></i>
 {% else %}
 <i class="lucide lucide-chevron-right"></i>
 {% endif %}
 </a>
 {% endfor %}
 </div>
 {% endfor %}
 </div>
</div>




