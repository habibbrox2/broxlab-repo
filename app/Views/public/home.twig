          </div>
          
          <p class="text-center text-muted small">
            <i class="bi bi-info-circle-fill me-1" aria-hidden="true"></i>Help us spread the word by sharing this page with your friends and followers
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{# ==================== NEWSLETTER SECTION ==================== #}
<section class="py-5 bg-light" aria-labelledby="newsletter-title">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-7">
        <div class="card border-0 shadow-lg rounded-4 p-5 newsletter-card home-newsletter-card text-center">
          <div class="mb-4">
            <span class="bg-primary bg-gradient rounded-circle p-3 mb-3 d-inline-block">
              <i class="bi bi-envelope-paper-fill text-white fs-1" aria-hidden="true"></i>
            </span>
            <h2 id="newsletter-title" class="fw-bold display-6 mb-2">Get Latest Updates</h2>
            <p class="lead text-muted">Subscribe for the latest news, reviews, and exclusive offers</p>
          </div>
          <form id="home-newsletter-form" class="row g-2 justify-content-center" aria-label="Newsletter subscription form">
            <div class="col-md-10">
              <label for="newsletter-email" class="visually-hidden">Email address</label>
              <input type="email" 
                     id="newsletter-email"
                     name="email"
                     class="form-control rounded-pill px-4 py-3 shadow-sm" 
                     placeholder="Your email address" 
                     aria-label="Enter your email address"
                     required>
            </div>
            <div class="col-md-6">
              <button type="submit" class="btn btn-primary rounded-pill fw-bold" aria-label="Subscribe to newsletter">
                <i class="bi bi-send-fill me-2" aria-hidden="true"></i>Subscribe
              </button>
            </div>
          </form>
          
          <script>
          document.getElementById('home-newsletter-form').addEventListener('submit', async (e) => {
              e.preventDefault();
              const formData = new FormData(e.target);
              
              try {
                  const response = await fetch('/newsletter/subscribe', {
                      method: 'POST',
                      body: formData
                  });
                  const data = await response.json();
                  
                  if (data.success) {
                      showMessage(data.message || 'Successfully subscribed to our newsletter', 'success');
                      e.target.reset();
                  } else {
                      showMessage(data.error || 'An error occurred', 'error');
                  }
              } catch (err) {
                  showMessage('Error: ' + err.message, 'error');
              }
          });
          </script>
        </div>
      </div>
    </div>
  </div>
</section>

{# ==================== RECOMMENDED SECTION ==================== #}
<section class="py-5 bg-gradient bg-light home-recommended-section" aria-labelledby="recommended-title">
  <div class="container">
    <div class="text-center mb-5">
      <h2 id="recommended-title" class="fw-bold display-5 mb-3">
        <span class="text-primary">Recommended</span> for You
      </h2>
      <p class="lead text-muted">Hand-picked content just for your interests</p>
    </div>
    <div class="row g-4 justify-content-center" role="region" aria-label="Recommended content">
      {% if featured_content %}
        {% for item in featured_content|slice(0, 3) %}
        <div class="col-md-6 col-lg-4">
          <article class="card h-100 border-0 shadow-lg hover-shadow-lg rounded-4 overflow-hidden recommended-card" role="article" aria-label="Recommended item: {{ item.title }}">
            {% if item.image %}
            <div class="ratio ratio-16x9 overflow-hidden recommended-card-img">
              <img src="{{ item.image }}" 
                   class="object-fit-cover w-100 h-100" 
                   alt="{{ item.title }}"
                   loading="lazy"
                   decoding="async"
                   width="400" height="225">
            </div>
            {% endif %}
            <div class="card-body">
              <div class="mb-2">
                <span class="badge bg-gradient bg-primary rounded-pill small">{{ item.category|default('Featured') }}</span>
              </div>
              <h3 class="card-title fw-bold line-clamp-2 h5">{{ item.title }}</h3>
              <p class="card-text text-muted small line-clamp-2">{{ item.description|striptags|default('') }}</p>
              <a href="{{ item.link|default('#') }}" 
                 class="btn btn-primary btn-sm rounded-pill mt-3"
                 aria-label="Read more about {{ item.title }}">
                Read More
              </a>
            </div>
          </article>
        </div>
        {% endfor %}
      {% else %}
        {# Fallback Categories Display #}
        <div class="col-12">
          <div class="row g-4 justify-content-center">
            {% set default_categories = [
              {name: 'News', slug: 'news', icon: 'bi bi-newspaper', gradient: '#667eea, #764ba2', description: 'Latest tech news'},
              {name: 'Reviews', slug: 'reviews', icon: 'bi bi-star-fill', gradient: '#f093fb, #f5576c', description: 'Product reviews'},
              {name: 'Tutorials', slug: 'tutorials', icon: 'bi bi-mortarboard-fill', gradient: '#4facfe, #00f2fe', description: 'Learn new skills'}
            ] %}
            
            {% for cat in categories|default(default_categories) %}
            <div class="col-md-6 col-lg-4">
              <a href="/category/{{ cat.slug }}" class="text-decoration-none" aria-label="Browse {{ cat.name }} category">
                <div class="p-4 rounded-4 text-white hover-shadow-lg transition-all category-card" 
                     style="background: linear-gradient(135deg, {{ cat.gradient|default('#6366f1, #a855f7') }});"
                     role="button"
                     tabindex="0">
                  <i class="{{ cat.icon|default('bi bi-folder-fill') }} fs-2 mb-3" aria-hidden="true"></i>
                  <h3 class="fw-bold mb-2 h5">{{ cat.name }}</h3>
                  <p class="small mb-0 opacity-75">{{ cat.description|default('Explore this category') }}</p>
                </div>
              </a>
            </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{# ==================== JAVASCRIPT ==================== #}
<script>

  // Copy to clipboard function
  function copyToClipboardHome() {
    const url = window.location.href;
    const btn = document.getElementById('copyLinkBtnHome');
    
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url)
        .then(function() {
          showCopySuccess(btn);
        })
        .catch(function(err) {
          console.error('Clipboard API failed:', err);
          fallbackCopy(url, btn);
        });
    } else {
      fallbackCopy(url, btn);
    }
  }
  
  function fallbackCopy(text, btn) {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    textarea.setAttribute('aria-hidden', 'true');
    document.body.appendChild(textarea);
    textarea.select();
    try {
      document.execCommand('copy');
      showCopySuccess(btn);
    } catch (err) {
      console.error('Failed to copy:', err);
      alert('Failed to copy link. Please try again.');
    }
    document.body.removeChild(textarea);
  }
  
  function showCopySuccess(btn) {
    if (!btn) return;
    const originalHtml = btn.innerHTML;
    const originalBg = btn.style.backgroundColor;
    const originalBorder = btn.style.borderColor;
    
    btn.innerHTML = '<i class="bi bi-check-lg me-2" aria-hidden="true"></i>Copied!';
    btn.style.backgroundColor = '#28a745';
    btn.style.borderColor = '#28a745';
    btn.style.color = '#fff';
    btn.setAttribute('aria-label', 'Link copied to clipboard');
    
    setTimeout(function() {
      btn.innerHTML = originalHtml;
      btn.style.backgroundColor = originalBg;
      btn.style.borderColor = originalBorder;
      btn.style.color = '';
      btn.setAttribute('aria-label', 'Copy link to clipboard');
    }, 2000);
  }

    </script>

