{% extends "layout.twig" %}

{# ===== SEO Meta Tags ===== #}
{% block title %}{{ app_settings.meta_title ?: app_settings.site_name ~ ' | Official Website' }}{% endblock %}
{% block og_type %}website{% endblock %}

{% block extra_styles %}
  {# Non-critical page-specific styles (deferred) #}
  <link rel="stylesheet" href="{{ url }}assets/css/mobiles-grid.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ url }}assets/css/mobiles-grid.css"></noscript>
  <link rel="stylesheet" href="{{ asset('assets/css/weather.css') }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ asset('assets/css/weather.css') }}"></noscript>
{% endblock %}

{% set page_image = app_settings.site_logo|default(url ~ 'assets/images/default-og-image.png')|absolute_url %}
{% set page_schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical_url|default(url),
  'url': url,
  'name': app_settings.meta_title ?: app_settings.site_name,
  'description': app_settings.meta_description ?: 'Welcome to ' ~ app_settings.site_name,
  'image': page_image,
  'isPartOf': {
    '@type': 'WebSite',
    '@id': url,
    'name': app_settings.site_name
  },
  'datePublished': 'now'|date('c'),
  'dateModified': 'now'|date('c')
} %}
{% block schema %}
  <script type="application/ld+json">
{{ page_schema|schema_json }}
  </script>
{% endblock %}

{% block content %}

{# ==================== HERO SECTION ==================== #}
<section class="hero home-hero position-relative text-center text-white py-5 mb-5 overflow-hidden"
        
         aria-labelledby="hero-title">

  {# Animated Background Elements #}
  <div class="position-absolute top-0 start-0 w-100 h-100" aria-hidden="true">
    {# Floating Shapes #}
    <div class="floating-shape shape-1"></div>
    <div class="floating-shape shape-2"></div>
    <div class="floating-shape shape-3"></div>
    <div class="floating-shape shape-4"></div>
    <div class="floating-shape shape-5"></div>

    {# Gradient Orbs #}
    <div class="hero-orb orb-1"></div>
    <div class="hero-orb orb-2"></div>
    <div class="hero-orb orb-3"></div>

    {# Mesh Gradient Overlay #}
    <div class="mesh-overlay"></div>
  </div>

  <div class="container py-5 position-relative" style="z-index: 2;">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        {# Hero Badge #}
        <div class="hero-badge mb-4">
          <span class="badge bg-white bg-opacity-20 text-primary px-4 py-2 rounded-pill border border-white border-opacity-40 tw-backdrop-blur-sm">
            <i class="bi bi-lightning-charge-fill me-2" aria-hidden="true"></i>
            Explore What's New
            <i class="bi bi-rocket-takeoff-fill ms-2" aria-hidden="true"></i>
          </span>
        </div>

        <h1 id="hero-title" class="display-2 fw-extrabold mb-4 text-uppercase tracking-wider hero-title">
          <span class="text-shadow-lg">
            Latest Updates
          </span>
        </h1>

        <p class="lead mb-5 opacity-90 fs-5 hero-subtitle">
          Discover the future of mobile technology with our curated latest updates, insights, and exclusive services that keeps you ahead of the curve.
        </p>

        {# Action Buttons #}
        <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center mb-4">
          <a href="#latest-updates" class="btn btn-lg btn-light rounded-pill px-5 py-3 shadow-lg fw-bold transition-all hover-scale hero-cta-primary position-relative overflow-hidden">
            <span class="position-relative z-index-1">
              <i class="bi bi-rocket-takeoff-fill me-2" aria-hidden="true"></i>
              Explore Now
