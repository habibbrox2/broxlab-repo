            <div class="btn-shine"></div>
          </a>

          <a href="/services" class="btn btn-lg btn-outline-light rounded-pill px-5 py-3 fw-bold transition-all hover-glow hero-cta-secondary">
            <i class="bi bi-award-fill me-2" aria-hidden="true"></i>
            Browse Services
          </a>

        </div>

        {# Quick Stats #}
        <div class="row justify-content-center mt-5 home-hero-stats g-3">
          <div class="col-auto">
            <div class="hero-stat d-flex align-items-center gap-3 text-white-50">
              <div class="stat-icon bg-white bg-opacity-20 rounded-circle p-3">
                <i class="bi bi-phone-fill fs-4 text-primary" aria-hidden="true"></i>
              </div>
              <div class="text-start">
                <div class="fw-bold fs-4 text-white">1200+</div>
                <div class="small opacity-75">Devices</div>
              </div>
            </div>
          </div>

          <div class="col-auto mx-4">
            <div class="hero-stat d-flex align-items-center gap-3 text-white-50">
              <div class="stat-icon bg-white bg-opacity-20 rounded-circle p-3">
                <i class="bi bi-newspaper fs-4 text-success" aria-hidden="true"></i>
              </div>
              <div class="text-start">
                <div class="fw-bold fs-4 text-white">850+</div>
                <div class="small opacity-75">Articles</div>
              </div>
            </div>
          </div>

          <div class="col-auto">
            <div class="hero-stat d-flex align-items-center gap-3 text-white-50">
              <div class="stat-icon bg-white bg-opacity-20 rounded-circle p-3">
                <i class="bi bi-award-fill fs-4 text-warning" aria-hidden="true"></i>
              </div>
              <div class="text-start">
                <div class="fw-bold fs-4 text-white">150+</div>
                <div class="small opacity-75">Services</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# Scroll Indicator #}
  <div class="scroll-indicator position-absolute bottom-0 start-50 translate-middle-x mb-4">
    <div class="d-flex flex-column align-items-center text-white-50">
      <span class="small mb-2">Scroll to explore</span>
      <div class="scroll-mouse">
        <div class="scroll-wheel"></div>
      </div>
    </div>
  </div>
</section>

