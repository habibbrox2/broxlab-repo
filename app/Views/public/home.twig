               rel="noopener noreferrer"
               class="btn btn-sm rounded-pill shadow-sm transition-all"
               style="background-color: #25D366; color: white; padding: 0.5rem 1.2rem;"
               aria-label="Share on WhatsApp">
                <i class="bi bi-whatsapp me-2" aria-hidden="true"></i>WhatsApp
            </a>

            {# Email Share #}
            <a href="mailto:?subject={{ 'Check out this amazing website'|url_encode }}&body={{ 'I found this amazing website that you might like:'|url_encode }}%0D%0A{{ url|url_encode|default('') }}" 
               class="btn btn-sm rounded-pill shadow-sm transition-all"
               style="background-color: #EA4335; color: white; padding: 0.5rem 1.2rem;"
               aria-label="Share via Email">
                <i class="bi bi-envelope-fill me-2" aria-hidden="true"></i>Email
