            </a>

            {# LinkedIn Share #}
            <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ url|url_encode|default('') }}" 
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-sm rounded-pill shadow-sm transition-all"
               style="background-color: #0077B5; color: white; padding: 0.5rem 1.2rem;"
               aria-label="Share on LinkedIn">
                <i class="bi bi-linkedin me-2" aria-hidden="true"></i>LinkedIn
            </a>

            {# WhatsApp Share #}
            <a href="https://wa.me/?text={{ 'Check out this amazing content'|url_encode }}%20{{ url|url_encode|default('') }}" 
