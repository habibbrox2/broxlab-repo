                      color: white;
                      box-shadow: 0 10px 30px rgba(245, 87, 108, 0.3);">
            <div class="d-flex align-items-center mb-3">
              <div class="datetime-icon me-3">
                <i class="bi bi-calendar-event-fill fs-4"></i>
              </div>
