{# ==================== WEATHER WIDGET SECTION ==================== #}
{% include 'public/partials/weather-widget.twig' %}


<style>
@keyframes pulse {
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.1); }
  100% { opacity: 1; transform: scale(1); }
}

.live-dot {
  animation: pulse 2s infinite;
}

.hover-scale {
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.hover-scale:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.2) !important;
}

.datetime-section {
  position: relative;
  overflow: hidden;
}

.datetime-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(45deg, rgba(255,255,255,0.1) 0%, transparent 50%, rgba(255,255,255,0.1) 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.datetime-section:hover::before {
  opacity: 1;
}

.datetime-icon {
  background: rgba(255,255,255,0.2);
  padding: 0.5rem;
  border-radius: 50%;
  backdrop-filter: blur(10px);
}

@media (max-width: 991.98px) {
  .datetime-section {
    margin-bottom: 1rem;
  }
}
</style>

<script>
  function updateHomeDateTime() {
    const now = new Date();

    const banglaDate = new Intl.DateTimeFormat('bn-BD', {
      weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
    }).format(now);

    const banglaTime = new Intl.DateTimeFormat('bn-BD', {
      hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
      timeZone: 'Asia/Dhaka'
    }).format(now);

    const englishDate = new Intl.DateTimeFormat('en-US', {
      weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
    }).format(now);

    const englishTime = new Intl.DateTimeFormat('en-US', {
      hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true,
      timeZone: 'Asia/Dhaka'
    }).format(now);

    document.getElementById('bengali-date').textContent = banglaDate;
    document.getElementById('bengali-time').textContent = banglaTime;
    document.getElementById('english-date').textContent = englishDate;
    document.getElementById('english-time').textContent = englishTime;
  }

  updateHomeDateTime();
  setInterval(updateHomeDateTime, 1000);
</script>

{# ==================== LATEST UPDATES SECTION ==================== #}
<div class="container py-4 home-latest-section" id="latest-updates">
    {# ==================== TOP POSTS & SERVICES SLIDER ==================== #}
    <section class="home-top-slider mb-5" aria-labelledby="home-top-slider-title">
      <div class="home-top-slider__head">
        <div>
          <h3 id="home-top-slider-title" class="home-top-slider__title mb-1">Top Posts & Services</h3>
          <p class="home-top-slider__subtitle mb-0">Most viewed content picked from posts and services.</p>
        </div>
        <div class="home-top-slider__controls" aria-label="Top slider controls">
          <button type="button" class="home-top-slider__btn" data-top-prev aria-label="Previous slide">
            <i class="bi bi-chevron-left"></i>
          </button>
          <button type="button" class="home-top-slider__btn" data-top-next aria-label="Next slide">
            <i class="bi bi-chevron-right"></i>
          </button>
        </div>
      </div>

      <div class="home-top-slider__viewport">
        <div class="home-top-slider__track" data-top-track role="list" aria-label="Top posts and services">
          {% for p in top_posts|default([]) %}
            <a href="{{ ('/posts/' ~ p.id ~ '/' ~ (('' ~ (p.slug|default(p.id)))|url_encode))|absolute_url }}" class="home-top-card is-post" role="listitem" aria-label="Top post: {{ p.title }}">
              <div class="home-top-card__media">
                {% if p.image %}
                  <img src="{{ p.image|absolute_url }}" alt="{{ p.title|striptags }}" loading="lazy" decoding="async" width="320" height="180">
                {% else %}
                  <span class="home-top-card__placeholder"><i class="bi bi-newspaper"></i></span>
                {% endif %}
              </div>
              <div class="home-top-card__body">
                <span class="home-top-card__type">Post</span>
                <h4 class="home-top-card__title">{{ p.title }}</h4>
                <div class="home-top-card__meta">
                  <span class="home-top-card__rating"><i class="bi bi-star-fill"></i> {{ p.rating_average|default(0)|number_format(1) }} <small>({{ p.rating_total|default(0)|number_format }})</small></span>
                  {% if p.published_at is defined and p.published_at %}
                    <span><i class="bi bi-clock-history"></i> {{ p.published_at|time_ago }}</span>
                  {% endif %}
                </div>
              </div>
            </a>
          {% endfor %}

          {% for s in top_services|default([]) %}
            <a href="/services/{{ s.slug }}" class="home-top-card is-service" role="listitem" aria-label="Top service: {{ s.title|default(s.name) }}">
              <div class="home-top-card__media">
                {% if s.image %}
                  <img src="{{ s.image }}" alt="{{ s.title|default(s.name) }}" loading="lazy" decoding="async" width="320" height="180">
                {% else %}
                  <span class="home-top-card__placeholder"><i class="bi bi-award-fill"></i></span>
                {% endif %}
              </div>
              <div class="home-top-card__body">
                <span class="home-top-card__type">Service</span>
                <h4 class="home-top-card__title">{{ s.title|default(s.name) }}</h4>
                <div class="home-top-card__meta">
                  <span class="home-top-card__rating"><i class="bi bi-star-fill"></i> {{ s.rating_average|default(0)|number_format(1) }} <small>({{ s.rating_total|default(0)|number_format }})</small></span>
                  {% if s.published_at is defined and s.published_at %}
                    <span><i class="bi bi-clock-history"></i> {{ s.published_at|time_ago }}</span>
                  {% endif %}
                </div>
              </div>
            </a>
          {% endfor %}
        </div>
      </div>

      {% if (top_posts|default([])|length == 0) and (top_services|default([])|length == 0) %}
        <div class="home-top-slider__empty">Top content not available right now.</div>
      {% endif %}
    </section>

    {# ==================== HEADER WITH TAB NAVIGATION ==================== #}
    <div class="latest-updates-header mb-4">
      {# Section Title #}
      <div class="section-title-wrapper mb-3 mb-md-0">
        <h2 class="fw-bold m-0 display-6 display-md-5">
          <span class="text-primary border-bottom border-3 border-primary pb-2">Recent</span> Feed
        </h2>
      </div>
      
      {# Modern Tab Navigation #}
      <nav class="modern-tab-nav" role="tablist" aria-label="Feed tabs">
        <div class="tab-buttons-wrapper">
          <button class="tab-btn active" 
                  id="recent-tab" 
                  role="tab" 
                  aria-selected="true" 
                  aria-controls="latest-feed"
                  data-tab="recent">
            <i class="bi bi-clock-history" aria-hidden="true"></i>
            <span class="tab-label">Recent</span>
          </button>
          
          <button class="tab-btn" 
                  id="services-tab" 
                  role="tab" 
                  aria-selected="false" 
                  aria-controls="services-feed"
                  data-tab="services">
            <i class="bi bi-briefcase" aria-hidden="true"></i>
            <span class="tab-label">Services</span>
          </button>
        </div>
        
        {# Auto-rotate Timer #}
        <div class="tab-timer-wrapper">
          <small class="timer-text" id="auto-rotate-indicator">
            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
            <span class="d-none d-sm-inline">Auto: </span>
            <span id="rotate-timer">15</span>s
          </small>
        </div>
      </nav>
    </div>

    {# ==================== CONTENT CARDS SECTION ==================== #}
    <div id="latest-feed" class="feed-grid" role="feed" aria-label="Latest content feed">
      {% include 'partials/home-feed-items.twig' with {
        items: contents,
        start_index: ((current_page - 1) * homepage_feed_limit) + 1,
        empty_text: 'No content available at the moment.'
      } %}
    </div>

    {# ==================== SERVICES FEED (AJAX) ==================== #}
    <div id="services-feed" class="feed-grid d-none" role="feed" aria-label="Services feed">
      <!-- Populated via JavaScript -->
    </div>

    {# ==================== SHARED LOAD MORE PAGINATION ==================== #}
    <div id="feed-loading-section" class="mt-5 text-center">
      <button id="load-more-btn"
              type="button"
              class="btn btn-primary btn-lg rounded-pill px-5 py-3 shadow-lg fw-bold">
        <i class="bi bi-arrow-down-circle me-2"></i>
        <span id="load-more-btn-text">Load More Items</span>
      </button>
      <div class="mt-3 text-muted small">
        <i class="bi bi-info-circle me-2"></i>
        <span id="feed-page-status">Page {{ current_page }} of {{ total_pages }}</span>
      </div>
      <div id="feed-end-message" class="mt-3 text-center text-muted d-none">
        <i class="bi bi-check-circle fs-3 text-success mb-2 d-block"></i>
        <span>You've reached the end!</span>
      </div>
    </div>
</div>



{# ==================== JAVASCRIPT ==================== #}
<script>
(function(){
  const servicesTabBtn = document.getElementById('services-tab');
  const recentTabBtn = document.getElementById('recent-tab');
  const latestFeed = document.getElementById('latest-feed');
  const servicesFeed = document.getElementById('services-feed');
  const rotateTimerEl = document.getElementById('rotate-timer');
  const loadMoreSection = document.getElementById('feed-loading-section');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const loadMoreBtnText = document.getElementById('load-more-btn-text');
  const feedPageStatus = document.getElementById('feed-page-status');
  const feedEndMessage = document.getElementById('feed-end-message');

  let currentFeed = 'recent';
  let countdownTimer = null;
  let countdownValue = 15;
  let isTransitioning = false;
  const rotateAfterSeconds = 15;

  const feedStates = {
    recent: {
      name: 'recent',
      endpoint: '/api/feed/load-more?sort={{ sort|default('latest')|url_encode }}',
      container: latestFeed,
      buttonLabel: 'Load More Items',
      loadingLabel: 'Loading recent items...',
      currentPage: {{ current_page|default(1) }},
      totalPages: {{ total_pages|default(1) }},
      loadedOnce: true,
      isLoading: false
    },
    services: {
      name: 'services',
      endpoint: '/api/services/html',
      container: servicesFeed,
      buttonLabel: 'Load More Services',
      loadingLabel: 'Loading services...',
      currentPage: 0,
      totalPages: 1,
      loadedOnce: false,
      isLoading: false
    }
  };

  function setActiveTab(tabName) {
    if (tabName === 'recent') {
      recentTabBtn.classList.add('active');
      servicesTabBtn.classList.remove('active');
      recentTabBtn.setAttribute('aria-selected', 'true');
      servicesTabBtn.setAttribute('aria-selected', 'false');
    } else {
      servicesTabBtn.classList.add('active');
      recentTabBtn.classList.remove('active');
      servicesTabBtn.setAttribute('aria-selected', 'true');
      recentTabBtn.setAttribute('aria-selected', 'false');
    }
  }

  function getActiveState() {
    return feedStates[currentFeed];
  }

  function setButtonLoading(isLoading, label) {
    if (!loadMoreBtn || !loadMoreBtnText) return;

    loadMoreBtn.disabled = !!isLoading;
    loadMoreBtnText.textContent = label;
  }

  function updateLoadMoreUi() {
    const state = getActiveState();
    if (!state || !loadMoreSection || !loadMoreBtn || !feedPageStatus || !feedEndMessage) {
      return;
    }

    const hasMore = state.currentPage < state.totalPages;
    const showButton = state.isLoading || hasMore;

    loadMoreSection.classList.remove('d-none');
    loadMoreBtn.classList.toggle('d-none', !showButton);
    feedPageStatus.classList.toggle('d-none', !state.loadedOnce);
    feedEndMessage.classList.toggle('d-none', showButton || !state.loadedOnce);

    if (state.loadedOnce) {
      feedPageStatus.textContent = 'Page ' + Math.max(state.currentPage, 1) + ' of ' + Math.max(state.totalPages, 1);
    } else {
      feedPageStatus.textContent = 'Preparing feed...';
    }

    setButtonLoading(state.isLoading, state.isLoading ? state.loadingLabel : state.buttonLabel);
  }

  function setFeedLoading(feedName, isLoading) {
    const state = feedStates[feedName];
    if (!state) return;

    state.isLoading = isLoading;
    if (currentFeed === feedName) {
      updateLoadMoreUi();
    }
  }

  async function fetchFeedPage(feedName, page, options = {}) {
    const state = feedStates[feedName];
    if (!state || state.isLoading) return;

    const shouldReplace = options.replace === true;
    setFeedLoading(feedName, true);

    if (shouldReplace && state.container) {
      state.container.innerHTML = '<div class="loading-spinner" aria-live="polite"><div class="spinner-border spinner-border-sm text-primary me-2" role="status"><span class="visually-hidden">Loading</span></div>' + escapeHtml(state.loadingLabel) + '</div>';
    }

    try {
      const separator = state.endpoint.includes('?') ? '&' : '?';
      const res = await fetch(state.endpoint + separator + 'page=' + page, {
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      });
      if (!res.ok) throw new Error('Failed to load ' + feedName + ' feed');

      const data = await res.json();
      if (!data.success) throw new Error(data.error || ('Failed to load ' + feedName + ' feed'));

      if (shouldReplace) {
        state.container.innerHTML = data.html || '';
      } else {
        state.container.insertAdjacentHTML('beforeend', data.html || '');
      }

      state.currentPage = Number(data.current_page || page);
      state.totalPages = Number(data.total_pages || 1);
      state.loadedOnce = true;
    } catch (err) {
      if (shouldReplace && state.container) {
        state.container.innerHTML = '<div class="feed-empty-state"><div class="empty-state-content text-danger">' + escapeHtml(err.message || 'Failed to load feed.') + '</div></div>';
      }
      console.error(err);
    } finally {
      setFeedLoading(feedName, false);
    }
  }

  function resetCountdown() {
    countdownValue = rotateAfterSeconds;
    if (rotateTimerEl) rotateTimerEl.textContent = countdownValue;
  }

  function startCountdown() {
    resetCountdown();
    if (countdownTimer) clearInterval(countdownTimer);
    
    countdownTimer = setInterval(() => {
      countdownValue--;
      if (rotateTimerEl) rotateTimerEl.textContent = countdownValue;
      
      if (countdownValue <= 0) {
        clearInterval(countdownTimer);
        rotateFeeds();
      }
    }, 1000);
  }

  function stopCountdown() {
    if (countdownTimer) clearInterval(countdownTimer);
  }

  function rotateFeeds() {
    if (isTransitioning) return;
    
    if (currentFeed === 'recent') {
      showFeed('services');
    } else {
      showFeed('recent');
    }
  }

  function showFeed(feedName) {
    if (isTransitioning || currentFeed === feedName) return;

    const currentState = getActiveState();
    const nextState = feedStates[feedName];
    if (!currentState || !nextState) return;

    isTransitioning = true;
    currentState.container.classList.add('fade-out');

    setTimeout(async () => {
      currentState.container.classList.add('d-none');
      currentState.container.classList.remove('fade-out');
      nextState.container.classList.remove('d-none');
      currentFeed = feedName;
      setActiveTab(feedName);
      updateLoadMoreUi();

      if (!nextState.loadedOnce) {
        await fetchFeedPage(feedName, 1, { replace: true });
      }

      updateLoadMoreUi();
      startCountdown();
      isTransitioning = false;
    }, 600);
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/[&<>"']/g, function(ch){
      return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\'':'&#39;'}[ch]);
    });
  }

  // Event listeners
  if (servicesTabBtn) {
    servicesTabBtn.addEventListener('click', function(e){
      e.preventDefault();
      stopCountdown();
      if (currentFeed !== 'services') {
        showFeed('services');
      } else {
        startCountdown();
      }
    });
  }

  if (recentTabBtn) {
    recentTabBtn.addEventListener('click', function(e){
      e.preventDefault();
      stopCountdown();
      if (currentFeed !== 'recent') {
        showFeed('recent');
      } else {
        startCountdown();
      }
    });
  }

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', function() {
      const state = getActiveState();
      if (!state || state.isLoading || state.currentPage >= state.totalPages) {
        updateLoadMoreUi();
        return;
      }

      stopCountdown();
      fetchFeedPage(currentFeed, state.currentPage + 1).finally(() => {
        updateLoadMoreUi();
        startCountdown();
      });
    });
  }

  // Start auto-rotate
  window.addEventListener('load', function() {
    updateLoadMoreUi();
    setTimeout(() => startCountdown(), 1000);
  });
})();

(function(){
  const sliderRoot = document.querySelector('.home-top-slider');
  if (!sliderRoot) return;

  const track = sliderRoot.querySelector('[data-top-track]');
  const prevBtn = sliderRoot.querySelector('[data-top-prev]');
  const nextBtn = sliderRoot.querySelector('[data-top-next]');
  if (!track || !prevBtn || !nextBtn) return;

  const getStep = () => {
    const firstCard = track.querySelector('.home-top-card');
    if (!firstCard) return 320;
    const styles = window.getComputedStyle(track);
    const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
    return Math.round(firstCard.getBoundingClientRect().width + gap);
  };

  const goNext = () => {
    const maxScrollLeft = Math.max(0, track.scrollWidth - track.clientWidth);
    if (track.scrollLeft >= maxScrollLeft - 5) {
      track.scrollTo({ left: 0, behavior: 'smooth' });
      return;
    }
    track.scrollBy({ left: getStep(), behavior: 'smooth' });
  };

  const goPrev = () => {
    if (track.scrollLeft <= 5) {
      track.scrollTo({ left: Math.max(0, track.scrollWidth - track.clientWidth), behavior: 'smooth' });
      return;
    }
    track.scrollBy({ left: -getStep(), behavior: 'smooth' });
  };

  prevBtn.addEventListener('click', goPrev);
  nextBtn.addEventListener('click', goNext);

  let autoTimer = null;
  const startAuto = () => {
    if (autoTimer) clearInterval(autoTimer);
    autoTimer = setInterval(goNext, 5000);
  };
  const stopAuto = () => {
    if (autoTimer) clearInterval(autoTimer);
    autoTimer = null;
  };

  sliderRoot.addEventListener('mouseenter', stopAuto);
  sliderRoot.addEventListener('mouseleave', startAuto);
  sliderRoot.addEventListener('touchstart', stopAuto, { passive: true });
  sliderRoot.addEventListener('touchend', startAuto, { passive: true });

  startAuto();
})();
</script>

