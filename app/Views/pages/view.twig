{% extends"layout.twig" %}
{% block title %}{{ page.title }} | {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% block meta_description %}{{ page.excerpt|default(page.content|striptags|slice(0, 160)) }}{% endblock %}
{% block og_image %}{{ page.featured_image|default(page.image|default(app_settings.site_logo)) }}{% endblock %}
{% block og_type %}website{% endblock %}
{% set breadcrumbs = [
 { label: 'Pages', url: '/pages', icon: 'file' },
 { label: page.title|slice(0, 40) ~ (page.title|length > 40 ? '...' : ''), icon: 'file-text' }
] %}
{% set page_image = page.featured_image|default(page.image|default(app_settings.site_logo))|absolute_url %}
{% set page_schema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 'url': current_url,
 'name': page.title,
 'description': page.content|striptags|slice(0, 160),
 'image': page_image,
 'datePublished': page.created_at|date('c'),
 'publisher': {
 '@type': 'Organization',
 'name': app_settings.site_name,
 'logo': {
 '@type': 'ImageObject',
 'url': app_settings.site_logo|absolute_url
 }
 }
} %}
{% if page.updated_at %}
 {% set page_schema = page_schema|merge({'dateModified': page.updated_at|date('c')}) %}
{% endif %}
{% block schema %}
 <script type="application/ld+json">
{{ page_schema|schema_json }}
 </script>
{% endblock %}
{% block content %}
 {# Hero Header Section #}
 <section class="relative overflow-hidden mb-5">
 <div class="position-absolute top-0 start-0 w-full h-full opacity-10"
 aria-hidden="true">
 <div class="absolute rounded-full w-64 h-64 -top-32 -left-32 bg-white/5"></div>
 <div class="absolute rounded-full w-48 h-48 -bottom-24 -right-24 bg-white/5"></div>
 </div>
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 items-center">
 <div class="lg:col-span-8">
 <h1 class="text-3xl font-bold text-white mb-3 text-shadow-lg">{{ page.title }}</h1>
 {# Meta Information #}
 <div class="flex flex-wrap gap-3 mb-3">
 {% if page.created_at %}
 <div class="text-white">
 <i class="lucide lucide-calendar-check mr-1"></i>
 <time datetime="{{ page.created_at|date("Y-m-d") }}">
 {{ page.created_at|date("F d, Y") }}
 </time>
 </div>
 {% endif %}
 </div>
 {# Categories & Tags #}
 <div class="flex flex-wrap gap-2">
 {% if page.categories %}
 {% for cat in page.categories %}
 <a href="/category/{{ cat.slug }}"
 class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-white text-emerald-600 no-underline px-3 py-2">
 <i class="lucide lucide-folder mr-1"></i>{{ cat.name }}
 </a>
 {% endfor %}
 {% endif %}
 {% if page.tags %}
 {% for tag in page.tags %}
 <a href="/tag/{{ tag.slug }}"
 class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-white bg-opacity-75 text-slate-900 no-underline px-3 py-2">
 <i class="lucide lucide-tag mr-1"></i>{{ tag.name }}
 </a>
 {% endfor %}
 {% endif %}
 </div>
 </div>
 <div class="lg:col-span-4 text-center lg:text-right mt-4 lg:mt-0">
 <div class="inline-block p-4 bg-white/10 rounded-full">
 <i class="lucide lucide-file-text text-white text-4xl"></i>
 </div>
 </div>
 </div>
 </div>
 </section>
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-5">
 {# Quick Access Panel #}
 {% include 'partials/quick-access.twig' with { context_type: 'page', context_id: page.id } %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 {# Main Content Column #}
 <div class="lg:col-span-8">
 {# Page Content Card #}
 <article class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4">
 <div class="p-4 md:p-5">
 <div class="content-wrapper lh-lg">{{ page.content|raw }}</div>
 </div>
 </article>
 {% include 'partials/content-rating.twig' with { content_type: 'page', content_id: page.id } %}
 {# Share Section #}
 <div class="mb-4">
 {% include 'partials/share.twig' with {
 url: current_url,
 title: page.title,
 description: page.content|striptags|slice(0, 100)
 } %}
 </div>
 {# Previous / Next Navigation #}
 <nav class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4"
 aria-label="Page navigation">
 <div class="p-4 p-3">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-2">
 <div class="col-span-6">
 {% if previousPage %}
 <a href="/pages/view/{{ previousPage.slug }}"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition transition-ghost-success w-full rounded-full"
 aria-label="Previous page: {{ previousPage.title }}">
 <i class="lucide lucide-arrow-left mr-2"></i>
 <span class="hidden d-md-inline">Previous</span>
 </a>
 {% else %}
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100 w-full rounded-full" disabled>
 <i class="lucide lucide-arrow-left mr-2"></i>
 <span class="hidden d-md-inline">Previous</span>
 </button>
 {% endif %}
 </div>
 <div class="col-span-6">
 {% if nextPage %}
 <a href="/pages/view/{{ nextPage.slug }}"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition transition-ghost-success w-full rounded-full"
 aria-label="Next page: {{ nextPage.title }}">
 <span class="hidden d-md-inline">Next</span>
 <i class="lucide lucide-arrow-right ml-2"></i>
 </a>
 {% else %}
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100 w-full rounded-full" disabled>
 <span class="hidden d-md-inline">Next</span>
 <i class="lucide lucide-arrow-right ml-2"></i>
 </button>
 {% endif %}
 </div>
 </div>
 </div>
 </nav>
 {# Comments Section #}
 <section id="comments-wrapper" class="mb-4" aria-labelledby="comments-title">
 <h2 id="comments-title" class="sr-only">Comments Section</h2>
 {% include 'comments/comments.twig' with { content_type: 'page', content_id: page.id, comments: comments } %}
 </section>
 {# Related Pages Section #}
 {% include 'partials/related-section.twig' with {
 items: relatedPages,
 title: 'Related Pages',
 type: 'page',
 gradient: 'linear-gradient(135deg, #10b981 0%, #06b6d4 100%)',
 view_all_url: '/pages',
 id: 'related-pages-title',
 variant: 'pro'
 } %}
 </div>
 {# Sidebar #}
 <aside class="lg:col-span-4" role="complementary" aria-label="Sidebar">
 <div>
 {# Quick Navigation #}
 <nav class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4"
 aria-labelledby="quick-nav-title">
 <div class="border-b border-slate-200 px-4 py-3 bg-indigo-600 text-white p-3 border-0">
 <h2 id="quick-nav-title" class="mb-0 h6 font-bold">
 <i class="lucide lucide-list mr-2"></i>Quick Navigation
 </h2>
 </div>
 <div class="p-4 p-3">
 <ul class="list-none pl-0 mb-0 small">
 <li class="mb-2">
 <a href="#comments-wrapper"
 class="no-underline flex items-center p-2 rounded hover-bg-slate-100">
 <i class="lucide lucide-message-circle mr-2 text-indigo-600"></i>
 <span>Comments</span>
 </a>
 </li>
 {% if relatedPages %}
 <li class="mb-2">
 <a href="#related-pages-title"
 class="no-underline flex items-center p-2 rounded hover-bg-slate-100">
 <i class="lucide lucide-link mr-2 text-emerald-600"></i>
 <span>Related Pages</span>
 </a>
 </li>
 {% endif %}
 <li class="mb-0">
 <a href="/pages"
 class="no-underline flex items-center p-2 rounded hover-bg-slate-100">
 <i class="lucide lucide-grid-3x3 mr-2 text-slate-600"></i>
 <span>All Pages</span>
 </a>
 </li>
 </ul>
 </div>
 </nav>
 {# Categories Widget #}
 {% if page.categories and page.categories|length > 0 %}
 <section class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4"
 aria-labelledby="categories-title">
 <div class="border-b border-slate-200 px-4 py-3 bg-amber-500 text-white p-3 border-0">
 <h2 id="categories-title" class="mb-0 h6 font-bold">
 <i class="lucide lucide-folder mr-2"></i>Categories
 </h2>
 </div>
 <div class="p-4 p-3">
 <div class="flex flex-wrap gap-2">
 {% for cat in page.categories %}
 <a href="/category/{{ cat.slug }}"
 class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-100 text-surface-dark p-2 no-underline hover-bg-amber-500">
 <i class="lucide lucide-folder-open mr-1"></i>{{ cat.name }}
 </a>
 {% endfor %}
 </div>
 </div>
 </section>
 {% endif %}
 {# Tags Cloud #}
 {% if page.tags and page.tags|length > 0 %}
 <section class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4"
 aria-labelledby="tags-title">
 <div class="border-b border-slate-200 px-4 py-3 bg-sky-500 text-white p-3 border-0">
 <h2 id="tags-title" class="mb-0 h6 font-bold">
 <i class="lucide lucide-tags mr-2"></i>Tags
 </h2>
 </div>
 <div class="p-4 p-3">
 <div class="flex flex-wrap gap-2">
 {% for tag in page.tags %}
 <a href="/tag/{{ tag.slug }}"
 class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-100 text-surface-dark p-2 no-underline hover-bg-sky-500">
 <i class="lucide lucide-tag mr-1"></i>{{ tag.name }}
 </a>
 {% endfor %}
 </div>
 </div>
 </section>
 {% endif %}
 {# Page Stats Card #}
 <section class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl"
 aria-labelledby="stats-title">
 <div class="border-b border-slate-200 px-4 py-3 bg-gradient-to-r from-indigo-500 to-purple-600 text-white p-3 border-0">
 <h2 id="stats-title" class="mb-0 h6 font-bold">
 <i class="lucide lucide-trending-up mr-2"></i>Page Statistics
 </h2>
 </div>
 <div class="p-4 p-3">
 <div class="flex flex-column gap-3">
 {% if page.created_at %}
 <div class="flex items-center justify-between">
 <span class="text-slate-500 small">
 <i class="lucide lucide-calendar-check text-sky-600 mr-1"></i>Published
 </span>
 <span class="font-bold small">{{ page.created_at|date("M d, Y") }}</span>
 </div>
 {% endif %}
 <div class="flex items-center justify-between">
 <span class="text-slate-500 small">
 <i class="lucide lucide-calendar-check text-sky-600 mr-1"></i>Published
 </span>
 <span class="font-bold small">{{ page.created_at|date("M d, Y") }}</span>
 </div>
 {% endif %}
 </div>
 </div>
 </section>
 </div>
 </aside>
 </div>
 </div>
 {# Custom Styles #}
 {# JavaScript #}
 <script>
 // Smooth scroll for anchor links
 document.querySelectorAll('a[href^="#"]').forEach(anchor => {
 anchor.addEventListener('click', function (e) {
 const targetId = this.getAttribute('href');
 if (targetId === '#') return;

 const targetElement = document.querySelector(targetId);
 if (targetElement) {
 e.preventDefault();
 targetElement.scrollIntoView({
 behavior: 'smooth',
 block: 'start'
 });

 // Update focus for accessibility
 targetElement.setAttribute('tabindex', '-1');
 targetElement.focus();
 }
 });
 });

 // Add loading state to external links
 document.querySelectorAll('.content-wrapper a[href^="http"]').forEach(link => {
 link.setAttribute('target', '_blank');
 link.setAttribute('rel', 'noopener noreferrer');
 link.innerHTML += ' <i class="lucide lucide-external-link small"></i>';
 });
 </script>
{% endblock %}






