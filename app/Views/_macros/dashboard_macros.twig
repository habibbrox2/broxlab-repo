 FILE: templates/_macros/dashboard_macros.twig
 Reusable UI helpers for dashboards
 ============================ #}
{% macro status_badge(status) %}
 {% set s = status|lower %}
 {% set cls =
 s in ['approved','active','success'] ? 'bg-green-100 text-green-800 border border-green-300' :
 (s in ['pending','in review','processing'] ? 'bg-amber-100 text-amber-800 border border-amber-300' :
 (s in ['rejected','inactive','failed'] ? 'bg-red-100 text-red-800 border border-red-300' : 'bg-neutral-100 text-neutral-800 border border-neutral-300'))
 %}
 <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold {{ cls }}">{{ status }}</span>
{% endmacro %}

{% macro empty_state(title, subtitle) %}
 <div class="text-center border border-neutral-200 rounded-xl p-6 bg-neutral-50">
 <div class="text-5xl mb-3">ðŸ“­</div>
 <h5 class="text-lg font-bold text-neutral-800 mb-1">{{ title }}</h5>
 <p class="text-sm text-neutral-500 mb-0">{{ subtitle }}</p>
 </div>
{% endmacro %}

