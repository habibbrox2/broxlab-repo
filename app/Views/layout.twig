<!DOCTYPE html>
<html lang="{{ current_lang }}" data-lang="{{ current_lang }}" data-theme="light" id="app-html">
<script>
// Apply saved theme immediately to prevent flash (runs before rendering)
(function(){try{var t=localStorage.getItem('broxbhai-theme');if(!t){t=window.matchMedia&&window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'}document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=t}catch(e){}})();
</script>

{% import '_macros/flash.twig' as flash_macros %}

{# ─────────────────────────────────────────────
   HEAD
   ───────────────────────────────────────────── #}
<head>

  {# == Encoding & Viewport == #}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  {# == Page Title == #}
  <title>{% block title %}{{ app_settings.meta_title|default(app_settings.site_name ~ ' | Official Website') }}{% endblock %}</title>

  {# == Primary SEO == #}
  <meta name="description"  content="{% block meta_description %}{{ app_settings.meta_description|default('Welcome to ' ~ app_settings.site_name) }}{% endblock %}">
  <meta name="keywords"     content="{{ app_settings.meta_keywords|default(app_settings.site_name ~ ', mobile, tech, news') }}">
  <meta name="author"       content="{{ app_settings.site_name }}">
  <meta name="creator"      content="{{ app_settings.site_name }}">
  <meta name="publisher"    content="{{ app_settings.site_name }}">

  {# == Crawling Directives == #}
  <meta name="robots"    content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <meta name="bingbot"   content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">

  {# == Canonical & Pagination == #}
  <link rel="canonical" href="{{ canonical_url|default(current_url) }}">
  {% if pagination_next_url is defined and pagination_next_url %}
    <link rel="next" href="{{ pagination_next_url }}">
  {% endif %}
  {% if pagination_prev_url is defined and pagination_prev_url %}
    <link rel="prev" href="{{ pagination_prev_url }}">
  {% endif %}

  {# == Favicon & PWA == #}
  <link rel="icon"             type="image/x-icon" href="{{ app_settings.favicon|absolute_url }}">
  <link rel="shortcut icon"                         href="{{ app_settings.favicon|default('/assets/favicon.ico')|absolute_url }}">
  <link rel="apple-touch-icon"                      href="{{ app_settings.site_logo|absolute_url }}">
  <meta name="theme-color"           content="#0d6efd">
  <meta name="msapplication-TileColor" content="#0d6efd">
  <meta name="mobile-web-app-capable"        content="yes">
  <meta name="apple-mobile-web-app-title"    content="{{ app_settings.site_name }}">
  <meta name="application-name"              content="{{ app_settings.site_name }}">

  {# == Open Graph == #}
  <meta property="og:type"         content="{% block og_type %}website{% endblock %}">
  <meta property="og:url"          content="{{ canonical_url|default(current_url) }}">
  <meta property="og:site_name"    content="{{ app_settings.site_name }}">
  <meta property="og:title"        content="{{ block('title')|striptags|default(app_settings.site_name) }}">
  <meta property="og:description"  content="{{ app_settings.meta_description|default('Welcome to ' ~ app_settings.site_name) }}">
  <meta property="og:image"        content="{% block og_image %}{{ app_settings.site_logo|default('/assets/images/default-og-image.png')|absolute_url }}{% endblock %}">
  <meta property="og:image:width"  content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type"   content="image/png">
  <meta property="og:locale"           content="{{ current_lang == 'bn' ? 'bn_BD' : 'en_US' }}">
  <meta property="og:locale:alternate" content="bn_BD">
  {% if app_settings.facebook_app_id %}
    <meta property="fb:app_id" content="{{ app_settings.facebook_app_id }}">
  {% endif %}

  {# Article-specific OG tags #}
  {% if og_article_author    is defined %}<meta property="article:author"           content="{{ og_article_author }}">{% endif %}
  {% if og_article_publisher is defined %}<meta property="article:publisher"         content="{{ og_article_publisher }}">{% endif %}
  {% if og_published_time    is defined %}<meta property="article:published_time"    content="{{ og_published_time }}">{% endif %}
  {% if og_modified_time     is defined %}<meta property="article:modified_time"     content="{{ og_modified_time }}">{% endif %}
  {% if og_section           is defined %}<meta property="article:section"           content="{{ og_section }}">{% endif %}
  {% if og_tags is defined and og_tags is iterable %}
    {% for tag in og_tags %}
      <meta property="article:tag" content="{{ tag }}">
    {% endfor %}
  {% endif %}

  {# == Twitter Card == #}
  <meta name="twitter:card"        content="summary_large_image">
  <meta name="twitter:title"       content="{{ block('title')|striptags|default(app_settings.site_name) }}">
  <meta name="twitter:description" content="{{ app_settings.meta_description|default('Welcome to ' ~ app_settings.site_name) }}">
  <meta name="twitter:image"       content="{{ app_settings.site_logo|default('/assets/images/default-og-image.png')|absolute_url }}">
  {% if app_settings.twitter_handle %}<meta name="twitter:creator" content="@{{ app_settings.twitter_handle }}">{% endif %}
  {% if app_settings.twitter_site  %}<meta name="twitter:site"    content="@{{ app_settings.twitter_site }}">{% endif %}

  {# == Language & Localisation == #}
  <meta name="language" content="{{ current_lang == 'bn' ? 'Bengali' : 'English' }}">
  <link rel="alternate" hreflang="en"        href="{{ canonical_url|default(current_url) }}">
  <link rel="alternate" hreflang="bn"        href="{{ current_url }}" lang="bn">
  <link rel="alternate" hreflang="x-default" href="{{ canonical_url|default(current_url) }}">

  {# == Page Timestamps == #}
  {% if page_date_published is defined %}<meta name="date"     content="{{ page_date_published }}">{% endif %}
  {% if page_date_modified  is defined %}<meta name="modified" content="{{ page_date_modified }}">{% endif %}

  {# == CSRF & Auth == #}
  <meta name="csrf-token" content="{{ csrf_token }}">
  {% if auth_user.id %}<meta name="user-id" content="{{ auth_user.id }}">{% endif %}

  {# ── Performance: DNS-prefetch & Preconnect ── #}
  <link rel="preconnect"    href="https://fonts.googleapis.com">
  <link rel="preconnect"    href="https://fonts.gstatic.com" crossorigin="anonymous">
  <link rel="preconnect"    href="https://cdn.jsdelivr.net">
  <link rel="preconnect"    href="https://www.googletagmanager.com">
  <link rel="preconnect"    href="https://www.gstatic.com" crossorigin="anonymous">
  <link rel="dns-prefetch"  href="https://fcm.googleapis.com">
  <link rel="dns-prefetch"  href="https://firebaseinstallations.googleapis.com">

  {# ── Google Fonts (preload + swap → no FOIT) ── #}
  <link rel="preload" as="style"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        onload="this.onload=null;this.rel='stylesheet'"
        fetchpriority="low">
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </noscript>

  {# ── CSS: Critical (render-blocking) ── #}
  {% set assets_version = app_settings.asset_version is defined and app_settings.asset_version
      ? app_settings.asset_version
      : ('b' ~ 'now'|date('U')) %}

  <link rel="stylesheet" href="{{ asset('/assets/css/dist/tailwind-public.css') }}?v={{ assets_version }}">

  {# ── CSS: Deferred (non-critical, loaded async via print trick) ── #}
  {% set deferred_stylesheets = [
    asset('/cdn/css/lucide/lucide.css'),
    asset('/assets/css/brox-polish.css'),
    asset('/assets/ai/css/assistant.css'),
    asset('/assets/datepicker/datepicker.css'),
    'https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css'
  ] %}
  {% for href in deferred_stylesheets %}
    <link rel="stylesheet" href="{{ href }}{% if not 'sweetalert2' in href %}?v={{ assets_version }}{% endif %}"
          media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="{{ href }}{% if not 'sweetalert2' in href %}?v={{ assets_version }}{% endif %}"></noscript>
  {% endfor %}

  {% block extra_styles %}{% endblock %}
  {% block extra_head %}{% endblock %}

  {# ── JSON-LD: Organization (site-wide) ── #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ (url ~ '#organization')|json_encode|raw }},
    "name": {{ app_settings.site_name|json_encode|raw }},
    "url": {{ url|json_encode|raw }},
    "logo": {
      "@type": "ImageObject",
      "url": {{ app_settings.site_logo|default(url ~ 'assets/images/default-logo.png')|absolute_url|json_encode|raw }},
      "width": 250,
      "height": 100
    },
    "description": {{ app_settings.meta_description|default('Mobile reviews, tech news, and gadget insights')|json_encode|raw }},
    "sameAs": [
      "https://www.facebook.com/{{ app_settings.social_facebook|default('') }}",
      "https://twitter.com/{{ app_settings.social_twitter|default('') }}",
      "https://www.instagram.com/{{ app_settings.social_instagram|default('') }}",
      "https://www.linkedin.com/company/{{ app_settings.company_name|default('') }}"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "Customer Support",
      {% if app_settings.contact_phone %}"telephone": {{ app_settings.contact_phone|json_encode|raw }},{% endif %}
      "email": {{ app_settings.contact_email|default('support@example.com')|json_encode|raw }}
    }
  }
  </script>

  {# ── JSON-LD: WebPage (site-wide) ── #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": {{ canonical_url|default(current_url)|json_encode|raw }},
    "url": {{ canonical_url|default(current_url)|json_encode|raw }},
    "name": {{ block('title')|striptags|json_encode|raw }},
    "description": {{ app_settings.meta_description|json_encode|raw }},
    "image": {
      "@type": "ImageObject",
      "url": {{ app_settings.site_logo|default('/assets/images/default-og-image.png')|absolute_url|json_encode|raw }},
      "width": 1200,
      "height": 630
    },
    "datePublished": "{{ page_date_published|default('now')|date('c') }}",
    "dateModified": "{{ page_date_modified|default('now')|date('c') }}",
    "inLanguage": "{{ current_lang == 'bn' ? 'bn-BD' : 'en-US' }}",
    "isPartOf": {
      "@type": "WebSite",
      "@id": {{ url|json_encode|raw }},
      "name": {{ app_settings.site_name|json_encode|raw }},
      "url": {{ url|json_encode|raw }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ (url ~ 'search?q={search_term_string}')|json_encode|raw }}
        },
        "query-input": "required name=search_term_string"
      }
    },
    "publisher": {
      "@type": "Organization",
      "@id": {{ (url ~ '#organization')|json_encode|raw }}
    },
    "potentialAction": {
      "@type": "ReadAction",
      "target": "{{ canonical_url|default(current_url) }}"
    }
  }
  </script>

  {# ── JSON-LD: LocalBusiness (site-wide) ── #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": {{ app_settings.site_name|json_encode|raw }},
    "url": {{ url|json_encode|raw }},
    "logo": {{ app_settings.site_logo|absolute_url|json_encode|raw }},
    "description": {{ app_settings.meta_description|default('Mobile reviews, tech news, and gadget insights')|json_encode|raw }},
    "image": {{ app_settings.site_logo|default(url ~ 'assets/images/default-og-image.png')|absolute_url|json_encode|raw }},
    {% if app_settings.business_address %}
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ app_settings.business_address|json_encode|raw }},
      "addressCountry": {{ app_settings.business_country|default('BD')|json_encode|raw }}
    },
    {% endif %}
    {% if app_settings.contact_phone  %}"telephone": {{ app_settings.contact_phone|json_encode|raw }},{% endif %}
    {% if app_settings.contact_email  %}"email": {{ app_settings.contact_email|json_encode|raw }},{% endif %}
    "sameAs": [
      "https://www.facebook.com/{{ app_settings.social_facebook|default('') }}",
      "https://twitter.com/{{ app_settings.social_twitter|default('') }}",
      "https://www.instagram.com/{{ app_settings.social_instagram|default('') }}"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": 4.8,
      "ratingCount": {{ app_settings.rating_count|default(1000)|json_encode|raw }}
    }
  }
  </script>

</head>

{# ─────────────────────────────────────────────
   BODY
   ───────────────────────────────────────────── #}
<body role="application" class="min-h-screen flex flex-col">

  {# ── JSON-LD: BreadcrumbList ── #}
  {% if breadcrumbs is defined and breadcrumbs|length > 0 %}
    {% set sanitized_breadcrumbs = breadcrumbs|sanitize_breadcrumbs %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ url }}" }
        {% for crumb in sanitized_breadcrumbs %}
        ,{
          "@type": "ListItem",
          "position": {{ loop.index + 1 }},
          "name": {{ crumb.label|json_encode|raw }},
          "item": {{ (loop.last ? canonical_url : crumb.url)|json_encode|raw }}
        }
        {% endfor %}
      ]
    }
    </script>
  {% endif %}

  {% block schema %}{% endblock %}

    {# ── Preloader ── #}
  <div id="sitePreloader" role="status" aria-label="Loading"
       class="fixed inset-0 z-[99999] flex flex-col items-center justify-center
              bg-white dark:bg-slate-950
              transition-all duration-500 ease-out
              motion-reduce:transition-none">
    <div class="relative flex flex-col items-center gap-5">
      {# Animated logo icon #}
      <div class="relative flex items-center justify-center w-16 h-16">
        <div class="absolute inset-0 rounded-full border-[3px] border-slate-100 dark:border-slate-800"></div>
        <div class="absolute inset-0 rounded-full border-[3px] border-transparent border-t-indigo-500
                    animate-[preloader-spin_0.8s_linear_infinite]
                    motion-reduce:animate-none"></div>
        <div class="absolute inset-[3px] rounded-full border-[3px] border-transparent border-r-violet-400
                    animate-[preloader-spin_1.2s_linear_infinite_reverse]
                    motion-reduce:animate-none"></div>
        <i class="lucide lucide-sparkles w-6 h-6 text-indigo-600 dark:text-indigo-400"></i>
      </div>
      {# Loading dots #}
      <div class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-[preloader-dot_1.4s_ease-in-out_infinite_both] motion-reduce:animate-none"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-[preloader-dot_1.4s_ease-in-out_infinite_both_0.16s] motion-reduce:animate-none"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-[preloader-dot_1.4s_ease-in-out_infinite_both_0.32s] motion-reduce:animate-none"></span>
      </div>
    </div>
    {# Loading bar #}
    <div class="absolute bottom-0 left-0 right-0 h-[3px] bg-slate-100 dark:bg-slate-800">
      <div id="preloaderBar"
           class="h-full bg-gradient-to-r from-indigo-500 via-violet-500 to-indigo-500
                  transition-all duration-[3s] ease-out motion-reduce:transition-none"
           style="width:0%"></div>
    </div>
  </div>

  {# ── Accessibility: Skip link ── #}
  <a href="#main-content"
     class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-50 focus:px-4 focus:py-3 focus:bg-white focus:text-indigo-600 focus:outline-none focus:rounded-br-lg"
     tabindex="0">
    <span data-i18n="Skip to main content">Skip to main content</span>
  </a>

  {# ── Header ── #}
  {% include 'partials/header-v2.twig' %}

  {# ── Main content ── #}
  <main id="main-content" role="main" class="relative isolate flex-1">

    {# Flash messages #}
    {% if suppress_layout_flash is not defined or not suppress_layout_flash %}
      {{ flash_macros.render_flash(flash_message|default(flash|default(null))) }}
    {% endif %}

    {# Breadcrumb navigation #}
    {% if breadcrumbs is defined and breadcrumbs|length > 0 %}
      <nav aria-label="Breadcrumb" class="py-3">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <ol class="flex flex-wrap items-center gap-1.5 rounded-3xl border border-slate-200/80 bg-white/85 px-4 py-3 text-sm text-slate-500 shadow-[0_12px_40px_rgba(15,23,42,0.06)] backdrop-blur-xl"
              itemscope itemtype="https://schema.org/BreadcrumbList">

            {# Home crumb #}
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="/" itemprop="item" title="Home"
                 class="inline-flex items-center gap-1 text-indigo-600 hover:text-indigo-800 transition-colors">
                <i class="lucide lucide-house" aria-hidden="true"></i>
                <span itemprop="name">{{ 'Home'|trans }}</span>
              </a>
              <meta itemprop="position" content="1">
            </li>

            {# Dynamic crumbs #}
            {% for crumb in breadcrumbs %}
              {% set position = loop.index + 1 %}
              <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"
                  class="flex items-center {% if loop.last %}text-slate-700 font-medium{% endif %}"
                  {% if loop.last %}aria-current="page"{% endif %}>

                <span class="mx-1.5 text-slate-300" aria-hidden="true">/</span>

                {% if loop.last %}
                  <span itemprop="item" class="inline-flex items-center gap-1">
                    {% if crumb.icon %}<i class="lucide lucide-{{ crumb.icon }}" aria-hidden="true"></i>{% endif %}
                    <span itemprop="name">{{ crumb.label }}</span>
                  </span>
                  <meta itemprop="url"      content="{{ canonical_url }}">
                {% else %}
                  <a href="{{ crumb.url }}" itemprop="item"
                     class="inline-flex items-center gap-1 text-indigo-600 hover:text-indigo-800 transition-colors">
                    {% if crumb.icon %}<i class="lucide lucide-{{ crumb.icon }}" aria-hidden="true"></i>{% endif %}
                    <span itemprop="name">{{ crumb.label }}</span>
                  </a>
                {% endif %}
                <meta itemprop="position" content="{{ position }}">
              </li>
            {% endfor %}

          </ol>
        </div>
      </nav>
    {% endif %}

    {# Page content #}
    {% block content %}
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
        <div class="lg:w-2/3 mx-auto">
          <h1>Welcome to {{ app_settings.site_name }}</h1>
          <p>This is the main content area. Extend this template in your pages.</p>
        </div>
      </div>
    {% endblock %}

  </main>

  {# ── Footer ── #}
  {% include 'partials/footer.twig' %}

  {# ── UI Widgets ── #}

  {# Scroll-to-top button #}
  <button id="scrollTopBtn"
          type="button"
          title="{{ 'Scroll to top of page'|trans }}"
          aria-label="{{ 'Scroll to top of page'|trans }}"
          data-i18n-title="Scroll to top of page"
          data-i18n-aria-label="Scroll to top of page"
          class="scroll-top-btn fixed bottom-20 right-5 z-40 hidden items-center justify-center w-11 h-11 rounded-full bg-indigo-600 text-white shadow-lg shadow-indigo-500/25 border border-indigo-400/30 hover:bg-indigo-700 focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 focus-visible:outline-none">
    <i class="lucide lucide-arrow-up w-5 h-5" aria-hidden="true"></i>
  </button>

  {# Push notification button #}
  <button id="enableNotificationsBtn"
          type="button"
          title="{{ 'Enable push notifications'|trans }}"
          aria-label="{{ 'Enable notifications'|trans }}"
          data-i18n-title="Enable push notifications"
          data-i18n-aria-label="Enable notifications"
          class="notif-permission-btn fixed bottom-[140px] right-5 z-40 hidden items-center justify-center w-11 h-11 rounded-full bg-indigo-600 text-white shadow-lg shadow-indigo-500/25 border border-indigo-400/30 hover:bg-indigo-700 focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 focus-visible:outline-none">
    <i class="lucide lucide-bell w-5 h-5" aria-hidden="true"></i>
  </button>

  {# Reading progress bar #}
  <div id="scrollProgress"
       role="progressbar"
       aria-label="Page scroll progress"
       aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"
       class="scroll-progress fixed top-0 left-0 z-[9999] h-[3px] w-0 bg-indigo-500 transition-none">
  </div>

  {# Page transition overlay #}
  <div id="pageTransitionOverlay"
       aria-hidden="true"
       class="fixed inset-0 z-[99998] pointer-events-none
              bg-white dark:bg-slate-950
              transition-all duration-300 ease-out motion-reduce:transition-none"
       style="opacity:0">
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 via-transparent to-violet-500/5 dark:from-indigo-500/10 dark:to-violet-500/10"></div>
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center gap-3">
      <div class="w-8 h-8 rounded-full border-2 border-slate-200 dark:border-slate-700 border-t-indigo-500 animate-spin motion-reduce:animate-none"></div>
      <span class="text-xs font-medium text-slate-400 dark:text-slate-500">Loading...</span>
    </div>
  </div>

  {# ─────────────────────────────────────────────
     SCRIPTS
     ───────────────────────────────────────────── #}

  {# ── Inline: core UI behaviours (no deps, runs immediately) ── #}
  {# debounce/throttle are provided by shared/dom-helpers.js; delegateClick/change/keydown by shared/events.js #}
  <script src="{{ asset('/assets/js/shared/dom-helpers.js') }}"></script>
  <script src="{{ asset('/assets/js/shared/events.js') }}"></script>
  <script src="{{ asset('/assets/datepicker/datepicker.js') }}" defer></script>
  <script>
  (function () {
    'use strict';

    function scrollTop() {
      return window.pageYOffset || document.documentElement.scrollTop || 0;
    }

    /* ── 1. Scroll-to-top button ── */
    function initScrollTopBtn() {
      var btn = document.getElementById('scrollTopBtn');
      if (!btn) return;

      function sync() {
        var visible = scrollTop() > 180;
        btn.classList.toggle('flex',   visible);
        btn.classList.toggle('hidden', !visible);
        btn.setAttribute('aria-hidden', visible ? 'false' : 'true');
      }

      btn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
      window.addEventListener('scroll', sync, { passive: true });
      sync();
    }

    /* ── 2. Reading progress bar ── */
    function initProgressBar() {
      var bar = document.getElementById('scrollProgress');
      if (!bar) return;

      function update() {
        var scrolled  = scrollTop();
        var docH      = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
        var winH      = window.innerHeight;
        var maxScroll = docH - winH;
        var pct       = maxScroll > 0 ? Math.min((scrolled / maxScroll) * 100, 100) : 0;
        bar.style.width = pct + '%';
        bar.setAttribute('aria-valuenow', Math.round(pct));
      }

      window.addEventListener('scroll', throttle(update, 50), { passive: true });
      window.addEventListener('resize', debounce(update, 100), { passive: true });
      update();
    }

    /* ── 3. Scroll-triggered animations (IntersectionObserver) ── */
    function initScrollAnimations() {
      var els = document.querySelectorAll('.scroll-fade-in, .scroll-slide-up, .scroll-scale-in');
      if (!els.length) return;

      if (!('IntersectionObserver' in window)) {
        els.forEach(function (el) { el.classList.add('visible'); });
        return;
      }

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
        });
      }, { rootMargin: '0px 0px -60px 0px', threshold: 0.08 });

      els.forEach(function (el) { observer.observe(el); });
    }

    /* ── 4. Smooth anchor scrolling (offset for sticky header) ── */
    function initSmoothAnchors() {
      var header = document.querySelector('header[role="banner"]');

      document.addEventListener('click', function (e) {
        var link = e.target.closest('a[href^="#"]');
        if (!link) return;
        var id = link.getAttribute('href');
        if (!id || id === '#') return;
        var target = document.querySelector(id);
        if (!target) return;

        e.preventDefault();
        var offset  = (header ? header.offsetHeight : 0) + 12;
        var top     = target.getBoundingClientRect().top + window.pageYOffset - offset;
        window.scrollTo({ top: top, behavior: 'smooth' });
        target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      });
    }

    /* ── 5. Preloader hide ── */
    var preloaderHidden = false;
    function hidePreloader() {
      if (preloaderHidden) return;
      preloaderHidden = true;
      var preloader = document.getElementById('sitePreloader');
      if (!preloader) return;
      preloader.classList.add('preloader-hidden');
      // Remove from DOM after transition completes
      setTimeout(function () {
        preloader.style.display = 'none';
        preloader.removeAttribute('role');
      }, 600);
    }

    /* ── 6. Page transition overlay ── */
    function initPageTransitions() {
      var overlay = document.getElementById('pageTransitionOverlay');
      if (!overlay) return;

      document.addEventListener('click', function (e) {
        var link = e.target.closest('a:not([href^="#"]):not([href^="javascript"]):not([target="_blank"]):not([download])');
        if (!link) return;
        var href = link.getAttribute('href');
        if (!href || href.startsWith('mailto:') || href.startsWith('tel:') || href.indexOf('://') > -1 || href.startsWith('//')) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;

        try {
          if (new URL(href, window.location.origin).origin !== window.location.origin) return;
        } catch (_) { return; }

        overlay.classList.add('is-active');
      });

      window.addEventListener('pageshow', function () {
        overlay.classList.remove('is-active');
        // Re-hide preloader on bfcache restore
        hidePreloader();
      });
    }

    /* ── Init ── */
    function init() {
      // Animate preloader progress bar to 70% immediately
      var preloaderBar = document.getElementById('preloaderBar');
      if (preloaderBar) {
        requestAnimationFrame(function () {
          preloaderBar.style.width = '70%';
        });
      }

      initScrollTopBtn();
      initProgressBar();
      initScrollAnimations();
      initSmoothAnchors();
      initPageTransitions();

      // Hide preloader once everything is initialized
      hidePreloader();
    }

    // Start preloader bar animation early (before DOMContentLoaded)
    (function earlyProgress() {
      var bar = document.getElementById('preloaderBar');
      if (bar) {
        requestAnimationFrame(function () {
          bar.style.width = '30%';
        });
      }
    })();

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
  </script>

  {# ── App config (must come before module scripts) ── #}
  <script>
  window.__APP_JS_CONFIG = window.__APP_JS_CONFIG || {};
  window.__APP_JS_CONFIG.notifications = window.__APP_JS_CONFIG.notifications || {};
  window.__APP_JS_CONFIG.notifications.websocketUrl = '';

  window.puter = window.puter || {};
  window.puter.quiet = true;

  window.__broxSiteLang  = '{{ current_lang }}';
  window.__broxSiteLogo  = '{{ app_settings.site_logo|default('') }}';

  window.__broxSiteTranslations = window.__broxSiteTranslations || {};
  // Load full translations for all supported languages from server (JSON files)
  window.__broxSiteTranslations['en'] = Object.assign(
    window.__broxSiteTranslations['en'] || {},
    {{ site_translations.en|default({})|json|raw }}
  );
  window.__broxSiteTranslations['bn'] = Object.assign(
    window.__broxSiteTranslations['bn'] || {},
    {{ site_translations.bn|default({})|json|raw }}
  );
  // Ensure current language translations are also available under the current lang key
  window.__broxSiteTranslations['{{ current_lang }}'] = Object.assign(
    window.__broxSiteTranslations['{{ current_lang }}'] || {},
    {{ site_translations[current_lang]|default({})|json|raw }}
  );
  </script>

