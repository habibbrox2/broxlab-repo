                        {# Theme Toggle #}
                        <li class="nav-item brox-nav-item ms-lg-2">
                            <button class="brox-theme-toggle" id="broxThemeToggle" type="button" title="{{ 'Toggle theme'|trans }}" aria-label="{{ 'Toggle theme'|trans }}" data-i18n-title="Toggle theme" data-i18n-aria-label="Toggle theme">
                                <i class="bi bi-moon-fill"></i>
                                <i class="bi bi-sun-fill"></i>
                            </button>
                        </li>

                        {# Language Toggle #}
                        {% if available_languages is defined and available_languages|length > 1 %}
                        <li class="nav-item dropdown brox-nav-item ms-lg-2">
                            <a class="nav-link dropdown-toggle brox-nav-link brox-language-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span data-i18n="{{ current_lang == 'bn' ? 'Bangla' : 'English' }}" data-i18n-en="EN" data-i18n-bn="বাংলা">{{ current_lang == 'bn' ? 'বাংলা'|trans : 'EN'|trans }}</span>
