    (function () {
      'use strict';

      /* ═══════════════════════════════════════════════
         UTILITY HELPERS
         ═══════════════════════════════════════════════ */
      function debounce(fn, ms) {
        var timer = null;
        return function () {
          var ctx = this, args = arguments;
          clearTimeout(timer);
          timer = setTimeout(function () { fn.apply(ctx, args); }, ms);
        };
      }

      function throttle(fn, ms) {
        var last = 0;
        return function () {
          var now = Date.now();
          if (now - last >= ms) { last = now; fn.apply(this, arguments); }
        };
      }

      function getScrollTop() {
        return window.pageYOffset || document.documentElement.scrollTop || 0;
      }

      /* ═══════════════════════════════════════════════
         1. SCROLL-TO-TOP BUTTON (Enhanced)
         ═══════════════════════════════════════════════ */
      function initScrollTopButton() {
        var btn = document.getElementById('scrollTopBtn');
        if (!btn) return;

        function toggle() {
          var scroll = getScrollTop();
          var show = scroll > 180;
          btn.classList.toggle('is-visible', show);
          btn.setAttribute('aria-hidden', show ? 'false' : 'true');
        }

        btn.addEventListener('click', function (e) {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        window.addEventListener('scroll', toggle, { passive: true });
        toggle();
      }

      /* ═══════════════════════════════════════════════
         2. READING PROGRESS BAR
         ═══════════════════════════════════════════════ */
      function initProgressBar() {
        var bar = document.getElementById('scrollProgress');
        if (!bar) return;

        function update() {
          var scroll = getScrollTop();
          var docHeight = Math.max(
            document.body.scrollHeight,
            document.documentElement.scrollHeight,
            document.body.offsetHeight,
            document.documentElement.offsetHeight,
            document.body.clientHeight,
            document.documentElement.clientHeight
          );
          var winHeight = window.innerHeight;
          var maxScroll = docHeight - winHeight;
          var percent = maxScroll > 0 ? Math.min((scroll / maxScroll) * 100, 100) : 0;
          bar.style.width = percent + '%';
          bar.setAttribute('aria-valuenow', Math.round(percent));
        }

        window.addEventListener('scroll', throttle(update, 50), { passive: true });
        window.addEventListener('resize', debounce(update, 100), { passive: true });
        update();
      }

      /* ═══════════════════════════════════════════════
         3. SCROLL-TRIGGERED ANIMATIONS (IntersectionObserver)
         ═══════════════════════════════════════════════ */
      function initScrollAnimations() {
        var els = document.querySelectorAll('.scroll-fade-in, .scroll-slide-up, .scroll-scale-in');
        if (!els.length) return;

        if (!('IntersectionObserver' in window)) {
          // Fallback: show all immediately
          els.forEach(function (el) { el.classList.add('visible'); });
          return;
        }

        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, {
          rootMargin: '0px 0px -60px 0px',
          threshold: 0.08
        });

        els.forEach(function (el) { observer.observe(el); });
      }

      /* ═══════════════════════════════════════════════
         4. NAVBAR SCROLL DIRECTION (Hide on scroll down, show on scroll up)
         ═══════════════════════════════════════════════ */
      function initNavbarScroll() {
        var navbar = document.querySelector('.brox-navbar-container');
        if (!navbar) return;

        var lastScroll = getScrollTop();
        var ticking = false;
        var scrollThreshold = 80;

        function onScroll() {
          var currentScroll = getScrollTop();
          var delta = currentScroll - lastScroll;

          // Only act if we've scrolled past the threshold
          if (currentScroll > scrollThreshold) {
            if (delta > 0) {
              // Scrolling down — hide
              navbar.classList.remove('navbar-scroll-up');
              navbar.classList.add('navbar-scroll-down');
            } else if (delta < 0) {
              // Scrolling up — show
              navbar.classList.remove('navbar-scroll-down');
              navbar.classList.add('navbar-scroll-up');
            }
            // Add shadow when scrolled
            navbar.classList.add('is-scrolled');
          } else {
            // At top — reset
            navbar.classList.remove('navbar-scroll-down', 'navbar-scroll-up', 'is-scrolled');
          }

          lastScroll = currentScroll;
          ticking = false;
        }

        window.addEventListener('scroll', function () {
          if (!ticking) {
            window.requestAnimationFrame(onScroll);
            ticking = true;
          }
        }, { passive: true });

        // Don't hide navbar when user is hovering over it
        navbar.addEventListener('mouseenter', function () {
          navbar.classList.remove('navbar-scroll-down');
          navbar.classList.add('navbar-scroll-up');
        });

        // Initial state
        if (getScrollTop() > scrollThreshold) {
          navbar.classList.add('is-scrolled');
        }
      }

      /* ═══════════════════════════════════════════════
         5. SMOOTH ANCHOR SCROLLING (with sticky header offset)
         ═══════════════════════════════════════════════ */
      function initSmoothAnchors() {
        var navbar = document.querySelector('.brox-navbar-container');
        var headerOffset = navbar ? navbar.offsetHeight + 12 : 80;

        document.addEventListener('click', function (e) {
          var link = e.target.closest('a[href^="#"]');
          if (!link) return;

          var targetId = link.getAttribute('href');
          if (!targetId || targetId === '#') return;

          var target = document.querySelector(targetId);
          if (!target) return;

          e.preventDefault();

          var targetPos = target.getBoundingClientRect().top + window.pageYOffset - headerOffset;

          window.scrollTo({
            top: targetPos,
            behavior: 'smooth'
          });

          // Focus the target for accessibility
          target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
        });
      }

      /* ═══════════════════════════════════════════════
         6. PAGE TRANSITION FADE (on internal navigation clicks)
         ═══════════════════════════════════════════════ */
      function initPageTransitions() {
        var overlay = document.getElementById('pageTransitionOverlay');
        if (!overlay) return;

        document.addEventListener('click', function (e) {
          var link = e.target.closest('a:not([href^="#"]):not([href^="javascript"]):not([target="_blank"]):not([download])');
          if (!link) return;

          var href = link.getAttribute('href');
          if (!href || href === '' || href.indexOf('://') > -1 || href.startsWith('//') || href.startsWith('mailto:') || href.startsWith('tel:')) return;

          // Only apply to internal navigation links (same origin)
          var origin = window.location.origin;
          try {
            var linkUrl = new URL(href, origin);
            if (linkUrl.origin !== origin) return;
          } catch (e) {
            return;
          }

          // Don't transition on modifier clicks or right-click
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;

          // Show overlay briefly
          overlay.classList.add('is-active');
        });

        // Hide overlay when page loads (in case it was left visible from back navigation)
        window.addEventListener('pageshow', function () {
          overlay.classList.remove('is-active');
        });
      }

      /* ═══════════════════════════════════════════════
         INIT — Wait for DOM and kick off all modules
         ═══════════════════════════════════════════════ */
      function init() {
        initScrollTopButton();
        initProgressBar();
        initScrollAnimations();
        initNavbarScroll();
        initSmoothAnchors();
        initPageTransitions();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init, { once: true });
      } else {
        init();
      }
    })();
