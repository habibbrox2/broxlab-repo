<!DOCTYPE html>
<html lang="{{ current_lang }}" data-lang="{{ current_lang }}" data-theme="light">
{% import '_macros/flash.twig' as flash_macros %}

{# ===== HEAD SECTION (SEO & Metadata) ===== #}
<head>
 {# ===== CRITICAL: Page Encoding & Viewport ===== #}
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
 <meta http-equiv="X-UA-Compatible" content="IE=edge">

 {# ===== PRIMARY SEO: Page Title ===== #}
 <title>
 {%- block title -%}
 {{ app_settings.meta_title|default(app_settings.site_name ~ ' | Official Website') }}
 {%- endblock -%}
 </title>

 {# ===== PRIMARY SEO: Meta Description & Keywords ===== #}
 <meta name="description" content="{% block meta_description %}{{ app_settings.meta_description|default('Welcome to ' ~ app_settings.site_name) }}{% endblock %}">
 <meta name="keywords" content="{{ app_settings.meta_keywords|default(app_settings.site_name ~ ', mobile, tech, news') }}">
 
 {# ===== AUTHORSHIP & ATTRIBUTION ===== #}
 <meta name="author" content="{{ app_settings.site_name }}">
 <meta name="creator" content="{{ app_settings.site_name }}">
 <meta name="publisher" content="{{ app_settings.site_name }}">

 {# ===== SEARCH ENGINE CRAWLING DIRECTIVES ===== #}
 <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
 <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
 <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">

 {# ===== CANONICAL URL (Prevent Duplicate Content Issues) ===== #}
 <link rel="canonical" href="{{ canonical_url|default(current_url) }}">

 {# ===== PAGINATION LINKS (next/prev for series of pages) ===== #}
 {% if pagination_next_url is defined and pagination_next_url %}
 <link rel="next" href="{{ pagination_next_url }}">
 {% endif %}
 {% if pagination_prev_url is defined and pagination_prev_url %}
 <link rel="prev" href="{{ pagination_prev_url }}">
 {% endif %}

 {# ===== FAVICON & BRANDING ===== #}
 <link rel="icon" type="image/x-icon" href="{{ app_settings.favicon|absolute_url }}">
 <link rel="apple-touch-icon" href="{{ app_settings.site_logo|absolute_url }}">
 <link rel="shortcut icon" href="{{ app_settings.favicon|default('/assets/favicon.ico')|absolute_url }}">
 <meta name="theme-color" content="#0d6efd">
 <meta name="msapplication-TileColor" content="#0d6efd">

 {# ===== GOOGLE FONTS (Preconnect for faster loading) ===== #}
 <link rel="preconnect" href="https://fonts.googleapis.com">
 <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">


 {# ===== OPEN GRAPH META TAGS (Facebook, LinkedIn, Pinterest) ===== #}
 <meta property="og:title" content="{{ block('title')|striptags|default(app_settings.site_name) }}">
 <meta property="og:description" content="{{ app_settings.meta_description|default('Welcome to ' ~ app_settings.site_name) }}">
 <meta property="og:site_name" content="{{ app_settings.site_name }}">
 <meta property="og:image" content="{% block og_image %}{{ app_settings.site_logo|default('/assets/images/default-og-image.png')|absolute_url }}{% endblock %}">
 <meta property="og:image:width" content="1200">
 <meta property="og:image:height" content="630">
 <meta property="og:image:type" content="image/png">
 <meta property="og:type" content="{% block og_type %}website{% endblock %}">
 <meta property="og:url" content="{{ canonical_url|default(current_url) }}">
 <meta property="og:locale" content="{{ current_lang == 'bn' ? 'bn_BD' : 'en_US' }}">
 <meta property="og:locale:alternate" content="bn_BD">
 {% if app_settings.facebook_app_id %}<meta property="fb:app_id" content="{{ app_settings.facebook_app_id }}">{% endif %}

 {# Article-specific OG tags - populated by content views via block or page variables #}
 {% if og_article_author is defined %}<meta property="article:author" content="{{ og_article_author }}">{% endif %}
 {% if og_article_publisher is defined %}<meta property="article:publisher" content="{{ og_article_publisher }}">{% endif %}
 {% if og_published_time is defined %}<meta property="article:published_time" content="{{ og_published_time }}">{% endif %}
 {% if og_modified_time is defined %}<meta property="article:modified_time" content="{{ og_modified_time }}">{% endif %}
 {% if og_section is defined %}<meta property="article:section" content="{{ og_section }}">{% endif %}
 {% if og_tags is defined and og_tags is iterable %}
 {% for tag in og_tags %}
 <meta property="article:tag" content="{{ tag }}">
 {% endfor %}
 {% endif %}

 {# ===== ORGANIZATION SCHEMA (Site-wide) ===== #}
 <script type="application/ld+json">
{"@context":"https://schema.org","@type":"Organization","name": {{ app_settings.site_name|json_encode }},"url": {{ url|json_encode }},"logo": {{ app_settings.site_logo|default(url ~ 'assets/images/default-logo.png')|absolute_url|json_encode }},"description": {{ (app_settings.meta_description|default('Mobile reviews, tech news, and gadget insights'))|json_encode }},"sameAs": ["https://www.facebook.com/{{ app_settings.facebook_handle|default('') }}","https://twitter.com/{{ app_settings.twitter_handle|default('') }}","https://www.linkedin.com/company/{{ app_settings.company_name|default('') }}"
 ],"contactPoint": {"@type":"ContactPoint","telephone":"{{ app_settings.phone|default('') }}","contactType":"Customer Service"
 }
}
 </script>

 {# ===== TWITTER CARD META TAGS (Twitter/X) ===== #}
 <meta name="twitter:card" content="summary_large_image">
 <meta name="twitter:title" content="{{ block('title')|striptags|default(app_settings.site_name) }}">
 <meta name="twitter:description" content="{{ app_settings.meta_description|default('Welcome to ' ~ app_settings.site_name) }}">
 <meta name="twitter:image" content="{{ app_settings.site_logo|default('/assets/images/default-og-image.png')|absolute_url }}">
 {% if app_settings.twitter_handle %}<meta name="twitter:creator" content="@{{ app_settings.twitter_handle }}">{% endif %}
 {% if app_settings.twitter_site %}<meta name="twitter:site" content="@{{ app_settings.twitter_site }}">{% endif %}

 {# ===== MOBILE & THUMBNAIL META ===== #}
 <meta name="thumbnail" content="{{ block('og_image') }}">
 <meta name="mobile-web-app-capable" content="yes">
 <meta name="apple-mobile-web-app-title" content="{{ app_settings.site_name }}">
 <meta name="application-name" content="{{ app_settings.site_name }}">

 {# ===== LANGUAGE & LOCALIZATION ===== #}
 <meta name="language" content="{{ current_lang == 'bn' ? 'Bengali' : 'English' }}">
 <link rel="alternate" hreflang="en" href="{{ canonical_url|default(current_url) }}">
 <link rel="alternate" hreflang="bn" href="{{ current_url }}" lang="bn">
 <link rel="alternate" hreflang="x-default" href="{{ canonical_url|default(current_url) }}">

 {# ===== PAGE TIMESTAMPS (SEO) ===== #}
 {% if page_date_published is defined %}<meta name="date" content="{{ page_date_published }}">{% endif %}
 {% if page_date_modified is defined %}<meta name="modified" content="{{ page_date_modified }}">{% endif %}

 {# ===== FIREBASE & NOTIFICATION SYSTEM META TAGS ===== #}
 <meta name="csrf-token" content="{{ csrf_token }}">
 {% if auth_user.id %}<meta name="user-id" content="{{ auth_user.id }}">{% endif %}

 {# ===== PERFORMANCE: DNS-Prefetch & Preconnect ===== #}
 <link rel="preconnect" href="https://cdn.jsdelivr.net">
 <link rel="preconnect" href="https://www.googletagmanager.com">
 {# Firebase CDN Preconnect #}
 <link rel="preconnect" href="https://www.gstatic.com" crossorigin="anonymous">
 <link rel="dns-prefetch" href="https://fcm.googleapis.com">  <link rel="dns-prefetch" href="https://firebaseinstallations.googleapis.com">

  {# ===== CRITICAL CSS (Render-Blocking - must load first) ===== #}
  {# Simple cache-busting version token #}
  {% set assets_version = app_settings.asset_version is defined and app_settings.asset_version ? app_settings.asset_version : ('b' ~ 'now'|date('U')) %}
  {# App styles (Tailwind single source of truth) — critical for first paint #}
  <link rel="stylesheet" href="{{ asset('/assets/css/dist/tailwind-public.css') }}?v={{ assets_version }}">
  <link rel="stylesheet" href="{{ asset('/cdn/css/lucide/lucide.css') }}?v={{ assets_version }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ asset('/cdn/css/lucide/lucide.css') }}?v={{ assets_version }}"></noscript>
    {# Fallback: if compiled dist is missing/empty during development, load source Tailwind input so components have styles #}
    <link rel="stylesheet" href="{{ asset('/assets/css/tailwind-input.css') }}?v={{ assets_version }}" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="{{ asset('/assets/css/tailwind-input.css') }}?v={{ assets_version }}"></noscript>
  {# BroxLab polished layout styles — semantic element typography, spacing (deferred, non-critical) #}
  <link rel="stylesheet" href="{{ asset('/assets/css/brox-polish.css') }}?v={{ assets_version }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ asset('/assets/css/brox-polish.css') }}?v={{ assets_version }}"></noscript>

 {# ===== NON-CRITICAL CSS (Deferred via media="print" trick) ===== #}
 {# SweetAlert2 modals - loaded from CDN, only needed on interaction #}
 <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" media="print" onload="this.media='all'">
 <noscript><link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet"></noscript>

 {# AI Assistant styles - only needed when assistant is active #}
 <link rel="stylesheet" href="{{ asset('/assets/ai-assistant/styles/thinking-indicator.css') }}?v={{ assets_version }}" media="print" onload="this.media='all'">
 <noscript><link rel="stylesheet" href="{{ asset('/assets/ai-assistant/styles/thinking-indicator.css') }}?v={{ assets_version }}"></noscript>
 <link rel="stylesheet" href="{{ asset('/assets/ai-assistant/styles/assistant-ui.css') }}?v={{ assets_version }}" media="print" onload="this.media='all'">
 <noscript><link rel="stylesheet" href="{{ asset('/assets/ai-assistant/styles/assistant-ui.css') }}?v={{ assets_version }}"></noscript>

 <link rel="stylesheet" href="{{ asset('/ai/css/ai-style.css') }}?v={{ assets_version }}" media="print" onload="this.media='all'">
 <noscript><link rel="stylesheet" href="{{ asset('/ai/css/ai-style.css') }}?v={{ assets_version }}"></noscript>  {# ===== GOOGLE FONTS (Optimized: preconnect + preload + swap to avoid FOIT) ===== #}
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        onload="this.onload=null;this.rel='stylesheet'" fetchpriority="low">
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </noscript>
 {% block extra_styles %}
 {% endblock %}
 {% block extra_head %}
 {% endblock %}

</head>

{# ===== BODY SECTION ===== #}
<body role="application" class="min-h-screen">

 {# ===== JSON-LD SCHEMAS (Keep in head for SEO) ===== #}
 <script type="application/ld+json">
 {"@context":"https://schema.org","@type":"WebPage","@id": {{ canonical_url|default(current_url)|json_encode }},"url": {{ canonical_url|default(current_url)|json_encode }},"name": {{ block('title')|striptags|json_encode }},"description": {{ app_settings.meta_description|json_encode }},"image": {"@type":"ImageObject","url": {{ app_settings.site_logo|default('/assets/images/default-og-image.png')|absolute_url|json_encode }},"width": 1200,"height": 630
 },"datePublished":"{{ page_date_published|default('now')|date('c') }}","dateModified":"{{ page_date_modified|default('now')|date('c') }}","isPartOf": {"@type":"WebSite","@id": {{ url|json_encode }},"name": {{ app_settings.site_name|json_encode }},"url": {{ url|json_encode }}
 },"publisher": {"@type":"Organization","@id": {{ (url ~ '#organization')|json_encode }},"name": {{ app_settings.site_name|json_encode }},"logo": {"@type":"ImageObject","url": {{ app_settings.site_logo|absolute_url|json_encode }}
 }
 },"mainEntity": {"@type":"Article","headline": {{ block('title')|striptags|json_encode }}
 },"inLanguage":"en-US","potentialAction": {"@type":"ReadAction","target":"{{ canonical_url|default(current_url) }}"
 }
 }
 </script>

 <script type="application/ld+json">
 {"@context":"https://schema.org","@type":"Organization","@id": {{ (url ~ '#organization')|json_encode }},"name": {{ app_settings.site_name|json_encode }},"url": {{ url|json_encode }},"sameAs": ["https://twitter.com/{{ app_settings.social_twitter|default('') }}","https://www.instagram.com/{{ app_settings.social_instagram ?: '' }}","https://www.facebook.com/{{ app_settings.social_facebook ?: '' }}"
 ],"logo": {"@type":"ImageObject","url": {{ (app_settings.site_logo ?: '/assets/images/default-logo.png')|absolute_url|json_encode }},"width": 250,"height": 100
 },"description": {{ app_settings.meta_description|json_encode }},"contactPoint": {"@type":"ContactPoint","contactType":"Customer Support",
 {% if app_settings.contact_phone %}"telephone": {{ app_settings.contact_phone|json_encode }},{% endif %}"email": {{ app_settings.contact_email|default('support@example.com')|json_encode }}
 }
 }
 </script>

 <script type="application/ld+json">
 {"@context":"https://schema.org","@type":"WebSite","name": {{ app_settings.site_name|json_encode }},"url": {{ url|json_encode }},"description": {{ app_settings.meta_description|json_encode }},"potentialAction": {"@type":"SearchAction","target": {"@type":"EntryPoint","urlTemplate": {{ (url ~ 'search?q={search_term_string}')|json_encode }}
 },"query-input":"required name=search_term_string"
 }
 }
 </script>

 {# ===== LOCAL BUSINESS SCHEMA (if business details available) ===== #}
 <script type="application/ld+json">
 {"@context":"https://schema.org","@type":"LocalBusiness","name": {{ app_settings.site_name|json_encode }},"url": {{ url|json_encode }},"logo": {{ app_settings.site_logo|absolute_url|json_encode }},"description": {{ app_settings.meta_description|default('Mobile reviews, tech news, and gadget insights')|json_encode }},"image": {{ app_settings.site_logo|default(url ~ 'assets/images/default-og-image.png')|absolute_url|json_encode }},

 {% if app_settings.business_address %}"address": {"@type":"PostalAddress","streetAddress": {{ app_settings.business_address|json_encode }},"addressCountry": {{ app_settings.business_country|default('BD')|json_encode }}
 },{% endif %}
 {% if app_settings.contact_phone %}"telephone": {{ app_settings.contact_phone|json_encode }},{% endif %}
 {% if app_settings.contact_email %}"email": {{ app_settings.contact_email|json_encode }},{% endif %}"sameAs": ["https://www.facebook.com/{{ app_settings.social_facebook|default('') }}","https://twitter.com/{{ app_settings.social_twitter|default('') }}","https://www.instagram.com/{{ app_settings.social_instagram|default('') }}"
 ],"aggregateRating": {"@type":"AggregateRating","ratingValue": 4.8,"ratingCount": {{ app_settings.rating_count|default(1000)|json_encode }}
 }
 }
 </script>

 {% block schema %}{% endblock %}

 {% if breadcrumbs is defined and breadcrumbs|length > 0 %}
 {% set sanitized_breadcrumbs = breadcrumbs|sanitize_breadcrumbs %}
 <script type="application/ld+json">
 {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement": [
 {"@type":"ListItem","position": 1,"name":"Home","item":"{{ url }}"
 }
 {% for crumb in sanitized_breadcrumbs %}
 ,{"@type":"ListItem","position": {{ loop.index + 1 }},"name": {{ crumb.label|json_encode }},"item": {{ (loop.last ? canonical_url : crumb.url)|json_encode }}
 }
 {% endfor %}
 ]
 }
 </script>
 {% endif %}

 {# ===== ACCESSIBILITY: Skip to Main Content ===== #}
 <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-50 focus:p-4 focus:bg-white focus:text-indigo-600 focus:outline-none" tabindex="0">Skip to main content</a>

  {# ===== BROXBHAI HEADER â€” Modern Glassmorphism Navbar ===== #}
  <header class="brox-navbar-container" role="banner">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <nav class="flex items-center justify-between gap-4 py-3" role="navigation" aria-label="Primary navigation">
  
  {# Brand / Logo #}
  <a class="brox-brand-link" href="{{ studio_header_url|default('/studio') }}" title="Studio">
  {% if app_settings.site_logo is defined and app_settings.site_logo %}
  <img src="{{ app_settings.site_logo|absolute_url }}" alt="{{ app_settings.site_name }}" class="brox-brand-logo" fetchpriority="high" decoding="async" width="120" height="40">
  {% else %}
  <div class="brox-brand-icon">
  <i class="lucide lucide-phone text-white text-base"></i>
  <span class="brox-brand-text text-white text-base">{{ app_settings.site_name }}</span>
  </div>
  {% endif %}
  </a>

  {# Mobile Toggle â€” Animated Hamburger #}
  <button class="brox-mobile-toggle" type="button" 
  data-brox-toggle="collapse" data-brox-target="#broxMainNav" 
  aria-controls="broxMainNav" aria-expanded="false" aria-label="Toggle navigation">
  <span class="brox-toggle-bar"></span>
  <span class="brox-toggle-bar"></span>
  <span class="brox-toggle-bar"></span>
  </button>

  {# Navigation Menu #}
  <div class="brox-navbar-collapse lg:!flex" id="broxMainNav">
  {% set navCurrentPath = request.path|default(current_path|default('/')) %}
  {% set nav_items = (public_nav_items is iterable) ? public_nav_items : [] %}
  {% if nav_items is empty %}
  {% set nav_items = [
  {'label': 'Home', 'label_bn': 'à¦¹à§‹à¦®', 'url': '/', 'icon': 'lucide lucide-home', 'match': '/'},
  {'label': 'Mobiles', 'label_bn': 'মোবাইল', 'url': '/mobiles', 'icon': 'lucide lucide-phone', 'match': '/mobiles'},
  {'label': 'Articles', 'label_bn': 'আর্টিকেল', 'url': '/posts', 'icon': 'lucide lucide-newspaper', 'match': '/posts'},
  {'label': 'Services', 'label_bn': 'সেবাসমূহ', 'url': '/services', 'icon': 'lucide lucide-award', 'match': '/services'},
  {'label': 'Calculators', 'label_bn': 'ক্যালকুলেটর', 'url': '/calculators', 'icon': 'lucide lucide-calculator', 'match': '/calculators'},
  {'label': 'Support Us', 'label_bn': 'সহায়তা করুন', 'url': '/donate', 'icon': 'lucide lucide-heart', 'match': '/donate'},
  {'label': 'Studio', 'label_bn': 'স্টুডিও', 'url': '/studio', 'icon': 'lucide lucide-palette', 'match': '/studio'},
  {'label': 'Bangla Converter', 'label_bn': 'বাংলা কনভার্টার', 'url': '/bangla-converter', 'icon': 'lucide lucide-languages', 'match': '/bangla-converter'},
  {'label': 'MedEx', 'label_bn': 'মেডএক্স', 'url': '/medex', 'icon': 'lucide lucide-pill', 'match': '/medex'},
  ] %}
  {% if auth_user is defined and auth_user.is_authenticated %}
  {% set dashboard_url = (auth_user.is_super_admin is defined and auth_user.is_super_admin) or (auth_user.role is defined and auth_user.role == 'admin') ? '/admin/dashboard' : '/user/dashboard' %}
  {% set nav_items = nav_items|merge([{'label': 'Dashboard', 'label_bn': 'ড্যাশবোর্ড', 'url': dashboard_url, 'icon': 'lucide lucide-gauge', 'match': dashboard_url}]) %}
  {% endif %}
  {% endif %}

  <ul class="navbar-nav lg:ml-auto">
  {% for item in nav_items %}
  {% if item.enabled|default(true) %}
  {% set navUrl = item.url|default('/') %}
  {% set navMatch = item.match|default(navUrl) %}
  {% set isActive = navMatch == '/' ? (navCurrentPath == '/') : (navCurrentPath == navMatch or navCurrentPath starts with (navMatch ~ '/')) %}
  <li class="brox-nav-item">
  <a class="brox-nav-link {% if isActive %}brox-active{% endif %}" href="{{ navUrl }}">
  {% if item.icon|default('') %}
  <i class="{{ item.icon }}"></i>
  {% endif %}
  <span data-i18n="{{ item.label|default('Link') }}" data-i18n-en="{{ item.label }}" data-i18n-bn="{{ item.label_bn|default(item.label) }}">{{ item.label|default('Link')|trans }}</span>
  </a>
  </li>
  {% endif %}
  {% endfor %}

  {# â”€â”€ Authenticated User Section â”€â”€ #}
  {% if auth_user is defined and auth_user.is_authenticated %}

  {# Notification Bell #}
  <li class="relative brox-nav-item lg:ml-1" data-notification-menu>
  {% set nav_unread_count = unread_count|default(0) %}
  <a class="brox-nav-link"
  href="#" id="broxNotificationBell" role="button" data-brox-toggle="dropdown" data-notification-bell
  aria-expanded="false">
  <i class="lucide lucide-bell"></i>
  <span id="broxNotificationBadge" data-notification-badge class="brox-notification-badge {% if nav_unread_count <= 0 %}hidden{% endif %}">
  <span id="broxNotificationCount" data-notification-count>{{ nav_unread_count }}</span>
  </span>
  </a>
  <div class="brox-notification-dropdown" data-notification-dropdown aria-labelledby="broxNotificationBell">
  <div class="brox-dropdown-header px-4 py-2.5 rounded-xl">
  <h6 class="text-sm font-semibold">
  <i class="lucide lucide-bell mr-2"></i>Notifications
  </h6>
  </div>
  <div class="brox-dropdown-divider"></div>
  <div>
  <div id="broxNotificationsList" data-notification-list class="brox-notification-list" data-user-id="{{ auth_user.id }}">
  {% if notifications is defined and notifications is iterable and notifications|length > 0 %}
  {% for notif in notifications|slice(0, 10) %}
  <div class="rounded-xl p-3 mx-1.5 mb-1 transition-colors {% if notif.is_read is defined and notif.is_read == 0 %}bg-[rgb(var(--surface-soft))]{% endif %}"
  data-notification-id="{{ notif.id }}"
  {% if notif.action_url is defined and notif.action_url %}data-action-url="{{ notif.action_url }}"{% endif %}>
  <div class="flex items-start gap-2">
  <div class="flex-1">
  <div class="font-semibold text-sm mb-0.5">{{ notif.title }}</div>
  <div class="text-xs text-[rgb(var(--muted))] mb-1">{{ notif.message }}</div>
  <div class="text-xs text-[rgb(var(--muted))]/60">{{ notif.created_at|date("n/j/Y, g:i:s A") }}</div>
  </div>
  {% if notif.is_read is defined and notif.is_read == 0 %}
  <button type="button"
  class="inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-lg border border-[rgb(var(--primary))] text-[rgb(var(--primary))] hover:bg-[rgb(var(--primary))]/5 transition-colors"
  data-action="mark-read"
  data-notification-id="{{ notif.id }}"><span data-i18n="Read">{{ 'Read'|trans }}</span></button>
  {% endif %}
  </div>
  </div>
  {% endfor %}
  {% else %}
  <div class="text-center py-6 text-[rgb(var(--muted))]">
  <i class="lucide lucide-inbox text-lg"></i>
  <p class="mt-2 text-sm"><span data-i18n="No new notifications">{{ 'No new notifications'|trans }}</span></p>
  </div>
  {% endif %}
  </div>
  </div>
  <div class="brox-dropdown-divider"></div>
  <div>
  <a class="brox-dropdown-item justify-center text-center font-medium" href="/user/notifications">
  <i class="lucide lucide-arrow-right mr-1"></i><span data-i18n="View all">{{ 'View all'|trans }}</span>
  </a>
  </div>
  </div>
  </li>

  {# User Dropdown #}
  <li class="relative brox-nav-item lg:ml-1">
  <a class="brox-nav-link brox-user-dropdown-toggle flex items-center gap-2 px-2 py-1.5 rounded-lg transition-all duration-200 hover:bg-[rgb(var(--surface-soft))] hover:shadow-sm" 
  href="#" id="broxNavbarUser" role="button" 
