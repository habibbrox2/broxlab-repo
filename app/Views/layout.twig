<!DOCTYPE html>
<html lang="{{ current_lang }}" data-lang="{{ current_lang }}" data-theme="light">
{% import '_macros/flash.twig' as flash_macros %}

{# ===== HEAD SECTION (SEO & Metadata) ===== #}
<head>
    {# ===== CRITICAL: Page Encoding & Viewport ===== #}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    {# ===== PRIMARY SEO: Page Title ===== #}
    <title>
        {%- block title -%}
            {{ app_settings.meta_title|default(app_settings.site_name ~ ' | Official Website') }}
        {%- endblock -%}
    </title>

    {# ===== PRIMARY SEO: Meta Description & Keywords ===== #}
    <meta name="description" content="{% block meta_description %}{{ app_settings.meta_description|default('Welcome to ' ~ app_settings.site_name) }}{% endblock %}">
    <meta name="keywords" content="{{ app_settings.meta_keywords|default(app_settings.site_name ~ ', mobile, tech, news') }}">
    
    {# ===== AUTHORSHIP & ATTRIBUTION ===== #}
    <meta name="author" content="{{ app_settings.site_name }}">
    <meta name="creator" content="{{ app_settings.site_name }}">
    <meta name="publisher" content="{{ app_settings.site_name }}">

    {# ===== SEARCH ENGINE CRAWLING DIRECTIVES ===== #}
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">

    {# ===== CANONICAL URL (Prevent Duplicate Content Issues) ===== #}
    <link rel="canonical" href="{{ canonical_url|default(current_url) }}">

    {# ===== PAGINATION LINKS (next/prev for series of pages) ===== #}
    {% if pagination_next_url is defined and pagination_next_url %}
        <link rel="next" href="{{ pagination_next_url }}">
    {% endif %}
    {% if pagination_prev_url is defined and pagination_prev_url %}
        <link rel="prev" href="{{ pagination_prev_url }}">
    {% endif %}

    {# ===== FAVICON & BRANDING ===== #}
    <link rel="icon" type="image/x-icon" href="{{ app_settings.favicon|default('/assets/favicon.ico')|absolute_url }}">
    <link rel="apple-touch-icon" href="{{ app_settings.site_logo|default('/assets/images/default-logo.png')|absolute_url }}">
    <link rel="shortcut icon" href="{{ app_settings.favicon|default('/assets/favicon.ico')|absolute_url }}">
    <meta name="theme-color" content="#0d6efd">
    <meta name="msapplication-TileColor" content="#0d6efd">

    {# ===== GOOGLE FONTS (Preconnect for faster loading) ===== #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>


    {# ===== OPEN GRAPH META TAGS (Facebook, LinkedIn, Pinterest) ===== #}
    <meta property="og:title" content="{{ block('title')|striptags|default(app_settings.site_name) }}">
    <meta property="og:description" content="{{ app_settings.meta_description|default('Welcome to ' ~ app_settings.site_name) }}">
    <meta property="og:site_name" content="{{ app_settings.site_name }}">
    <meta property="og:image" content="{% block og_image %}{{ app_settings.site_logo|default('/assets/images/default-og-image.png')|absolute_url }}{% endblock %}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type" content="image/png">
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:url" content="{{ canonical_url|default(current_url) }}">
    <meta property="og:locale" content="en_US">
    <meta property="og:locale:alternate" content="bn_BD">

    {# ===== ORGANIZATION SCHEMA (Site-wide) ===== #}
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ app_settings.site_name|json_encode }},
  "url": {{ url|json_encode }},
  "logo": {{ app_settings.site_logo|default(url ~ 'assets/images/default-logo.png')|absolute_url|json_encode }},
  "description": {{ (app_settings.meta_description|default('Mobile reviews, tech news, and gadget insights'))|json_encode }},
  "sameAs": [
    "https://www.facebook.com/{{ app_settings.facebook_handle|default('') }}",
    "https://twitter.com/{{ app_settings.twitter_handle|default('') }}",
    "https://www.linkedin.com/company/{{ app_settings.company_name|default('') }}"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "{{ app_settings.phone|default('') }}",
    "contactType": "Customer Service"
  }
}
    </script>

    {# ===== TWITTER CARD META TAGS (Twitter/X) ===== #}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title')|striptags|default(app_settings.site_name) }}">
    <meta name="twitter:description" content="{{ app_settings.meta_description|default('Welcome to ' ~ app_settings.site_name) }}">
    <meta name="twitter:image" content="{{ app_settings.site_logo|default('/assets/images/default-og-image.png')|absolute_url }}">
    {% if app_settings.twitter_handle %}<meta name="twitter:creator" content="@{{ app_settings.twitter_handle }}">{% endif %}
    {% if app_settings.twitter_site %}<meta name="twitter:site" content="@{{ app_settings.twitter_site }}">{% endif %}

    {# ===== LANGUAGE & LOCALIZATION ===== #}
    <meta name="language" content="English">
    <link rel="alternate" hreflang="en-US" href="{{ canonical_url|default(current_url) }}">
    <link rel="alternate" hreflang="bn-BD" href="{{ current_url }}" lang="bn">

    {# ===== FIREBASE & NOTIFICATION SYSTEM META TAGS ===== #}
    <meta name="csrf-token" content="{{ csrf_token }}">
    {% if auth_user.id %}<meta name="user-id" content="{{ auth_user.id }}">{% endif %}

    {# ===== PERFORMANCE: DNS-Prefetch & Preconnect ===== #}
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://www.googletagmanager.com">
    {# Firebase CDN Preconnect #}
    <link rel="preconnect" href="https://www.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://fcm.googleapis.com">
    <link rel="dns-prefetch" href="https://firebaseinstallations.googleapis.com">


    {# ===== CRITICAL CSS PRELOAD ===== #}
    <link rel="preload" href="{{ asset('/cdn/css/bootstrap.min.css') }}" as="style">
    <link rel="preload" href="{{ asset('/cdn/css/bootstrap-icons.min.css') }}" as="style">
    <link rel="preload" href="{{ asset('/assets/css/dist/public-bundle.css') }}" as="style">
    <link rel="preload" href="{{ asset('/assets/css/tailwind.css') }}" as="style">

    {# ===== BOOTSTRAP CSS (Critical Path) - CDN Subdomain ===== #}
    <link href="{{ asset('/cdn/css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('/cdn/css/sweetalert2.min.css') }}" rel="stylesheet">

    {# ===== GOOGLE FONTS (Deferred Loading) ===== #}
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" async>
    <noscript><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>

    {# ===== BOOTSTRAP ICONS (Deferred Loading) ===== #}
    <link href="{{ asset('/cdn/css/bootstrap-icons.min.css') }}" rel="stylesheet">

    {# ===== APPLICATION STYLESHEETS (Bundled for Performance) ===== #}
    <link rel="stylesheet" href="{{ asset('/assets/css/dist/public-bundle.css') }}">
    <link rel="stylesheet" href="{{ asset('/assets/css/tailwind.css') }}">
    <link rel="stylesheet" href="{{ asset('/assets/ai-assistant/styles/thinking-indicator.css') }}">
    {% block extra_styles %}
    {% endblock %}
    {% block extra_head %}
    {% endblock %}

</head>

{# ===== BODY SECTION ===== #}
<body role="application">

    {# ===== JSON-LD SCHEMAS (Keep in head for SEO) ===== #}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": {{ canonical_url|default(current_url)|json_encode }},
        "url": {{ canonical_url|default(current_url)|json_encode }},
        "name": {{ block('title')|striptags|json_encode }},
        "description": {{ app_settings.meta_description|json_encode }},
        "image": {
            "@type": "ImageObject",
            "url": {{ app_settings.site_logo|default('/assets/images/default-og-image.png')|absolute_url|json_encode }},
            "width": 1200,
            "height": 630
        },
        "datePublished": "{{ page_date_published|default('now')|date('c') }}",
        "dateModified": "{{ page_date_modified|default('now')|date('c') }}",
        "isPartOf": {
            "@type": "WebSite",
            "@id": {{ url|json_encode }},
            "name": {{ app_settings.site_name|json_encode }},
            "url": {{ url|json_encode }}
        },
        "publisher": {
            "@type": "Organization",
            "@id": {{ (url ~ '#organization')|json_encode }},
            "name": {{ app_settings.site_name|json_encode }},
            "logo": {
                "@type": "ImageObject",
                "url": {{ app_settings.site_logo|default('/assets/images/default-logo.png')|absolute_url|json_encode }}
            }
        },
        "mainEntity": {
            "@type": "Article",
            "headline": {{ block('title')|striptags|json_encode }}
        },
        "inLanguage": "en-US",
        "potentialAction": {
            "@type": "ReadAction",
            "target": "{{ canonical_url|default(current_url) }}"
        }
    }
    </script>

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": {{ (url ~ '#organization')|json_encode }},
        "name": {{ app_settings.site_name|json_encode }},
        "url": {{ url|json_encode }},
        "sameAs": [
            "https://twitter.com/{{ app_settings.social_twitter|default('') }}",
            "https://www.instagram.com/{{ app_settings.social_instagram ?: '' }}",
            "https://www.facebook.com/{{ app_settings.social_facebook ?: '' }}"
        ],
        "logo": {
            "@type": "ImageObject",
            "url": {{ (app_settings.site_logo ?: '/assets/images/default-logo.png')|absolute_url|json_encode }},
            "width": 250,
            "height": 100
        },
        "description": {{ app_settings.meta_description|json_encode }},
        "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "Customer Support",
            {% if app_settings.contact_phone %}"telephone": {{ app_settings.contact_phone|json_encode }},{% endif %}
            "email": {{ app_settings.contact_email|default('support@example.com')|json_encode }}
        }
    }
    </script>

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": {{ app_settings.site_name|json_encode }},
        "url": {{ url|json_encode }},
        "description": {{ app_settings.meta_description|json_encode }},
        "potentialAction": {
            "@type": "SearchAction",
            "target": {
                "@type": "EntryPoint",
                "urlTemplate": {{ (url ~ 'search?q={search_term_string}')|json_encode }}
            },
            "query-input": "required name=search_term_string"
        }
    }
    </script>

    {# ===== LOCAL BUSINESS SCHEMA (if business details available) ===== #}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": {{ app_settings.site_name|json_encode }},
        "url": {{ url|json_encode }},
        "logo": {{ app_settings.site_logo|default(url ~ 'assets/images/default-logo.png')|absolute_url|json_encode }},
        "description": {{ app_settings.meta_description|default('Mobile reviews, tech news, and gadget insights')|json_encode }},
        "image": {{ app_settings.site_logo|default(url ~ 'assets/images/default-og-image.png')|absolute_url|json_encode }},

        {% if app_settings.business_address %}"address": {
            "@type": "PostalAddress",
            "streetAddress": {{ app_settings.business_address|json_encode }},
            "addressCountry": {{ app_settings.business_country|default('BD')|json_encode }}
        },{% endif %}
        {% if app_settings.contact_phone %}"telephone": {{ app_settings.contact_phone|json_encode }},{% endif %}
        {% if app_settings.contact_email %}"email": {{ app_settings.contact_email|json_encode }},{% endif %}
        "sameAs": [
            "https://www.facebook.com/{{ app_settings.social_facebook|default('') }}",
            "https://twitter.com/{{ app_settings.social_twitter|default('') }}",
            "https://www.instagram.com/{{ app_settings.social_instagram|default('') }}"
        ],
        "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": 4.8,
            "ratingCount": {{ app_settings.rating_count|default(1000)|json_encode }}
        }
    }
    </script>

    {% if breadcrumbs is defined and breadcrumbs|length > 0 %}
    {% set sanitized_breadcrumbs = breadcrumbs|sanitize_breadcrumbs %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "{{ url }}"
            }
            {% for crumb in sanitized_breadcrumbs %}
            ,{
                "@type": "ListItem",
                "position": {{ loop.index + 1 }},
                "name": {{ crumb.label|json_encode }},
                "item": {{ (loop.last ? canonical_url : crumb.url)|json_encode }}
            }
            {% endfor %}
        ]
    }
    </script>
    {% endif %}

    {# ===== ACCESSIBILITY: Skip to Main Content ===== #}
    <a href="#main-content" class="visually-hidden-focusable" tabindex="0">Skip to main content</a>

    {# ===== BROXBHAI HEADER - RESPONSIVE FIXED ===== #}
    <header class="brox-navbar-container sticky-top shadow-sm" role="banner">
        <div class="container">
            <nav class="navbar navbar-expand-lg" role="navigation">
                
                {# Brand / Logo #}
                <a class="navbar-brand brox-brand-link" href="{{ studio_header_url|default('/studio') }}" title="Studio">
                    {% if app_settings.site_logo is defined and app_settings.site_logo %}
                        <img src="{{ app_settings.site_logo|absolute_url }}" alt="{{ app_settings.site_name }}" class="brox-brand-logo me-2" loading="lazy" decoding="async">
                    {% else %}
                        <div class="bg-primary rounded-3 p-2 me-2 shadow-sm brox-brand-icon">
                            <i class="bi bi-phone-fill text-white"></i> <span class="brox-brand-text">{{ app_settings.site_name }}</span>
                        </div>
                    {% endif %}
                </a>

                {# Mobile Toggle #}
                <button class="navbar-toggler brox-mobile-toggle" type="button" 
                        data-bs-toggle="collapse" data-bs-target="#broxMainNav" 
                        aria-controls="broxMainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon brox-toggle-icon"></span>
                </button>

                {# Navigation Menu #}
                <div class="collapse navbar-collapse brox-navbar-collapse" id="broxMainNav">
                    {% set navCurrentPath = request.path|default(current_path|default('/')) %}
                    {% set nav_items = (public_nav_items is iterable) ? public_nav_items : [] %}
                    {% if nav_items is empty %}
                        {% set nav_items = [
                            {'label': 'Home', 'url': '/', 'icon': 'bi-house-door-fill', 'match': '/'},
                            {'label': 'Mobiles', 'url': '/mobiles', 'icon': 'bi-phone-fill', 'match': '/mobiles'},
                            {'label': 'Articles', 'url': '/posts', 'icon': 'bi-newspaper', 'match': '/posts'},
                            {'label': 'Services', 'url': '/services', 'icon': 'bi-award-fill', 'match': '/services'},
                            {'label': 'Support Us', 'url': '/donate', 'icon': 'bi-heart-fill', 'match': '/donate'},
                            {'label': 'Studio', 'url': '/studio', 'icon': 'bi-palette-fill', 'match': '/studio'},
                            {'label': 'Bangla Converter', 'url': '/bangla-converter', 'icon': 'bi-translate', 'match': '/bangla-converter'},
                        ] %}
                        {# Add Dashboard link for authenticated users #}
                        {% if auth_user is defined and auth_user.is_authenticated %}
                            {% set dashboard_url = (auth_user.is_super_admin is defined and auth_user.is_super_admin) or (auth_user.role is defined and auth_user.role == 'admin') ? '/admin/dashboard' : '/user/dashboard' %}
                            {% set nav_items = nav_items|merge([{'label': 'Dashboard', 'url': dashboard_url, 'icon': 'bi-speedometer2', 'match': dashboard_url}]) %}
                        {% endif %}
                    {% endif %}

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-1">
                        {% for item in nav_items %}
                            {% if item.enabled|default(true) %}
                                {% set navUrl = item.url|default('/') %}
                                {% set navMatch = item.match|default(navUrl) %}
                                {% set isActive = navMatch == '/' ? (navCurrentPath == '/') : (navCurrentPath == navMatch or navCurrentPath starts with (navMatch ~ '/')) %}
                                <li class="nav-item brox-nav-item">
                                    <a class="nav-link brox-nav-link {% if isActive %}brox-active{% endif %}" href="{{ navUrl }}">
                                        {% if item.icon|default('') %}
                                            <i class="bi {{ item.icon }} me-2"></i>
                                        {% endif %}
                                        <span data-i18n="{{ item.label|default('Link') }}">{{ item.label|default('Link')|trans }}</span>
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
{# Authenticated User Section #}

                        {% if auth_user is defined and auth_user.is_authenticated %}
                            
                            {# Notification Bell #}
                            <li class="nav-item dropdown brox-nav-item ms-lg-2 brox-notification-wrapper" data-notification-menu>
                                {% set nav_unread_count = unread_count|default(0) %}
                            <a class="nav-link brox-nav-link brox-notification-bell position-relative"
                               href="#" id="broxNotificationBell" role="button" data-bs-toggle="dropdown" data-notification-bell
                               aria-expanded="false">
                                <i class="bi bi-bell-fill"></i>
                                <span id="broxNotificationBadge" data-notification-badge class="brox-notification-badge badge rounded-pill bg-danger {% if nav_unread_count <= 0 %}d-none{% endif %}">
                                    <span id="broxNotificationCount" data-notification-count>{{ nav_unread_count }}</span>
                                </span>
                            </a>
                            <div class="dropdown-menu brox-notification-dropdown" data-notification-dropdown aria-labelledby="broxNotificationBell">
                                <div class="brox-notification-dropdown-header">
                                    <h6 class="mb-0">
                                        <i class="bi bi-bell-fill me-2"></i>Notifications
                                    </h6>
                                </div>
                                <div>
                                    <div id="broxNotificationsList" data-notification-list class="brox-notification-list" data-user-id="{{ auth_user.id }}">
                                            {% if notifications is defined and notifications is iterable and notifications|length > 0 %}
                                                {% for notif in notifications|slice(0, 10) %}
                                                    <div class="notification-entry p-2 mb-2 rounded {% if notif.is_read is defined and notif.is_read == 0 %}bg-light border-start border-primary border-2{% endif %}"
                                                         data-notification-id="{{ notif.id }}"
                                                         {% if notif.action_url is defined and notif.action_url %}data-action-url="{{ notif.action_url }}"{% endif %}>
                                                        <div class="d-flex align-items-start gap-2">
                                                            <div class="flex-grow-1">
                                                                <div class="fw-semibold small mb-1">{{ notif.title }}</div>
                                                                <div class="small text-muted mb-1">{{ notif.message }}</div>
                                                                <div class="small text-secondary">{{ notif.created_at|date("n/j/Y, g:i:s A") }}</div>
                                                            </div>
                                                            {% if notif.is_read is defined and notif.is_read == 0 %}
                                                                <button type="button"
                                                                        class="btn btn-sm btn-outline-primary"
                                                                        data-action="mark-read"
                                                                        data-notification-id="{{ notif.id }}"><span data-i18n="Read">{{ 'Read'|trans }}</span></button>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            {% else %}
                                                <div class="text-center py-4 text-muted">
                                                    <i class="bi bi-inbox fs-4"></i>
                                                    <p class="mb-0 mt-2 small"><span data-i18n="No new notifications">{{ 'No new notifications'|trans }}</span></p>
                                                </div>
                                            {% endif %}
                                        </div>
                                </div>
                                <div class="dropdown-divider brox-dropdown-divider"></div>
                                <div>
                                    <a class="brox-dropdown-item brox-dropdown-item text-center" href="/user/notifications">
                                        <i class="bi bi-arrow-right me-1"></i><span data-i18n="View all">{{ 'View all'|trans }}</span>
                                    </a>
                                </div>
                            </div>
                        </li>

                            {# User Dropdown #}
                            <li class="nav-item dropdown brox-nav-item ms-lg-2">
                                <a class="nav-link dropdown-toggle brox-nav-link brox-user-dropdown-toggle" 
                                   href="#" id="broxNavbarUser" role="button" 
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    {% if auth_user.profile_pic is defined and auth_user.profile_pic %}
                                        <img src="{{ auth_user.profile_pic|absolute_url }}" class="rounded-circle me-2 brox-user-avatar" alt="{{ auth_user.username }}" loading="lazy" decoding="async">
                                    {% else %}
                                        <img src="{{ '/assets/images/default-avatar.png'|absolute_url }}" class="rounded-circle me-2 brox-user-avatar" alt="User avatar" loading="lazy" decoding="async">
                                    {% endif %}
                                    <span class="brox-user-dropdown-username d-none d-lg-inline">{{ auth_user.username }}</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end brox-dropdown-menu" aria-labelledby="broxNavbarUser">
                                    <li class="brox-dropdown-header">
                                        <p class="brox-dropdown-user-name mb-1 fw-bold">{{ auth_user.username }}</p>
                                        <span class="badge bg-primary-subtle text-primary rounded-pill">
                                            {% if auth_user.roles is defined and auth_user.roles is not empty %}
                                                {{ auth_user.roles|join(', ')|title }}
                                            {% else %}
                                                <span data-i18n="User">{{ 'User'|trans }}</span>
                                            {% endif %}
                                        </span>
                                    </li>
                                    <li><hr class="dropdown-divider brox-dropdown-divider"></li>
                                    
                                    {# Admin Menu #}
                                    {% if (auth_user.is_super_admin is defined and auth_user.is_super_admin) or (auth_user.role is defined and auth_user.role == 'admin') %}
                                        <li><a class="dropdown-item brox-dropdown-item" href="/admin/profile"><i class="bi bi-person-circle me-2"></i><span data-i18n="Profile">{{ 'Profile'|trans }}</span></a></li>
                                        <li><a class="dropdown-item brox-dropdown-item" href="/admin/dashboard"><i class="bi bi-speedometer2 me-2"></i><span data-i18n="Dashboard">{{ 'Dashboard'|trans }}</span></a></li>
                                        <li><a class="dropdown-item brox-dropdown-item" href="/admin/my/notifications"><i class="bi bi-bell me-2"></i><span data-i18n="Notifications">{{ 'Notifications'|trans }}</span></a></li>
                                        <li><a class="dropdown-item brox-dropdown-item" href="/admin/account-settings"><i class="bi bi-gear me-2"></i><span data-i18n="Settings">{{ 'Settings'|trans }}</span></a></li>
                                        
                                        {% if auth_user.is_super_admin is defined and auth_user.is_super_admin %}
                                            <li><hr class="dropdown-divider brox-dropdown-divider"></li>
                                            <li><a class="dropdown-item brox-dropdown-item" href="/admin/roles"><i class="bi bi-shield-lock me-2"></i>Roles</a></li>
                                            <li><a class="dropdown-item brox-dropdown-item" href="/admin/permissions"><i class="bi bi-key me-2"></i>Permissions</a></li>
                                        {% endif %}
                                    
                                    {# User Menu #}
                                    {% else %}
                                        <li><a class="dropdown-item brox-dropdown-item" href="/profile"><i class="bi bi-person-circle me-2"></i><span data-i18n="Profile">{{ 'Profile'|trans }}</span></a></li>
                                        <li><a class="dropdown-item brox-dropdown-item" href="/user/dashboard"><i class="bi bi-speedometer2 me-2"></i><span data-i18n="Dashboard">{{ 'Dashboard'|trans }}</span></a></li>
                                        <li><a class="dropdown-item brox-dropdown-item" href="/user/notifications"><i class="bi bi-bell me-2"></i><span data-i18n="Notifications">{{ 'Notifications'|trans }}</span></a></li>
                                        <li><a class="dropdown-item brox-dropdown-item" href="/user/settings"><i class="bi bi-gear me-2"></i><span data-i18n="Settings">{{ 'Settings'|trans }}</span></a></li>
