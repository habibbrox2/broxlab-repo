{% extends"layout.twig" %}
{% block title %}{{ post.title }} | {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% block meta_description %}{{ post.excerpt|default(post.content|striptags|slice(0, 160)) }}{% endblock %}
{% block og_image %}{{ post.featured_image|default(post.image|default(app_settings.site_logo))|absolute_url }}{% endblock %}
{% block og_type %}article{% endblock %}
{% set breadcrumbs = [
 { label: 'Articles', url: '/posts', icon: 'newspaper' },
 { label: post.title|slice(0, 40) ~ (post.title|length > 40 ? '...' : ''), icon: 'file-text' }
] %}
{% set page_image = post.featured_image|default(post.image|default(app_settings.site_logo))|absolute_url %}
{% set page_keywords = post.categories is iterable ? post.categories|map(item => item.name)|filter(k => k|length > 0)|unique : [] %}
{% set page_schema = {
 '@context': 'https://schema.org',
 '@type': 'BlogPosting',
 '@id': canonical_url|default(current_url),
 'url': canonical_url|default(current_url),
 'headline': post.title,
 'description': post.content|striptags|slice(0, 160),
 'articleBody': post.content|striptags|slice(0, 2000),
 'wordCount': post.content|striptags|wordcount,
 'image': {
 '@type': 'ImageObject',
 'url': page_image,
 'width': 1200,
 'height': 630
 },
 'datePublished': (post.published_at|default(post.created_at))|date('c'),
 'author': {
 '@type': 'Person',
 'name': post.author
 },
 'publisher': {
 '@type': 'Organization',
 'name': app_settings.site_name,
 'logo': {
 '@type': 'ImageObject',
 'url': app_settings.site_logo|absolute_url,
 'width': 250,
 'height': 100
 }
 },
 'mainEntityOfPage': {
 '@type': 'WebPage',
 '@id': canonical_url|default(current_url)
 },
 'isPartOf': {
 '@type': 'WebSite',
 '@id': url ~ '#website'
 },
 'keywords': page_keywords
} %}
{% if post.updated_at %}
 {% set page_schema = page_schema|merge({'dateModified': post.updated_at|date('c')}) %}
{% endif %}
{% block schema %}
 <script type="application/ld+json">
{{ page_schema|schema_json }}
 </script>
{% endblock %}
{% block extra_styles %}
 <link rel="stylesheet" href="{{ asset('assets/css/feed-discovery.css') }}?v={{ assets_version }}" media="print" onload="this.media='all'">
 <noscript><link rel="stylesheet" href="{{ asset('assets/css/feed-discovery.css') }}?v={{ assets_version }}"></noscript>
 <style>
 .post-view-hero {
 background: linear-gradient(135deg, rgba(15, 23, 42, 0.96) 0%, rgba(79, 70, 229, 0.95) 50%, rgba(14, 165, 233, 0.95) 100%);
 color: #f8fafc;
 }
 .post-view-hero h1 {
 color: #ffffff;
 text-shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
 }
 .post-view-hero .hero-meta {
 gap: 0.75rem;
 }
 .post-view-hero .hero-meta .meta-item {
 background: rgba(255, 255, 255, 0.1);
 border: 1px solid rgba(255, 255, 255, 0.14);
 border-radius: 1rem;
 padding: 0.75rem 1rem;
 color: #e2e8f0;
 min-width: 150px;
 }
 .post-view-hero .hero-meta .meta-item i {
 color: #a5b4fc;
 }
 .post-view-hero .category-badge {
 background: rgba(255, 255, 255, 0.16);
 color: #eff6ff;
 border: 1px solid rgba(255, 255, 255, 0.18);
 }
 .post-view-page .post-content-card {
 border: 1px solid rgba(15, 23, 42, 0.08);
 }
 .post-view-page .post-content-card .content-wrapper {
 word-break: break-word;
 }
 .post-sidebar-sticky {
 position: sticky;
 top: 1.5rem;
 }
 .post-sidebar-sticky .sidebar-card + .sidebar-card {
 margin-top: 1.25rem;
 }
 .post-sidebar-sticky .sidebar-header {
 background: transparent;
 }
 @media (max-width: 991px) {
 .post-sidebar-sticky {
 position: static;
 top: auto;
 }
 }

