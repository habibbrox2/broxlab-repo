 @media (max-width: 768px) {
 .post-view-hero {
 padding: 3rem 0;
 margin-bottom: 2rem;
 }
 .post-view-hero h1 {
 font-size: 2rem;
 line-height: 1.2;
 margin-bottom: 1.5rem;
 }
 .post-view-hero .hero-meta {
 gap: 0.5rem;
 flex-direction: column;
 align-items: flex-start;
 }
 .post-view-hero .hero-meta .meta-item {
 width: 100%;
 min-width: auto;
 padding: 0.5rem 0.75rem;
 margin-bottom: 0.25rem;
 }
 .post-view-hero .hero-meta .meta-item img {
 width: 32px;
 height: 32px;
 }
 .post-view-hero .flex.flex-wrap.gap-2 {
 gap: 0.5rem;
 margin-top: 1rem;
 }
 .post-view-hero .category-badge {
 font-size: 0.75rem;
 padding: 0.375rem 0.75rem;
 }
 .post-view-page .post-content-card .p-4 {
 padding: 1.5rem;
 }
 .post-view-page .post-content-card .content-wrapper {
 font-size: 1rem;
 line-height: 1.6;
 }
 .post-sidebar-sticky .sidebar-card {
 margin-bottom: 1rem;
 }
 .post-sidebar-sticky .p-4 {
 padding: 1rem;
 }
 .post-sidebar-sticky .sidebar-header {
 padding: 1rem;
 }
 .post-sidebar-sticky .sidebar-header h2 {
 font-size: 1rem;
 }
 .post-sidebar-sticky .tag-badge {
 font-size: 0.75rem;
 padding: 0.375rem 0.625rem;
 }
 .post-sidebar-sticky .small {
 font-size: 0.75rem;
 }
 .post-sidebar-sticky .flex.items-center.gap-3 {
 gap: 0.75rem;
 flex-wrap: wrap;
 }
 .post-sidebar-sticky .flex.items-center.justify-between {
 margin-bottom: 0.5rem;
 }
 .post-sidebar-sticky .flex.items-center.justify-between:last-child {
 margin-bottom: 0;
 }
 }

 @media (min-width: 769px) and (max-width: 991px) {
 .post-view-hero {
 padding: 4rem 0;
 margin-bottom: 3rem;
 }
 .post-view-hero h1 {
 font-size: 2.5rem;
 line-height: 1.3;
 }
 .post-view-hero .hero-meta {
 gap: 1rem;
 flex-wrap: wrap;
 }
 .post-view-hero .hero-meta .meta-item {
 min-width: 180px;
 flex: 1 1 auto;
 }
 .post-view-hero .flex.flex-wrap.gap-2 {
 gap: 0.75rem;
 }
 .post-view-page .post-content-card .p-4 {
 padding: 2rem 2.5rem;
 }
 .post-sidebar-sticky {
 top: 1rem;
 }
 .post-sidebar-sticky .sidebar-card + .sidebar-card {
 margin-top: 1rem;
 }
 .post-sidebar-sticky .p-4 {
 padding: 1.25rem;
 }
 .post-sidebar-sticky .sidebar-header {
 padding: 1.25rem;
 }
 .post-sidebar-sticky .tag-badge {
 font-size: 0.8rem;
 padding: 0.5rem 0.75rem;
 }
 .post-sidebar-sticky .flex.items-center.gap-3 {
 gap: 1rem;
 }
 }

 /* Additional mobile optimizations */
 @media (max-width: 576px) {
 .post-view-hero .lg:col-span-4 {
 margin-top: 2rem;
 }
 .post-view-hero .lg:col-span-4 .inline-flex {
 padding: 1rem;
 }
 .post-view-hero .lg:col-span-4 .lucide-book-open {
 font-size: 2rem;
 }
 .post-view-page .grid-cols-1.md\:grid-cols-12 {
 gap: 1.5rem;
 }
 .post-view-page .lg:col-span-8,
 .post-view-page .lg:col-span-4 {
 padding-left: 0.75rem;
 padding-right: 0.75rem;
 }
 .p-4.p-4 {
 padding: 1.25rem !important;
 }
 .p-4.p-3 {
 padding: 1rem !important;
 }
 .mb-4 {
 margin-bottom: 1.5rem !important;
 }
 .mb-3 {
 margin-bottom: 1rem !important;
 }
 .gap-3 {
 gap: 0.75rem !important;
 }
 .gap-2 {
 gap: 0.5rem !important;
 }
 .mr-3 {
 margin-right: 0.75rem !important;
 }
 .mr-2 {
 margin-right: 0.5rem !important;
 }
 .mr-1 {
 margin-right: 0.25rem !important;
 }
 .ml-2 {
 margin-left: 0.5rem !important;
 }
 .p-2 {
 padding: 0.5rem !important;
 }
 .p-3 {
 padding: 0.75rem !important;
 }
 .p-4 {
 padding: 1rem !important;
 }.rounded-full {
    border-radius: 50rem !important;
  }
 .rounded-2xl {
 border-radius: 0.75rem !important;
 }
 }
 </style>
{% endblock %}
{% block content %}
 <section class="post-view-hero relative overflow-hidden mb-5 pt-12 pb-8 md:pt-16 md:pb-12">
 <div class="absolute inset-0 opacity-10" aria-hidden="true"></div>
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative">
 <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 items-center">
 <div class="lg:col-span-8">
 <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-3" style="text-shadow: 0 4px 12px rgba(0,0,0,0.3)">{{ post.title }}</h1>
 {# Author & Meta Information #}
 <div class="hero-meta flex flex-wrap gap-3 mb-3">
 <div class="meta-item flex items-center">
 <img src="{{ '/assets/images/default-avatar.png'|absolute_url }}"
 alt="Author {{ post.author }} avatar"
 class="rounded-full mr-2 h-10 w-10"
 loading="lazy">
 <span class="font-semibold">{{ post.author }}</span>
 </div>
 {% if post.created_at or post.published_at %}
 <div class="meta-item flex items-center">
 <i class="lucide lucide-calendar-check mr-2"></i>
 <div>
 <div class="text-xs uppercase tracking-wider opacity-75">Published</div>
 <time datetime="{{ (post.published_at|default(post.created_at))|date("Y-m-d") }}" class="font-semibold block">
 {{ (post.published_at|default(post.created_at))|date("M j, Y \\a\\t g:i A") }}
 </time>
 </div>
 </div>
 {% endif %}
 </div>
 {# Categories & Tags #}
 <div class="flex flex-wrap gap-2">
 {% if post.categories %}
 {% for cat in post.categories %}
 <a href="/category/{{ cat.slug }}"
 class="inline-flex items-center gap-1 rounded-full bg-white/20 px-3 py-1.5 text-xs font-semibold text-white no-underline hover:bg-white/30 transition-colors">
 <i class="lucide lucide-folder mr-1"></i>{{ cat.name }}
 </a>
 {% endfor %}
 {% endif %}
 {% if post.tags %}
 {% for tag in post.tags %}
 <a href="/tag/{{ tag.slug }}"
 class="inline-flex items-center gap-1 rounded-full bg-white/20 px-3 py-1.5 text-xs font-semibold text-white/90 no-underline hover:bg-white/30 transition-colors">
 <i class="lucide lucide-tag mr-1"></i>{{ tag.name }}
 </a>
 {% endfor %}
 {% endif %}
 </div>
 </div>
 <div class="lg:col-span-4 text-center lg:text-right mt-4 lg:mt-0">
 <div class="inline-flex items-center justify-center h-20 w-20 rounded-full bg-white/10">
 <i class="lucide lucide-book-open text-white text-4xl"></i>
 </div>
 </div>
 </div>
 </div>
 </section>
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-5 post-view-page">
 {# Quick Access Panel #}
 {% include 'partials/quick-access.twig' with { context_type: 'post', context_id: post.id } %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 {# Main Content Column #}
 <div class="lg:col-span-8">
 {# Post Content Card #}
 <article class="rounded-2xl border border-slate-200 bg-white shadow-sm mb-4 post-content-card">
 <div class="p-5 md:p-7">
 <div class="content-wrapper text-base leading-relaxed">{{ post.content|raw }}</div>
 </div>
 </article>
 {% include 'partials/content-rating.twig' with { content_type: 'post', content_id: post.id } %}
 {# Author Info Card #}
 <aside class="rounded-2xl border border-slate-200 bg-white shadow-sm mb-4"
 aria-labelledby="author-info">
 <div class="p-4">
 <div class="flex items-center">
 <div class="relative mr-3">
 <img src="{{ '/assets/images/default-avatar.png'|absolute_url }}"
 alt="Author {{ post.author }} profile photo"
 class="rounded-full h-12 w-12"
 loading="lazy">
 <div class="absolute -bottom-0.5 -end-0.5 h-3 w-3 rounded-full bg-emerald-600 ring-2 ring-white"
 title="Active author"></div>
 </div>
 <div class="flex-1 min-w-0">
 <h2 id="author-info" class="mb-1 font-bold text-lg">{{ post.author }}</h2>
 <p class="text-slate-500 mb-2 text-sm">
 <i class="lucide lucide-pen mr-1"></i>Article Author
 </p>
 <p class="text-slate-500 mb-0 text-sm">
 Published on <time datetime="{{ (post.published_at|default(post.created_at))|date("Y-m-d") }}">{{ (post.published_at|default(post.created_at))|date("M j, Y \\a\\t g:i A") }}</time>
 </p>
 </div>
 <div>
 <button class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-colors" type="button">
 <i class="lucide lucide-user-plus mr-1"></i>Follow
 </button>
 </div>
 </div>
 </div>
 </aside>
 {# Share Section #}
 <div class="mb-4">
 {% include 'partials/share.twig' with {
 url: current_url,
 title: post.title,
 description: post.content|striptags|slice(0, 100)
 } %}
 </div>
 {# Previous / Next Navigation #}<nav class="rounded-2xl border border-slate-200 bg-white shadow-sm mb-4"
                     aria-label="Post navigation">
 <div class="p-4">
 <div class="grid grid-cols-2 gap-3">
 <div>
 {% if previousPost %}
 <a href="{{ previousPost.id ? '/posts/' ~ previousPost.id ~ '/' ~ (('' ~ (previousPost.slug|default(previousPost.url|default(previousPost.id))))|url_encode) : '/posts/view/' ~ (('' ~ (previousPost.slug|default(previousPost.url|default(previousPost.id))))|url_encode) }}"
 class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-colors w-full"
 aria-label="Previous post: {{ previousPost.title }}">
 <i class="lucide lucide-arrow-left mr-2"></i>
 <span class="hidden md:inline">Previous</span>
 </a>
 {% else %}
 <button class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-200 bg-slate-100 px-4 py-2.5 text-sm font-semibold text-slate-400 cursor-not-allowed w-full" disabled>
 <i class="lucide lucide-arrow-left mr-2"></i>
 <span class="hidden md:inline">Previous</span>
 </button>
 {% endif %}
 </div>
 <div>
 {% if nextPost %}
 <a href="{{ nextPost.id ? '/posts/' ~ nextPost.id ~ '/' ~ (('' ~ (nextPost.slug|default(nextPost.url|default(nextPost.id))))|url_encode) : '/posts/view/' ~ (('' ~ (nextPost.slug|default(nextPost.url|default(nextPost.id))))|url_encode) }}"
 class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-colors w-full"
 aria-label="Next post: {{ nextPost.title }}">
 <span class="hidden md:inline">Next</span>
 <i class="lucide lucide-arrow-right ml-2"></i>
 </a>
 {% else %}
 <button class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-200 bg-slate-100 px-4 py-2.5 text-sm font-semibold text-slate-400 cursor-not-allowed w-full" disabled>
 <span class="hidden md:inline">Next</span>
 <i class="lucide lucide-arrow-right ml-2"></i>
 </button>
 {% endif %}
 </div>
 </div>
 </div>
 </nav>
 {# Comments Section #}
 <section id="comments-wrapper" class="mb-4" aria-labelledby="comments-title">
 <h2 id="comments-title" class="sr-only">Comments Section</h2>
 {% include 'comments/comments.twig' with { content_type: 'post', content_id: post.id, comments: comments } %}
 </section>
 {# Related Articles Section #}
 {% include 'partials/related-section.twig' with {
 items: relatedPosts,
 title: 'Related Articles',
 type: 'post',
 gradient: 'linear-gradient(135deg, #1417f1 0%, #8b5cf6 100%)',
 view_all_url: '/posts',
 id: 'related-articles-title',
 variant: 'pro'
 } %}
 </div>
 {# Sidebar #}
 <aside class="lg:col-span-4" role="complementary" aria-label="Sidebar">
 <div class="post-sidebar-sticky">
 {# Quick Navigation #}<nav class="rounded-2xl border border-slate-200 bg-white shadow-sm mb-4"
                     aria-labelledby="quick-nav-title">
 <div class="sidebar-header bg-gradient-to-r from-indigo-500 to-violet-500 px-4 py-3 rounded-t-2xl">
 <h2 id="quick-nav-title" class="mb-0 font-bold text-sm text-white">
 <i class="lucide lucide-list mr-2"></i>Quick Navigation
 </h2>
 </div>
 <div class="p-4">
 <ul class="list-none pl-0 mb-0 text-sm">
 <li class="mb-2">
 <a href="#comments-wrapper"
 class="no-underline flex items-center gap-2 p-2 rounded-lg hover:bg-slate-100 transition-colors text-sm">
 <i class="lucide lucide-message-circle text-indigo-600"></i>
 <span>Comments</span>
 </a>
 </li>
 {% if relatedPosts %}
 <li>
 <a href="#related-articles-title"
 class="no-underline flex items-center gap-2 p-2 rounded-lg hover:bg-slate-100 transition-colors text-sm">
 <i class="lucide lucide-link text-indigo-600"></i>
 <span>Related Articles</span>
 </a>
 </li>
 {% endif %}
 <li>
 <a href="/posts"
 class="no-underline flex items-center gap-2 p-2 rounded-lg hover:bg-slate-100 transition-colors text-sm">
 <i class="lucide lucide-grid-3x3 text-slate-600"></i>
 <span>All Articles</span>
 </a>
 </li>
 </ul>
 </div>
 </nav>
 {# Popular Articles #}
 {% if popularPosts and popularPosts|length > 0 %}
 <section class="rounded-2xl border border-slate-200 bg-white shadow-sm mb-4"
 aria-labelledby="popular-title">
 <div class="border-b border-slate-200 bg-gradient-to-r from-emerald-500 to-teal-500 px-4 py-3 rounded-t-2xl">
 <h2 id="popular-title" class="mb-0 font-bold text-sm text-white">
 <i class="lucide lucide-flame mr-2"></i>Popular Articles
 </h2>
 </div>
 <div class="p-4">
 <ul class="list-none pl-0 mb-0">
 {% for pp in popularPosts|slice(0, 5) %}
 <li class="mb-3 {% if not loop.last %}pb-3 border-b border-slate-100{% endif %}">
 <a href="{{ pp.id ? '/posts/' ~ pp.id ~ '/' ~ (('' ~ (pp.slug|default(pp.url|default(pp.id))))|url_encode) : '/posts/view/' ~ (('' ~ (pp.slug|default(pp.url|default(pp.id))))|url_encode) }}"
 class="no-underline text-slate-800 hover:text-indigo-600 block transition-colors"
 aria-label="Read popular article: {{ pp.title }}">
 <h3 class="text-sm font-semibold mb-1 line-clamp-2">{{ pp.title }}</h3>
 </a>
 <div class="text-xs text-slate-500 flex items-center gap-3">
 <span>
 <i class="lucide lucide-calendar-check mr-1"></i>{{ (pp.published_at|default(pp.created_at))|date("M j, Y \\a\\t g:i A") }}
 </span>
 </div>
 </li>
 {% endfor %}
 </ul>
 </div>
 </section>
 {% endif %}
 {# Categories Widget #}
 {% if post.categories and post.categories|length > 0 %}
 <section class="rounded-2xl border border-slate-200 bg-white shadow-sm mb-4"
 aria-labelledby="categories-title">
 <div class="border-b border-slate-200 bg-gradient-to-r from-amber-500 to-orange-500 px-4 py-3 rounded-t-2xl">
 <h2 id="categories-title" class="mb-0 font-bold text-sm text-white">
 <i class="lucide lucide-folder mr-2"></i>Categories
 </h2>
 </div>
 <div class="p-4">
 <div class="flex flex-wrap gap-2">
 {% for cat in post.categories %}
 <a href="/category/{{ cat.slug }}"
 class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 no-underline hover:bg-amber-500 hover:text-white transition-colors">
 <i class="lucide lucide-folder-open mr-1"></i>{{ cat.name }}
 </a>
 {% endfor %}
 </div>
 </div>
 </section>
 {% endif %}
 {# Tags Cloud #}
 {% if post.tags and post.tags|length > 0 %}
 <section class="rounded-2xl border border-slate-200 bg-white shadow-sm mb-4"
 aria-labelledby="tags-title">
 <div class="border-b border-slate-200 bg-gradient-to-r from-sky-500 to-cyan-500 px-4 py-3 rounded-t-2xl">
 <h2 id="tags-title" class="mb-0 font-bold text-sm text-white">
 <i class="lucide lucide-tags mr-2"></i>Tags
 </h2>
 </div>
 <div class="p-4">
 <div class="flex flex-wrap gap-2">
 {% for tag in post.tags %}
 <a href="/tag/{{ tag.slug }}"
 class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 no-underline hover:bg-sky-500 hover:text-white transition-colors">
 <i class="lucide lucide-tag mr-1"></i>{{ tag.name }}
 </a>
 {% endfor %}
 </div>
 </div>
 </section>
 {% endif %}
 {# Article Stats Card #}
 <section class="rounded-2xl border border-slate-200 bg-white shadow-sm"
 aria-labelledby="stats-title">
 <div class="border-b border-slate-200 bg-gradient-to-r from-indigo-500 to-purple-600 px-4 py-3 rounded-t-2xl">
 <h2 id="stats-title" class="mb-0 font-bold text-sm">
 <i class="lucide lucide-trending-up mr-2"></i>Article Statistics
 </h2>
 </div>
 <div class="p-4">
 <div class="flex flex-col gap-3">
 {% if post.created_at or post.published_at %}
 <div class="flex items-center justify-between">
 <span class="text-xs text-slate-500">
 <i class="lucide lucide-calendar-check text-sky-600 mr-1"></i>Published
 </span>
 <span class="text-xs font-bold">{{ (post.published_at|default(post.created_at))|date("M j, Y \\a\\t g:i A") }}</span>
 </div>
 {% endif %}
 <div class="flex items-center justify-between">
 <span class="text-xs text-slate-500">
 <i class="lucide lucide-clock text-amber-600 mr-1"></i>Read Time
 </span>
 <span class="text-xs font-bold">{{ ((post.content|striptags|length / 1000)|round)|default(1) }} min</span>
 </div>
 </div>
 </div>
 </section>
 </div>
 </aside>
 </div>
 </div>
 {# JavaScript #}
 <script>
 // Smooth scroll for anchor links
 document.querySelectorAll('a[href^="#"]').forEach(anchor => {
 anchor.addEventListener('click', function (e) {
 const targetId = this.getAttribute('href');
 if (targetId === '#') return;

 const targetElement = document.querySelector(targetId);
 if (targetElement) {
 e.preventDefault();
 targetElement.scrollIntoView({
 behavior: 'smooth',
 block: 'start'
 });

 // Update focus for accessibility
 targetElement.setAttribute('tabindex', '-1');
 targetElement.focus();
 }
 });
 });

 // Add external link icons and attributes
 document.querySelectorAll('.content-wrapper a[href^="http"]').forEach(link => {
 // Don't modify if it's an internal link
 if (!link.href.includes(window.location.hostname)) {
 link.setAttribute('target', '_blank');
 link.setAttribute('rel', 'noopener noreferrer');
 link.innerHTML += ' <i class="lucide lucide-external-link text-xs"></i>';
 }
 });

 // Add reading progress bar
 const addReadingProgress = () => {
 const progressBar = document.createElement('div');
 progressBar.id = 'reading-progress';
 progressBar.style.cssText = `
 position: fixed;
 top: 0;
 left: 0;
 height: 3px;
 background: linear-gradient(90deg, #6366f1, #8b5cf6);
 width: 0%;
 z-index: 9999;
 transition: width 0.1s ease;
 `;
 document.body.appendChild(progressBar);

 window.addEventListener('scroll', () => {
 const windowHeight = window.innerHeight;
 const documentHeight = document.documentElement.scrollHeight;
 const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
 const scrollPercent = (scrollTop / (documentHeight - windowHeight)) * 100;
 progressBar.style.width = scrollPercent + '%';
 });
 };

 addReadingProgress();
 </script>
{% endblock %}














