 {"@type":"Question","name": {{ 'How can I delete my account?'|trans|json_encode }},"acceptedAnswer": {"@type":"Answer","text": {{ 'You can request account deletion from your account settings. Please note that this action cannot be undone.'|trans|json_encode }}
 }
 },
 {"@type":"Question","name": {{ 'Do you accept guest posts?'|trans|json_encode }},"acceptedAnswer": {"@type":"Answer","text": {{ 'Yes! We welcome guest posts from experienced reviewers and tech writers. Please contact us with your proposal.'|trans|json_encode }}
 }
 }
 ]
}
 </script>
