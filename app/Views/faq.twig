{% extends 'layout.twig' %}
{% block title %}{{ 'FAQ - Frequently Asked Questions'|trans }} | {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% set breadcrumbs = [{"label": 'FAQ'|trans,"url":"/faq","icon":"question"}] %}
{% block content %}
 {# Hero Section #}
 <section class="hero-section relative py-5 mb-5 overflow-hidden bg-gradient-to-br from-indigo-100 via-white to-sky-100">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 items-center">
 <div class="lg:col-span-8">
 <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-3">
 <i class="lucide lucide-circle-help mr-2 inline-block align-middle" style="width:1.25em;height:1.25em;"></i>{{ 'Frequently Asked Questions'|trans }}
 </h1>
 <p class="text-lg md:text-xl text-slate-500">{{ 'Find answers to common questions about our services and platform'|trans }}</p>
 </div>
 <div class="lg:col-span-4 text-center">
 <div class="hero-icon text-6xl opacity-50">â“</div>
 </div>
 </div>
 </div>
 </section>
 {# Structured Data - FAQ Schema (all 8 Q&A pairs dynamically) #}
 <script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity": [
 {"@type":"Question","name": {{ 'What is BroxBhai?'|trans|json_encode }},"acceptedAnswer": {"@type":"Answer","text": {{ 'BroxBhai is a comprehensive platform for mobile device reviews, tech news, and gadget discussions. We provide detailed reviews, comparisons, and guides to help you make informed decisions about your tech purchases.'|trans|json_encode }}
 }
 },
 {"@type":"Question","name": {{ 'How can I submit a review?'|trans|json_encode }},"acceptedAnswer": {"@type":"Answer","text": {{ 'You need to create an account first, then navigate to your dashboard and click"Submit Review". Make sure to provide detailed information and include photos if possible.'|trans|json_encode }}
 }
 },
 {"@type":"Question","name": {{ 'How do I report inappropriate content?'|trans|json_encode }},"acceptedAnswer": {"@type":"Answer","text": {{ 'If you find any inappropriate content or spam, please use the report button on that content or contact us directly with details.'|trans|json_encode }}
 }
 },
 {"@type":"Question","name": {{ 'Can I edit my profile?'|trans|json_encode }},"acceptedAnswer": {"@type":"Answer","text": {{ 'Yes! Once you are logged in, go to your profile settings where you can update your name, email, profile picture, and other personal information.'|trans|json_encode }}
 }
 },
 {"@type":"Question","name": {{ 'How often is content updated?'|trans|json_encode }},"acceptedAnswer": {"@type":"Answer","text": {{ 'We publish new reviews, news, and guides regularly. Subscribe to our newsletter to get the latest updates.'|trans|json_encode }}
 }
 },
 {"@type":"Question","name": {{ 'Is BroxBhai free to use?'|trans|json_encode }},"acceptedAnswer": {"@type":"Answer","text": {{ 'Yes! BroxBhai is completely free to browse, read reviews, and participate in discussions. You only need to create a free account to submit content.'|trans|json_encode }}
 }
