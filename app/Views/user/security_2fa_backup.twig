{% extends"layout.twig" %}
{% block title %}Backup Codes{% endblock %}
{% block content %}
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
 <!-- Page Header -->
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-amber-500/20 via-amber-50 to-white p-6 sm:p-8">
   <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
     <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-amber-400/30 blur-3xl"></div>
     <div class="absolute -bottom-10 -left-10 h-32 w-32 rounded-full bg-orange-400/20 blur-3xl"></div>
   </div>
   <div class="relative">
     <nav aria-label="breadcrumb" class="mb-2">
       <ol class="flex items-center gap-2 text-sm text-slate-500 list-none p-0 m-0">
         <li><a href="/profile" class="text-indigo-600 hover:text-indigo-800 transition-colors no-underline">Profile</a></li>
         <li class="before:content-['/'] before:mx-2 before:text-slate-300"><a href="/user/security/2fa" class="text-indigo-600 hover:text-indigo-800 transition-colors no-underline">2FA Settings</a></li>
         <li class="before:content-['/'] before:mx-2 before:text-slate-300" aria-current="page">Backup Codes</li>
       </ol>
     </nav>
     <div class="flex items-center gap-2.5">
       <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-600 text-white shadow-lg shadow-amber-600/20">
         <i class="lucide lucide-download" style="width:1.25em;height:1.25em;"></i>
       </div>
       <div>
         <h1 class="text-xl font-black tracking-tight text-slate-900 sm:text-2xl">ব্যাকআপ কোড</h1>
         <p class="mt-0.5 text-sm text-slate-500">এই কোডগুলি নিরাপদ স্থানে সংরক্ষণ করুন; এগুলি আপনার 2FA কোড ব্যর্থ হলে ব্যবহার হবে।</p>
       </div>
     </div>
   </div>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 justify-center">
 <div class="md:col-span-8">
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-amber-300/60 bg-white shadow-sm transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-amber-200/60 bg-gradient-to-r from-amber-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-100 text-amber-600">
 <i class="lucide lucide-download" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">আপনার ব্যাকআপ কোডগুলি সংরক্ষণ করুন</h5>
 </div>
 <div class="p-5">
 <div class="p-4 rounded-lg bg-red-600-light text-red-600-dark border border-danger" role="alert">
 <strong><i class="lucide lucide-alert-circle"></i> মনোযোগ!</strong>
 <p class="mt-2 mb-0">
 এই কোডগুলি শুধুমাত্র এখন দেখানো হবে। সেগুলি নিরাপদ জায়গায় সংরক্ষণ করুন।
 আপনি যদি আপনার ফোন হারান, এই কোডগুলি আপনার অ্যাকাউন্টে অ্যাক্সেস পেতে সাহায্য করবে।
 </p>
 </div>
 <!-- Backup Codes Display -->
 <div class="backup-codes-box bg-neutral-50 p-4 rounded-lg mb-4">
 <p class="text-neutral-500 mb-3">
 <i class="lucide lucide-shield"></i> প্রতিটি কোড একবার ব্যবহার করা যায়:
 </p>
 <div class="codes-list">
 {% for code in backup_codes %}
 <div class="code-item mb-2 p-2 bg-white rounded border">
 <code class="font-bold">
 {{ code }}
 </code>
 </div>
 {% endfor %}
 </div>
 </div>
 <!-- Action Buttons -->
 <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
 <div>
 <button type="button" class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-sky-500 text-white text-sm font-medium hover:bg-sky-600 transition-colors" data-action="copyAllCodes">
 <i class="lucide lucide-clipboard"></i> সবগুলি কপি করুন
 </button>
 </div>
 <div>
 <button type="button" class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-lg border border-neutral-300 bg-white text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition-colors" data-action="printCodes">
 <i class="lucide lucide-printer"></i> প্রিন্ট করুন
 </button>
 </div>
 </div>
 <hr class="my-4">
 <!-- Safe Storage Tips -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-sky-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-sky-100 text-sky-600">
 <i class="lucide lucide-lock" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">নিরাপদ সংরক্ষণ পরামর্শ</h5>
 </div>
 <div class="p-4">
 <p>
 এই কোডগুলি সংরক্ষণ করার জন্য সুপারিশকৃত উপায়গুলি:
 </p>
 <ul>
 <li>
 <strong>✅ ভালো:</strong> শক্তিশালী পাসওয়ার্ড দিয়ে এনক্রিপ্ট করা ফাইলে
 </li>
 <li>
 <strong>✅ ভালো:</strong> নিরাপদ স্থানে মুদ্রিত এবং সংরক্ষিত
 </li>
 <li>
 <strong>✅ ভালো:</strong> নির্ভরযোগ্য পাসওয়ার্ড ম্যানেজারে
 </li>
 <li>
 <strong>❌ খারাপ:</strong> সাধারণ টেক্সট ফাইলে
 </li>
 <li>
 <strong>❌ খারাপ:</strong> ইমেইল বা ক্লাউডে অরক্ষিত
 </li>
 <li>
 <strong>❌ খারাপ:</strong> অন্য কারো কাছে পাঠানো
 </li>
 </ul>
 </div>
 </div>
 <hr class="my-4">
 <!-- How to Use -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-emerald-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600">
 <i class="lucide lucide-help-circle" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">কীভাবে ব্যবহার করবেন?</h5>
 </div>
 <div class="p-4">
 <p>
 যদি আপনি আপনার ফোন হারান বা Authenticator অ্যাপ অ্যাক্সেস করতে না পারেন:
 </p>
 <ol>
 <li>লগইন পৃষ্ঠায় যান</li>
 <li>ইমেইল এবং পাসওয়ার্ড প্রবেশ করুন</li>
 <li>
 2FA কোড পাওয়ার জায়গায়, এই ব্যাকআপ কোডগুলির একটি ব্যবহার করুন
 </li>
 <li>আপনি লগইন করার পরে, নতুন 2FA সেটআপ করুন</li>
 </ol>
 <p class="mt-3 text-red-600">
 <strong>নোট:</strong> প্রতিটি ব্যাকআপ কোড শুধুমাত্র একবার ব্যবহার করা যায়!
 </p>
 </div>
 </div>
 <hr class="my-4">
 <!-- Next Steps -->
 <div class="p-4 rounded-lg bg-emerald-600-light text-emerald-600-dark border border-success" role="alert">
 <strong><i class="lucide lucide-check-circle"></i> সম্পন্ন!</strong>
 <p class="mt-2 mb-0">
 আপনার 2FA সেটআপ সম্পূর্ণ। আপনার অ্যাকাউন্ট এখন সুরক্ষিত।
 পরবর্তী লগইনে, আপনাকে একটি 2FA কোড প্রদান করতে হবে।
 </p>
 </div>
 <a href="/user/security/2fa" class="w-full inline-flex items-center justify-center px-5 py-3 rounded-lg bg-indigo-600 text-white text-base font-medium hover:bg-indigo-600/90 transition-colors">
 <i class="lucide lucide-arrow-left"></i> 2FA সেটিংসে ফিরে যান
 </a>
 </div>
 </div>
 </div>
 </div>
 </div>
 <script>
function copyAllCodes() {
 const codeItems = document.querySelectorAll('.code-item code');
 let allCodes = '';
 codeItems.forEach(code => {
 allCodes += code.textContent + '\n';
 });

 navigator.clipboard.writeText(allCodes).then(() => {
 alert('সব কোড কপি করা হয়েছে!');
 });
}

function printCodes() {
 window.print();
}

// ক্লিক করে কোড কপি করুন
document.querySelectorAll('.code-item').forEach(item => {
 item.addEventListener('click', function() {
 const code = this.querySelector('code').textContent;
 navigator.clipboard.writeText(code).then(() => {
 const originalBg = this.style.backgroundColor;
 this.style.backgroundColor = '#c3e6cb';
 setTimeout(() => {
 this.style.backgroundColor = originalBg;
 }, 200);
 });
 });
});
 

<script>
document.addEventListener("click", function(e) {
  var t = e.target.closest("[data-action]");
  if (!t) return;
  var a = t.getAttribute("data-action");
  var id = t.dataset.id;
  if (a && window[a]) window[a](id, t);
});
</script>
</script>
{% endblock %}




