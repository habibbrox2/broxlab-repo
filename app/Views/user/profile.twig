{% extends"layout.twig" %}
{% block title %}My Profile - {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% block content %}
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
 <!-- Page Header -->
 <div class="mb-4 profile-page-header">
 <h1 class="h2 mb-1 font-bold profile-page-title">
 <i class="lucide lucide-user text-indigo-600 mr-2"></i>My Profile
 </h1>
 <p class="text-neutral-500 mb-0 profile-page-subtitle">Manage your personal information and settings</p>
 </div>
 <!-- Profile Header Card -->
 <div class="bg-white rounded-xl shadow-sm mb-4 overflow-hidden">
 <!-- Gradient Background Header -->
 <div class="bg-gradient-to-r from-indigo-600/10 to-transparent h-32"></div>
 <div class="p-4 relative">
 <div class="flex items-end gap-4">
 <div class="flex-shrink-0">
 <!-- Profile Picture with Ring -->
 <div class="relative">
 {% if user.profile_pic %}
 <img src="{{ user.profile_pic }}"
 alt="Profile Picture"
 class="rounded-full border-4 border-white shadow-md"
 width="140"
 height="140">
 {% else %}
 <img src="/assets/images/default-avatar.png"
 alt="Default Avatar"
 class="rounded-full border-4 border-white shadow-md"
 width="140"
 height="140">
 {% endif %}
 <span class="absolute bottom-0 end-0 w-4 h-4 bg-emerald-600 rounded-full border-2 border-white"
 data-brox-toggle="tooltip"
 title="Active"></span>
 </div>
 </div>
 <div class="flex-1 min-w-0">
 <div class="flex flex-col md:flex-grid grid-cols-1 gap-4 md:grid-cols-12 justify-between items-start md:items-center gap-3 mt-3 md:mt-0">
 <div>
 <h3 class="mb-1 font-bold">{{ user.first_name ~ ' ' ~ user.last_name }}</h3>
 <p class="text-neutral-500 mb-2">
 <i class="lucide lucide-at-sign"></i> {{ user.username }}
 </p>
 <!-- User Roles Badges -->
 {% if auth_user.roles is not empty %}
 <div class="flex flex-wrap gap-2 mb-2">
 {% for role in auth_user.roles %}
 <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium" style="background-color: var(--role-{{ role|default('user') }}-bg, #f0f0f0); color: var(--role-{{ role|default('user') }}-text, #333); border: 1px solid var(--role-{{ role|default('user') }}-border, #ddd);">
 <i class="lucide lucide-shield-check mr-1"></i>
 {{ role|replace({"_":""}) |title }}
 </span>
 {% endfor %}
 </div>
 {% endif %}
 </div>
 <!-- Quick Actions -->
 <div class="flex gap-2">
 <a href="/profile/edit" class="inline-flex items-center px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-sm font-medium shadow-sm hover:bg-indigo-600/90 transition-colors">
 <i class="lucide lucide-pencil mr-1"></i> Edit Profile
 </a>
 <div class="relative inline-block">
 <button class="inline-flex items-center px-3 py-1.5 rounded-lg border border-neutral-300 bg-white text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition-colors shadow-sm"
 type="button"
 data-brox-toggle="dropdown">
 <i class="lucide lucide-ellipsis-vertical"></i>
 </button>
 <ul class="absolute right-0 z-50 mt-1 min-w-[200px] bg-white border border-slate-200 rounded-lg shadow-lg py-1 hidden group-focus-within:block" data-brox-dropdown-menu>
 <li>
 <a class="block px-4 py-2 text-sm text-neutral-700 hover:bg-neutral-100 no-underline" href="/profile/password"><i class="lucide lucide-key mr-2"></i> Change Password</a>
 </li>
 <li>
 <a class="block px-4 py-2 text-sm text-neutral-700 hover:bg-neutral-100 no-underline" href="/user/security/2fa"><i class="lucide lucide-shield mr-2"></i> 2FA Settings</a>
 </li>
 </ul>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
 <!-- Left Column -->
 <div class="lg:col-span-1">
 <!-- Contact Information -->
 <div class="bg-white rounded-xl shadow-sm border border-slate-200 mb-4">
 <div class="p-4">
 <h5 class="mb-4 font-bold">
 <i class="lucide lucide-user text-indigo-600 mr-2"></i>Contact Information
 </h5>
 <div class="mb-3">
 <label class="text-neutral-500 text-xs block mb-1">Email Address</label>
 <div class="flex items-center">
 <i class="lucide lucide-mail text-indigo-600 mr-2"></i>
 <span class="text-break">{{ user.email }}</span>
 </div>
 </div>
 <div class="mb-3">
 <label class="text-neutral-500 text-xs block mb-1">Phone Number</label>
 <div class="flex items-center">
 <i class="lucide lucide-phone text-indigo-600 mr-2"></i>
 <span>{{ user.phone|default("Not provided") }}</span>
 </div>
 </div>
 <div class="mb-0">
 <label class="text-neutral-500 text-xs block mb-1">Account Status</label>
 <div class="flex items-center">
 <i class="lucide lucide-shield-check text-emerald-600 mr-2"></i>
 <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-200">{{ user.status|title }}</span>
 </div>
 </div>
 </div>
 </div>
 <!-- Social Links -->
 <div class="bg-white rounded-xl shadow-sm border border-slate-200 mb-4">
 <div class="p-4">
 <h5 class="mb-4 font-semibold text-base">
 <i class="lucide lucide-share-2 text-indigo-600 mr-2"></i>Social Profiles
 </h5>
 {% set social_links = [
 {name: 'Facebook', url: user.facebook_url, icon: 'facebook', color: '#1877f2'},
 {name: 'Twitter', url: user.twitter_url, icon: 'twitter-x', color: '#000000'},
 {name: 'Instagram', url: user.instagram_url, icon: 'instagram', color: '#e4405f'},
 {name: 'LinkedIn', url: user.linkedin_url, icon: 'linkedin', color: '#0a66c2'}
 ] %}
 {% for social in social_links %}
 <div class="flex items-center justify-between mb-3 pb-3 {% if not loop.last %}border-b border-slate-100{% endif %}">
 <div class="flex items-center">
 <div class="rounded-full p-2 mr-3"
 style="background-color: {{ social.color }}15">
 <i class="lucide lucide-{{ social.icon }}"
 style="color: {{ social.color }};
 font-size: 1.2rem"></i>
 </div>
 <span class="font-medium">{{ social.name }}</span>
 </div>
 {% if social.url %}
 <a href="{{ social.url }}"
 target="_blank"
 class="inline-flex items-center px-3 py-1.5 rounded-lg border border-neutral-300 text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition-colors">
 <i class="lucide lucide-external-link"></i>
 </a>
 {% else %}
 <span class="text-neutral-500 text-xs">Not linked</span>
 {% endif %}
 </div>
 {% endfor %}
 </div>
 </div>
 </div>
 <!-- Right Column -->
 <div class="lg:col-span-2">
 <!-- Personal Information -->
 <div class="bg-white rounded-xl shadow-sm border border-slate-200 mb-4">
 <div class="p-4">
 <h5 class="mb-4 font-semibold text-base">
 <i class="lucide lucide-info text-indigo-600 mr-2"></i>Personal Information
 </h5>
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">First Name</label>
 <p class="mb-0 font-medium">{{ user.first_name|default("N/A") }}</p>
 </div>
 </div>
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">Last Name</label>
 <p class="mb-0 font-medium">{{ user.last_name|default("N/A") }}</p>
 </div>
 </div>
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">Gender</label>
 <p class="mb-0 font-medium">{{ user.gender|default("N/A") |title }}</p>
 </div>
 </div>
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">Date of Birth</label>
 <p class="mb-0 font-medium">{{ user.dob ? user.dob|date("F j, Y") : 'N/A' }}</p>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Address Information -->
 <div class="bg-white rounded-xl shadow-sm border border-slate-200 mb-4">
 <div class="p-4">
 <h5 class="mb-4 font-semibold text-base">
 <i class="lucide lucide-map-pin text-indigo-600 mr-2"></i>Address
 </h5>
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
 <div class="md:col-span-2">
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">Street Address</label>
 <p class="mb-0 font-medium">{{ user.address|default("N/A") }}</p>
 </div>
 </div>
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">City</label>
 <p class="mb-0 font-medium">{{ user.city|default("N/A") }}</p>
 </div>
 </div>
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">State / Province</label>
 <p class="mb-0 font-medium">{{ user.state|default("N/A") }}</p>
 </div>
 </div>
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">Country</label>
 <p class="mb-0 font-medium">{{ user.country|default("N/A") }}</p>
 </div>
 </div>
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">Zip / Postal Code</label>
 <p class="mb-0 font-medium">{{ user.zipcode|default("N/A") }}</p>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Login Activity -->
 <div class="bg-white rounded-xl shadow-sm border border-slate-200">
 <div class="p-4">
 <h5 class="mb-4 font-semibold text-base">
 <i class="lucide lucide-history text-indigo-600 mr-2"></i>Login Activity
 </h5>
 <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
 <div>
 <div class="p-3 bg-neutral-50 rounded-lg">
 <div class="flex items-center mb-2">
 <i class="lucide lucide-calendar-check text-indigo-600 mr-2"></i>
 <label class="text-neutral-500 text-sm mb-0">Last Login</label>
 </div>
 <p class="mb-0 font-medium">{{ user.last_login ? user.last_login|date("M j, Y") : 'Never' }}</p>
 <small class="text-neutral-500">{{ user.last_login ? user.last_login|date("h:i A") : '' }}</small>
 </div>
 </div>
 <div>
 <div class="p-3 bg-neutral-50 rounded-lg">
 <div class="flex items-center mb-2">
 <i class="lucide lucide-router text-indigo-600 mr-2"></i>
 <label class="text-neutral-500 text-sm mb-0">IP Address</label>
 </div>
 <p class="mb-0 font-medium">{{ user.login_ip|default("N/A") }}</p>
 </div>
 </div>
 <div>
 <div class="p-3 bg-neutral-50 rounded-lg">
 <div class="flex items-center mb-2">
 <i class="lucide lucide-hard-drive text-indigo-600 mr-2"></i>
 <label class="text-neutral-500 text-sm mb-0">Device</label>
 </div>
 <p class="mb-0 font-medium">{{ user.login_device|default("N/A") }}</p>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <script>
 // Initialize tooltips
 var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-brox-toggle="tooltip"]'))
 var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
 return new broxUI.Tooltip(tooltipTriggerEl)
 })
 </script>
{% endblock %}




