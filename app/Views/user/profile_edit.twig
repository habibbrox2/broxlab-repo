{% extends"layout.twig" %}
{% block title %}Edit Profile{% endblock %}
{% block content %}
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
 <!-- Page Header -->
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-600/10 via-indigo-50 to-white p-6 sm:p-8">
   <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
     <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-indigo-400/30 blur-3xl"></div>
     <div class="absolute -bottom-10 -left-10 h-32 w-32 rounded-full bg-violet-400/20 blur-3xl"></div>
   </div>
   <div class="relative">
     <nav aria-label="breadcrumb" class="mb-2">
       <ol class="flex items-center gap-2 text-sm text-slate-500 list-none p-0 m-0">
         <li><a href="/profile" class="text-indigo-300 hover:text-indigo-100 transition-colors">Profile</a></li>
         <li class="before:content-['/'] before:mr-2 before:text-indigo-300/50" aria-current="page">Edit</li>
       </ol>
     </nav>
     <div class="flex items-center gap-2.5">
       <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-white shadow-lg shadow-indigo-600/20">
         <i class="lucide lucide-pencil" style="width:1.25em;height:1.25em;"></i>
       </div>
       <div>
         <h1 class="text-xl font-black tracking-tight text-slate-900 sm:text-2xl">Edit Profile</h1>
         <p class="mt-0.5 text-sm text-slate-500">Update your personal information and preferences</p>
       </div>
     </div>
   </div>
 </div>
 <!-- Modern Tab Navigation -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-6 transition-shadow hover:shadow-md">
   <div class="p-1.5">
     <ul class="flex flex-wrap gap-1" id="profileTabs" role="tablist">
       <li role="presentation">
         <button class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 active:scale-[0.97]"
           id="edit-tab" data-brox-toggle="tab" data-brox-target="#edit" type="button" role="tab">
           <i class="lucide lucide-pencil" style="width:1em;height:1em;"></i>
           <span class="hidden md:inline">Edit Profile</span>
           <span class="md:hidden">Profile</span>
         </button>
       </li>
       <li role="presentation">
         <button class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-600 transition-all hover:bg-slate-50 active:scale-[0.97]"
           id="password-tab" data-brox-toggle="tab" data-brox-target="#password" type="button" role="tab">
           <i class="lucide lucide-key" style="width:1em;height:1em;"></i>
           <span class="hidden md:inline">Change Password</span>
           <span class="md:hidden">Password</span>
         </button>
       </li>
       <li role="presentation">
         <button class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-600 transition-all hover:bg-slate-50 active:scale-[0.97]"
           id="security-tab" data-brox-toggle="tab" data-brox-target="#security" type="button" role="tab">
           <i class="lucide lucide-shield" style="width:1em;height:1em;"></i>
           <span class="hidden md:inline">Security (2FA)</span>
           <span class="md:hidden">Security</span>
         </button>
       </li>
     </ul>
   </div>
 </div>
 <!-- Tab Content -->
 <div id="profileTabContent">
 <!-- Edit Profile Tab -->
 <div class="block" id="edit" role="tabpanel">
 <form method="POST"
 action="/profile/edit"
 enctype="multipart/form-data"
 id="profileForm">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <!-- Profile Picture Section -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-4 transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-100 text-indigo-600">
 <i class="lucide lucide-user-circle" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">Profile Picture</h5>
 </div>
 <div class="p-5">
 <div class="flex items-center gap-4">
 <div class="flex-shrink-0">
 <div class="relative">
 {% if user.profile_pic %}
 <img id="profilePreview"
 src="{{ user.profile_pic }}"
 alt="Profile Picture"
 class="rounded-full shadow-md border-2 border-slate-200"
 width="140"
 height="140">
 {% else %}
 <img id="profilePreview"
 src="/assets/images/default-avatar.png"
 alt="Default Avatar"
 class="rounded-full shadow-md border-2 border-slate-200"
 width="140"
 height="140">
 {% endif %}
 <label for="profile_pic"
 class="absolute bottom-0 end-0 inline-flex items-center justify-center w-8 h-8 rounded-full bg-indigo-600 text-white text-sm shadow-md cursor-pointer hover:bg-indigo-600/90 transition-colors border-2 border-white">
 <i class="lucide lucide-camera"></i>
 </label>
 </div>
 </div>
 <div class="flex-1">
 <div class="ml-3">
 <input type="file"
 class="hidden"
 id="profile_pic"
 name="profile_pic"
 accept="image/*">
 <h6 class="mb-2">Choose a profile picture</h6>
 <p class="text-neutral-500 text-sm mb-2">
 <i class="lucide lucide-info mr-1"></i>
 JPG, PNG or JPEG. Max size 2MB.
 </p>
 <button type="button"
 class="inline-flex items-center px-3 py-1.5 rounded-lg border border-neutral-300 text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition-colors"
 onclick="document.getElementById('profile_pic').click()">
 <i class="lucide lucide-upload mr-1"></i> Upload Photo
 </button>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Basic Information -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-4 transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-100 text-indigo-600">
 <i class="lucide lucide-info" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">Basic Information</h5>
 </div>
 <div class="p-5">
 <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
 <div>
 <label for="username" class="block text-sm font-medium mb-1.5">
 Username <span class="text-red-500">*</span>
 </label>
 <div class="flex">
 <span class="inline-flex items-center px-3 bg-neutral-100 border border-r-0 border-slate-300 rounded-l-lg text-neutral-500">
 <i class="lucide lucide-at-sign"></i>
 </span>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="username"
 name="username"
 value="{{ user.username }}"
 required>
 </div>
 </div>
 <div>
 <label for="email" class="block text-sm font-medium mb-1.5">
 Email Address <span class="text-red-500">*</span>
 </label>
 <div class="flex">
 <span class="inline-flex items-center px-3 bg-neutral-100 border border-r-0 border-slate-300 rounded-l-lg text-neutral-500">
 <i class="lucide lucide-mail"></i>
 </span>
 <input type="email"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="email"
 name="email"
 value="{{ user.email }}"
 required>
 </div>
 </div>
 <div>
 <label for="first_name" class="block text-sm font-medium mb-1.5">First Name</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="first_name"
 name="first_name"
 value="{{ user.first_name|default("") }}"
 placeholder="Enter first name">
 </div>
 <div>
 <label for="last_name" class="block text-sm font-medium mb-1.5">Last Name</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="last_name"
 name="last_name"
 value="{{ user.last_name|default("") }}"
 placeholder="Enter last name">
 </div>
 <div>
 <label for="gender" class="block text-sm font-medium mb-1.5">Gender</label>
 <select class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary appearance-none bg-white" id="gender" name="gender">
 <option value="" {% if not user.gender %}selected{% endif %}>Select Gender</option>
 <option value="male" {% if user.gender == 'male' %}selected{% endif %}>Male</option>
 <option value="female" {% if user.gender == 'female' %}selected{% endif %}>Female</option>
 <option value="other" {% if user.gender == 'other' %}selected{% endif %}>Other</option>
 </select>
 </div>
 <div>
 <label for="dob" class="block text-sm font-medium mb-1.5">Date of Birth</label>
 <input type="date"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="dob"
 name="dob"
 value="{{ user.dob ? user.dob|date("Y-m-d") : '' }}"
 data-format="YYYY-MM-DD"
 placeholder="YYYY-MM-DD">
 </div>
 </div>
 </div>
 </div>
 <!-- Contact Information -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-4 transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-sky-100 text-sky-600">
 <i class="lucide lucide-phone" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">Contact Information</h5>
 </div>
 <div class="p-5">
 <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
 <div>
 <label for="phone" class="block text-sm font-medium mb-1.5">Phone Number</label>
 <div class="flex">
 <span class="inline-flex items-center px-3 bg-neutral-100 border border-r-0 border-slate-300 rounded-l-lg text-neutral-500">
 <i class="lucide lucide-phone"></i>
 </span>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="phone"
 name="phone"
 value="{{ user.phone|default("") }}"
 placeholder="+1 (555) 000-0000">
 </div>
 </div>
 <div>
 <label for="alternate_phone" class="block text-sm font-medium mb-1.5">Alternate Phone</label>
 <div class="flex">
 <span class="inline-flex items-center px-3 bg-neutral-100 border border-r-0 border-slate-300 rounded-l-lg text-neutral-500">
 <i class="lucide lucide-smartphone"></i>
 </span>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="alternate_phone"
 name="alternate_phone"
 value="{{ user.alternate_phone|default("") }}"
 placeholder="+1 (555) 000-0000">
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Address Information -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-4 transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-100 text-amber-600">
 <i class="lucide lucide-map-pin" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">Address Information</h5>
 </div>
 <div class="p-5">
 <div class="grid grid-cols-1 gap-3">
 <div class="md:col-span-2">
 <label for="address" class="block text-sm font-medium mb-1.5">Street Address</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="address"
 name="address"
 value="{{ user.address|default("") }}"
 placeholder="123 Main Street">
 </div>
 <div>
 <label for="city" class="block text-sm font-medium mb-1.5">City</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="city"
 name="city"
 value="{{ user.city|default("") }}"
 placeholder="New York">
 </div>
 <div>
 <label for="state" class="block text-sm font-medium mb-1.5">State / Province</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="state"
 name="state"
 value="{{ user.state|default("") }}"
 placeholder="NY">
 </div>
 <div>
 <label for="country" class="block text-sm font-medium mb-1.5">Country</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="country"
 name="country"
 value="{{ user.country|default("") }}"
 placeholder="United States">
 </div>
 <div>
 <label for="zipcode" class="block text-sm font-medium mb-1.5">Zip / Postal Code</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="zipcode"
 name="zipcode"
 value="{{ user.zipcode|default("") }}"
 placeholder="10001">
 </div>
 </div>
 </div>
 </div>
 <!-- Social Links -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-4 transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-sky-100 text-sky-600">
 <i class="lucide lucide-share-2" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">Social Media Profiles</h5>
 </div>
 <div class="p-5">
 <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
 <div>
 <label for="facebook_url" class="block text-sm font-medium mb-1.5">
 <i class="lucide lucide-facebook mr-1"></i> Facebook
 </label>
 <input type="url"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="facebook_url"
 name="facebook_url"
 value="{{ user.facebook_url|default("") }}"
 placeholder="https://facebook.com/username">
 </div>
 <div>
 <label for="twitter_url" class="block text-sm font-medium mb-1.5">
 <i class="lucide lucide-share-2 mr-1"></i> Twitter / X
 </label>
 <input type="url"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="twitter_url"
 name="twitter_url"
 value="{{ user.twitter_url|default("") }}"
 placeholder="https://twitter.com/username">
 </div>
 <div>
 <label for="instagram_url" class="block text-sm font-medium mb-1.5">
 <i class="lucide lucide-instagram text-red-500 mr-1"></i> Instagram
 </label>
 <input type="url"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="instagram_url"
 name="instagram_url"
 value="{{ user.instagram_url|default("") }}"
 placeholder="https://instagram.com/username">
 </div>
 <div>
 <label for="linkedin_url" class="block text-sm font-medium mb-1.5">
 <i class="lucide lucide-briefcase text-indigo-600 mr-1"></i> LinkedIn
 </label>
 <input type="url"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="linkedin_url"
 name="linkedin_url"
 value="{{ user.linkedin_url|default("") }}"
 placeholder="https://linkedin.com/in/username">
 </div>
 </div>
 </div>
 </div>
 <!-- Action Buttons -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
 <div class="border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
   <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600">
     <i class="lucide lucide-check-circle" style="width:1.125em;height:1.125em;"></i>
   </div>
   <h5 class="text-sm font-bold text-slate-900">Save Changes</h5>
 </div>
 <div class="p-5">
 <div class="flex flex-wrap gap-2 items-center justify-between">
 <div class="flex gap-2 flex-wrap">
 <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 hover:-translate-y-0.5 active:scale-[0.97]">
 <i class="lucide lucide-check-circle" style="width:1em;height:1em;"></i>Save Changes
 </button>
 <a href="/profile" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-5 py-2.5 text-sm font-medium text-slate-600 shadow-sm transition-all hover:bg-slate-50 hover:-translate-y-0.5">
 <i class="lucide lucide-x-circle" style="width:1em;height:1em;"></i>Cancel
 </a>
 </div>
 <button type="reset"
   class="inline-flex items-center gap-1.5 rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-xs font-semibold text-red-600 transition-all hover:bg-red-100 hover:-translate-y-0.5"
   onclick="return confirm('Are you sure you want to reset all changes?')">
 <i class="lucide lucide-rotate-ccw" style="width:0.875em;height:0.875em;"></i>Reset Form
 </button>
 </div>
 </div>
 </div>
 </form>
 </div>
 <!-- Change Password Tab -->
 <div class="hidden" id="password" role="tabpanel">
 <div class="bg-white rounded-xl shadow-sm border border-slate-200">
 <div class="p-5 text-center">
 <div class="mb-4">
 <div class="inline-flex items-center justify-center rounded-full bg-indigo-600/10 mb-3 w-16 h-16">
 <i class="lucide lucide-key text-indigo-600 text-2xl"></i>
 </div>
 <h4 class="mb-2 font-bold">Change Password</h4>
 <p class="text-neutral-500 mb-4">Keep your account secure by updating your password regularly</p>
 </div>
 <div class="flex flex-col gap-2 items-center">
 <a href="/profile/password" class="inline-flex items-center px-5 py-2.5 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-600/90 transition-colors">
 <i class="lucide lucide-arrow-right mr-2"></i>Go to Password Settings
 </a>
 <p class="text-neutral-500 text-sm mt-2 mb-0">
 <i class="lucide lucide-info mr-1"></i>
 We recommend using a strong, unique password
 </p>
 </div>
 </div>
 </div>
 </div>
 <!-- 2FA Settings Tab -->
 <div class="hidden" id="security" role="tabpanel">
 <div class="bg-white rounded-xl shadow-sm border border-slate-200">
 <div class="p-5 text-center">
 <div class="mb-4">
 <div class="inline-flex items-center justify-center rounded-full bg-green-500/10 mb-3 w-16 h-16">
 <i class="lucide lucide-shield text-green-600 text-2xl"></i>
 </div>
 <h4 class="mb-2 font-bold">Two-Factor Authentication</h4>
 <p class="text-neutral-500 mb-4">Add an extra layer of security to protect your account from unauthorized access</p>
 </div>
 <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-4 text-left">
 <div class="p-3 bg-neutral-50 rounded-xl h-full">
 <i class="lucide lucide-shield-check text-green-600 mb-2 block text-xl"></i>
 <h6 class="mb-1">Enhanced Security</h6>
 <small class="text-neutral-500">Protect against unauthorized access</small>
 </div>
 <div class="p-3 bg-neutral-50 rounded-xl h-full">
 <i class="lucide lucide-smartphone text-indigo-600 mb-2 block text-xl"></i>
 <h6 class="mb-1">Multiple Methods</h6>
 <small class="text-neutral-500">SMS, email, or authenticator app</small>
 </div>
 <div class="p-3 bg-neutral-50 rounded-xl h-full">
 <i class="lucide lucide-history text-blue-500 mb-2 block text-xl"></i>
 <h6 class="mb-1">Easy Setup</h6>
 <small class="text-neutral-500">Configure in just a few minutes</small>
 </div>
 </div>
 <a href="/user/security/2fa" class="inline-flex items-center px-5 py-2.5 rounded-lg bg-green-600 text-white text-sm font-medium hover:bg-green-700 transition-colors">
 <i class="lucide lucide-shield-check mr-2"></i>Manage 2FA Settings
 </a>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Profile Picture Live Preview Script -->
 <script>
 const profileInput = document.getElementById('profile_pic');
 const profilePreview = document.getElementById('profilePreview');

 profileInput.addEventListener('change', function() {
 const file = this.files[0];
 if (file) {
 // Validate file size (2MB)
 if (file.size > 2 * 1024 * 1024) {
 alert('File size must be less than 2MB');
 this.value = '';
 return;
 }

 // Validate file type
 const allowedTypes = ['image/jpeg', 'image/png', 'image/jpg'];
 if (!allowedTypes.includes(file.type)) {
 alert('Only JPG, PNG, and JPEG files are allowed');
 this.value = '';
 return;
 }

 const reader = new FileReader();
 reader.onload = function(e) {
 profilePreview.src = e.target.result;

 // Add a subtle animation
 profilePreview.style.opacity = '0';
 setTimeout(() => {
 profilePreview.style.transition = 'opacity 0.3s ease';
 profilePreview.style.opacity = '1';
 }, 50);
 }
 reader.readAsDataURL(file);
 }
 });

 // Form validation feedback
 const form = document.getElementById('profileForm');
 form.addEventListener('submit', function(e) {
 if (!form.checkValidity()) {
 e.preventDefault();
 e.stopPropagation();
 }
 // Bootstrap's was-validated removed; manual validation done via checkValidity
 });
 </script>
{% endblock %}



