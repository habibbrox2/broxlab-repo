{% extends"layout.twig" %}
{% block title %}Change Password{% endblock %}
{% block content %}
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
 <!-- Breadcrumb and Header -->
 <div class="mb-4">
 <nav aria-label="breadcrumb">
 <ol class="flex items-center gap-2 text-sm text-neutral-500 list-none p-0 m-0">
 <li>
 <a href="/profile" class="text-indigo-600 hover:text-indigo-600/80 transition-colors">Profile</a>
 </li>
 <li class="before:content-['/'] before:mx-2 before:text-neutral-300" aria-current="page">Change Password</li>
 </ol>
 </nav>
 <h1 class="h2 mb-1 font-bold">
 <i class="lucide lucide-key text-indigo-600 mr-2"></i>Update Password
 </h1>
 <p class="text-neutral-500 mb-0">Keep your account secure by updating your password regularly.</p>
 </div>
 <div class="bg-white rounded-xl shadow-sm border border-slate-200">
 <div class="px-5 py-4 border-b border-slate-100 bg-neutral-50">
 <h5 class="text-base font-semibold mb-0">
 <i class="lucide lucide-lock mr-2"></i>Change Password
 </h5>
 </div>
 <div class="p-5"
 <form method="POST" action="/profile/password">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <div class="mb-3">
 <label for="current_password" class="block text-sm font-medium mb-1.5">Current Password</label>
 <input type="password"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="current_password"
 name="current_password"
 required>
 </div>
 <div class="mb-3">
 <label for="new_password" class="block text-sm font-medium mb-1.5">New Password</label>
 <input type="password"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="new_password"
 name="new_password"
 required>
 </div>
 <div class="mb-3">
 <label for="confirm_password" class="block text-sm font-medium mb-1.5">Confirm New Password</label>
 <input type="password"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="confirm_password"
 name="confirm_password"
 required>
 </div>
 <button type="submit" class="inline-flex items-center px-4 py-2.5 rounded-lg bg-green-600 text-white text-sm font-medium hover:bg-green-700 transition-colors">
 <i class="lucide lucide-key mr-1"></i> Change Password
 </button>
 <a href="/profile" class="inline-flex items-center px-4 py-2.5 rounded-lg border border-neutral-300 text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition-colors"><i class="lucide lucide-x-circle mr-1"></i> Cancel</a>
 </form>
 </div>
 </div>
 </div>
{% endblock %}



