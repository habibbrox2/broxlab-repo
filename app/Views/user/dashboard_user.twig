{# ============================
FILE: templates/dashboard_user.twig
============================ #}
{% extends"layout.twig" %}
{% import"_macros/dashboard_macros.twig" as ui %}
{% block title %}User Dashboard{% endblock %}
{% block content %}
 <div class="py-3">
 <div class="flex items-center justify-between mb-4">
 <div class="flex items-center gap-3">
 <img src="{{ user.photo_url|default("/assets/profile-placeholder.png") }}"
 class="rounded-full"
 width="60"
 height="60"
 alt="Profile">
 <div>
 <h1 class="text-xl font-bold mb-1">Hello, {{ user.full_name|default(user.username|title) }}</h1>
 <div class="text-neutral-500 text-sm">Track your applications and updates</div>
 </div>
 </div>
 <div>
 <a href="/applications/new" class="inline-flex items-center px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-600/90 transition-colors"><i class="lucide lucide-plus mr-1"></i>New Application</a>
 </div>
 </div>
 <div class="mb-4 flex flex-wrap gap-2">
 <a href="/cv" class="inline-flex items-center px-3 py-1.5 rounded-lg text-indigo-600 text-sm font-medium hover:bg-indigo-600/10 transition-colors">
 <i class="lucide lucide-file-text mr-1"></i>My CVs
 </a>
 <a href="/user/settings" class="inline-flex items-center px-3 py-1.5 rounded-lg text-neutral-700 border border-neutral-300 text-sm font-medium hover:bg-neutral-100 transition-colors">
 <i class="lucide lucide-settings mr-1"></i>Settings
 </a>
 <a href="/logout" class="inline-flex items-center px-3 py-1.5 rounded-lg text-red-600 text-sm font-medium hover:bg-red-50 transition-colors">
 <i class="lucide lucide-log-out mr-1"></i>Logout
 </a>
 </div>
 {# User Roles & Permissions Alert #}
 {% if user_roles and user_roles|length > 0 %}
 <div class="p-4 rounded-lg bg-sky-50 text-sky-800 border border-sky-200 mb-4"
 role="alert">
 <div class="flex items-start justify-between">
 <div>
 <h6 class="text-inherit mb-2">
 <i class="lucide lucide-shield-check mr-2"></i>Your Role(s)
 </h6>
 <div class="flex flex-wrap gap-2">
 {% for role in user_roles %}
 <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-indigo-600/10 text-indigo-600 border border-primary/20">
 <i class="lucide lucide-shield-check mr-1"></i>{{ role.name|replace({"_":""}) |title }}
 </span>
 {% endfor %}
 </div>
 </div>
 <button type="button"
 class="w-6 h-6 flex items-center justify-center border-0 bg-transparent text-neutral-500 hover:text-neutral-800 hover:bg-neutral-100 rounded-lg transition-all duration-150 cursor-pointer flex-shrink-0" data-brox-dismiss="alert"
 aria-label="Close"></button>
 </div>
 </div>
 {% endif %}
 {# Personal Stats #}
 <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-5 gap-3 mb-4">
 <a href="/cv" class="no-underline">
 <div class="bg-white rounded-xl shadow-sm border border-slate-200 h-full hover:shadow-md-md transition-shadow-md">
 <div class="p-4">
 <div class="text-neutral-500 text-sm">
 <i class="lucide lucide-file-text mr-1"></i> My CVs
 </div>
 <div class="text-2xl font-bold">{{ mystats.cvs|default(0) }}</div>
 </div>
 </div>
 </a>
 <div class="bg-white rounded-xl shadow-sm border border-slate-200 h-full">
 <div class="p-4">
 <div class="text-neutral-500 text-sm">
 <i class="lucide lucide-file-text mr-1"></i> Total Applications
 </div>
 <div class="text-2xl font-bold">{{ mystats.total|default(0) }}</div>
 </div>
 </div>
 <div class="bg-white rounded-xl shadow-sm border border-slate-200 h-full">
 <div class="p-4">
 <div class="text-neutral-500 text-sm">
 <i class="lucide lucide-history mr-1"></i> Pending
 </div>
 <div class="text-2xl font-bold">{{ mystats.pending|default(0) }}</div>
 </div>
 </div>
 <div class="bg-white rounded-xl shadow-sm border border-slate-200 h-full">
 <div class="p-4">
 <div class="text-neutral-500 text-sm">
 <i class="lucide lucide-check-circle mr-1"></i> Approved
 </div>
 <div class="text-2xl font-bold">{{ mystats.approved|default(0) }}</div>
 </div>
 </div>
 <div class="bg-white rounded-xl shadow-sm border border-slate-200 h-full">
 <div class="p-4">
 <div class="text-neutral-500 text-sm">
 <i class="lucide lucide-x-circle mr-1"></i> Rejected
 </div>
 <div class="text-2xl font-bold">{{ mystats.rejected|default(0) }}</div>
 </div>
 </div>
 </div>
 <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
 <div class="xl:col-span-2">
 <div class="bg-white rounded-xl shadow-sm border border-slate-200">
 <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between">
 <h5 class="mb-0 font-semibold">My Recent Applications</h5>
 <a href="/applications" class="inline-flex items-center px-3 py-1.5 rounded-lg text-indigo-600 text-sm font-medium hover:bg-indigo-600/10 transition-colors">View all</a>
 </div>
 <div class="p-0">
 {% if my_applications is not empty %}
 <div class="overflow-x-auto">
 <table class="w-full text-sm">
 <thead class="bg-neutral-100">
 <tr>
 <th>ID</th>
 <th>Type</th>
 <th>Status</th>
 <th>Updated</th>
 <th class="text-right">Action</th>
 </tr>
 </thead>
 <tbody>
 {% for app in my_applications %}
 <tr>
 <td class="px-3 py-2">#{{ app.id }}</td>
 <td class="px-3 py-2 whitespace-nowrap">{{ app.certificate_type|title }}</td>
 <td class="px-3 py-2">{{ ui.status_badge(app.status) }}</td>
 <td class="px-3 py-2 text-neutral-500 text-sm">{{ app.updated_at|date("d M, Y h:i A") }}</td>
 <td class="px-3 py-2 text-right">
 <a href="/applications/{{ app.id }}"
 class="inline-flex items-center px-3 py-1.5 rounded-lg text-neutral-700 border border-neutral-300 text-sm font-medium hover:bg-neutral-100 transition-colors">View</a>
 {% if app.status == 'pending' %}
 <a href="/applications/{{ app.id }}/edit" class="inline-flex items-center px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-600/90 transition-colors">Update</a>
 {% endif %}
 </td>
 </tr>
 {% endfor %}
 </tbody>
 </table>
 </div>
 {% else %}
 <div class="p-4">{{ ui.empty_state('No applications yet', 'Start by creating a new application.') }}</div>
 {% endif %}
 </div>
 </div>
 </div>
 <div class="xl:col-span-1">
 <div class="bg-white rounded-xl shadow-sm border border-slate-200 mb-4">
 <div class="px-4 py-3 border-b border-slate-100">
 <h6 class="mb-0 font-semibold">Profile Completion</h6>
 </div>
 <div class="p-4">
 {% set pct = profile.completeness|default(0) %}
 <div class="w-full bg-neutral-200 rounded-full h-2 mb-2">
 <div class="bg-indigo-600 rounded-full h-2 transition-all duration-300"
 role="progressbar"
 style="width: {{ pct }}%"
 aria-valuenow="{{ pct }}"
 aria-valuemin="0"
 aria-valuemax="100"></div>
 </div>
 <div class="text-sm text-neutral-500">{{ pct }}% complete</div>
 <div class="flex flex-col gap-2 mt-3">
 {% if profile.needs_photo %}
 <a href="/profile" class="inline-flex items-center px-3 py-1.5 rounded-lg text-neutral-700 border border-neutral-300 text-sm font-medium hover:bg-neutral-100 transition-colors">Add Profile Photo</a>
 {% endif %}
 {% if profile.needs_phone %}<a href="/profile" class="inline-flex items-center px-3 py-1.5 rounded-lg text-neutral-700 border border-neutral-300 text-sm font-medium hover:bg-neutral-100 transition-colors">Verify Phone</a>{% endif %}
 </div>
 </div>
 </div>
 <!-- Services Card -->
 <div class="bg-white rounded-xl shadow-sm border border-slate-200 mb-4">
 <div class="px-4 py-3 border-b border-slate-100 flex justify-between items-center">
 <h6 class="mb-0 font-semibold">
 <i class="lucide lucide-award mr-2 text-amber-500"></i> Services
 </h6>
 <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-indigo-600 text-white">Quick Access</span>
 </div>
 <div class="p-4">
 <p class="text-sm text-neutral-500 mb-3">Explore and apply for exclusive services tailored to your needs.</p>
 <div class="flex flex-col gap-2">
 <a href="/services" class="inline-flex items-center px-3 py-1.5 rounded-lg text-indigo-600 text-sm font-medium hover:bg-indigo-600/10 transition-colors">
 <i class="lucide lucide-search mr-1"></i> Browse Services
 </a>
 <a href="/services/my-applications" class="inline-flex items-center px-3 py-1.5 rounded-lg text-cyan-600 text-sm font-medium hover:bg-cyan-50 transition-colors">
 <i class="lucide lucide-clipboard-check mr-1"></i> My Applications
 </a>
 </div>
 </div>
 </div>
 <!-- Security Card -->
 <div class="bg-white rounded-xl shadow-sm border border-slate-200 mb-4">
 <div class="px-4 py-3 border-b border-slate-100">
 <h6 class="mb-0 font-semibold">
 <i class="lucide lucide-shield-check mr-2"></i> Account Security
 </h6>
 </div>
 <div class="p-4">
 <p class="text-sm text-neutral-500 mb-3">Enhance your account security with two-factor authentication.</p>
 <div class="flex flex-col gap-2">
 <a href="/user/security/2fa" class="inline-flex items-center px-3 py-1.5 rounded-lg text-green-600 text-sm font-medium hover:bg-green-50 transition-colors">
 <i class="lucide lucide-shield mr-1"></i> Manage 2FA
 </a>
 <a href="/profile/password" class="inline-flex items-center px-3 py-1.5 rounded-lg text-neutral-700 border border-neutral-300 text-sm font-medium hover:bg-neutral-100 transition-colors">
 <i class="lucide lucide-key mr-1"></i> Change Password
 </a>
 </div>
 </div>
 </div>
 <div class="bg-white rounded-xl shadow-sm border border-slate-200">
 <div class="px-4 py-3 border-b border-slate-100 flex justify-between items-center">
 <h6 class="mb-0 font-semibold">Notices</h6>
 <a href="/notices" class="text-sm text-indigo-600 hover:text-indigo-600/80">View all</a>
 </div>
 <div class="p-4">
 {% if notices is not empty %}
 <ul class="list-none mb-0 p-0">
 {% for n in notices %}
 <li class="mb-3">
 <div class="font-semibold">{{ n.title }}</div>
 <div class="text-neutral-500 text-sm">{{ n.published_at|date("d M, Y") }}</div>
 <div class="small">{{ n.excerpt }}</div>
 </li>
 {% endfor %}
 </ul>
 {% else %}
 {{ ui.empty_state('No notices', 'Announcements from the office will appear here.') }}
 {% endif %}
 </div>
 </div>
 </div>
 </div>
 </div>
{% endblock %}
{% block scripts %}
 {{ parent() }}
 <script>// You can add user-specific interactions here if needed</script>
{% endblock %}




