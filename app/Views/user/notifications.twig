{% extends 'layout.twig' %}
{% block title %}আমার নোটিফিকেশন{% endblock %}
{% block extra_styles %}
<style>
/* ── Dark mode overrides for JS-generated notification content ── */
[data-theme="dark"] #permissionStatus .bg-green-50 { background: rgba(22, 163, 74, 0.15) !important; border-color: rgba(22, 163, 74, 0.3) !important; }
[data-theme="dark"] #permissionStatus .text-green-800 { color: #86efac !important; }
[data-theme="dark"] #permissionStatus .border-green-200 { border-color: rgba(22, 163, 74, 0.3) !important; }
[data-theme="dark"] #permissionStatus .bg-amber-50 { background: rgba(217, 119, 6, 0.15) !important; border-color: rgba(217, 119, 6, 0.3) !important; }
[data-theme="dark"] #permissionStatus .text-amber-800 { color: #fcd34d !important; }
[data-theme="dark"] #permissionStatus .border-amber-200 { border-color: rgba(217, 119, 6, 0.3) !important; }
[data-theme="dark"] #permissionStatus .bg-neutral-100 { background: rgba(51, 65, 85, 0.6) !important; border-color: rgba(51, 65, 85, 0.8) !important; }
[data-theme="dark"] #permissionStatus .text-neutral-700 { color: rgb(203 213 225) !important; }
[data-theme="dark"] #permissionStatus .border-neutral-200 { border-color: rgba(51, 65, 85, 0.8) !important; }
[data-theme="dark"] #permissionStatus .text-neutral-500 { color: rgb(148 163 184) !important; }
[data-theme="dark"] #topicsContainer label { color: rgb(203 213 225) !important; }
[data-theme="dark"] #topicsContainer .text-neutral-500 { color: rgb(148 163 184) !important; }
[data-theme="dark"] #topicsContainer input[type="checkbox"] { border-color: rgb(71 85 105) !important; }
</style>
{% endblock %}
{% block content %}
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
 <!-- Page Header -->
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-600/10 via-indigo-50 to-white p-6 sm:p-8">
   <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
     <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-indigo-400/30 blur-3xl"></div>
     <div class="absolute -bottom-10 -left-10 h-32 w-32 rounded-full bg-violet-400/20 blur-3xl"></div>
   </div>
   <div class="relative flex items-center justify-between gap-4">
     <div class="flex items-center gap-2.5">
       <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-white shadow-lg shadow-indigo-600/20">
         <i class="lucide lucide-bell" style="width:1.25em;height:1.25em;"></i>
       </div>
       <div>
         <h1 class="text-xl font-black tracking-tight text-slate-900 sm:text-2xl">আমার নোটিফিকেশন</h1>
         <p class="mt-0.5 text-sm text-slate-500">আপনার সকল নোটিফিকেশন এখানে পাবেন</p>
       </div>
     </div>
     {% if unread_count > 0 %}
     <button class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2 text-xs font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 hover:-translate-y-0.5" data-action="markAllAsRead">
       <i class="lucide lucide-check" style="width:0.875em;height:0.875em;"></i>সব পড়া হিসেবে চিহ্নিত করুন
     </button>
     {% endif %}
   </div>
 </div>
 <!-- Unread Count Badge -->
 {% if unread_count > 0 %}
 <div class="p-4 rounded-lg bg-blue-50 text-blue-800 border border-blue-200 mb-4 flex items-center dark:bg-blue-900/25 dark:text-blue-300 dark:border-blue-800/60" role="alert">
 <i class="lucide lucide-info mr-2"></i>
 <span>আপনার <strong>{{ unread_count }} টি অপড়া নোটিফিকেশন</strong> আছে</span>
 </div>
 {% endif %}
 <!-- Notifications List -->
 <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
 <div class="lg:col-span-2">
 {% if notifications|length > 0 %}
 {% for notif in notifications %}
 <div class="bg-white rounded-xl shadow-sm border border-slate-200 mb-3 notification-rounded-xl border-slate-200 {% if notif.is_read == 0 %}border-l-4 border-l-primary bg-blue-50{% endif %} dark:bg-slate-800 dark:border-slate-700 dark:shadow-slate-900/20{% if notif.is_read == 0 %} dark:bg-blue-900/15{% endif %}"
 data-notification-id="{{ notif.id }}">
 <div class="p-4">
 <div class="flex justify-between items-start">
 <div class="flex-1">
 <div class="flex items-center gap-2 mb-2">
 <h5 class="mb-0">{{ notif.title }}</h5>
 {% if notif.is_read == 0 %}
 <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-600 text-white dark:bg-indigo-700">
 <i class="lucide lucide-circle mr-1"></i>নতুন
 </span>
 {% endif %}
 <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-neutral-200 text-neutral-700 capitalize dark:bg-slate-700 dark:text-slate-300">{{ notif.type }}</span>
 </div>
 <p class="mb-3 text-slate-900 dark:text-slate-300">{{ notif.message }}</p>
 <div class="flex gap-2 mt-3">
 {% if notif.action_url %}
 <a href="{{ notif.action_url }}" class="inline-flex items-center px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-600/90 transition-colors dark:bg-indigo-700 dark:hover:bg-indigo-600">
 <i class="lucide lucide-arrow-right mr-1"></i>বিস্তারিত দেখুন
 </a>
 {% endif %}
 {% if notif.is_read == 0 %}
 <button class="inline-flex items-center px-3 py-1.5 rounded-lg border border-neutral-300 text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition-colors dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700"
 data-action="markAsRead" data-id="{{ notif.id }}">
 <i class="lucide lucide-check mr-1"></i>পড়া হিসেবে চিহ্নিত করুন
 </button>
 {% endif %}
 </div>
 </div>
 <div class="text-right ml-3">
 <small class="text-neutral-500 dark:text-slate-500 block">
 <i class="lucide lucide-calendar mr-1"></i>{{ notif.created_at|date("d M Y") }}
 </small>
 <small class="text-neutral-500 dark:text-slate-500 block mt-1">
 <i class="lucide lucide-clock mr-1"></i>{{ notif.created_at|date("H:i") }}
 </small>
 </div>
 </div>
 </div>
 </div>
 {% endfor %}
 <!-- Pagination -->
 {% if total_pages > 1 %}
 <nav class="mt-4"
 aria-label="নোটিফিকেশন পৃষ্ঠা নেভিগেশন">
 <ul class="flex items-center justify-center gap-1 list-none p-0">
 {% if current_page > 1 %}
 <li class="inline-flex">
 <a class="inline-flex items-center justify-center px-3 py-2 text-sm rounded-lg border border-slate-300 text-neutral-700 hover:bg-neutral-100 transition-colors no-underline dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700"
 href="?page=1"
 aria-label="প্রথম পৃষ্ঠা">
 <i class="lucide lucide-chevrons-left"></i>
 </a>
 </li>
 <li class="inline-flex">
 <a class="inline-flex items-center justify-center px-3 py-2 text-sm rounded-lg border border-slate-300 text-neutral-700 hover:bg-neutral-100 transition-colors no-underline dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700"
 href="?page={{ current_page - 1 }}"
 aria-label="পূর্ববর্তী">
 <i class="lucide lucide-chevron-left"></i>
 </a>
 </li>
 {% endif %}
 {% set start_page = max(1, current_page - 2) %}
 {% set end_page = min(total_pages, current_page + 2) %}
 {% if start_page > 1 %}
 <li class="inline-flex opacity-50">
 <span class="inline-flex items-center justify-center px-3 py-2 text-sm rounded-lg border border-slate-300 text-neutral-700 hover:bg-neutral-100 transition-colors no-underline dark:border-slate-600 dark:text-slate-400 dark:hover:bg-slate-700">...</span>
 </li>
 {% endif %}
 {% for page in range(start_page, end_page + 1) %}
 <li class="inline-flex {% if page == current_page %}active{% endif %}">
 <a class="inline-flex items-center justify-center px-3 py-2 text-sm rounded-lg border border-slate-300 text-neutral-700 hover:bg-neutral-100 transition-colors no-underline dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700" href="?page={{ page }}">{{ page }}</a>
 </li>
 {% endfor %}
 {% if end_page < total_pages %}
 <li class="inline-flex opacity-50">
 <span class="inline-flex items-center justify-center px-3 py-2 text-sm rounded-lg border border-slate-300 text-neutral-700 hover:bg-neutral-100 transition-colors no-underline dark:border-slate-600 dark:text-slate-400 dark:hover:bg-slate-700">...</span>
 </li>
 {% endif %}
 {% if current_page < total_pages %}
 <li class="inline-flex">
 <a class="inline-flex items-center justify-center px-3 py-2 text-sm rounded-lg border border-slate-300 text-neutral-700 hover:bg-neutral-100 transition-colors no-underline dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700"
 href="?page={{ current_page + 1 }}"
 aria-label="পরবর্তী">
 <i class="lucide lucide-chevron-right"></i>
 </a>
 </li>
 <li class="inline-flex">
 <a class="inline-flex items-center justify-center px-3 py-2 text-sm rounded-lg border border-slate-300 text-neutral-700 hover:bg-neutral-100 transition-colors no-underline dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700"
 href="?page={{ total_pages }}"
 aria-label="শেষ পৃষ্ঠা">
 <i class="lucide lucide-chevrons-right"></i>
 </a>
 </li>
 {% endif %}
 </ul>
 </nav>
 <div class="text-center text-neutral-500 dark:text-slate-400 text-sm">
 পৃষ্ঠা {{ current_page }} এর {{ total_pages }} (প্রতি পৃষ্ঠায় 20 টি)
 </div>
 {% endif %}
 {% else %}
 <div class="bg-white rounded-xl shadow-sm border border-slate-200 text-center py-5 dark:bg-slate-800 dark:border-slate-700">
 <div class="p-4">
 <i class="lucide lucide-inbox text-5xl text-neutral-400 dark:text-slate-600 mb-3 block mx-auto"></i>
 <h5 class="text-neutral-500 dark:text-slate-300">কোনো নোটিফিকেশন নেই</h5>
 <p class="text-neutral-500 dark:text-slate-400 mb-0">
 আপনার কোনো নোটিফিকেশন নেই। নতুন নোটিফিকেশনের জন্য অপেক্ষা করুন।
 </p>
 </div>
 </div>
 {% endif %}
 </div>
 <!-- Sidebar -->
 <div>
 <!-- Permission Status Card -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-3 transition-shadow hover:shadow-md dark:bg-slate-800 dark:border-slate-700" id="permissionCard">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-amber-50 to-white px-4 py-3 dark:border-slate-700 dark:from-amber-900/25 dark:to-slate-800">
 <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-100 text-amber-600 dark:bg-amber-800 dark:text-amber-200">
 <i class="lucide lucide-shield-check" style="width:1em;height:1em;"></i>
 </div>
 <h6 class="text-sm font-bold text-slate-900 dark:text-amber-200">পুশ নোটিফিকেশন</h6>
 </div>
 <div class="p-4 text-sm" id="permissionStatus">
 <div class="text-center">
 <div class="inline-spinner inline-spinner-sm text-amber-600 mb-2 dark:text-amber-400"
 role="status">
 <span class="sr-only">লোড হচ্ছে...</span>
 </div>
 <p class="text-neutral-500 mb-0 dark:text-slate-400">স্ট্যাটাস চেক করা হচ্ছে...</p>
 </div>
 </div>
 </div>
 <!-- Topics Preferences Card -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-3 transition-shadow hover:shadow-md dark:bg-slate-800 dark:border-slate-700">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-sky-50 to-white px-4 py-3 dark:border-slate-700 dark:from-sky-900/25 dark:to-slate-800">
 <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-100 text-sky-600 dark:bg-sky-800 dark:text-sky-200">
 <i class="lucide lucide-tag" style="width:1em;height:1em;"></i>
 </div>
 <h6 class="text-sm font-bold text-slate-900 dark:text-sky-200">বিষয় পছন্দ</h6>
 </div>
 <div class="p-4 text-sm" id="topicsContainer">
 <div class="text-center">
 <div class="inline-spinner inline-spinner-sm text-sky-600 mb-2 dark:text-sky-400" role="status">
 <span class="sr-only">লোড হচ্ছে...</span>
 </div>
 <p class="text-neutral-500 mb-0 dark:text-slate-400">বিষয় লোড হচ্ছে...</p>
 </div>
 </div>
 </div>
 <!-- Notification Statistics -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-3 transition-shadow hover:shadow-md dark:bg-slate-800 dark:border-slate-700">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-blue-50 to-white px-4 py-3 dark:border-slate-700 dark:from-blue-900/25 dark:to-slate-800">
 <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-100 text-blue-600 dark:bg-blue-800 dark:text-blue-200">
 <i class="lucide lucide-bar-chart-3" style="width:1em;height:1em;"></i>
 </div>
 <h6 class="text-sm font-bold text-slate-900 dark:text-blue-200">পরিসংখ্যান</h6>
 </div>
 <div class="p-4">
 <div class="grid grid-cols-2 text-center">
 <div>
 <div class="text-2xl font-bold text-indigo-600 mb-0">{{ unread_count }}</div>
 <small class="text-neutral-500 dark:text-slate-400">অপড়া</small>
 </div>
 <div>
 <div class="text-2xl font-bold text-green-600 mb-0">{{ notifications|length }}</div>
 <small class="text-neutral-500 dark:text-slate-400">এই পৃষ্ঠায়</small>
 </div>
 </div>
 </div>
 </div>
 <!-- Help Section -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md dark:bg-slate-800 dark:border-slate-700">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-100 to-white px-4 py-3 dark:border-slate-700 dark:from-slate-700/50 dark:to-slate-800">
 <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-200 text-slate-600 dark:bg-slate-600 dark:text-slate-200">
 <i class="lucide lucide-help-circle" style="width:1em;height:1em;"></i>
 </div>
 <h6 class="text-sm font-bold text-slate-900 dark:text-slate-200">সাহায্য</h6>
 </div>
 <div class="p-4 text-sm">
 <p class="mb-2">
 <strong class="dark:text-slate-200">নীল ডানদিক সীমানা:</strong>
 <br>
 <span class="text-neutral-500 dark:text-slate-400">নতুন অপড়া নোটিফিকেশন</span>
 </p>
 <hr class="my-2 dark:border-slate-700">
 <p class="mb-2">
 <strong class="dark:text-slate-200">নতুন ব্যাজ:</strong>
 <br>
 <span class="text-neutral-500 dark:text-slate-400">এখনই পড়া হয়নি এমন নোটিফিকেশন</span>
 </p>
 <hr class="my-2 dark:border-slate-700">
 <p class="mb-0">
 <strong class="dark:text-slate-200">টাইপ ব্যাজ:</strong>
 <br>
 <span class="text-neutral-500 dark:text-slate-400">নোটিফিকেশনের ধরণ দেখায়</span>
 </p>
 </div>
 </div>
 <!-- Tips -->
 <div class="p-4 rounded-lg bg-neutral-50 text-neutral-600 border border-neutral-200 mt-3 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700">
 <h6 class="mb-2 dark:text-slate-200">
 <i class="lucide lucide-lightbulb mr-2"></i>টিপস
 </h6>
 <ul class="text-xs mb-0 dark:text-slate-400">
 <li>সব নোটিফিকেশন পড়া হিসেবে চিহ্নিত করুন</li>
 <li>বিষয় পছন্দ অনুযায়ী ফিল্টার করুন</li>
 <li>প্রতিটি নোটিফিকেশনে বিস্তারিত বোতাম আছে</li>
 </ul>
 </div>
 </div>
 </div>
 </div>
 <script>
let allTopics = [];
let userTopics = {};

// Get CSRF token
function getCsrfToken() {
 return document.querySelector('meta[name="csrf-token"]')?.content || '';
}

// Load and display permission status
async function loadPermissionStatus() {
 try {
 // Import the permission request module
 const { getNotificationPermission, requestNotificationPermission } = await import('/assets/firebase/v2/dist/permission-request.js');

 const permission = getNotificationPermission();
 const statusEl = document.getElementById('permissionStatus');

 let html = '';

 switch (permission) {
 case 'granted':
 html = `
 <div class="p-4 rounded-lg bg-green-50 text-green-800 border border-green-200 flex items-center mb-0">
 <i class="lucide lucide-check-circle mr-2"></i>
 <span>পুশ নোটিফিকেশন সক্ষম</span>
 </div>
 `;
 break;

 case 'denied':
 html = `
 <div class="p-4 rounded-lg bg-amber-50 text-amber-800 border border-amber-200 flex items-center mb-0">
 <i class="lucide lucide-alert-triangle mr-2"></i>
 <div>
 <span>পুশ নোটিফিকেশন অক্ষম</span><br>
 <small class="text-neutral-500">ব্রাউজার সেটিংস পরিবর্তন করুন অথবা নোটিফিকেশন পুনরায় সক্ষম করুন</small>
 </div>
 </div>
 `;
 break;

 case 'default':
 html = `
 <div>
 <p class="mb-3 text-neutral-500">পুশ নোটিফিকেশন এখনও সক্ষম নয়। সব আপডেট পেতে সক্ষম করুন।</p>
 <button class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-600/90 transition-colors w-full" data-action="requestPermission">
 <i class="lucide lucide-bell mr-1"></i>সক্ষম করুন
 </button>
 </div>
 `;
 break;

 default:
 html = `
 <div class="p-4 rounded-lg bg-neutral-100 text-neutral-700 border border-neutral-200 flex items-center mb-0">
 <i class="lucide lucide-info mr-2"></i>
 <span>এই ব্রাউজারে পুশ নোটিফিকেশন সমর্থিত নয়</span>
 </div>
 `;
 }

 statusEl.innerHTML = html;
 } catch (error) {
 console.error('Error loading permission status:', error);
 }
}

// Request permission
async function requestPermission() {
 try {
 const { requestNotificationPermission } = await import('/assets/firebase/v2/dist/permission-request.js');
 const result = await requestNotificationPermission();

 if (result.success) {
 showToast('✅ পুশ নোটিফিকেশন সক্ষম হয়েছে', 'success');
 loadPermissionStatus();
 } else {
 showToast('❌ ' + (result.error || 'পারমিশন দেওয়া হয়নি'), 'danger');
 }
 } catch (error) {
 console.error('Permission request error:', error);
 showToast('❌ সার্ভার ত্রুটি', 'danger');
 }
}

// Load user topic preferences
async function loadTopicPreferences() {
 try {
 // Load all available topics
 const topicsRes = await fetch('/api/topics/list');
 const topicsData = await topicsRes.json();
 allTopics = topicsData.topics || [];

 // Load user's preferences
 const prefsRes = await fetch('/api/user/notification-preferences', {
 headers: { 'X-CSRF-Token': getCsrfToken() }
 });
 const prefsData = await prefsRes.json();
 userTopics = prefsData.topics || {};

 // Render toggles
 const container = document.getElementById('topicsContainer');

 if (allTopics.length === 0) {
 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8.innerHTML = '<p class="text-neutral-500 text-center text-sm mb-0">কোনো বিষয় পাওয়া যায়নি</p>';
 return;
 }

 const html = allTopics.map(topic => `
 <div class="flex items-start gap-2 mb-2">
 <input
 type="checkbox"
 class="mt-0.5 w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-primary"
 id="topic_${topic.slug}"
 data-topic="${topic.slug}"
 ${userTopics[topic.slug] ? 'checked' : ''}
 />
 <label for="topic_${topic.slug}">
 <strong>${topic.name}</strong>
 ${topic.description ? `<br><small class="text-neutral-500">${topic.description}</small>` : ''}
 </label>
 </div>
 `).join('');

 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8.innerHTML = html || '<p class="text-neutral-500 text-center text-sm mb-0">কোনো বিষয় পাওয়া যায়নি</p>';

 // Add event listeners
 document.querySelectorAll('.topic-toggle').forEach(el => {
 el.addEventListener('change', toggleTopic);
 });
 } catch (e) {
 console.error('Failed to load topics:', e);
 document.getElementById('topicsContainer').innerHTML = `
 <div class="p-4 rounded-lg bg-red-50 text-red-800 border border-red-200 mb-0">
 <small>বিষয় লোড করতে ব্যর্থ: ${e.message}</small>
 </div>
 `;
 }
}

async function toggleTopic(e) {
  const topic = e.target.dataset.topic;
  const shouldSubscribe = e.target.checked;
  const endpoint = shouldSubscribe ? '/api/topics/subscribe' : '/api/topics/unsubscribe';

  try {
  const res = await fetch(endpoint, {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    'X-CSRF-Token': getCsrfToken()
  },
  body: JSON.stringify({ topic })
  });

  if (!res.ok) {
  e.target.checked = !shouldSubscribe; // Revert
  showToast('❌ বিষয় আপডেট করতে ব্যর্থ', 'danger');
  } else {
  const action = shouldSubscribe ? 'সাবস্ক্রাইব' : 'আনসাবস্ক্রাইব';
  showToast(`✅ ${topic} থেকে ${action} হয়েছে`, 'success');
  }
  } catch (err) {
  e.target.checked = !shouldSubscribe;
  console.error('Topic toggle error:', err);
  showToast('❌ সার্ভার ত্রুটি', 'danger');
  }
}

async function markAsRead(notificationId) {
  try {
  const res = await fetch('/api/notification/mark-read', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    'X-CSRF-Token': getCsrfToken()
  },
  body: JSON.stringify({ notification_id: notificationId })
  });

  if (res.ok) {
  const data = await res.json();
  if (data.success) {
  const card = document.querySelector(`[data-notification-id="${notificationId}"]`);
  if (card) {
    card.classList.remove('border-l-4', 'border-l-primary', 'bg-blue-50');
    if (card.classList.contains('dark:bg-blue-900/15')) {
      card.classList.remove('dark:bg-blue-900/15');
    }
  }
  showToast('✅ পড়া হিসেবে চিহ্নিত হয়েছে', 'success');
  location.reload();
  } else {
  showToast('❌ আপডেট করতে ব্যর্থ', 'danger');
  }
  } else {
  showToast('❌ সার্ভার ত্রুটি', 'danger');
  }
  } catch (err) {
  console.error('Mark as read error:', err);
  showToast('❌ সার্ভার ত্রুটি', 'danger');
  }
}

