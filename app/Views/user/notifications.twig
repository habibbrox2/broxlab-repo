<script>
document.addEventListener("click", function(e) {
  var t = e.target.closest("[data-action]");
  if (!t) return;
  switch (t.getAttribute("data-action")) {
  case "mark-all-read": markAllRead(); break;
  case "clear-all-notifications": clearAllNotifications(); break;
  case "delete-notification": deleteNotification(t.dataset.id); break;
  }
});
</script>

<script>
document.addEventListener("click", function(e) {
  var t = e.target.closest("[data-action]");
  if (!t) return;
  var a = t.getAttribute("data-action");
  var id = t.dataset.id;
  if (a && window[a]) window[a](id, t);
});
</script>
