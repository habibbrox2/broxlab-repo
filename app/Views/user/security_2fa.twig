{% extends"layout.twig" %}
{% block title %}Two-Factor Authentication{% endblock %}
{% block content %}
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
 <!-- Page Header -->
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-600/10 via-indigo-50 to-white p-6 sm:p-8">
   <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
     <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-indigo-400/30 blur-3xl"></div>
     <div class="absolute -bottom-10 -left-10 h-32 w-32 rounded-full bg-violet-400/20 blur-3xl"></div>
   </div>
   <div class="relative">
     <nav aria-label="breadcrumb" class="mb-2">
       <ol class="flex items-center gap-2 text-sm text-slate-500 list-none p-0 m-0">
         <li><a href="/profile" class="text-indigo-600 hover:text-indigo-800 transition-colors no-underline">Profile</a></li>
         <li class="before:content-['/'] before:mr-2 before:text-slate-300" aria-current="page">Two-Factor Authentication</li>
       </ol>
     </nav>
     <div class="flex items-center gap-2.5">
       <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-white shadow-lg shadow-indigo-600/20">
         <i class="lucide lucide-shield" style="width:1.25em;height:1.25em;"></i>
       </div>
       <div>
         <h1 class="text-xl font-black tracking-tight text-slate-900 sm:text-2xl">দ্বি-ফ্যাক্টর প্রমাণীকরণ (2FA)</h1>
         <p class="mt-0.5 text-sm text-slate-500">আপনার অ্যাকাউন্ট নিরাপত্তা বাড়াতে দ্বি-ফ্যাক্টর প্রমাণীকরণ ব্যবহার করুন।</p>
       </div>
     </div>
   </div>
 </div>
 <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
 <div class="lg:col-span-2">
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-100 text-indigo-600">
 <i class="lucide lucide-lock" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">দ্বি-ফ্যাক্টর প্রমাণীকরণ (2FA)</h5>
 </div>
 <div class="p-5">
 <!-- 2FA Status -->
 <div class="p-4 rounded-lg {% if twofa_enabled %}bg-green-50 text-green-800 border border-green-200{% else %}bg-sky-50 text-sky-800 border-sky-200{% endif %}" role="alert">
 <strong>
 {% if twofa_enabled %}
 <i class="lucide lucide-check-circle"></i> 2FA সক্ষম
 {% else %}
 <i class="lucide lucide-x-circle"></i> 2FA প্রতিবন্ধী
 {% endif %}
 </strong>
 <p class="mt-2 mb-0">
 {% if twofa_enabled %}
 আপনার অ্যাকাউন্ট Google Authenticator দিয়ে সুরক্ষিত রয়েছে।
 {% if twofa_created %}
 <br>
 <small>সেটআপ তারিখ: <strong>{{ twofa_created|date("F j, Y \\a\\t g:i A") }}</strong></small>
 {% endif %}
 {% else %}
 আপনার অ্যাকাউন্ট অতিরিক্ত নিরাপত্তা সুরক্ষা প্রয়োজন। 2FA সক্ষম করুন।
 {% endif %}
 </p>
 </div>
 <!-- 2FA Information -->
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
 <div>
 <h5>2FA কী?</h5>
 <p class="text-neutral-500">
 দ্বি-ফ্যাক্টর প্রমাণীকরণ আপনার অ্যাকাউন্টকে অতিরিক্ত সুরক্ষা প্রদান করে। পাসওয়ার্ড ছাড়াও, আপনাকে
 আপনার ফোনে আসা একটি অনন্য কোড প্রদান করতে হবে।
 </p>
 </div>
 <div>
 <h5>সুবিধা:</h5>
 <ul class="text-neutral-500">
 <li>অ্যাকাউন্ট নিরাপত্তা বৃদ্ধি</li>
 <li>হ্যাকারদের বিরুদ্ধে সুরক্ষা</li>
 <li>ব্যাকআপ কোড সহ জরুরি অ্যাক্সেস</li>
 </ul>
 </div>
 </div>
 <hr class="my-4">
 <!-- Actions -->
 <div class="grid grid-cols-1 gap-4 mt-4">
 {% if not twofa_enabled %}
 <div>
 <a href="/user/security/2fa/setup" class="w-full inline-flex items-center justify-center px-5 py-3 rounded-lg bg-green-600 text-white text-base font-medium hover:bg-green-700 transition-colors">
 <i class="lucide lucide-settings"></i> 2FA এখਨই সেটআপ করুন
 </a>
 </div>
 {% else %}
 <div>
 <a href="/user/security/2fa/backup" class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-sky-500 text-white text-base font-medium hover:bg-sky-600 transition-colors">
 <i class="lucide lucide-download"></i> ব্যাকআপ কোড দেখুন
 </a>
 </div>
 <div>
 <button type="button"
 class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-red-600 text-white text-base font-medium hover:bg-red-700 transition-colors"
 data-brox-toggle="modal"
 data-brox-target="#disableTwoFAModal">
 <i class="lucide lucide-x"></i> 2FA প্রতিবন্ধ করুন
 </button>
 </div>
 {% endif %}
 </div>
 </div>
 </div>
 <!-- FAQ Section -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mt-4 transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
 <i class="lucide lucide-help-circle" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">সাধারণ প্রশ্ন (FAQ)</h5>
 </div>
 <div class="p-5">
 <div class="divide-y divide-slate-100 dark:divide-slate-700/50" id="faqAccordion">
 <div class="border-b border-slate-100">
 <div id="headingOne">
 <h2 class="mb-0">
 <button class="w-full text-left px-0 py-2 text-indigo-600 hover:text-indigo-600/80 transition-colors text-sm font-medium bg-transparent border-0 cursor-pointer"
 type="button"
 data-brox-toggle="collapse"
 data-brox-target="#collapseOne">
 কোন অ্যাপ ব্যবহার করব?
 </button>
 </h2>
 </div>
 <div id="collapseOne" class="collapse" data-brox-parent="#faqAccordion">
 <div class="px-0 py-3">
 আপনি যেকোনো TOTP-সামঞ্জস্যপূর্ণ অ্যাপ ব্যবহার করতে পারেন যেমন:
 <ul class="mt-2">
 <li>Google Authenticator</li>
 <li>Microsoft Authenticator</li>
 <li>Authy</li>
 <li>LastPass Authenticator</li>
 </ul>
 </div>
 </div>
 </div>
 <div class="border-b border-slate-100">
 <div id="headingTwo">
 <h2 class="mb-0">
 <button class="w-full text-left px-0 py-2 text-indigo-600 hover:text-indigo-600/80 transition-colors text-sm font-medium bg-transparent border-0 cursor-pointer"
 type="button"
 data-brox-toggle="collapse"
 data-brox-target="#collapseTwo">
 ফোন হারিয়ে গেলে কী করব?
 </button>
 </h2>
 </div>
 <div id="collapseTwo" class="collapse" data-brox-parent="#faqAccordion">
 <div class="px-0 py-3">
 আপনি সংরক্ষিত ব্যাকআপ কোডগুলি ব্যবহার করতে পারেন লগইন করতে এবং 2FA বন্ধ করতে। অগ্রিম সংরক্ষণ করুন!
 </div>
 </div>
 </div>
 <div class="border-b border-slate-100">
 <div id="headingThree">
 <h2 class="mb-0">
 <button class="w-full text-left px-0 py-2 text-indigo-600 hover:text-indigo-600/80 transition-colors text-sm font-medium bg-transparent border-0 cursor-pointer"
 type="button"
 data-brox-toggle="collapse"
 data-brox-target="#collapseThree">কোড কতক্ষণ বৈধ?</button>
 </h2>
 </div>
 <div id="collapseThree" class="collapse" data-brox-parent="#faqAccordion">
 <div class="px-0 py-3">
 প্রতিটি কোড ৩০ সেকেন্ডের জন্য বৈধ। যদি কোড কাজ না করে, পরবর্তীটি চেষ্টা করুন।
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Sidebar -->
 <div class="lg:col-span-1">
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-4 transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-4 py-3">
 <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
 <i class="lucide lucide-info" style="width:1em;height:1em;"></i>
 </div>
 <h6 class="text-sm font-bold text-slate-900">গুরুত্বপূর্ণ তথ্য</h6>
 </div>
 <div class="p-4 text-sm">
 <p>
 <strong>2FA নিরাপত্তা টিপস:</strong>
 </p>
 <ul>
 <li>কোনো কাউকে কোড শেয়ার করবেন না</li>
 <li>ব্যাকআপ কোড নিরাপদ জায়গায় রাখুন</li>
 <li>ফোন সময় সঠিক রাখুন</li>
 <li>নিয়মিত পাসওয়ার্ড পরিবর্তন করুন</li>
 </ul>
 </div>
 </div>
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-4 py-3">
 <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600">
 <i class="lucide lucide-phone" style="width:1em;height:1em;"></i>
 </div>
 <h6 class="text-sm font-bold text-slate-900">সাপোর্ট</h6>
 </div>
 <div class="p-4 text-sm text-neutral-500">
 <p>
 2FA সেটআপ করতে সমস্যা হচ্ছেন?
 <a href="/contact">সাপোর্টের সাথে যোগাযোগ করুন</a>
 </p>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Disable 2FA Modal -->
 {% if twofa_enabled %}
 <div class="fixed inset-0 z-50 hidden" id="disableTwoFAModal" tabindex="-1" role="dialog">
 <div class="fixed inset-0 bg-black/50" aria-hidden="true"></div>
 <div class="fixed inset-0 flex items-center justify-center p-4">
 <div class="relative bg-white rounded-xl shadow-md-xl w-full max-w-md">
 <form method="POST" action="/user/security/2fa/disable">
 <div class="flex items-center justify-between px-5 py-4 border-b border-slate-200">
 <h5 class="text-lg font-bold text-neutral-800 m-0">2FA প্রতিবন্ধী করুন</h5>
 <button type="button"
 class="w-8 h-8 flex items-center justify-center border-0 bg-transparent text-neutral-500 hover:text-neutral-800 hover:bg-neutral-100 rounded-lg transition-all duration-150 cursor-pointer"
 data-brox-dismiss="modal"
 aria-label="Close">&times;</button>
 </div>
 <div class="px-5 py-4">
 <p>
 <strong>সতর্কতা!</strong> আপনার অ্যাকাউন্ট আর 2FA সুরক্ষিত থাকবে না।
 </p>
 <div class="mb-3">
 <label for="password">পাসওয়ার্ড নিশ্চিত করতে:</label>
 <input type="password" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary" name="password" required>
 <small class="text-xs text-neutral-400">নিরাপত্তার জন্য আপনার পাসওয়ার্ড প্রবেশ করুন</small>
 </div>
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 </div>
 <div class="flex items-center justify-end gap-2 px-5 py-4 border-t border-slate-200 rounded-b-xl bg-slate-50/50">
 <button type="button" class="inline-flex items-center px-4 py-2 rounded-lg border border-neutral-300 bg-white text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition-colors" data-brox-dismiss="modal">বাতিল</button>
 <button type="submit" class="inline-flex items-center px-4 py-2 rounded-lg bg-red-600 text-white text-sm font-medium hover:bg-red-700 transition-colors">হ্যাঁ, প্রতিবন্ধী করুন</button>
 </div>
 </form>
 </div>
 </div>
 </div>
 {% endif %}
{% endblock %}




