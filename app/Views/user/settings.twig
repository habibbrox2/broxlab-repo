{% extends"layout.twig" %}
{% block title %}{{ 'My Settings'|trans }} | {{ 'Account Management'|trans }}{% endblock %}
{% block content %}
<style>
/* ── Offcanvas support for broxUI (non-Bootstrap) ── */
.offcanvas {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1055;
  width: 400px;
  max-width: calc(100vw - 3rem);
  height: 100%;
  background: #fff;
  transform: translateX(-100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.35s ease;
  visibility: hidden;
  outline: 0;
}
.offcanvas.show {
  transform: translateX(0);
  visibility: visible;
}
.offcanvas-backdrop {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1050;
  background: rgba(0, 0, 0, 0.5);
  transition: opacity 0.2s ease;
}
.offcanvas-backdrop.fade { opacity: 0; }
.offcanvas-backdrop.fade.show { opacity: 1; }

/* ── Tab-pane support for broxUI (non-Bootstrap) ── */
.tab-pane:not(.active) { display: none; }
.tab-pane.active { display: block; }

/* ── Dark mode overrides ── */
[data-theme="dark"] .offcanvas {
  background: rgb(var(--surface));
}
[data-theme="dark"] .offcanvas-backdrop {
  background: rgba(0, 0, 0, 0.7);
}
</style>
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-5 mb-5">
 <!-- Page Header -->
<div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-600/10 via-indigo-50 to-white p-6 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
    <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-indigo-400/30 blur-3xl"></div>
    <div class="absolute -bottom-10 -left-10 h-32 w-32 rounded-full bg-violet-400/20 blur-3xl"></div>
  </div>
  <div class="relative">
    <div class="flex items-center gap-2.5">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-white shadow-lg shadow-indigo-600/20">
        <i class="lucide lucide-settings" style="width:1.25em;height:1.25em;"></i>
      </div>
      <div>
        <h1 class="text-xl font-black tracking-tight text-slate-900 sm:text-2xl">{{ 'Account Settings'|trans }}</h1>
        <p class="mt-0.5 text-sm text-slate-500">
          {{ 'Manage your account security, linked providers, notifications and privacy preferences all from one place.'|trans }}
        </p>
      </div>
    </div>
  </div>
</div>
 <!-- mobile menu button -->
 <button class="inline-flex items-center px-4 py-2 rounded-lg border border-neutral-300 text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition-colors lg:hidden mb-3"
 type="button"
 data-brox-toggle="offcanvas"
 data-brox-target="#settingsSidebar"
 aria-controls="#settingsSidebar">
 <i class="lucide lucide-menu"></i> {{ 'Menu'|trans }}
