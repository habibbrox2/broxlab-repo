  <h5 id="settingsSidebarLabel" class="text-base font-bold text-slate-900 dark:text-slate-100">{{ 'Settings'|trans }}</h5>
  <button type="button"
    class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-700 dark:hover:text-slate-300"
    data-brox-dismiss="offcanvas"
    aria-label="{{ 'Close'|trans }}">
    <i class="lucide lucide-x" style="width:1.125em;height:1.125em;"></i>
  </button>
 </div>
 <div class="flex-1 overflow-y-auto p-2">
  <div class="space-y-1" role="tablist">
