 <p class="text-sm text-neutral-500 mb-3">
 Add additional email addresses to your account for enhanced security and account recovery options.
 </p>
 <form id="link-email-form" class="needs-validation" novalidate>
 <div class="flex items-center mb-3">
 <input type="email"
 class="w-full px-3 py-2 border border-neutral-300 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all bg-white"
 id="new-email"
 name="email"
 placeholder="Enter email address"
 required>
 <button class="inline-flex items-center px-4 py-2.5 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-600/90 transition-colors" type="submit" id="link-email-btn">
 <i class="lucide lucide-link-2 mr-1"></i> Link Email
 </button>
 </div>
 <div id="link-email-message" class="hidden" role="alert"></div>
 </form>
 </div>
 <!-- Email Security Info -->
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200 text-sm mt-4 mb-0">
 <i class="lucide lucide-shield mr-2"></i>
 <strong>Security:</strong> Only you can link or unlink email addresses. We'll send a verification link to confirm the email.
 </div>
 </div>
 </div>
 </div>
<!-- Notifications Preferences Tab -->
<div class="tab-pane" id="notifications-prefs" role="tabpanel">
 <!-- Notification Channels Card -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-4 transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-100 text-amber-600">
 <i class="lucide lucide-bell" style="width:1.125em;height:1.125em;"></i>
 </div>
