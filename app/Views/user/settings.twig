     data-brox-toggle="tab"
     aria-selected="false">
    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600"><i class="lucide lucide-shield" style="width:1em;height:1em;"></i></div> Privacy & Data
   </a>
  </div>
 </div>
</div>
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
 <!-- Sidebar Navigation -->
 <div class="lg:col-span-3 mb-4 hidden lg:block">
 <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
 <div class="border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
   <h6 class="text-sm font-bold text-slate-900">
     <i class="lucide lucide-menu mr-2"></i>{{ 'Navigation'|trans }}
   </h6>
 </div>
 <div class="p-2 space-y-1" role="tablist">
   <a href="#password-security"
     class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-semibold text-indigo-600 bg-indigo-50 transition-colors"
     data-brox-toggle="tab"
     aria-selected="true">
    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-white"><i class="lucide lucide-lock" style="width:1em;height:1em;"></i></div> {{ 'Password & Security'|trans }}
   </a>
   <a href="#oauth-accounts"
     class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-medium text-slate-600 transition-all hover:bg-slate-50"
     data-brox-toggle="tab">
    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-100 text-sky-600"><i class="lucide lucide-link-2" style="width:1em;height:1em;"></i></div> {{ 'Linked Accounts'|trans }}
   </a>
   <a href="#notifications-prefs"
     class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-medium text-slate-600 transition-all hover:bg-slate-50"
     data-brox-toggle="tab">
    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-100 text-amber-600"><i class="lucide lucide-bell" style="width:1em;height:1em;"></i></div> {{ 'Notifications'|trans }}
   </a>
   <a href="#device-management"
     class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-medium text-slate-600 transition-all hover:bg-slate-50"
     data-brox-toggle="tab">
    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-100 text-indigo-600"><i class="lucide lucide-smartphone" style="width:1em;height:1em;"></i></div> {{ 'Devices'|trans }}
   </a>
   <a href="#privacy"
     class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-medium text-slate-600 transition-all hover:bg-slate-50"
     data-brox-toggle="tab">
    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600"><i class="lucide lucide-shield" style="width:1em;height:1em;"></i></div> {{ 'Privacy & Data'|trans }}
   </a>
 </div>
 </div>
 </div>
 <!-- Main Content -->
 <div class="lg:col-span-9">
 <!-- Alerts Section -->
 <div id="alerts-container"></div>
 <!-- Profile Summary -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-4 transition-shadow hover:shadow-md">
 <div class="p-5 flex items-center gap-4">
 <div class="relative shrink-0">
 <img src="{{ user.photo_url|default("/assets/profile-placeholder.png") }}"
 class="rounded-full border-2 border-slate-200 object-cover shadow-sm"
 width="64"
 height="64"
 alt="Profile"
 loading="lazy">
 <div class="absolute -bottom-0.5 -right-0.5 flex h-4 w-4 items-center justify-center rounded-full border-2 border-white bg-emerald-500 shadow-sm">
   <i class="lucide lucide-check h-2 w-2 text-white"></i>
 </div>
 </div>
 <div>
 <h5 class="mb-0.5 font-bold text-slate-900">{{ user.full_name|default(user.username) }}</h5>
 <p class="text-sm text-slate-500">{{ user.email }}</p>
 <a href="/profile" class="inline-flex items-center gap-1.5 mt-1 rounded-lg bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-indigo-600 transition-all hover:bg-indigo-100 hover:-translate-y-0.5">
 <i class="lucide lucide-pencil" style="width:0.875em;height:0.875em;"></i>{{ 'Edit Profile'|trans }}
 </a>
 </div>
 </div>
 </div>
 <!-- Account Information Tab --><!-- ── Tab Panels ── -->
<!-- Password & Security Tab --> <div class="tab-pane {{ current_tab|default('password-security') == 'password-security' ? 'active' : '' }}"
     id="password-security"
     role="tabpanel">
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-4 transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-100 text-indigo-600">
 <i class="lucide lucide-lock" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">{{ 'Password & Security'|trans }}</h5>
 </div>
 <div class="p-5">
 <!-- Change Password Section -->
 <h6 class="mb-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">{{ 'Change Password'|trans }}</h6>
 <form id="change-password-form">
 <div class="mb-3">
 <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{{ 'Current Password'|trans }}</label>
 <input type="password"
 class="w-full px-3 py-2 border border-neutral-300 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all bg-white"
 id="current_password"
 placeholder="{{ 'Enter your current password'|trans }}"
 required>
 <small class="text-xs text-neutral-400">{{ 'Required for security verification'|trans }}</small>
 </div>
 <div class="mb-3">
 <label class="block text-sm font-semibold text-neutral-700 mb-1.5">{{ 'New Password'|trans }}</label>
 <input type="password"
 class="w-full px-3 py-2 border border-neutral-300 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all bg-white"
 id="new_password"
 placeholder="{{ 'Enter new password'|trans }}"
 required>
 <small class="text-xs text-neutral-400">{{ 'At least 8 characters, including uppercase, lowercase, number, and special character'|trans }}</small>
 <div class="password-strength mt-2">
 <div class="strength-meter">
 <div class="strength-meter-fill" id="strength-meter-fill"></div>
 </div>
 <span class="strength-text" id="strength-text">Very Weak</span>
 </div>
 <ul class="password-requirements text-xs mt-2" id="password-requirements">
 <li id="req-length">At least 8 characters</li>
 <li id="req-uppercase">One uppercase letter (A-Z)</li>
 <li id="req-lowercase">One lowercase letter (a-z)</li>
 <li id="req-number">One number (0-9)</li>
 <li id="req-special">One special character (!@#$%^&*)</li>
 </ul>
 </div>
 <div class="mb-3">
 <label class="block text-sm font-semibold text-neutral-700 mb-1.5">Confirm New Password</label>
 <input type="password"
 class="w-full px-3 py-2 border border-neutral-300 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all bg-white"
 id="confirm_password"
 placeholder="Confirm new password"
 required>
 </div>
 <input type="hidden" id="csrf_token" value="{{ csrf_token }}">
 <button type="submit" class="inline-flex items-center px-4 py-2.5 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-600/90 transition-colors">
 <i class="lucide lucide-check mr-1"></i> Update Password
 </button>
 <button type="reset" class="inline-flex items-center px-4 py-2.5 rounded-lg border border-neutral-300 bg-white text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition-colors ml-2">Clear</button>
 </form>
 <hr class="my-4">
 <!-- Two-Factor Authentication -->
 <h6 class="mb-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Two-Factor Authentication</h6>
 <div class="flex items-center justify-between">
 <div>
 <p class="mb-1">
 <strong>Two-Factor Authentication</strong>
 </p>
 <small class="text-neutral-500">Add an extra layer of security to your account</small>
 </div>
 <button class="inline-flex items-center px-3 py-1.5 rounded-lg text-indigo-600 text-sm font-medium hover:bg-indigo-600/10 transition-colors"
 onclick="window.location.href='/user/security/2fa'">
 <i class="lucide lucide-shield mr-1"></i> Setup 2FA
 </button>
 </div>
 <!-- Active Sessions -->
 <h6 class="mb-3 text-xs font-semibold text-neutral-500 uppercase tracking-wider">Active Sessions</h6>
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200 text-sm">
 <i class="lucide lucide-info mr-2"></i>
 You are currently logged in from this browser.
 </div>
 <button class="inline-flex items-center px-3 py-1.5 rounded-lg bg-red-600 text-white text-sm font-medium hover:bg-red-700 transition-colors" id="logout-all-btn">
 <i class="lucide lucide-log-out mr-1"></i> Logout from All Devices
 </button>
 </div>
 </div>
 </div>
<!-- Firebase Auth Linked Accounts Tab --> <div class="tab-pane" id="oauth-accounts" role="tabpanel">
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-4 transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-sky-100 text-sky-600">
