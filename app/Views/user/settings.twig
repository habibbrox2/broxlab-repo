 <label class="flex flex-col" for="sms-notifications">
 <strong>SMS Notifications</strong>
 <small class="block text-neutral-500">Text message alerts (if available)</small>
 </label>
 </div>
 </div>
 </div>
 <div class="md:col-span-1">
 <div class="mb-3">
 <div class="flex items-center gap-3">
 <input class="w-10 h-6 rounded-full border-2 border-neutral-300 bg-white checked:bg-indigo-600 checked:border-primary appearance-none cursor-pointer transition-colors shrink-0 notification-channel"
