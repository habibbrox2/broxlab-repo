{% extends 'layout.twig' %}

{% block title %}{{ page_title|default('Build Your CV (Guest Mode)') }}{% endblock %}

{% block content %}
<div class="min-h-screen bg-slate-50">
  <div class="max-w-4xl mx-auto px-4 py-6">
    
    {# Guest Mode Banner #}
    <div class="bg-amber-50 border-2 border-amber-200 rounded-xl p-4 mb-6 flex items-start gap-3">
      <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center flex-shrink-0">
        <i data-lucide="info" class="w-4 h-4 text-amber-600"></i>
      </div>
      <div class="flex-1">
        <p class="text-xs text-amber-700 leading-relaxed">
          Guest mode — using <strong>Minimal</strong> template. 
          <a href="/login?redirect=/cv-builder/templates" class="font-semibold underline hover:text-amber-900">Log in</a> to unlock premium templates and save permanently.
        </p>
      </div>
    </div>

    {# Job Position Selector #}
    <div class="mb-6">
      <select id="bld-job-title" data-action="select-job"
              class="w-full px-5 py-3.5 border-2 border-slate-200 rounded-xl bg-white text-slate-900 text-base font-medium cursor-pointer appearance-none transition-all duration-300 hover:bg-slate-50 hover:border-slate-300 focus:outline-none focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-500/10"
              style="background-image: url('data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2720%27 height=%2720%27 viewBox=%270 0 24 24%27 fill=%27none%27 stroke=%27%23334155%27 stroke-width=%272%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27%3E%3Cpolyline points=%276 9 12 15 18 9%27%3E%3C/polyline%3E%3C/svg%3E');
                     background-repeat: no-repeat; background-position: right 1rem center; background-size: 1.25rem; padding-right: 3rem;">
        <option value="">Select your job title for suggestions...</option>
        {% for pos in job_positions %}
        <option value="{{ pos.slug }}">{{ pos.title }}</option>
        {% endfor %}
      </select>
    </div>

    {# Progress Bar #}
    <div class="bg-white rounded-2xl p-6 mb-6 border border-slate-200 shadow-sm">
      <div class="flex justify-between items-center mb-3.5">
        <span class="text-slate-900 font-semibold flex items-center gap-2">
          <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-slate-100 text-[0.8rem] font-bold" id="bld-current-step">1</span>
          <span>Step <span id="bld-current-step-num">1</span> of <span id="bld-total-steps">3</span></span>
        </span>
        <span class="text-slate-600 text-sm font-medium bg-slate-100 px-3 py-1 rounded-full">
          <span id="bld-progress-pct">0</span>% Complete
        </span>
      </div>
      <div class="h-1.5 bg-slate-100 rounded-full overflow-hidden mb-4 relative">
        <div class="h-full bg-gradient-to-r from-indigo-500 to-purple-500 rounded-full transition-all duration-[0.6s] ease-out" id="bld-progress-fill" style="width: 0%;"></div>
      </div>
      <div class="flex justify-between relative py-1" id="bld-step-dots">
        <div class="absolute top-1/2 left-0 right-0 h-0.5 bg-slate-200 -translate-y-1/2 pointer-events-none"></div>
        {% set steps = [
          {'label': 'Personal', 'num': '1'},
          {'label': 'Professional', 'num': '2'},
          {'label': 'Extras', 'num': '3'}
        ] %}
        {% for step in steps %}
        <div class="flex flex-col items-center gap-1.5 relative z-10 cursor-pointer transition-transform duration-300 hover:-translate-y-0.5" title="{{ step.label }}">
          <div class="w-8 h-8 md:w-8 md:h-8 rounded-full bg-slate-100 border-2 border-slate-200 transition-all duration-[0.4s] ease-out flex items-center justify-center text-xs font-bold text-slate-400 relative {% if step.num == '1' %}bg-indigo-600 border-indigo-600 text-white scale-110 shadow-[0_0_16px_rgba(99,102,241,0.2)]{% endif %}"
               data-step="{{ step.num }}">
            <span>{{ step.num }}</span>
          </div>
          <span class="text-[0.6rem] text-slate-500 whitespace-nowrap font-medium tracking-wide hidden sm:block">{{ step.label }}</span>
        </div>
        {% endfor %}
      </div>
    </div>

    {# Step Content #}
    <div class="bg-white rounded-2xl p-6 md:p-10 shadow-xl border border-slate-200 relative overflow-hidden" id="bld-step-content">
      {# JavaScript populates this #}
    </div>

    {# Navigation #}
    <div class="flex justify-between items-center mt-8 pt-6 border-t-2 border-slate-200 gap-3 flex-wrap">
      <button class="flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-sm border-none cursor-pointer transition-all duration-200 active:scale-[0.97] bg-white text-slate-600 hover:bg-slate-100 hover:text-slate-900" id="bld-btn-prev" data-action="prev-step">
        <i data-lucide="chevron-left" class="w-4 h-4"></i> Back
      </button>
      <div class="flex gap-3">
        <button class="flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-sm border-2 border-slate-200 cursor-pointer transition-all duration-200 active:scale-[0.97] bg-white text-slate-600 hover:bg-slate-50 hover:border-slate-300" id="bld-btn-save-draft" data-action="save-draft">
          <i data-lucide="save" class="w-4 h-4"></i> Save
        </button>
        <button class="flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-sm border-2 border-slate-200 cursor-pointer transition-all duration-200 active:scale-[0.97] bg-white text-slate-600 hover:bg-slate-100 hover:text-slate-900" id="bld-btn-skip" data-action="skip-step">
          Skip <i data-lucide="skip-forward" class="w-4 h-4"></i>
        </button>
        <button class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-sm border-none cursor-pointer transition-all duration-200 active:scale-[0.97] bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow-lg shadow-indigo-500/30 hover:shadow-xl hover:shadow-indigo-500/40 hover:-translate-y-0.5" id="bld-btn-next" data-action="next-step">
          Next <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </button>
      </div>
    </div>

    {# Auto-save Indicator #}
    <div class="fixed bottom-6 right-6 bg-gray-900/90 backdrop-blur-sm text-white px-4 py-2.5 rounded-xl text-sm opacity-0 translate-y-2.5 transition-all duration-300 z-[100] flex items-center gap-2 shadow-2xl border border-white/10" id="bld-save-indicator">
      <i data-lucide="check-circle" class="w-4 h-4 text-emerald-500"></i>
      Auto-saved
    </div>
  </div>
</div>

<script type="module" src="/assets/js/dist/cv-builder.js?v={{ random() }}"></script>
<script>
window.__bldData = {{ builder_state|json_encode|raw }};
window.__bldCvId = {{ cv_id|raw }};
window.__bldCsrf = '{{ csrf_token|default('') }}';
window.__bldJobPositions = {{ job_positions|json_encode|raw }};
window.__bldTemplates = ['minimal'];
window.__bldSelectedTemplate = 'minimal';
window.__bldProfilePhoto = '';
window.__bldGuestMode = true;
window.__bldGuestApiBase = '/api/cv/guest';
</script>
{% endblock %}
