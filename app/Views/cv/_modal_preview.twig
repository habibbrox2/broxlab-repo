{% macro preview_modal(cv_id, templates, selected_template) %}
<!-- CV Modal Preview - Isolated iframe with no CSS conflicts -->
<div id="cv-preview-modal" class="fixed inset-0 z-[9999] hidden" role="dialog" aria-modal="true" aria-label="CV Preview">
  <!-- Backdrop -->
  <div class="fixed inset-0 bg-black/60 backdrop-blur-sm transition-opacity"></div>
  
  <!-- Modal Container -->
  <div class="fixed inset-0 flex items-center justify-center p-2 sm:p-4">
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-5xl max-h-[95vh] flex flex-col overflow-hidden animate-modal-in">
      <!-- Header -->
      <div class="flex items-center justify-between px-4 sm:px-6 py-3 sm:py-4 border-b border-gray-200 bg-gradient-to-r from-gray-50 to-white flex-shrink-0">
        <div class="flex items-center gap-3">
          <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
            <i class="lucide lucide-eye w-5 h-5 text-indigo-600"></i>
            CV Preview
          </h3>
          <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 bg-indigo-50 text-indigo-700 text-xs font-semibold rounded-full border border-indigo-200">
            <i class="lucide lucide-maximize-2 w-3 h-3"></i>
            A4 Preview
          </span>
        </div>
        <div class="flex items-center gap-2">
          <!-- Template Switcher -->
          <select id="modal-template-select" data-action="change-modal-template"
                  class="text-sm border border-gray-300 rounded-lg px-3 py-1.5 bg-white text-gray-700 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none">
            {% for t in templates %}
            <option value="{{ t }}" {{ t == selected_template ? 'selected' : '' }}>{{ t|capitalize }}</option>
            {% endfor %}
          </select>
          <div class="hidden sm:flex items-center gap-1 border-l border-gray-200 pl-2 ml-1">
            <button data-action="modal-zoom-out" class="p-1.5 rounded-lg hover:bg-gray-100 text-gray-500 hover:text-gray-700 transition-colors" title="Zoom Out">
              <i class="lucide lucide-zoom-out w-4 h-4"></i>
            </button>
            <span id="modal-zoom-level" class="text-xs font-medium text-gray-600 min-w-[3rem] text-center select-none">100%</span>
            <button data-action="modal-zoom-in" class="p-1.5 rounded-lg hover:bg-gray-100 text-gray-500 hover:text-gray-700 transition-colors" title="Zoom In">
              <i class="lucide lucide-zoom-in w-4 h-4"></i>
            </button>
            <button data-action="modal-zoom-reset" class="p-1.5 rounded-lg hover:bg-gray-100 text-gray-500 hover:text-gray-700 transition-colors" title="Reset Zoom">
              <i class="lucide lucide-rotate-ccw w-4 h-4"></i>
            </button>
          </div>
          <button data-action="close-preview-modal" class="p-1.5 rounded-lg hover:bg-gray-100 text-gray-400 hover:text-gray-600 transition-colors ml-1" title="Close Preview">
            <i class="lucide lucide-x w-5 h-5"></i>
          </button>
        </div>
      </div>
      
      <!-- Iframe Body -->
      <div class="flex-1 overflow-hidden bg-gray-100 relative" id="modal-preview-body">
        <!-- Loading overlay -->
        <div id="modal-preview-loading" class="absolute inset-0 flex items-center justify-center bg-gray-100/80 z-10 transition-opacity duration-300">
          <div class="flex flex-col items-center gap-3">
            <div class="w-10 h-10 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin"></div>
            <span class="text-sm text-gray-500 font-medium">Loading preview...</span>
          </div>
        </div>
        
        <!-- Scrollable iframe container -->
        <div class="w-full h-full overflow-auto" id="modal-preview-scroll">
          <div id="modal-preview-scale-wrapper" class="flex items-start justify-center p-4 sm:p-8 transition-all duration-200">
            <iframe id="cv-preview-iframe"
                    class="bg-white rounded-lg shadow-lg"
                    style="width: 210mm; min-height: 297mm; border: none; transition: width 0.2s, height 0.2s;"
                    sandbox="allow-scripts allow-same-origin"
                    title="CV Preview"
                    loading="lazy">
            </iframe>
          </div>
        </div>
      </div>
      
      <!-- Footer -->
      <div class="flex items-center justify-between px-4 sm:px-6 py-3 border-t border-gray-200 bg-gray-50 flex-shrink-0">
        <div class="text-xs text-gray-500 flex items-center gap-2">
          <i class="lucide lucide-info w-3.5 h-3.5"></i>
          <span>Scroll to navigate · <kbd class="px-1.5 py-0.5 bg-gray-200 rounded text-[10px] font-mono">Esc</kbd> to close</span>
        </div>
        <div class="flex items-center gap-2">
          <a href="/cv-builder/{{ cv_id }}/export/pdf?output=inline" target="_blank"
             class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
            <i class="lucide lucide-printer w-4 h-4"></i>
            <span class="hidden sm:inline">Print</span>
          </a>
          <a href="/cv-builder/{{ cv_id }}/export/pdf"
             class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-semibold text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
            <i class="lucide lucide-download w-4 h-4"></i>
            <span class="hidden sm:inline">Download PDF</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
@keyframes modal-in {
  from { opacity: 0; transform: scale(0.95) translateY(10px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}
#cv-preview-modal:not(.hidden) .animate-modal-in {
  animation: modal-in 0.25s ease-out;
}
#cv-preview-modal * { box-sizing: border-box; }
#modal-preview-scroll::-webkit-scrollbar { width: 8px; height: 8px; }
#modal-preview-scroll::-webkit-scrollbar-track { background: transparent; }
#modal-preview-scroll::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 4px; }
#modal-preview-scroll::-webkit-scrollbar-thumb:hover { background: #9ca3af; }
@media (max-width: 640px) {
  #cv-preview-iframe { width: 100% !important; min-height: 80vh !important; border-radius: 4px; }
  #modal-preview-scale-wrapper { padding: 8px !important; }
}
</style>

<script>
(function() {
  var cvId = {{ cv_id|default(0) }};
  var currentTemplate = '{{ selected_template|default('modern') }}';
  var modalZoom = 1.0;
  var iframe = null;
  var modalEl = null;

  function init() {
    modalEl = document.getElementById('cv-preview-modal');
    iframe = document.getElementById('cv-preview-iframe');
    if (!modalEl || !iframe) return;
    modalEl.querySelector('.fixed.inset-0.bg-black\/60')?.addEventListener('click', closePreviewModal);
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !modalEl.classList.contains('hidden')) closePreviewModal();
    });
  }

  window.openPreviewModal = function(cvId_, template) {
    cvId = cvId_ || {{ cv_id|default(0) }};
    if (template) currentTemplate = template;
    if (!modalEl) init();
    if (!modalEl || !iframe) return;
    modalEl.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    var loading = document.getElementById('modal-preview-loading');
    loading.classList.remove('hidden');
    loadIframe();
  };

  window.closePreviewModal = function() {
    if (!modalEl) return;
    modalEl.classList.add('hidden');
    document.body.style.overflow = '';
    if (iframe) iframe.src = '';
  };

  window.changeModalTemplate = function(template) {
    currentTemplate = template;
    document.getElementById('modal-template-select').value = template;
    loadIframe();
  };

  function loadIframe() {
    if (!iframe) return;
    var loading = document.getElementById('modal-preview-loading');
    loading.classList.remove('hidden');
    iframe.src = '/api/cv/' + cvId + '/preview?template=' + encodeURIComponent(currentTemplate) + '&t=' + Date.now();
    iframe.onload = function() {
      var loading = document.getElementById('modal-preview-loading');
      if (loading) loading.classList.add('hidden');
    };
  }

  function modalZoomIn() {
    modalZoom = Math.min(2.0, modalZoom + 0.1);
    applyModalZoom();
  }
  function modalZoomOut() {
    modalZoom = Math.max(0.5, modalZoom - 0.1);
    applyModalZoom();
  }
  function modalZoomReset() {
    modalZoom = 1.0;
    applyModalZoom();
  }
  function applyModalZoom() {
    var el = document.getElementById('cv-preview-iframe');
    var label = document.getElementById('modal-zoom-level');
    if (el) {
      el.style.transform = 'scale(' + modalZoom + ')';
      el.style.transformOrigin = 'top center';
    }
    if (label) {
      label.textContent = Math.round(modalZoom * 100) + '%';
    }
  }

  // Init on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

<script>
document.addEventListener("click", function(e) {
  var t = e.target.closest("[data-action]");
  if (!t) return;
  var a = t.getAttribute("data-action");
  var id = t.dataset.id;
  if (a && window[a]) window[a](id, t);
});
</script>
</script>
{% endmacro %}
