{% extends 'layout.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %}
<div class="min-h-screen bg-white pb-32">
  <!-- Header with Back Button -->
  <div class="bg-white border-b border-gray-200 sticky top-0 z-10">
    <div class="flex items-center justify-between px-4 py-4 max-w-2xl mx-auto">
      <a href="javascript:history.back()" class="text-gray-700 hover:text-gray-900">
        <i class="lucide-chevron-left text-2xl"></i>
      </a>
      <h1 class="text-xl font-bold text-gray-900">সিভি বিল্ডার</h1>
      <div class="w-6"></div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-2xl mx-auto px-4 py-6">
    <!-- Profile Card -->
    <div class="bg-gray-50 rounded-xl p-6 mb-6">
      <div class="flex gap-4 mb-6">
        <!-- Profile Photo -->
        <div class="flex-shrink-0">
          <div class="w-20 h-20 bg-gradient-to-br from-blue-400 to-purple-500 rounded-lg flex items-center justify-center text-white shadow-md overflow-hidden">
            {% if user.profile_photo %}
              <img src="{{ user.profile_photo }}" alt="{{ user.name }}" class="w-full h-full object-cover">
            {% else %}
              <i class="lucide-user text-4xl"></i>
            {% endif %}
          </div>
        </div>

        <!-- Profile Info -->
        <div class="flex-grow">
          <h2 class="text-lg font-bold text-gray-900">{{ user.name|default('ব্যবহারকারী') }}</h2>
          {% if user.phone %}
            <p class="text-sm text-gray-600 mt-1">{{ user.phone }}</p>
          {% endif %}
        </div>
      </div>

      <!-- Professional Status Badge -->
      {% if active_cv_professional_status %}
        <div class="bg-white rounded-lg p-3 flex items-center gap-2">
          <span class="text-sm font-medium text-gray-700">কর্মজীবনের অবস্থা:</span>
          <div class="flex items-center gap-1">
            {% if active_cv_professional_status == 'looking' %}
              <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">
                <i class="lucide-check mr-1"></i>চালু
              </span>
            {% else %}
              <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">
                <i class="lucide-pause mr-1"></i>বিশ্রাম
              </span>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Feature Cards Grid (2 columns) -->
    <div class="grid grid-cols-2 gap-4 mb-8">
      <!-- Edit CV -->
      <div class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition-shadow cursor-pointer" onclick="window.location='/cv/edit'">
        <div class="flex items-start justify-between mb-3">
          <div class="w-12 h-12 bg-teal-100 rounded-full flex items-center justify-center text-teal-600">
            <i class="lucide-edit-2 text-xl"></i>
          </div>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">সিভি এডিট</h3>
        <p class="text-xs text-gray-600">আপনার সিভিতে পরিবর্তন করুন এবং আপডেট রাখুন</p>
      </div>

      <!-- Download CV -->
      <div class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition-shadow cursor-pointer" onclick="window.location='/cv/download'">
        <div class="flex items-start justify-between mb-3">
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-blue-600">
            <i class="lucide-download text-xl"></i>
          </div>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">সিভি ডাউনলোড করুন</h3>
        <p class="text-xs text-gray-600">সিভি ডাউনলোড করে চাকরির আবেদন করুন</p>
      </div>

      <!-- Career Advice -->
      <div class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition-shadow cursor-pointer" onclick="window.location='/advice'">
        <div class="flex items-start justify-between mb-3">
          <div class="w-12 h-12 bg-teal-100 rounded-full flex items-center justify-center text-teal-600">
            <i class="lucide-users text-xl"></i>
          </div>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">ক্যারিয়ার পরামর্শ নিন</h3>
        <p class="text-xs text-gray-600">ক্যারিয়ারের জন্য পরামর্শকের সাথা আপনার আইডিয়া আলোচনা করুন</p>
      </div>

      <!-- CV Template -->
      <div class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition-shadow cursor-pointer" onclick="window.location='/templates'">
        <div class="flex items-start justify-between mb-3">
          <div class="w-12 h-12 bg-teal-100 rounded-full flex items-center justify-center text-teal-600">
            <i class="lucide-layout-template text-xl"></i>
          </div>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">সিভি টেমপ্লেট নিন</h3>
        <p class="text-xs text-gray-600">চমকের টেমপ্লেট দিয়ে আপনার সিভির ডিজাইন করুন</p>
      </div>

      <!-- Job Search -->
      <div class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition-shadow cursor-pointer relative" onclick="window.location='/jobs'">
        <div class="absolute top-3 right-3 bg-teal-600 text-white text-xs font-bold rounded-full w-8 h-8 flex items-center justify-center">300</div>
        <div class="flex items-start justify-between mb-3">
          <div class="w-12 h-12 bg-teal-100 rounded-full flex items-center justify-center text-teal-600">
            <i class="lucide-briefcase text-xl"></i>
          </div>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">চাকরি খুঁজুন</h3>
        <p class="text-xs text-gray-600">বিভিন্ন আপনার অধ্যায়ের চাকরি খুঁজে নিন</p>
      </div>

      <!-- Call Expert -->
      <div class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition-shadow cursor-pointer" onclick="window.location='/expert-call'">
        <div class="flex items-start justify-between mb-3">
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-blue-600">
            <i class="lucide-phone text-xl"></i>
          </div>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">বিশেষজ্ঞকে কল করুন</h3>
        <p class="text-xs text-gray-600">পেশাদার বিশেষজ্ঞদের সাথে কথা বলুন</p>
      </div>

      <!-- Specialist Consultation -->
      <div class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition-shadow cursor-pointer" onclick="window.location='/specialist'">
        <div class="flex items-start justify-between mb-3">
          <div class="w-12 h-12 bg-teal-100 rounded-full flex items-center justify-center text-teal-600">
            <i class="lucide-message-circle text-xl"></i>
          </div>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">বিশেষজ্ঞকে কল করুন</h3>
        <p class="text-xs text-gray-600">পরামর্শের জন্য সাহায্যা করুন এবং উপদেশ পান</p>
      </div>

      <!-- Share CV -->
      <div class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition-shadow cursor-pointer" onclick="window.location='/cv/share'">
        <div class="flex items-start justify-between mb-3">
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-blue-600">
            <i class="lucide-share-2 text-xl"></i>
          </div>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">সিভি শেয়ার করুন</h3>
        <p class="text-xs text-gray-600">হ্রদ আপনার সিভি শেয়ার করুন</p>
      </div>
    </div>
  </div>

  <!-- Fixed Bottom Button -->
  <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200">
    <div class="max-w-2xl mx-auto px-4 py-3">
      <button onclick="window.location='/cv/view'" class="w-full bg-teal-600 hover:bg-teal-700 text-white font-bold py-3 px-6 rounded-xl transition-colors">
        সিভি দেখুন
      </button>
    </div>
  </div>
</div>

<script src="{{ asset('/assets/js/cv-dashboard.js') }}" defer></script>
{% endblock %}
 