{% endblock %}

{% block content %}


<div class="cv-dashboard">
 <div class="cv-header">
 <div class="cv-header-content">
 <div class="cv-header-left">
 <h1>My CVs</h1>
 {% if cvs is not empty %}
 <div class="cv-stats">
 <div class="cv-stat">
 <span class="cv-stat-number">{{ cvs|length }}</span>
 <span class="cv-stat-label">Total CVs</span>
 </div>
 <div class="cv-stat">
 <span class="cv-stat-number">
 {% set active_count = 0 %}
 {% for cv in cvs %}
 {% if cv.is_active == true or cv.is_active == 1 %}
 {% set active_count = active_count + 1 %}
 {% endif %}
 {% endfor %}
 {{ active_count }}
 </span>
 <span class="cv-stat-label">Active</span>
 </div>
 <div class="cv-stat">
 <span class="cv-stat-number">
 {% set draft_count = 0 %}
 {% for cv in cvs %}
 {% if cv.is_active == false or cv.is_active == 0 %}
 {% set draft_count = draft_count + 1 %}
 {% endif %}
 {% endfor %}
 {{ draft_count }}
 </span>
 <span class="cv-stat-label">Drafts</span>
 </div>
 </div>
 {% endif %}
 </div>

 <div class="cv-header-actions">
 <div class="cv-search-box">
 <i class="lucide lucide-search cv-search-icon" style="width:1em;height:1em;"></i>
 <input type="text" class="cv-search-input" placeholder="Search CVs..." id="cvSearch">
 </div>
 <form method="POST" action="/cv" style="margin: 0;">
 <input type="hidden" name="csrf_token" value="{{ csrf_token|default('') }}">
 <button type="submit" class="cv-create-btn">
 <i class="lucide lucide-plus" style="width:1em;height:1em;"></i>
 Create New CV
 </button>
 </form>
 </div>
 </div>

 {% if cvs is not empty %}
 <div class="cv-filters">
 <button class="cv-filter-btn active" data-filter="all">
 <i class="lucide lucide-grid-3x3" style="width:1em;height:1em;"></i> All CVs
 </button>
 <button class="cv-filter-btn" data-filter="active">
 <i class="lucide lucide-check-circle" style="width:1em;height:1em;"></i> Active
 </button>
 <button class="cv-filter-btn" data-filter="draft">
 <i class="lucide lucide-pencil" style="width:1em;height:1em;"></i> Drafts
 </button>
 <button class="cv-filter-btn" data-filter="recent">
 <i class="lucide lucide-clock" style="width:1em;height:1em;"></i> Recent
 </button>
 </div>
 {% endif %}
 </div>

 {% if cvs is empty %}
 <div class="cv-empty">
 <div class="cv-empty-icon">
 <i class="lucide lucide-file-text" style="width:1em;height:1em;"></i>
 </div>
 <h2>Start Building Your Professional CV</h2>
 <p>Create stunning CVs with our modern templates and powerful editor. Stand out from the crowd with professionally designed layouts.</p>

 <div class="cv-empty-features">
 <div class="cv-empty-feature">
 <i class="lucide lucide-palette" style="width:1em;height:1em;"></i>
 <h6>Modern Templates</h6>
 <p>Choose from professionally designed templates</p>
 </div>
 <div class="cv-empty-feature">
 <i class="lucide lucide-zap" style="width:1em;height:1em;"></i>
 <h6>Easy Editing</h6>
 <p>Drag & drop sections with live preview</p>
 </div>
 <div class="cv-empty-feature">
 <i class="lucide lucide-share-2" style="width:1em;height:1em;"></i>
 <h6>Share Instantly</h6>
 <p>Generate shareable links and export PDFs</p>
 </div>
 <div class="cv-empty-feature">
 <i class="lucide lucide-trending-up" style="width:1em;height:1em;"></i>
 <h6>ATS Optimized</h6>
 <p>Designed to pass Applicant Tracking Systems</p>
 </div>
 </div>

 <form method="POST" action="/cv" style="margin: 0;">
 <input type="hidden" name="csrf_token" value="{{ csrf_token|default('') }}">
 <button type="submit" class="cv-create-first-btn">
 <i class="lucide lucide-rocket" style="width:1em;height:1em;"></i>
 Create Your First CV
 </button>
 </form>
 </div>
 {% else %}
 <div class="cv-grid" id="cvGrid">
 {% for cv in cvs %}
 <div class="cv-card" data-status="{{ cv.is_active ? 'active' : 'draft' }}" data-title="{{ cv.title|lower }}">
 <div class="cv-card-header">
 <h5 class="cv-card-title">{{ cv.title }}</h5>
 <div class="cv-card-meta">
 <span>Updated {{ cv.updated_at|date('M d, Y') }}</span>
 </div>
 <span class="cv-badge {{ cv.is_active ? 'inline-flex font-semibold-active' : font-semibold-draft' }}">
 {{ cv.is_active ? 'Active' : 'Draft' }}
 </span>
 </div>

 <div class="cv-card-body">
 <div class="cv-preview">
 <!-- CV Preview Thumbnail -->
 </div>

 <div class="cv-meta">
 <div class="cv-meta-item">
 <i class="lucide lucide-calendar" style="width:1em;height:1em;"></i>
 <span>Created {{ cv.created_at|date('M d, Y') }}</span>
 </div>
 <div class="cv-meta-item">
