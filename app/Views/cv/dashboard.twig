 padding: 0.75rem 1rem;
 border: 2px solid #E5E7EB;
 border-radius: 10px;
 font-size: 0.9rem;
 background: #F9FAFB;
 }
 
 .share-input:focus {
 outline: none;
 border-color: #667eea;
 }
 
 .cv-copy-btn {
 background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
 color: white;
 border: none;
 padding: 0.75rem 1.25rem;
 border-radius: 10px;
 font-weight: 600;
 cursor: pointer;
 transition: all 0.3s ease;
 }
 
 .cv-copy-btn:hover {
