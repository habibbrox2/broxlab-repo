{% extends 'layout.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block extra_styles %}
<style>
 :root {
 --cv-primary: #667eea;
 --cv-secondary: #764ba2;
 --cv-success: #059669;
 --cv-warning: #F59E0B;
 --cv-danger: #DC2626;
 --cv-gray-50: #F9FAFB;
 --cv-gray-100: #F3F4F6;
 --cv-gray-200: #E5E7EB;
 --cv-gray-300: #D1D5DB;
 --cv-gray-400: #9CA3AF;
 --cv-gray-500: #6B7280;
 --cv-gray-600: #4B5563;
 --cv-gray-700: #374151;
 --cv-gray-800: #1F2937;
 --cv-gray-900: #111827;
 }

 .cv-dashboard {
 min-height: 100vh;
 background: linear-gradient(135deg, var(--cv-primary) 0%, var(--cv-secondary) 100%);
 padding: 2rem 1rem;
 position: relative;
 overflow-x: hidden;
 }

 .cv-dashboard::before {
 content: '';
 position: absolute;
 top: 0;
 left: 0;
 right: 0;
 bottom: 0;
 background:
 radial-gradient(circle at 20% 80%, rgba(120, 119, 198, 0.3) 0%, transparent 50%),
 radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
 radial-gradient(circle at 40% 40%, rgba(120, 119, 198, 0.2) 0%, transparent 50%);
 pointer-events: none;
 }

 .cv-header {
 max-width: 1400px;
 margin: 0 auto 3rem;
 position: relative;
 z-index: 2;
 }

 .cv-header-content {
 display: flex;
 justify-content: space-between;
 align-items: center;
 flex-wrap: wrap;
 gap: 1rem;
 }

 .cv-header-left {
 display: flex;
 align-items: center;
 gap: 1.5rem;
 }

 .cv-header h1 {
 color: white;
 font-size: 2.5rem;
 font-weight: 800;
 text-shadow: 0 4px 8px rgba(0,0,0,0.2);
 margin: 0;
 background: linear-gradient(135deg, white 0%, rgba(255,255,255,0.8) 100%);
 -webkit-background-clip: text;
 -webkit-text-fill-color: transparent;
 background-clip: text;
 }

 .cv-stats {
 display: flex;
 gap: 2rem;
 margin-top: 1rem;
 }

 .cv-stat {
 background: rgba(255,255,255,0.1);
 backdrop-filter: blur(10px);
 border: 1px solid rgba(255,255,255,0.2);
 border-radius: 16px;
 padding: 1rem 1.5rem;
 text-align: center;
 transition: all 0.3s ease;
 }

 .cv-stat:hover {
 transform: translateY(-2px);
 background: rgba(255,255,255,0.15);
 }

 .cv-stat-number {
 font-size: 2rem;
 font-weight: 700;
 color: white;
 display: block;
 }

 .cv-stat-label {
 font-size: 0.875rem;
 color: rgba(255,255,255,0.8);
 margin-top: 0.25rem;
 }

 .cv-header-actions {
 display: flex;
 gap: 1rem;
 align-items: center;
 }

 .cv-search-box {
 position: relative;
 width: 300px;
 }

 .cv-search-input {
 width: 100%;
 padding: 0.75rem 1rem 0.75rem 3rem;
 border: none;
 border-radius: 50px;
 background: rgba(255,255,255,0.95);
 backdrop-filter: blur(10px);
 font-size: 0.9rem;
 transition: all 0.3s ease;
 box-shadow: 0 4px 20px rgba(0,0,0,0.1);
 }

 .cv-search-input:focus {
 outline: none;
 box-shadow: 0 8px 30px rgba(0,0,0,0.2);
 background: white;
 }

 .cv-search-icon {
 position: absolute;
 left: 1rem;
 top: 50%;
 transform: translateY(-50%);
 color: var(--cv-gray-400);
 z-index: 1;
 }

 .cv-create-btn {
 background: linear-gradient(135deg, white 0%, rgba(255,255,255,0.9) 100%);
 color: var(--cv-primary);
 border: none;
 padding: 0.875rem 2rem;
 border-radius: 50px;
 font-weight: 600;
 font-size: 0.95rem;
 display: flex;
 align-items: center;
 gap: 0.5rem;
 box-shadow: 0 8px 30px rgba(0,0,0,0.15);
 transition: all 0.3s ease;
 position: relative;
 overflow: hidden;
 }

 .cv-create-btn::before {
 content: '';
 position: absolute;
 top: 0;
 left: -100%;
 width: 100%;
 height: 100%;
 background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
 transition: left 0.5s;
 }

 .cv-create-btn:hover::before {
 left: 100%;
 }

 .cv-create-btn:hover {
 transform: translateY(-3px);
 box-shadow: 0 12px 40px rgba(0,0,0,0.2);
 color: var(--cv-secondary);
 }

 .cv-filters {
 display: flex;
 gap: 0.5rem;
 margin-bottom: 2rem;
 flex-wrap: wrap;
 }

 .cv-filter-btn {
 padding: 0.5rem 1rem;
 border: 1px solid rgba(255,255,255,0.3);
 background: rgba(255,255,255,0.1);
 color: white;
 border-radius: 25px;
 font-size: 0.85rem;
 cursor: pointer;
 transition: all 0.3s ease;
 backdrop-filter: blur(10px);
 }

 .cv-filter-btn:hover,
 .cv-filter-btn.active {
 background: rgba(255,255,255,0.2);
 border-color: rgba(255,255,255,0.5);
 transform: translateY(-1px);
 }

 .cv-grid {
 max-width: 1400px;
 margin: 0 auto;
 display: grid;
 grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
 gap: 2rem;
 position: relative;
 z-index: 2;
 }

 .cv-card {
 background: white;
 border-radius: 24px;
 overflow: hidden;
 box-shadow: 0 20px 60px rgba(0,0,0,0.15);
 transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
 position: relative;
 border: 1px solid rgba(255,255,255,0.2);
 }

 .cv-card::before {
 content: '';
 position: absolute;
 top: 0;
 left: 0;
 right: 0;
 height: 4px;
 background: linear-gradient(90deg, var(--cv-primary), var(--cv-secondary));
 opacity: 0;
 transition: opacity 0.3s ease;
 }

 .cv-card:hover {
 transform: translateY(-8px) scale(1.02);
 box-shadow: 0 30px 80px rgba(0,0,0,0.2);
 }

 .cv-card:hover::before {
 opacity: 1;
 }

 .cv-card-header {
 background: linear-gradient(135deg, var(--cv-primary) 0%, var(--cv-secondary) 100%);
 padding: 1.5rem;
 position: relative;
 overflow: hidden;
 }

 .cv-card-header::before {
 content: '';
 position: absolute;
 top: -50%;
 right: -50%;
 width: 200%;
 height: 200%;
 background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
 animation: float 6s ease-in-out infinite;
 }

 @keyframes float {
 0%, 100% { transform: translate(-50%, -50%) rotate(0deg); }
 50% { transform: translate(-50%, -50%) rotate(180deg); }
 }

 .cv-card-title {
 color: white;
 font-size: 1.25rem;
 font-weight: 700;
 margin: 0 0 0.5rem 0;
 position: relative;
 z-index: 1;
 text-shadow: 0 2px 4px rgba(0,0,0,0.2);
 }

 .cv-card-meta {
 display: flex;
 align-items: center;
 gap: 1rem;
 font-size: 0.85rem;
 color: rgba(255,255,255,0.9);
 position: relative;
 z-index: 1;
 }

 .cv-badge {
 padding: 0.375rem 0.875rem;
 border-radius: 20px;
 font-size: 0.75rem;
 font-weight: 600;
 text-transform: uppercase;
 letter-spacing: 0.5px;
 position: relative;
 z-index: 1;
 }

 .cv-badge-active {
 background: rgba(5, 150, 105, 0.9);
 color: white;
 box-shadow: 0 2px 8px rgba(5, 150, 105, 0.3);
 }

 .cv-badge-draft {
 background: rgba(245, 158, 11, 0.9);
 color: white;
 box-shadow: 0 2px 8px rgba(245, 158, 11, 0.3);
 }

 .cv-card-body {
 padding: 1.5rem;
 }

 .cv-preview {
 height: 120px;
 background: linear-gradient(135deg, var(--cv-gray-100) 0%, var(--cv-gray-200) 100%);
 border-radius: 12px;
 margin-bottom: 1rem;
 display: flex;
 align-items: center;
 justify-content: center;
 position: relative;
 overflow: hidden;
 border: 2px dashed var(--cv-gray-300);
 }

 .cv-preview::before {
 content: 'ðŸ“„';
 font-size: 2rem;
 opacity: 0.5;
 }

 .cv-meta {
 display: flex;
 align-items: center;
 justify-content: space-between;
 color: var(--cv-gray-500);
 font-size: 0.875rem;
 margin-bottom: 1.5rem;
 flex-wrap: wrap;
 gap: 0.5rem;
 }

 .cv-meta-item {
 display: flex;
 align-items: center;
 gap: 0.375rem;
 }

 .cv-meta-item i {
 color: var(--cv-gray-400);
 font-size: 0.8rem;
 }

 .cv-actions {
 display: grid;
 grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
 gap: 0.5rem;
 }

 .cv-action-btn {
 padding: 0.625rem 0.5rem;
 border-radius: 10px;
 font-size: 0.8rem;
 font-weight: 600;
 border: none;
 cursor: pointer;
 transition: all 0.3s ease;
 display: flex;
 flex-direction: column;
 align-items: center;
 gap: 0.25rem;
 text-decoration: none;
 color: inherit;
 min-height: 60px;
 justify-content: center;
 }

 .cv-action-btn i {
 font-size: 1.1rem;
 margin-bottom: 0.125rem;
 }

 .cv-action-edit {
 background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
 color: white;
 }

 .cv-action-edit:hover {
 transform: translateY(-2px);
 box-shadow: 0 8px 25px rgba(79, 70, 229, 0.4);
 }

 .cv-action-preview {
 background: linear-gradient(135deg, #F3F4F6 0%, #E5E7EB 100%);
 color: var(--cv-gray-700);
 }

 .cv-action-preview:hover {
 background: linear-gradient(135deg, #E5E7EB 0%, #D1D5DB 100%);
 transform: translateY(-2px);
 }

 .cv-action-pdf {
 background: linear-gradient(135deg, #FEE2E2 0%, #FECACA 100%);
 color: var(--cv-danger);
 }

 .cv-action-pdf:hover {
 background: linear-gradient(135deg, #FECACA 0%, #FCA5A5 100%);
 transform: translateY(-2px);
 }

 .cv-action-share {
 background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
 color: var(--cv-success);
 }

 .cv-action-share:hover {
 background: linear-gradient(135deg, #A7F3D0 0%, #6EE7B7 100%);
 transform: translateY(-2px);
 }

 .cv-action-delete {
 background: transparent;
 color: var(--cv-danger);
 border: 1px solid #FCA5A5;
 grid-column: span 2;
 }

 .cv-action-delete:hover {
 background: #FEE2E2;
 transform: translateY(-2px);
 }

 .cv-empty {
 max-width: 600px;
 margin: 6rem auto;
 text-align: center;
 background: white;
 border-radius: 32px;
 padding: 4rem 3rem;
 box-shadow: 0 25px 80px rgba(0,0,0,0.15);
 position: relative;
 z-index: 2;
 border: 1px solid rgba(255,255,255,0.2);
 }

 .cv-empty::before {
 content: '';
 position: absolute;
 top: -20px;
 left: -20px;
 right: -20px;
 bottom: -20px;
 background: linear-gradient(135deg, rgba(102,126,234,0.1) 0%, rgba(118,75,162,0.1) 100%);
 border-radius: 40px;
 z-index: -1;
 }

 .cv-empty-icon {
 width: 100px;
 height: 100px;
 background: linear-gradient(135deg, var(--cv-primary) 0%, var(--cv-secondary) 100%);
 border-radius: 28px;
 display: flex;
 align-items: center;
 justify-content: center;
 margin: 0 auto 2rem;
 position: relative;
 box-shadow: 0 20px 60px rgba(102,126,234,0.3);
 }

 .cv-empty-icon::before {
 content: '';
 position: absolute;
 inset: -4px;
 background: linear-gradient(135deg, var(--cv-primary) 0%, var(--cv-secondary) 100%);
 border-radius: 32px;
 opacity: 0.3;
 filter: blur(8px);
 }

 .cv-empty-icon i {
 font-size: 3rem;
 color: white;
 position: relative;
 z-index: 1;
 }

 .cv-empty h2 {
 color: var(--cv-gray-800);
 font-size: 2rem;
 font-weight: 700;
 margin-bottom: 1rem;
 background: linear-gradient(135deg, var(--cv-gray-800) 0%, var(--cv-gray-600) 100%);
 -webkit-background-clip: text;
 -webkit-text-fill-color: transparent;
 background-clip: text;
 }

 .cv-empty p {
 color: var(--cv-gray-500);
 font-size: 1.1rem;
 margin-bottom: 2rem;
 line-height: 1.6;
 }

 .cv-empty-features {
 display: grid;
 grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
 gap: 1.5rem;
 margin-bottom: 2.5rem;
 }

 .cv-empty-feature {
 padding: 1rem;
 background: var(--cv-gray-50);
 border-radius: 12px;
 border: 1px solid var(--cv-gray-200);
 }

 .cv-empty-feature i {
 font-size: 1.5rem;
 color: var(--cv-primary);
 margin-bottom: 0.5rem;
 }

 .cv-empty-feature h6 {
 font-size: 0.9rem;
 font-weight: 600;
 color: var(--cv-gray-800);
 margin-bottom: 0.25rem;
 }

 .cv-empty-feature p {
 font-size: 0.8rem;
 color: var(--cv-gray-500);
 margin: 0;
 }

 .cv-create-first-btn {
 background: linear-gradient(135deg, var(--cv-primary) 0%, var(--cv-secondary) 100%);
 color: white;
 border: none;
 padding: 1rem 3rem;
 border-radius: 50px;
 font-weight: 600;
 font-size: 1.1rem;
 cursor: pointer;
 transition: all 0.3s ease;
 position: relative;
 overflow: hidden;
 box-shadow: 0 8px 30px rgba(102,126,234,0.4);
 }

 .cv-create-first-btn::before {
 content: '';
 position: absolute;
 top: 0;
 left: -100%;
 width: 100%;
 height: 100%;
 background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
 transition: left 0.6s;
 }

 .cv-create-first-btn:hover::before {
 left: 100%;
 }

 .cv-create-first-btn:hover {
 transform: translateY(-3px);
 box-shadow: 0 15px 40px rgba(102,126,234,0.5);
 }

 @media (max-width: 768px) {
 .cv-dashboard {
 padding: 1rem 0.5rem;
 }

 .cv-header h1 {
 font-size: 2rem;
 }

 .cv-stats {
 gap: 1rem;
 }

 .cv-search-box {
 width: 250px;
 }

 .cv-grid {
 grid-template-columns: 1fr;
 gap: 1.5rem;
 }

 .cv-empty {
 margin: 3rem auto;
 padding: 2rem 1.5rem;
 }

 .cv-empty-features {
 grid-template-columns: 1fr;
 }
 }

 @media (max-width: 480px) {
 .cv-header-content {
 flex-direction: column;
 align-items: stretch;
 }

 .cv-header-left {
 justify-content: center;
 }

 .cv-search-box {
 width: 100%;
 order: 3;
 margin-top: 1rem;
 }

 .cv-create-btn {
 width: 100%;
 justify-content: center;
 }
 }
 
