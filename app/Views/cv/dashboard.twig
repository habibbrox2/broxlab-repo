{% extends 'layout.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %}
<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-indigo-50/30 relative overflow-hidden" id="cv-dashboard-container">
  {# Decorative background elements #}
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-gradient-to-br from-indigo-100/40 to-purple-100/30 rounded-full -translate-y-1/2 translate-x-1/4 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-gradient-to-tr from-teal-100/30 to-cyan-100/20 rounded-full translate-y-1/3 -translate-x-1/4 blur-3xl"></div>
  </div>

  {# Safelist all avatar gradient colors for Tailwind detection #}
  <div class="hidden from-blue-400 to-purple-500 from-emerald-400 to-teal-500 from-orange-400 to-rose-500 from-cyan-400 to-blue-500 from-pink-400 to-fuchsia-500 from-amber-400 to-orange-500 from-violet-400 to-indigo-500 from-green-400 to-emerald-500 from-red-400 to-pink-500 from-indigo-400 to-violet-500 from-teal-400 to-cyan-500 from-rose-400 to-red-500 from-sky-400 to-indigo-500 from-lime-400 to-green-500 from-purple-400 to-fuchsia-500 from-yellow-400 to-amber-500" aria-hidden="true"></div>

  {# Header with Back Button #}
  <div class="relative z-10">
    <div class="flex items-center justify-between px-4 py-5 max-w-2xl mx-auto">
      <a href="javascript:history.back()" class="group flex items-center justify-center w-10 h-10 rounded-xl bg-white border border-slate-200 shadow-sm text-slate-600 hover:text-indigo-600 hover:border-indigo-200 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
        <i data-lucide="chevron-left" class="w-5 h-5 transition-transform group-hover:-translate-x-0.5"></i>
      </a>
      <h1 class="text-lg font-bold text-slate-800 tracking-tight">সিভি বিল্ডার</h1>
      <div class="w-10"></div>
    </div>
  </div>

  {# Main Content #}
  <div class="relative z-10 max-w-2xl mx-auto px-4 pb-10">
    {# Profile Card - Enhanced Glassmorphism #}
    <div class="relative bg-white/80 backdrop-blur-xl rounded-2xl p-6 mb-8 shadow-lg shadow-slate-200/60 border border-white/60 overflow-hidden" id="dashboard-view">
      <div class="absolute inset-0 bg-gradient-to-br from-slate-50/50 to-transparent pointer-events-none"></div>
      <div class="relative">
        <div class="flex gap-4 mb-5">
          {# Profile Photo with enhanced styling #}
          <div class="flex-shrink-0">
            <div class="w-20 h-20 bg-gradient-to-br {{ user.avatar_color|default('from-blue-400 to-purple-500') }} rounded-xl flex items-center justify-center text-white shadow-md shadow-indigo-500/30 overflow-hidden ring-4 ring-white/60" title="{{ user.name|default('User') }}">
              {% if user.profile_photo %}
                <img src="{{ user.profile_photo }}" alt="{{ user.name }}" class="w-full h-full object-cover" title="{{ user.name|default('User') }}">
              {% else %}
                {% if user.name|trim is not empty %}
                  {% set name_parts = user.name|split(' ') %}
                  {% set initials = (name_parts|first)|first|upper %}
                  {% if name_parts|length > 1 %}
                    {% set initials = initials ~ (name_parts|last)|first|upper %}
                  {% endif %}
                  <span class="text-2xl font-bold text-white">{{ initials }}</span>
                {% else %}
                  <i data-lucide="user" class="text-3xl text-white/80"></i>
                {% endif %}
              {% endif %}
            </div>
          </div>

          {# Profile Info #}
          <div class="flex-grow flex flex-col justify-center">
            <h2 class="text-lg font-bold text-slate-800 tracking-tight">{{ user.name|default('ব্যবহারকারী') }}</h2>
            {% if user.phone %}
              <p class="text-sm text-slate-500 mt-1 flex items-center gap-1.5">
                <i data-lucide="phone" class="w-3.5 h-3.5 text-slate-400"></i>
                {{ user.phone }}
              </p>
            {% endif %}
            {% if user.email %}
              <p class="text-sm text-slate-500 mt-0.5 flex items-center gap-1.5">
                <i data-lucide="mail" class="w-3.5 h-3.5 text-slate-400"></i>
                {{ user.email }}
              </p>
            {% endif %}
          </div>
        </div>

        {# Professional Status Badge - Enhanced #}
        {% if active_cv_professional_status %}
          <div class="bg-white/70 backdrop-blur-sm rounded-xl p-3.5 border border-slate-100">
            <div class="flex items-center gap-2.5">
              <span class="text-sm font-medium text-slate-600">কর্মজীবনের অবস্থা:</span>
              <div class="flex items-center gap-1.5">
                {% if active_cv_professional_status == 'looking' %}
                  <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-sm shadow-emerald-100/50">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    <i data-lucide="check" class="w-3 h-3"></i>চালু
                  </span>
                {% else %}
                  <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 shadow-sm shadow-blue-100/50">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                    <i data-lucide="pause" class="w-3 h-3"></i>বিশ্রাম
                  </span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    {# Feature Cards Grid - Enhanced with hover animations #}
    <div class="grid grid-cols-2 gap-3.5 mb-8" id="feature-cards">
      {# Edit CV #}
      <a href="{% if cvs|length > 0 %}/cv-builder/builder/{{ cvs[0].id }}{% else %}/cv-builder/new{% endif %}" class="group relative bg-white rounded-2xl p-5 border border-slate-200/80 hover:border-indigo-300 hover:shadow-xl hover:shadow-indigo-100/50 hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative">
          <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-teal-100 to-emerald-100 rounded-xl flex items-center justify-center text-teal-600 shadow-sm ring-1 ring-teal-200/50 group-hover:scale-110 group-hover:shadow-md group-hover:shadow-teal-200/40 transition-all duration-300">
              <i data-lucide="edit-2" class="w-5 h-5"></i>
            </div>
          </div>
          <h3 class="font-bold text-slate-800 text-sm mb-1.5 group-hover:text-indigo-700 transition-colors">সিভি এডিট</h3>
          <p class="text-xs text-slate-500 leading-relaxed">আপনার সিভিতে পরিবর্তন করুন এবং আপডেট রাখুন</p>
        </div>
      </a>

      {# Download CV #}
      <a href="/cv-builder/download" class="group relative bg-white rounded-2xl p-5 border border-slate-200/80 hover:border-blue-300 hover:shadow-xl hover:shadow-blue-100/50 hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-50/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative">
          <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-blue-100 to-indigo-100 rounded-xl flex items-center justify-center text-blue-600 shadow-sm ring-1 ring-blue-200/50 group-hover:scale-110 group-hover:shadow-md group-hover:shadow-blue-200/40 transition-all duration-300">
              <i data-lucide="download" class="w-5 h-5"></i>
            </div>
          </div>
          <h3 class="font-bold text-slate-800 text-sm mb-1.5 group-hover:text-indigo-700 transition-colors">সিভি ডাউনলোড করুন</h3>
          <p class="text-xs text-slate-500 leading-relaxed">সিভি ডাউনলোড করে চাকরির আবেদন করুন</p>
        </div>
      </a>

      {# CV Template #}
      <a href="/cv-builder/templates" class="group relative bg-white rounded-2xl p-5 border border-slate-200/80 hover:border-purple-300 hover:shadow-xl hover:shadow-purple-100/50 hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-purple-50/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative">
          <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-purple-100 to-pink-100 rounded-xl flex items-center justify-center text-purple-600 shadow-sm ring-1 ring-purple-200/50 group-hover:scale-110 group-hover:shadow-md group-hover:shadow-purple-200/40 transition-all duration-300">
              <i data-lucide="layout-template" class="w-5 h-5"></i>
            </div>
          </div>
          <h3 class="font-bold text-slate-800 text-sm mb-1.5 group-hover:text-indigo-700 transition-colors">সিভি টেমপ্লেট নিন</h3>
          <p class="text-xs text-slate-500 leading-relaxed">চমকের টেমপ্লেট দিয়ে আপনার সিভির ডিজাইন করুন</p>
        </div>
      </a>

      {# Share CV #}
      <a href="/cv-builder/share" class="group relative bg-white rounded-2xl p-5 border border-slate-200/80 hover:border-cyan-300 hover:shadow-xl hover:shadow-cyan-100/50 hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-cyan-50/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative">
          <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-cyan-100 to-blue-100 rounded-xl flex items-center justify-center text-cyan-600 shadow-sm ring-1 ring-cyan-200/50 group-hover:scale-110 group-hover:shadow-md group-hover:shadow-cyan-200/40 transition-all duration-300">
              <i data-lucide="share-2" class="w-5 h-5"></i>
            </div>
          </div>
          <h3 class="font-bold text-slate-800 text-sm mb-1.5 group-hover:text-indigo-700 transition-colors">সিভি শেয়ার করুন</h3>
          <p class="text-xs text-slate-500 leading-relaxed">হ্রদ আপনার সিভি শেয়ার করুন</p>
        </div>
      </a>

      {# View CV (full-width CTA) - Enhanced #}
      <a href="/cv-builder/view" class="col-span-2 group relative bg-gradient-to-r from-teal-50 via-white to-indigo-50/50 border-2 border-teal-200/80 rounded-2xl p-5 hover:shadow-xl hover:shadow-teal-100/50 hover:border-teal-300 hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r from-teal-100/20 to-indigo-100/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative flex items-center gap-5">
          <div class="w-14 h-14 bg-gradient-to-br from-teal-100 to-emerald-100 rounded-xl flex items-center justify-center text-teal-600 shadow-sm ring-1 ring-teal-200/50 group-hover:scale-110 group-hover:shadow-md transition-all duration-300 flex-shrink-0">
            <i data-lucide="eye" class="w-6 h-6"></i>
          </div>
          <div class="flex-grow">
            <h3 class="font-bold text-slate-800 text-sm mb-1 group-hover:text-indigo-700 transition-colors">সিভি দেখুন</h3>
            <p class="text-xs text-slate-500 leading-relaxed">আপনার তৈরি সিভি প্রিভিউ ও ডাউনলোড করুন</p>
          </div>
          <i data-lucide="arrow-right" class="w-5 h-5 text-slate-300 group-hover:text-teal-500 group-hover:translate-x-1 transition-all duration-300 flex-shrink-0"></i>
        </div>
      </a>
    </div>

    {# CV List Section - If there are existing CVs #}
    {% if cvs is defined and cvs|length > 0 %}
    <div class="space-y-3">
      <h3 class="text-sm font-semibold text-slate-600 uppercase tracking-wide flex items-center gap-2">
        <i data-lucide="briefcase" class="w-4 h-4"></i>
        Your CVs
      </h3>
      {% for cv in cvs %}
      <div class="group bg-white/80 backdrop-blur-sm rounded-xl p-4 border border-slate-200/70 hover:border-indigo-300 hover:shadow-lg hover:shadow-indigo-50/80 transition-all duration-300" data-cv-id="{{ cv.id }}">
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 bg-gradient-to-br from-indigo-100 to-purple-100 rounded-lg flex items-center justify-center text-indigo-600 flex-shrink-0">
            <i data-lucide="file-text" class="w-5 h-5"></i>
          </div>
          <div class="flex-grow min-w-0">
            <h4 class="font-semibold text-slate-800 text-sm truncate group-hover:text-indigo-700 transition-colors">{{ cv.title }}</h4>
            <p class="text-xs text-slate-500 mt-0.5 flex items-center gap-2">
              <span class="inline-flex items-center gap-1">
                <i data-lucide="calendar" class="w-3 h-3"></i>
                {{ cv.updated_at|date('M j, Y') }}
              </span>
              {% if cv.view_count is defined %}
              <span class="inline-flex items-center gap-1">
                <i data-lucide="eye" class="w-3 h-3"></i>
                {{ cv.view_count }}
              </span>
              {% endif %}
            </p>
          </div>
          <div class="flex items-center gap-2">
            <a href="/cv-builder/builder/{{ cv.id }}" class="p-2 rounded-lg bg-slate-50 text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 transition-all duration-200" title="Edit">
              <i data-lucide="pencil" class="w-4 h-4"></i>
            </a>
            <a href="/cv-builder/{{ cv.id }}/preview" class="p-2 rounded-lg bg-slate-50 text-slate-600 hover:bg-teal-50 hover:text-teal-600 transition-all duration-200" title="Preview">
              <i data-lucide="eye" class="w-4 h-4"></i>
            </a>
            <button data-action="delete-cv" data-cv-id="{{ cv.id }}" data-cv-title="{{ cv.title }}" class="p-2 rounded-lg bg-slate-50 text-slate-600 hover:bg-red-50 hover:text-red-600 transition-all duration-200" title="Delete">
              <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>

<script src="{{ asset('/assets/js/cv-dashboard.js') }}" defer></script>
{% endblock %}
