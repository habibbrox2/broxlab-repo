 }
 
 .share-modal h5 {
 color: #1F2937;
 font-size: 1.25rem;
 margin-bottom: 0.5rem;
 }

 /* Hide legacy/mojibake headings if present */
 .share-modal h5:not(.share-modal-title) {
 display: none;
 }
 
 .share-modal p {
 color: #6B7280;
 margin-bottom: 1rem;
 }
 
 .share-input-group {
