 padding: 1rem 1.5rem;
 border-radius: 12px;
 box-shadow: 0 10px 30px rgba(0,0,0,0.2);
 transform: translateY(100px);
 opacity: 0;
 transition: all 0.3s ease;
 z-index: 9999;
 }
 
 .toast.show {
 transform: translateY(0);
 opacity: 1;
 }
 
 .toast.success {
 background: #059669;
 }
 
 .toast.error {
 background: #DC2626;
 }
