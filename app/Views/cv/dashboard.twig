 <span>Edit</span>
 </a>
 <a href="/cv/{{ cv.id }}/preview" target="_blank" class="cv-action-btn cv-action-preview" title="Preview CV">
 <i class="lucide lucide-eye" style="width:1em;height:1em;"></i>
 <span>View</span>
 </a>
 <a href="/cv/{{ cv.id }}/export" class="cv-action-btn cv-action-pdf" title="Export as PDF">
 <i class="lucide lucide-download" style="width:1em;height:1em;"></i>
 <span>PDF</span>
 </a>
 <button onclick="shareCv({{ cv.id }})" class="cv-action-btn cv-action-share" title="Share CV">
 <i class="lucide lucide-share-2" style="width:1em;height:1em;"></i>
 <span>Share</span>
 </button>
 <button onclick="deleteCv({{ cv.id }})" class="cv-action-btn cv-action-delete" title="Delete CV">
