{% extends 'layout.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %}
{# Safelist all avatar gradient colors for Tailwind detection #}
<div class="hidden from-blue-400 to-purple-500 from-emerald-400 to-teal-500 from-orange-400 to-rose-500 from-cyan-400 to-blue-500 from-pink-400 to-fuchsia-500 from-amber-400 to-orange-500 from-violet-400 to-indigo-500 from-green-400 to-emerald-500 from-red-400 to-pink-500 from-indigo-400 to-violet-500 from-teal-400 to-cyan-500 from-rose-400 to-red-500 from-sky-400 to-indigo-500 from-lime-400 to-green-500 from-purple-400 to-fuchsia-500 from-yellow-400 to-amber-500" aria-hidden="true"></div>
<div class="min-h-screen bg-white pb-6" id="cv-dashboard-container">
  <!-- Header with Back Button -->
  <div class="bg-white border-b border-gray-200 sticky top-0 z-10">
    <div class="flex items-center justify-between px-4 py-4 max-w-2xl mx-auto">
      <a href="javascript:history.back()" class="text-gray-700 hover:text-gray-900">
        <i data-lucide="chevron-left" class="text-2xl"></i>
      </a>
      <h1 class="text-xl font-bold text-gray-900" id="page-title">সিভি বিল্ডার</h1>
      <div class="w-6"></div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-2xl mx-auto px-4 py-6">
    <!-- Profile Card -->
    <div class="bg-gray-50 rounded-xl p-6 mb-6" id="dashboard-view">
      <div class="flex gap-4 mb-6">
        <!-- Profile Photo -->
        <div class="flex-shrink-0">
          <div class="w-20 h-20 bg-gradient-to-br {{ user.avatar_color|default('from-blue-400 to-purple-500') }} rounded-lg flex items-center justify-center text-white shadow-md overflow-hidden" title="{{ user.name|default('User') }}">
            {% if user.profile_photo %}
              <img src="{{ user.profile_photo }}" alt="{{ user.name }}" class="w-full h-full object-cover" title="{{ user.name|default('User') }}">
            {% else %}
              {% if user.name|trim is not empty %}
                {% set name_parts = user.name|split(' ') %}
                {% set initials = (name_parts|first)|first|upper %}
                {% if name_parts|length > 1 %}
                  {% set initials = initials ~ (name_parts|last)|first|upper %}
                {% endif %}
                <span class="text-2xl font-bold text-white">{{ initials }}</span>
              {% else %}
                <i data-lucide="user" class="text-4xl"></i>
              {% endif %}
            {% endif %}
          </div>
        </div>

        <!-- Profile Info -->
        <div class="flex-grow">
          <h2 class="text-lg font-bold text-gray-900">{{ user.name|default('ব্যবহারকারী') }}</h2>
          {% if user.phone %}
            <p class="text-sm text-gray-600 mt-1">{{ user.phone }}</p>
          {% endif %}
        </div>
      </div>

      <!-- Professional Status Badge -->
      {% if active_cv_professional_status %}
        <div class="bg-white rounded-lg p-3 flex items-center gap-2">
          <span class="text-sm font-medium text-gray-700">কর্মজীবনের অবস্থা:</span>
          <div class="flex items-center gap-1">
            {% if active_cv_professional_status == 'looking' %}
              <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">
                <i data-lucide="check" class="mr-1"></i>চালু
              </span>
            {% else %}
              <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">
                <i data-lucide="pause" class="mr-1"></i>বিশ্রাম
              </span>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Feature Cards Grid (2 columns) -->
    <div class="grid grid-cols-2 gap-4 mb-8" id="feature-cards">
      <!-- Edit CV -->
      <div class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition-shadow cursor-pointer" onclick="window.location='{% if cvs|length > 0 %}/cv-builder/builder/{{ cvs[0].id }}{% else %}/cv-builder/new{% endif %}'">
        <div class="flex items-start justify-between mb-3">
          <div class="w-12 h-12 bg-teal-100 rounded-full flex items-center justify-center text-teal-600">
            <i data-lucide="edit-2" class="text-xl"></i>
          </div>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">সিভি এডিট</h3>
        <p class="text-xs text-gray-600">আপনার সিভিতে পরিবর্তন করুন এবং আপডেট রাখুন</p>
      </div>

      <!-- Download CV -->
      <div class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition-shadow cursor-pointer" onclick="window.location='/cv-builder/download'">
        <div class="flex items-start justify-between mb-3">
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-blue-600">
            <i data-lucide="download" class="text-xl"></i>
          </div>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">সিভি ডাউনলোড করুন</h3>
        <p class="text-xs text-gray-600">সিভি ডাউনলোড করে চাকরির আবেদন করুন</p>
      </div>


      <!-- CV Template -->
      <div class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition-shadow cursor-pointer" onclick="window.location='/cv-builder/templates'">
        <div class="flex items-start justify-between mb-3">
          <div class="w-12 h-12 bg-teal-100 rounded-full flex items-center justify-center text-teal-600">
            <i data-lucide="layout-template" class="text-xl"></i>
          </div>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">সিভি টেমপ্লেট নিন</h3>
        <p class="text-xs text-gray-600">চমকের টেমপ্লেট দিয়ে আপনার সিভির ডিজাইন করুন</p>
      </div>


      <!-- Share CV -->
      <div class="bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md transition-shadow cursor-pointer" onclick="window.location='/cv-builder/share'">
        <div class="flex items-start justify-between mb-3">
          <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-blue-600">
            <i data-lucide="share-2" class="text-xl"></i>
          </div>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">সিভি শেয়ার করুন</h3>
        <p class="text-xs text-gray-600">হ্রদ আপনার সিভি শেয়ার করুন</p>
      </div>

      <!-- View CV (full-width CTA) -->
      <div class="col-span-2 bg-gradient-to-r from-teal-50 to-white border-2 border-teal-200 rounded-xl p-4 hover:shadow-md transition-shadow cursor-pointer hover:border-teal-300" onclick="window.location='/cv-builder/view'">
        <div class="flex items-start justify-between mb-3">
          <div class="w-12 h-12 bg-teal-100 rounded-full flex items-center justify-center text-teal-600">
            <i data-lucide="eye" class="text-xl"></i>
          </div>
        </div>
        <h3 class="font-bold text-gray-900 text-sm mb-1">সিভি দেখুন</h3>
        <p class="text-xs text-gray-600">আপনার তৈরি সিভি প্রিভিউ ও ডাউনলোড করুন</p>
      </div>
    </div>
  </div>
</div>




<script src="{{ asset('/assets/js/cv-dashboard.js') }}" defer></script>
{% endblock %}
