{% extends 'layout.twig' %}

{% block title %}{{ cv.title|default('View CV') }}{% endblock %}

{% block extra_styles %}
<style>
    :root {
        --cv-view-primary: #4F46E5;
        --cv-view-secondary: #7C3AED;
        --cv-view-success: #059669;
        --cv-view-warning: #F59E0B;
        --cv-view-danger: #DC2626;
        --cv-view-gray-50: #F9FAFB;
        --cv-view-gray-100: #F3F4F6;
        --cv-view-gray-200: #E5E7EB;
        --cv-view-gray-300: #D1D5DB;
        --cv-view-gray-400: #9CA3AF;
        --cv-view-gray-500: #6B7280;
        --cv-view-gray-600: #4B5563;
        --cv-view-gray-700: #374151;
        --cv-view-gray-800: #1F2937;
        --cv-view-gray-900: #111827;
    }

    .cv-view-page {
        min-height: 100vh;
        background: linear-gradient(135deg, var(--cv-view-gray-50) 0%, var(--cv-view-gray-100) 100%);
        padding: 2rem 1rem;
    }

    .cv-view-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .cv-view-header {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        border: 1px solid var(--cv-view-gray-200);
    }

    .cv-view-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--cv-view-gray-800);
        margin-bottom: 0.5rem;
    }

    .cv-view-meta {
        display: flex;
        align-items: center;
        gap: 2rem;
        color: var(--cv-view-gray-500);
        font-size: 0.9rem;
    }

    .cv-view-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
    }

    .cv-action-btn {
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        min-width: 120px;
        justify-content: center;
    }

    .cv-action-btn-primary {
        background: linear-gradient(135deg, var(--cv-view-primary) 0%, var(--cv-view-secondary) 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(79,70,229,0.3);
    }

    .cv-action-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(79,70,229,0.4);
    }

    .cv-action-btn-secondary {
        background: white;
        color: var(--cv-view-gray-700);
        border: 2px solid var(--cv-view-gray-200);
    }

    .cv-action-btn-secondary:hover {
        background: var(--cv-view-gray-50);
        border-color: var(--cv-view-gray-300);
        transform: translateY(-1px);
    }

    .cv-action-btn-success {
        background: var(--cv-view-success);
        color: white;
    }

    .cv-action-btn-success:hover {
        background: #047857;
        transform: translateY(-1px);
    }

    .cv-action-btn-warning {
        background: var(--cv-view-warning);
        color: white;
    }

    .cv-action-btn-warning:hover {
        background: #D97706;
        transform: translateY(-1px);
    }

    .cv-content-wrapper {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 2rem;
        align-items: start;
    }

    .cv-preview-container {
        background: white;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        border: 1px solid var(--cv-view-gray-200);
        overflow: hidden;
        position: relative;
    }

    .cv-preview-header {
        background: linear-gradient(135deg, var(--cv-view-primary) 0%, var(--cv-view-secondary) 100%);
        color: white;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .cv-preview-title {
        font-weight: 600;
        font-size: 1rem;
    }

    .cv-preview-controls {
        display: flex;
        gap: 0.5rem;
    }

    .cv-zoom-btn {
        background: rgba(255,255,255,0.2);
        border: none;
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .cv-zoom-btn:hover {
        background: rgba(255,255,255,0.3);
    }

    .cv-preview-content {
        padding: 0;
        overflow: auto;
        max-height: 80vh;
    }

    .cv-preview-iframe {
        width: 100%;
        height: 100%;
        min-height: 600px;
        border: none;
        background: white;
    }

    .cv-sidebar {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        border: 1px solid var(--cv-view-gray-200);
        position: sticky;
        top: 2rem;
    }

    .cv-sidebar-section {
        margin-bottom: 2rem;
    }

    .cv-sidebar-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--cv-view-gray-800);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .cv-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .cv-stat {
        text-align: center;
        padding: 1rem;
        background: var(--cv-view-gray-50);
        border-radius: 8px;
        border: 1px solid var(--cv-view-gray-200);
    }

    .cv-stat-number {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--cv-view-primary);
        display: block;
    }

    .cv-stat-label {
        font-size: 0.8rem;
        color: var(--cv-view-gray-600);
        margin-top: 0.25rem;
    }

    .cv-share-section {
        margin-bottom: 2rem;
    }

    .cv-share-input {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid var(--cv-view-gray-300);
        border-radius: 8px;
        font-size: 0.9rem;
        margin-bottom: 1rem;
        background: var(--cv-view-gray-50);
    }

    .cv-share-buttons {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .cv-share-btn {
        flex: 1;
        padding: 0.5rem;
        border: 1px solid var(--cv-view-gray-300);
        border-radius: 6px;
        background: white;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--cv-view-gray-600);
    }

    .cv-share-btn:hover {
        background: var(--cv-view-gray-50);
        border-color: var(--cv-view-gray-400);
    }

    .cv-share-btn i {
        font-size: 1.1rem;
    }

    .cv-recent-activity {
        max-height: 300px;
        overflow-y: auto;
    }

    .cv-activity-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--cv-view-gray-100);
    }

    .cv-activity-item:last-child {
        border-bottom: none;
    }

    .cv-activity-icon {
        width: 32px;
        height: 32px;
        background: var(--cv-view-primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.8rem;
    }

    .cv-activity-content {
        flex: 1;
    }

    .cv-activity-text {
        font-size: 0.85rem;
        color: var(--cv-view-gray-700);
        margin-bottom: 0.25rem;
    }

    .cv-activity-time {
        font-size: 0.75rem;
        color: var(--cv-view-gray-500);
    }

    .cv-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 400px;
        color: var(--cv-view-gray-500);
    }

    .cv-loading-spinner {
        width: 40px;
        height: 40px;
        border: 4px solid var(--cv-view-gray-200);
        border-top: 4px solid var(--cv-view-primary);
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-right: 1rem;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @media (max-width: 768px) {
        .cv-content-wrapper {
            grid-template-columns: 1fr;
        }

        .cv-sidebar {
            position: static;
        }

        .cv-view-actions {
            flex-direction: column;
        }

        .cv-action-btn {
            width: 100%;
        }

        .cv-stats {
            grid-template-columns: 1fr;
        }
    }

    @media print {
        .cv-view-page,
        .cv-view-header,
        .cv-sidebar,
        .cv-preview-header {
            display: none !important;
        }

        .cv-preview-container {
            box-shadow: none;
            border: none;
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="cv-view-page">
    <div class="cv-view-container">
        <!-- Header Section -->
        <div class="cv-view-header">
            <h1 class="cv-view-title">{{ cv.title|default('My CV') }}</h1>
            <div class="cv-view-meta">
                <span><i class="bi bi-calendar"></i> Created {{ cv.created_at|date('M j, Y')|default('Recently') }}</span>
                <span><i class="bi bi-clock"></i> Updated {{ cv.updated_at|date('M j, Y')|default('Recently') }}</span>
                <span><i class="bi bi-eye"></i> {{ cv.views|default(0) }} views</span>
            </div>

            <div class="cv-view-actions">
                <a href="/cv/{{ cv.id }}/edit" class="cv-action-btn cv-action-btn-primary">
                    <i class="bi bi-pencil"></i>
                    Edit CV
                </a>
                <button onclick="downloadCV()" class="cv-action-btn cv-action-btn-success">
                    <i class="bi bi-download"></i>
                    Download PDF
                </button>
                <button onclick="shareCV()" class="cv-action-btn cv-action-btn-secondary">
                    <i class="bi bi-share"></i>
                    Share
                </button>
                <button onclick="duplicateCV()" class="cv-action-btn cv-action-btn-warning">
                    <i class="bi bi-copy"></i>
                    Duplicate
                </button>
                <button onclick="deleteCV()" class="cv-action-btn cv-action-btn-secondary" style="background: var(--cv-view-danger); color: white;">
                    <i class="bi bi-trash"></i>
                    Delete
                </button>
            </div>
        </div>

        <!-- Main Content -->
        <div class="cv-content-wrapper">
            <!-- CV Preview -->
            <div class="cv-preview-container">
                <div class="cv-preview-header">
                    <span class="cv-preview-title">CV Preview</span>
                    <div class="cv-preview-controls">
                        <button onclick="zoomOut()" class="cv-zoom-btn" title="Zoom Out">
                            <i class="bi bi-zoom-out"></i>
                        </button>
                        <span id="zoomLevel">100%</span>
                        <button onclick="zoomIn()" class="cv-zoom-btn" title="Zoom In">
                            <i class="bi bi-zoom-in"></i>
                        </button>
                        <button onclick="resetZoom()" class="cv-zoom-btn" title="Reset Zoom">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                </div>
                <div class="cv-preview-content">
                    <div id="cvLoading" class="cv-loading">
                        <div class="cv-loading-spinner"></div>
                        <span>Loading CV preview...</span>
                    </div>
                    <iframe id="cvPreview" class="cv-preview-iframe" style="display: none;"></iframe>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="cv-sidebar">
                <!-- Statistics -->
                <div class="cv-sidebar-section">
                    <h3 class="cv-sidebar-title">
                        <i class="bi bi-bar-chart"></i>
                        Statistics
                    </h3>
                    <div class="cv-stats">
                        <div class="cv-stat">
                            <span class="cv-stat-number">{{ cv.sections|length|default(0) }}</span>
                            <span class="cv-stat-label">Sections</span>
                        </div>
                        <div class="cv-stat">
                            <span class="cv-stat-number">{{ cv.items|length|default(0) }}</span>
                            <span class="cv-stat-label">Items</span>
                        </div>
                        <div class="cv-stat">
                            <span class="cv-stat-number">{{ cv.word_count|default(0) }}</span>
                            <span class="cv-stat-label">Words</span>
                        </div>
                        <div class="cv-stat">
                            <span class="cv-stat-number">{{ cv.completeness|default(0) }}%</span>
                            <span class="cv-stat-label">Complete</span>
                        </div>
                    </div>
                </div>

                <!-- Share Section -->
                <div class="cv-share-section">
                    <h3 class="cv-sidebar-title">
                        <i class="bi bi-share"></i>
                        Share CV
                    </h3>
                    <input type="text" id="shareUrl" class="cv-share-input" readonly
                           value="{{ app_url }}/cv/{{ cv.id }}/public">
                    <div class="cv-share-buttons">
                        <button onclick="copyShareUrl()" class="cv-share-btn" title="Copy Link">
                            <i class="bi bi-clipboard"></i>
                        </button>
                        <button onclick="shareToLinkedIn()" class="cv-share-btn" title="Share on LinkedIn">
                            <i class="bi bi-linkedin"></i>
                        </button>
                        <button onclick="shareToTwitter()" class="cv-share-btn" title="Share on Twitter">
                            <i class="bi bi-twitter"></i>
                        </button>
                        <button onclick="shareViaEmail()" class="cv-share-btn" title="Share via Email">
                            <i class="bi bi-envelope"></i>
                        </button>
                    </div>
                </div>

                <!-- Recent Activity -->
                <div class="cv-sidebar-section">
                    <h3 class="cv-sidebar-title">
                        <i class="bi bi-activity"></i>
                        Recent Activity
                    </h3>
                    <div class="cv-recent-activity">
                        {% for activity in cv.activities|default([]) %}
                        <div class="cv-activity-item">
                            <div class="cv-activity-icon">
                                <i class="bi bi-{{ activity.icon|default('circle') }}"></i>
                            </div>
                            <div class="cv-activity-content">
                                <div class="cv-activity-text">{{ activity.description }}</div>
                                <div class="cv-activity-time">{{ activity.time|default('Recently') }}</div>
                            </div>
                        </div>
                        {% endfor %}
                        {% if cv.activities|default([])|length == 0 %}
                        <div class="cv-activity-item">
                            <div class="cv-activity-icon">
                                <i class="bi bi-plus-circle"></i>
                            </div>
                            <div class="cv-activity-content">
                                <div class="cv-activity-text">CV created</div>
                                <div class="cv-activity-time">{{ cv.created_at|date('M j, Y')|default('Recently') }}</div>
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="cv-sidebar-section">
                    <h3 class="cv-sidebar-title">
                        <i class="bi bi-lightning"></i>
                        Quick Actions
                    </h3>
                    <div style="display: grid; gap: 0.5rem;">
                        <button onclick="optimizeForATS()" class="cv-action-btn cv-action-btn-secondary" style="width: 100%; justify-content: flex-start;">
                            <i class="bi bi-robot"></i>
                            Optimize for ATS
                        </button>
                        <button onclick="checkGrammar()" class="cv-action-btn cv-action-btn-secondary" style="width: 100%; justify-content: flex-start;">
                            <i class="bi bi-check-circle"></i>
                            Check Grammar
                        </button>
                        <button onclick="generateCoverLetter()" class="cv-action-btn cv-action-btn-secondary" style="width: 100%; justify-content: flex-start;">
                            <i class="bi bi-file-text"></i>
                            Generate Cover Letter
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Share Modal -->
<div class="modal fade" id="shareModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Share Your CV</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Share Link</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="shareLinkInput" readonly>
                        <button class="btn btn-outline-secondary" onclick="copyShareLink()">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>
                <div class="d-grid gap-2">
                    <button onclick="shareToLinkedIn()" class="btn btn-primary">
                        <i class="bi bi-linkedin"></i> Share on LinkedIn
                    </button>
                    <button onclick="shareToTwitter()" class="btn btn-info">
                        <i class="bi bi-twitter"></i> Share on Twitter
                    </button>
                    <button onclick="shareViaEmail()" class="btn btn-secondary">
                        <i class="bi bi-envelope"></i> Share via Email
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// CV View Functionality
let currentZoom = 1;
const zoomStep = 0.1;
const minZoom = 0.5;
const maxZoom = 2;

document.addEventListener('DOMContentLoaded', function() {
    loadCVPreview();
    updateZoomDisplay();
});

function loadCVPreview() {
    const iframe = document.getElementById('cvPreview');
    const loading = document.getElementById('cvLoading');

    // Load the CV content (you would replace this with actual CV rendering logic)
    iframe.srcdoc = `
        <!DOCTYPE html>
        <html>
        <head>
            <style>
                body { font-family: Arial, sans-serif; margin: 20px; }
                .cv-header { text-align: center; margin-bottom: 30px; }
                .cv-name { font-size: 24px; font-weight: bold; }
                .cv-section { margin-bottom: 20px; }
                .cv-section-title { font-weight: bold; border-bottom: 1px solid #ccc; padding-bottom: 5px; }
            </style>
        </head>
        <body>
            <div class="cv-header">
                <div class="cv-name">{{ cv.title|default('My CV') }}</div>
            </div>
            <div class="cv-section">
                <div class="cv-section-title">Professional Summary</div>
                <p>This is a preview of your CV. The actual content will be rendered here.</p>
            </div>
            <div class="cv-section">
                <div class="cv-section-title">Experience</div>
                <p>Your work experience will appear here.</p>
            </div>
            <div class="cv-section">
                <div class="cv-section-title">Education</div>
                <p>Your education details will appear here.</p>
            </div>
        </body>
        </html>
    `;

    iframe.onload = function() {
        loading.style.display = 'none';
        iframe.style.display = 'block';
    };
}

function zoomIn() {
    if (currentZoom < maxZoom) {
        currentZoom += zoomStep;
        updateZoom();
    }
}

function zoomOut() {
    if (currentZoom > minZoom) {
        currentZoom -= zoomStep;
        updateZoom();
    }
}

function resetZoom() {
    currentZoom = 1;
    updateZoom();
}

function updateZoom() {
    const iframe = document.getElementById('cvPreview');
    iframe.style.transform = `scale(${currentZoom})`;
    iframe.style.transformOrigin = 'top left';
    updateZoomDisplay();
}

function updateZoomDisplay() {
    const zoomLevel = document.getElementById('zoomLevel');
    zoomLevel.textContent = Math.round(currentZoom * 100) + '%';
}

function downloadCV() {
    // Implement PDF download functionality
    alert('PDF download functionality would be implemented here');
}

function shareCV() {
    const modal = new bootstrap.Modal(document.getElementById('shareModal'));
    document.getElementById('shareLinkInput').value = document.getElementById('shareUrl').value;
    modal.show();
}

function copyShareUrl() {
    const urlInput = document.getElementById('shareUrl');
    urlInput.select();
    document.execCommand('copy');

    // Show feedback
    const btn = event.target.closest('.cv-share-btn');
    const originalIcon = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-check"></i>';
    btn.style.background = 'var(--cv-view-success)';
    btn.style.color = 'white';

    setTimeout(() => {
        btn.innerHTML = originalIcon;
        btn.style.background = '';
        btn.style.color = '';
    }, 2000);
}

function copyShareLink() {
    const input = document.getElementById('shareLinkInput');
    input.select();
    document.execCommand('copy');

    // Show feedback
    const btn = event.target;
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-check"></i> Copied!';
    btn.classList.remove('btn-outline-secondary');
    btn.classList.add('btn-success');

    setTimeout(() => {
        btn.innerHTML = originalText;
        btn.classList.remove('btn-success');
        btn.classList.add('btn-outline-secondary');
    }, 2000);
}

function shareToLinkedIn() {
    const url = encodeURIComponent(document.getElementById('shareUrl').value);
    const title = encodeURIComponent('Check out my CV');
    window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${url}&title=${title}`, '_blank');
}

function shareToTwitter() {
    const url = encodeURIComponent(document.getElementById('shareUrl').value);
    const text = encodeURIComponent('Check out my professional CV');
    window.open(`https://twitter.com/intent/tweet?url=${url}&text=${text}`, '_blank');
}

function shareViaEmail() {
    const subject = encodeURIComponent('My Professional CV');
    const body = encodeURIComponent(`Hi,\n\nI'd like to share my professional CV with you:\n\n${document.getElementById('shareUrl').value}\n\nBest regards`);
    window.location.href = `mailto:?subject=${subject}&body=${body}`;
}

function duplicateCV() {
    if (confirm('Are you sure you want to duplicate this CV?')) {
        // Implement duplicate functionality
        alert('CV duplication functionality would be implemented here');
    }
}

function deleteCV() {
    if (confirm('Are you sure you want to delete this CV? This action cannot be undone.')) {
        // Implement delete functionality
        alert('CV deletion functionality would be implemented here');
    }
}

function optimizeForATS() {
    alert('ATS optimization functionality would be implemented here');
}

function checkGrammar() {
    alert('Grammar check functionality would be implemented here');
}

function generateCoverLetter() {
    alert('Cover letter generation functionality would be implemented here');
}
</script>
{% endblock %}