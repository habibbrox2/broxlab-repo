{% extends 'layout.twig' %}

{% block title %}{{ cv.title|default('View CV') }}{% endblock %}

{% block extra_styles %}
<style>
 :root {
 --cv-view-primary: #4F46E5;
 --cv-view-secondary: #7C3AED;
 --cv-view-success: #059669;
 --cv-view-warning: #F59E0B;
 --cv-view-danger: #DC2626;
 --cv-view-gray-50: #F9FAFB;
 --cv-view-gray-100: #F3F4F6;
 --cv-view-gray-200: #E5E7EB;
 --cv-view-gray-300: #D1D5DB;
 --cv-view-gray-400: #9CA3AF;
 --cv-view-gray-500: #6B7280;
 --cv-view-gray-600: #4B5563;
 --cv-view-gray-700: #374151;
 --cv-view-gray-800: #1F2937;
 --cv-view-gray-900: #111827;
 }

 .cv-view-page {
 min-height: 100vh;
 background: linear-gradient(135deg, var(--cv-view-gray-50) 0%, var(--cv-view-gray-100) 100%);
 padding: 2rem 1rem;
 }

 .cv-view-container {
 max-width: 1200px;
 margin: 0 auto;
 }

 .cv-view-header {
 background: white;
 border-radius: 16px;
 padding: 2rem;
 margin-bottom: 2rem;
 box-shadow: 0 10px 40px rgba(0,0,0,0.1);
 border: 1px solid var(--cv-view-gray-200);
 }

 .cv-view-title {
 font-size: 2rem;
 font-weight: 700;
 color: var(--cv-view-gray-800);
 margin-bottom: 0.5rem;
 }

 .cv-view-meta {
 display: flex;
 align-items: center;
 gap: 2rem;
 color: var(--cv-view-gray-500);
 font-size: 0.9rem;
 }

 .cv-view-actions {
 display: flex;
 gap: 1rem;
 flex-wrap: wrap;
 margin-top: 1.5rem;
 }

 .cv-action-btn {
 padding: 0.75rem 1.5rem;
 border-radius: 8px;
 font-weight: 600;
 font-size: 0.9rem;
 border: none;
 cursor: pointer;
 transition: all 0.3s ease;
 display: flex;
 align-items: center;
 gap: 0.5rem;
 text-decoration: none;
 min-width: 120px;
 justify-content: center;
 }

 .cv-action-primary {
 background: linear-gradient(135deg, var(--cv-view-primary) 0%, var(--cv-view-secondary) 100%);
 color: white;
 box-shadow: 0 4px 15px rgba(79,70,229,0.3);
 }

 .cv-action-primary:hover {
 transform: translateY(-2px);
 box-shadow: 0 8px 25px rgba(79,70,229,0.4);
 }

 .cv-action-secondary {
 background: white;
 color: var(--cv-view-gray-700);
 border: 2px solid var(--cv-view-gray-200);
 }

 .cv-action-secondary:hover {
 background: var(--cv-view-gray-50);
 border-color: var(--cv-view-gray-300);
 transform: translateY(-1px);
 }

 .cv-action-success {
 background: var(--cv-view-success);
 color: white;
 }

 .cv-action-success:hover {
 background: #047857;
 transform: translateY(-1px);
 }

 .cv-action-warning {
 background: var(--cv-view-warning);
 color: white;
 }

 .cv-action-warning:hover {
 background: #D97706;
 transform: translateY(-1px);
 }

 .cv-content-wrapper {
 display: grid;
 grid-template-columns: 1fr 300px;
 gap: 2rem;
 align-items: start;
 }

 .cv-preview-container {
 background: white;
 border-radius: 16px;
 box-shadow: 0 10px 40px rgba(0,0,0,0.1);
 border: 1px solid var(--cv-view-gray-200);
 overflow: hidden;
 position: relative;
 }

 .cv-preview-header {
 background: linear-gradient(135deg, var(--cv-view-primary) 0%, var(--cv-view-secondary) 100%);
 color: white;
 padding: 1rem 1.5rem;
 display: flex;
 align-items: center;
 justify-content: space-between;
 }

 .cv-preview-title {
 font-weight: 600;
 font-size: 1rem;
 }

 .cv-preview-controls {
 display: flex;
 gap: 0.5rem;
 }

 .cv-zoom-btn {
 background: rgba(255,255,255,0.2);
 border: none;
 color: white;
 width: 32px;
 height: 32px;
 border-radius: 6px;
 cursor: pointer;
 display: flex;
 align-items: center;
 justify-content: center;
 transition: all 0.2s ease;
 }

 .cv-zoom-btn:hover {
 background: rgba(255,255,255,0.3);
 }

 .cv-preview-content {
 padding: 0;
 overflow: auto;
 max-height: 80vh;
 }

 .cv-preview-iframe {
 width: 100%;
 height: 100%;
 min-height: 600px;
 border: none;
 background: white;
 }

 .cv-sidebar {
 background: white;
 border-radius: 16px;
 padding: 1.5rem;
 box-shadow: 0 10px 40px rgba(0,0,0,0.1);
 border: 1px solid var(--cv-view-gray-200);
 position: sticky;
 top: 2rem;
 }

 .cv-sidebar-section {
 margin-bottom: 2rem;
 }

 .cv-sidebar-title {
 font-size: 1.1rem;
 font-weight: 600;
 color: var(--cv-view-gray-800);
 margin-bottom: 1rem;
 display: flex;
 align-items: center;
 gap: 0.5rem;
 }

 .cv-stats {
 display: grid;
 grid-template-columns: 1fr 1fr;
 gap: 1rem;
 }

 .cv-stat {
 text-align: center;
 padding: 1rem;
 background: var(--cv-view-gray-50);
 border-radius: 8px;
 border: 1px solid var(--cv-view-gray-200);
 }

 .cv-stat-number {
 font-size: 1.5rem;
 font-weight: 700;
 color: var(--cv-view-primary);
 display: block;
 }

 .cv-stat-label {
 font-size: 0.8rem;
 color: var(--cv-view-gray-600);
 margin-top: 0.25rem;
 }

 .cv-share-section {
 margin-bottom: 2rem;
 }

 .cv-share-input {
 width: 100%;
 padding: 0.75rem;
 border: 1px solid var(--cv-view-gray-300);
 border-radius: 8px;
 font-size: 0.9rem;
 margin-bottom: 1rem;
 background: var(--cv-view-gray-50);
 }

 .cv-share-buttons {
 display: flex;
 gap: 0.5rem;
 flex-wrap: wrap;
 }

 .cv-share-btn {
 flex: 1;
 padding: 0.5rem;
 border: 1px solid var(--cv-view-gray-300);
 border-radius: 6px;
 background: white;
 cursor: pointer;
 transition: all 0.2s ease;
 display: flex;
 align-items: center;
 justify-content: center;
 color: var(--cv-view-gray-600);
 }

 .cv-share-btn:hover {
 background: var(--cv-view-gray-50);
 border-color: var(--cv-view-gray-400);
 }

 .cv-share-btn i {
 font-size: 1.1rem;
 }

 .cv-recent-activity {
 max-height: 300px;
 overflow-y: auto;
 }

 .cv-activity-item {
 display: flex;
 align-items: center;
 gap: 0.75rem;
 padding: 0.75rem 0;
 border-bottom: 1px solid var(--cv-view-gray-100);
 }

 .cv-activity-item:last-child {
 border-bottom: none;
 }

 .cv-activity-icon {
 width: 32px;
 height: 32px;
 background: var(--cv-view-primary);
 border-radius: 50%;
 display: flex;
 align-items: center;
 justify-content: center;
 color: white;
 font-size: 0.8rem;
 }

 .cv-activity-content {
 flex: 1;
 }

 .cv-activity-text {
 font-size: 0.85rem;
 color: var(--cv-view-gray-700);
 margin-bottom: 0.25rem;
 }

 .cv-activity-time {
 font-size: 0.75rem;
 color: var(--cv-view-gray-500);
 }

 .cv-loading {
 display: flex;
 align-items: center;
 justify-content: center;
 height: 400px;
 color: var(--cv-view-gray-500);
 }

 .cv-loading-spinner {
 width: 40px;
 height: 40px;
 border: 4px solid var(--cv-view-gray-200);
 border-top: 4px solid var(--cv-view-primary);
 border-radius: 50%;
 animation: spin 1s linear infinite;
 margin-right: 1rem;
 }

 @keyframes spin {
 0% { transform: rotate(0deg); }
 100% { transform: rotate(360deg); }
 }

 @media (max-width: 768px) {
 .cv-content-wrapper {
 grid-template-columns: 1fr;
 }

 .cv-sidebar {
 position: static;
 }

 .cv-view-actions {
 flex-direction: column;
 }

 .cv-action-btn {
 width: 100%;
 }

 .cv-stats {
 grid-template-columns: 1fr;
 }
 }

 @media print {
 .cv-view-page,
 .cv-view-header,
 .cv-sidebar,
 .cv-preview-header {
 display: none !important;
 }

 .cv-preview-container {
 box-shadow: none;
 border: none;
 }
 }
/* ── ATS Scorecard Modal ── */
.ats-overlay {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center;
  padding: 1rem;
  backdrop-filter: blur(4px);
}
.ats-modal {
  background: white; border-radius: 20px;
  max-width: 680px; width: 100%; max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 25px 60px rgba(0,0,0,0.3);
  animation: atsFadeIn 0.25s ease;
}
@keyframes atsFadeIn {
  from { opacity: 0; transform: translateY(20px) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.ats-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid #e5e7eb;
  background: linear-gradient(135deg, #f8fafc, #fff);
  border-radius: 20px 20px 0 0;
}
.ats-header h2 {
  font-size: 1.2rem; font-weight: 700; color: #1f2937;
  display: flex; align-items: center; gap: 0.5rem;
}
.ats-close-btn {
  width: 36px; height: 36px; border-radius: 10px;
  border: none; background: transparent;
  color: #6b7280; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.15s;
}
.ats-close-btn:hover { background: #f3f4f6; color: #111827; }
.ats-body { padding: 1.5rem; }

/* Score ring */
.ats-score-ring {
  display: flex; flex-direction: column; align-items: center;
  margin-bottom: 1.5rem; padding: 1.5rem;
  background: linear-gradient(135deg, #f8fafc, #f1f5f9);
  border-radius: 16px; border: 1px solid #e5e7eb;
}
.ats-ring-svg {
  width: 120px; height: 120px;
  transform: rotate(-90deg);
}
.ats-ring-bg { fill: none; stroke: #e5e7eb; stroke-width: 8; }
.ats-ring-fill { fill: none; stroke-width: 8; stroke-linecap: round; transition: stroke-dashoffset 1s ease; }
.ats-score-value {
  position: absolute; font-size: 2rem; font-weight: 800;
  color: #1f2937;
}
.ats-score-label { font-size: 0.8rem; color: #6b7280; margin-top: 0.25rem; }
.ats-score-grade {
  display: inline-flex; align-items: center; gap: 0.35rem;
  padding: 0.3rem 0.8rem; border-radius: 999px;
  font-size: 0.8rem; font-weight: 700; margin-top: 0.5rem;
}
.ats-grade-excellent { background: #d1fae5; color: #065f46; }
.ats-grade-good { background: #dbeafe; color: #1d4ed8; }
.ats-grade-average { background: #fef3c7; color: #92400e; }
.ats-grade-poor { background: #fee2e2; color: #991b1b; }

/* Section scores */
.ats-sections { margin-bottom: 1.5rem; }
.ats-section-title { font-size: 0.9rem; font-weight: 700; color: #1f2937; margin-bottom: 0.75rem; }
.ats-section-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
.ats-section-card {
  border: 1px solid #e5e7eb; border-radius: 12px;
  padding: 0.9rem 1rem;
  display: flex; align-items: center; justify-content: space-between;
  transition: all 0.15s;
}
.ats-section-card:hover { border-color: #d1d5db; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
.ats-section-name { font-size: 0.85rem; font-weight: 600; color: #374151; }
.ats-section-bar {
  width: 60px; height: 6px; border-radius: 3px;
  background: #e5e7eb; overflow: hidden;
}
.ats-section-fill { height: 100%; border-radius: 3px; transition: width 0.8s ease; }
.ats-section-pct { font-size: 0.8rem; font-weight: 700; min-width: 32px; text-align: right; }

/* Keywords */
.ats-keywords { margin-bottom: 1.5rem; }
.ats-kw-title { font-size: 0.9rem; font-weight: 700; color: #1f2937; margin-bottom: 0.5rem; }
.ats-kw-list { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.ats-kw-tag {
  display: inline-flex; align-items: center; gap: 0.3rem;
  padding: 0.25rem 0.6rem; border-radius: 999px;
  font-size: 0.78rem; font-weight: 600;
}
.ats-kw-found { background: #d1fae5; color: #065f46; }
.ats-kw-missing { background: #fee2e2; color: #991b1b; }
.ats-kw-suggestion { background: #fef3c7; color: #92400e; }

/* Suggestions */
.ats-suggestions { margin-bottom: 1.5rem; }
.ats-sug-title { font-size: 0.9rem; font-weight: 700; color: #1f2937; margin-bottom: 0.5rem; }
.ats-sug-item {
  display: flex; align-items: flex-start; gap: 0.6rem;
  padding: 0.7rem 0; border-bottom: 1px solid #f3f4f6;
}
.ats-sug-item:last-child { border-bottom: none; }
.ats-sug-icon { width: 24px; height: 24px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; flex-shrink: 0; }
.ats-sug-icon-improve { background: #fef3c7; color: #92400e; }
.ats-sug-icon-add { background: #dbeafe; color: #1d4ed8; }
.ats-sug-icon-fix { background: #fee2e2; color: #991b1b; }
.ats-sug-text { font-size: 0.85rem; color: #4b5563; line-height: 1.4; }
.ats-sug-action { margin-top: 0.3rem; }
.ats-sug-btn {
  display: inline-flex; align-items: center; gap: 0.3rem;
  padding: 0.2rem 0.6rem; border-radius: 6px;
  border: 1px solid #d1d5db; background: white;
  font-size: 0.75rem; font-weight: 600; color: #374151;
  cursor: pointer; transition: all 0.15s;
}
.ats-sug-btn:hover { border-color: #9ca3af; background: #f9fafb; }

/* Readability meter */
.ats-readability {
  display: flex; align-items: center; gap: 0.75rem;
  padding: 0.75rem 1rem;
  background: #f8fafc; border: 1px solid #e5e7eb; border-radius: 12px;
  margin-bottom: 1rem;
}
.ats-read-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1rem; }
.ats-read-text { font-size: 0.85rem; color: #374151; font-weight: 600; }
.ats-read-label { font-size: 0.75rem; color: #6b7280; }

/* Loading state */
.ats-loading {
  text-align: center; padding: 3rem 1rem;
}
.ats-loading-spinner {
  width: 40px; height: 40px;
  border: 4px solid #e5e7eb; border-top-color: #4f46e5;
  border-radius: 50%; animation: atsSpin 0.8s linear infinite;
  margin: 0 auto 1rem;
}
@keyframes atsSpin { to { transform: rotate(360deg); } }
.ats-loading-text { font-size: 0.9rem; color: #6b7280; }

/* Error state */
.ats-error {
  text-align: center; padding: 2rem 1rem;
}
.ats-error-icon { font-size: 2.5rem; margin-bottom: 0.5rem; display: block; }
.ats-error-text { font-size: 0.9rem; color: #dc2626; margin-bottom: 1rem; }
.ats-retry-btn {
  padding: 0.5rem 1.25rem; border-radius: 8px;
  border: none; background: #4f46e5; color: white;
  font-weight: 600; font-size: 0.85rem; cursor: pointer;
  transition: all 0.15s;
}
.ats-retry-btn:hover { background: #4338ca; }

/* Rate limit warning */
.ats-rate-limit {
  text-align: center; padding: 2rem 1rem;
}
.ats-rate-icon { font-size: 2rem; margin-bottom: 0.5rem; display: block; }
.ats-rate-text { font-size: 0.9rem; color: #92400e; }
.ats-rate-sub { font-size: 0.8rem; color: #6b7280; margin-top: 0.25rem; }

@media (max-width: 640px) {
  .ats-section-grid { grid-template-columns: 1fr; }
  .ats-modal { max-height: 95vh; border-radius: 16px; }
}
</style>
{% endblock %}

{% block content %}
<div class="cv-view-page">
 <div class="cv-view-container">
 <!-- Header Section -->
 <div class="cv-view-header">
 <h1 class="cv-view-title">{{ cv.title|default('My CV') }}</h1>
 <div class="cv-view-meta">
 <span><i class="lucide lucide-calendar"></i> Created {{ cv.created_at|date('M j, Y')|default('Recently') }}</span>
 <span><i class="lucide lucide-clock"></i> Updated {{ cv.updated_at|date('M j, Y')|default('Recently') }}</span>
 </div>

 <div class="cv-view-actions">
 <a href="/cv-builder/{{ cv.id }}" class="cv-action-btn cv-action-primary">
 <i class="lucide lucide-pencil"></i>
 Edit CV
 </a>
 <button onclick="downloadCV()" class="cv-action-btn cv-action-success">
 <i class="lucide lucide-download"></i>
 Download PDF
 </button>
 <button onclick="shareCV()" class="cv-action-btn cv-action-secondary">
 <i class="lucide lucide-share-2"></i>
 Share
 </button>
 <button onclick="duplicateCV()" class="cv-action-btn cv-action-warning">
 <i class="lucide lucide-copy"></i>
 Duplicate
 </button>
 <button onclick="deleteCV()" class="cv-action-btn cv-action-secondary" style="background: var(--cv-view-danger); color: white;">
 <i class="lucide lucide-trash-2"></i>
 Delete
 </button>
 </div>
 </div>

 <!-- Main Content -->
 <div class="cv-content-wrapper">    <!-- CV Preview with Live A4 Rendering -->
 <div class="cv-preview-container">
 <div class="cv-preview-header">
 <span class="cv-preview-title">CV Preview</span>
 <div class="cv-preview-controls">
 <select id="templateSelector" onchange="switchTemplate(this.value)" class="cv-zoom-btn" style="width:auto;padding:0 8px;font-size:12px;background:rgba(255,255,255,0.2);color:white;border:1px solid rgba(255,255,255,0.3);border-radius:6px;cursor:pointer;">
 {% for t in templates %}
 <option value="{{ t }}"{{ t == selected_template ? ' selected' : '' }} style="color:#1f2937;background:white;">{{ t|capitalize }}</option>
 {% endfor %}
 </select>
 <span style="color:rgba(255,255,255,0.6);font-size:12px;">|</span>
 <button onclick="previewZoomOut()" class="cv-zoom-btn" title="Zoom Out">−</button>
 <span id="zoomLevel" style="color:white;font-size:12px;min-width:40px;text-align:center;">100%</span>
 <button onclick="previewZoomIn()" class="cv-zoom-btn" title="Zoom In">+</button>
 <button onclick="previewZoomReset()" class="cv-zoom-btn" title="Reset Zoom">↺</button>
 </div>
 </div>
 <div class="cv-preview-content" id="previewContent" style="overflow:hidden;">
 <div id="cvLoading" class="cv-loading">
 <div class="cv-loading-spinner"></div>
 <span>Loading CV preview...</span>
 </div>
 <iframe id="cvPreview" class="cv-preview-iframe" style="display: none;" sandbox="allow-scripts allow-same-origin"></iframe>
 </div>
 </div>

 <!-- Sidebar -->
 <div class="cv-sidebar">
 <!-- Statistics -->
 <div class="cv-sidebar-section">
 <h3 class="cv-sidebar-title">
 <i class="lucide lucide-bar-chart-3"></i>
 Statistics
 </h3>
 <div class="cv-stats">
 <div class="cv-stat">
 <span class="cv-stat-number">{{ cv.sections|length|default(0) }}</span>
 <span class="cv-stat-label">Sections</span>
 </div>
 <div class="cv-stat">
 <span class="cv-stat-number">{{ cv.items|length|default(0) }}</span>
 <span class="cv-stat-label">Items</span>
 </div>
 <div class="cv-stat">
 <span class="cv-stat-number">{{ cv.word_count|default(0) }}</span>
 <span class="cv-stat-label">Words</span>
 </div>
 <div class="cv-stat">
 <span class="cv-stat-number">{{ cv.completeness|default(0) }}%</span>
 <span class="cv-stat-label">Complete</span>
 </div>
 </div>
 </div>

 <!-- Share Section -->
 <div class="cv-share-section">
 <h3 class="cv-sidebar-title">
 <i class="lucide lucide-share-2"></i>
 Share CV
 </h3>
 <input type="text" id="shareUrl" class="cv-share-input" readonly
 value="{{ app_url }}/cv/{{ cv.id }}/public">
 <div class="cv-share-buttons">
 <button onclick="copyShareUrl()" class="cv-share-btn" title="Copy Link">
 <i class="lucide lucide-clipboard"></i>
 </button>
 <button onclick="shareToLinkedIn()" class="cv-share-btn" title="Share on LinkedIn">
 <i class="lucide lucide-briefcase"></i>
 </button>
 <button onclick="shareToTwitter()" class="cv-share-btn" title="Share on Twitter">
 <i class="lucide lucide-share-2"></i>
 </button>
 <button onclick="shareViaEmail()" class="cv-share-btn" title="Share via Email">
 <i class="lucide lucide-mail"></i>
 </button>
 </div>
 </div>

 <!-- Recent Activity -->
 <div class="cv-sidebar-section">
 <h3 class="cv-sidebar-title">
 <i class="lucide lucide-activity"></i>
 Recent Activity
 </h3>
 <div class="cv-recent-activity">
 {% for activity in cv.activities|default([]) %}
 <div class="cv-activity-item">
 <div class="cv-activity-icon">
 <i class="lucide lucide-{{ activity.icon|default('circle') }}"></i>
 </div>
 <div class="cv-activity-content">
 <div class="cv-activity-text">{{ activity.description }}</div>
 <div class="cv-activity-time">{{ activity.time|default('Recently') }}</div>
 </div>
 </div>
 {% endfor %}
 {% if cv.activities|default([])|length == 0 %}
 <div class="cv-activity-item">
 <div class="cv-activity-icon">
 <i class="lucide lucide-plus-circle"></i>
 </div>
 <div class="cv-activity-content">
 <div class="cv-activity-text">CV created</div>
 <div class="cv-activity-time">{{ cv.created_at|date('M j, Y')|default('Recently') }}</div>
 </div>
 </div>
 {% endif %}
 </div>
 </div>

 <!-- Quick Actions -->
 <div class="cv-sidebar-section">
 <h3 class="cv-sidebar-title">
 <i class="lucide lucide-zap"></i>
 Quick Actions
 </h3>
 <div style="display: grid; gap: 0.5rem;">
 <button onclick="openAtsScorecard()" class="cv-action-btn cv-action-secondary" style="width: 100%; justify-content: flex-start;">
 <i class="lucide lucide-bot"></i>
 ATS Scorecard
 </button>
 <button onclick="checkGrammar(event)" class="cv-action-btn cv-action-secondary" style="width: 100%; justify-content: flex-start;">
 <i class="lucide lucide-check-circle"></i>
 Check Grammar
 </button>
 <button onclick="openCoverLetter()" class="cv-action-btn cv-action-secondary" style="width: 100%; justify-content: flex-start;">
 <i class="lucide lucide-file-text"></i>
 Generate Cover Letter
 </button>
 </div>
 </div>
 </div>
 </div>
 </div>
</div>

<!-- Share Modal -->
<div class="fixed inset-0 z-50 hidden" id="shareModal" tabindex="-1">
 <div class="fixed inset-0 bg-black/50 transition-opacity" data-brox-dismiss="modal"></div>
 <div class="fixed inset-0 flex items-center justify-center p-4">
 <div class="bg-white rounded-xl shadow-md-xl w-full max-w-md overflow-hidden">
 <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-200">
 <h5 class="text-lg font-semibold text-neutral-900">Share Your CV</h5>
 <button type="button" class="w-8 h-8 flex items-center justify-center border-0 bg-transparent text-neutral-500 hover:text-neutral-800 hover:bg-neutral-100 rounded-lg transition-all duration-150 cursor-pointer" data-brox-dismiss="modal">&times;</button>
 </div>
 <div class="p-6">
 <div class="mb-4">
 <label class="block text-sm font-medium text-neutral-700 mb-1.5">Share Link</label>
 <div class="flex rounded-lg border border-neutral-300 overflow-hidden focus-within:ring-2 focus-within:ring-primary/20 focus-within:border-primary transition-all">
 <input type="text" class="flex-1 px-3 py-2 border-0 outline-none text-sm" id="shareLinkInput" readonly>
 <button class="inline-flex items-center px-3 py-2 text-sm font-medium text-neutral-700 bg-neutral-50 hover:bg-neutral-100 transition-colors border-l border-neutral-300" onclick="copyShareLink()">
