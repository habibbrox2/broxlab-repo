 </button>
 </div>
 </div>
 <div class="flex flex-col gap-2">
 <button onclick="shareToLinkedIn()" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-600/90 transition-colors">
 <i class="lucide lucide-briefcase"></i> Share on LinkedIn
 </button>
 <button onclick="shareToTwitter()" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-sky-500 text-white text-sm font-semibold hover:bg-sky-600 transition-colors">
 <i class="lucide lucide-share-2"></i> Share on Twitter
 </button>
 <button onclick="shareViaEmail()" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg border border-neutral-300 bg-white text-neutral-700 text-sm font-semibold hover:bg-neutral-100 transition-colors">
 <i class="lucide lucide-mail"></i> Share via Email
 </button>
 </div>
 </div>
 </div>
 </div>
</div>

<!-- Cover Letter Modal -->
<div class="ats-overlay" id="clOverlay" style="display:none;" onclick="if(event.target===this)closeCoverLetter()">
 <div class="ats-modal" onclick="event.stopPropagation()">
  <div class="ats-header">
   <h2><i class="lucide lucide-file-text"></i> Cover Letter Generator</h2>
   <button class="ats-close-btn" onclick="closeCoverLetter()" title="Close"><i class="lucide lucide-x"></i></button>
  </div>
  <div class="ats-body" id="clBody">
   <!-- Form -->
   <div id="clForm">
    <div style="margin-bottom:1rem;">
     <label style="display:block;font-size:0.85rem;font-weight:600;color:#374151;margin-bottom:0.4rem;">Company Name <span style="color:#dc2626;">*</span></label>
     <input type="text" id="clCompany" placeholder="e.g. Google, Microsoft, Acme Corp"
      style="width:100%;padding:0.65rem 0.8rem;border:1px solid #d1d5db;border-radius:8px;font-size:0.9rem;outline:none;transition:border-color 0.15s;"
      onfocus="this.style.borderColor='#4f46e5'" onblur="this.style.borderColor='#d1d5db'">
    </div>
    <div style="margin-bottom:1rem;">
     <label style="display:block;font-size:0.85rem;font-weight:600;color:#374151;margin-bottom:0.4rem;">Job Title <span style="color:#dc2626;">*</span></label>
     <input type="text" id="clJobTitle" placeholder="e.g. Senior Software Engineer"
      style="width:100%;padding:0.65rem 0.8rem;border:1px solid #d1d5db;border-radius:8px;font-size:0.9rem;outline:none;transition:border-color 0.15s;"
      onfocus="this.style.borderColor='#4f46e5'" onblur="this.style.borderColor='#d1d5db'">
    </div>
    <div style="margin-bottom:1.25rem;">
     <label style="display:block;font-size:0.85rem;font-weight:600;color:#374151;margin-bottom:0.4rem;">Job Description <span style="color:#6b7280;font-weight:400;">(optional — better results)</span></label>
     <textarea id="clJobDesc" rows="4" placeholder="Paste the job description here for a more tailored cover letter..."
      style="width:100%;padding:0.65rem 0.8rem;border:1px solid #d1d5db;border-radius:8px;font-size:0.9rem;outline:none;resize:vertical;font-family:inherit;transition:border-color 0.15s;"
      onfocus="this.style.borderColor='#4f46e5'" onblur="this.style.borderColor='#d1d5db'"></textarea>
    </div>
    <button id="clGenerateBtn" onclick="generateCoverLetter()"
     style="width:100%;padding:0.75rem;border:none;border-radius:8px;background:linear-gradient(135deg,#4f46e5,#7c3aed);color:white;font-weight:700;font-size:0.95rem;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;justify-content:center;gap:0.5rem;"
     onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
     <i class="lucide lucide-sparkles"></i> Generate Cover Letter
    </button>
   </div>
   <!-- Result -->
   <div id="clResult" style="display:none;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
     <span style="font-size:0.85rem;color:#6b7280;">Your personalized cover letter</span>
     <div style="display:flex;gap:0.4rem;">
      <button onclick="copyCoverLetter(event)" class="ats-sug-btn" title="Copy to clipboard">
       <i class="lucide lucide-copy" style="width:14px;height:14px;"></i> Copy
      </button>
      <button onclick="downloadCoverLetter()" class="ats-sug-btn" title="Download as text file">
       <i class="lucide lucide-download" style="width:14px;height:14px;"></i> Download
      </button>
     </div>
    </div>
    <div id="clLetterContent"
     style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:12px;padding:1.25rem;font-size:0.9rem;line-height:1.7;color:#374151;white-space:pre-wrap;font-family:Georgia,serif;max-height:55vh;overflow-y:auto;">
    </div>
    <div id="clMeta" style="display:flex;align-items:center;gap:1rem;margin-top:0.75rem;font-size:0.8rem;color:#6b7280;"></div>
    <button onclick="resetCoverLetterForm()"
     style="margin-top:1rem;width:100%;padding:0.6rem;border:1px solid #d1d5db;border-radius:8px;background:white;color:#374151;font-weight:600;font-size:0.85rem;cursor:pointer;transition:all 0.15s;display:flex;align-items:center;justify-content:center;gap:0.4rem;"
     onmouseover="this.style.borderColor='#9ca3af'" onmouseout="this.style.borderColor='#d1d5db'">
     <i class="lucide lucide-refresh-cw" style="width:14px;height:14px;"></i> Generate New
    </button>
   </div>
   <!-- Loading -->
   <div id="clLoading" style="display:none;text-align:center;padding:2rem 1rem;">
    <div class="ats-loading-spinner"></div>
    <div style="font-size:0.9rem;color:#6b7280;margin-top:0.75rem;">Crafting your personalized cover letter based on your CV...</div>
   </div>
   <!-- Error -->
   <div id="clError" style="display:none;text-align:center;padding:2rem 1rem;">
    <span style="font-size:2.5rem;display:block;margin-bottom:0.5rem;"><i class="lucide lucide-alert-circle" style="width:2.5rem;height:2.5rem;color:#dc2626;"></i></span>
    <div id="clErrorText" style="font-size:0.9rem;color:#dc2626;margin-bottom:1rem;"></div>
    <button onclick="resetCoverLetterForm()" class="ats-retry-btn">Try Again</button>
   </div>
  </div>
 </div>
</div>

<!-- ATS Scorecard Modal -->
<div class="ats-overlay" id="atsOverlay" style="display:none;" onclick="if(event.target===this)closeAtsScorecard()">
 <div class="ats-modal" onclick="event.stopPropagation()">
 <div class="ats-header">
 <h2><i class="lucide lucide-bot"></i> ATS Scorecard</h2>
 <button class="ats-close-btn" onclick="closeAtsScorecard()" title="Close"><i class="lucide lucide-x"></i></button>
 </div>
 <div class="ats-body" id="atsBody">
 <div class="ats-loading" id="atsLoading">
 <div class="ats-loading-spinner"></div>
 <div class="ats-loading-text">Analyzing your CV for ATS compatibility...</div>
 </div>
 </div>
 </div>
</div>

<script>
// CV View — Live Preview with Template Switching
const cvId = {{ cv.id|default('0') }};
let currentTemplate = '{{ selected_template|default('modern') }}';
let previewZoom = 1.0;
const zoomStep = 0.1;
const minZoom = 0.5;
const maxZoom = 2.0;

document.addEventListener('DOMContentLoaded', function() {
  loadPreview(currentTemplate);
  setupPostMessageListener();
});

function getPreviewUrl(template, zoom) {
  return `/api/cv/${cvId}/preview?template=${encodeURIComponent(template)}&zoom=${zoom || previewZoom}`;
}

function loadPreview(template) {
  const iframe = document.getElementById('cvPreview');
  const loading = document.getElementById('cvLoading');
  if (!iframe || !loading) return;

  currentTemplate = template;
  loading.style.display = 'flex';
  iframe.style.display = 'none';

  const url = getPreviewUrl(template, previewZoom);
  iframe.src = url;

  iframe.onload = function() {
    loading.style.display = 'none';
    iframe.style.display = 'block';
  };

  // Fallback: hide loading after 10s
  setTimeout(function() {
    loading.style.display = 'none';
    iframe.style.display = 'block';
  }, 10000);
}

function switchTemplate(template) {
  const selector = document.getElementById('templateSelector');
  if (selector) selector.value = template;
  loadPreview(template);
}

function setupPostMessageListener() {
  window.addEventListener('message', function(event) {
    if (event.data && event.data.type === 'template-change') {
      // User changed template from the iframe toolbar
      const newTemplate = event.data.template;
      const selector = document.getElementById('templateSelector');
      if (selector) selector.value = newTemplate;
      loadPreview(newTemplate);
    }
    if (event.data && event.data.type === 'preview-loaded') {
      // Preview finished loading — update URL if needed
    }
  });
}

// Zoom controls (scale the iframe container)
function previewZoomIn() {
  if (previewZoom < maxZoom) {
    previewZoom = Math.round((previewZoom + zoomStep) * 10) / 10;
    applyPreviewZoom();
  }
}

function previewZoomOut() {
  if (previewZoom > minZoom) {
    previewZoom = Math.round((previewZoom - zoomStep) * 10) / 10;
    applyPreviewZoom();
  }
}

function previewZoomReset() {
  previewZoom = 1.0;
  applyPreviewZoom();
}

function applyPreviewZoom() {
  const iframe = document.getElementById('cvPreview');
  const content = document.getElementById('previewContent');
  if (!iframe) return;

  iframe.style.transform = 'scale(' + previewZoom + ')';
  iframe.style.transformOrigin = 'top left';
  iframe.style.width = (100 / previewZoom) + '%';
  iframe.style.height = (600 * previewZoom) + 'px';

  const zoomDisplay = document.getElementById('zoomLevel');
  if (zoomDisplay) {
    zoomDisplay.textContent = Math.round(previewZoom * 100) + '%';
  }

  // Update URL without reload
  const url = new URL(window.location);
  url.searchParams.set('zoom', previewZoom);
  window.history.replaceState({}, '', url);
}

// Download PDF using the export route
function downloadCV() {
  window.location.href = '/cv-builder/' + cvId + '/export/pdf';
}

function shareCV() {
  var modalEl = document.getElementById('shareModal');
  if (!modalEl) return;
  document.getElementById('shareLinkInput').value = document.getElementById('shareUrl').value;
  if (window.broxUI && window.broxUI.Modal) {
    var modal = new broxUI.Modal(modalEl);
    modal.show();
  } else {
    modalEl.classList.remove('hidden');
  }
}

function copyShareUrl() {
  var urlInput = document.getElementById('shareUrl');
  urlInput.select();
  document.execCommand('copy');
  var btn = event.target.closest('.cv-share-btn');
  var originalIcon = btn.innerHTML;
  btn.innerHTML = '<i class="lucide lucide-check"></i>';
  btn.style.background = 'var(--cv-view-success)';
  btn.style.color = 'white';
  setTimeout(function() {
    btn.innerHTML = originalIcon;
    btn.style.background = '';
    btn.style.color = '';
  }, 2000);
}

function copyShareLink() {
  var input = document.getElementById('shareLinkInput');
  input.select();
  document.execCommand('copy');
  var btn = event.target;
  var originalText = btn.innerHTML;
  btn.innerHTML = '<i class="lucide lucide-check"></i> Copied!';
  setTimeout(function() { btn.innerHTML = originalText; }, 2000);
}

function shareToLinkedIn() {
  var url = encodeURIComponent(document.getElementById('shareUrl').value);
  window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + url, '_blank');
}

function shareToTwitter() {
  var url = encodeURIComponent(document.getElementById('shareUrl').value);
  var text = encodeURIComponent('Check out my professional CV');
  window.open('https://twitter.com/intent/tweet?url=' + url + '&text=' + text, '_blank');
}

function shareViaEmail() {
  var subject = encodeURIComponent('My Professional CV');
  var body = encodeURIComponent('Hi,\n\nI would like to share my professional CV with you:\n\n' + document.getElementById('shareUrl').value);
  window.location.href = 'mailto:?subject=' + subject + '&body=' + body;
}

async function duplicateCV() {
  if (!(await window.showConfirm('Create a copy of this CV? All sections and content will be duplicated.', 'Duplicate CV', 'info'))) return;

  const btn = document.querySelector('button[onclick*="duplicateCV"]');
  const originalHtml = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="lucide lucide-hourglass"></i> Duplicating...'; }

  try {
    const resp = await fetch('/cv-builder/' + cvId + '/duplicate', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
      }
    });

    const data = await resp.json();
    if (data.success && data.redirect) {
      window.showMessage('CV duplicated successfully! Redirecting...', 'success');
      window.location.href = data.redirect;
    } else {
      window.showMessage(data.error || 'Failed to duplicate CV', 'danger');
      if (btn) { btn.disabled = false; btn.innerHTML = originalHtml; }
    }
  } catch (err) {
    console.error('Duplicate CV error:', err);
    window.showMessage('Failed to duplicate CV. Please try again.', 'danger');
    if (btn) { btn.disabled = false; btn.innerHTML = originalHtml; }
  }
}

async function deleteCV() {
  if (!(await window.showConfirm('Are you sure you want to delete this CV? This action cannot be undone.\n\nAll sections and content will be permanently removed.', 'Delete CV', 'error'))) return;

  const btn = document.querySelector('button[onclick*="deleteCV"]');
  const originalHtml = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="lucide lucide-hourglass"></i> Deleting...'; }

  try {
    const resp = await fetch('/cv-builder/' + cvId, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
      }
    });

    const data = await resp.json();
    if (data.success) {
      window.showMessage('CV deleted successfully! Redirecting...', 'success');
      setTimeout(function() { window.location.href = '/cv-builder'; }, 1200);
    } else {
      window.showMessage(data.error || 'Failed to delete CV', 'danger');
      if (btn) { btn.disabled = false; btn.innerHTML = originalHtml; }
    }
  } catch (err) {
    console.error('Delete CV error:', err);
    window.showMessage('Failed to delete CV. Please try again.', 'danger');
    if (btn) { btn.disabled = false; btn.innerHTML = originalHtml; }
  }
}

// ========== ATS SCORECARD ==========

function openAtsScorecard() {
  const overlay = document.getElementById('atsOverlay');
  const body = document.getElementById('atsBody');
  if (!overlay || !body) return;

  overlay.style.display = 'flex';
  body.innerHTML = `
    <div class="ats-loading" id="atsLoading">
      <div class="ats-loading-spinner"></div>
      <div class="ats-loading-text">Analyzing your CV for ATS compatibility...</div>
    </div>
  `;

  fetchAtsScore();
}

function closeAtsScorecard() {
  const overlay = document.getElementById('atsOverlay');
  if (overlay) overlay.style.display = 'none';
}

async function fetchAtsScore() {
  const body = document.getElementById('atsBody');
  if (!body) return;

  try {
    const resp = await fetch('/cv-builder/' + cvId + '/ai/ats-score', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
      },
      body: JSON.stringify({})
    });

    if (resp.status === 429) {
      const data = await resp.json();
      renderRateLimit(data);
      return;
    }

    const data = await resp.json();

    if (!data || data.error) {
      renderError(data?.error || 'Failed to analyze CV');
      return;
    }

    renderScorecard(data);
  } catch (err) {
    console.error('ATS score fetch error:', err);
    renderError('Network error. Please try again.');
  }
}

function renderScorecard(data) {
  const body = document.getElementById('atsBody');
  if (!body) return;

  const score = data.score || 0;
  const feedback = data.feedback || data.analysis || {};
  const suggestions = data.suggestions || [];
  const foundKeywords = data.found_keywords || feedback?.keywords?.found || [];
  const missingKeywords = data.missing_keywords || feedback?.keywords?.missing || [];
  const readability = feedback?.readability || 'Needs review';

  // Determine grade
  let grade, gradeClass;
  if (score >= 80) { grade = 'Excellent'; gradeClass = 'ats-grade-excellent'; }
  else if (score >= 60) { grade = 'Good'; gradeClass = 'ats-grade-good'; }
  else if (score >= 40) { grade = 'Average'; gradeClass = 'ats-grade-average'; }
  else { grade = 'Needs Work'; gradeClass = 'ats-grade-poor'; }

  // Section breakdown — compute from missing suggestions array
  const sections = feedback?.sections || {};
  const sectionMissing = Array.isArray(sections?.missing) ? sections.missing : [];
  const isComplete = sections?.complete === true;

  const sectionData = [
    { key: 'summary', label: 'Summary', score: isComplete ? 85 : (sectionMissing.some(function(s) { return s.toLowerCase().includes('summar'); }) ? 40 : 70) },
    { key: 'experience', label: 'Experience', score: isComplete ? 90 : (sectionMissing.some(function(s) { return s.toLowerCase().includes('experience') || s.toLowerCase().includes('work'); }) ? 50 : 75) },
    { key: 'education', label: 'Education', score: isComplete ? 80 : (sectionMissing.some(function(s) { return s.toLowerCase().includes('education'); }) ? 30 : 65) },
    { key: 'skills', label: 'Skills', score: isComplete ? 85 : (sectionMissing.some(function(s) { return s.toLowerCase().includes('skill'); }) ? 45 : 70) },
  ];

  // SVG ring circumference
  const circumference = 2 * Math.PI * 52;
  const offset = circumference - (score / 100) * circumference;

  const kwFoundHtml = foundKeywords.length
    ? foundKeywords.map(k => `<span class="ats-kw-tag ats-kw-found"><i class="lucide lucide-check" style="width:12px;height:12px;"></i>${escapeHtml(k)}</span>`).join('')
    : '<span style="color:#6b7280;font-size:0.85rem;">No keywords detected yet</span>';

  const kwMissingHtml = missingKeywords.length
    ? missingKeywords.map(k => `<span class="ats-kw-tag ats-kw-missing"><i class="lucide lucide-plus" style="width:12px;height:12px;"></i>${escapeHtml(k)}</span>`).join('')
    : '';

  // Build suggestions HTML
  const sugHtml = suggestions.length
    ? suggestions.map((s, i) => {
        const icon = s.toLowerCase().includes('add') || s.toLowerCase().includes('include')
          ? 'add' : s.toLowerCase().includes('fix') || s.toLowerCase().includes('improve')
          ? 'fix' : 'improve';
        return `
          <div class="ats-sug-item">
            <div class="ats-sug-icon ats-sug-icon-${icon}">
              <i class="lucide lucide-${icon === 'add' ? 'plus' : icon === 'fix' ? 'alert-triangle' : 'sparkles'}" style="width:14px;height:14px;"></i>
            </div>
            <div>
              <div class="ats-sug-text">${escapeHtml(s)}</div>
            </div>
          </div>
        `;
      }).join('')
    : '<div style="color:#6b7280;font-size:0.85rem;padding:0.5rem 0;">No specific suggestions. Your CV looks good!</div>';

  body.innerHTML = `
    <div class="ats-score-ring">
      <div style="position:relative;display:flex;flex-direction:column;align-items:center;">
        <svg class="ats-ring-svg" viewBox="0 0 120 120">
          <circle class="ats-ring-bg" cx="60" cy="60" r="52"/>
          <circle class="ats-ring-fill" cx="60" cy="60" r="52"
            stroke="${score >= 80 ? '#059669' : score >= 60 ? '#3b82f6' : score >= 40 ? '#f59e0b' : '#ef4444'}"
            stroke-dasharray="${circumference}"
            stroke-dashoffset="${offset}"/>
        </svg>
        <span class="ats-score-value">${score}</span>
      </div>
      <div class="ats-score-label">out of 100</div>
      <span class="ats-score-grade ${gradeClass}">
        <i class="lucide lucide-${score >= 80 ? 'award' : score >= 60 ? 'thumbs-up' : score >= 40 ? 'trending-up' : 'alert-circle'}" style="width:14px;height:14px;"></i>
        ${grade}
      </span>
    </div>

    <div class="ats-readability">
      <div class="ats-read-icon" style="background:${readability === 'Good' || readability === 'Excellent' ? '#d1fae5' : '#fef3c7'};color:${readability === 'Good' || readability === 'Excellent' ? '#065f46' : '#92400e'};">
        <i class="lucide lucide-${readability === 'Good' || readability === 'Excellent' ? 'check-circle' : 'info'}" style="width:18px;height:18px;"></i>
      </div>
      <div>
        <div class="ats-read-text">Readability: ${escapeHtml(typeof readability === 'string' ? readability : 'Good')}</div>
        <div class="ats-read-label">How easily ATS can parse your CV</div>
      </div>
    </div>

    <div class="ats-sections">
      <div class="ats-section-title">Section Scores</div>
      <div class="ats-section-grid">
        ${sectionData.map(s => {
          const barColor = s.score >= 70 ? '#059669' : s.score >= 40 ? '#f59e0b' : '#ef4444';
          return `
            <div class="ats-section-card">
              <span class="ats-section-name">${s.label}</span>
              <div style="display:flex;align-items:center;gap:0.5rem;">
                <div class="ats-section-bar">
                  <div class="ats-section-fill" style="width:${s.score}%;background:${barColor};"></div>
                </div>
                <span class="ats-section-pct" style="color:${barColor};">${s.score}%</span>
              </div>
            </div>
          `;
        }).join('')}
      </div>
    </div>

    <div class="ats-keywords">
      <div class="ats-kw-title">Keywords Found <span style="font-weight:400;color:#6b7280;font-size:0.8rem;">(${foundKeywords.length})</span></div>
      <div class="ats-kw-list">${kwFoundHtml}</div>
    </div>

    ${kwMissingHtml ? `
    <div class="ats-keywords">
      <div class="ats-kw-title">Recommended Keywords <span style="font-weight:400;color:#6b7280;font-size:0.8rem;">(${missingKeywords.length})</span></div>
      <div class="ats-kw-list">${kwMissingHtml}</div>
    </div>
    ` : ''}

    <div class="ats-suggestions">
      <div class="ats-sug-title">Improvement Suggestions</div>
      ${sugHtml}
    </div>
  `;
}

function renderError(message) {
  const body = document.getElementById('atsBody');
  if (!body) return;
  body.innerHTML = `
    <div class="ats-error">
      <span class="ats-error-icon"><i class="lucide lucide-alert-circle" style="width:3rem;height:3rem;color:#dc2626;"></i></span>
      <div class="ats-error-text">${escapeHtml(message)}</div>
      <button class="ats-retry-btn" onclick="fetchAtsScore()">Try Again</button>
    </div>
  `;
}

function renderRateLimit(data) {
  const body = document.getElementById('atsBody');
  if (!body) return;
  body.innerHTML = `
    <div class="ats-rate-limit">
      <span class="ats-rate-icon"><i class="lucide lucide-hourglass" style="width:2.5rem;height:2.5rem;color:#f59e0b;"></i></span>
      <div class="ats-rate-text">Rate limit reached. Please wait before analyzing again.</div>
      <div class="ats-rate-sub">You can still edit your CV in the meantime.</div>
      <button class="ats-retry-btn" style="margin-top:1rem;" onclick="fetchAtsScore()">Check Again</button>
    </div>
  `;
}

// ========== CHECK GRAMMAR (AI Improve) ==========

async function checkGrammar(evt) {
  const cvTitle = document.querySelector('.cv-view-title')?.textContent || 'CV';
  if (!(await window.showConfirm('Use AI to improve your CV content? This will analyze your summary section for grammar, clarity, and impact.', 'AI Improvement', 'info'))) return;

  const clickedBtn = evt?.target?.closest?.('button');
  const btn = clickedBtn || document.querySelector('.cv-action-btn .lucide-check-circle')?.closest('.cv-action-btn');
  const originalBtnHtml = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="lucide lucide-hourglass"></i> Improving...'; }

  try {
    const resp = await fetch('/cv-builder/' + cvId + '/ai/improve', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
      },
      body: JSON.stringify({ text: 'Review my CV for grammar and clarity improvements', type: 'sentence' })
    });

    const data = await resp.json();
    if (data && data.improved) {
      window.showMessage('AI suggestions ready! Check your summary section for improvements.', 'success');
    } else {
      window.showMessage('AI checked your CV. No major issues found.', 'info');
    }
  } catch (err) {
    console.error('Grammar check error:', err);
    window.showMessage('Grammar check failed. Please try again.', 'danger');
  }

  if (btn) { btn.disabled = false; btn.innerHTML = originalBtnHtml; }
}

// ========== COVER LETTER GENERATOR ==========

function openCoverLetter() {
  const overlay = document.getElementById('clOverlay');
  if (!overlay) return;
  overlay.style.display = 'flex';
  resetCoverLetterForm();
}

function closeCoverLetter() {
  const overlay = document.getElementById('clOverlay');
  if (overlay) overlay.style.display = 'none';
}

function resetCoverLetterForm() {
  document.getElementById('clForm').style.display = 'block';
  document.getElementById('clResult').style.display = 'none';
  document.getElementById('clLoading').style.display = 'none';
  document.getElementById('clError').style.display = 'none';
  document.getElementById('clGenerateBtn').disabled = false;
  document.getElementById('clGenerateBtn').innerHTML = '<i class="lucide lucide-sparkles"></i> Generate Cover Letter';
}

async function generateCoverLetter() {
  const company = document.getElementById('clCompany').value.trim();
  const jobTitle = document.getElementById('clJobTitle').value.trim();
  const jobDesc = document.getElementById('clJobDesc').value.trim();

  if (!company) {
    document.getElementById('clCompany').focus();
    document.getElementById('clCompany').style.borderColor = '#dc2626';
    return;
  }
  if (!jobTitle) {
    document.getElementById('clJobTitle').focus();
    document.getElementById('clJobTitle').style.borderColor = '#dc2626';
    return;
  }

  // Show loading
  document.getElementById('clForm').style.display = 'none';
  document.getElementById('clResult').style.display = 'none';
  document.getElementById('clError').style.display = 'none';
  document.getElementById('clLoading').style.display = 'block';

  try {
    const resp = await fetch('/cv-builder/' + cvId + '/ai/cover-letter', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
      },
      body: JSON.stringify({
        company_name: company,
        job_title: jobTitle,
        job_description: jobDesc
      })
    });

    const data = await resp.json();

    if (!resp.ok || data.error) {
      throw new Error(data.error || 'Failed to generate cover letter');
    }

    const letter = data.cover_letter || '';
    if (!letter) {
      throw new Error('No cover letter was generated. Please try again.');
    }

    // Display result
    document.getElementById('clLoading').style.display = 'none';
    document.getElementById('clLetterContent').textContent = letter;

    // Meta info
    var metaHtml = '';
    if (data.word_count) {
      metaHtml += '<span><i class="lucide lucide-file-text" style="width:12px;height:12px;vertical-align:middle;"></i> ' + data.word_count + ' words</span>';
    }
    if (data.generated_at) {
      metaHtml += '<span><i class="lucide lucide-clock" style="width:12px;height:12px;vertical-align:middle;"></i> ' + new Date(data.generated_at).toLocaleTimeString() + '</span>';
    }
    document.getElementById('clMeta').innerHTML = metaHtml;

    document.getElementById('clResult').style.display = 'block';
  } catch (err) {
    console.error('Cover letter generation error:', err);
    document.getElementById('clLoading').style.display = 'none';
    document.getElementById('clErrorText').textContent = err.message || 'Failed to generate cover letter. Please try again.';
    document.getElementById('clError').style.display = 'block';
  }
}

function copyCoverLetter(evt) {
  const content = document.getElementById('clLetterContent');
  if (!content) return;

  navigator.clipboard.writeText(content.textContent).then(function() {
    const btn = evt?.target?.closest('button') || evt?.target;
    const original = btn.innerHTML;
    btn.innerHTML = '<i class="lucide lucide-check" style="width:14px;height:14px;"></i> Copied!';
    setTimeout(function() { btn.innerHTML = original; }, 2000);
  }).catch(function() {
    // Fallback
    const range = document.createRange();
    range.selectNode(content);
    window.getSelection().removeAllRanges();
    window.getSelection().addRange(range);
    document.execCommand('copy');
    window.getSelection().removeAllRanges();
  });
}

function downloadCoverLetter() {
  const content = document.getElementById('clLetterContent');
  if (!content || !content.textContent) return;

  const company = document.getElementById('clCompany').value.trim() || 'Company';
  const job = document.getElementById('clJobTitle').value.trim() || 'Position';

  const blob = new Blob([content.textContent], { type: 'text/plain;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'Cover_Letter_' + company.replace(/[^a-zA-Z0-9]/g, '_') + '_' + job.replace(/[^a-zA-Z0-9]/g, '_') + '.txt';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function escapeHtml(text) {
  if (!text) return '';
  const div = document.createElement('div');
  div.textContent = String(text);
  return div.innerHTML;
}
</script>
