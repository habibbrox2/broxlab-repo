<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ cv.full_name|default('CV') }} - {{ cv.job_title|default('Professional') }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                    colors: { glass: { 400: '#8B5CF6', 500: '#7C3AED', 600: '#6D28D9' } }
                }
            }
        }
    </script>
    <style>
        @media print { @page { size: A4; margin: 0; } body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } .no-print { display: none !important; } }
        body { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .glass-card { background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.3); }
        .glass-card-solid { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.5); }
    </style>
</head>
<body class="font-sans text-gray-800 min-h-screen py-6 px-4">

<div class="max-w-[210mm] mx-auto shadow-2xl" style="min-height: 297mm;">
    <div class="glass-card-solid rounded-2xl overflow-hidden">
        <!-- Glass Header -->
        <div class="relative px-10 pt-10 pb-8 overflow-hidden">
            <div class="absolute top-0 right-0 w-72 h-72 bg-gradient-to-br from-glass-400/20 to-purple-500/20 rounded-full -mr-20 -mt-20 blur-2xl"></div>
            <div class="absolute bottom-0 left-0 w-48 h-48 bg-gradient-to-tr from-blue-400/20 to-glass-400/20 rounded-full -ml-10 -mb-10 blur-xl"></div>
            <div class="relative flex items-center gap-6">
                <div class="w-28 h-28 rounded-full bg-white/40 border-2 border-white/60 flex items-center justify-center flex-shrink-0 shadow-lg overflow-hidden">
                    {% if cv.profile_photo %}
                    <img src="{{ cv.profile_photo }}" alt="{{ cv.full_name|default('Profile') }}" class="w-full h-full object-cover">
                    {% else %}
                    <svg class="w-16 h-16 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    {% endif %}
                </div>
                <div class="flex-1">
                    <h1 class="text-3xl font-bold text-gray-900 tracking-tight">{{ cv.full_name|default('Your Name') }}</h1>
                    <p class="text-lg text-glass-600 font-semibold mt-1">{{ cv.job_title|default('Professional Title') }}</p>
                    <div class="flex flex-wrap gap-4 mt-3 text-sm text-gray-600">
                        {% if cv.linkedin %}
                        <a href="{{ cv.linkedin }}" class="flex items-center gap-1.5 hover:text-glass-600 transition-colors" target="_blank">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h14m-.5 15.5v-5.3a3.26 3.26 0 00-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 011.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 001.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 00-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
                            LinkedIn
                        </a>
                        {% endif %}
                        {% if cv.github %}
                        <a href="{{ cv.github }}" class="flex items-center gap-1.5 hover:text-glass-600 transition-colors" target="_blank">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                            GitHub
                        </a>
                        {% endif %}
                        {% if cv.portfolio %}
                        <a href="{{ cv.portfolio }}" class="flex items-center gap-1.5 hover:text-glass-600 transition-colors" target="_blank">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
                            Portfolio
                        </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="px-10 pb-10 flex gap-6">
            <!-- Glass Sidebar -->
            <aside class="w-[220px] flex-shrink-0">
                <!-- START SIDEBAR -->
                <div class="glass-card rounded-xl p-5 mb-5">
                    <h3 class="text-xs font-bold text-glass-600 uppercase tracking-widest mb-3">Contact</h3>
                    <div class="space-y-2.5 text-xs text-gray-600">
                        {% if cv.email %}
                        <div class="flex items-start gap-2">
                            <svg class="w-3.5 h-3.5 text-glass-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            <span class="break-all">{{ cv.email }}</span>
                        </div>
                        {% endif %}
                        {% if cv.phone %}
                        <div class="flex items-start gap-2">
                            <svg class="w-3.5 h-3.5 text-glass-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                            <span>{{ cv.phone }}</span>
                        </div>
                        {% endif %}
                        {% if cv.location %}
                        <div class="flex items-start gap-2">
                            <svg class="w-3.5 h-3.5 text-glass-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243A8 8 0 1117.657 16.657z"/><circle cx="12" cy="11" r="1.5" fill="currentColor"/></svg>
                            <span>{{ cv.location }}</span>
                        </div>
                        {% endif %}
                    </div>
                </div>

                {% set techSkills = [] %}
                {% for section in sections %}
                    {% if section.section_type == 'skills' %}
                        {% for item in section.items %}
                            {% set techSkills = techSkills|merge([item.content.name]) %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}
                {% if techSkills|length > 0 %}
                <div class="glass-card rounded-xl p-5 mb-5">
                    <h3 class="text-xs font-bold text-glass-600 uppercase tracking-widest mb-3">Skills</h3>
                    <div class="space-y-2">
                        {% for skill in techSkills|slice(0, 6) %}
                        <div><div class="flex justify-between text-xs mb-0.5"><span>{{ skill }}</span><span class="text-glass-600 font-medium">{{ 100 - (loop.index0 * 6) }}%</span></div><div class="h-1 bg-white/50 rounded-full"><div class="h-1 bg-glass-500 rounded-full" style="width:{{ 100 - (loop.index0 * 6) }}%"></div></div></div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {% set langSection = sections|filter(s => s.section_type == 'languages')|first %}
                {% if langSection and langSection.items|length > 0 %}
                <div class="glass-card rounded-xl p-5">
                    <h3 class="text-xs font-bold text-glass-600 uppercase tracking-widest mb-3">Languages</h3>
                    <div class="space-y-1.5 text-xs text-gray-600">
                        {% for item in langSection.items %}
                        <div class="flex justify-between"><span>{{ item.content.name|default('') }}</span><span class="text-glass-600 font-medium">{{ item.content.proficiency|default('Fluent') }}</span></div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                <!-- END SIDEBAR -->
            </aside>

            <!-- Main -->
            <main class="flex-1">
                {% for section in sections %}
                {% if section.section_type == 'summary' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-glass-600 uppercase tracking-widest mb-2">Professional Summary</h2>
                    {% for item in section.items %}
                    <p class="text-sm text-gray-600 leading-relaxed">{{ item.content.summary|default(item.content.text|default('')) }}</p>
                    {% endfor %}
                </section>
                {% endif %}

                {% if section.section_type == 'experience' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-glass-600 uppercase tracking-widest mb-3">Work Experience</h2>
                    {% for item in section.items %}
                    <!-- START EXPERIENCE -->
                    <div class="mb-4">
                        <div class="flex justify-between items-start mb-1">
                            <div>
                                <h3 class="font-bold text-gray-900">{{ item.content.position|default('Position') }}</h3>
                                <p class="text-sm text-glass-600 font-medium">{{ item.content.company|default('') }}</p>
                            </div>
                            <span class="text-xs text-gray-500 font-medium whitespace-nowrap">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                        </div>
                        <p class="text-sm text-gray-600 mt-1 leading-relaxed">{{ item.content.description|default('') }}</p>
                    </div>
                    <!-- END EXPERIENCE -->
                    {% endfor %}
                </section>
                {% endif %}

                {% if section.section_type == 'education' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-glass-600 uppercase tracking-widest mb-3">Education</h2>
                    {% for item in section.items %}
                    <!-- START EDUCATION -->
                    <div class="mb-3 flex justify-between items-baseline">
                        <div>
                            <h3 class="font-bold text-gray-900">{{ item.content.degree|default('Degree') }}</h3>
                            <p class="text-sm text-gray-600">{{ item.content.institution|default('') }}</p>
                        </div>
                        <span class="text-xs text-gray-500 font-medium">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                    </div>
                    <!-- END EDUCATION -->
                    {% endfor %}
                </section>
                {% endif %}

                {% if section.section_type == 'projects' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-glass-600 uppercase tracking-widest mb-3">Projects</h2>
                    <!-- START PROJECTS -->
                    <div class="grid grid-cols-2 gap-3">
                        {% for item in section.items %}
                        <div class="glass-card rounded-lg p-3">
                            <h4 class="font-bold text-sm text-gray-900">{{ item.content.name|default('Project') }}</h4>
                            <p class="text-xs text-gray-500 mt-0.5">{{ item.content.description|default('') }}</p>
                            {% if item.content.technologies %}
                            <span class="text-xs text-glass-600 font-semibold mt-1 inline-block">{{ item.content.technologies }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                    <!-- END PROJECTS -->
                </section>
                {% endif %}

                {% if section.section_type == 'certifications' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-glass-600 uppercase tracking-widest mb-3">Certificates</h2>
                    <!-- START CERTIFICATES -->
                    <div class="space-y-2">
                        {% for item in section.items %}
                        <div class="glass-card rounded-lg p-3">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h4 class="font-bold text-sm text-gray-900">{{ item.content.name|default('Certificate') }}</h4>
                                    {% if item.content.organization %}<p class="text-xs text-gray-500">{{ item.content.organization }}{% if item.content.date %} | {{ item.content.date }}{% endif %}</p>{% endif %}
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    <!-- END CERTIFICATES -->
                </section>
                {% endif %}
                {% endfor %}

                <footer class="mt-6 pt-4 border-t border-gray-200/60 text-xs text-gray-400 flex justify-between items-center no-print">
                    <span>Reference available upon request</span>
                    <span>{{ cv.full_name|default('Applicant') }}{% if cv.email %} | {{ cv.email }}{% endif %}</span>
                </footer>
            </main>
        </div>
    </div>
</div>

</body>
</html>
