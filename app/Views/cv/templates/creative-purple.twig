<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ cv.full_name|default('CV') }} - {{ cv.job_title|default('Professional') }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'], display: ['Space Grotesk', 'sans-serif'] },
                    colors: { creative: { 400: '#A855F7', 500: '#9333EA', 600: '#7C3AED', 900: '#581C87' } }
                }
            }
        }
    </script>
    <style>
        @media print { @page { size: A4; margin: 0; } body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } .no-print { display: none !important; } }
        .creative-gradient { background: linear-gradient(135deg, #7C3AED 0%, #A855F7 50%, #EC4899 100%); }
        .glass-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); }
    </style>
</head>
<body class="font-sans text-gray-800 bg-gray-100 min-h-screen">

<div class="max-w-[210mm] mx-auto shadow-2xl my-4 overflow-hidden" style="min-height: 297mm;">
    <!-- Creative Header -->
    <div class="creative-gradient relative px-10 pt-10 pb-16 text-white">
        <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -mr-20 -mt-20"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/10 rounded-full -ml-10 -mb-10"></div>
        <div class="relative flex items-end justify-between">
            <div class="flex-1">
                <p class="text-white/80 text-sm font-medium mb-2 tracking-widest uppercase font-display">Portfolio 2024</p>
                <h1 class="text-4xl font-display font-bold tracking-tight">{{ cv.full_name|default('Your Name') }}</h1>
                <p class="text-xl text-white/90 mt-1 font-medium">{{ cv.job_title|default('Professional Title') }}</p>
                <div class="flex flex-wrap gap-4 mt-4 text-sm text-white/80">
                    {% if cv.linkedin %}
                    <a href="{{ cv.linkedin }}" class="flex items-center gap-1.5 hover:text-white transition-colors" target="_blank">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h14m-.5 15.5v-5.3a3.26 3.26 0 00-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 011.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 001.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 00-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
                        LinkedIn
                    </a>
                    {% endif %}
                    {% if cv.github %}
                    <a href="{{ cv.github }}" class="flex items-center gap-1.5 hover:text-white transition-colors" target="_blank">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                        GitHub
                    </a>
                    {% endif %}
                    {% if cv.portfolio %}
                    <a href="{{ cv.portfolio }}" class="flex items-center gap-1.5 hover:text-white transition-colors" target="_blank">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
                        Portfolio
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="px-10 pb-10 -mt-6 relative">
        <!-- Contact Cards Row -->
        <div class="flex gap-4 mb-8">
            {% if cv.email %}
            <div class="glass-card rounded-xl px-5 py-3 flex-1 flex items-center gap-3 border border-white/50 shadow-sm">
                <svg class="w-5 h-5 text-creative-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <span class="text-sm text-gray-600 break-all">{{ cv.email }}</span>
            </div>
            {% endif %}
            {% if cv.phone %}
            <div class="glass-card rounded-xl px-5 py-3 flex-1 flex items-center gap-3 border border-white/50 shadow-sm">
                <svg class="w-5 h-5 text-creative-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                <span class="text-sm text-gray-600">{{ cv.phone }}</span>
            </div>
            {% endif %}
            {% if cv.location %}
            <div class="glass-card rounded-xl px-5 py-3 flex-1 flex items-center gap-3 border border-white/50 shadow-sm">
                <svg class="w-5 h-5 text-creative-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243A8 8 0 1117.657 16.657z"/><circle cx="12" cy="11" r="1.5" fill="currentColor"/></svg>
                <span class="text-sm text-gray-600">{{ cv.location }}</span>
            </div>
            {% endif %}
        </div>

        <div class="flex gap-8">
            <!-- Left Info -->
            <div class="w-[220px] flex-shrink-0">
                {% set techSkills = [] %}
                {% for section in sections %}
                    {% if section.section_type == 'skills' %}
                        {% for item in section.items %}
                            {% set techSkills = techSkills|merge([item.content.name]) %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}
                {% if techSkills|length > 0 %}
                <div class="mb-6">
                    <h3 class="text-xs font-bold text-creative-600 uppercase tracking-widest mb-3 font-display">Skills</h3>
                    <div class="flex flex-wrap gap-2">
                        {% for skill in techSkills %}
                        <span class="px-3 py-1.5 bg-creative-500/10 text-creative-700 rounded-full text-xs font-medium border border-creative-500/20">{{ skill }}</span>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {% set langSection = sections|filter(s => s.section_type == 'languages')|first %}
                {% if langSection and langSection.items|length > 0 %}
                <div class="mb-6">
                    <h3 class="text-xs font-bold text-creative-600 uppercase tracking-widest mb-3 font-display">Languages</h3>
                    <div class="space-y-2">
                        {% for item in langSection.items %}
                        <div class="flex justify-between items-center">
                            <span class="text-sm text-gray-700 font-medium">{{ item.content.name|default('') }}</span>
                            <span class="text-xs text-creative-600 font-semibold bg-creative-500/10 px-2 py-0.5 rounded-full">{{ item.content.proficiency|default('Fluent') }}</span>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>

            <!-- Main Content -->
            <main class="flex-1">
                {% for section in sections %}
                {% if section.section_type == 'summary' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-creative-600 uppercase tracking-widest mb-3 font-display">Professional Summary</h2>
                    {% for item in section.items %}
                    <p class="text-sm text-gray-600 leading-relaxed">{{ item.content.summary|default(item.content.text|default('')) }}</p>
                    {% endfor %}
                </section>
                {% endif %}

                {% if section.section_type == 'experience' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-creative-600 uppercase tracking-widest mb-4 font-display">Work Experience</h2>
                    {% for item in section.items %}
                    <!-- START EXPERIENCE -->
                    <div class="glass-card rounded-xl p-4 mb-4 border border-white/50 shadow-sm">
                        <div class="flex justify-between items-start mb-1">
                            <div>
                                <h3 class="font-bold text-gray-900">{{ item.content.position|default('Position') }}</h3>
                                <p class="text-sm text-creative-600 font-medium">{{ item.content.company|default('') }}</p>
                            </div>
                            <span class="text-xs text-gray-500 font-medium whitespace-nowrap">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                        </div>
                        <p class="text-sm text-gray-600 mt-2 leading-relaxed">{{ item.content.description|default('') }}</p>
                    </div>
                    <!-- END EXPERIENCE -->
                    {% endfor %}
                </section>
                {% endif %}

                {% if section.section_type == 'education' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-creative-600 uppercase tracking-widest mb-4 font-display">Education</h2>
                    {% for item in section.items %}
                    <!-- START EDUCATION -->
                    <div class="glass-card rounded-xl p-4 mb-3 border border-white/50 shadow-sm">
                        <div class="flex justify-between items-start">
                            <div>
                                <h3 class="font-bold text-gray-900">{{ item.content.degree|default('Degree') }}</h3>
                                <p class="text-sm text-gray-600">{{ item.content.institution|default('') }}</p>
                            </div>
                            <span class="text-xs text-gray-500 font-medium">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                        </div>
                        {% if item.content.gpa or item.content.field %}
                        <p class="text-sm text-gray-500 mt-1">{{ item.content.field ? ('Focus: ' ~ item.content.field) : '' }}{% if item.content.gpa and item.content.field %} | {% endif %}{% if item.content.gpa %}GPA: {{ item.content.gpa }}{% endif %}</p>
                        {% endif %}
                    </div>
                    <!-- END EDUCATION -->
                    {% endfor %}
                </section>
                {% endif %}

                {% if section.section_type == 'projects' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-creative-600 uppercase tracking-widest mb-4 font-display">Projects</h2>
                    <!-- START PROJECTS -->
                    <div class="grid grid-cols-2 gap-4">
                        {% for item in section.items %}
                        <div class="glass-card rounded-xl p-4 border border-white/50 shadow-sm">
                            <h4 class="font-bold text-sm text-gray-900">{{ item.content.name|default('Project') }}</h4>
                            <p class="text-xs text-gray-500 mt-1">{{ item.content.description|default('') }}</p>
                            {% if item.content.technologies %}
                            <span class="text-xs text-creative-600 font-semibold mt-2 inline-block">{{ item.content.technologies }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                    <!-- END PROJECTS -->
                </section>
                {% endif %}

                {% if section.section_type == 'certifications' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-creative-600 uppercase tracking-widest mb-4 font-display">Certificates</h2>
                    <!-- START CERTIFICATES -->
                    <div class="space-y-3">
                        {% for item in section.items %}
                        <div class="glass-card rounded-xl p-4 border border-white/50 shadow-sm">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h4 class="font-bold text-sm text-gray-900">{{ item.content.name|default('Certificate') }}</h4>
                                    {% if item.content.organization %}<p class="text-xs text-gray-500">{{ item.content.organization }}{% if item.content.date %} | {{ item.content.date }}{% endif %}</p>{% endif %}
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    <!-- END CERTIFICATES -->
                </section>
                {% endif %}
                {% endfor %}

                <footer class="mt-8 pt-4 border-t border-gray-200 text-xs text-gray-400 flex justify-between items-center no-print">
                    <span>Reference available upon request</span>
                    <span>{{ cv.full_name|default('Applicant') }}{% if cv.email %} | {{ cv.email }}{% endif %}</span>
                </footer>
            </main>
        </div>
    </div>
</div>

</body>
</html>
