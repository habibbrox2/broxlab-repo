<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>{{ cv.title }}</title>
 <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
 <style>
 * { margin: 0; padding: 0; box-sizing: border-box; }
 body { font-family: 'Inter', 'Arial', sans-serif; font-size: 10.5pt; line-height: 1.5; color: #1F2937; background: white; }
 .cv-container { max-width: 210mm; margin: 0 auto; padding: 18mm 22mm; }
 .cv-header { text-align: center; margin-bottom: 24px; padding-bottom: 18px; border-bottom: 1px solid #D1D5DB; }
 .cv-photo-wrapper { display: flex; justify-content: center; margin-bottom: 14px; }
 .cv-photo { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 2px solid #D1D5DB; background: #F3F4F6; display: flex; align-items: center; justify-content: center; }
 .cv-photo img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
 .cv-photo-placeholder { font-size: 1.5rem; color: #9CA3AF; font-weight: 300; }
 .cv-name { font-family: 'Cormorant Garamond', serif; font-size: 24pt; font-weight: 600; color: #111827; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 4px; }
 .cv-job-title { font-size: 10pt; color: #6B7280; font-weight: 400; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px; }
 .cv-contact { display: flex; justify-content: center; flex-wrap: wrap; gap: 16px; color: #9CA3AF; font-size: 8.5pt; letter-spacing: 0.5px; }
 .contact-item { display: flex; align-items: center; gap: 4px; }
 .cv-section { margin-bottom: 18px; page-break-inside: avoid; }
 .section-title { font-family: 'Cormorant Garamond', serif; font-size: 13pt; font-weight: 600; color: #374151; text-transform: uppercase; letter-spacing: 3px; margin-bottom: 8px; padding-bottom: 4px; border-bottom: 1px solid #E5E7EB; }
 .cv-item { margin-bottom: 10px; page-break-inside: avoid; }
 .item-header { display: flex; justify-content: space-between; align-items: baseline; }
 .item-title { font-weight: 500; color: #1F2937; }
 .item-subtitle { color: #6B7280; font-size: 9.5pt; }
 .item-date { color: #9CA3AF; font-size: 8pt; white-space: nowrap; }
 .item-description { color: #4B5563; font-size: 9.5pt; margin-top: 3px; line-height: 1.5; }
 .item-description ul { margin-left: 14px; margin-top: 2px; }
 .skills-list { font-size: 9.5pt; color: #4B5563; }
 .skills-list span:not(:last-child)::after { content: ' \00B7 '; color: #D1D5DB; }
 .summary-text { font-size: 10pt; line-height: 1.6; color: #4B5563; }
 @media print {
   body { font-size: 9.5pt; }
   .cv-container { padding: 0; max-width: 100%; }
   .cv-section { page-break-inside: avoid; }
   .cv-item { page-break-inside: avoid; }
 }
 </style>
</head>
<body>
<div class="cv-container">
  <header class="cv-header">
    {% set photo_url = cv.profile_photo|default('') %}
    <div class="cv-photo-wrapper">
      {% if photo_url %}
      <div class="cv-photo"><img src="{{ photo_url }}" alt="{{ cv.title }}" /></div>
      {% else %}
      <div class="cv-photo"><span class="cv-photo-placeholder">{{ (cv.title|first)|default('?')|upper }}</span></div>
      {% endif %}
    </div>
    <h1 class="cv-name">{{ cv.title }}</h1>
    {% for section in sections if section.section_type == 'summary' %}
      {% for item in section.items %}
        {% if item.content.job_title %}<div class="cv-job-title">{{ item.content.job_title }}</div>{% endif %}
      {% endfor %}
    {% endfor %}
    <div class="cv-contact">
      {% for section in sections if section.section_type == 'summary' %}
        {% for item in section.items %}
          {% if item.content.email %}<span class="contact-item">&#9993; {{ item.content.email }}</span>{% endif %}
          {% if item.content.phone %}<span class="contact-item">&#9742; {{ item.content.phone }}</span>{% endif %}
          {% if item.content.location %}<span class="contact-item">&#128205; {{ item.content.location }}</span>{% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </header>
  {% for section in sections %}
  <section class="cv-section">
    <h2 class="section-title">{{ section.title }}</h2>
    {% if section.section_type == 'summary' %}
      {% for item in section.items %}
      <div class="summary-text">{{ item.content.text|default(item.content.summary|default('')) }}</div>
      {% endfor %}
    {% elseif section.section_type == 'experience' %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="item-header">
          <div><span class="item-title">{{ item.content.position|default('Position') }}</span>{% if item.content.company %} <span class="item-subtitle">&mdash; {{ item.content.company }}</span>{% endif %}</div>
          <span class="item-date">{{ item.content.start_date|default('') }} &ndash; {{ item.content.end_date|default('Present') }}</span>
        </div>
        {% if item.content.description %}<div class="item-description">{{ item.content.description|nl2br }}</div>{% endif %}
      </div>
      {% endfor %}
    {% elseif section.section_type == 'education' %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="item-header">
          <div><span class="item-title">{{ item.content.degree|default('Degree') }}{% if item.content.field %} in {{ item.content.field }}{% endif %}</span> <span class="item-subtitle">&mdash; {{ item.content.institution|default('') }}</span></div>
          <span class="item-date">{{ item.content.start_date|default('') }} &ndash; {{ item.content.end_date|default('') }}</span>
        </div>
      </div>
      {% endfor %}
    {% elseif section.section_type == 'skills' %}
      <div class="skills-list">
      {% for item in section.items %}
        {% set skills_list = item.content.skills|default(item.content.name ? [item.content.name] : []) %}
        {% for s in skills_list %}<span>{{ s }}</span>{% endfor %}
      {% endfor %}
      </div>
    {% elseif section.section_type == 'languages' %}
      <div class="skills-list">
      {% for item in section.items %}
        <span>{{ item.content.name }} ({{ item.content.proficiency|default('') }})</span>
      {% endfor %}
      </div>
    {% elseif section.section_type == 'projects' %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="item-title">{{ item.content.name|default('Project') }}</div>
        {% if item.content.description %}<div class="item-description">{{ item.content.description|nl2br }}</div>{% endif %}
      </div>
      {% endfor %}
    {% elseif section.section_type == 'certifications' %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="item-header">
          <div><span class="item-title">{{ item.content.name|default('') }}</span> <span class="item-subtitle">&mdash; {{ item.content.issuer|default('') }}</span></div>
          {% if item.content.date %}<span class="item-date">{{ item.content.date }}</span>{% endif %}
        </div>
      </div>
      {% endfor %}
    {% elseif section.section_type == 'references' %}
      {% for item in section.items %}
      <div class="cv-item">
        <span class="item-title">{{ item.content.name }}</span>{% if item.content.title %} &mdash; <span class="item-subtitle">{{ item.content.title }}{% if item.content.company %} at {{ item.content.company }}{% endif %}</span>{% endif %}
      </div>
      {% endfor %}
    {% elseif section.section_type == 'social_links' %}
      <div class="skills-list">
      {% for item in section.items %}
        <span>{{ item.content.platform }}: {{ item.content.url }}</span>
      {% endfor %}
      </div>
    {% else %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="item-title">{{ item.content.title|default(item.content.name|default('')) }}</div>
        {% if item.content.description or item.content.content %}<div class="item-description">{{ (item.content.description|default(item.content.content|default('')))|nl2br }}</div>{% endif %}
      </div>
      {% endfor %}
    {% endif %}
  </section>
  {% endfor %}
</div>
</body>
</html>
