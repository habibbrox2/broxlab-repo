<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ cv.full_name|default('CV') }} - {{ cv.job_title|default('Professional') }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>tailwind.config={theme:{extend:{fontFamily:{sans:['Inter','system-ui','sans-serif'],jp:['Noto Sans JP','sans-serif']},colors:{jp:{400:'#78716C',500:'#57534E',600:'#44403C',900:'#1C1917',50:'#FAFAF9',100:'#F5F5F4'}}}}}</script>
    <style>
        @media print { @page { size: A4; margin: 0; } body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } .no-print { display: none !important; } }
        body { background: #FAFAF9; }
    </style>
</head>
<body class="font-sans text-gray-800 min-h-screen">

<div class="max-w-[210mm] mx-auto bg-white shadow-lg my-4" style="min-height: 297mm;">
    <!-- Japanese Minimal Header -->
    <header class="px-12 pt-12 pb-8 text-center">
        <div class="w-20 h-20 rounded-full bg-gray-100 mx-auto mb-5 flex items-center justify-center overflow-hidden">
            {% if cv.profile_photo %}
            <img src="{{ cv.profile_photo }}" alt="{{ cv.full_name|default('Profile') }}" class="w-full h-full object-cover">
            {% else %}
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            {% endif %}
        </div>
        <h1 class="text-2xl font-light text-gray-900 tracking-wide font-jp">{{ cv.full_name|default('Your Name') }}</h1>
        <p class="text-sm text-gray-500 mt-1 font-light">{{ cv.job_title|default('Professional Title') }}</p>
        <div class="flex justify-center gap-6 mt-4 text-xs text-gray-400 font-light">
            {% if cv.email %}<span>{{ cv.email }}</span>{% endif %}
            {% if cv.email and cv.phone %}<span class="text-gray-300">|</span>{% endif %}
            {% if cv.phone %}<span>{{ cv.phone }}</span>{% endif %}
            {% if cv.phone and cv.location %}<span class="text-gray-300">|</span>{% endif %}
            {% if cv.location %}<span>{{ cv.location }}</span>{% endif %}
        </div>
        <div class="w-8 h-px bg-gray-300 mx-auto mt-6"></div>
    </header>

    <div class="px-12 pb-12">
        {% for section in sections %}
        {% if section.section_type == 'summary' and section.is_visible %}
        <section class="mb-8 text-center">
            <h2 class="text-xs font-medium text-gray-400 uppercase tracking-widest mb-3 font-jp">Professional Summary</h2>
            {% for item in section.items %}
            <p class="text-sm text-gray-600 leading-relaxed font-light max-w-lg mx-auto">{{ item.content.summary|default(item.content.text|default('')) }}</p>
            {% endfor %}
        </section>
        {% endif %}
        {% endfor %}

        <div class="grid grid-cols-2 gap-12">
            <!-- Experience -->
            <section>
                {% for section in sections %}
                {% if section.section_type == 'experience' and section.is_visible %}
                <h2 class="text-xs font-medium text-gray-400 uppercase tracking-widest mb-4 font-jp text-center">Work Experience</h2>
                {% for item in section.items %}
                <!-- START EXPERIENCE -->
                <div class="mb-5 text-center">
                    <h3 class="font-medium text-gray-900 text-sm">{{ item.content.position|default('Position') }}</h3>
                    <p class="text-xs text-gray-500">{{ item.content.company|default('') }}</p>
                    <span class="text-xs text-gray-400">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                    <p class="text-xs text-gray-500 mt-1 leading-relaxed">{{ item.content.description|default('') }}</p>
                </div>
                <!-- END EXPERIENCE -->
                {% endfor %}
                {% endif %}
                {% endfor %}
            </section>

            <!-- Education -->
            <section>
                {% for section in sections %}
                {% if section.section_type == 'education' and section.is_visible %}
                <h2 class="text-xs font-medium text-gray-400 uppercase tracking-widest mb-4 font-jp text-center">Education</h2>
                {% for item in section.items %}
                <!-- START EDUCATION -->
                <div class="mb-5 text-center">
                    <h3 class="font-medium text-gray-900 text-sm">{{ item.content.degree|default('Degree') }}</h3>
                    <p class="text-xs text-gray-500">{{ item.content.institution|default('') }}</p>
                    <span class="text-xs text-gray-400">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                    {% if item.content.gpa %}<p class="text-xs text-gray-400 mt-1">GPA: {{ item.content.gpa }}</p>{% endif %}
                </div>
                <!-- END EDUCATION -->
                {% endfor %}
                {% endif %}
                {% endfor %}
            </section>
        </div>

        <!-- Skills -->
        {% set techSkills = [] %}
        {% for section in sections %}
            {% if section.section_type == 'skills' %}
                {% for item in section.items %}
                    {% set techSkills = techSkills|merge([item.content.name]) %}
                {% endfor %}
            {% endif %}
        {% endfor %}
        {% if techSkills|length > 0 %}
        <section class="mt-8 text-center">
            <h2 class="text-xs font-medium text-gray-400 uppercase tracking-widest mb-4 font-jp">Skills</h2>
            <div class="flex flex-wrap justify-center gap-2">
                {% for skill in techSkills %}
                <span class="px-3 py-1 bg-gray-50 text-gray-600 rounded text-xs border border-gray-200 font-light">{{ skill }}</span>
                {% endfor %}
            </div>
        </section>
        {% endif %}

        <!-- Projects & Certificates -->
        {% for section in sections %}
        {% if section.section_type == 'projects' and section.is_visible %}
        <section class="mt-8 text-center">
            <h2 class="text-xs font-medium text-gray-400 uppercase tracking-widest mb-4 font-jp">Projects</h2>
            <div class="grid grid-cols-2 gap-4">
                {% for item in section.items %}
                <div class="text-center">
                    <h3 class="font-medium text-gray-900 text-sm">{{ item.content.name|default('Project') }}</h3>
                    <p class="text-xs text-gray-500 mt-1">{{ item.content.description|default('') }}</p>
                    {% if item.content.technologies %}
                    <span class="text-xs text-gray-400 mt-1 inline-block">{{ item.content.technologies }}</span>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </section>
        {% endif %}

        {% if section.section_type == 'certifications' and section.is_visible %}
        <section class="mt-8 text-center">
            <h2 class="text-xs font-medium text-gray-400 uppercase tracking-widest mb-4 font-jp">Certificates</h2>
            <div class="space-y-2">
                {% for item in section.items %}
                <p class="text-sm text-gray-600"><span class="font-medium">{{ item.content.name|default('Certificate') }}</span>{% if item.content.organization %} — {{ item.content.organization }}{% endif %}{% if item.content.date %} ({{ item.content.date }}){% endif %}</p>
                {% endfor %}
            </div>
        </section>
        {% endif %}
        {% endfor %}

        <!-- Languages -->
        {% set langSection = sections|filter(s => s.section_type == 'languages')|first %}
        {% if langSection and langSection.items|length > 0 %}
        <section class="mt-8 text-center">
            <h2 class="text-xs font-medium text-gray-400 uppercase tracking-widest mb-4 font-jp">Languages</h2>
            <div class="flex flex-wrap justify-center gap-2">
                {% for item in langSection.items %}
                <span class="px-3 py-1 bg-gray-50 text-gray-600 rounded text-xs border border-gray-200 font-light">{{ item.content.name|default('') }} ({{ item.content.proficiency|default('Fluent') }})</span>
                {% endfor %}
            </div>
        </section>
        {% endif %}

        <footer class="mt-8 pt-4 border-t border-gray-100 text-xs text-gray-300 flex justify-between items-center no-print">
            <span>Reference available upon request</span>
            <span>{{ cv.full_name|default('Applicant') }}{% if cv.email %} | {{ cv.email }}{% endif %}</span>
        </footer>
    </div>
</div>

</body>
</html>
