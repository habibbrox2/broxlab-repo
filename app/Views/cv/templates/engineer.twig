<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ cv.full_name|default('CV') }} - {{ cv.job_title|default('Professional') }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>tailwind.config={theme:{extend:{fontFamily:{sans:['Inter','system-ui','sans-serif']},colors:{engineer:{400:'#0EA5E9',500:'#0284C7',600:'#0369A1',900:'#0C4A6E'}}}}}</script>
    <style>
        @media print { @page { size: A4; margin: 0; } body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } .no-print { display: none !important; } }
        .blueprint-bg { background-color: #F0F9FF; background-image: linear-gradient(#E0F2FE 1px, transparent 1px), linear-gradient(90deg, #E0F2FE 1px, transparent 1px); background-size: 20px 20px; }
    </style>
</head>
<body class="font-sans text-gray-800 min-h-screen">

<div class="max-w-[210mm] mx-auto bg-white shadow-xl my-4" style="min-height: 297mm;">
    <div class="blueprint-bg">
        <!-- Engineer Header -->
        <header class="bg-engineer-900 text-white px-10 py-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-5">
                    <div class="w-16 h-16 rounded-lg bg-white/10 border border-white/20 flex items-center justify-center overflow-hidden">
                        {% if cv.profile_photo %}
                        <img src="{{ cv.profile_photo }}" alt="{{ cv.full_name|default('Profile') }}" class="w-full h-full object-cover">
                        {% else %}
                        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12m-3.75.75h9.75m-9.75 0V19.5m9.75-3.75v3.75m0 0h3.75m-3.75 0h-3.75m3.75 0v-3.75m0 3.75v3.75m0-3.75h3.75m-3.75 0h-3.75"/>
                        </svg>
                        {% endif %}
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold tracking-tight">{{ cv.full_name|default('Your Name') }}</h1>
                        <p class="text-engineer-200 text-sm mt-0.5">{{ cv.job_title|default('Professional Title') }}</p>
                    </div>
                </div>
                <div class="text-right text-xs text-engineer-200">
                    {% if cv.location %}<p>{{ cv.location }}</p>{% endif %}
                    {% if cv.email %}<p>{{ cv.email }}</p>{% endif %}
                </div>
            </div>
        </header>

        <div class="px-10 py-8">
            <div class="flex gap-8">
                <!-- START SIDEBAR -->
                <aside class="w-[220px] flex-shrink-0">
                    <div class="bg-white rounded-lg p-5 border border-engineer-100 shadow-sm mb-5">
                        <h3 class="text-xs font-bold text-engineer-700 uppercase tracking-widest mb-3">Contact</h3>
                        <div class="space-y-2.5 text-xs text-gray-600">
                            {% if cv.email %}
                            <p class="flex items-center gap-2"><svg class="w-3.5 h-3.5 text-engineer-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg><span class="break-all">{{ cv.email }}</span></p>
                            {% endif %}
                            {% if cv.phone %}
                            <p class="flex items-center gap-2"><svg class="w-3.5 h-3.5 text-engineer-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>{{ cv.phone }}</p>
                            {% endif %}
                            {% if cv.website %}
                            <p class="flex items-center gap-2"><svg class="w-3.5 h-3.5 text-engineer-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>{{ cv.website }}</p>
                            {% endif %}
                        </div>
                    </div>

                    {% set techSkills = [] %}
                    {% for section in sections %}
                        {% if section.section_type == 'skills' %}
                            {% for item in section.items %}
                                {% set techSkills = techSkills|merge([item.content.name]) %}
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                    {% if techSkills|length > 0 %}
                    <div class="bg-white rounded-lg p-5 border border-engineer-100 shadow-sm mb-5">
                        <h3 class="text-xs font-bold text-engineer-700 uppercase tracking-widest mb-3">Technical Skills</h3>
                        <div class="space-y-2">
                            {% for skill in techSkills|slice(0, 6) %}
                            <div><div class="flex justify-between text-xs mb-0.5"><span>{{ skill }}</span><span class="text-engineer-600 font-medium">{{ 100 - (loop.index0 * 6) }}%</span></div><div class="h-1.5 bg-engineer-50 rounded-full"><div class="h-1.5 bg-engineer-500 rounded-full" style="width:{{ 100 - (loop.index0 * 6) }}%"></div></div></div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    {% set langSection = sections|filter(s => s.section_type == 'languages')|first %}
                    {% if langSection and langSection.items|length > 0 %}
                    <div class="bg-white rounded-lg p-5 border border-engineer-100 shadow-sm">
                        <h3 class="text-xs font-bold text-engineer-700 uppercase tracking-widest mb-3">Languages</h3>
                        <div class="space-y-1.5 text-xs text-gray-600">
                            {% for item in langSection.items %}
                            <div class="flex justify-between"><span>{{ item.content.name|default('') }}</span><span class="text-engineer-600 font-medium">{{ item.content.proficiency|default('Fluent') }}</span></div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}
                    <!-- END SIDEBAR -->
                </aside>

                <!-- START MAIN CONTENT -->
                <main class="flex-1">
                    {% for section in sections %}
                    {% if section.section_type == 'summary' and section.is_visible %}
                    <section class="mb-6">
                        <h2 class="text-xs font-bold text-engineer-700 uppercase tracking-widest mb-2 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            Professional Summary
                        </h2>
                        {% for item in section.items %}
                        <p class="text-sm text-gray-600 leading-relaxed">{{ item.content.summary|default(item.content.text|default('')) }}</p>
                        {% endfor %}
                    </section>
                    {% endif %}

                    {% if section.section_type == 'experience' and section.is_visible %}
                    <section class="mb-6">
                        <h2 class="text-xs font-bold text-engineer-700 uppercase tracking-widest mb-3 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.93 23.93 0 0112 21c-2.89 0-5.6-.936-7.74-2.55M9 6.75V3m6 3.75V3m-9 9.75h10.5a2.25 2.25 0 012.25 2.25v1.5A2.25 2.25 0 0117.25 19.5H6.75A2.25 2.25 0 014.5 17.25v-1.5a2.25 2.25 0 012.25-2.25z"/></svg>
                            Work Experience
                        </h2>
                        {% for item in section.items %}
                        <!-- START EXPERIENCE -->
                        <div class="mb-4 bg-white rounded-lg p-4 border border-engineer-100 shadow-sm">
                            <div class="flex justify-between items-start mb-1">
                                <div>
                                    <h3 class="font-bold text-gray-900">{{ item.content.position|default('Position') }}</h3>
                                    <p class="text-sm text-engineer-600 font-medium">{{ item.content.company|default('') }}</p>
                                </div>
                                <span class="text-xs text-gray-500 font-medium whitespace-nowrap">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                            </div>
                            <p class="text-sm text-gray-600 mt-2 leading-relaxed">{{ item.content.description|default('') }}</p>
                        </div>
                        <!-- END EXPERIENCE -->
                        {% endfor %}
                    </section>
                    {% endif %}

                    {% if section.section_type == 'education' and section.is_visible %}
                    <section class="mb-6">
                        <h2 class="text-xs font-bold text-engineer-700 uppercase tracking-widest mb-3 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.408a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.184 12.083 12.083 0 01.665-6.479L12 14z"/></svg>
                            Education
                        </h2>
                        {% for item in section.items %}
                        <!-- START EDUCATION -->
                        <div class="mb-3 bg-engineer-50 rounded p-3 border-l-4 border-engineer-500">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h3 class="font-bold text-gray-900">{{ item.content.degree|default('Degree') }}</h3>
                                    <p class="text-sm text-gray-600">{{ item.content.institution|default('') }}</p>
                                </div>
                                <span class="text-xs text-gray-500 font-medium">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                            </div>
                            {% if item.content.gpa or item.content.field %}
                            <p class="text-xs text-gray-500 mt-1">{{ item.content.field ? ('Focus: ' ~ item.content.field) : '' }}{% if item.content.gpa and item.content.field %} | {% endif %}{% if item.content.gpa %}GPA: {{ item.content.gpa }}{% endif %}</p>
                            {% endif %}
                        </div>
                        <!-- END EDUCATION -->
                        {% endfor %}
                    </section>
                    {% endif %}

                    {% if section.section_type == 'projects' and section.is_visible %}
                    <section class="mb-6">
                        <h2 class="text-xs font-bold text-engineer-700 uppercase tracking-widest mb-3 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>
                            Key Projects
                        </h2>
                        <!-- START PROJECTS -->
                        <div class="grid grid-cols-2 gap-3">
                            {% for item in section.items %}
                            <div class="bg-white rounded p-3 border border-engineer-100">
                                <h4 class="font-bold text-sm text-gray-900">{{ item.content.name|default('Project') }}</h4>
                                <p class="text-xs text-gray-500 mt-0.5">{{ item.content.description|default('') }}</p>
                                {% if item.content.technologies %}
                                <span class="text-xs text-engineer-600 font-semibold mt-1 inline-block">{{ item.content.technologies }}</span>
                                {% endif %}
                            </div>
                            {% endfor %}
                        </div>
                        <!-- END PROJECTS -->
                    </section>
                    {% endif %}

                    {% if section.section_type == 'certifications' and section.is_visible %}
                    <section class="mb-6">
                        <h2 class="text-xs font-bold text-engineer-700 uppercase tracking-widest mb-3 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                            Certificates
                        </h2>
                        <!-- START CERTIFICATES -->
                        <div class="space-y-2">
                            {% for item in section.items %}
                            <div class="bg-white rounded p-3 border border-engineer-100">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <h4 class="font-bold text-sm text-gray-900">{{ item.content.name|default('Certificate') }}</h4>
                                        {% if item.content.organization %}<p class="text-xs text-gray-500">{{ item.content.organization }}{% if item.content.date %} | {{ item.content.date }}{% endif %}</p>{% endif %}
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                        <!-- END CERTIFICATES -->
                    </section>
                    {% endif %}
                    {% endfor %}

                    <footer class="mt-6 pt-4 border-t border-engineer-100 text-xs text-gray-400 flex justify-between items-center no-print">
                        <span>Reference available upon request</span>
                        <span>{{ cv.full_name|default('Applicant') }}{% if cv.email %} | {{ cv.email }}{% endif %}</span>
                    </footer>
                </main>
            </div>
        </div>
    </div>
</div>

</body>
</html>
