<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ cv.full_name|default('CV') }} - {{ cv.job_title|default('Professional') }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script>tailwind.config={theme:{extend:{fontFamily:{sans:['Inter','system-ui','sans-serif']},colors:{premium:{950:'#030712',900:'#0A0A0A',800:'#171717',700:'#262626',600:'#404040',500:'#525252'}}}}}</script>
    <style>
        @media print { @page { size: A4; margin: 0; } body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } .no-print { display: none !important; } }
        .premium-gradient { background: linear-gradient(180deg, #0A0A0A 0%, #030712 100%); }
        .accent-line { background: linear-gradient(90deg, #3B82F6, #8B5CF6, #EC4899); }
    </style>
</head>
<body class="font-sans text-gray-300 bg-gray-900 min-h-screen">

<div class="max-w-[210mm] mx-auto premium-gradient shadow-2xl my-4" style="min-height: 297mm;">
    <div class="px-10 py-8">
        <!-- Premium Header -->
        <header class="flex items-start justify-between mb-8 pb-6 border-b border-gray-800">
            <div class="flex items-center gap-5">
                <div class="w-24 h-24 rounded-xl bg-gray-800 border border-gray-700 flex items-center justify-center overflow-hidden">
                    {% if cv.profile_photo %}
                    <img src="{{ cv.profile_photo }}" alt="{{ cv.full_name|default('Profile') }}" class="w-full h-full object-cover">
                    {% else %}
                    <svg class="w-14 h-14 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    {% endif %}
                </div>
                <div>
                    <div class="accent-line h-1 w-12 rounded-full mb-3"></div>
                    <h1 class="text-2xl font-bold text-white tracking-tight">{{ cv.full_name|default('Your Name') }}</h1>
                    <p class="text-sm text-gray-400 mt-0.5">{{ cv.job_title|default('Professional Title') }}</p>
                </div>
            </div>
            <div class="text-right text-xs text-gray-500">
                {% if cv.location %}<p>{{ cv.location }}</p>{% endif %}
                {% if cv.email %}<p>{{ cv.email }}</p>{% endif %}
                {% if cv.phone %}<p>{{ cv.phone }}</p>{% endif %}
            </div>
        </header>

        <div class="flex gap-8">
            <!-- START SIDEBAR -->
            <aside class="w-[200px] flex-shrink-0">
                <div class="mb-6">
                    <h3 class="text-xs font-bold text-white uppercase tracking-widest mb-3 flex items-center gap-2">
                        <span class="w-1 h-1 bg-blue-500 rounded-full"></span>Contact
                    </h3>
                    <div class="space-y-2 text-xs text-gray-400">
                        {% if cv.email %}<p class="break-all">{{ cv.email }}</p>{% endif %}
                        {% if cv.phone %}<p>{{ cv.phone }}</p>{% endif %}
                        {% if cv.location %}<p>{{ cv.location }}</p>{% endif %}
                        {% if cv.website %}<p>{{ cv.website }}</p>{% endif %}
                    </div>
                </div>

                {% set techSkills = [] %}
                {% for section in sections %}
                    {% if section.section_type == 'skills' %}
                        {% for item in section.items %}
                            {% set techSkills = techSkills|merge([item.content.name]) %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}
                {% if techSkills|length > 0 %}
                <div class="mb-6">
                    <h3 class="text-xs font-bold text-white uppercase tracking-widest mb-3 flex items-center gap-2">
                        <span class="w-1 h-1 bg-purple-500 rounded-full"></span>Technical Skills
                    </h3>
                    <div class="space-y-2">
                        {% for skill in techSkills|slice(0, 6) %}
                        <div><div class="flex justify-between text-xs mb-0.5"><span class="text-gray-400">{{ skill }}</span><span class="text-blue-400">{{ 100 - (loop.index0 * 6) }}%</span></div><div class="h-1 bg-gray-800 rounded-full"><div class="h-1 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full" style="width:{{ 100 - (loop.index0 * 6) }}%"></div></div></div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {% set langSection = sections|filter(s => s.section_type == 'languages')|first %}
                {% if langSection and langSection.items|length > 0 %}
                <div class="mb-6">
                    <h3 class="text-xs font-bold text-white uppercase tracking-widest mb-3 flex items-center gap-2">
                        <span class="w-1 h-1 bg-pink-500 rounded-full"></span>Languages
                    </h3>
                    <div class="space-y-1.5 text-xs text-gray-400">
                        {% for item in langSection.items %}
                        <div class="flex justify-between"><span>{{ item.content.name|default('') }}</span><span class="text-gray-500">{{ item.content.proficiency|default('Fluent') }}</span></div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                <!-- END SIDEBAR -->
            </aside>

            <!-- START MAIN CONTENT -->
            <main class="flex-1">
                {% for section in sections %}
                {% if section.section_type == 'summary' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-white uppercase tracking-widest mb-2 flex items-center gap-2">
                        <span class="w-4 h-px bg-gray-600"></span>Professional Summary
                    </h2>
                    {% for item in section.items %}
                    <p class="text-sm text-gray-400 leading-relaxed">{{ item.content.summary|default(item.content.text|default('')) }}</p>
                    {% endfor %}
                </section>
                {% endif %}

                {% if section.section_type == 'experience' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-white uppercase tracking-widest mb-3 flex items-center gap-2">
                        <span class="w-4 h-px bg-gray-600"></span>Work Experience
                    </h2>
                    {% for item in section.items %}
                    <!-- START EXPERIENCE -->
                    <div class="mb-4 pb-4 border-b border-gray-800">
                        <div class="flex justify-between items-start mb-1">
                            <div>
                                <h3 class="font-bold text-white">{{ item.content.position|default('Position') }}</h3>
                                <p class="text-sm text-gray-400 font-medium">{{ item.content.company|default('') }}</p>
                            </div>
                            <span class="text-xs text-gray-500 font-medium px-2 py-1 bg-gray-800 rounded whitespace-nowrap">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                        </div>
                        <p class="text-sm text-gray-400 mt-2 leading-relaxed">{{ item.content.description|default('') }}</p>
                    </div>
                    <!-- END EXPERIENCE -->
                    {% endfor %}
                </section>
                {% endif %}

                {% if section.section_type == 'education' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-white uppercase tracking-widest mb-3 flex items-center gap-2">
                        <span class="w-4 h-px bg-gray-600"></span>Education
                    </h2>
                    {% for item in section.items %}
                    <!-- START EDUCATION -->
                    <div class="mb-3 flex justify-between items-baseline">
                        <div>
                            <h3 class="font-bold text-white">{{ item.content.degree|default('Degree') }}</h3>
                            <p class="text-sm text-gray-400">{{ item.content.institution|default('') }}</p>
                        </div>
                        <span class="text-xs text-gray-500 font-medium">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                    </div>
                    <!-- END EDUCATION -->
                    {% endfor %}
                </section>
                {% endif %}

                {% if section.section_type == 'projects' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-white uppercase tracking-widest mb-3 flex items-center gap-2">
                        <span class="w-4 h-px bg-gray-600"></span>Projects
                    </h2>
                    <!-- START PROJECTS -->
                    <div class="grid grid-cols-2 gap-3">
                        {% for item in section.items %}
                        <div class="bg-gray-800/50 rounded-lg p-3 border border-gray-700/50">
                            <h4 class="font-bold text-sm text-white">{{ item.content.name|default('Project') }}</h4>
                            <p class="text-xs text-gray-400 mt-0.5">{{ item.content.description|default('') }}</p>
                            {% if item.content.technologies %}
                            <span class="text-xs text-blue-400 font-semibold mt-1 inline-block">{{ item.content.technologies }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                    <!-- END PROJECTS -->
                </section>
                {% endif %}

                {% if section.section_type == 'certifications' and section.is_visible %}
                <section class="mb-6">
                    <h2 class="text-xs font-bold text-white uppercase tracking-widest mb-3 flex items-center gap-2">
                        <span class="w-4 h-px bg-gray-600"></span>Certificates
                    </h2>
                    <!-- START CERTIFICATES -->
                    <div class="space-y-2">
                        {% for item in section.items %}
                        <div class="bg-gray-800/50 rounded-lg p-3 border border-gray-700/50">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h4 class="font-bold text-sm text-white">{{ item.content.name|default('Certificate') }}</h4>
                                    {% if item.content.organization %}<p class="text-xs text-gray-400">{{ item.content.organization }}{% if item.content.date %} | {{ item.content.date }}{% endif %}</p>{% endif %}
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    <!-- END CERTIFICATES -->
                </section>
                {% endif %}
                {% endfor %}

                <footer class="mt-6 pt-4 border-t border-gray-800 text-xs text-gray-600 flex justify-between items-center no-print">
                    <span>Reference available upon request</span>
                    <span>{{ cv.full_name|default('Applicant') }}{% if cv.email %} | {{ cv.email }}{% endif %}</span>
                </footer>
            </main>
        </div>
    </div>
</div>

</body>
</html>
