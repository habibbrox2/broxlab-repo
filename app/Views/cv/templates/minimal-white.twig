<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ cv.full_name|default('CV') }} - {{ cv.job_title|default('Professional') }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>tailwind.config={theme:{extend:{fontFamily:{sans:['Inter','system-ui','sans-serif']}}}}</script>
    <style>
        @media print { @page { size: A4; margin: 0; } body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } .no-print { display: none !important; } }
    </style>
</head>
<body class="font-sans text-gray-800 bg-gray-100 min-h-screen">

<div class="max-w-[210mm] mx-auto bg-white shadow-2xl my-4" style="min-height: 297mm;">
    <div class="flex flex-col">
        <!-- START HEADER -->
        <header class="text-center pt-12 pb-8 px-10">
            <div class="w-24 h-24 rounded-full bg-gray-100 mx-auto mb-5 flex items-center justify-center overflow-hidden">
                {% if cv.profile_photo %}
                <img src="{{ cv.profile_photo }}" alt="{{ cv.full_name|default('Profile') }}" class="w-full h-full object-cover">
                {% else %}
                <svg class="w-14 h-14 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                {% endif %}
            </div>
            <h1 class="text-3xl font-light text-gray-900 tracking-tight">{{ cv.full_name|default('Your Name') }}</h1>
            <p class="text-base text-gray-500 mt-1 font-normal">{{ cv.job_title|default('Professional Title') }}</p>
            <div class="flex justify-center gap-6 mt-4 text-xs text-gray-400">
                {% if cv.email %}<a href="mailto:{{ cv.email }}" class="hover:text-gray-600 transition-colors">{{ cv.email }}</a>{% endif %}
                {% if cv.email and (cv.phone or cv.location) %}<span class="text-gray-300">|</span>{% endif %}
                {% if cv.phone %}<span>{{ cv.phone }}</span>{% endif %}
                {% if cv.phone and cv.location %}<span class="text-gray-300">|</span>{% endif %}
                {% if cv.location %}<span>{{ cv.location }}</span>{% endif %}
            </div>
            <div class="flex justify-center gap-6 mt-2 text-xs text-gray-400">
                {% if cv.linkedin %}<a href="{{ cv.linkedin }}" class="hover:text-gray-600 transition-colors" target="_blank">LinkedIn</a>{% endif %}
                {% if cv.github %}<a href="{{ cv.github }}" class="hover:text-gray-600 transition-colors" target="_blank">GitHub</a>{% endif %}
                {% if cv.portfolio %}<a href="{{ cv.portfolio }}" class="hover:text-gray-600 transition-colors" target="_blank">Portfolio</a>{% endif %}
            </div>
        </header>
        <!-- END HEADER -->

        <div class="px-10 pb-10">
            <hr class="border-gray-100 mb-8">

            {% for section in sections %}
            {% if section.section_type == 'summary' and section.is_visible %}
            <!-- Summary -->
            <section class="mb-8">
                <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Professional Summary</h2>
                {% for item in section.items %}
                <p class="text-sm text-gray-600 leading-relaxed">{{ item.content.summary|default(item.content.text|default('')) }}</p>
                {% endfor %}
            </section>
            {% endif %}

            {% if section.section_type == 'experience' and section.is_visible %}
            <!-- Experience -->
            <section class="mb-8">
                <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Work Experience</h2>
                {% for item in section.items %}
                <!-- START EXPERIENCE -->
                <div class="mb-6">
                    <div class="flex justify-between items-baseline mb-1">
                        <h3 class="font-semibold text-gray-900">{{ item.content.position|default('Position') }}</h3>
                        <span class="text-xs text-gray-400 font-medium">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                    </div>
                    {% if item.content.company %}<p class="text-sm text-gray-600 mb-2">{{ item.content.company }}</p>{% endif %}
                    <p class="text-sm text-gray-500 leading-relaxed">{{ item.content.description|default('') }}</p>
                </div>
                <!-- END EXPERIENCE -->
                {% endfor %}
            </section>
            {% endif %}

            {% if section.section_type == 'education' and section.is_visible %}
            <!-- Education -->
            <section class="mb-8">
                <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Education</h2>
                {% for item in section.items %}
                <!-- START EDUCATION -->
                <div class="mb-4 flex justify-between items-baseline">
                    <div>
                        <h3 class="font-semibold text-gray-900">{{ item.content.degree|default('Degree') }}</h3>
                        <p class="text-sm text-gray-600">{{ item.content.institution|default('') }}</p>
                    </div>
                    <span class="text-xs text-gray-400 font-medium">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                </div>
                <!-- END EDUCATION -->
                {% endfor %}
            </section>
            {% endif %}

            {% if section.section_type == 'skills' and section.is_visible %}
            <!-- Skills -->
            <section class="mb-8">
                <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Skills</h2>
                <div class="flex flex-wrap gap-2">
                    {% for item in section.items %}
                    <span class="px-3 py-1.5 bg-gray-50 text-gray-600 rounded-full text-xs border border-gray-200">{{ item.content.name|default('') }}</span>
                    {% endfor %}
                </div>
            </section>
            {% endif %}

            {% if section.section_type == 'projects' and section.is_visible %}
            <!-- Projects -->
            <section class="mb-8">
                <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Projects</h2>
                <!-- START PROJECTS -->
                <div class="grid grid-cols-2 gap-4">
                    {% for item in section.items %}
                    <div>
                        <h4 class="font-medium text-sm text-gray-900">{{ item.content.name|default('Project') }}</h4>
                        <p class="text-xs text-gray-500 mt-0.5">{{ item.content.description|default('') }}</p>
                    </div>
                    {% endfor %}
                </div>
                <!-- END PROJECTS -->
            </section>
            {% endif %}

            {% if section.section_type == 'certifications' and section.is_visible %}
            <!-- Certificates -->
            <section class="mb-8">
                <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Certificates</h2>
                <!-- START CERTIFICATES -->
                <div class="space-y-2">
                    {% for item in section.items %}
                    <p class="text-sm text-gray-600"><span class="font-medium">{{ item.content.name|default('Certificate') }}</span>{% if item.content.organization %} - {{ item.content.organization }}{% endif %}{% if item.content.date %} | {{ item.content.date }}{% endif %}</p>
                    {% endfor %}
                </div>
                <!-- END CERTIFICATES -->
            </section>
            {% endif %}
            {% endfor %}

            <!-- Footer -->
            <footer class="mt-12 pt-6 border-t border-gray-100 text-xs text-gray-300 flex justify-between items-center no-print">
                <span>Reference available upon request</span>
                <span>{{ cv.full_name|default('Applicant') }}{% if cv.email %} | {{ cv.email }}{% endif %}</span>
            </footer>
        </div>
    </div>
</div>

</body>
</html>
