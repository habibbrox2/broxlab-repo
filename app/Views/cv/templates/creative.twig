<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>{{ cv.title }}</title>
 <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
 <style>
 :root {
   --pink: #EC4899;
   --orange: #F97316;
   --gradient: linear-gradient(135deg, #EC4899, #F97316);
   --gradient-2: linear-gradient(135deg, #8B5CF6, #EC4899);
   --gradient-dark: linear-gradient(135deg, #1E1B4B, #312E81);
   --light-bg: #FDF2F8;
   --light-pink: #FCE7F3;
   --light-orange: #FFF7ED;
   --text: #1F2937;
   --text-light: #6B7280;
   --text-muted: #9CA3AF;
   --card-bg: #FFFFFF;
   --border: #F3E8FF;
   --shadow: 0 4px 16px rgba(236,72,153,0.08);
   --radius: 12px;
   --radius-sm: 8px;
 }

 * { margin: 0; padding: 0; box-sizing: border-box; }
 body {
   font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
   font-size: 10pt;
   line-height: 1.55;
   color: var(--text);
   background: #FAFAFA;
 }

 .cv-container {
   max-width: 210mm;
   margin: 0 auto;
   background: white;
   overflow: hidden;
 }

 /* ─── TOP BANNER ─── */
 .cv-banner {
   background: var(--gradient-dark);
   padding: 30px 32px 24px;
   position: relative;
   overflow: hidden;
 }
 .cv-banner::before {
   content: '';
   position: absolute;
   top: -50%; right: -20%;
   width: 60%; height: 200%;
   background: radial-gradient(circle, rgba(236,72,153,0.15) 0%, transparent 60%);
   pointer-events: none;
 }
 .cv-banner::after {
   content: '';
   position: absolute;
   bottom: 0; left: 0; right: 0;
   height: 4px;
   background: var(--gradient);
 }

 .banner-content {
   display: flex;
   align-items: center;
   gap: 24px;
   position: relative;
   z-index: 1;
 }

 .banner-photo {
   width: 96px;
   height: 96px;
   border-radius: 50%;
   flex-shrink: 0;
   border: 3px solid rgba(255,255,255,0.3);
   background: rgba(255,255,255,0.1);
   display: flex;
   align-items: center;
   justify-content: center;
   overflow: hidden;
 }
 .banner-photo img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
 .banner-photo-placeholder {
   font-family: 'Playfair Display', serif;
   font-size: 2rem;
   font-weight: 800;
   color: rgba(255,255,255,0.6);
 }

 .banner-text { flex: 1; }
 .banner-name {
   font-family: 'Playfair Display', serif;
   font-size: 24pt;
   font-weight: 800;
   color: white;
   line-height: 1.1;
   margin-bottom: 4px;
 }
 .banner-job-title {
   font-size: 10pt;
   font-weight: 500;
   color: rgba(255,255,255,0.85);
   letter-spacing: 0.5px;
   margin-bottom: 8px;
 }
 .banner-contact {
   display: flex;
   flex-wrap: wrap;
   gap: 10px 18px;
 }
 .banner-contact-item {
   display: flex;
   align-items: center;
   gap: 5px;
   font-size: 8pt;
   color: rgba(255,255,255,0.7);
 }
 .banner-contact-item .icon {
   width: 16px;
   height: 16px;
   display: inline-flex;
   align-items: center;
   justify-content: center;
   font-size: 7pt;
 }

 /* ─── MAIN CONTENT GRID ─── */
 .cv-body {
   display: flex;
   gap: 0;
 }

 /* ─── LEFT COLUMN (Colored background) ─── */
 .cv-left {
   width: 210px;
   flex-shrink: 0;
   background: linear-gradient(180deg, #FDF2F8 0%, #FFF7ED 100%);
   padding: 20px 16px;
 }

 .left-section {
   margin-bottom: 18px;
 }
 .left-section-title {
   font-size: 7.5pt;
   font-weight: 700;
   text-transform: uppercase;
   letter-spacing: 1.5px;
   color: #EC4899;
   margin-bottom: 8px;
   display: flex;
   align-items: center;
   gap: 6px;
 }
 .left-section-title::after {
   content: '';
   flex: 1;
   height: 1px;
   background: linear-gradient(90deg, rgba(236,72,153,0.3), transparent);
 }

 .left-divider {
   height: 1px;
   background: linear-gradient(90deg, transparent, rgba(236,72,153,0.2), transparent);
   margin: 14px 0;
 }

 /* Skills in left column */
 .left-skill-item {
   margin-bottom: 8px;
 }
 .left-skill-name {
   font-size: 8pt;
   font-weight: 500;
   color: #374151;
   margin-bottom: 3px;
 }
 .left-skill-bar {
   height: 5px;
   background: rgba(236,72,153,0.12);
   border-radius: 3px;
   overflow: hidden;
 }
 .left-skill-fill {
   height: 100%;
   border-radius: 3px;
   background: var(--gradient);
 }

 /* Colorful skill tags (alternative) */
 .left-tags {
   display: flex;
   flex-wrap: wrap;
   gap: 4px;
 }
 .left-tag {
   padding: 3px 8px;
   border-radius: 4px;
   font-size: 7.5pt;
   font-weight: 500;
 }
 .left-tag:nth-child(6n+1) { background: #FCE7F3; color: #BE185D; }
 .left-tag:nth-child(6n+2) { background: #FED7AA; color: #9A3412; }
 .left-tag:nth-child(6n+3) { background: #C7D2FE; color: #3730A3; }
 .left-tag:nth-child(6n+4) { background: #A7F3D0; color: #065F46; }
 .left-tag:nth-child(6n+5) { background: #FEF08A; color: #854D0E; }
 .left-tag:nth-child(6n)   { background: #DDD6FE; color: #5B21B6; }

 /* Languages in left */
 .left-lang-item {
   display: flex;
   justify-content: space-between;
   align-items: center;
   font-size: 8pt;
   margin-bottom: 4px;
 }
 .left-lang-name { color: #374151; font-weight: 500; }
 .left-lang-level { color: var(--text-muted); font-size: 7pt; }

 /* Social in left */
 .left-social-item {
   display: flex;
   align-items: center;
   gap: 6px;
   font-size: 7.5pt;
   color: #6B7280;
   margin-bottom: 3px;
 }

 /* ─── RIGHT COLUMN (White) ─── */
 .cv-right {
   flex: 1;
   padding: 20px 22px;
 }

 .right-section {
   margin-bottom: 16px;
   page-break-inside: avoid;
 }
 .right-section-title {
   font-family: 'Playfair Display', serif;
   font-size: 11pt;
   font-weight: 700;
   color: #1F2937;
   margin-bottom: 8px;
   display: flex;
   align-items: center;
   gap: 8px;
 }
 .right-section-title .accent-bar {
   width: 4px;
   height: 16px;
   background: var(--gradient);
   border-radius: 2px;
   flex-shrink: 0;
 }
 .right-section-title::after {
   content: '';
   flex: 1;
   height: 1px;
   background: linear-gradient(90deg, #F3E8FF, transparent);
 }

 /* Summary card */
 .summary-card {
   background: linear-gradient(135deg, #FDF2F8, #FFF7ED);
   border-radius: var(--radius-sm);
   padding: 12px 14px;
   font-size: 9.5pt;
   line-height: 1.55;
   color: #4B5563;
   border-left: 3px solid transparent;
   border-image: var(--gradient);
   border-image-slice: 1;
 }

 /* Card items (experience, education) */
 .card-item {
   background: var(--card-bg);
   border: 1px solid #F3E8FF;
   border-radius: var(--radius-sm);
   padding: 10px 12px;
   margin-bottom: 8px;
   transition: all 0.15s;
   position: relative;
   overflow: hidden;
 }
 .card-item::before {
   content: '';
   position: absolute;
   top: 0; left: 0;
   width: 3px;
   height: 100%;
   background: var(--gradient);
   border-radius: 0 2px 2px 0;
 }
 .card-header {
   display: flex;
   justify-content: space-between;
   align-items: baseline;
   margin-bottom: 2px;
 }
 .card-title {
   font-weight: 600;
   color: #1F2937;
   font-size: 10pt;
 }
 .card-subtitle {
   font-size: 8.5pt;
   color: #EC4899;
   font-weight: 500;
 }
 .card-date {
   font-size: 7.5pt;
   color: var(--text-muted);
   white-space: nowrap;
   padding: 1px 8px;
   background: var(--light-pink);
   border-radius: 10px;
   font-weight: 500;
 }
 .card-desc {
   font-size: 8.5pt;
   color: #6B7280;
   margin-top: 4px;
   line-height: 1.45;
 }

 /* Skill badges in right column */
 .right-skills {
   display: flex;
   flex-wrap: wrap;
   gap: 5px;
 }
 .right-skill-badge {
   padding: 4px 11px;
   border-radius: 16px;
   font-size: 8pt;
   font-weight: 500;
   border: 1px solid transparent;
   transition: all 0.15s;
 }
 .right-skill-badge:nth-child(6n+1) { background: #FCE7F3; color: #BE185D; border-color: rgba(190,24,93,0.15); }
 .right-skill-badge:nth-child(6n+2) { background: #FED7AA; color: #9A3412; border-color: rgba(154,52,18,0.15); }
 .right-skill-badge:nth-child(6n+3) { background: #C7D2FE; color: #3730A3; border-color: rgba(55,48,163,0.15); }
 .right-skill-badge:nth-child(6n+4) { background: #A7F3D0; color: #065F46; border-color: rgba(6,95,70,0.15); }
 .right-skill-badge:nth-child(6n+5) { background: #FEF08A; color: #854D0E; border-color: rgba(133,77,14,0.15); }
 .right-skill-badge:nth-child(6n)   { background: #DDD6FE; color: #5B21B6; border-color: rgba(91,33,182,0.15); }

 /* Languages */
 .right-lang-grid {
   display: flex;
   flex-wrap: wrap;
   gap: 6px 16px;
 }
 .right-lang-entry {
   font-size: 9pt;
   color: #374151;
 }
 .right-lang-entry .level {
   font-size: 7.5pt;
   color: var(--text-muted);
 }

 /* Projects */
 .project-card {
   padding: 8px 12px;
   margin-bottom: 6px;
   border: 1px solid #F3E8FF;
   border-radius: var(--radius-sm);
   border-left: 3px solid transparent;
   border-image: var(--gradient-2);
   border-image-slice: 1;
 }
 .project-card .name {
   font-weight: 600;
   font-size: 9.5pt;
   color: #1F2937;
 }
 .project-card .desc {
   font-size: 8pt;
   color: #6B7280;
   margin-top: 2px;
 }
 .project-card .tech {
   display: inline-flex;
   gap: 3px;
   margin-top: 3px;
   flex-wrap: wrap;
 }
 .project-card .tech span {
   background: #F3E8FF;
   padding: 1px 6px;
   border-radius: 3px;
   font-size: 7pt;
   color: #7C3AED;
 }

 /* Certifications */
 .cert-row {
   display: flex;
   align-items: center;
   gap: 8px;
   padding: 6px 10px;
   margin-bottom: 4px;
   background: var(--light-bg);
   border-radius: var(--radius-sm);
 }
 .cert-row .icon {
   width: 24px;
   height: 24px;
   background: var(--gradient);
   border-radius: 50%;
   display: flex;
   align-items: center;
   justify-content: center;
   color: white;
   font-size: 7pt;
   flex-shrink: 0;
 }
 .cert-row .info { flex: 1; }
 .cert-row .name { font-weight: 500; font-size: 8.5pt; color: #1F2937; }
 .cert-row .issuer { font-size: 7.5pt; color: var(--text-muted); }
 .cert-row .date { font-size: 7pt; color: var(--text-muted); white-space: nowrap; }

 /* References */
 .ref-grid {
   display: grid;
   grid-template-columns: 1fr 1fr;
   gap: 6px;
 }
 .ref-box {
   padding: 8px 10px;
   border: 1px solid #F3E8FF;
   border-radius: var(--radius-sm);
   background: #FAFAFA;
 }
 .ref-box .name {
   font-weight: 600;
   font-size: 8.5pt;
   color: #1F2937;
 }
 .ref-box .detail {
   font-size: 7.5pt;
   color: var(--text-muted);
 }

 /* Social in right */
 .right-social {
   display: flex;
   flex-wrap: wrap;
   gap: 4px 10px;
 }
 .right-social a {
   font-size: 8pt;
   color: #EC4899;
   text-decoration: none;
   font-weight: 500;
 }
 .right-social a:hover { text-decoration: underline; }

 /* Empty state */
 .empty-state {
   font-size: 8.5pt;
   color: var(--text-muted);
   font-style: italic;
   padding: 4px 0;
 }

 /* ─── PRINT ─── */
 @media print {
   body { background: white; font-size: 9pt; }
   .cv-container { max-width: 100%; box-shadow: none; }
   .cv-banner { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .cv-banner::after { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .cv-left { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .banner-photo { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .left-tag { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .right-skill-badge { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .left-skill-fill { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .card-item::before { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .summary-card { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .cert-row .icon { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .card-date { background: #FCE7F3 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .right-section { page-break-inside: avoid; }
   .card-item { page-break-inside: avoid; }
 }

 @media (max-width: 700px) {
   .cv-body { flex-direction: column; }
   .cv-left { width: 100%; }
   .banner-content { flex-direction: column; text-align: center; }
   .banner-contact { justify-content: center; }
   .ref-grid { grid-template-columns: 1fr; }
 }
 </style>
</head>
<body>
<div class="cv-container">
  {# ─── BANNER ─── #}
  <header class="cv-banner">
    <div class="banner-content">
      {% set photo_url = cv.profile_photo|default('') %}
      {% if photo_url %}
      <div class="banner-photo"><img src="{{ photo_url }}" alt="{{ cv.title }}" /></div>
      {% else %}
      <div class="banner-photo"><span class="banner-photo-placeholder">{{ (cv.title|first)|default('?')|upper }}</span></div>
      {% endif %}
      <div class="banner-text">
        <h1 class="banner-name">{{ cv.title }}</h1>
        {% for section in sections %}{% if section.section_type == 'summary' %}
          {% for item in section.items %}
            {% if item.content.job_title %}
        <div class="banner-job-title">{{ item.content.job_title }}</div>
            {% endif %}
          {% endfor %}
        {% endif %}{% endfor %}
        <div class="banner-contact">
          {% for section in sections %}{% if section.section_type == 'summary' %}
            {% for item in section.items %}
              {% if item.content.email %}
          <span class="banner-contact-item"><span class="icon">&#9993;</span> {{ item.content.email }}</span>
              {% endif %}
              {% if item.content.phone %}
          <span class="banner-contact-item"><span class="icon">&#128222;</span> {{ item.content.phone }}</span>
              {% endif %}
              {% if item.content.location %}
          <span class="banner-contact-item"><span class="icon">&#128205;</span> {{ item.content.location }}</span>
              {% endif %}
              {% if item.content.website %}
          <span class="banner-contact-item"><span class="icon">&#127760;</span> {{ item.content.website }}</span>
              {% endif %}
            {% endfor %}
          {% endif %}{% endfor %}
        </div>
      </div>
    </div>
  </header>

  {# ─── BODY ─── #}
  <div class="cv-body">
    {# ─── LEFT COLUMN ─── #}
    <aside class="cv-left">
      <!-- Skills (as colorful tags) -->
      {% for section in sections %}{% if section.section_type == 'skills' %}
      <div class="left-section">
        <div class="left-section-title">&#127912; Skills</div>
        <div class="left-tags">
          {% for item in section.items %}
            {% set skills_list = item.content.skills|default([]) %}
            {% if skills_list is empty and item.content.name %}
              {% set skills_list = [item.content.name] %}
            {% endif %}
            {% for s in skills_list %}
          <span class="left-tag">{{ s }}</span>
            {% endfor %}
          {% endfor %}
        </div>
      </div>
      {% endif %}{% endfor %}

      <div class="left-divider"></div>

      <!-- Languages -->
      {% for section in sections %}{% if section.section_type == 'languages' %}
      <div class="left-section">
        <div class="left-section-title">&#127760; Languages</div>
        {% for item in section.items %}
        <div class="left-lang-item">
          <span class="left-lang-name">{{ item.content.name }}</span>
          <span class="left-lang-level">{{ item.content.proficiency|default('') }}</span>
        </div>
        {% endfor %}
      </div>
      <div class="left-divider"></div>
      {% endif %}{% endfor %}

      <!-- Social Links -->
      {% for section in sections %}{% if section.section_type == 'social_links' %}
      <div class="left-section">
        <div class="left-section-title">&#128279; Connect</div>
        {% for item in section.items %}
        <div class="left-social-item">
          <span>{{ item.content.platform }}</span>
        </div>
        {% endfor %}
      </div>
      <div class="left-divider"></div>
      {% endif %}{% endfor %}

      <!-- Certifications in left -->
      {% for section in sections %}{% if section.section_type == 'certifications' %}
      <div class="left-section">
        <div class="left-section-title">&#127891; Certifications</div>
        {% for item in section.items %}
        <div class="left-skill-item">
          <div class="left-skill-name">{{ item.content.name|default('') }}</div>
          {% if item.content.issuer %}<div style="font-size:7pt;color:var(--text-muted);">{{ item.content.issuer }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>
      <div class="left-divider"></div>
      {% endif %}{% endfor %}

      <!-- References in left -->
      {% for section in sections %}{% if section.section_type == 'references' %}
      <div class="left-section">
        <div class="left-section-title">&#128100; References</div>
        {% for item in section.items %}
        <div class="left-social-item" style="flex-direction:column;align-items:flex-start;gap:1px;margin-bottom:6px;">
          <span style="font-weight:500;color:#374151;">{{ item.content.name }}</span>
          <span style="font-size:7pt;">{{ item.content.title|default('') }}{% if item.content.company %} @ {{ item.content.company }}{% endif %}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}{% endfor %}
    </aside>

    {# ─── RIGHT COLUMN ─── #}
    <main class="cv-right">
      <!-- Summary at top -->
      {% for section in sections %}{% if section.section_type == 'summary' %}
        {% for item in section.items %}
          {% set summary_text = item.content.text|default(item.content.summary|default('')) %}
          {% if summary_text %}
      <div class="right-section">
        <div class="right-section-title"><span class="accent-bar"></span>About</div>
        <div class="summary-card">{{ summary_text }}</div>
      </div>
          {% endif %}
        {% endfor %}
      {% endif %}{% endfor %}

      {# ─── SECTIONS LOOP ─── #}
      {% for section in sections %}
        {% if section.section_type != 'summary' and section.section_type != 'skills' and section.section_type != 'languages' and section.section_type != 'social_links' and section.section_type != 'certifications' and section.section_type != 'references' %}

      <div class="right-section">
        <div class="right-section-title"><span class="accent-bar"></span>{{ section.title }}</div>

        {# ─── EXPERIENCE ─── #}
        {% if section.section_type == 'experience' %}
          {% for item in section.items %}
          <div class="card-item">
            <div class="card-header">
              <div>
                <div class="card-title">{{ item.content.position|default('Position') }}</div>
                <div class="card-subtitle">{{ item.content.company|default('') }}{% if item.content.location %} &middot; {{ item.content.location }}{% endif %}</div>
              </div>
              <span class="card-date">{{ item.content.start_date|default('') }} – {{ item.content.end_date|default('Present') }}</span>
            </div>
            {% if item.content.description %}<div class="card-desc">{{ item.content.description|nl2br }}</div>{% endif %}
          </div>
          {% endfor %}

        {# ─── EDUCATION ─── #}
        {% elseif section.section_type == 'education' %}
          {% for item in section.items %}
          <div class="card-item">
            <div class="card-header">
              <div>
                <div class="card-title">{{ item.content.degree|default('Degree') }}{% if item.content.field %} in {{ item.content.field }}{% endif %}</div>
                <div class="card-subtitle">{{ item.content.institution|default('Institution') }}</div>
              </div>
              <span class="card-date">{{ item.content.start_date|default('') }} – {{ item.content.end_date|default('') }}</span>
            </div>
            {% if item.content.gpa %}<div class="card-desc">GPA: {{ item.content.gpa }}</div>{% endif %}
          </div>
          {% endfor %}

        {# ─── PROJECTS ─── #}
        {% elseif section.section_type == 'projects' %}
          {% for item in section.items %}
          <div class="project-card">
            <div class="name">{{ item.content.name|default('Project') }}</div>
            {% if item.content.description %}<div class="desc">{{ item.content.description|nl2br }}</div>{% endif %}
            {% if item.content.technologies %}
            <div class="tech"><span>{{ item.content.technologies }}</span></div>
            {% endif %}
          </div>
          {% endfor %}

        {# ─── OTHER / CUSTOM ─── #}
        {% else %}
          {% for item in section.items %}
          <div class="card-item">
            <div class="card-title">{{ item.content.title|default(item.content.name|default('')) }}</div>
            {% if item.content.description or item.content.content %}<div class="card-desc">{{ (item.content.description|default(item.content.content|default('')))|nl2br }}</div>{% endif %}
          </div>
          {% else %}
          <div class="empty-state">No content</div>
          {% endfor %}
        {% endif %}
      </div>
        {% endif %}
      {% else %}
      <div class="empty-state">No sections available</div>
      {% endfor %}
    </main>
  </div>
</div>
</body>
</html>
