<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ cv.title }}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 12pt;
            line-height: 1.5;
            color: #333;
        }
        
        .container {
            max-width: 210mm;
            margin: 0 auto;
            padding: 20mm;
        }
        
        .header {
            text-align: center;
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 2px solid #4F46E5;
        }
        
        .header h1 {
            font-size: 24pt;
            color: #1F2937;
            margin-bottom: 5px;
        }
        
        .contact-info {
            color: #6B7280;
            font-size: 10pt;
        }
        
        .section {
            margin-bottom: 20px;
        }
        
        .section-title {
            font-size: 14pt;
            color: #4F46E5;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
            padding-bottom: 5px;
            border-bottom: 1px solid #E5E7EB;
        }
        
        .item {
            margin-bottom: 15px;
        }
        
        .item-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
        }
        
        .item-title {
            font-weight: 600;
            color: #1F2937;
        }
        
        .item-subtitle {
            color: #6B7280;
            font-style: italic;
        }
        
        .item-date {
            color: #9CA3AF;
            font-size: 10pt;
        }
        
        .item-content {
            margin-top: 5px;
            color: #4B5563;
        }
        
        .skills-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        
        .skill-tag {
            background: #EEF2FF;
            color: #4F46E5;
            padding: 4px 12px;
            border-radius: 9999px;
            font-size: 10pt;
        }
        
        ul {
            margin-left: 20px;
        }
        
        li {
            margin-bottom: 3px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>{{ cv.title }}</h1>
            <div class="contact-info">
                <!-- Add contact info from summary section if available -->
            </div>
        </div>

        <!-- Sections -->
        {% for section in sections %}
            <div class="section">
                <h2 class="section-title">{{ section.title }}</h2>
                
                {% if section.section_type == 'summary' %}
                    {% for item in section.items %}
                        <div class="item-content">
                            {{ item.content.text ?? '' }}
                        </div>
                    {% endfor %}
                    
                {% elseif section.section_type == 'experience' %}
                    {% for item in section.items %}
                        <div class="item">
                            <div class="item-header">
                                <div>
                                    <span class="item-title">{{ item.content.position ?? 'Position' }}</span>
                                    <span class="item-subtitle"> at {{ item.content.company ?? 'Company' }}</span>
                                </div>
                                <span class="item-date">
                                    {{ item.content.start_date ?? '' }} - {{ item.content.end_date ?? 'Present' }}
                                </span>
                            </div>
                            <div class="item-content">
                                {{ item.content.description ?? '' }}
                            </div>
                        </div>
                    {% endfor %}
                    
                {% elseif section.section_type == 'education' %}
                    {% for item in section.items %}
                        <div class="item">
                            <div class="item-header">
                                <div>
                                    <span class="item-title">{{ item.content.degree ?? 'Degree' }}</span>
                                    <span class="item-subtitle"> - {{ item.content.institution ?? 'Institution' }}</span>
                                </div>
                                <span class="item-date">
                                    {{ item.content.start_date ?? '' }} - {{ item.content.end_date ?? '' }}
                                </span>
                            </div>
                        </div>
                    {% endfor %}
                    
                {% elseif section.section_type == 'skills' %}
                    <div class="skills-list">
                        {% for item in section.items %}
                            <span class="skill-tag">{{ item.content.name ?? '' }}</span>
                        {% endfor %}
                    </div>
                    
                {% elseif section.section_type == 'projects' %}
                    {% for item in section.items %}
                        <div class="item">
                            <div class="item-header">
                                <span class="item-title">{{ item.content.name ?? 'Project' }}</span>
                            </div>
                            <div class="item-content">
                                {{ item.content.description ?? '' }}
                            </div>
                        </div>
                    {% endfor %}
                    
                {% elseif section.section_type == 'certifications' %}
                    {% for item in section.items %}
                        <div class="item">
                            <div class="item-header">
                                <div>
                                    <span class="item-title">{{ item.content.name ?? 'Certification' }}</span>
                                    <span class="item-subtitle"> - {{ item.content.issuer ?? '' }}</span>
                                </div>
                                <span class="item-date">{{ item.content.date ?? '' }}</span>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        {% endfor %}
    </div>
</body>
</html>