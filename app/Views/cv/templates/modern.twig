<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>{{ cv.title }}</title>
 <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
 <style>
 :root {
 --primary: #4F46E5;
 --primary-light: #EEF2FF;
 --secondary: #7C3AED;
 --accent: #06B6D4;
 --gray-50: #F9FAFB;
 --gray-100: #F3F4F6;
 --gray-200: #E5E7EB;
 --gray-300: #D1D5DB;
 --gray-400: #9CA3AF;
 --gray-500: #6B7280;
 --gray-600: #4B5563;
 --gray-700: #374151;
 --gray-800: #1F2937;
 --gray-900: #111827;
 }
 
 * {
 margin: 0;
 padding: 0;
 box-sizing: border-box;
 }
 
 body {
 font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
 font-size: 11pt;
 line-height: 1.6;
 color: var(--gray-700);
 background: white;
 }
 
 .cv-container {
 max-width: 210mm;
 margin: 0 auto;
 padding: 15mm 20mm;
 }
 
 /* Header */
 .cv-header {
 text-align: center;
 margin-bottom: 25px;
 padding-bottom: 20px;
 border-bottom: 3px solid var(--primary);
 position: relative;
 }
 
 .cv-header::after {
 content: '';
 position: absolute;
 bottom: -3px;
 left: 0;
 width: 60px;
 height: 3px;
 background: linear-gradient(90deg, var(--primary), var(--secondary));
 }
 
 .cv-name {
 font-size: 28pt;
 font-weight: 700;
 color: var(--gray-900);
 margin-bottom: 8px;
 letter-spacing: -0.5px;
 }
 
 .cv-contact {
 display: flex;
 justify-content: center;
 flex-wrap: wrap;
 gap: 20px;
 color: var(--gray-500);
 font-size: 10pt;
 }
 
 .contact-item {
 display: flex;
 align-items: center;
 gap: 6px;
 }
 
 .contact-icon {
 width: 16px;
 height: 16px;
 background: var(--primary-light);
 border-radius: 50%;
 display: flex;
 align-items: center;
 justify-content: center;
 color: var(--primary);
 font-size: 8pt;
 }
 
 /* Sections */
 .cv-section {
 margin-bottom: 22px;
 }
 
 .section-header {
 display: flex;
 align-items: center;
 gap: 10px;
 margin-bottom: 12px;
 }
 
 .section-icon {
 width: 28px;
 height: 28px;
 background: linear-gradient(135deg, var(--primary), var(--secondary));
 border-radius: 6px;
 display: flex;
 align-items: center;
 justify-content: center;
 color: white;
 font-size: 12pt;
 flex-shrink: 0;
 }
 
 .section-title {
 font-size: 13pt;
 font-weight: 600;
 color: var(--gray-800);
 text-transform: uppercase;
 letter-spacing: 1px;
 position: relative;
 }
 
 .section-title::after {
 content: '';
 flex: 1;
 height: 1px;
 background: linear-gradient(90deg, var(--gray-200), transparent);
 margin-left: 15px;
 }
 
 /* Items */
 .section-content {
 padding-left: 38px;
 }
 
 .cv-item {
 margin-bottom: 15px;
 padding: 12px;
 background: var(--gray-50);
 border-radius: 8px;
 border-left: 3px solid var(--primary);
 transition: all 0.2s;
 }
 
 .cv-item:hover {
 background: var(--primary-light);
 transform: translateX(3px);
 }
 
 .item-header {
 display: flex;
 justify-content: space-between;
 align-items: flex-start;
 margin-bottom: 6px;
 }
 
 .item-main {
 flex: 1;
 }
 
 .item-title {
 font-weight: 600;
 color: var(--gray-800);
 font-size: 11pt;
 margin-bottom: 2px;
 }
 
 .item-subtitle {
 color: var(--primary);
 font-weight: 500;
 font-size: 10pt;
 }
 
 .item-date {
 background: var(--primary);
 color: white;
 padding: 3px 10px;
 border-radius: 15px;
 font-size: 8pt;
 font-weight: 500;
 white-space: nowrap;
 }
 
 .item-description {
 color: var(--gray-600);
 font-size: 10pt;
 line-height: 1.5;
 margin-top: 8px;
 }
 
 .item-description ul {
 margin-left: 15px;
 margin-top: 5px;
 }
 
 .item-description li {
 margin-bottom: 3px;
 }
 
 /* Skills */
 .skills-container {
 display: flex;
 flex-wrap: wrap;
 gap: 8px;
 padding-left: 38px;
 }
 
 .skill-item {
 background: linear-gradient(135deg, var(--primary-light), #E0E7FF);
 color: var(--primary);
 padding: 6px 14px;
 border-radius: 20px;
 font-size: 9pt;
 font-weight: 500;
 border: 1px solid rgba(79, 70, 229, 0.2);
 transition: all 0.2s;
 }
 
 .skill-item:hover {
 background: var(--primary);
 color: white;
 transform: scale(1.05);
 }
 
 /* Summary */
 .summary-content {
 padding-left: 38px;
 }
 
 .summary-text {
 background: linear-gradient(135deg, var(--gray-50), var(--primary-light));
 padding: 15px 20px;
 border-radius: 10px;
 border-left: 4px solid var(--primary);
 font-size: 10.5pt;
 line-height: 1.7;
 color: var(--gray-700);
 }
 
 /* Projects */
 .project-name {
 color: var(--secondary);
 font-weight: 600;
 }
 
 /* Certifications */
 .cert-item {
 border-left-color: var(--accent);
 }
 
 .cert-issuer {
 color: var(--accent);
 }
 
 /* Print Styles */
 @media print {
 body {
 font-size: 10pt;
 color: #000;
 background: #fff;
 }
 
 .cv-container {
 padding: 0;
 max-width: 100%;
 }
 
 .cv-header {
 margin-bottom: 20px;
 padding-bottom: 15px;
 }
 
 .cv-section {
 page-break-inside: avoid;
 margin-bottom: 18px;
 }
 
 .cv-item {
 page-break-inside: avoid;
 background: none !important;
 padding: 8px 0;
 border-left: 3px solid #4F46E5;
 }
 
 .cv-item:hover {
 background: none !important;
 transform: none;
 }
 
 .skill-item {
 background: #EEF2FF !important;
 color: #4F46E5 !important;
 border: 1px solid rgba(79, 70, 229, 0.2);
 transform: none !important;
 }
 
 .skill-item:hover {
 background: #EEF2FF !important;
 color: #4F46E5 !important;
 transform: none !important;
 }
 
 .summary-text {
 background: none;
 border-left: 4px solid #4F46E5;
 padding: 0 0 0 15px;
 }
 
 .section-icon {
 background: #4F46E5 !important;
 -webkit-print-color-adjust: exact;
 print-color-adjust: exact;
 }
 
 .item-date {
 background: #4F46E5 !important;
 -webkit-print-color-adjust: exact;
 print-color-adjust: exact;
 }
 
 .cv-header::after {
 background: #4F46E5 !important;
 -webkit-print-color-adjust: exact;
 print-color-adjust: exact;
 }
 
 /* Prevent section titles from being orphaned at bottom of page */
 .section-header {
 page-break-after: avoid;
 }
 
 }
 
 .section-content {
 /* mPDF handles widows/orphans via use_kwt config */
 }
 
 /* Page Break (for manual insertion) */
 .page-break {
 page-break-before: always;
 }
 
 /* mPDF-specific: force color rendering for PDF */
 .section-icon,
 .item-date,
 .cv-header::after {
 -webkit-print-color-adjust: exact;
 print-color-adjust: exact;
 }
 </style>
</head>
<body>
 <div class="cv-container">
 <!-- Header -->
 <header class="cv-header">
 <h1 class="cv-name">{{ cv.title }}</h1>
 <div class="cv-contact">
 {% for section in sections %}
 {% if section.section_type == 'summary' %}
 {% for item in section.items %}
 {% if item.content.email %}
 <span class="contact-item">
 <span class="contact-icon">@</span>
 {{ item.content.email }}
 </span>
 {% endif %}
 {% if item.content.phone %}
 <span class="contact-item">
 <span class="contact-icon">☎</span>
 {{ item.content.phone }}
 </span>
 {% endif %}
 {% if item.content.location %}
 <span class="contact-item">
 <span class="contact-icon">📍</span>
 {{ item.content.location }}
 </span>
 {% endif %}
 {% endfor %}
 {% endif %}
 {% endfor %}
 </div>
 </header>

 <!-- Sections -->
 {% for section in sections %}
 <section class="cv-section">
 <div class="section-header">
 <div class="section-icon">
 {% if section.section_type == 'summary' %}👤
 {% elseif section.section_type == 'experience' %}💼
 {% elseif section.section_type == 'education' %}🎓
 {% elseif section.section_type == 'skills' %}🛠️
 {% elseif section.section_type == 'projects' %}🚀
 {% elseif section.section_type == 'certifications' %}📜
 {% else %}📄{% endif %}
 </div>
 <h2 class="section-title">{{ section.title }}</h2>
 </div>
 
 {% if section.section_type == 'summary' %}
 <div class="summary-content">
 {% for item in section.items %}
 <div class="summary-text">
 {{ item.content.text ?? item.content.summary ?? '' }}
 </div>
 {% endfor %}
 </div>
 
 {% elseif section.section_type == 'experience' %}
 <div class="section-content">
 {% for item in section.items %}
 <div class="cv-item">
 <div class="item-header">
 <div class="item-main">
 <div class="item-title">{{ item.content.position ?? 'Position' }}</div>
 <div class="item-subtitle">{{ item.content.company ?? 'Company' }}</div>
 </div>
 <span class="item-date">
 {{ item.content.start_date ?? '' }} - {{ item.content.end_date ?? 'Present' }}
 </span>
 </div>
 {% if item.content.description %}
 <div class="item-description">
 {{ item.content.description|nl2br }}
 </div>
 {% endif %}
 </div>
 {% endfor %}
 </div>
 
 {% elseif section.section_type == 'education' %}
 <div class="section-content">
 {% for item in section.items %}
 <div class="cv-item">
 <div class="item-header">
 <div class="item-main">
 <div class="item-title">{{ item.content.degree ?? 'Degree' }}</div>
 <div class="item-subtitle">{{ item.content.institution ?? 'Institution' }}</div>
 </div>
 <span class="item-date">
 {{ item.content.start_date ?? '' }} - {{ item.content.end_date ?? '' }}
 </span>
 </div>
 {% if item.content.gpa %}
 <div class="item-description">
 GPA: {{ item.content.gpa }}
 </div>
 {% endif %}
 </div>
 {% endfor %}
 </div>
 
 {% elseif section.section_type == 'skills' %}
 <div class="skills-container">
 {% for item in section.items %}
 <span class="skill-item">{{ item.content.name ?? '' }}</span>
 {% endfor %}
 </div>
 
 {% elseif section.section_type == 'projects' %}
 <div class="section-content">
 {% for item in section.items %}
 <div class="cv-item">
 <div class="item-header">
 <div class="item-main">
 <div class="item-title project-name">{{ item.content.name ?? 'Project' }}</div>
 </div>
 {% if item.content.date %}
 <span class="item-date">{{ item.content.date }}</span>
 {% endif %}
 </div>
 {% if item.content.description %}
 <div class="item-description">
 {{ item.content.description|nl2br }}
 </div>
 {% endif %}
 {% if item.content.url %}
 <div class="item-description">
 🔗 {{ item.content.url }}
 </div>
 {% endif %}
 </div>
 {% endfor %}
 </div>
 
 {% elseif section.section_type == 'certifications' %}
 <div class="section-content">
 {% for item in section.items %}
 <div class="cv-item cert-item">
 <div class="item-header">
 <div class="item-main">
 <div class="item-title">{{ item.content.name ?? 'Certification' }}</div>
 <div class="item-subtitle cert-issuer">{{ item.content.issuer ?? '' }}</div>
 </div>
 {% if item.content.date %}
 <span class="item-date">{{ item.content.date }}</span>
 {% endif %}
 </div>
 {% if item.content.credential_id %}
 <div class="item-description">
 Credential ID: {{ item.content.credential_id }}
 </div>
 {% endif %}
 </div>
 {% endfor %}
 </div>
 {% endif %}
 </section>
 {% endfor %}
 </div>
</body>
</html>





