<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>{{ cv.title }}</title>
 <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
 <style>
 :root { --primary: #4F46E5; --primary-light: #EEF2FF; --secondary: #7C3AED; --accent: #06B6D4; }
 * { margin: 0; padding: 0; box-sizing: border-box; }
 body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; font-size: 11pt; line-height: 1.6; color: #374151; background: white; }
 .cv-container { max-width: 210mm; margin: 0 auto; padding: 15mm 20mm; }
 .cv-header { display: flex; align-items: center; gap: 20px; margin-bottom: 25px; padding-bottom: 20px; border-bottom: 3px solid var(--primary); position: relative; }
 .cv-header::after { content: ''; position: absolute; bottom: -3px; left: 0; width: 80px; height: 3px; background: linear-gradient(90deg, var(--primary), var(--secondary)); }
 .cv-photo { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid var(--primary-light); flex-shrink: 0; background: linear-gradient(135deg, var(--primary-light), #E0E7FF); display: flex; align-items: center; justify-content: center; }
 .cv-photo img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
 .cv-photo-placeholder { font-size: 2rem; color: var(--primary); font-weight: 700; }
 .cv-header-text { flex: 1; }
 .cv-name { font-size: 26pt; font-weight: 700; color: #111827; margin-bottom: 4px; letter-spacing: -0.5px; }
 .cv-job-title { font-size: 12pt; color: var(--primary); font-weight: 500; margin-bottom: 10px; }
 .cv-contact { display: flex; flex-wrap: wrap; gap: 12px; color: #6B7280; font-size: 9pt; }
 .contact-item { display: flex; align-items: center; gap: 4px; }
 .cv-section { margin-bottom: 20px; page-break-inside: avoid; }
 .section-header { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
 .section-icon { width: 26px; height: 26px; background: linear-gradient(135deg, var(--primary), var(--secondary)); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: white; font-size: 11pt; flex-shrink: 0; }
 .section-title { font-size: 12pt; font-weight: 600; color: #1F2937; text-transform: uppercase; letter-spacing: 1px; flex: 1; border-bottom: 2px solid var(--primary-light); padding-bottom: 4px; }
 .section-content { padding-left: 36px; }
 .cv-item { margin-bottom: 14px; padding: 10px 14px; background: #F9FAFB; border-radius: 8px; border-left: 3px solid var(--primary); page-break-inside: avoid; }
 .item-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px; }
 .item-title { font-weight: 600; color: #1F2937; font-size: 11pt; }
 .item-subtitle { color: var(--primary); font-weight: 500; font-size: 10pt; }
 .item-date { color: #6B7280; font-size: 8pt; white-space: nowrap; padding: 2px 8px; background: var(--primary-light); border-radius: 10px; }
 .item-description { color: #4B5563; font-size: 10pt; line-height: 1.5; margin-top: 6px; }
 .item-description ul { margin-left: 15px; margin-top: 4px; }
 .skills-container { display: flex; flex-wrap: wrap; gap: 6px; padding-left: 36px; }
 .skill-item { background: linear-gradient(135deg, var(--primary-light), #E0E7FF); color: var(--primary); padding: 5px 12px; border-radius: 16px; font-size: 9pt; font-weight: 500; border: 1px solid rgba(79,70,229,0.15); }
 .summary-text { background: linear-gradient(135deg, #F9FAFB, var(--primary-light)); padding: 14px 18px; border-radius: 8px; border-left: 4px solid var(--primary); font-size: 10.5pt; line-height: 1.7; color: #374151; }
 .lang-item { display: inline-flex; align-items: center; gap: 6px; margin-right: 14px; margin-bottom: 4px; font-size: 10pt; color: #374151; }
 .lang-proficiency { font-size: 8pt; color: #6B7280; }
 .ref-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
 .ref-card { padding: 10px; background: #F9FAFB; border-radius: 8px; border: 1px solid #E5E7EB; }
 .ref-name { font-weight: 600; color: #1F2937; font-size: 10pt; }
 .ref-title { font-size: 9pt; color: #6B7280; }
 .social-links { display: flex; flex-wrap: wrap; gap: 8px; }
 .social-link { font-size: 9pt; color: var(--primary); text-decoration: none; display: flex; align-items: center; gap: 4px; }
 .project-tech { display: inline-flex; gap: 4px; flex-wrap: wrap; margin-top: 4px; }
 .project-tech span { background: #E5E7EB; padding: 1px 8px; border-radius: 10px; font-size: 8pt; color: #374151; }
 @media print {
   body { font-size: 10pt; color: #000; }
   .cv-container { padding: 0; max-width: 100%; }
   .cv-item { background: none !important; padding: 6px 0; border-left-color: #4F46E5; }
   .skill-item { background: #EEF2FF !important; color: #4F46E5 !important; border-color: rgba(79,70,229,0.2); }
   .summary-text { background: none; }
   .section-icon { background: #4F46E5 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .item-date { background: #EEF2FF !important; }
 }
 </style>
</head>
<body>
<div class="cv-container">
  <header class="cv-header">
    {% set photo_url = cv.profile_photo|default('') %}
    {% if photo_url %}
    <div class="cv-photo"><img src="{{ photo_url }}" alt="{{ cv.title }}" /></div>
    {% else %}
    <div class="cv-photo"><span class="cv-photo-placeholder">{{ (cv.title|first)|default('?')|upper }}</span></div>
    {% endif %}
    <div class="cv-header-text">
      <h1 class="cv-name">{{ cv.title }}</h1>
      {% for section in sections %}
        {% if section.section_type == 'summary' %}
          {% for item in section.items %}
            {% if item.content.job_title %}<div class="cv-job-title">{{ item.content.job_title }}</div>{% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}
      <div class="cv-contact">
        {% for section in sections %}
          {% if section.section_type == 'summary' %}
          {% for item in section.items %}
            {% if item.content.email %}<span class="contact-item">&#9993; {{ item.content.email }}</span>{% endif %}
            {% if item.content.phone %}<span class="contact-item">&#128222; {{ item.content.phone }}</span>{% endif %}
            {% if item.content.location %}<span class="contact-item">&#128205; {{ item.content.location }}</span>{% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}
      </div>
    </div>
  </header>
  {% for section in sections %}
  <section class="cv-section">
    <div class="section-header">
      <div class="section-icon">
        {%- if section.section_type == 'summary' %}&#128100;
        {% elseif section.section_type == 'experience' %}&#128188;
        {% elseif section.section_type == 'education' %}&#127891;
        {% elseif section.section_type == 'skills' %}&#128736;
        {% elseif section.section_type == 'projects' %}&#128640;
        {% elseif section.section_type == 'certifications' %}&#128220;
        {% elseif section.section_type == 'languages' %}&#127760;
        {% elseif section.section_type == 'references' %}&#128203;
        {% elseif section.section_type == 'social_links' %}&#128279;
        {% else %}&#128196;
        {% endif -%}
      </div>
      <h2 class="section-title">{{ section.title }}</h2>
    </div>
    {% if section.section_type == 'summary' %}
      {% for item in section.items %}
      <div class="summary-text">{{ item.content.text|default(item.content.summary|default('')) }}</div>
      {% endfor %}
    {% elseif section.section_type == 'experience' %}
      <div class="section-content">
      {% for item in section.items %}
        <div class="cv-item">
          <div class="item-header">
            <div><div class="item-title">{{ item.content.position|default('Position') }}</div><div class="item-subtitle">{{ item.content.company|default('Company') }}{% if item.content.location %} &middot; {{ item.content.location }}{% endif %}</div></div>
            <span class="item-date">{{ item.content.start_date|default('') }} - {{ item.content.end_date|default('Present') }}</span>
          </div>
          {% if item.content.description %}<div class="item-description">{{ item.content.description|nl2br }}</div>{% endif %}
        </div>
      {% endfor %}
      </div>
    {% elseif section.section_type == 'education' %}
      <div class="section-content">
      {% for item in section.items %}
        <div class="cv-item">
          <div class="item-header">
            <div><div class="item-title">{{ item.content.degree|default('Degree') }}{% if item.content.field %} in {{ item.content.field }}{% endif %}</div><div class="item-subtitle">{{ item.content.institution|default('Institution') }}</div></div>
            <span class="item-date">{{ item.content.start_date|default('') }} - {{ item.content.end_date|default('') }}</span>
          </div>
          {% if item.content.gpa %}<div class="item-description">GPA: {{ item.content.gpa }}</div>{% endif %}
        </div>
      {% endfor %}
      </div>
    {% elseif section.section_type == 'skills' %}
      <div class="skills-container">
      {% for item in section.items %}
        {% set skills_list = item.content.skills|default([]) %}
        {% if skills_list is empty and item.content.name %}
          {% set skills_list = [item.content.name] %}
        {% endif %}
        {% for s in skills_list %}<span class="skill-item">{{ s }}</span>{% endfor %}
      {% endfor %}
      </div>
    {% elseif section.section_type == 'languages' %}
      <div style="padding-left:36px;">
      {% for item in section.items %}
        <span class="lang-item">{{ item.content.name }} <span class="lang-proficiency">({{ item.content.proficiency|default('') }})</span></span>
      {% endfor %}
      </div>
    {% elseif section.section_type == 'references' %}
      <div class="ref-grid">
      {% for item in section.items %}
        <div class="ref-card">
          <div class="ref-name">{{ item.content.name }}</div>
          <div class="ref-title">{{ item.content.title|default('') }}{% if item.content.company %} &middot; {{ item.content.company }}{% endif %}</div>
          {% if item.content.email %}<div style="font-size:8pt;color:#6B7280;">{{ item.content.email }}</div>{% endif %}
        </div>
      {% endfor %}
      </div>
    {% elseif section.section_type == 'social_links' %}
      <div class="social-links">
      {% for item in section.items %}
        <a href="{{ item.content.url }}" class="social-link">{{ item.content.platform }}</a>
      {% endfor %}
      </div>
    {% elseif section.section_type == 'projects' %}
      <div class="section-content">
      {% for item in section.items %}
        <div class="cv-item">
          <div class="item-title">{{ item.content.name|default('Project') }}</div>
          {% if item.content.description %}<div class="item-description">{{ item.content.description|nl2br }}</div>{% endif %}
          {% if item.content.technologies %}<div class="project-tech"><span>{{ item.content.technologies }}</span></div>{% endif %}
        </div>
      {% endfor %}
      </div>
    {% elseif section.section_type == 'certifications' %}
      <div class="section-content">
      {% for item in section.items %}
        <div class="cv-item" style="border-left-color:var(--accent);">
          <div class="item-title">{{ item.content.name|default('Certification') }}</div>
          <div class="item-subtitle">{{ item.content.issuer|default('') }}</div>
          {% if item.content.date %}<div class="item-date" style="margin-top:4px;display:inline-block;">{{ item.content.date }}</div>{% endif %}
        </div>
      {% endfor %}
      </div>
    {% else %}
      <div class="section-content">
      {% for item in section.items %}
        <div class="cv-item">
          <div class="item-title">{{ item.content.title|default(item.content.name|default('')) }}</div>
          {% if item.content.description or item.content.content %}<div class="item-description">{{ (item.content.description|default(item.content.content|default('')))|nl2br }}</div>{% endif %}
        </div>
      {% endfor %}
      </div>
    {% endif %}
  </section>
  {% endfor %}
</div>
</body>
</html>
