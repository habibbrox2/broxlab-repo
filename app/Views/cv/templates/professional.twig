<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>{{ cv.title }}</title>
 <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
 <style>
 * { margin: 0; padding: 0; box-sizing: border-box; }
 body { font-family: 'Roboto', 'Arial', sans-serif; font-size: 10.5pt; line-height: 1.5; color: #334155; background: #fff; }
 .cv-container { max-width: 210mm; margin: 0 auto; padding: 15mm 20mm; }
 .cv-header { display: flex; align-items: center; gap: 20px; margin-bottom: 20px; padding-bottom: 15px; border-bottom: 2px solid #1E40AF; }
 .cv-photo { width: 90px; height: 90px; border-radius: 8px; object-fit: cover; border: 2px solid #DBEAFE; flex-shrink: 0; background: linear-gradient(135deg, #EFF6FF, #DBEAFE); display: flex; align-items: center; justify-content: center; }
 .cv-photo img { width: 100%; height: 100%; border-radius: 6px; object-fit: cover; }
 .cv-photo-placeholder { font-size: 1.75rem; color: #1E40AF; font-weight: 700; }
 .cv-name { font-size: 24pt; font-weight: 700; color: #1E3A5F; margin-bottom: 2px; }
 .cv-job-title { font-size: 11pt; color: #1E40AF; font-weight: 500; }
 .cv-contact { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 6px; font-size: 9pt; color: #64748B; }
 .contact-item { display: flex; align-items: center; gap: 4px; }
 .cv-section { margin-bottom: 18px; page-break-inside: avoid; }
 .section-title { font-size: 11pt; font-weight: 700; color: #1E40AF; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; border-bottom: 1px solid #DBEAFE; padding-bottom: 4px; }
 .cv-item { margin-bottom: 12px; page-break-inside: avoid; }
 .item-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2px; }
 .item-title { font-weight: 600; color: #1E3A5F; font-size: 11pt; }
 .item-subtitle { color: #1E40AF; font-weight: 500; }
 .item-date { font-size: 9pt; color: #94A3B8; white-space: nowrap; }
 .item-description { font-size: 9.5pt; color: #475569; margin-top: 4px; }
 .item-description ul { margin-left: 14px; margin-top: 2px; }
 .skills-container { display: flex; flex-wrap: wrap; gap: 5px; }
 .skill-item { background: #EFF6FF; color: #1E40AF; padding: 3px 10px; border-radius: 3px; font-size: 9pt; border: 1px solid #BFDBFE; }
 .summary-text { font-size: 10pt; line-height: 1.6; color: #475569; }
 .ref-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
 .ref-card { padding: 8px 10px; border: 1px solid #E2E8F0; border-radius: 4px; }
 .ref-name { font-weight: 600; color: #1E3A5F; }
 .ref-title { font-size: 9pt; color: #64748B; }
 .lang-list { display: flex; flex-wrap: wrap; gap: 12px; }
 .lang-item { font-size: 9.5pt; }
 .lang-proficiency { color: #94A3B8; font-size: 8.5pt; }
 @media print {
   body { font-size: 9.5pt; color: #000; }
   .cv-container { padding: 0; }
   .skill-item { background: #EFF6FF !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .cv-section { page-break-inside: avoid; }
 }
 </style>
</head>
<body>
<div class="cv-container">
  <header class="cv-header">
    {% set photo_url = cv.profile_photo|default('') %}
    {% if photo_url %}
    <div class="cv-photo"><img src="{{ photo_url }}" alt="{{ cv.title }}" /></div>
    {% else %}
    <div class="cv-photo"><span class="cv-photo-placeholder">{{ (cv.title|first)|default('?')|upper }}</span></div>
    {% endif %}
    <div style="flex:1;">
      <h1 class="cv-name">{{ cv.title }}</h1>
      {% for section in sections %}
        {% if section.section_type == 'summary' %}
          {% for item in section.items %}
            {% if item.content.job_title %}<div class="cv-job-title">{{ item.content.job_title }}</div>{% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}
      <div class="cv-contact">
        {% for section in sections %}
          {% if section.section_type == 'summary' %}
            {% for item in section.items %}
              {% if item.content.email %}<span class="contact-item">&#9993; {{ item.content.email }}</span>{% endif %}
              {% if item.content.phone %}<span class="contact-item">&#128222; {{ item.content.phone }}</span>{% endif %}
              {% if item.content.location %}<span class="contact-item">&#128205; {{ item.content.location }}</span>{% endif %}
            {% endfor %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </header>
  {% for section in sections %}
  <section class="cv-section">
    <div class="section-title">{{ section.title }}</div>
    {% if section.section_type == 'summary' %}
      {% for item in section.items %}
      <div class="summary-text">{{ item.content.text|default(item.content.summary|default('')) }}</div>
      {% endfor %}
    {% elseif section.section_type == 'experience' %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="item-header">
          <div><span class="item-title">{{ item.content.position|default('Position') }}</span>{% if item.content.company %} <span class="item-subtitle">&middot; {{ item.content.company }}</span>{% endif %}</div>
          <span class="item-date">{{ item.content.start_date|default('') }} - {{ item.content.end_date|default('Present') }}</span>
        </div>
        {% if item.content.description %}<div class="item-description">{{ item.content.description|nl2br }}</div>{% endif %}
      </div>
      {% endfor %}
    {% elseif section.section_type == 'education' %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="item-header">
          <div><span class="item-title">{{ item.content.degree|default('Degree') }}{% if item.content.field %} in {{ item.content.field }}{% endif %}</span> <span class="item-subtitle">&middot; {{ item.content.institution|default('') }}</span></div>
          <span class="item-date">{{ item.content.start_date|default('') }} - {{ item.content.end_date|default('') }}</span>
        </div>
      </div>
      {% endfor %}
    {% elseif section.section_type == 'skills' %}
      <div class="skills-container">
      {% for item in section.items %}
        {% set skills_list = item.content.skills|default([]) %}
        {% if skills_list is empty and item.content.name %}
          {% set skills_list = [item.content.name] %}
        {% endif %}
        {% for s in skills_list %}<span class="skill-item">{{ s }}</span>{% endfor %}
      {% endfor %}
      </div>
    {% elseif section.section_type == 'languages' %}
      <div class="lang-list">
      {% for item in section.items %}
        <span class="lang-item">{{ item.content.name }} <span class="lang-proficiency">({{ item.content.proficiency|default('') }})</span></span>
      {% endfor %}
      </div>
    {% elseif section.section_type == 'projects' %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="item-title">{{ item.content.name|default('Project') }}</div>
        {% if item.content.description %}<div class="item-description">{{ item.content.description|nl2br }}</div>{% endif %}
      </div>
      {% endfor %}
    {% elseif section.section_type == 'certifications' %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="item-header">
          <span class="item-title">{{ item.content.name|default('') }}</span>
          {% if item.content.date %}<span class="item-date">{{ item.content.date }}</span>{% endif %}
        </div>
        {% if item.content.issuer %}<div class="item-subtitle">{{ item.content.issuer }}</div>{% endif %}
      </div>
      {% endfor %}
    {% elseif section.section_type == 'references' %}
      <div class="ref-grid">
      {% for item in section.items %}
        <div class="ref-card">
          <div class="ref-name">{{ item.content.name }}</div>
          <div class="ref-title">{{ item.content.title|default('') }}{% if item.content.company %} &middot; {{ item.content.company }}{% endif %}</div>
        </div>
      {% endfor %}
      </div>
    {% elseif section.section_type == 'social_links' %}
      <div class="lang-list">
      {% for item in section.items %}
        <span class="lang-item">{{ item.content.platform }}: {{ item.content.url }}</span>
      {% endfor %}
      </div>
    {% else %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="item-title">{{ item.content.title|default(item.content.name|default('')) }}</div>
        {% if item.content.description or item.content.content %}<div class="item-description">{{ (item.content.description|default(item.content.content|default('')))|nl2br }}</div>{% endif %}
      </div>
      {% endfor %}
    {% endif %}
  </section>
  {% endfor %}
</div>
</body>
</html>
