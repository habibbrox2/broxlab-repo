<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>{{ cv.title }}</title>
 <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
 <style>
 :root {
   --gold: #D4A017;
   --gold-light: #FDF3D0;
   --gold-dark: #B8860B;
   --gold-gradient: linear-gradient(135deg, #D4A017, #B8860B);
   --dark: #0F0F1A;
   --dark-2: #1A1A2E;
   --dark-3: #242440;
   --sidebar-bg: linear-gradient(180deg, #0F0F1A 0%, #1A1A2E 100%);
   --text: #2D2D3D;
   --text-light: #6B7280;
   --text-muted: #9CA3AF;
   --bg-alt: #F8F6F0;
   --shadow: 0 2px 8px rgba(0,0,0,0.06);
   --radius: 6px;
 }

 * { margin: 0; padding: 0; box-sizing: border-box; }
 body {
   font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
   font-size: 10pt;
   line-height: 1.55;
   color: var(--text);
   background: white;
 }

 /* ─── TWO-COLUMN LAYOUT ─── */
 .cv-wrapper {
   display: flex;
   max-width: 210mm;
   margin: 0 auto;
   min-height: 297mm;
 }

 /* ─── SIDEBAR (DARK GOLD) ─── */
 .cv-sidebar {
   width: 220px;
   flex-shrink: 0;
   background: var(--sidebar-bg);
   padding: 28px 18px;
   color: rgba(255,255,255,0.85);
   position: relative;
   overflow: hidden;
 }
 .cv-sidebar::before {
   content: '';
   position: absolute;
   top: -40%; left: -30%;
   width: 200%; height: 200%;
   background: radial-gradient(circle at 30% 20%, rgba(212,160,23,0.06) 0%, transparent 60%);
   pointer-events: none;
 }
 .cv-sidebar::after {
   content: '';
   position: absolute;
   bottom: 0; left: 0; right: 0;
   height: 3px;
   background: var(--gold-gradient);
 }

 /* Sidebar Photo */
 .sidebar-photo {
   width: 100px;
   height: 100px;
   border-radius: 50%;
   margin: 0 auto 16px;
   display: block;
   border: 3px solid rgba(212,160,23,0.4);
   object-fit: cover;
   background: rgba(212,160,23,0.1);
   position: relative;
   z-index: 1;
 }
 .sidebar-photo img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
 .sidebar-photo-placeholder {
   width: 100px;
   height: 100px;
   border-radius: 50%;
   margin: 0 auto 16px;
   display: flex;
   align-items: center;
   justify-content: center;
   background: rgba(212,160,23,0.15);
   border: 3px solid rgba(212,160,23,0.4);
   font-family: 'Playfair Display', serif;
   font-size: 2rem;
   font-weight: 700;
   color: var(--gold);
 }

 /* Sidebar Name */
 .sidebar-name {
   font-family: 'Playfair Display', serif;
   font-size: 16pt;
   font-weight: 700;
   color: white;
   text-align: center;
   margin-bottom: 2px;
   line-height: 1.2;
   position: relative;
   z-index: 1;
 }
 .sidebar-title {
   font-size: 8.5pt;
   color: var(--gold);
   text-align: center;
   margin-bottom: 14px;
   font-weight: 500;
   letter-spacing: 0.5px;
   position: relative;
   z-index: 1;
 }

 /* Gold divider */
 .sidebar-divider {
   height: 1px;
   background: linear-gradient(90deg, transparent, rgba(212,160,23,0.4), transparent);
   margin: 12px 0;
   position: relative;
   z-index: 1;
 }
 .sidebar-divider::before {
   content: '\u2666';
   position: absolute;
   left: 50%;
   top: 50%;
   transform: translate(-50%, -50%);
   color: var(--gold);
   font-size: 6pt;
   background: var(--dark-2);
   padding: 0 6px;
 }

 /* Sidebar sections */
 .sidebar-section {
   margin-bottom: 12px;
   position: relative;
   z-index: 1;
 }
 .sidebar-section-title {
   font-size: 7.5pt;
   font-weight: 600;
   color: var(--gold);
   text-transform: uppercase;
   letter-spacing: 1.5px;
   margin-bottom: 6px;
   display: flex;
   align-items: center;
   gap: 6px;
 }
 .sidebar-section-title::after {
   content: '';
   flex: 1;
   height: 1px;
   background: linear-gradient(90deg, rgba(212,160,23,0.3), transparent);
 }

 /* Sidebar contact */
 .sidebar-contact-item {
   display: flex;
   align-items: center;
   gap: 8px;
   font-size: 8pt;
   margin-bottom: 5px;
   color: rgba(255,255,255,0.7);
   line-height: 1.3;
 }
 .sidebar-contact-icon {
   width: 18px;
   height: 18px;
   flex-shrink: 0;
   display: flex;
   align-items: center;
   justify-content: center;
 }

 /* Sidebar skills with bars */
 .sidebar-skill {
   margin-bottom: 6px;
 }
 .sidebar-skill-name {
   font-size: 8pt;
   color: rgba(255,255,255,0.8);
   margin-bottom: 2px;
 }
 .sidebar-skill-bar {
   height: 4px;
   background: rgba(255,255,255,0.1);
   border-radius: 2px;
   overflow: hidden;
 }
 .sidebar-skill-fill {
   height: 100%;
   background: var(--gold-gradient);
   border-radius: 2px;
 }

 /* Sidebar language with stars */
 .sidebar-lang-item {
   display: flex;
   justify-content: space-between;
   align-items: center;
   font-size: 8pt;
   margin-bottom: 4px;
 }
 .sidebar-lang-name { color: rgba(255,255,255,0.8); }
 .sidebar-lang-stars { color: var(--gold); font-size: 6pt; letter-spacing: 1px; }
 .sidebar-lang-level { color: rgba(255,255,255,0.4); font-size: 7pt; }

 /* ─── MAIN CONTENT ─── */
 .cv-main {
   flex: 1;
   padding: 28px 24px 20px;
   background: white;
   position: relative;
 }

 /* Premium watermark */
 .cv-main::before {
   content: 'PREMIUM';
   position: absolute;
   right: 12px;
   bottom: 12px;
   font-family: 'Playfair Display', serif;
   font-size: 28pt;
   font-weight: 800;
   color: rgba(212,160,23,0.04);
   letter-spacing: 6px;
   pointer-events: none;
   line-height: 1;
 }

 /* Main header */
 .main-header {
   margin-bottom: 18px;
   padding-bottom: 14px;
   border-bottom: 2px solid #E5E7EB;
   position: relative;
 }
 .main-header::after {
   content: '';
   position: absolute;
   bottom: -2px;
   left: 0;
   width: 60px;
   height: 2px;
   background: var(--gold-gradient);
 }
 .main-header h1 {
   font-family: 'Playfair Display', serif;
   font-size: 22pt;
   font-weight: 700;
   color: #111827;
   margin-bottom: 2px;
 }
 .main-header .job-title {
   font-size: 10pt;
   color: var(--gold-dark);
   font-weight: 500;
 }
 .main-header .header-summary {
   font-size: 9pt;
   color: var(--text-light);
   margin-top: 6px;
   line-height: 1.5;
 }

 /* Sections */
 .section-block {
   margin-bottom: 14px;
   page-break-inside: avoid;
   position: relative;
 }
 .section-block-title {
   font-family: 'Playfair Display', serif;
   font-size: 11pt;
   font-weight: 700;
   color: #1F2937;
   margin-bottom: 6px;
   display: flex;
   align-items: center;
   gap: 8px;
 }
 .section-block-title .gold-icon {
   width: 20px;
   height: 20px;
   background: var(--gold-gradient);
   border-radius: 4px;
   display: inline-flex;
   align-items: center;
   justify-content: center;
   color: white;
   font-size: 9pt;
   flex-shrink: 0;
 }
 .section-block-title::after {
   content: '';
   flex: 1;
   height: 1px;
   background: linear-gradient(90deg, #E5E7EB, transparent);
 }

 /* Experience/Education items - timeline style */
 .timeline-item {
   padding-left: 14px;
   border-left: 2px solid #E5E7EB;
   margin-left: 6px;
   margin-bottom: 10px;
   position: relative;
   padding-bottom: 6px;
 }
 .timeline-item::before {
   content: '';
   position: absolute;
   left: -5px;
   top: 4px;
   width: 8px;
   height: 8px;
   border-radius: 50%;
   background: var(--gold-gradient);
   border: 2px solid white;
 }
 .timeline-header {
   display: flex;
   justify-content: space-between;
   align-items: baseline;
   margin-bottom: 1px;
 }
 .timeline-title {
   font-weight: 600;
   color: #1F2937;
   font-size: 10pt;
 }
 .timeline-subtitle {
   font-size: 8.5pt;
   color: var(--gold-dark);
   font-weight: 500;
 }
 .timeline-date {
   font-size: 7.5pt;
   color: var(--text-muted);
   white-space: nowrap;
   padding: 1px 6px;
   background: var(--gold-light);
   border-radius: 3px;
   font-weight: 500;
 }
 .timeline-desc {
   font-size: 8.5pt;
   color: var(--text-light);
   margin-top: 3px;
   line-height: 1.45;
 }

 /* Main area skills */
 .main-skills {
   display: flex;
   flex-wrap: wrap;
   gap: 4px;
 }
 .main-skill {
   padding: 3px 10px;
   font-size: 8pt;
   font-weight: 500;
   background: var(--gold-light);
   color: var(--gold-dark);
   border-radius: 12px;
   border: 1px solid rgba(212,160,23,0.15);
 }
 .main-skill.expert {
   background: var(--gold-gradient);
   color: white;
   border: none;
 }

 /* Languages in main */
 .lang-list {
   display: flex;
   flex-wrap: wrap;
   gap: 6px 14px;
 }
 .lang-entry {
   font-size: 9pt;
   color: var(--text);
 }
 .lang-entry .level {
   font-size: 7.5pt;
   color: var(--text-muted);
 }

 /* Certifications */
 .cert-badge {
   display: inline-flex;
   align-items: center;
   gap: 6px;
   padding: 5px 10px;
   background: var(--gold-light);
   border: 1px solid rgba(212,160,23,0.2);
   border-radius: 4px;
   margin-bottom: 4px;
   font-size: 8.5pt;
   width: 100%;
 }
 .cert-badge-icon {
   width: 22px;
   height: 22px;
   background: var(--gold-gradient);
   border-radius: 50%;
   display: inline-flex;
   align-items: center;
   justify-content: center;
   color: white;
   font-size: 7pt;
   flex-shrink: 0;
 }
 .cert-name { font-weight: 500; color: #1F2937; flex: 1; }
 .cert-issuer { font-size: 7.5pt; color: var(--text-muted); }
 .cert-date { font-size: 7pt; color: var(--text-muted); white-space: nowrap; }

 /* References */
 .ref-grid {
   display: grid;
   grid-template-columns: 1fr 1fr;
   gap: 6px;
 }
 .ref-entry {
   padding: 6px 10px;
   background: #F9FAFB;
   border-radius: 4px;
   border: 1px solid #E5E7EB;
   border-left: 2px solid var(--gold);
 }
 .ref-entry-name { font-weight: 600; font-size: 9pt; color: #1F2937; }
 .ref-entry-info { font-size: 7.5pt; color: var(--text-light); }

 /* Projects */
 .project-box {
   padding: 6px 10px;
   margin-bottom: 6px;
   background: #F9FAFB;
   border-radius: 4px;
   border-left: 2px solid var(--gold);
 }
 .project-box .name { font-weight: 600; font-size: 9pt; color: #1F2937; }
 .project-box .desc { font-size: 8pt; color: var(--text-light); margin-top: 2px; }
 .project-box .tech {
   display: inline-flex;
   gap: 3px;
   margin-top: 3px;
   flex-wrap: wrap;
 }
 .project-box .tech span {
   background: #E5E7EB;
   padding: 1px 6px;
   border-radius: 3px;
   font-size: 7pt;
   color: #374151;
 }

 /* Social links */
 .social-row {
   display: flex;
   flex-wrap: wrap;
   gap: 4px 10px;
 }
 .social-link-item {
   font-size: 8pt;
   color: var(--gold-dark);
   text-decoration: none;
 }

 /* Empty state */
 .empty-state {
   font-size: 8.5pt;
   color: var(--text-muted);
   font-style: italic;
   padding: 4px 0;
 }

 /* ─── PRINT ─── */
 @media print {
   body { font-size: 9pt; }
   .cv-wrapper { max-width: 100%; }
   .cv-sidebar { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .cv-sidebar::after { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .sidebar-photo { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .sidebar-photo-placeholder { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .sidebar-skill-fill { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .section-block-title .gold-icon { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .timeline-item::before { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .cert-badge-icon { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .main-skill.expert { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   .timeline-date { background: #FDF3D0 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
 }
 @media (max-width: 700px) {
   .cv-wrapper { flex-direction: column; }
   .cv-sidebar { width: 100%; }
 }
 </style>
</head>
<body>
<div class="cv-wrapper">
  {# ─── SIDEBAR ─── #}
  <aside class="cv-sidebar">
    <!-- Photo -->
    {% set photo_url = cv.profile_photo|default('') %}
    {% if photo_url %}
    <div class="sidebar-photo"><img src="{{ photo_url }}" alt="{{ cv.title }}" /></div>
    {% else %}
    <div class="sidebar-photo-placeholder">{{ (cv.title|first)|default('?')|upper }}</div>
    {% endif %}

    <!-- Name & Title -->
    <div class="sidebar-name">{{ cv.title }}</div>
    {% for section in sections %}
      {% if section.section_type == 'summary' %}
        {% for item in section.items %}
          {% if item.content.job_title %}
    <div class="sidebar-title">{{ item.content.job_title }}</div>
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}

    <div class="sidebar-divider"></div>

    <!-- Contact -->
    <div class="sidebar-section">
      <div class="sidebar-section-title">Contact</div>
      {% for section in sections %}
        {% if section.section_type == 'summary' %}
          {% for item in section.items %}
            {% if item.content.email %}
      <div class="sidebar-contact-item">
        <span class="sidebar-contact-icon">&#9993;</span>
        <span>{{ item.content.email }}</span>
      </div>
            {% endif %}
            {% if item.content.phone %}
      <div class="sidebar-contact-item">
        <span class="sidebar-contact-icon">&#128222;</span>
        <span>{{ item.content.phone }}</span>
      </div>
            {% endif %}
            {% if item.content.location %}
      <div class="sidebar-contact-item">
        <span class="sidebar-contact-icon">&#128205;</span>
        <span>{{ item.content.location }}</span>
      </div>
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    </div>

    <div class="sidebar-divider"></div>

    <!-- Skills with bars -->
    {% for section in sections %}
      {% if section.section_type == 'skills' %}
    <div class="sidebar-section">
      <div class="sidebar-section-title">Expertise</div>
      {% for item in section.items %}
        {% set skills_list = item.content.skills|default([]) %}
        {% if skills_list is empty and item.content.name %}
          {% set skills_list = [item.content.name] %}
        {% endif %}
        {% for s in skills_list %}
      <div class="sidebar-skill">
        <div class="sidebar-skill-name">{{ s }}</div>
        <div class="sidebar-skill-bar">
          <div class="sidebar-skill-fill" style="width:{{ 60 + (loop.index0 * 7) % 30 }}%;"></div>
        </div>
      </div>
        {% endfor %}
      {% endfor %}
    </div>
      {% endif %}
    {% endfor %}

    <!-- Languages with stars -->
    {% for section in sections %}
      {% if section.section_type == 'languages' %}
    <div class="sidebar-section">
      <div class="sidebar-section-title">Languages</div>
      {% for item in section.items %}
      <div class="sidebar-lang-item">
        <span class="sidebar-lang-name">{{ item.content.name }}</span>
        {% set prof = item.content.proficiency|lower|default('intermediate') %}
        {% set stars = 3 %}
        {% if prof in ['native', 'fluent'] %}
          {% set stars = 5 %}
        {% elseif prof == 'advanced' %}
          {% set stars = 4 %}
        {% elseif prof == 'basic' %}
          {% set stars = 2 %}
        {% endif %}
        <span class="sidebar-lang-stars">{% for i in 1..stars %}&#9733;{% endfor %}<span class="sidebar-lang-level"> {{ item.content.proficiency|default('') }}</span></span>
      </div>
      {% endfor %}
    </div>
      {% endif %}
    {% endfor %}

    <!-- Social Links -->
    {% for section in sections %}
      {% if section.section_type == 'social_links' %}
    <div class="sidebar-section">
      <div class="sidebar-section-title">Connect</div>
      {% for item in section.items %}
      <div class="sidebar-contact-item">
        <span class="sidebar-contact-icon">&#128279;</span>
        <span>{{ item.content.platform }}</span>
      </div>
      {% endfor %}
    </div>
      {% endif %}
    {% endfor %}
  </aside>

  {# ─── MAIN CONTENT ─── #}
  <main class="cv-main">
    <!-- Header summary area -->
    <div class="main-header">
      <h1>{{ cv.title }}</h1>
      {% for section in sections %}
        {% if section.section_type == 'summary' %}
          {% for item in section.items %}
            {% if item.content.job_title %}<div class="job-title">{{ item.content.job_title }}</div>{% endif %}
            {% if item.content.text or item.content.summary %}
              {% set summary_text = item.content.text|default(item.content.summary|default('')) %}
              {% if summary_text %}
          <div class="header-summary">{{ summary_text }}</div>
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    </div>

    {# ─── SECTIONS LOOP ─── #}
    {% for section in sections %}
      {# Skip summary - already shown in header #}
      {% if section.section_type != 'summary' %}

    <section class="section-block">
      <div class="section-block-title">
        <span class="gold-icon">
          {%- if section.section_type == 'experience' %}&#128188;
          {% elseif section.section_type == 'education' %}&#127891;
          {% elseif section.section_type == 'skills' %}&#9881;
          {% elseif section.section_type == 'projects' %}&#128640;
          {% elseif section.section_type == 'certifications' %}&#127891;
          {% elseif section.section_type == 'languages' %}&#127760;
          {% elseif section.section_type == 'references' %}&#128100;
          {% elseif section.section_type == 'social_links' %}&#128279;
          {% else %}&#128196;
          {% endif -%}
        </span>
        {{ section.title }}
      </div>

      {# ─── EXPERIENCE (Timeline) ─── #}
      {% if section.section_type == 'experience' %}
        {% for item in section.items %}
        <div class="timeline-item">
          <div class="timeline-header">
            <div>
              <div class="timeline-title">{{ item.content.position|default('Position') }}</div>
              <div class="timeline-subtitle">{{ item.content.company|default('') }}{% if item.content.location %} &middot; {{ item.content.location }}{% endif %}</div>
            </div>
            <span class="timeline-date">{{ item.content.start_date|default('') }} – {{ item.content.end_date|default('Present') }}</span>
          </div>
          {% if item.content.description %}<div class="timeline-desc">{{ item.content.description|nl2br }}</div>{% endif %}
        </div>
        {% endfor %}

      {# ─── EDUCATION (Timeline) ─── #}
      {% elseif section.section_type == 'education' %}
        {% for item in section.items %}
        <div class="timeline-item">
          <div class="timeline-header">
            <div>
              <div class="timeline-title">{{ item.content.degree|default('Degree') }}{% if item.content.field %} in {{ item.content.field }}{% endif %}</div>
              <div class="timeline-subtitle">{{ item.content.institution|default('Institution') }}</div>
            </div>
            <span class="timeline-date">{{ item.content.start_date|default('') }} – {{ item.content.end_date|default('') }}</span>
          </div>
          {% if item.content.gpa %}<div class="timeline-desc">GPA: {{ item.content.gpa }}</div>{% endif %}
        </div>
        {% endfor %}

      {# ─── SKILLS (Tags in main area) ─── #}
      {% elseif section.section_type == 'skills' %}
        <div class="main-skills">
        {% for item in section.items %}
          {% set skills_list = item.content.skills|default([]) %}
          {% if skills_list is empty and item.content.name %}
            {% set skills_list = [item.content.name] %}
          {% endif %}
          {% for s in skills_list %}
          <span class="main-skill{% if loop.first %} expert{% endif %}">{{ s }}</span>
          {% endfor %}
        {% endfor %}
        </div>

      {# ─── LANGUAGES ─── #}
      {% elseif section.section_type == 'languages' %}
        <div class="lang-list">
        {% for item in section.items %}
          <span class="lang-entry">{{ item.content.name }} <span class="level">{{ item.content.proficiency|default('') }}</span></span>
        {% endfor %}
        </div>

      {# ─── CERTIFICATIONS (Badge style) ─── #}
      {% elseif section.section_type == 'certifications' %}
        {% for item in section.items %}
        <div class="cert-badge">
          <span class="cert-badge-icon">&#10003;</span>
          <span class="cert-name">{{ item.content.name|default('Certification') }}</span>
          {% if item.content.issuer %}<span class="cert-issuer">{{ item.content.issuer }}</span>{% endif %}
          {% if item.content.date %}<span class="cert-date">{{ item.content.date }}</span>{% endif %}
        </div>
        {% endfor %}

      {# ─── PROJECTS ─── #}
      {% elseif section.section_type == 'projects' %}
        {% for item in section.items %}
        <div class="project-box">
          <div class="name">{{ item.content.name|default('Project') }}</div>
          {% if item.content.description %}<div class="desc">{{ item.content.description|nl2br }}</div>{% endif %}
          {% if item.content.technologies %}
          <div class="tech"><span>{{ item.content.technologies }}</span></div>
          {% endif %}
        </div>
        {% endfor %}

      {# ─── REFERENCES ─── #}
      {% elseif section.section_type == 'references' %}
        {% if section.items|length > 0 %}
        <div class="ref-grid">
        {% for item in section.items %}
          <div class="ref-entry">
            <div class="ref-entry-name">{{ item.content.name }}</div>
            <div class="ref-entry-info">{{ item.content.title|default('') }}{% if item.content.company %} @ {{ item.content.company }}{% endif %}</div>
            {% if item.content.email %}<div class="ref-entry-info">{{ item.content.email }}</div>{% endif %}
          </div>
        {% endfor %}
        </div>
        {% endif %}

      {# ─── SOCIAL LINKS ─── #}
      {% elseif section.section_type == 'social_links' %}
        <div class="social-row">
        {% for item in section.items %}
          <a href="{{ item.content.url }}" class="social-link-item">{{ item.content.platform }}</a>
        {% endfor %}
        </div>

      {# ─── OTHER / CUSTOM ─── #}
      {% else %}
        {% for item in section.items %}
        <div class="timeline-item">
          <div class="timeline-title">{{ item.content.title|default(item.content.name|default('')) }}</div>
          {% if item.content.description or item.content.content %}<div class="timeline-desc">{{ (item.content.description|default(item.content.content|default('')))|nl2br }}</div>{% endif %}
        </div>
        {% else %}
        <div class="empty-state">No content</div>
        {% endfor %}
      {% endif %}
    </section>
      {% endif %}
    {% else %}
    <div class="empty-state">No sections available</div>
    {% endfor %}
  </main>
</div>
</body>
</html>
