<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>{{ cv.title }}</title>
 <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
 <style>
   * { margin: 0; padding: 0; box-sizing: border-box; }
   body { font-family: 'Inter', 'Georgia', serif; font-size: 10.5pt; line-height: 1.6; color: #2D3436; background: #fff; }
   .cv-container { max-width: 210mm; margin: 0 auto; padding: 15mm 20mm; }

   /* ── Header ── */
   .cv-header { text-align: center; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 2px solid #1B2A4A; }
   .cv-photo-wrapper { display: flex; justify-content: center; margin-bottom: 12px; }
   .cv-photo { width: 85px; height: 85px; border-radius: 50%; object-fit: cover; border: 2px solid #D4C5A9; background: #F5F0EB; display: flex; align-items: center; justify-content: center; }
   .cv-photo img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
   .cv-photo-placeholder { font-family: 'Playfair Display', serif; font-size: 1.75rem; color: #1B2A4A; font-weight: 600; }
   .cv-name { font-family: 'Playfair Display', serif; font-size: 26pt; font-weight: 700; color: #1B2A4A; letter-spacing: 1px; margin-bottom: 3px; }
   .cv-job-title { font-size: 11pt; color: #4A5568; font-weight: 400; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 10px; }
   .cv-contact { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; color: #6B7280; font-size: 8.5pt; letter-spacing: 0.3px; }
   .contact-item { display: flex; align-items: center; gap: 4px; }
   .contact-item .icon { width: 12px; height: 12px; display: inline-block; }

   /* ── Sections ── */
   .cv-section { margin-bottom: 16px; page-break-inside: avoid; }
   .section-title { font-family: 'Playfair Display', serif; font-size: 13pt; font-weight: 600; color: #1B2A4A; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 6px; padding-bottom: 3px; border-bottom: 1px solid #E8E0D6; }
   .section-title::after { content: ''; display: block; width: 40px; height: 2px; background: #D4C5A9; margin-top: 3px; }

   /* ── Items ── */
   .cv-item { margin-bottom: 10px; page-break-inside: avoid; }
   .item-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2px; }
   .item-title { font-weight: 600; color: #1B2A4A; font-size: 11pt; }
   .item-subtitle { font-weight: 400; color: #4A5568; }
   .item-date { font-size: 8.5pt; color: #9CA3AF; white-space: nowrap; }
   .item-description { font-size: 9.5pt; color: #4B5563; margin-top: 3px; line-height: 1.55; }
   .item-description ul { margin-left: 16px; margin-top: 2px; padding-left: 0; }
   .item-description li { margin-bottom: 1px; }

   /* ── Summary ── */
   .summary-text { font-size: 10pt; line-height: 1.65; color: #4B5563; font-style: italic; }

   /* ── Skills ── */
   .skills-list { font-size: 9.5pt; color: #4B5563; line-height: 1.7; }
   .skills-list .skill-category { font-weight: 500; color: #1B2A4A; }
   .skills-list .skill-items { margin-left: 4px; }
   .skills-list .skill-items span:not(:last-child)::after { content: ' \2022 '; color: #D4C5A9; }

   /* ── Languages ── */
   .lang-list { display: flex; flex-wrap: wrap; gap: 16px; font-size: 9.5pt; }
   .lang-item { color: #4B5563; }
   .lang-name { font-weight: 500; color: #1B2A4A; }
   .lang-proficiency { color: #9CA3AF; font-size: 8.5pt; }

   /* ── References ── */
   .ref-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 4px; }
   .ref-card { padding: 6px 8px; border-left: 2px solid #D4C5A9; }
   .ref-name { font-weight: 600; color: #1B2A4A; font-size: 10pt; }
   .ref-detail { font-size: 9pt; color: #6B7280; }

   /* ── Projects ── */
   .project-title { font-weight: 600; color: #1B2A4A; font-size: 10.5pt; }

   /* ── Certifications ── */
   .cert-title { font-weight: 500; color: #2D3436; font-size: 10pt; }

   /* ── Print ── */
   @media print {
     body { font-size: 9.5pt; color: #000; }
     .cv-container { padding: 0; }
     .section-title::after { background: #D4C5A9 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
     .cv-section { page-break-inside: avoid; }
     .cv-item { page-break-inside: avoid; }
     .ref-card { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
   }
 </style>
</head>
<body>
<div class="cv-container">
  <header class="cv-header">
    {% set photo_url = cv.profile_photo|default('') %}
    <div class="cv-photo-wrapper">
      {% if photo_url %}
      <div class="cv-photo"><img src="{{ photo_url }}" alt="{{ cv.title }}" /></div>
      {% else %}
      <div class="cv-photo"><span class="cv-photo-placeholder">{{ (cv.title|first)|default('?')|upper }}</span></div>
      {% endif %}
    </div>
    <h1 class="cv-name">{{ cv.title }}</h1>
    {% for section in sections %}
      {% if section.section_type == 'summary' %}
        {% for item in section.items %}
          {% if item.content.job_title %}<div class="cv-job-title">{{ item.content.job_title }}</div>{% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}
    <div class="cv-contact">
      {% for section in sections %}
        {% if section.section_type == 'summary' %}
          {% for item in section.items %}
            {% if item.content.email %}<span class="contact-item">&#9993; {{ item.content.email }}</span>{% endif %}
            {% if item.content.phone %}<span class="contact-item">&#9742; {{ item.content.phone }}</span>{% endif %}
            {% if item.content.address %}<span class="contact-item">&#128205; {{ item.content.address }}</span>{% endif %}
            {% if item.content.website %}<span class="contact-item">&#127760; {{ item.content.website }}</span>{% endif %}
            {% if item.content.linkedin %}<span class="contact-item">&#128279; {{ item.content.linkedin }}</span>{% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    </div>
  </header>

  {% for section in sections %}
  <section class="cv-section">
    <h2 class="section-title">{{ section.title }}</h2>

    {% if section.section_type == 'summary' %}
      {% for item in section.items %}
      <div class="summary-text">{{ item.content.text|default(item.content.summary|default('')) }}</div>
      {% endfor %}

    {% elseif section.section_type == 'experience' %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="item-header">
          <div>
            <span class="item-title">{{ item.content.position|default('Position') }}</span>
            {% if item.content.company %}<span class="item-subtitle"> &mdash; {{ item.content.company }}</span>{% endif %}
          </div>
          <span class="item-date">{{ item.content.start_date|default('') }} &ndash; {{ item.content.end_date|default('Present') }}</span>
        </div>
        {% if item.content.location %}<div style="font-size:8.5pt;color:#9CA3AF;margin-bottom:2px;">{{ item.content.location }}</div>{% endif %}
        {% if item.content.description %}<div class="item-description">{{ item.content.description|nl2br }}</div>{% endif %}
      </div>
      {% endfor %}

    {% elseif section.section_type == 'education' %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="item-header">
          <div>
            <span class="item-title">{{ item.content.degree|default('Degree') }}{% if item.content.field %} in {{ item.content.field }}{% endif %}</span>
            <span class="item-subtitle"> &mdash; {{ item.content.institution|default('') }}</span>
          </div>
          <span class="item-date">{{ item.content.start_date|default('') }} &ndash; {{ item.content.end_date|default('') }}</span>
        </div>
        {% if item.content.gpa %}<div style="font-size:9pt;color:#6B7280;">GPA: {{ item.content.gpa }}</div>{% endif %}
      </div>
      {% endfor %}

    {% elseif section.section_type == 'skills' %}
      <div class="skills-list">
      {% for item in section.items %}
        {% set skills_list = item.content.skills|default(item.content.name ? [item.content.name] : []) %}
        {% if loop.first %}<span class="skill-items">{% endif %}
        {% for s in skills_list %}<span>{{ s }}</span>{% endfor %}
        {% if loop.last %}</span>{% endif %}
      {% endfor %}
      </div>

    {% elseif section.section_type == 'languages' %}
      <div class="lang-list">
      {% for item in section.items %}
        <span class="lang-item"><span class="lang-name">{{ item.content.name }}</span> <span class="lang-proficiency">({{ item.content.proficiency|default('') }})</span></span>
      {% endfor %}
      </div>

    {% elseif section.section_type == 'projects' %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="project-title">{{ item.content.name|default('Project') }}</div>
        {% if item.content.description %}<div class="item-description">{{ item.content.description|nl2br }}</div>{% endif %}
      </div>
      {% endfor %}

    {% elseif section.section_type == 'certifications' %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="item-header">
          <span class="cert-title">{{ item.content.name|default('') }}</span>
          {% if item.content.date %}<span class="item-date">{{ item.content.date }}</span>{% endif %}
        </div>
        {% if item.content.issuer %}<div style="font-size:9pt;color:#6B7280;">{{ item.content.issuer }}</div>{% endif %}
      </div>
      {% endfor %}

    {% elseif section.section_type == 'references' %}
      <div class="ref-grid">
      {% for item in section.items %}
        <div class="ref-card">
          <div class="ref-name">{{ item.content.name }}</div>
          <div class="ref-detail">{{ item.content.title|default('') }}{% if item.content.company %} &mdash; {{ item.content.company }}{% endif %}</div>
        </div>
      {% endfor %}
      </div>

    {% elseif section.section_type == 'social_links' %}
      <div class="skills-list">
      {% for item in section.items %}
        <span>{{ item.content.platform }}: {{ item.content.url }}</span>{% if not loop.last %}<br>{% endif %}
      {% endfor %}
      </div>

    {% else %}
      {% for item in section.items %}
      <div class="cv-item">
        <div class="item-title">{{ item.content.title|default(item.content.name|default('')) }}</div>
        {% if item.content.description or item.content.content %}<div class="item-description">{{ (item.content.description|default(item.content.content|default('')))|nl2br }}</div>{% endif %}
      </div>
      {% endfor %}
    {% endif %}
  </section>
  {% endfor %}
</div>
</body>
</html>
