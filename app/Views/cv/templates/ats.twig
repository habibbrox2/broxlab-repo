<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>{{ cv.title }}</title>
 <style>
 * {
 margin: 0;
 padding: 0;
 box-sizing: border-box;
 }
 
 body {
 font-family: 'Arial', sans-serif;
 font-size: 10pt;
 line-height: 1.3;
 color: #000;
 background: #fff;
 }
 
 .mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 {
 max-width: 210mm;
 margin: 0 auto;
 padding: 10mm;
 }
 
 .header {
 margin-bottom: 15px;
 text-align: left;
 }
 
 .header h1 {
 font-size: 16pt;
 font-weight: bold;
 }
 
 .section {
 margin-bottom: 12px;
 }
 
 .section-title {
 font-size: 11pt;
 font-weight: bold;
 text-decoration: underline;
 margin-bottom: 5px;
 }
 
 .item {
 margin-bottom: 8px;
 margin-left: 10px;
 }
 
 .item-title {
 font-weight: bold;
 }
 
 .item-subtitle {
 font-style: normal;
 }
 
 .item-date {
 font-style: normal;
 }
 
 .item-content {
 margin-left: 15px;
 }
 
 .skills-list {
 margin-left: 15px;
 }
 
 /* ATS-friendly: no complex tables, no floating elements */
 p, div {
 display: block;
 }
 
 /* Avoid fancy formatting that ATS can't read */
 .no-graphics {
 border: none;
 background: none;
 }
 </style>
</head>
<body>
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <!-- Header -->
 <div class="header">
 <h1>{{ cv.title }}</h1>
 </div>

 <!-- Sections -->
 {% for section in sections %}
 <div class="section">
 <h2 class="section-title">{{ section.title|upper }}</h2>
 
 {% if section.section_type == 'summary' %}
 {% for item in section.items %}
 <div class="item">
 {{ item.content.text ?? '' }}
 </div>
 {% endfor %}
 
 {% elseif section.section_type == 'experience' %}
 {% for item in section.items %}
 <div class="item">
 <span class="item-title">{{ item.content.position ?? '' }}</span> - 
 <span class="item-subtitle">{{ item.content.company ?? '' }}</span> - 
 <span class="item-date">{{ item.content.start_date ?? '' }} to {{ item.content.end_date ?? 'Present' }}</span>
 <div class="item-content">
 {{ item.content.description ?? '' }}
 </div>
 </div>
 {% endfor %}
 
 {% elseif section.section_type == 'education' %}
 {% for item in section.items %}
 <div class="item">
 <span class="item-title">{{ item.content.degree ?? '' }}</span> - 
 <span class="item-subtitle">{{ item.content.institution ?? '' }}</span> - 
 <span class="item-date">{{ item.content.start_date ?? '' }} to {{ item.content.end_date ?? '' }}</span>
 </div>
 {% endfor %}
 
 {% elseif section.section_type == 'skills' %}
 <div class="skills-list">
 {% for item in section.items %}
 {{ item.content.name ?? '' }}{% if not loop.last %}; {% endif %}
 {% endfor %}
 </div>
 
 {% elseif section.section_type == 'projects' %}
 {% for item in section.items %}
 <div class="item">
 <span class="item-title">{{ item.content.name ?? '' }}</span>
 <div class="item-content">
 {{ item.content.description ?? '' }}
 </div>
 </div>
 {% endfor %}
 
 {% elseif section.section_type == 'certifications' %}
 {% for item in section.items %}
 <div class="item">
 <span class="item-title">{{ item.content.name ?? '' }}</span> - 
 <span class="item-subtitle">{{ item.content.issuer ?? '' }}</span> - 
 <span class="item-date">{{ item.content.date ?? '' }}</span>
 </div>
 {% endfor %}
 {% endif %}
 </div>
 {% endfor %}
 </div>
</body>
</html>


