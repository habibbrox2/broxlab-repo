// ─── SPINNER KEYFRAMES ───
var style = document.createElement('style');
style.textContent = '@keyframes spin { to { transform: rotate(360deg); } }';
document.head.appendChild(style);

// ─── INIT ───
function escHtml(str) { if (!str) return ''; return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;'); }
document.addEventListener('DOMContentLoaded', function() {
  mktInitFavs();
  mktSortTemplates();

  // Handle bKash callback redirect params
  var urlParams = new URLSearchParams(window.location.search);
  var paymentStatus = urlParams.get('payment');
  if (paymentStatus === 'success') {
    var purchaseId = urlParams.get('purchase_id') || '';
    var trxId = urlParams.get('trxid') || '';
    var templateSlug = urlParams.get('template_slug') || '';
    // Show success notification
    var msg = 'Payment successful! Your premium template is now available. Transaction ID: ' + trxId;
    if (typeof window.showMessage !== 'undefined') {
      window.showMessage(msg, 'success');
    } else {
      alert(msg);
    }
    // Auto-open the payment modal in success mode with upgrade offer
    if (templateSlug && window.__mktTemplates[templateSlug]) {
      var tmpl = window.__mktTemplates[templateSlug];
      window.__mktPaySlug = templateSlug;
      document.getElementById('mkt-pay-name').textContent = tmpl.name || 'Premium Template';
      document.getElementById('mkt-pay-amount').textContent = tmpl.price || 50;
      document.getElementById('mkt-pay-success-template').textContent = tmpl.name || 'Premium Template';
      document.getElementById('mkt-pay-step-method').style.display = 'none';
      document.getElementById('mkt-pay-step-details').style.display = 'none';
      document.getElementById('mkt-pay-step-success').style.display = '';
      document.getElementById('mkt-payment-modal').classList.add('open');
      document.body.style.overflow = 'hidden';
      // Show upgrade offer
      setTimeout(function() {
        mktShowUpgradeOffer(templateSlug, tmpl.name);
      }, 500);
    }
    // Clean URL without reload
    if (window.history.replaceState) {
      urlParams.delete('payment');
      urlParams.delete('purchase_id');
      urlParams.delete('trxid');
      urlParams.delete('template_slug');
      var newUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
      window.history.replaceState({}, document.title, newUrl);
    }
  } else if (paymentStatus === 'cancel' || paymentStatus === 'failure') {
    var msg = 'Payment was cancelled or failed. You can try again.';
    if (typeof window.showMessage !== 'undefined') {
      window.showMessage(msg, 'warning');
    } else {
      alert(msg);
    }
    if (window.history.replaceState) {
      urlParams.delete('payment');
      var newUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
      window.history.replaceState({}, document.title, newUrl);
    }
  }
});
</script>
{% endblock %}
