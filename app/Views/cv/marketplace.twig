window.__mktPaySlug = '';
window.__mktPayPurchaseId = 0;

function mktOpenPaymentModal(slug) {
  var tmpl = window.__mktTemplates[slug];
  if (!tmpl) return;

  // Check if user is authenticated
  {% if not is_authenticated %}
  window.location.href = '/login?redirect=' + encodeURIComponent('/cv-builder/templates');
  return;
  {% endif %}

  window.__mktPaySlug = slug;
  window.__mktPayPurchaseId = 0;

  document.getElementById('mkt-pay-name').textContent = tmpl.name || 'Premium Template';
  document.getElementById('mkt-pay-amount').textContent = tmpl.price || 50;
  document.getElementById('mkt-pay-details-amount').textContent = tmpl.price || 50;
  document.getElementById('mkt-pay-success-template').textContent = tmpl.name || 'Premium Template';

  // Reset to step 1
  document.getElementById('mkt-pay-step-method').style.display = '';
  document.getElementById('mkt-pay-step-details').style.display = 'none';
  document.getElementById('mkt-pay-step-success').style.display = 'none';
  document.getElementById('mkt-pay-loading').style.display = 'none';
  document.getElementById('mkt-pay-phone').value = '';
  document.getElementById('mkt-pay-trxid').value = '';

  // Highlight selected method
  document.querySelectorAll('.mkt-pay-method-btn').forEach(function(b) {
    b.style.borderColor = 'var(--mkt-gray-200)';
    b.style.background = 'white';
  });

  document.getElementById('mkt-payment-modal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function mktClosePaymentModal() {
  document.getElementById('mkt-payment-modal').classList.remove('open');
  document.body.style.overflow = '';
}

function mktSelectMethod(method) {
  window.__mktPayMethod = method;
  document.querySelectorAll('.mkt-pay-method-btn').forEach(function(b) {
    if (b.getAttribute('data-method') === method) {
      b.style.borderColor = '#D4A017';
      b.style.background = '#FDF3D0';
    } else {
      b.style.borderColor = 'var(--mkt-gray-200)';
      b.style.background = 'white';
    }
  });

  var label = method.charAt(0).toUpperCase() + method.slice(1);
  document.getElementById('mkt-pay-method-label').textContent = label;

  // For bKash: show checkout button; for others: show manual flow with merchant number + trxid
  var merchants = { bkash: '01XXXXXXXXX', nagad: '01XXXXXXXXX', rocket: '01XXXXXXXXX' };
  document.getElementById('mkt-pay-merchant').textContent = merchants[method] || '01XXXXXXXXX';

  // Show/hide bKash Checkout elements
  var bkashCheckoutEl = document.getElementById('mkt-pay-bkash-checkout');
  var manualFieldsEl = document.getElementById('mkt-pay-manual-fields');
  var merchantInfoEl = document.getElementById('mkt-pay-merchant-info');
  
  if (method === 'bkash') {
    bkashCheckoutEl.style.display = '';
    manualFieldsEl.style.display = 'none';
    merchantInfoEl.style.display = 'none';
    document.getElementById('mkt-pay-submit-btn').textContent = 'Pay via bKash Checkout';
  } else {
    bkashCheckoutEl.style.display = 'none';
    manualFieldsEl.style.display = '';
    merchantInfoEl.style.display = '';
    document.getElementById('mkt-pay-submit-btn').textContent = 'Submit Payment';
  }

  document.getElementById('mkt-pay-step-method').style.display = 'none';
  document.getElementById('mkt-pay-step-details').style.display = '';
}

function mktBackToMethods() {
  document.getElementById('mkt-pay-step-details').style.display = 'none';
  document.getElementById('mkt-pay-step-method').style.display = '';
}

function mktSubmitPayment() {
  var method = window.__mktPayMethod || 'bkash';
  var phone = document.getElementById('mkt-pay-phone').value.trim();

  if (!phone) { alert('Please enter your phone number.'); document.getElementById('mkt-pay-phone').focus(); return; }

  // bKash Checkout API flow
  if (method === 'bkash') {
    mktPayWithBkashCheckout(phone);
    return;
  }

  // Manual flow for other methods
  var trxId = document.getElementById('mkt-pay-trxid').value.trim();
  if (!trxId) { alert('Please enter the transaction ID from your payment.'); document.getElementById('mkt-pay-trxid').focus(); return; }

  document.getElementById('mkt-pay-step-details').style.display = 'none';
  document.getElementById('mkt-pay-loading').style.display = '';
  document.getElementById('mkt-pay-submit-btn').disabled = true;

  var baseUrl = window.location.origin;
  var csrfToken = '{{ csrf_token }}';

  fetch(baseUrl + '/api/cv/templates/initiate-purchase', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken },
    body: JSON.stringify({ template_slug: window.__mktPaySlug, payment_method: method, phone_number: phone })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.success && data.purchase_id) {
      window.__mktPayPurchaseId = data.purchase_id;
      return fetch(baseUrl + '/api/cv/templates/verify-purchase', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken },
        body: JSON.stringify({ purchase_id: data.purchase_id, transaction_id: trxId })
      });
    } else {
      throw new Error(data.error || 'Failed to initiate purchase');
    }
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    document.getElementById('mkt-pay-loading').style.display = 'none';
    document.getElementById('mkt-pay-submit-btn').disabled = false;
    if (data.success) {
      document.getElementById('mkt-pay-step-success').style.display = '';
      if (typeof gtag !== 'undefined') { gtag('event', 'purchase', { currency: 'BDT', value: 50 }); }
      // Show upgrade offer for purchased template
      if (window.__mktPaySlug) {
        var tmpl = window.__mktTemplates[window.__mktPaySlug];
        setTimeout(function() {
          mktShowUpgradeOffer(window.__mktPaySlug, tmpl ? tmpl.name : '');
        }, 300);
      }
    } else {
      alert('Error: ' + (data.error || 'Verification failed'));
      mktBackToMethods();
    }
  })
  .catch(function(err) {
    document.getElementById('mkt-pay-loading').style.display = 'none';
    document.getElementById('mkt-pay-submit-btn').disabled = false;
    alert('An error occurred: ' + err.message);
    mktBackToMethods();
  });
}

/**
 * Pay with bKash Checkout API — redirects to bKash hosted checkout page.
 */
function mktPayWithBkashCheckout(phone) {
  document.getElementById('mkt-pay-step-details').style.display = 'none';
  document.getElementById('mkt-pay-loading').style.display = '';
  document.getElementById('mkt-pay-submit-btn').disabled = true;

  var baseUrl = window.location.origin;
  var csrfToken = '{{ csrf_token }}';

  fetch(baseUrl + '/api/cv/templates/bkash-checkout', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken },
    body: JSON.stringify({ template_slug: window.__mktPaySlug, phone_number: phone })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    document.getElementById('mkt-pay-loading').style.display = 'none';
    document.getElementById('mkt-pay-submit-btn').disabled = false;

    if (!data.success) {
      if (data.purchased) {
        alert('You have already purchased this template!');
        mktClosePaymentModal();
        return;
      }
      if (data.pending) {
        alert('You have a pending purchase. Please wait for confirmation.');
        mktClosePaymentModal();
        return;
      }
      alert('Error: ' + (data.error || 'Failed to initiate bKash checkout'));
      mktBackToMethods();
      return;
    }

    // If we have a checkout URL, redirect to bKash
    if (data.checkout_url) {
      window.location.href = data.checkout_url;
      return;
    }

    // If gateway is unavailable, fall back to manual flow
    if (data.manual_fallback) {
      alert('bKash gateway is currently unavailable. You can make a manual payment instead.');
      // Switch to manual flow for bKash
      window.__mktPayMethod = 'bkash';
      document.getElementById('mkt-pay-merchant').textContent = data.merchant_number || '01XXXXXXXXX';
      document.getElementById('mkt-pay-bkash-checkout').style.display = 'none';
      document.getElementById('mkt-pay-merchant-info').style.display = '';
      document.getElementById('mkt-pay-manual-fields').style.display = '';
      document.getElementById('mkt-pay-submit-btn').textContent = 'Submit Payment';
      document.getElementById('mkt-pay-step-details').style.display = '';
      return;
    }

    alert('Unexpected response. Please try again.');
    mktBackToMethods();
  })
  .catch(function(err) {
    document.getElementById('mkt-pay-loading').style.display = 'none';
    document.getElementById('mkt-pay-submit-btn').disabled = false;
    alert('Connection error: ' + err.message);
    mktBackToMethods();
  });
}

// ─── CV UPGRADE AFTER PURCHASE ───
/**
 * Fetches user's CVs and shows upgrade options in the success step.
 * @param {string} templateSlug - e.g. 'executive'
 * @param {string} templateName - e.g. 'Executive Elite'
 */
function mktShowUpgradeOffer(templateSlug, templateName) {
  var section = document.getElementById('mkt-pay-upgrade-section');
  var list = document.getElementById('mkt-upgrade-cv-list');
  var noCvs = document.getElementById('mkt-upgrade-no-cvs');
  var loading = document.getElementById('mkt-upgrade-loading');
  var nameEl = document.getElementById('mkt-upgrade-template-name');
  var linkEl = document.getElementById('mkt-upgrade-new-link');

  if (!section) return;

  nameEl.textContent = templateName || (templateSlug.charAt(0).toUpperCase() + templateSlug.slice(1));
  linkEl.href = '/cv-builder/infos?template=' + encodeURIComponent(templateSlug);
  linkEl.innerHTML = '<i class="lucide lucide-plus" style="width:1em;height:1em;"></i> Open CV Builder with ' + escHtml(templateName || templateSlug);

  section.style.display = '';
  list.innerHTML = '';
  noCvs.style.display = 'none';
  loading.style.display = '';

  fetch('/api/cv/my-cvs')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      loading.style.display = 'none';
      if (!data.success || !data.cvs || data.cvs.length === 0) {
        noCvs.style.display = '';
        return;
      }
      var upgradable = data.cvs.filter(function(cv) {
        return cv.template === 'minimal';
      });
      if (upgradable.length === 0) {
        noCvs.style.display = '';
        return;
      }
      list.innerHTML = '';
      upgradable.forEach(function(cv) {
        var item = document.createElement('div');
        item.style.cssText = 'display:flex;align-items:center;justify-content:space-between;padding:0.65rem 0.85rem;border:1px solid var(--mkt-gray-200);border-radius:10px;background:white;transition:all 0.2s;';
        item.innerHTML = '<div style="display:flex;align-items:center;gap:0.5rem;min-width:0;">' +
          '<i class="lucide lucide-file-text" style="width:1em;height:1em;flex-shrink:0;color:var(--mkt-primary);"></i>' +
          '<span style="font-size:0.85rem;font-weight:500;color:var(--mkt-gray-700);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + escHtml(cv.title) + '</span>' +
          '</div>' +
          '<button class="mkt-upgrade-btn" data-action="mkt-upgrade-cv" data-cv-id="' + cv.id + '" data-template="' + templateSlug + '" style="flex-shrink:0;padding:0.35rem 0.85rem;border-radius:8px;font-size:0.8rem;font-weight:600;border:none;cursor:pointer;background:linear-gradient(135deg,var(--mkt-primary),var(--mkt-secondary));color:white;transition:all 0.2s;">Apply</button>';
        list.appendChild(item);
      });
    })
    .catch(function() {
      loading.style.display = 'none';
      noCvs.style.display = '';
    });
}

