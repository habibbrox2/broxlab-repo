{% extends 'layout.twig' %}

{% block title %}{{ page_title|default('Create CV') }}{% endblock %}

{% block content %}
<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-indigo-50/30 py-8 px-4 relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gradient-to-br from-indigo-100/40 to-purple-100/30 rounded-full -translate-y-1/2 translate-x-1/4 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-[350px] h-[350px] bg-gradient-to-tr from-teal-100/30 to-cyan-100/20 rounded-full translate-y-1/4 -translate-x-1/4 blur-3xl"></div>
  </div>

  <div class="max-w-2xl mx-auto relative">
    {# Header Card - Enhanced with better visual hierarchy #}
    <div class="relative mb-8 overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 via-indigo-700 to-violet-700 text-white shadow-2xl shadow-indigo-500/30">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(255,255,255,0.22),transparent_55%)] bg-[radial-gradient(ellipse_at_bottom_left,rgba(99,102,241,0.2),transparent_50%)]" aria-hidden="true"></div>
      <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/4 blur-2xl"></div>
      <div class="relative px-8 py-10 text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/20 border border-white/25 mb-5 shadow-xl backdrop-blur-sm">
          <i class="lucide lucide-file-earmark-text w-7 h-7 text-white"></i>
        </div>
        <h1 class="text-2xl font-bold mb-2 tracking-tight">{{ page_title }}</h1>
        <p class="text-indigo-100 text-sm max-w-md mx-auto leading-relaxed">আপনার পেশাদার সিভি তৈরি করুন এবং ক্যারিয়ারের নতুন দিগন্ত উন্মোচন করুন</p>
      </div>
    </div>

    {# Create Form - Enhanced cards with better spacing #}
    <form method="POST" action="/cv-builder" class="space-y-4">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

      {# CV Title - Enhanced Input Group #}
      <div class="group bg-white/90 backdrop-blur-sm rounded-2xl p-6 shadow-lg shadow-slate-200/50 border border-slate-200/80 hover:border-indigo-300 hover:shadow-xl hover:shadow-indigo-100/40 transition-all duration-300">
        <label for="title" class="form-label flex items-center gap-2 text-sm font-semibold text-slate-700 mb-2.5">
          <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-indigo-50 text-indigo-600">
            <i data-lucide="text-cursor-input" class="w-4 h-4"></i>
          </span>
          সিভি শিরোনাম
        </label>
        <div class="relative">
          <input type="text" id="title" name="title" value="My CV"
                 class="form-input pl-10"
                 placeholder="e.g. My Professional CV">
          <i data-lucide="type" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none"></i>
        </div>
        <p class="form-hint flex items-center gap-1.5 mt-2 text-xs text-slate-500">
          <i data-lucide="info" class="w-3 h-3"></i>
          আপনার সিভি সনাক্ত করার জন্য একটি নাম দিন
        </p>
      </div>

      {# Profession / Job Title #}
      <div class="group bg-white/90 backdrop-blur-sm rounded-2xl p-6 shadow-lg shadow-slate-200/50 border border-slate-200/80 hover:border-indigo-300 hover:shadow-xl hover:shadow-indigo-100/40 transition-all duration-300">
        <label for="profession" class="form-label flex items-center gap-2 text-sm font-semibold text-slate-700 mb-2.5">
          <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-indigo-50 text-indigo-600">
            <i data-lucide="briefcase" class="w-4 h-4"></i>
          </span>
          পেশা / চাকরির শিরোনাম
        </label>
        <div class="relative">
          <input type="text" id="profession" name="profession"
                 class="form-input pl-10"
                 placeholder="e.g. Software Engineer, Doctor, Teacher"
                 value="{{ profession|default() }}">
          <i data-lucide="user" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none"></i>
        </div>
        <p class="form-hint flex items-center gap-1.5 mt-2 text-xs text-slate-500">
          <i data-lucide="info" class="w-3 h-3"></i>
          আপনার পেশা নির্বাচন করলে প্রিফিলড সাজেশন পাওয়া যাবে
        </p>
      </div>

      {# Template Selection - Enhanced Radio Cards #}
      <div class="group bg-white/90 backdrop-blur-sm rounded-2xl p-6 shadow-lg shadow-slate-200/50 border border-slate-200/80 hover:border-indigo-300 hover:shadow-xl hover:shadow-indigo-100/40 transition-all duration-300">
        <label class="form-label flex items-center gap-2 text-sm font-semibold text-slate-700 mb-2">
          <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-indigo-50 text-indigo-600">
            <i data-lucide="layout-template" class="w-4 h-4"></i>
          </span>
          টেমপ্লেট নির্বাচন করুন
        </label>
        <p class="form-hint mb-5 text-xs text-slate-500">আপনার পছন্দের টেমপ্লেট বেছে নিন। পরে পরিবর্তন করতে পারবেন।</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <label class="pill-option justify-center text-center !p-4 !flex-col !gap-2.5 group/card" data-active="true">
            <input type="radio" name="template" value="modern" checked>
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-md shadow-indigo-200/50 group-hover/card:shadow-lg group-hover/card:scale-105 transition-all duration-200">
              <i class="lucide lucide-palette w-5 h-5 text-white"></i>
            </div>
            <span class="text-xs font-semibold text-slate-700">Modern</span>
          </label>
          <label class="pill-option justify-center text-center !p-4 !flex-col !gap-2.5 group/card">
            <input type="radio" name="template" value="minimal">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-slate-600 to-slate-500 flex items-center justify-center shadow-md shadow-slate-200/50 group-hover/card:shadow-lg group-hover/card:scale-105 transition-all duration-200">
              <i class="lucide lucide-minus w-5 h-5 text-white"></i>
            </div>
            <span class="text-xs font-semibold text-slate-700">Minimal</span>
          </label>
          <label class="pill-option justify-center text-center !p-4 !flex-col !gap-2.5 group/card">
            <input type="radio" name="template" value="ats">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500 to-emerald-600 flex items-center justify-center shadow-md shadow-emerald-200/50 group-hover/card:shadow-lg group-hover/card:scale-105 transition-all duration-200">
              <i class="lucide lucide-bot w-5 h-5 text-white"></i>
            </div>
            <span class="text-xs font-semibold text-slate-700">ATS</span>
          </label>
          <label class="pill-option justify-center text-center !p-4 !flex-col !gap-2.5 group/card">
            <input type="radio" name="template" value="professional">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-600 to-blue-500 flex items-center justify-center shadow-md shadow-blue-200/50 group-hover/card:shadow-lg group-hover/card:scale-105 transition-all duration-200">
              <i class="lucide lucide-briefcase w-5 h-5 text-white"></i>
            </div>
            <span class="text-xs font-semibold text-slate-700">Professional</span>
          </label>
        </div>
      </div>

      {# Professional Status - Enhanced Toggle Cards #}
      <div class="group bg-white/90 backdrop-blur-sm rounded-2xl p-6 shadow-lg shadow-slate-200/50 border border-slate-200/80 hover:border-indigo-300 hover:shadow-xl hover:shadow-indigo-100/40 transition-all duration-300">
        <label class="form-label flex items-center gap-2 text-sm font-semibold text-slate-700 mb-4">
          <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-indigo-50 text-indigo-600">
            <i data-lucide="user-check" class="w-4 h-4"></i>
          </span>
          কর্মজীবনের অবস্থা
        </label>
        <div class="grid grid-cols-2 gap-3">
          <label class="pill-option group/status" data-active="true">
            <input type="radio" name="professional_status" value="looking" checked>
            <i data-lucide="briefcase" class="w-4 h-4 text-indigo-600"></i>
            <span class="text-sm font-medium text-slate-700">চাকরি খুঁজছি</span>
          </label>
          <label class="pill-option group/status">
            <input type="radio" name="professional_status" value="resting">
            <i data-lucide="pause" class="w-4 h-4 text-indigo-600"></i>
            <span class="text-sm font-medium text-slate-700">বিশ্রামে</span>
          </label>
        </div>
      </div>

      {# Actions - Enhanced Buttons #}
      <div class="flex items-center gap-3 pt-3">
        <a href="/cv-builder" class="btn btn-ghost flex-1 justify-center gap-2">
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          ফিরে যান
        </a>
        <button type="submit" class="btn btn-primary flex-1 justify-center gap-2 shadow-lg shadow-indigo-500/25 hover:shadow-xl hover:shadow-indigo-500/30 hover:-translate-y-0.5">
          <i data-lucide="plus" class="w-4 h-4"></i>
          সিভি তৈরি করুন
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
