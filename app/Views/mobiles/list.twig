{% extends "layout.twig" %}
{% block title %}Latest Phones & Mobile Devices - {{ app_settings.site_name|default("Mobile Updates") }}{% endblock %}
{% block extra_styles %}
  <link rel="stylesheet" href="{{ asset('assets/css/feed-discovery.css') }}?v={{ assets_version }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ asset('assets/css/feed-discovery.css') }}?v={{ assets_version }}"></noscript>
{% endblock %}
{% block extra_scripts %}
  <script type="module" src="{{ asset('assets/js/dist/feed-discovery.js') }}?v={{ assets_version }}"></script>
{% endblock %}
{% block meta_description %}Explore the latest mobile phones and devices. View detailed specifications, comparisons, and reviews for your perfect smartphone.{% endblock %}
{% block og_type %}website{% endblock %}
{% set breadcrumbs = [{"label":"Mobiles","url":"/mobiles","icon":"smartphone"}] %}

{% set page_schema = {
 '@context': 'https://schema.org',
 '@type': 'CollectionPage',
 'name': 'Latest Phones & Mobile Devices',
 'description': 'Browse the latest mobile phones and smartphone specifications',
 'url': current_url
} %}
{% block schema %}
 <script type="application/ld+json">
{{ page_schema|schema_json }}
 

<script>
document.addEventListener("click", function(e) {
  var t = e.target.closest("[data-action]");
  if (!t) return;
  switch (t.getAttribute("data-action")) {
  case "delete-mobile": deleteMobile(t.dataset.id); break;
  case "toggle-mobile": toggleMobile(t.dataset.id); break;
  }
});
</script>

<script>
document.addEventListener("change", function(e) {
  var t = e.target.closest("[data-action]");
  if (t && t.getAttribute("data-action") === "auto-submit" && t.form) t.form.submit();
});
</script>
</script>
{% endblock %}
{% block content %}
 {# ================= Hero Section ================= #}
 <section class="relative overflow-hidden bg-gradient-to-br from-indigo-600 via-purple-600 to-indigo-800 py-14 md:py-18 mb-8 md:mb-10 shadow-[inset_0_-1px_0_rgba(255,255,255,0.12)]">
  <div class="pointer-events-none absolute inset-0">
   <div class="absolute -top-20 -right-16 h-72 w-72 rounded-full bg-cyan-300/15 blur-3xl"></div>
   <div class="absolute -bottom-20 -left-20 h-80 w-80 rounded-full bg-purple-400/15 blur-3xl"></div>
   <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(255,255,255,0.12),transparent_50%)]"></div>
  </div>
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
   <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 md:gap-6">
    <div class="max-w-2xl">
     <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-semibold text-white/90 shadow-lg backdrop-blur-sm">
      <i class="lucide lucide-smartphone w-3.5 h-3.5"></i>
      <span>Phone Database</span>
      <i class="lucide lucide-chevron-right w-3 h-3"></i>
     </div>
     <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-3 tracking-tight">
      Latest <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 to-purple-200">Mobile Phones</span>
     </h1>
     <p class="text-base md:text-lg text-white/70 max-w-xl">Explore the newest smartphones with detailed specifications, pricing, and image galleries.</p>
    </div>
    <div class="flex-shrink-0">
     <div class="flex h-24 w-24 md:h-28 md:w-28 items-center justify-center rounded-[1.75rem] bg-white/10 border border-white/20 shadow-2xl backdrop-blur-sm">
      <span class="text-5xl md:text-6xl">📱</span>
     </div>
    </div>
   </div>
  </div>
 </section>

 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-8">
  {# ================= Filter Card ================= #}
  <form method="get" class="discovery-toolbar mb-6">
    <div class="toolbar-row">
      <div class="toolbar-search-wrap">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input type="search" name="search" value="{{ search|default("") }}" placeholder="Search mobiles..." autocomplete="off">
      </div>
      <select name="per_page" class="toolbar-select" data-action="auto-submit" aria-label="Items per page">
        {% for opt in available_per_page|default([12, 24, 36, 48]) %}
          <option value="{{ opt }}" {% if per_page == opt %}selected{% endif %}>{{ opt }}</option>
        {% endfor %}
      </select>
      <select name="sort" class="toolbar-select" data-action="auto-submit" aria-label="Sort mobiles">
        <option value="release_date" {% if sort == 'release_date' %}selected{% endif %}>Release Date</option>
        <option value="brand_name" {% if sort == 'brand_name' %}selected{% endif %}>Brand</option>
        <option value="model_name" {% if sort == 'model_name' %}selected{% endif %}>Model</option>
        <option value="created_at" {% if sort == 'created_at' %}selected{% endif %}>Recently Added</option>
        <option value="id" {% if sort == 'id' %}selected{% endif %}>ID</option>
      </select>
    </div>
  </form>

  {# ================= Mobiles Grid ================= #}
  {% if mobiles|length > 0 %}
    <div id="discovery-feed-grid" class="is-grid-view grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" role="feed" aria-label="Mobiles feed">
      {% for mobile in mobiles %}
        {% set mobile_image = mobile.thumbnail_path|default(mobile.image_path)|default('') %}
        {% set mobile_images = mobile_image ? [mobile_image] : [] %}
        {% include 'partials/discovery-card.twig' with { item: {
          images: mobile_images,
          image: mobile_image,
          title: mobile.brand_name ~ ' ' ~ mobile.model_name,
          subtitle: mobile.release_date ? ('Released ' ~ mobile.release_date|date('M Y')) : (mobile.official_price ? 'Official price: ' ~ mobile.official_price|number_format(0, '.', ',') ~ ' à§³' : ''),
          categories: [ {name: mobile.brand_name|default('Phone')} ],
          tags: [],
          created_at: mobile.created_at,
          url: mobile.id,
          id: mobile.id,
          type: 'mobile'
        }, index: loop.index } %}
      {% endfor %}
    </div>

    {% if total_pages is defined and total_pages > 1 %}
      <div class="pagination-container py-8">
        <div class="pagination" aria-label="Mobile list pagination">
          {% if current_page > 1 %}
            <a class="pagination-link" href="?page={{ current_page - 1 }}&per_page={{ per_page }}&search={{ search|default("") }}&sort={{ sort|default("release_date") }}" aria-label="Previous page">
              <i class="lucide lucide-chevron-left"></i>
            </a>
          {% else %}
            <span class="pagination-link disabled"><i class="lucide lucide-chevron-left"></i></span>
          {% endif %}

          {% set start_page = max(2, current_page - 2) %}
          {% set end_page = min(total_pages - 1, current_page + 2) %}

          <a class="pagination-link {% if current_page == 1 %}active{% endif %}" href="?page=1&per_page={{ per_page }}&search={{ search|default("") }}&sort={{ sort|default("release_date") }}">1</a>
          {% if start_page > 2 %}
            <span class="pagination-link disabled" aria-hidden="true">...</span>
          {% endif %}
          {% for p in start_page..end_page %}
            <a class="pagination-link {% if p == current_page %}active{% endif %}" href="?page={{ p }}&per_page={{ per_page }}&search={{ search|default("") }}&sort={{ sort|default("release_date") }}">{{ p }}</a>
          {% endfor %}
          {% if end_page < total_pages - 1 %}
            <span class="pagination-link disabled" aria-hidden="true">...</span>
          {% endif %}
          <a class="pagination-link {% if current_page == total_pages %}active{% endif %}" href="?page={{ total_pages }}&per_page={{ per_page }}&search={{ search|default("") }}&sort={{ sort|default("release_date") }}">{{ total_pages }}</a>
          {% if current_page < total_pages %}
            <a class="pagination-link" href="?page={{ current_page + 1 }}&per_page={{ per_page }}&search={{ search|default("") }}&sort={{ sort|default("release_date") }}" aria-label="Next page">
              <i class="lucide lucide-chevron-right"></i>
            </a>
          {% else %}
            <span class="pagination-link disabled"><i class="lucide lucide-chevron-right"></i></span>
          {% endif %}
        </div>
      </div>
    {% endif %}
  {% else %}
    <div class="empty-state py-24 text-center">
      <i class="lucide lucide-smartphone mb-4 inline-flex h-20 w-20 items-center justify-center rounded-3xl bg-slate-100 text-slate-500"></i>
      <h3 class="mt-6 text-2xl font-bold text-slate-900">No mobiles found</h3>
      <p class="mx-auto mt-2 max-w-md text-sm text-slate-500">Try adjusting your search filters or clear the current query.</p>
      <a href="/mobiles" class="mt-6 inline-flex items-center justify-center rounded-xl bg-indigo-600 px-6 py-3 text-sm font-bold text-white shadow-md shadow-indigo-500/20 transition-all duration-200 hover:bg-indigo-700">
        <i class="lucide lucide-refresh-cw w-4 h-4"></i>
        <span>Reset filters</span>
      </a>
    </div>
  {% endif %}
 </div>
{% endblock %}

