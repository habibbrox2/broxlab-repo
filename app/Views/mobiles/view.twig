{% extends "layout.twig" %}
{% block title %}{{ mobile.brand_name }} {{ mobile.model_name }} - Phone Specifications & Reviews{% endblock %}
{% block meta_description %}Complete specifications and information about {{ mobile.brand_name }} {{ mobile.model_name }} phone{% endblock %}
{% block og_image %}{{ main_image|default(app_settings.site_logo|default(url ~ 'assets/images/default-image.png')) }}{% endblock %}
{% block og_type %}product{% endblock %}
{% set breadcrumbs = [
 { label: 'Mobiles', url: '/mobiles', icon: 'smartphone' },
 { label: mobile.brand_name ~ ' ' ~ mobile.model_name, icon: 'smartphone' }
] %}
{% set image_count = images|length %}
{% set spec_count = specifications|length %}
{% set main_image = image_count > 0 ? images[0].image_url : null %}
{% set page_image = main_image ? main_image : app_settings.site_logo|default(url ~ 'assets/images/default-image.png')|absolute_url %}
{% set page_schema = {
 '@context': 'https://schema.org',
 '@type': 'Product',
 'name': mobile.brand_name ~ ' ' ~ mobile.model_name,
 'description': 'Complete specifications and information about ' ~ mobile.brand_name ~ ' ' ~ mobile.model_name ~ ' phone',
 'brand': {
  '@type': 'Brand',
  'name': mobile.brand_name
 },
 'image': page_image,
 'url': current_url,
 'offers': {
  '@type': 'Offer',
  'url': current_url,
  'availability': 'https://schema.org/InStock',
  'priceCurrency': 'BDT',
  'shippingDetails': {
   '@type': 'ShippingDeliveryTime',
   'shippingRate': { '@type': 'PriceSpecification', 'priceCurrency': 'BDT', 'price': 0 },
   'shippingDestination': { '@type': 'ShippingRateArea', 'areaServed': 'BD' },
   'deliveryTime': {
    '@type': 'ShippingDeliveryTime',
    'handlingTime': { '@type': 'QuantitativeValue', 'minValue': 0, 'maxValue': 2, 'unitCode': 'DAY' },
    'transitTime': { '@type': 'QuantitativeValue', 'minValue': 1, 'maxValue': 5, 'unitCode': 'DAY' }
   }
  },
  'hasMerchantReturnPolicy': {
   '@type': 'MerchantReturnPolicy',
   'returnsAccepted': true,
   'returnPolicyCategory': 'https://schema.org/MerchantReturnFiniteReturnWindow',
   'merchantReturnDays': 30,
   'returnMethod': 'https://schema.org/ReturnByMail',
   'returnFees': 'https://schema.org/FreeReturn'
  }
 },
 'aggregateRating': {
  '@type': 'AggregateRating',
  'ratingValue': 4.5,
  'reviewCount': comments|length
 },
 'isPartOf': { '@type': 'WebSite', '@id': url }
} %}
{% if mobile.official_price and mobile.official_price > 0 %}
 {% set page_schema = page_schema|merge({
  'offers': page_schema.offers|merge({
   'price': mobile.official_price|round(2),
   'priceSpecification': { '@type': 'PriceSpecification', 'priceCurrency': 'BDT', 'price': mobile.official_price|round(2) }
  })
 }) %}
{% elseif mobile.unofficial_price and mobile.unofficial_price > 0 %}
 {% set page_schema = page_schema|merge({
  'offers': page_schema.offers|merge({ 'price': mobile.unofficial_price|round(2) })
 }) %}
{% endif %}
{% block schema %}
 <script type="application/ld+json">
{{ page_schema|schema_json }}
 </script>
{% endblock %}
{% block extra_styles %}
 <link rel="stylesheet" href="{{ asset('assets/css/feed-discovery.css') }}?v={{ assets_version }}" media="print" onload="this.media='all'">
 <noscript><link rel="stylesheet" href="{{ asset('assets/css/feed-discovery.css') }}?v={{ assets_version }}"></noscript>
{% endblock %}

{% block content %}
<section class="py-4 lg:py-6">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

  {# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     HERO: Gallery + Summary Side-by-Side
     â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• #}
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-8">

   {# â”€â”€ Gallery Column â”€â”€ #}
   <div class="lg:col-span-6 xl:col-span-5">
    <div class="sticky top-24">
     {% if image_count > 0 %}
      {# Main Gallery Image #}
      <div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" id="mobileGallery" role="region" aria-label="{{ mobile.brand_name }} {{ mobile.model_name }} image gallery">
       <div class="relative overflow-hidden" id="galleryMain">
        {% for img in images %}
         <div class="gallery-slide {% if loop.first %}block{% else %}hidden{% endif %}" data-gallery-idx="{{ loop.index0 }}">
          <div class="aspect-[4/3] flex items-center justify-center bg-white p-4">
           <img src="{{ img.image_url }}"
            alt="{{ mobile.brand_name }} {{ mobile.model_name }} - Image {{ loop.index }}"
            class="max-h-full max-w-full object-contain transition-opacity duration-300"
            loading="{{ loop.first ? 'eager' : 'lazy' }}"
            decoding="async">
          </div>
         </div>
        {% endfor %}

        {# Navigation Arrows #}
        {% if image_count > 1 %}
         <button type="button" id="galleryPrev"
          class="absolute left-3 top-1/2 z-10 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-slate-700 shadow-md backdrop-blur-sm transition-all hover:bg-white hover:shadow-lg active:scale-95"
          aria-label="Previous image">
          <i class="lucide lucide-chevron-left w-5 h-5"></i>
         </button>
         <button type="button" id="galleryNext"
          class="absolute right-3 top-1/2 z-10 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-slate-700 shadow-md backdrop-blur-sm transition-all hover:bg-white hover:shadow-lg active:scale-95"
          aria-label="Next image">
          <i class="lucide lucide-chevron-right w-5 h-5"></i>
         </button>
        {% endif %}

        {# Counter #}
        {% if image_count > 1 %}
         <div class="absolute right-3 bottom-3 z-10 rounded-full bg-slate-900/70 px-3 py-1 text-xs font-semibold text-white shadow-sm backdrop-blur-sm">
          <span id="galleryCounter">1</span>/{{ image_count }}
         </div>
        {% endif %}
       </div>

       {# Thumbnails #}
       {% if image_count > 1 %}
        <div class="flex gap-2 overflow-x-auto border-t border-slate-100 bg-slate-50/80 p-3" id="galleryThumbs" role="tablist" aria-label="Image thumbnails">
         {% for img in images %}
          <button type="button"
           class="gallery-thumb flex-shrink-0 overflow-hidden rounded-xl border-2 transition-all duration-200 {% if loop.first %}border-indigo-500 shadow-sm{% else %}border-transparent opacity-60 hover:opacity-100{% endif %}"
           data-thumb-idx="{{ loop.index0 }}"
           aria-label="View image {{ loop.index }}"
           aria-current="{{ loop.first ? 'true' : 'false' }}">
           <div class="h-16 w-16 overflow-hidden bg-white">
            <img src="{{ img.image_url }}"
             alt="Thumbnail {{ loop.index }}"
             class="h-full w-full object-cover"
             loading="lazy"
             decoding="async">
           </div>
          </button>
         {% endfor %}
        </div>
       {% endif %}
      </div>
     {% else %}
      {# Empty State #}
      <div class="flex aspect-[4/3] items-center justify-center rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-50 to-slate-100">
       <div class="text-center">
        <div class="mx-auto mb-3 inline-flex h-16 w-16 items-center justify-center rounded-full bg-slate-200 text-slate-400">
         <i class="lucide lucide-smartphone text-3xl"></i>
        </div>
        <p class="text-sm font-medium text-slate-500">No image available</p>
       </div>
      </div>
     {% endif %}
    </div>
   </div>

   {# â”€â”€ Summary Column â”€â”€ #}
   <div class="lg:col-span-6 xl:col-span-7">
    {# Kicker #}
    <div class="mb-3 flex flex-wrap items-center gap-2">
     <span class="inline-flex items-center gap-1.5 rounded-full {% if mobile.status == 'official' %}bg-emerald-100 text-emerald-700{% else %}bg-slate-100 text-slate-600{% endif %} px-3 py-1 text-xs font-semibold">
      <i class="lucide lucide-{{ mobile.status == 'official' ? 'check-circle' : 'info' }} w-3.5 h-3.5"></i>
      {{ mobile.status|capitalize }}
     </span>
     <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-100 text-indigo-700 px-3 py-1 text-xs font-semibold">
      <i class="lucide lucide-building w-3.5 h-3.5"></i>
      {{ mobile.brand_name }}
     </span>
    </div>

    {# Title #}
    <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 mb-3">
     {{ mobile.brand_name }} {{ mobile.model_name }}
    </h1>
    <p class="text-base text-slate-500 mb-6">Pricing, specifications, image gallery, and related devices in one place.</p>

    {# Quick Stats Grid #}
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
     <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-sm">
      <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Release</span>
      <strong class="text-sm text-slate-900">{{ mobile.release_date ? mobile.release_date|date("F d, Y") : 'Unknown' }}</strong>
     </div>
     <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-sm">
      <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Images</span>
      <strong class="text-sm text-slate-900">{{ image_count }}</strong>
     </div>
     <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-sm">
      <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Specs</span>
      <strong class="text-sm text-slate-900">{{ spec_count }}</strong>
     </div>
     <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-sm">
      <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Availability</span>
      <strong class="text-sm text-slate-900">{{ mobile.is_official ? 'Official' : 'Market' }}</strong>
     </div>
    </div>

    {# Pricing Strip #}
    <div class="flex flex-wrap gap-3 mb-6">
     {% if mobile.official_price %}
      <div class="rounded-xl bg-gradient-to-br from-emerald-50 to-emerald-100/60 border border-emerald-200 p-3.5 min-w-[140px] shadow-sm">
       <span class="block text-xs font-semibold uppercase tracking-wider text-emerald-600 mb-1">Official Price</span>
       <strong class="text-xl font-bold text-emerald-800">{{ mobile.official_price|number_format(2, '.', ',') }} à§³</strong>
      </div>
     {% endif %}
     {% if mobile.unofficial_price %}
      <div class="rounded-xl bg-gradient-to-br from-amber-50 to-amber-100/60 border border-amber-200 p-3.5 min-w-[140px] shadow-sm">
       <span class="block text-xs font-semibold uppercase tracking-wider text-amber-600 mb-1">Market Price</span>
       <strong class="text-xl font-bold text-amber-800">{{ mobile.unofficial_price|number_format(2, '.', ',') }} à§³</strong>
      </div>
     {% endif %}
    </div>

    {# Tags #}
    {% if mobile.tags %}
     <div class="flex flex-wrap gap-2 mb-6" aria-label="Related mobile tags">
      {% for tag in mobile.tags %}
       <a href="/mobiles?tag={{ tag.slug }}"
        class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 shadow-sm transition hover:border-indigo-300 hover:text-indigo-600 hover:bg-indigo-50">
        <i class="lucide lucide-tag w-3 h-3"></i>
        {{ tag.name }}
       </a>
      {% endfor %}
     </div>
    {% endif %}

    {# Quick Links #}
    <div class="flex flex-wrap gap-2">
     <a href="#tab-specs" class="mobile-quick-link inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 active:scale-[0.97]" data-mobile-tab-trigger="specs">
      <i class="lucide lucide-check-square w-4 h-4"></i>
      <span>Specifications</span>
     </a>
     <a href="#tab-images" class="mobile-quick-link inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 active:scale-[0.97]" data-mobile-tab-trigger="images">
      <i class="lucide lucide-images w-4 h-4"></i>
      <span>Images</span>
     </a>
     {% if mobile.official_price or mobile.unofficial_price %}
      <a href="#tab-price" class="mobile-quick-link inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 active:scale-[0.97]" data-mobile-tab-trigger="price">
       <i class="lucide lucide-circle-dollar-sign w-4 h-4"></i>
       <span>Price</span>
      </a>
     {% endif %}
     <a href="/mobiles" class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 active:scale-[0.97]">
      <i class="lucide lucide-grid-3x3 w-4 h-4"></i>
      <span>All Mobiles</span>
     </a>
    </div>
   </div>
  </div>

  {# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     TABS: Specs / Images / Price
     â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• #}
  <div class="mt-8 lg:mt-10">
   {# Tab Header #}
   <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
     <h2 class="text-xl md:text-2xl font-bold text-slate-900">Device Details</h2>
     <p class="text-sm text-slate-500">Browse structured information without leaving the page.</p>
    </div>
    <div class="flex gap-1.5 rounded-2xl border border-slate-200 bg-slate-50/80 p-1.5 shadow-sm" role="tablist" aria-label="Mobile detail tabs">
     <button class="tab-btn active inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2 text-sm font-semibold text-slate-900 shadow-sm transition hover:bg-white"
      id="specs-tab"
      role="tab"
      data-tab="specs"
      aria-selected="true"
      aria-controls="tab-specs">
      <i class="lucide lucide-check-square w-4 h-4"></i>
      <span class="hidden sm:inline">Specifications</span>
      <span class="sm:hidden">Specs</span>
     </button>
     <button class="tab-btn inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold text-slate-600 transition hover:text-slate-900 hover:bg-white/80"
      id="images-tab"
      role="tab"
      data-tab="images"
      aria-selected="false"
      aria-controls="tab-images">
      <i class="lucide lucide-images w-4 h-4"></i>
      <span class="hidden sm:inline">Images</span>
      <span class="sm:hidden">Photos</span>
     </button>
     {% if mobile.official_price or mobile.unofficial_price %}
      <button class="tab-btn inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold text-slate-600 transition hover:text-slate-900 hover:bg-white/80"
       id="price-tab"
       role="tab"
       data-tab="price"
       aria-selected="false"
       aria-controls="tab-price">
       <i class="lucide lucide-circle-dollar-sign w-4 h-4"></i>
       <span>Price</span>
      </button>
     {% endif %}
    </div>
   </div>

   {# Tab Content #}
   <div>
    {# â”€â”€ Specs Tab â”€â”€ #}
    <div id="tab-specs" role="tabpanel" aria-labelledby="specs-tab" data-tab-panel="specs">
     {% if specifications %}
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
       <div class="divide-y divide-slate-100">
        {% for spec in specifications %}
         <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-5 py-3.5 {% if loop.index is odd %}bg-slate-50/50{% endif %} transition hover:bg-indigo-50/30">
          <span class="text-sm font-semibold text-slate-700">{{ spec.spec_key }}</span>
          <span class="col-span-2 text-sm text-slate-600">{{ spec.spec_value }}</span>
         </div>
        {% endfor %}
       </div>
      </div>
     {% else %}
      <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center shadow-sm">
       <div class="mx-auto mb-3 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-slate-100 text-slate-400">
        <i class="lucide lucide-alert-circle text-2xl"></i>
       </div>
       <p class="text-slate-500 font-medium">No specifications available.</p>
      </div>
     {% endif %}
    </div>

    {# â”€â”€ Images Tab â”€â”€ #}
    <div id="tab-images" role="tabpanel" aria-labelledby="images-tab" data-tab-panel="images" class="hidden">
     {% if images %}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
       {% for img in images %}
        <a href="{{ img.image_url }}"
         target="_blank"
         rel="noopener noreferrer"
         class="group block overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
         <div class="aspect-[4/3] overflow-hidden bg-white p-3">
          <img src="{{ img.image_url }}"
           alt="{{ mobile.brand_name }} {{ mobile.model_name }} gallery image {{ loop.index }}"
           class="h-full w-full object-contain transition duration-300 group-hover:scale-105"
           loading="lazy"
           decoding="async">
         </div>
         <div class="border-t border-slate-100 px-3 py-2 text-center">
          <span class="text-xs font-medium text-slate-500">Image {{ loop.index }} <i class="lucide lucide-external-link w-3 h-3 inline ml-1"></i></span>
         </div>
        </a>
       {% endfor %}
      </div>
     {% else %}
      <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center shadow-sm">
       <div class="mx-auto mb-3 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-slate-100 text-slate-400">
        <i class="lucide lucide-image text-2xl"></i>
       </div>
       <p class="text-slate-500 font-medium">No images available.</p>
      </div>
     {% endif %}
    </div>

    {# â”€â”€ Price Tab â”€â”€ #}
    {% if mobile.official_price or mobile.unofficial_price %}
     <div id="tab-price" role="tabpanel" aria-labelledby="price-tab" data-tab-panel="price" class="hidden">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
       {% if mobile.official_price %}
        <div class="rounded-2xl border border-emerald-200 bg-gradient-to-br from-emerald-50 to-white p-6 shadow-sm">
         <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600">
          <i class="lucide lucide-check-circle text-xl"></i>
         </div>
         <span class="block text-sm font-semibold uppercase tracking-wider text-emerald-600 mb-2">Official Price</span>
         <strong class="text-3xl font-bold text-emerald-800">{{ mobile.official_price|number_format(2, '.', ',') }} à§³</strong>
         <p class="mt-2 text-xs text-emerald-600/70">Official manufacturer suggested retail price</p>
        </div>
       {% endif %}
       {% if mobile.unofficial_price %}
        <div class="rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50 to-white p-6 shadow-sm">
         <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-amber-100 text-amber-600">
          <i class="lucide lucide-trending-up text-xl"></i>
         </div>
         <span class="block text-sm font-semibold uppercase tracking-wider text-amber-600 mb-2">Unofficial / Market Price</span>
         <strong class="text-3xl font-bold text-amber-800">{{ mobile.unofficial_price|number_format(2, '.', ',') }} à§³</strong>
         <p class="mt-2 text-xs text-amber-600/70">Current market price from local retailers</p>
        </div>
       {% endif %}
      </div>
     </div>
    {% endif %}
   </div>
  </div>

  {# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     COMMENTS SECTION
     â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• #}
  <div class="mt-8 lg:mt-10" id="comments-wrapper">
   {% include 'comments/comments.twig' with { content_type: 'mobiles', content_id: mobile.id, comments: comments } %}
  </div>
 </div>
</section>

{# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   RELATED MOBILES SECTION
   â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• #}
{% include 'partials/related-section.twig' with {
 items: related_mobiles,
 title: 'Related Mobiles',
 type: 'mobile',
