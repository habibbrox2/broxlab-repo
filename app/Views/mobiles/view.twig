{% block extra_scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
 // â”€â”€ Gallery Navigation â”€â”€
 const gallerySlides = document.querySelectorAll('[data-gallery-idx]');
 const galleryThumbs = document.querySelectorAll('[data-thumb-idx]');
 const prevBtn = document.getElementById('galleryPrev');
 const nextBtn = document.getElementById('galleryNext');
 const counterEl = document.getElementById('galleryCounter');
 let currentIdx = 0;

 function showGallerySlide(idx) {
  if (idx < 0) idx = gallerySlides.length - 1;
  if (idx >= gallerySlides.length) idx = 0;
  currentIdx = idx;

  gallerySlides.forEach(function(slide, i) {
   slide.classList.toggle('block', i === idx);
   slide.classList.toggle('hidden', i !== idx);
  });

  galleryThumbs.forEach(function(thumb, i) {
   const isActive = i === idx;
   thumb.classList.toggle('border-indigo-500', isActive);
   thumb.classList.toggle('shadow-sm', isActive);
   thumb.classList.toggle('border-transparent', !isActive);
   thumb.classList.toggle('opacity-60', !isActive);
   thumb.classList.toggle('hover:opacity-100', !isActive);
   thumb.setAttribute('aria-current', isActive ? 'true' : 'false');
  });

  if (counterEl) counterEl.textContent = idx + 1;
 }

 if (prevBtn) prevBtn.addEventListener('click', function() { showGallerySlide(currentIdx - 1); });
 if (nextBtn) nextBtn.addEventListener('click', function() { showGallerySlide(currentIdx + 1); });

 galleryThumbs.forEach(function(thumb) {
  thumb.addEventListener('click', function() {
   showGallerySlide(parseInt(this.getAttribute('data-thumb-idx')));
  });
 });

 // Keyboard navigation
 document.addEventListener('keydown', function(e) {
  if (e.key === 'ArrowLeft' && prevBtn) showGallerySlide(currentIdx - 1);
  if (e.key === 'ArrowRight' && nextBtn) showGallerySlide(currentIdx + 1);
 });

 // â”€â”€ Tab Switching â”€â”€
 const tabButtons = document.querySelectorAll('[role="tab"][data-tab]');
 const tabPanels = {};
 document.querySelectorAll('[data-tab-panel]').forEach(function(p) {
  tabPanels[p.getAttribute('data-tab-panel')] = p;
 });

 function activateTab(tabName) {
  // Update tab buttons
  tabButtons.forEach(function(btn) {
   const isActive = btn.getAttribute('data-tab') === tabName;
   btn.classList.toggle('bg-white', isActive);
   btn.classList.toggle('shadow-sm', isActive);
   btn.classList.toggle('text-slate-900', isActive);
   btn.classList.toggle('text-slate-600', !isActive);
   btn.classList.toggle('hover:bg-white', isActive);
   btn.classList.toggle('hover:text-slate-900', !isActive);
   btn.classList.toggle('hover:bg-white/80', !isActive);
   btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
  });

  // Show/hide panels
  Object.keys(tabPanels).forEach(function(key) {
   tabPanels[key].classList.toggle('hidden', key !== tabName);
  });

  // Update bottom nav active state
  const bottomNavBtns = document.querySelectorAll('.fixed.bottom-0 button[data-tab]');
  bottomNavBtns.forEach(function(btn) {
   const isActive = btn.getAttribute('data-tab') === tabName;
   btn.classList.toggle('text-indigo-600', isActive);
   btn.classList.toggle('active-tab-bottom', isActive);
   btn.classList.toggle('text-slate-400', !isActive);
  });
 }

 tabButtons.forEach(function(btn) {
  btn.addEventListener('click', function() {
   const tab = this.getAttribute('data-tab');
   if (tab) activateTab(tab);
  });
 });

 // Bottom nav tab triggers
 document.querySelectorAll('.fixed.bottom-0 button[data-tab]').forEach(function(btn) {
  btn.addEventListener('click', function() {
   const tab = this.getAttribute('data-tab');
   if (tab) {
    activateTab(tab);
    // Scroll to the tabs section
    document.querySelector('[role="tablist"]').scrollIntoView({ behavior: 'smooth', block: 'start' });
   }
  });
 });

 // Quick links triggers
 document.querySelectorAll('[data-mobile-tab-trigger]').forEach(function(link) {
  link.addEventListener('click', function(e) {
   e.preventDefault();
   const tab = this.getAttribute('data-mobile-tab-trigger');
   if (tab) {
    activateTab(tab);
    document.querySelector('[role="tablist"]').scrollIntoView({ behavior: 'smooth', block: 'start' });
   }
  });
 });
});
</script>
{% endblock %}
