<nav class="fixed bottom-0 left-0 right-0 z-40 border-t border-slate-200 bg-white/95 shadow-[0_-4px_20px_rgba(0,0,0,0.06)] backdrop-blur-xl lg:hidden" aria-label="Mobile content sections">
 <div class="flex items-center justify-around px-2 py-2">
  <button class="inline-flex flex-col items-center gap-0.5 px-3 py-2 text-indigo-600 transition active:scale-95 active-tab-bottom"
