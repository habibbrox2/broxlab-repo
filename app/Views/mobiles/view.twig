{% extends "layout.twig" %}
{% block title %}{{ mobile.brand_name }} {{ mobile.model_name }} - Phone Specifications & Reviews{% endblock %}
{% block meta_description %}Complete specifications and information about {{ mobile.brand_name }} {{ mobile.model_name }} phone{% endblock %}
{% block og_image %}{{ main_image|default(app_settings.site_logo|default(url ~ 'assets/images/default-image.png')) }}{% endblock %}
{% block og_type %}product{% endblock %}
{% set breadcrumbs = [
  { label: 'Mobiles', url: '/mobiles', icon: 'mobile' },
  { label: mobile.brand_name|slice(0, 20), icon: 'phone' }
] %}
{% set image_count = images|length %}
{% set spec_count = specifications|length %}
{% set main_image = image_count > 0 ? images[0].image_url : null %}

{% block content %}
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ mobile.brand_name|json }} {{ mobile.model_name|json }}",
  "description": "Complete specifications and information about {{ mobile.brand_name|json }} {{ mobile.model_name|json }} phone",
  "brand": {
    "@type": "Brand",
    "name": "{{ mobile.brand_name|json }}"
  },
  "offers": {
    "@type": "Offer",
    "url": "{{ current_url }}",
    "availability": "https://schema.org/InStock",
    "priceCurrency": "BDT"
  }
}
  </script>

  <section class="mobile-view-page py-4 py-lg-5">
    <div class="container">
      <div class="mobile-hero">
        <div class="mobile-hero__gallery">
          {% if image_count > 0 %}
            <div id="mobileGalleryCarousel"
                 class="carousel slide mobile-gallery-carousel"
                 data-bs-ride="false"
                 aria-label="{{ mobile.brand_name }} {{ mobile.model_name }} image gallery">
              <div class="carousel-inner">
                {% for img in images %}
                  <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                    <div class="mobile-gallery-stage">
                      <img src="{{ img.image_url }}"
                           alt="{{ mobile.brand_name }} {{ mobile.model_name }} image {{ loop.index }}"
                           loading="{{ loop.first ? 'eager' : 'lazy' }}"
                           decoding="async">
                    </div>
                  </div>
                {% endfor %}
              </div>

              {% if image_count > 1 %}
                <button class="carousel-control-prev" type="button" data-bs-target="#mobileGalleryCarousel" data-bs-slide="prev">
                  <span class="carousel-control-prev-icon"></span>
                  <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#mobileGalleryCarousel" data-bs-slide="next">
                  <span class="carousel-control-next-icon"></span>
                  <span class="visually-hidden">Next</span>
                </button>
              {% endif %}
            </div>

            {% if image_count > 1 %}
              <div class="mobile-gallery-thumbs" role="tablist" aria-label="Select gallery image">
                {% for img in images %}
                  <button class="mobile-gallery-thumb {{ loop.first ? 'is-active' : '' }}"
                          type="button"
                          data-bs-target="#mobileGalleryCarousel"
                          data-bs-slide-to="{{ loop.index0 }}"
                          aria-label="Show image {{ loop.index }}"
                          aria-current="{{ loop.first ? 'true' : 'false' }}">
                    <img src="{{ img.image_url }}"
                         alt="{{ mobile.brand_name }} {{ mobile.model_name }} thumbnail {{ loop.index }}"
                         loading="lazy"
                         decoding="async">
                  </button>
                {% endfor %}
              </div>
            {% endif %}
          {% else %}
            <div class="mobile-gallery-stage is-empty">
              <i class="bi bi-phone"></i>
              <span>No image available</span>
            </div>
          {% endif %}
        </div>

        <div class="mobile-hero__summary">
          <div class="mobile-kicker">
            <span class="mobile-status-pill is-{{ mobile.status|lower }}">
              <i class="bi {{ mobile.status == 'official' ? 'bi-patch-check-fill' : 'bi-info-circle-fill' }}"></i>
              {{ mobile.status|capitalize }}
            </span>
            <span class="mobile-kicker__brand">{{ mobile.brand_name }}</span>
          </div>

          <h1 class="mobile-title">{{ mobile.brand_name }} {{ mobile.model_name }}</h1>
          <p class="mobile-subtitle">Pricing, specifications, image gallery, and related devices in one place.</p>

          <div class="mobile-meta-grid">
            <div class="mobile-meta-card">
              <span class="mobile-meta-card__label">Release Date</span>
              <strong>{{ mobile.release_date ? mobile.release_date|date("F d, Y") : 'Unknown' }}</strong>
            </div>
            <div class="mobile-meta-card">
              <span class="mobile-meta-card__label">Images</span>
              <strong>{{ image_count }}</strong>
            </div>
            <div class="mobile-meta-card">
              <span class="mobile-meta-card__label">Specs</span>
              <strong>{{ spec_count }}</strong>
            </div>
            <div class="mobile-meta-card">
              <span class="mobile-meta-card__label">Availability</span>
              <strong>{{ mobile.is_official ? 'Official' : 'Market' }}</strong>
            </div>
          </div>

          <div class="mobile-price-strip">
            {% if mobile.official_price %}
              <div class="mobile-price-pill is-official">
                <span>Official</span>
                <strong>{{ mobile.official_price|number_format(2, '.', ',') }} ৳</strong>
              </div>
            {% endif %}
            {% if mobile.unofficial_price %}
              <div class="mobile-price-pill is-unofficial">
                <span>Unofficial</span>
                <strong>{{ mobile.unofficial_price|number_format(2, '.', ',') }} ৳</strong>
              </div>
            {% endif %}
          </div>

          {% if mobile.tags %}
            <div class="mobile-tag-row" aria-label="Related mobile tags">
              {% for tag in mobile.tags %}
                <a href="/mobiles?tag={{ tag.slug }}" class="mobile-tag-chip">{{ tag.name }}</a>
              {% endfor %}
            </div>
          {% endif %}

          <div class="mobile-quick-links">
            <a href="#tab-specs" class="mobile-quick-link" data-mobile-tab-trigger="specs">
              <i class="bi bi-list-check"></i>
              <span>Specifications</span>
            </a>
            <a href="#tab-images" class="mobile-quick-link" data-mobile-tab-trigger="images">
              <i class="bi bi-images"></i>
              <span>Images</span>
            </a>
            {% if mobile.official_price or mobile.unofficial_price %}
              <a href="#tab-price" class="mobile-quick-link" data-mobile-tab-trigger="price">
                <i class="bi bi-cash-coin"></i>
                <span>Price</span>
              </a>
            {% endif %}
            <a href="/mobiles" class="mobile-quick-link">
              <i class="bi bi-grid"></i>
              <span>All Mobiles</span>
            </a>
          </div>
        </div>
      </div>

      <div class="mobile-tabs-shell">
        <div class="mobile-tabs-header">
          <div>
            <h2 class="mobile-section-title">Device Details</h2>
            <p class="mobile-section-subtitle">Browse structured information without leaving the page.</p>
          </div>

          <ul class="nav mobile-tabs-nav" id="mobileTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active"
                      id="specs-tab"
                      data-bs-toggle="tab"
                      data-bs-target="#tab-specs"
                      type="button"
                      role="tab"
                      aria-controls="tab-specs"
                      aria-selected="true">
                <i class="bi bi-list-check"></i>
                <span>Specifications</span>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link"
                      id="images-tab"
                      data-bs-toggle="tab"
                      data-bs-target="#tab-images"
                      type="button"
                      role="tab"
                      aria-controls="tab-images"
                      aria-selected="false">
                <i class="bi bi-images"></i>
                <span>Images</span>
              </button>
            </li>
            {% if mobile.official_price or mobile.unofficial_price %}
              <li class="nav-item" role="presentation">
                <button class="nav-link"
                        id="price-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#tab-price"
                        type="button"
                        role="tab"
                        aria-controls="tab-price"
                        aria-selected="false">
                  <i class="bi bi-cash-coin"></i>
                  <span>Price</span>
                </button>
              </li>
            {% endif %}
          </ul>
        </div>

        <div class="tab-content mobile-tabs-content" id="mobileTabsContent">
          <div class="tab-pane fade show active" id="tab-specs" role="tabpanel" aria-labelledby="specs-tab">
            {% if specifications %}
              <div class="mobile-spec-grid">
                {% for spec in specifications %}
                  <article class="mobile-spec-item">
                    <span class="mobile-spec-item__key">{{ spec.spec_key }}</span>
                    <span class="mobile-spec-item__value">{{ spec.spec_value }}</span>
                  </article>
                {% endfor %}
              </div>
            {% else %}
              <div class="mobile-empty-state">
                <i class="bi bi-exclamation-circle"></i>
                <p>No specifications available.</p>
              </div>
            {% endif %}
          </div>

          <div class="tab-pane fade" id="tab-images" role="tabpanel" aria-labelledby="images-tab">
            {% if images %}
              <div class="mobile-image-grid">
                {% for img in images %}
                  <a href="{{ img.image_url }}"
                     target="_blank"
                     rel="noopener noreferrer"
                     class="mobile-image-card">
                    <img src="{{ img.image_url }}"
                         alt="{{ mobile.brand_name }} {{ mobile.model_name }} gallery image {{ loop.index }}"
                         loading="lazy"
                         decoding="async">
                  </a>
                {% endfor %}
              </div>
            {% else %}
              <div class="mobile-empty-state">
                <i class="bi bi-image-alt"></i>
                <p>No images available.</p>
              </div>
            {% endif %}
          </div>

          {% if mobile.official_price or mobile.unofficial_price %}
            <div class="tab-pane fade" id="tab-price" role="tabpanel" aria-labelledby="price-tab">
              <div class="mobile-price-panel">
                {% if mobile.official_price %}
                  <div class="mobile-price-panel__item is-official">
                    <span class="mobile-price-panel__label">Official Price</span>
                    <strong>{{ mobile.official_price|number_format(2, '.', ',') }} ৳</strong>
                  </div>
                {% endif %}
                {% if mobile.unofficial_price %}
                  <div class="mobile-price-panel__item is-unofficial">
                    <span class="mobile-price-panel__label">Unofficial Price</span>
                    <strong>{{ mobile.unofficial_price|number_format(2, '.', ',') }} ৳</strong>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div id="comments-wrapper" class="mobile-comments-shell mt-4 mt-lg-5">
        {% include 'comments/comments.twig' with { content_type: 'mobiles', content_id: mobile.id, comments: comments } %}
      </div>
    </div>
  </section>

  {% if related_mobiles is defined and related_mobiles|length > 0 %}
    <section class="related-mobiles-section py-5">
      <div class="container">
        <div class="related-mobiles-section__header">
          <div>
            <h2 class="mobile-section-title mb-2">Related Mobiles</h2>
            <p class="mobile-section-subtitle mb-0">Nearby options worth comparing before you decide.</p>
          </div>
          <a href="/mobiles" class="related-mobiles-section__link">Browse all</a>
        </div>

        <div class="row g-4">
          {% for mob in related_mobiles|slice(0, 3) %}
            <div class="col-md-6 col-xl-4">
              <article class="related-mobile-card">
                <div class="related-mobile-card__media">
                  {% if mob.images is defined and mob.images|length > 0 %}
                    {% include 'partials/carousel.twig' with {
                      id: 'related_mobile_carousel_' ~ mob.id,
                      images: mob.images,
                      title: mob.brand_name ~ ' ' ~ mob.model_name,
                      show_indicators: mob.images|length > 1,
                      show_controls: mob.images|length > 1,
                      height: '220px'
                    } %}
                  {% elseif mob.image %}
                    <img src="{{ mob.image }}"
                         alt="{{ mob.brand_name }} {{ mob.model_name }}"
                         loading="lazy"
                         decoding="async">
                  {% else %}
                    <div class="related-mobile-card__placeholder">
                      <i class="bi bi-phone"></i>
                    </div>
                  {% endif %}
                </div>

                <div class="related-mobile-card__body">
                  <div class="related-mobile-card__topline">
                    <span class="related-mobile-card__badge">Phone</span>
                    {% if mob.release_date %}
                      <span class="related-mobile-card__year">{{ mob.release_date|date("Y") }}</span>
                    {% endif %}
                  </div>

                  <h3 class="related-mobile-card__title">{{ mob.brand_name }} {{ mob.model_name }}</h3>

                  <div class="related-mobile-card__meta">
                    {% if mob.official_price %}
                      <span class="related-mobile-card__price">{{ mob.official_price|number_format(0, '.', ',') }} ৳</span>
                    {% endif %}
                  </div>

                  <a href="/mobiles/view/{{ mob.url }}" class="related-mobile-card__action">
                    <span>View Specs</span>
                    <i class="bi bi-arrow-right"></i>
                  </a>
                </div>
              </article>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  <nav class="bottom-nav d-md-none" aria-label="Mobile content sections">
    <div class="bottom-nav-container">
      <button class="nav-link active flex-column ripple"
              data-bs-toggle="tab"
              data-bs-target="#tab-specs"
              type="button">
        <i class="bi bi-list-check fs-5"></i>
        <small class="tab-label">Specs</small>
      </button>
      <button class="nav-link flex-column ripple"
              data-bs-toggle="tab"
              data-bs-target="#tab-images"
              type="button">
        <i class="bi bi-images fs-5"></i>
        <small class="tab-label">Images</small>
      </button>
      {% if mobile.official_price or mobile.unofficial_price %}
        <button class="nav-link flex-column ripple"
                data-bs-toggle="tab"
                data-bs-target="#tab-price"
                type="button">
          <i class="bi bi-cash-coin fs-5"></i>
          <small class="tab-label">Price</small>
        </button>
      {% endif %}
    </div>
  </nav>

  <script>
document.addEventListener('DOMContentLoaded', () => {
    const rippleButtons = document.querySelectorAll('.ripple');
    rippleButtons.forEach((btn) => {
        btn.addEventListener('click', function (e) {
            const circle = document.createElement('span');
            circle.classList.add('ripple-effect');

            const rect = this.getBoundingClientRect();
            const size = Math.max(rect.width, rect.height);
            circle.style.width = circle.style.height = size + 'px';
            circle.style.left = e.clientX - rect.left - size / 2 + 'px';
            circle.style.top = e.clientY - rect.top - size / 2 + 'px';

            this.appendChild(circle);
            setTimeout(() => circle.remove(), 600);
        });
    });

    const tabButtons = Array.from(document.querySelectorAll('[data-bs-toggle="tab"][data-bs-target^="#tab-"]'));
    const bottomButtons = Array.from(document.querySelectorAll('.bottom-nav .nav-link'));
    const quickLinks = Array.from(document.querySelectorAll('[data-mobile-tab-trigger]'));
    const galleryThumbs = Array.from(document.querySelectorAll('.mobile-gallery-thumb'));

    const syncActiveTargets = (target) => {
        tabButtons.forEach((btn) => {
            btn.classList.toggle('active', btn.dataset.bsTarget === target);
            btn.setAttribute('aria-selected', btn.dataset.bsTarget === target ? 'true' : 'false');
        });
        bottomButtons.forEach((btn) => {
            btn.classList.toggle('active', btn.dataset.bsTarget === target);
        });
    };

    tabButtons.forEach((btn) => {
        btn.addEventListener('shown.bs.tab', (event) => {
            syncActiveTargets(event.target.dataset.bsTarget);
        });
    });

    quickLinks.forEach((link) => {
        link.addEventListener('click', (event) => {
            const trigger = event.currentTarget.getAttribute('data-mobile-tab-trigger');
            if (!trigger) {
                return;
            }

            event.preventDefault();
            const button = document.querySelector('#' + trigger + '-tab');
            if (button && window.bootstrap?.Tab) {
                window.bootstrap.Tab.getOrCreateInstance(button).show();
                document.querySelector('.mobile-tabs-shell')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    });

    galleryThumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
            galleryThumbs.forEach((item) => {
                const active = item === thumb;
                item.classList.toggle('is-active', active);
                item.setAttribute('aria-current', active ? 'true' : 'false');
            });
        });
    });

    const carouselEl = document.getElementById('mobileGalleryCarousel');
    if (carouselEl) {
        carouselEl.addEventListener('slid.bs.carousel', (event) => {
            galleryThumbs.forEach((thumb, index) => {
                const active = index === event.to;
                thumb.classList.toggle('is-active', active);
                thumb.setAttribute('aria-current', active ? 'true' : 'false');
            });
        });
    }
});
  </script>
{% endblock %}
