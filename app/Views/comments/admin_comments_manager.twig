{% extends"admin/layout.twig" %}
{% block title %}Manage Comments{% endblock %}
{% block content %}
 <div class="px-4 py-4">
 <!-- Page Header -->
 <div class="mb-4">
 <div class="flex items-center justify-between">
 <div>
 <h1 class="text-xl font-bold text-neutral-900">
 <i class="lucide lucide-message-square mr-2"></i> Comments Management
 </h1>
 <p class="text-neutral-500 mt-2 mb-0 text-sm">Manage and moderate user comments across your site</p>
 </div>
 </div>
 </div>
 <!-- Statistics Cards -->
 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
 <div class="bg-white rounded-xl shadow-sm p-4">
 <div class="flex items-center justify-between">
 <div>
 <p class="text-neutral-500 text-sm mb-0">Total Comments</p>
 <h3 class="mb-0 font-bold text-neutral-900">{{ total_comments }}</h3>
 </div>
 <div class="bg-indigo-600/10 p-3 rounded-lg">
 <i class="lucide lucide-message-square-text text-lg text-indigo-600"></i>
 </div>
 </div>
 </div>
 </div>
 </div>
  <div class="bg-white rounded-xl shadow-sm p-4">
 <div class="flex items-center justify-between">
 <div>
 <p class="text-neutral-500 text-sm mb-0">Today's Comments</p>
 <h3 class="mb-0 font-bold text-neutral-900">{{ today_count }}</h3>
 </div>
 <div class="bg-emerald-500/10 p-3 rounded-lg">
 <i class="lucide lucide-calendar-check text-lg text-emerald-600"></i>
 </div>
 </div>
 </div>
 <div class="bg-white rounded-xl shadow-sm p-4">
 <div class="flex items-center justify-between">
 <div>
 <p class="text-neutral-500 text-sm mb-0">Pending Approval</p>
 <h3 class="mb-0 font-bold text-neutral-900">{{ pending_count }}</h3>
 </div>
 <div class="bg-amber-500/10 p-3 rounded-lg">
 <i class="lucide lucide-hourglass text-lg text-amber-600"></i>
 </div>
 </div>
 </div>
 <div class="bg-white rounded-xl shadow-sm p-4">
 <div class="flex items-center justify-between">
 <div>
 <p class="text-neutral-500 text-sm mb-0">Avg Per Day</p>
 <h3 class="mb-0 font-bold text-neutral-900">{{ (total_comments / 30)|round }}</h3>
 </div>
 <div class="bg-sky-500/10 p-3 rounded-lg">
 <i class="lucide lucide-trending-up text-lg text-sky-600"></i>
 </div>
 </div>
 </div>
 </div>
 <!-- Comments Table -->
 <div class="bg-white rounded-xl shadow-sm mb-4">
 <div class="px-4 py-3 bg-neutral-50 border-b border-neutral-200 rounded-t-xl">
 <form class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 items-end" method="GET">
 <div>
 <label class="block text-xs text-neutral-500 mb-1">Search</label>
 <div class="flex rounded-lg border border-neutral-300 overflow-hidden focus-within:ring-2 focus-within:ring-primary/20 focus-within:border-primary transition-all">
 <span class="inline-flex items-center px-3 bg-neutral-50 border-r border-neutral-200 text-neutral-500"><i class="lucide lucide-search text-sm"></i></span>
 <input type="text"
 class="flex-1 px-3 py-1.5 border-0 outline-none text-sm"
 placeholder="Search comments..."
 name="search"
 value="{{ search }}">
 </div>
 </div>
 <div>
 <label class="block text-xs text-neutral-500 mb-1">Status</label>
 <select class="w-full px-3 py-1.5 border border-neutral-300 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none bg-white" name="status">
 <option value="all" {% if status == 'all' %}selected{% endif %}>All Status</option>
 <option value="approved" {% if status == 'approved' %}selected{% endif %}>Approved</option>
 <option value="pending" {% if status == 'pending' %}selected{% endif %}>Pending</option>
 </select>
 </div>
 <div>
 <label class="block text-xs text-neutral-500 mb-1">Limit</label>
 <select name="limit" class="w-full px-3 py-1.5 border border-neutral-300 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none bg-white">
 <option value="10">10 items</option>
 <option value="20" selected>20 items</option>
 <option value="50">50 items</option>
 <option value="100">100 items</option>
 </select>
 </div>
 <div class="text-right">
 <button type="submit" class="inline-flex items-center px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-600/90 transition-colors">
 <i class="lucide lucide-filter mr-1"></i> Apply
 </button>
 </div>
 </form>
 </div>
 <div class="overflow-x-auto">
 {% if comments %}
 <table class="w-full border-collapse text-sm">
 <thead>
 <tr class="bg-neutral-50 border-b border-neutral-200">
 <th class="px-3 py-3 text-left">
 <input type="checkbox" class="w-4 h-4 rounded border-neutral-300 text-indigo-600 focus:ring-primary" id="selectAll">
 </th>
 <th class="px-3 py-3 text-left text-xs font-semibold text-neutral-600 uppercase tracking-wider">Author</th>
 <th class="px-3 py-3 text-left text-xs font-semibold text-neutral-600 uppercase tracking-wider">Comment Content</th>
 <th class="px-3 py-3 text-left text-xs font-semibold text-neutral-600 uppercase tracking-wider">Date</th>
 <th class="px-3 py-3 text-left text-xs font-semibold text-neutral-600 uppercase tracking-wider">Engagement</th>
 <th class="px-3 py-3 text-left text-xs font-semibold text-neutral-600 uppercase tracking-wider">Actions</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-neutral-100">
 {% for comment in comments %}
 <tr class="hover:bg-neutral-50 transition-colors">
 <td class="px-3 py-3">
 <input type="checkbox"
 class="w-4 h-4 rounded border-neutral-300 text-indigo-600 focus:ring-primary comment-checkbox"
 value="{{ comment.id }}">
 </td>
 <td class="px-3 py-3">
 <div class="flex items-center gap-2">
 <div class="bg-indigo-600/10 rounded-full p-2">
 <i class="lucide lucide-user text-indigo-600 text-sm"></i>
 </div>
 <div>
 <p class="mb-0 font-semibold text-xs text-neutral-800">
 {% if comment.user_id %}
 User #{{ comment.user_id }}
 {% else %}
 {{ comment.guest_name }}
 {% endif %}
 </p>
 <p class="mb-0 text-neutral-500 text-xs">{{ comment.user_id ? 'Registered' : 'Guest' }}</p>
 </div>
 </div>
 </td>
 <td class="px-3 py-3">
 <p class="mb-0 truncate max-w-xs" title="{{ comment.content|striptags }}">
 {{ comment.content|striptags|slice(0, 80) }}
 {% if comment.content|length > 80 %}...{% endif %}
 </p>
 <p class="mb-0 text-neutral-500 text-xs mt-1">
 On: <strong>{{ comment.content_type|capitalize }} #{{ comment.content_id }}</strong>
 {% if comment.parent_id %}<span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs bg-neutral-100 text-neutral-600">Reply</span>{% endif %}
 </p>
 </td>
 <td class="px-3 py-3">
 <span class="text-neutral-500 text-xs">
 {{ comment.created_at|date("M d, Y") }}
 <br>
 {{ comment.created_at|date("H:i") }}
 </span>
 </td>
 <td class="px-3 py-3">
 <span class="text-neutral-500 text-xs">
 <i class="lucide lucide-thumbs-up"></i> {{ comment.likes|default(0) }}
 <br>
 <i class="lucide lucide-message-square"></i> {{ comment.reply_count|default(0) }}
 </span>
 </td>
 <td class="px-3 py-3">
 <div class="flex items-center gap-1">
 <a href="/admin/comments/{{ comment.id }}"
 class="inline-flex items-center justify-center w-7 h-7 rounded-lg text-neutral-500 hover:text-indigo-600 hover:bg-indigo-600/10 transition-all"
 title="View Details">
 <i class="lucide lucide-eye text-sm"></i>
 </a>
 <button type="button"
 class="inline-flex items-center justify-center w-7 h-7 rounded-lg text-neutral-500 hover:text-sky-600 hover:bg-sky-50 transition-all"
 onclick="editCommentQuick({{ comment.id }})"
 title="Edit">
 <i class="lucide lucide-pencil text-sm"></i>
 </button>
 {% if comment.status != 'hidden' %}
 <button type="button"
 class="inline-flex items-center justify-center w-7 h-7 rounded-lg text-neutral-500 hover:text-amber-600 hover:bg-amber-50 transition-all"
 onclick="hideCommentQuick({{ comment.id }})"
 title="Hide">
 <i class="lucide lucide-eye-off text-sm"></i>
 </button>
 {% else %}
 <button type="button"
 class="inline-flex items-center justify-center w-7 h-7 rounded-lg text-neutral-500 hover:text-emerald-600 hover:bg-emerald-50 transition-all"
 onclick="unhideCommentQuick({{ comment.id }})"
 title="Unhide">
 <i class="lucide lucide-eye text-sm"></i>
 </button>
 {% endif %}
 <button type="button"
 class="inline-flex items-center justify-center w-7 h-7 rounded-lg text-neutral-500 hover:text-red-600 hover:bg-red-50 transition-all"
 onclick="deleteComment({{ comment.id }})"
 title="Delete">
 <i class="lucide lucide-trash-2 text-sm"></i>
 </button>
 </div>
 </td>
 </tr>
 {% endfor %}
 </tbody>
 </table>
 <!-- Bulk Actions -->
 <div class="px-4 py-3 bg-neutral-50 border-t border-neutral-200 rounded-b-xl">
 <div class="flex items-center justify-between">
 <div class="flex items-center gap-2">
 <select class="px-3 py-1.5 border border-neutral-300 rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none bg-white" id="bulkAction">
 <option value="">Bulk Actions</option>
 <option value="approve">Approve Selected</option>
 <option value="delete">Delete Selected</option>
 </select>
 <button type="button"
 class="inline-flex items-center px-3 py-1.5 rounded-lg border border-neutral-300 bg-white text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition-colors"
 onclick="executeBulkAction()">Apply</button>
 </div>
 <div class="text-neutral-500 text-sm">
 <span id="selectedCount">0</span> selected
 </div>
 </div>
 </div>
 {% else %}
 <div class="p-5 text-center">
 <div class="mb-3">
 <i class="lucide lucide-message-square text-4xl text-neutral-300"></i>
 </div>
 <p class="text-neutral-500 mb-0">No comments found</p>
 </div>
 {% endif %}
 </div>
 </div>
 <!-- Pagination -->
 {% include"admin/partials/pagination.twig" %}
 </div>
 <!-- Comment Detail Modal -->
 <div class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50" id="commentModal">
 <div class="bg-white rounded-xl shadow-md-xl w-full max-w-2xl mx-2 my-2 max-h-[90vh] flex flex-col">
 <div class="flex items-center justify-between px-5 py-4 border-b border-neutral-200 rounded-t-xl">
 <h5 class="text-lg font-bold text-neutral-900 m-0">Comment Details</h5>
 <button type="button" class="w-8 h-8 flex items-center justify-center border-0 bg-transparent text-neutral-500 hover:text-neutral-800 hover:bg-neutral-100 rounded-lg transition-all duration-150 cursor-pointer" data-brox-dismiss="modal"></button>
 </div>
 <div class="flex-1 px-5 py-4 overflow-y-auto" id="commentModalBody">
 <div class="text-center py-4">
 <div class="inline-spinner text-indigo-600" role="status">
 <span class="sr-only">Loading...</span>
 </div>
 </div>
 </div>
 <div class="flex items-center justify-end gap-2 px-5 py-4 border-t border-neutral-200 rounded-b-xl">
 <button type="button" class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg bg-white border border-neutral-300 text-neutral-700 hover:bg-neutral-100 transition-all duration-150 cursor-pointer" data-brox-dismiss="modal">Close</button>
 <button type="button" class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg bg-red-600 text-white hover:bg-red-700 transition-all duration-150 cursor-pointer" id="deleteCommentBtn">Delete</button>
 </div>
 </div>
 </div>
 <script>
let currentCommentId = null;

// Toggle select all
document.getElementById('selectAll')?.addEventListener('change', function() {
 const checkboxes = document.querySelectorAll('.comment-checkbox');
 checkboxes.forEach(checkbox => {
 checkbox.checked = this.checked;
 });
 updateSelectedCount();
});

// Update selected count
document.querySelectorAll('.comment-checkbox')?.forEach(checkbox => {
 checkbox.addEventListener('change', updateSelectedCount);
});

function updateSelectedCount() {
 const checked = document.querySelectorAll('.comment-checkbox:checked').length;
 document.getElementById('selectedCount').textContent = checked;
}

// View comment
function viewComment(commentId) {
 currentCommentId = commentId;
 const modal = new broxUI.Modal(document.getElementById('commentModal'));

 // Show loading spinner
 document.getElementById('commentModalBody').innerHTML = `
 <div class="text-center py-4">
 <div class="inline-spinner text-indigo-600" role="status">
 <span class="sr-only">Loading...</span>
 </div>
 </div>
 `;

 modal.show();

 // Load comment details
 fetch(`/admin/comments/detail?id=${commentId}`)
 .then(r => r.json())
 .then(data => {
 if (data.success) {
 document.getElementById('commentModalBody').innerHTML = `
 <div class="mb-3">
 <label class="block text-xs font-bold text-neutral-500 uppercase tracking-wider">AUTHOR</label>
 <p class="font-bold">${data.author}</p>
 </div>
 <div class="mb-3">
 <label class="block text-xs font-bold text-neutral-500 uppercase tracking-wider">CONTENT</label>
 <div class="border rounded p-3 bg-slate-100">${data.content}</div>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="md:col-span-6 mb-3">
 <label class="block text-xs font-bold text-neutral-500 uppercase tracking-wider">DATE</label>
 <p>${data.created_at}</p>
 </div>
 <div class="md:col-span-6 mb-3">
 <label class="block text-xs font-bold text-neutral-500 uppercase tracking-wider">LIKES</label>
 <p><i class="lucide lucide-thumbs-up text-indigo-600"></i> ${data.likes}</p>
 </div>
 </div>
 <div class="mb-3">
 <label class="block text-xs font-bold text-neutral-500 uppercase tracking-wider">CONTENT TYPE</label>
 <p>${data.content_type} #${data.content_id}</p>
 </div>
 `;
 } else {
 document.getElementById('commentModalBody').innerHTML = `
 <div class="p-4 rounded-lg bg-red-600-light text-red-600-dark border border-danger" role="alert">
 <i class="lucide lucide-alert-triangle mr-2"></i>
 ${data.message || 'Failed to load comment details'}
 </div>
 `;
 }
 })
 .catch(error => {
 document.getElementById('commentModalBody').innerHTML = `
 <div class="p-4 rounded-lg bg-red-600-light text-red-600-dark border border-danger" role="alert">
 <i class="lucide lucide-alert-triangle mr-2"></i>
 Error loading comment details
 </div>
 `;
 });
}

// Delete comment from modal
document.getElementById('deleteCommentBtn')?.addEventListener('click', function() {
 if (currentCommentId) {
 deleteComment(currentCommentId);
 }
});

// Delete comment
function deleteComment(commentId) {
 if (!confirm('Delete this comment permanently? This action cannot be undone.')) return;

 fetch(`/admin/comments/${commentId}/delete`, {
 method: 'POST',
 headers: {
 'Content-Type': 'application/json'
 }
 })
 .then(r => r.json())
 .then(data => {
 if (data.success) {
 // Close modal if open
 const modalElement = document.getElementById('commentModal');
 const modal = broxUI.Modal.getInstance(modalElement);
 if (modal) modal.hide();

 // Show success message
 alert('Comment deleted successfully');
 location.reload();
 } else {
 alert('Error: ' + (data.message || 'Failed to delete comment'));
 }
 })
 .catch(error => {
 alert('Error deleting comment');
 });
}

// Edit comment quick action
function editCommentQuick(commentId) {
 window.location.href = `/admin/comments/${commentId}`;
}

// Hide comment quick action
function hideCommentQuick(commentId) {
 const reason = prompt('Why are you hiding this comment? (optional)');

 const formData = new FormData();
 if (reason) formData.append('reason', reason);

 fetch(`/admin/comments/${commentId}/hide`, {
 method: 'POST',
 body: formData
 })
 .then(r => r.json())
 .then(data => {
 if (data.success) {
 alert('Comment hidden successfully');
 location.reload();
 } else {
 alert('Error: ' + (data.message || 'Failed to hide comment'));
 }
 })
 .catch(error => {
 alert('Error hiding comment');
 });
}

// Unhide comment quick action
function unhideCommentQuick(commentId) {
 if (!confirm('Unhide this comment?')) return;

 fetch(`/admin/comments/${commentId}/unhide`, {
 method: 'POST',
 headers: {
 'Content-Type': 'application/json'
 }
 })
 .then(r => r.json())
 .then(data => {
 if (data.success) {
 alert('Comment unhidden successfully');
 location.reload();
 } else {
 alert('Error: ' + (data.message || 'Failed to unhide comment'));
 }
 })
 .catch(error => {
 alert('Error unhiding comment');
 });
}

// Bulk actions
function executeBulkAction() {
 const action = document.getElementById('bulkAction').value;
 const checked = document.querySelectorAll('.comment-checkbox:checked');

 if (!action) {
 alert('Please select an action');
 return;
 }

 if (checked.length === 0) {
 alert('Please select at least one comment');
 return;
 }

 const ids = Array.from(checked).map(c => parseInt(c.value));

 let confirmMsg = '';
 if (action === 'approve') {
 confirmMsg = `Approve ${ids.length} comment(s)?`;
 } else if (action === 'delete') {
 confirmMsg = `Delete ${ids.length} comment(s) permanently? This action cannot be undone.`;
 }

 if (!confirm(confirmMsg)) return;

 fetch('/admin/comments/bulk-action', {
 method: 'POST',
 headers: {
 'Content-Type': 'application/json'
 },
 body: JSON.stringify({
 action: action,
 ids: ids
 })
 })
 .then(r => r.json())
 .then(data => {
 if (data.success) {
 alert(data.message || 'Bulk action completed');
 location.reload();
 } else {
 alert('Error: ' + (data.message || 'Failed to complete bulk action'));
 }
 })
 .catch(error => {
 alert('Error executing bulk action');
 });
}
 </script>
{% endblock %}



