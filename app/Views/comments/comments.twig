 <i class="lucide lucide-x" style="width:1em;height:1em;"></i>
 </button>
 </div>
 <!-- Loading Spinner -->
 <div id="comment-loading" class="text-center my-4 hidden">
 <div class="modern-spinner">
 <div class="spinner-ring"></div>
 <div class="spinner-ring"></div>
 <div class="spinner-ring"></div>
 </div>
