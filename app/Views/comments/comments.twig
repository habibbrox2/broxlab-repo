 <span id="total-comments">{{ comments|length }}</span>
 <span class="ml-1">{{ comments|length == 1 ? 'Comment' : 'Comments' }}</span>
 </div>
 </div>
 </div>
 <!-- Feedback Alert -->
 <div id="comment-feedback"
