{# Admin panel layout #}
<!DOCTYPE html>
<html lang="en" data-theme="light">

{# ===== Imports ===== #}
{% import '_macros/flash.twig' as flash_macros %}
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{% block title %}{{ title|default('Admin') }}{% endblock %}</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="csrf-token" content="{{ csrf_token }}">
    {% if auth_user.id %}<meta name="user-id" content="{{ auth_user.id }}">{% endif %}
    {% if auth_user.id %}
    <script>
      // expose the list of permissions the current admin has for client-side checks
      window.ADMIN_PERMISSIONS = {{ getUserPermissions(auth_user.id)|json_encode|raw }};
      // super-admins bypass every permission check
      window.IS_SUPER_ADMIN = {{ auth_user.is_super_admin ? 'true' : 'false' }};
      // expose current user id for RBAC API lookups
      window.AUTH_USER_ID = {{ auth_user.id|default('null') }};
    </script>
    {% endif %}

    <script>
      (function () {
        try {
          var root = document.documentElement;
          var savedTheme = localStorage.getItem('broxbhai-theme') || localStorage.getItem('app-theme');
          var isValidSavedTheme = savedTheme === 'dark' || savedTheme === 'light';
          var resolvedTheme = isValidSavedTheme
            ? savedTheme
            : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

          root.setAttribute('data-theme', resolvedTheme);
          root.style.colorScheme = resolvedTheme;
        } catch (error) {
          // Ignore storage/media-query failures and keep default light theme.
        }
      })();
    </script>

    <link rel="icon" type="image/x-icon" href="{{ app_settings.favicon|default('/assets/logo/favicon.ico') }}">

    {# Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Noto+Sans+Bengali:wght@100..900&display=swap" rel="stylesheet">

    {# Core styles - Bundled for Performance - CDN Subdomain #}
    <link rel="stylesheet" href="{{ asset('/cdn/css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('/assets/css/dist/admin-bundle.css') }}">
    <link rel="stylesheet" href="{{ asset('/assets/css/tailwind.css') }}">
    <link rel="stylesheet" href="{{ asset('/ai/dist/ai-style.css') }}">
    <link rel="stylesheet" href="{{ asset('/assets/ai-assistant/styles/thinking-indicator.css') }}">

    {# Icons - CDN #}
    <link href="{{ asset('/cdn/css/bootstrap-icons.min.css') }}" rel="stylesheet">

    {# Third-party styles - CDN #}
    <link href="{{ asset('/cdn/css/sweetalert2.min.css') }}" rel="stylesheet">
    
    {# Page-specific styles #}
    {% block stylesheets %}{% endblock %}

</head>
<body data-admin-dir="{{ admin_dir|default('/admin') }}">

  <!-- Header -->
  <header class="navbar navbar-dark bg-dark shadow-sm sticky-top">
    <div class="container-fluid">
      <button class="sidebar-toggle btn btn-dark d-lg-none me-2" type="button" aria-label="Toggle sidebar">
        <i class="bi bi-list"></i>
      </button>
      <a class="navbar-brand d-flex align-items-center" href="/admin/dashboard">
        <i class="bi bi-speedometer2 me-2"></i> Admin Panel
      </a>
      <div class="d-flex align-items-center ms-auto gap-3 admin-topbar-actions">
        <!-- Admin Notification Bell -->
        <div class="admin-notification-dropdown-wrap brox-notification-wrapper" data-notification-menu>
          {% set admin_unread_count = unread_count|default(0) %}
          <a class="admin-notification-bell"
             href="#"
             id="adminNotificationBell"
             data-notification-bell
             aria-expanded="false"
             title="Notifications">
            <i class="bi bi-bell-fill admin-notification-bell-icon"></i>
            <span id="adminNotificationBadge"
                  data-notification-badge
                  class="admin-notification-badge {% if admin_unread_count <= 0 %}d-none{% endif %}">
              <span id="adminNotificationCount" data-notification-count>{{ admin_unread_count }}</span>
            </span>
          </a>
          <div class="admin-notification-dropdown" data-notification-dropdown aria-labelledby="adminNotificationBell">
            <div class="admin-notification-dropdown-header">
              <h6 class="admin-notification-dropdown-title">
                <i class="bi bi-bell-fill me-2"></i>Notifications
              </h6>
            </div>
            <div id="adminNotificationsList"
                 data-notification-list
                 class="admin-notification-list"
                 data-user-id="{{ auth_user.id|default('') }}">
              {% if notifications is defined and notifications is iterable and notifications|length > 0 %}
                {% for notif in notifications|slice(0, 10) %}
                  <div class="notification-entry admin-notification-entry {% if notif.is_read is defined and notif.is_read == 0 %}bg-light border-start border-primary border-2{% endif %}"
                       data-notification-id="{{ notif.id }}"
                       {% if notif.action_url is defined and notif.action_url %}data-action-url="{{ notif.action_url }}"{% endif %}>
                    <div class="d-flex align-items-start gap-2">
                      <div class="flex-grow-1">
                        <div class="fw-semibold small mb-1 admin-notification-entry-title">{{ notif.title }}</div>
                        <div class="small text-muted mb-1 admin-notification-entry-message">{{ notif.message }}</div>
                        <div class="small text-secondary">{{ notif.created_at|date("n/j/Y, g:i:s A") }}</div>
                      </div>
                      {% if notif.is_read is defined and notif.is_read == 0 %}
                        <button type="button"
                                class="btn btn-sm btn-outline-primary admin-notification-read-btn"
                                data-action="mark-read"
                                data-notification-id="{{ notif.id }}">Read</button>
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}
              {% else %}
                <div class="admin-notification-empty text-muted">
                  <i class="bi bi-inbox admin-notification-empty-icon"></i>
                  <p class="admin-notification-empty-text">No notifications yet</p>
                </div>
              {% endif %}
            </div>
            <div class="dropdown-divider admin-notification-divider"></div>
            <a href="/admin/my/notifications" class="dropdown-item admin-notification-view-all">
              <i class="bi bi-arrow-right me-1"></i>View all notifications
            </a>
          </div>
        </div>

        <button
          class="btn btn-dark btn-sm"
          id="broxThemeToggle"
          type="button"
          title="Toggle theme"
          aria-label="Toggle dark mode"
          aria-pressed="false">
          <i class="bi bi-circle-half"></i>
        </button>

        <!-- Server Status Indicator -->
        <div class="server-status-indicator dropdown" id="serverStatusIndicator" data-bs-toggle="dropdown" aria-expanded="false" title="Checking server status..." aria-label="Server status">
          <div class="d-flex align-items-center">
            <i class="bi bi-server" id="serverStatusIcon"></i>
            <span class="server-status-text d-none d-md-inline ms-1" id="serverStatusText">Checking</span>
            <i class="bi bi-chevron-down ms-1" style="font-size: 0.7rem;"></i>
          </div>
          <ul class="dropdown-menu server-status-dropdown" aria-labelledby="serverStatusIndicator">
            <li class="dropdown-header">Server Status</li>
            <li><div class="server-status-item" data-service="database">
                <i class="bi bi-database"></i>
                <span>Database</span>
                <span class="status-badge" data-status="checking">Checking</span>
              </div></li>
            <li><div class="server-status-item" data-service="cache">
                <i class="bi bi-hdd-stack"></i>
                <span>Cache</span>
                <span class="status-badge" data-status="checking">Checking</span>
              </div></li>
            <li><div class="server-status-item" data-service="api">
                <i class="bi bi-gear"></i>
                <span>API</span>
                <span class="status-badge" data-status="checking">Checking</span>
              </div></li>
            <li><div class="server-status-item" data-service="nodejs">
                <i class="bi bi-code-slash"></i>
                <span>Node.js</span>
                <span class="status-badge" data-status="checking">Checking</span>
              </div></li>
            <li><hr class="dropdown-divider"></li>
            <li><div class="server-status-item">
                <small class="text-muted" id="serverStatusLastCheck">Last checked: Never</small>
              </div></li>
          </ul>
        </div>
        {% if auth_user.is_authenticated %}
        <div class="dropdown admin-user-menu" data-admin-user-menu>
          <a class="d-flex align-items-center text-white text-decoration-none dropdown-toggle admin-user-toggle"
            href="#"
            id="adminUserMenu"
            data-bs-toggle="dropdown"
            data-admin-user-toggle
            aria-expanded="false"
            aria-haspopup="true">
            <img src="{{ auth_user.profile_pic|default('/assets/images/default-avatar.png') }}" alt="Profile"
                class="rounded-circle me-2 admin-user-avatar" style="width:32px; height:32px; object-fit:cover;">
            <div class="d-none d-sm-block text-start admin-user-meta">
              <div class="small">{{ auth_user.username }}</div>
              {% if auth_user.roles is not empty %}
                <div class="small text-info">{{ auth_user.roles|join(', ')|upper }}</div>
              {% endif %}
            </div>
          </a>
          <ul class="dropdown-menu text-small admin-user-dropdown" data-admin-user-dropdown aria-labelledby="adminUserMenu">
            <li><a class="dropdown-item admin-user-dropdown-item" href="/admin/profile"><i class="bi bi-person-circle me-1"></i> Profile</a></li>
            <li><a class="dropdown-item admin-user-dropdown-item" href="/admin/dashboard"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a></li>
            <li><a class="dropdown-item admin-user-dropdown-item" href="/admin/my/notifications"><i class="bi bi-bell me-1"></i> My Notifications</a></li>
            <li><a class="dropdown-item admin-user-dropdown-item" href="/admin/account-settings"><i class="bi bi-gear me-1"></i> Account Settings</a></li>

            {% if auth_user.is_super_admin %}
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item admin-user-dropdown-item" href="/admin/roles"><i class="bi bi-shield-lock me-1"></i> Manage Roles</a></li>
              <li><a class="dropdown-item admin-user-dropdown-item" href="/admin/permissions"><i class="bi bi-key me-1"></i> Manage Permissions</a></li>
            {% endif %}

            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item admin-user-dropdown-item text-danger" href="/logout" data-unified-logout><i class="bi bi-box-arrow-right me-1"></i> Logout</a></li>
          </ul>
        </div>
        {% endif %}

      </div>
    </div>
  </header>

  {# Mobile overlay #}
  <div id="sidebarOverlay"
       class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-30 lg:hidden transition-opacity duration-300">
  </div>

  {# ══════════════════════════════════════════
     MAIN WRAPPER
  ══════════════════════════════════════════ #}
  <div class="flex flex-1 overflow-hidden">

    {# ══════════════════════════════════════════
       SIDEBAR
    ══════════════════════════════════════════ #}
    <aside id="adminSidebar"
           class="w-[220px] flex-shrink-0
                  bg-white dark:bg-slate-950
                  border-r border-slate-200/70 dark:border-slate-800/70
                  overflow-y-auto overflow-x-hidden
                  transition-all duration-300 ease-out
                  fixed lg:sticky left-0 top-0 h-full z-40
                  -translate-x-full lg:translate-x-0"
           aria-label="Primary navigation">

      {# Sidebar header #}
      <div class="flex items-center justify-between h-10 px-3.5
                  border-b border-slate-100 dark:border-slate-800/80
                  bg-slate-50/60 dark:bg-slate-900/30">
        <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-600 select-none flex items-center gap-1.5">
          <i class="lucide lucide-layout-dashboard w-3 h-3"></i>
          Navigation
        </span>
        <button id="sidebarMiniToggle" type="button"
                class="hidden lg:inline-flex items-center justify-center w-6 h-6 rounded-lg
                       hover:bg-slate-200 dark:hover:bg-slate-800
                       text-slate-400 dark:text-slate-600
                       hover:text-indigo-600 dark:hover:text-indigo-400
                       transition-all duration-150
                       focus-visible:ring-2 focus-visible:ring-indigo-500/30 focus-visible:outline-none"
                aria-label="Collapse sidebar" aria-pressed="false">
          <i class="lucide lucide-chevrons-left w-3.5 h-3.5"></i>
        </button>
      </div>

      {# Nav #}
      <nav class="px-2 py-2 space-y-0.5">
        {% set settings_children = [
          {'name': 'Account Settings', 'url': '/admin/account-settings', 'key': 'account-settings'}
        ] %}
        {% if auth_user.is_super_admin %}
          {% set settings_children = settings_children|merge([
            {'name': 'App Settings',    'url': '/admin/app-settings',   'key': 'app-settings'},
            {'name': 'AI System',       'url': '/admin/ai-system',      'key': 'ai-settings'},
            {'name': 'Feature Flags',   'url': '/admin/feature-flags',  'key': 'feature-flags'}
          ]) %}
        {% endif %}

        {% set ai_items = [
          {'name': 'AI Conversations', 'icon': 'lucide-message-square', 'url': '/admin/ai-chats', 'key': 'ai-chats'}
        ] %}
        {% if auth_user.is_super_admin %}
          {% set ai_items = ai_items|merge([
            {'name': 'AI Knowledge',     'icon': 'lucide-book',        'url': '/admin/ai-knowledge',              'key': 'ai-knowledge'},
            {'name': 'Article Writer',   'icon': 'lucide-pencil',      'url': '/admin/ai/article-writer',         'key': 'ai-article-writer'},
            {'name': 'Live Writer',      'icon': 'lucide-refresh-cw',  'url': '/admin/ai/article-writer-stream',  'key': 'ai-article-writer-stream'},
            {'name': 'Bulk Generator',   'icon': 'lucide-boxes',       'url': '/admin/ai/bulk-article-writer',    'key': 'ai-bulk-article-writer'}
          ]) %}
        {% endif %}

        {% set sidebar_groups = [
          {
            'label': 'Main',
            'items': [
              {'name': 'Dashboard',  'icon': 'lucide-gauge',       'url': '/admin/dashboard',    'key': 'dashboard'},
              {'name': 'Analytics',  'icon': 'lucide-bar-chart-3', 'url': '/admin/analytics',    'key': 'analytics'},
              {'name': 'Activity',   'icon': 'lucide-activity',    'url': '/admin/log-activity', 'key': 'log-activity'}
            ]
          },
          {
            'label': 'Content',
            'items': [
              {'name': 'Posts', 'icon': 'lucide-file-text', 'key': 'posts', 'children': [
                {'name': 'All Posts', 'url': '/admin/posts',        'key': 'all-posts'},
                {'name': 'New Post',  'url': '/admin/posts/create', 'key': 'add-post'}
              ]},
              {'name': 'Pages',      'icon': 'lucide-file',   'url': '/admin/pages',      'key': 'pages'},
              {'name': 'Categories', 'icon': 'lucide-tags',   'url': '/admin/categories', 'key': 'categories'},
              {'name': 'Tags',       'icon': 'lucide-hash',   'url': '/admin/tags',       'key': 'tags'},
              {'name': 'Media',      'icon': 'lucide-image',  'url': '/admin/media',      'key': 'media'}
            ]
          },
          {
            'label': 'Services',
            'items': [
              {'name': 'Services', 'icon': 'lucide-award', 'key': 'services', 'children': [
                {'name': 'All Services',   'url': '/admin/services',        'key': 'all-services'},
                {'name': 'New Service',    'url': '/admin/services/create', 'key': 'create-service'}
              ]},
              {'name': 'Applications', 'icon': 'lucide-briefcase', 'key': 'applications', 'children': [
                {'name': 'All',      'url': '/admin/applications',                    'key': 'all-applications'},
                {'name': 'Pending',  'url': '/admin/applications?status=pending',     'key': 'pending-applications'},
                {'name': 'Approved', 'url': '/admin/applications?status=approved',    'key': 'approved-applications'},
                {'name': 'Rejected', 'url': '/admin/applications?status=rejected',    'key': 'rejected-applications'},
                {'name': 'Receipts', 'url': '/admin/applications/receipts',           'key': 'applications-receipts'}
              ]}
            ]
          },
          {
            'label': 'AI',
            'items': ai_items
          },
          {
            'label': 'System',
            'items': [
              {'name': 'Settings',    'icon': 'lucide-settings', 'key': 'settings', 'url': '/admin/account-settings', 'children': settings_children},
              {'name': 'Users',       'icon': 'lucide-users',    'url': '/admin/users',       'key': 'users'},
              {'name': 'Roles',       'icon': 'lucide-share-2',  'url': '/admin/roles',       'key': 'roles'},
              {'name': 'Permissions', 'icon': 'lucide-shield',   'url': '/admin/permissions', 'key': 'permissions'}
            ]
          },
          {
            'label': 'Extras',
            'items': [
              {'name': 'Mobiles', 'icon': 'lucide-smartphone', 'key': 'mobiles', 'children': [
                {'name': 'All Mobiles', 'url': '/admin/mobiles/all',    'key': 'mobiles-list'},
                {'name': 'Add Mobile',  'url': '/admin/mobiles/insert', 'key': 'add-mobile'}
              ]},
              {'name': 'CV Management', 'icon': 'lucide-user', 'key': 'cv-management', 'children': [
                {'name': 'CVs',           'url': '/admin/cvs',              'key': 'cvs'},
                {'name': 'CV Infos',   'url': '/admin/cv-infos', 'key': 'cv-infos'},
                {'name': 'Templates',       'url': '/admin/cv-templates',     'key': 'cv-templates'},
                {'name': 'Purchases',       'url': '/admin/cv-purchases',     'key': 'cv-purchases'},
                {'name': 'Job Positions',   'url': '/admin/job-positions',    'key': 'job-positions'}
              ]},
              {'name': 'Notifications', 'icon': 'lucide-bell', 'key': 'notifications', 'children': [
                {'name': 'My Notifications', 'url': '/admin/my/notifications',        'key': 'my-notifications'},
                {'name': 'Dashboard',        'url': '/admin/notifications',           'key': 'notif-dashboard'},
                {'name': 'Send',             'url': '/admin/notifications/send',      'key': 'send-notif'},
                {'name': 'All',              'url': '/admin/notifications/list',      'key': 'all-notif'},
                {'name': 'Subscribers',      'url': '/admin/notification-subscribers','key': 'notif-subscribers'},
                {'name': 'Templates',        'url': '/admin/notification-templates',  'key': 'notification-templates'}
              ]},
              {'name': 'Scrap Control',    'icon': 'lucide-cloud-download', 'url': '/admin/scrap-control-center', 'key': 'scrap-control-center'},
              {'name': 'Comments',         'icon': 'lucide-message-circle', 'url': '/admin/comments',            'key': 'comments'},
              {'name': 'Contact',          'icon': 'lucide-mail',           'url': '/admin/contact',             'key': 'contact'},
              {'name': 'Email Templates',  'icon': 'lucide-file-text',      'url': '/admin/email-templates',     'key': 'email-templates'}
            ]
          }
        ] %}

          <a class="list-group-item list-group-item-action d-flex align-items-center sidebar-menu-toggle {{ is_child_active ? 'active' }}"
            data-bs-toggle="collapse"
            href="#{{ prefix }}-submenu-{{ item.key }}"
            role="button"
            aria-expanded="{{ is_child_active ? 'true' : 'false' }}"
            aria-controls="{{ prefix }}-submenu-{{ item.key }}"
            title="{{ item.name }}">
            <i class="bi {{ item.icon }} me-2"></i>
            <span class="sidebar-label">{{ item.name }}</span>
            <i class="bi bi-chevron-down ms-auto"></i>
          </a>
          <div class="sidebar-submenu collapse {{ is_child_active ? 'show' }}" id="{{ prefix }}-submenu-{{ item.key }}">
            <div class="list-group list-group-flush sidebar-submenu-list ms-3">
              {% for child in item.children %}
                <a href="{{ child.url }}"
                  class="list-group-item list-group-item-action sidebar-submenu-item {{ current_page == child.key ? 'active' }}"
                  aria-current="{{ current_page == child.key ? 'page' }}"
                  title="{{ child.name }}">
                  <span class="sidebar-label">{{ child.name }}</span>
                </a>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <a href="{{ item.url }}"
            class="list-group-item list-group-item-action d-flex align-items-center sidebar-menu-link {{ current_page == item.key ? 'active' }}"
            aria-current="{{ current_page == item.key ? 'page' }}"
            title="{{ item.name }}">
            <i class="bi {{ item.icon }} me-2"></i>
            <span class="sidebar-label">{{ item.name }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  {% endmacro %}

  {% import _self as menus %}

  {# Unified Responsive Sidebar #}
  <div class="sidebar col-lg-3 col-xl-2 bg-white shadow-sm">
    <div class="sidebar-header d-lg-none p-3 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="m-0 fw-bold">Menu</h5>
      <button type="button" class="modern-btn-close sidebar-close"></button>
    </div>
    <div class="p-3">
      <div class="d-none d-lg-flex align-items-center justify-content-end mb-2">
        <button
          type="button"
          class="sidebar-mini-toggle btn btn-sm btn-outline-secondary"
          aria-label="Toggle compact sidebar"
          title="Toggle compact sidebar"
          aria-pressed="false"
          aria-expanded="false">
          <i class="bi bi-layout-sidebar-inset-reverse"></i>
        </button>
      </div>
      {{ menus.render_menu(menu_items, current_page, 'main') }}
    </div>
  </div>
  
  {# Sidebar overlay for mobile - toggles with sidebar #}
  <div class="sidebar-overlay"></div>
  
  <div class="admin-column-resizer d-none d-lg-flex"
       id="adminColumnResizer"
       role="separator"
       aria-label="Resize sidebar"
       title="↔ Drag to resize • ⟲ Double-click to reset"
       data-tooltip="↔ Drag to resize • ⟲ Double-click to reset"
       aria-orientation="vertical"
       tabindex="0"></div>

      <!-- Main content -->
      <main class="col-12 col-lg-9 col-xl-10 py-4 admin-main">
        {% if skip_auto_breadcrumb is not defined or skip_auto_breadcrumb == false %}
            {% if breadcrumbs is not defined %}
                {% set breadcrumbs = auto_admin_breadcrumbs() %}
            {% endif %}
            {% include 'admin/partials/breadcrumb.twig' %}
        {% endif %}

        {% set flash_data = flash_message|default(flash|default(null)) %}
        {{ flash_macros.render_flash(flash_data) }}
        {% include 'admin/partials/_offline_draft_recover.twig' %}
        
        {% block content %}
        {% endblock %}
      </main>

    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-dark text-white text-center py-3 mt-auto">
    &copy; {{ "now"|date("Y") }} Admin Panel. All rights reserved.
  </footer>

  {# Footer scripts #}
  {# jQuery for legacy code compatibility - load before other scripts #}
  <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>

  <script>
    window.__APP_JS_CONFIG_OVERRIDES = {
      notifications: {
        websocketUrl: {{ env('WEBSOCKET_SERVER_URL', '') | json_encode | raw }}
      }
    };
  </script>
  <script src="{{ asset('/assets/js/dist/app-config.js') }}" defer></script>
  <script src="{{ asset('/assets/firebase/v2/dist/firebase-config.js') }}" defer></script>

  <script src="{{ asset('/assets/js/dist/bootstrap-lite.js') }}" defer></script>

  {# SweetAlert2 + global flash handler #}
  <script src="{{ asset('/cdn/js/sweetalert2.all.min.js') }}" defer></script>
  <script src="{{ asset('/assets/js/dist/sweetalert2-handler.js') }}" defer></script>

  {# Feature scripts #}
  {# Datepicker Library #}
  <link rel="stylesheet" href="{{ asset('/assets/datepicker/datepicker.css') }}">
  <script src="{{ asset('/assets/datepicker/datepicker.js') }}" defer></script>
  <script src="{{ asset('/assets/js/dist/datepicker.js') }}" defer></script>

  <script type="module" src="{{ asset('/assets/js/dist/theme-manager.js') }}" defer></script>

   {# Admin scripts #}
