{# Admin panel layout #}
<!DOCTYPE html>
<html lang="en" data-theme="light">

{# ===== Imports ===== #}
{% import '_macros/flash.twig' as flash_macros %}
<head>
 <meta charset="UTF-8">
 <meta http-equiv="X-UA-Compatible" content="IE=edge">
 <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
 <title>{% block title %}{{ title|default('Admin') }}{% endblock %}</title>
 <meta name="robots" content="noindex, nofollow">
 <meta name="csrf-token" content="{{ csrf_token }}">
 {% if auth_user.id %}<meta name="user-id" content="{{ auth_user.id }}">{% endif %}
 {% if auth_user.id %}
 <script>
 // Expose the current admin's permissions for client-side checks.
 window.ADMIN_PERMISSIONS = {{ getUserPermissions(auth_user.id)|json_encode|raw }};
 window.IS_SUPER_ADMIN = {{ auth_user.is_super_admin ? 'true' : 'false' }};
 window.AUTH_USER_ID = {{ auth_user.id|default('null') }};
 </script>
 {% endif %}

 <script>
 (function () {
 try {
 var root = document.documentElement;
 var savedTheme = localStorage.getItem('broxbhai-theme') || localStorage.getItem('app-theme');
 var isValidSavedTheme = savedTheme === 'dark' || savedTheme === 'light';
 var resolvedTheme = isValidSavedTheme
 ? savedTheme
 : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

 root.setAttribute('data-theme', resolvedTheme);
 root.style.colorScheme = resolvedTheme;
 } catch (error) {
 // Ignore storage/media-query failures and keep the default theme.
 }
 })();
 </script>

 <link rel="icon" type="image/x-icon" href="{{ app_settings.favicon|default('/assets/logo/favicon.ico') }}">

 {# Fonts #}
 <link rel="preconnect" href="https://fonts.googleapis.com">
 <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
 <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Noto+Sans+Bengali:wght@100..900&display=swap" rel="stylesheet">

 {# Core styles - Tailwind single source of truth #}
 <link rel="stylesheet" href="{{ asset('/assets/css/dist/tailwind-admin.css') }}">
 <link rel="stylesheet" href="{{ asset('/cdn/css/lucide/lucide.css') }}">
 <link rel="stylesheet" href="{{ asset('/ai/dist/ai-style.css') }}">
 <link rel="stylesheet" href="{{ asset('/assets/ai-assistant/styles/thinking-indicator.css') }}">

 {# Third-party styles #}
 <link href="{{ asset('/cdn/css/sweetalert2.min.css') }}" rel="stylesheet">

 {% block stylesheets %}{% endblock %}
</head>
<body data-admin-dir="{{ admin_dir|default('/admin') }}" class="admin-shell">
 <div class="admin-shell min-h-screen">
  <header class="admin-topbar sticky top-0 z-40">
   <div class="admin-topbar-inner container-admin">
    <button class="sidebar-toggle admin-icon-button lg:hidden" type="button" aria-label="Open navigation">
     <i class="lucide lucide-menu"></i>
    </button>

    <a class="admin-brand" href="/admin/dashboard" aria-label="Go to dashboard">
     <span class="admin-brand-mark">
      <i class="lucide lucide-gauge"></i>
     </span>
     <span class="hidden sm:flex sm:flex-col">
      <span class="text-sm font-semibold leading-none">BroxLab Admin</span>
      <span class="text-xs text-slate-300">Command center</span>
     </span>
    </a>

    <form class="admin-search hidden flex-1 items-center xl:flex" role="search" action="/admin/dashboard" method="get">
     <label class="sr-only" for="adminGlobalSearch">Search admin</label>
     <div class="admin-search-shell">
      <i class="lucide lucide-search text-slate-400"></i>
      <input
       id="adminGlobalSearch"
       name="search"
       type="search"
       class="admin-search-input"
       placeholder="Search admin records"
       value="{{ search|default(pagination.search|default('')) }}">
     </div>
    </form>

    <div class="ml-auto flex items-center gap-2 sm:gap-3">
     {% set admin_unread_count = unread_count|default(0) %}

     <div class="relative" data-notification-menu>
      <a
       href="#"
       id="adminNotificationBell"
       data-notification-bell
       aria-expanded="false"
       title="Notifications"
       class="admin-icon-button relative"
       aria-label="Notifications">
       <i class="lucide lucide-bell"></i>
       <span id="adminNotificationBadge" class="admin-badge-dot {{ admin_unread_count <= 0 ? 'hidden' : '' }}">
        <span id="adminNotificationCount" data-notification-count>{{ admin_unread_count }}</span>
       </span>
      </a>
      <div data-notification-dropdown aria-labelledby="adminNotificationBell" class="dropdown-menu admin-dropdown-menu">
       <div class="admin-dropdown-header">
        <h6 class="flex items-center gap-2 text-sm font-semibold text-slate-900">
         <i class="lucide lucide-bell"></i>
         Notifications
        </h6>
       </div>
       <div id="adminNotificationsList" data-notification-list data-user-id="{{ auth_user.id|default('') }}" class="admin-notification-list">
        {% if notifications is defined and notifications is iterable and notifications|length > 0 %}
         {% for notif in notifications|slice(0, 10) %}
          <div
           class="admin-notification-entry {{ notif.is_read is defined and notif.is_read == 0 ? 'is-unread' : '' }}"
           data-notification-id="{{ notif.id }}"
           {% if notif.action_url is defined and notif.action_url %}data-action-url="{{ notif.action_url }}"{% endif %}>
           <div class="flex items-start gap-3">
            <div class="min-w-0 flex-1">
             <div class="mb-1 text-sm font-semibold text-slate-900">{{ notif.title }}</div>
             <div class="mb-1 text-sm text-slate-500">{{ notif.message }}</div>
             <div class="text-xs text-slate-400">{{ notif.created_at|date("n/j/Y, g:i:s A") }}</div>
            </div>
            {% if notif.is_read is defined and notif.is_read == 0 %}
             <button
              type="button"
              class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 transition hover:bg-slate-50"
              data-action="mark-read"
              data-notification-id="{{ notif.id }}">
              Read
             </button>
            {% endif %}
           </div>
          </div>
         {% endfor %}
        {% else %}
         <div class="py-8 text-center text-slate-500">
          <i class="lucide lucide-inbox mb-2 text-xl"></i>
          <p class="mb-0 text-sm">No notifications yet</p>
         </div>
        {% endif %}
       </div>
       <div class="admin-dropdown-divider"></div>
       <a href="/admin/my/notifications" class="admin-dropdown-link">
        <i class="lucide lucide-arrow-right"></i>
        View all notifications
       </a>
      </div>
     </div>

     <button
      class="admin-icon-button"
      id="broxThemeToggle"
      type="button"
      title="Toggle theme"
      aria-label="Toggle dark mode"
      aria-pressed="false">
      <i class="lucide lucide-circle-half"></i>
     </button>

     <div class="relative" id="serverStatusIndicator" data-brox-toggle="dropdown" aria-expanded="false" title="Checking server status..." aria-label="Server status">
      <div class="admin-status-chip">
       <i class="lucide lucide-server" id="serverStatusIcon"></i>
       <span class="hidden md:inline" id="serverStatusText">Checking</span>
       <i class="lucide lucide-chevron-down text-[0.7rem]"></i>
      </div>
      <ul class="dropdown-menu admin-dropdown-menu admin-status-menu" aria-labelledby="serverStatusIndicator">
       <li class="px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Server Status</li>
       <li>
        <div data-service="database" class="admin-status-row">
         <i class="lucide lucide-database"></i>
         <span>Database</span>
         <span class="status-badge" data-status="checking">Checking</span>
        </div>
       </li>
       <li>
        <div data-service="cache" class="admin-status-row">
         <i class="lucide lucide-hard-drive"></i>
         <span>Cache</span>
         <span class="status-badge" data-status="checking">Checking</span>
        </div>
       </li>
       <li>
        <div data-service="api" class="admin-status-row">
         <i class="lucide lucide-settings"></i>
         <span>API</span>
         <span class="status-badge" data-status="checking">Checking</span>
        </div>
       </li>
       <li>
        <div data-service="nodejs" class="admin-status-row">
         <i class="lucide lucide-code"></i>
         <span>Node.js</span>
         <span class="status-badge" data-status="checking">Checking</span>
        </div>
       </li>
       <li><hr class="my-1 border-slate-200/80"></li>
       <li class="px-4 py-2">
        <small class="text-xs text-slate-500" id="serverStatusLastCheck">Last checked: Never</small>
       </li>
      </ul>
     </div>

     {% if auth_user.is_authenticated %}
      <div class="relative" data-admin-user-menu>
       <a
        class="admin-user-chip"
        href="#"
        id="adminUserMenu"
        data-brox-toggle="dropdown"
        data-admin-user-toggle
        aria-expanded="false"
        aria-haspopup="true">
        <img src="{{ auth_user.profile_pic|default('/assets/images/default-avatar.png') }}" alt="Profile" class="admin-user-avatar">
        <div class="hidden sm:block text-left">
         <div class="text-sm font-semibold text-slate-900">{{ auth_user.username }}</div>
         {% if auth_user.roles is not empty %}
          <div class="text-xs font-medium uppercase tracking-wide text-indigo-600">{{ auth_user.roles|join(', ')|upper }}</div>
         {% endif %}
        </div>
       </a>
       <ul class="dropdown-menu admin-dropdown-menu admin-user-dropdown" data-admin-user-dropdown aria-labelledby="adminUserMenu">
        <li><a class="admin-dropdown-link" href="/admin/profile"><i class="lucide lucide-user-circle"></i> Profile</a></li>
        <li><a class="admin-dropdown-link" href="/admin/dashboard"><i class="lucide lucide-gauge"></i> Dashboard</a></li>
        <li><a class="admin-dropdown-link" href="/admin/my/notifications"><i class="lucide lucide-bell"></i> My Notifications</a></li>
        <li><a class="admin-dropdown-link" href="/admin/account-settings"><i class="lucide lucide-settings"></i> Account Settings</a></li>

        {% if auth_user.is_super_admin %}
         <li><hr class="my-1 border-slate-200/80"></li>
         <li><a class="admin-dropdown-link" href="/admin/roles"><i class="lucide lucide-shield"></i> Manage Roles</a></li>
         <li><a class="admin-dropdown-link" href="/admin/permissions"><i class="lucide lucide-key"></i> Manage Permissions</a></li>
        {% endif %}

        <li><hr class="my-1 border-slate-200/80"></li>
        <li><a class="admin-dropdown-link danger" href="/logout" data-unified-logout><i class="lucide lucide-log-out"></i> Logout</a></li>
       </ul>
      </div>
     {% endif %}
    </div>
   </div>
  </header>

  <div class="sidebar-overlay"></div>

  <div class="admin-shell-row container-admin">
   {% set settings_children = [
    {'name': 'Account Settings', 'url': '/admin/account-settings', 'key': 'account-settings'}
   ] %}

   {% if auth_user.is_super_admin %}
    {% set settings_children = settings_children|merge([
     {'name': 'App Settings', 'url': '/admin/app-settings', 'key': 'app-settings'},
     {'name': 'AI SYSTEM', 'url': '/admin/ai-system', 'key': 'ai-settings'},
     {'name': 'Feature Flags', 'url': '/admin/feature-flags', 'key': 'feature-flags'}
    ]) %}
   {% endif %}

   {% set menu_items = [
    {'name': 'Dashboard', 'icon': 'lucide-gauge', 'url': '/admin/dashboard', 'key': 'dashboard'},
    {'name': 'Analytics', 'icon': 'lucide-bar-chart-3', 'url': '/admin/analytics', 'key': 'analytics'},
    {'name': 'Activity', 'icon': 'lucide-activity', 'url': '/admin/log-activity', 'key': 'log-activity'},
    {'name': 'Mobiles', 'icon': 'lucide-smartphone', 'url': '/admin/mobiles/all', 'key': 'mobiles', 'children': [
     {'name': 'All Mobiles', 'url': '/admin/mobiles/all', 'key': 'mobiles-list'},
     {'name': 'Add Mobile', 'url': '/admin/mobiles/insert', 'key': 'add-mobile'}
    ]},
    {'name': 'Posts', 'icon': 'lucide-file-text', 'url': '/admin/posts', 'key': 'posts', 'children': [
     {'name': 'All Posts', 'url': '/admin/posts', 'key': 'all-posts'},
     {'name': 'Add Post', 'url': '/admin/posts/create', 'key': 'add-post'}
    ]},
    {'name': 'AI Conversations', 'icon': 'lucide-message-square', 'url': '/admin/ai-chats', 'key': 'ai-chats'},
    {'name': 'Services', 'icon': 'lucide-award', 'url': '/admin/services', 'key': 'services', 'children': [
     {'name': 'All Services', 'url': '/admin/services', 'key': 'all-services'},
     {'name': 'Create Service', 'url': '/admin/services/create', 'key': 'create-service'}
    ]},
    {'name': 'Service Applications', 'icon': 'lucide-briefcase', 'url': '/admin/applications', 'key': 'applications', 'children': [
     {'name': 'All Applications', 'url': '/admin/applications', 'key': 'all-applications'},
     {'name': 'Pending', 'url': '/admin/applications?status=pending', 'key': 'pending-applications'},
     {'name': 'Approved', 'url': '/admin/applications?status=approved', 'key': 'approved-applications'},
     {'name': 'Rejected', 'url': '/admin/applications?status=rejected', 'key': 'rejected-applications'},
     {'name': 'Receipts', 'url': '/admin/applications/receipts', 'key': 'applications-receipts'}
    ]},
    {'name': 'Pages', 'icon': 'lucide-file-text', 'url': '/admin/pages', 'key': 'pages'},
    {'name': 'Categories', 'icon': 'lucide-tags', 'url': '/admin/categories', 'key': 'categories'},
    {'name': 'Tags', 'icon': 'lucide-hash', 'url': '/admin/tags', 'key': 'tags'},
    {'name': 'Media Manager', 'icon': 'lucide-image', 'url': '/admin/media', 'key': 'media'},
    {'name': 'CV Management', 'icon': 'lucide-user', 'url': '/admin/cvs', 'key': 'cv-management', 'children': [
     {'name': 'CVs', 'url': '/admin/cvs', 'key': 'cvs'},
     {'name': 'Templates', 'url': '/admin/cv-templates', 'key': 'cv-templates'}
    ]},
    {'name': 'Notifications', 'icon': 'lucide-bell', 'url': '/admin/notifications', 'key': 'notifications', 'children': [
     {'name': 'My Notifications', 'url': '/admin/my/notifications', 'key': 'my-notifications'},
     {'name': 'Dashboard', 'url': '/admin/notifications', 'key': 'notif-dashboard'},
     {'name': 'Send Notification', 'url': '/admin/notifications/send', 'key': 'send-notif'},
     {'name': 'All Notifications', 'url': '/admin/notifications/list', 'key': 'all-notif'},
     {'name': 'Subscribers', 'url': '/admin/notification-subscribers', 'key': 'notif-subscribers'},
     {'name': 'Templates', 'url': '/admin/notification-templates', 'key': 'notification-templates'}
    ]},
    {'name': 'Scrap Control Center', 'icon': 'lucide-cloud-download', 'url': '/admin/scrap-control-center', 'key': 'scrap-control-center'},
    {'name': 'Comments', 'icon': 'lucide-message-circle', 'url': '/admin/comments', 'key': 'comments'},
    {'name': 'SMS Logs', 'icon': 'lucide-message-square', 'url': '/admin/sms-logs', 'key': 'sms-logs'},
    {'name': 'Users', 'icon': 'lucide-users', 'url': '/admin/users', 'key': 'users'},
    {'name': 'Roles', 'icon': 'lucide-share-2', 'url': '/admin/roles', 'key': 'roles'},
    {'name': 'Permissions', 'icon': 'lucide-shield', 'url': '/admin/permissions', 'key': 'permissions'},
    {'name': 'Contact Messages', 'icon': 'lucide-mail', 'url': '/admin/contact', 'key': 'contact', 'children': [
     {'name': 'All Messages', 'url': '/admin/contact', 'key': 'all-messages'}
    ]},
    {'name': 'Email Templates', 'icon': 'lucide-file-text', 'url': '/admin/email-templates', 'key': 'email-templates'},
    {'name': 'Settings', 'icon': 'lucide-settings', 'url': '/admin/account-settings', 'key': 'settings', 'children': settings_children}
   ] %}

   {% if auth_user.is_super_admin %}
    {% set menu_items = menu_items|merge([
     {'name': 'AI Knowledge Base', 'icon': 'lucide-book', 'url': '/admin/ai-knowledge', 'key': 'ai-knowledge'},
     {'name': 'AI Article Writer', 'icon': 'lucide-pencil', 'url': '/admin/ai/article-writer', 'key': 'ai-article-writer'},
     {'name': 'Live Article Writer', 'icon': 'lucide-refresh-cw', 'url': '/admin/ai/article-writer-stream', 'key': 'ai-article-writer-stream'},
     {'name': 'Bulk Article Gen', 'icon': 'lucide-boxes', 'url': '/admin/ai/bulk-article-writer', 'key': 'ai-bulk-article-writer'}
    ]) %}
   {% endif %}

   {% macro render_menu(menu_items, current_page, prefix) %}
    <div class="admin-sidebar-nav">
     {% for item in menu_items %}
      {% if item.children is defined %}
       {% set is_child_active = false %}
       {% for child in item.children %}
        {% if current_page == child.key %}
         {% set is_child_active = true %}
        {% endif %}
       {% endfor %}

       <a
        class="group list-group-item list-group-item-action admin-sidebar-link {{ is_child_active ? 'active' : '' }}"
        data-brox-toggle="collapse"
        href="#{{ prefix }}-submenu-{{ item.key }}"
        role="button"
        aria-expanded="{{ is_child_active ? 'true' : 'false' }}"
        aria-controls="{{ prefix }}-submenu-{{ item.key }}"
        title="{{ item.name }}">
        <span class="admin-sidebar-link-icon"><i class="lucide {{ item.icon }}"></i></span>
        <span>{{ item.name }}</span>
        <i class="lucide lucide-chevron-down ml-auto text-[0.8rem]"></i>
       </a>
       <div class="collapse {{ is_child_active ? 'show' : '' }}" id="{{ prefix }}-submenu-{{ item.key }}">
        <div class="admin-sidebar-submenu">
         {% for child in item.children %}
          <a
           href="{{ child.url }}"
           class="list-group-item list-group-item-action admin-sidebar-sublink {{ current_page == child.key ? 'active' : '' }}"
           aria-current="{{ current_page == child.key ? 'page' : 'false' }}"
           title="{{ child.name }}">
           <span>{{ child.name }}</span>
          </a>
         {% endfor %}
        </div>
       </div>
      {% else %}
       <a
        href="{{ item.url }}"
        class="group list-group-item list-group-item-action admin-sidebar-link {{ current_page == item.key ? 'active' : '' }}"
        aria-current="{{ current_page == item.key ? 'page' : 'false' }}"
        title="{{ item.name }}">
        <span class="admin-sidebar-link-icon"><i class="lucide {{ item.icon }}"></i></span>
        <span>{{ item.name }}</span>
       </a>
      {% endif %}
     {% endfor %}
    </div>
   {% endmacro %}

   {% import _self as menus %}

   <aside class="sidebar admin-sidebar" aria-label="Primary navigation">
    <div class="admin-sidebar-header">
     <div>
      <p class="admin-sidebar-kicker">Navigation</p>
      <h2 class="admin-sidebar-title">Menu</h2>
     </div>
     <button type="button" class="sidebar-close admin-icon-button lg:hidden" aria-label="Close navigation">
      <i class="lucide lucide-x"></i>
     </button>
    </div>

    <div class="admin-sidebar-tools">
     <button
      type="button"
      class="sidebar-mini-toggle admin-icon-button hidden lg:inline-flex"
      aria-label="Toggle compact sidebar"
      title="Toggle compact sidebar"
      aria-pressed="false"
      aria-expanded="false">
      <i class="lucide lucide-panel-left"></i>
     </button>
    </div>

    {{ menus.render_menu(menu_items, current_page|default(''), 'main') }}
   </aside>

   <div class="hidden lg:flex" id="adminColumnResizer" role="separator" aria-label="Resize sidebar" title="Drag to resize or double-click to reset" data-tooltip="Drag to resize or double-click to reset" aria-orientation="vertical" tabindex="0"></div>

   <main class="admin-main" role="main">
    <div class="admin-page">
     {% if skip_auto_breadcrumb is not defined or skip_auto_breadcrumb == false %}
      {% if breadcrumbs is not defined %}
       {% set breadcrumbs = auto_admin_breadcrumbs() %}
      {% endif %}
      {% include 'admin/partials/breadcrumb.twig' %}
     {% endif %}

     {% set flash_data = flash_message|default(flash|default(null)) %}
     {{ flash_macros.render_flash(flash_data) }}
     {% include 'admin/partials/_offline_draft_recover.twig' %}

     {% block content %}{% endblock %}
    </div>
   </main>
  </div>

  <footer class="admin-footer">
   &copy; {{"now"|date("Y") }} Admin Panel. All rights reserved.
  </footer>
 </div>

 <script>
 window.__APP_JS_CONFIG_OVERRIDES = {
 notifications: {
 websocketUrl: {{ env('WEBSOCKET_SERVER_URL', '') | json_encode | raw }}
 }
 };
 </script>
 <script src="{{ asset('/assets/js/dist/app-config.js') }}" defer></script>
 <script src="{{ asset('/assets/firebase/v2/dist/firebase-config.js') }}" defer></script>
 <script type="module" src="{{ asset('/assets/js/dist/brox-ui.js') }}"></script>

 <script src="{{ asset('/cdn/js/sweetalert2.all.min.js') }}" defer></script>
 <script src="{{ asset('/assets/js/dist/sweetalert2-handler.js') }}" defer></script>

 <link rel="stylesheet" href="{{ asset('/assets/datepicker/datepicker.css') }}">
 <script src="{{ asset('/assets/datepicker/datepicker.js') }}" defer></script>
 <script src="{{ asset('/assets/js/dist/datepicker.js') }}" defer></script>

 <script type="module" src="{{ asset('/assets/js/dist/theme-manager.js') }}" defer></script>

 <script src="{{ asset('/assets/js/dist/lucide-compat.js') }}"></script>
 <script type="module" src="{{ asset('/assets/js/dist/admin.js') }}" defer></script>
 <script src="{{ asset('/assets/js/dist/activity.js') }}" defer></script>

 <script>
 document.addEventListener('DOMContentLoaded', function () {
 const adminMain = document.querySelector('main.admin-main');
 if (!adminMain) return;

 const ensureSelectAllHeader = function (table) {
 if (!table || !(table instanceof HTMLElement)) return null;

 const hasRowCheckbox = table.querySelector('tbody input[type="checkbox"].item-checkbox');
 const existingSelectAll = table.querySelector('thead input#select-all-checkbox.table-select-checkbox');

 if (existingSelectAll || hasRowCheckbox) {
 return existingSelectAll || table.querySelector('thead input.table-select-checkbox');
 }

 const theadRow = table.querySelector('thead tr');
 if (!theadRow) return null;

 const thTexts = Array.from(theadRow.querySelectorAll('th')).map(th => (th.textContent || '').trim().toLowerCase());
 const isListing = thTexts.includes('actions') || thTexts.includes('action') || table.classList.contains('table-hover');
 if (!isListing) return null;

 const th = document.createElement('th');
 th.style.width = '40px';
 th.className = 'text-center';
 th.innerHTML = '<input type="checkbox" id="select-all-checkbox" class="w-4 h-4 border border-slate-300 rounded bg-white checked:bg-indigo-600 focus:ring-2 focus:ring-indigo-500 transition-colors cursor-pointer table-select-checkbox">';
 theadRow.insertBefore(th, theadRow.firstChild);

 table.querySelectorAll('tbody tr').forEach(function (tr) {
 const cells = tr.querySelectorAll('td');
 if (cells.length === 1 && cells[0] && cells[0].hasAttribute('colspan')) {
 return;
 }

 let rowId = (tr.getAttribute('data-id') || tr.getAttribute('data-grid grid-cols-1 gap-4 md:grid-cols-12-id') || '').trim();
 if (!rowId) {
 const firstCell = tr.querySelector('td');
 const txt = firstCell ? (firstCell.textContent || '').trim() : '';
 const m = txt.match(/(\d{1,12})/);
 rowId = m ? m[1] : '';
 }

 const td = document.createElement('td');
 td.className = 'text-center';
 if (rowId) {
 td.innerHTML = '<input type="checkbox" class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 table-select-checkbox item-checkbox" value="' + rowId.replace(/\"/g, '"') + '">';
 } else {
 td.innerHTML = '<input type="checkbox" class="w-4 h-4 border border-slate-300 rounded bg-white opacity-50 cursor-not-allowed table-select-checkbox item-checkbox" disabled>';
 }
 tr.insertBefore(td, tr.firstChild);
 });

 return th.querySelector('input#select-all-checkbox');
 };

 const wireTableSelection = function (table) {
 const selectAll = table.querySelector('thead input#select-all-checkbox.table-select-checkbox');
 const items = Array.from(table.querySelectorAll('tbody input[type="checkbox"].item-checkbox'));
 if (!selectAll || items.length === 0) return;

 if (selectAll.dataset.skipGlobalSelectAll === '1') return;
 if (selectAll.dataset.selectAllWired === '1') return;
 selectAll.dataset.selectAllWired = '1';

 const updateHeader = function () {
 const enabledItems = items.filter(cb => !cb.disabled);
 const total = enabledItems.length;
 const checked = enabledItems.filter(cb => cb.checked).length;

 selectAll.indeterminate = total > 0 && checked > 0 && checked < total;
 selectAll.checked = total > 0 && checked === total;
 };

 selectAll.addEventListener('change', function () {
 const enabledItems = items.filter(cb => !cb.disabled);
 enabledItems.forEach(function (cb) {
 cb.checked = !!selectAll.checked;
 });
 updateHeader();
 });

 items.forEach(function (cb) {
 cb.addEventListener('change', updateHeader);
 });

 updateHeader();
 };

 adminMain.querySelectorAll('table').forEach(function (table) {
 ensureSelectAllHeader(table);
 wireTableSelection(table);
 });
 });
 </script>

