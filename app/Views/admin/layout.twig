<script>
document.addEventListener('DOMContentLoaded', function () {
  'use strict';

  /* ── Scroll animations (handled by admin-sidebar-polish.js for sidebar) ── */
  (function () {
    var els = document.querySelectorAll('.scroll-fade-in, .scroll-slide-up, .scroll-scale-in');
    if (!els.length) return;
    if (!('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.classList.add('visible'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          io.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -60px 0px', threshold: 0.08 });
    els.forEach(function (el) { io.observe(el); });
  })();

  /* ── User dropdown (NOT handled by admin-sidebar-polish.js) ── */
  (function () {
    var trigger = document.getElementById('adminUserMenu');
    var dropdown = document.querySelector('[data-admin-user-dropdown]');
    if (!trigger || !dropdown) return;
    function toggleDropdown(force) {
      var open = typeof force === 'boolean' ? force : !dropdown.classList.contains('open');
      dropdown.classList.toggle('open', open);
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    trigger.addEventListener('click', function (e) { e.stopPropagation(); toggleDropdown(); });
    document.addEventListener('click', function (e) {
      if (!trigger.contains(e.target) && !dropdown.contains(e.target)) toggleDropdown(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') toggleDropdown(false);
    });
  })();

  /* ── Theme toggle aria-pressed sync ── */
  (function () {
    var themeBtn = document.getElementById('broxThemeToggle');
    if (!themeBtn) return;
    function syncThemeState() {
      var theme = document.documentElement.getAttribute('data-theme');
      var isDark = theme === 'dark';
      themeBtn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    }
    syncThemeState();
    // Watch data-theme attribute mutations — covers all theme change sources
    var observer = new MutationObserver(function () { syncThemeState(); });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  })();

  /* ── Notification bell ARIA state ── */
  (function () {
    var notifBtn = document.getElementById('adminNotificationBell');
    if (!notifBtn) return;
    // Listen for notification panel open/close events
    document.addEventListener('notif-panel-toggle', function (e) {
      notifBtn.setAttribute('aria-expanded', e.detail && e.detail.open ? 'true' : 'false');
    });
  })();

  /* ── Server status indicator ARIA state ── */
  (function () {
    var statusBtn = document.getElementById('serverStatusIndicator');
    if (!statusBtn) return;
    document.addEventListener('server-status-toggle', function (e) {
      statusBtn.setAttribute('aria-expanded', e.detail && e.detail.open ? 'true' : 'false');
    });
  })();

  /* ── Sidebar toggle button initial aria state ── */
  (function () {
    var toggleBtn = document.getElementById('sidebarToggle');
    if (toggleBtn) {
      // Ensure initial state reflects sidebar visibility
      var sidebar = document.getElementById('adminSidebar');
      var isVisible = sidebar && !sidebar.classList.contains('-translate-x-full');
      toggleBtn.setAttribute('aria-expanded', isVisible ? 'true' : 'false');
    }
    // Close button — aria state only; actual sidebar close handled by admin-sidebar-polish.js
    var closeBtn = document.getElementById('sidebarClose');
    if (closeBtn && toggleBtn) {
      closeBtn.addEventListener('click', function () {
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    }
  })();

  /* ── Table select-all (for admin tables) ── */
  (function () {
    var adminMain = document.querySelector('main[role="main"]');
    if (!adminMain) return;
    adminMain.querySelectorAll('table').forEach(function (table) {
      var selectAll = table.querySelector('thead [data-select-all-checkbox]');
      var items = Array.from(table.querySelectorAll('tbody input[type="checkbox"].item-checkbox'));
      if (!selectAll || !items.length) return;
      if (selectAll.dataset.selectAllWired === '1') return;
      selectAll.dataset.selectAllWired = '1';
      function updateHeader() {
        var enabled = items.filter(function (cb) { return !cb.disabled; });
        var checked = enabled.filter(function (cb) { return cb.checked; });
        selectAll.indeterminate = enabled.length > 0 && checked.length > 0 && checked.length < enabled.length;
        selectAll.checked = enabled.length > 0 && checked.length === enabled.length;
      }
      selectAll.addEventListener('change', function () {
        items.forEach(function (cb) { if (!cb.disabled) cb.checked = !!selectAll.checked; });
        updateHeader();
      });
      items.forEach(function (cb) { cb.addEventListener('change', updateHeader); });
      updateHeader();
    });
  })();

  /* ── Sidebar badge counts (handled separately from admin-sidebar-polish.js) ── */
  (function () {
    fetch('/api/admin/sidebar-counts')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.success || !data.counts) return;
        document.querySelectorAll('.sidebar-badge[data-badge-key]').forEach(function (badge) {
          var count = data.counts[badge.getAttribute('data-badge-key')];
          if (typeof count === 'number' && count > 0) {
            badge.textContent = count > 99 ? '99+' : count;
            badge.style.display = 'inline-flex';
          }
        });
      })
      .catch(function () {});
  })();

});
</script>

