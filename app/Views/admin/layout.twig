 {# ── Admin: scroll animations, sidebar, table select-all, badge counts ── #}
 <script>
 document.addEventListener('DOMContentLoaded', function () {
  // ── IntersectionObserver scroll animations ──
  (function() {
    var els = document.querySelectorAll('.scroll-fade-in, .scroll-slide-up, .scroll-scale-in');
    if (!els.length) return;
    if (!('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.classList.add('visible'); });
      return;
    }
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
      });
    }, { rootMargin: '0px 0px -60px 0px', threshold: 0.08 });
    els.forEach(function (el) { observer.observe(el); });
  })();

  // ── Table select-all checkbox wiring ──
  const adminMain = document.querySelector('main[role="main"]');
  if (adminMain) {
    const ensureSelectAllHeader = function (table) {
      if (!table || !(table instanceof HTMLElement)) return null;
      const hasRowCheckbox = table.querySelector('tbody input[type="checkbox"].item-checkbox');
      const existingSelectAll = table.querySelector('thead [data-select-all-checkbox], thead #select-all-checkbox');
      if (existingSelectAll || hasRowCheckbox) return existingSelectAll || table.querySelector('thead input.table-select-checkbox');
      const theadRow = table.querySelector('thead tr');
      if (!theadRow) return null;
      const thTexts = Array.from(theadRow.querySelectorAll('th')).map(th => (th.textContent || '').trim().toLowerCase());
      const isListing = thTexts.includes('actions') || thTexts.includes('action') || table.hasAttribute('data-listing');
      if (!isListing) return null;
      const th = document.createElement('th');
      th.style.width = '40px';
      th.className = 'text-center';
      th.innerHTML = '<input type="checkbox" data-select-all-checkbox="true" class="w-4 h-4 border border-slate-300 rounded bg-white checked:bg-indigo-600 focus:ring-2 focus:ring-indigo-500 transition-colors cursor-pointer table-select-checkbox">';
      theadRow.insertBefore(th, theadRow.firstChild);
      table.querySelectorAll('tbody tr').forEach(function (tr) {
        const cells = tr.querySelectorAll('td');
        if (cells.length === 1 && cells[0] && cells[0].hasAttribute('colspan')) return;
        let rowId = (tr.getAttribute('data-id') || tr.getAttribute('data-row-id') || tr.getAttribute('data-item-id') || '').trim();
        if (!rowId) {
          const firstCell = tr.querySelector('td');
          const txt = firstCell ? (firstCell.textContent || '').trim() : '';
          const m = txt.match(/(\d{1,12})/);
          rowId = m ? m[1] : '';
        }
        const td = document.createElement('td');
        td.className = 'text-center';
        td.innerHTML = rowId
          ? '<input type="checkbox" class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 table-select-checkbox item-checkbox" value="' + rowId.replace(/"/g, '&quot;') + '">'
          : '<input type="checkbox" class="w-4 h-4 border border-slate-300 rounded bg-white opacity-50 cursor-not-allowed table-select-checkbox item-checkbox" disabled>';
        tr.insertBefore(td, tr.firstChild);
      });
      return th.querySelector('[data-select-all-checkbox], #select-all-checkbox');
    };
    const wireTableSelection = function (table) {
      const selectAll = table.querySelector('thead [data-select-all-checkbox].table-select-checkbox, thead #select-all-checkbox.table-select-checkbox');
      const items = Array.from(table.querySelectorAll('tbody input[type="checkbox"].item-checkbox'));
      if (!selectAll || items.length === 0) return;
      if (selectAll.dataset.skipGlobalSelectAll === '1' || selectAll.dataset.selectAllWired === '1') return;
      selectAll.dataset.selectAllWired = '1';
      const updateHeader = function () {
        const enabledItems = items.filter(function(cb) { return !cb.disabled; });
        const total = enabledItems.length;
        const checked = enabledItems.filter(function(cb) { return cb.checked; }).length;
        selectAll.indeterminate = total > 0 && checked > 0 && checked < total;
        selectAll.checked = total > 0 && checked === total;
      };
      selectAll.addEventListener('change', function () {
        items.forEach(function (cb) { if (!cb.disabled) cb.checked = !!selectAll.checked; });
        updateHeader();
      });
      items.forEach(function (cb) { cb.addEventListener('change', updateHeader); });
      updateHeader();
    };
    adminMain.querySelectorAll('table').forEach(function (table) {
      ensureSelectAllHeader(table);
      wireTableSelection(table);
    });
  }

  // ── Sidebar badge counts fetch ──
  fetch('/api/admin/sidebar-counts').then(function (res) { return res.json(); }).then(function (data) {
    if (!data.success || !data.counts) return;
    var counts = data.counts;
    var badges = document.querySelectorAll('.sidebar-badge[data-badge-key]');
    badges.forEach(function (badge) {
      var key = badge.getAttribute('data-badge-key');
      var count = counts[key];
      if (typeof count === 'number' && count > 0) {
        badge.textContent = count > 99 ? '99+' : count;
        badge.style.display = 'inline-flex';
      }
    });
  }).catch(function () { /* non-critical */ });
 });
 </script>

