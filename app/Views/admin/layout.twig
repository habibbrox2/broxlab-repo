{# Admin panel layout #}
<!DOCTYPE html>
<html lang="en" data-theme="light">

{# ===== Imports ===== #}
{% import '_macros/flash.twig' as flash_macros %}
<head>
 <meta charset="UTF-8">
 <meta http-equiv="X-UA-Compatible" content="IE=edge">
 <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
 <title>{% block title %}{{ title|default('Admin') }}{% endblock %}</title>
 <meta name="robots" content="noindex, nofollow">
 <meta name="csrf-token" content="{{ csrf_token }}">
 {% if auth_user.id %}<meta name="user-id" content="{{ auth_user.id }}">{% endif %}

 <script>
 (function () {
 try {
 var root = document.documentElement;
 var savedTheme = localStorage.getItem('broxbhai-theme') || localStorage.getItem('app-theme');
 var isValidSavedTheme = savedTheme === 'dark' || savedTheme === 'light';
 var resolvedTheme = isValidSavedTheme
 ? savedTheme
 : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

 root.setAttribute('data-theme', resolvedTheme);
 root.style.colorScheme = resolvedTheme;
 } catch (error) {
 // Ignore storage/media-query failures and keep the default theme.
 }
 })();
 </script>

 <link rel="icon" type="image/x-icon" href="{{ app_settings.favicon|default('/assets/logo/favicon.ico') }}">  {# Fonts — preload + swap (non render-blocking) #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="preload" as="style"
        href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Noto+Sans+Bengali:wght@100..900&display=swap"
        onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Noto+Sans+Bengali:wght@100..900&display=swap" rel="stylesheet">
  </noscript>

 {# Core styles - Tailwind single source of truth #}
 <link rel="stylesheet" href="{{ asset('/assets/css/dist/tailwind-admin.css') }}">
 <link rel="stylesheet" href="{{ asset('/assets/css/admin-sidebar-polish.css') }}">
 <link rel="stylesheet" href="{{ asset('/cdn/css/lucide/lucide.css') }}"
        media="print" onload="this.media='all'">
 <noscript><link rel="stylesheet" href="{{ asset('/cdn/css/lucide/lucide.css') }}"></noscript>

 {# AI Assistant styles #}
 <link rel="stylesheet" href="{{ asset('/assets/ai/css/assistant.css') }}">

 {# Third-party styles #}
 <link href="{{ asset('/cdn/css/sweetalert2.min.css') }}" rel="stylesheet">
 <link rel="stylesheet" href="{{ asset('/assets/datepicker/datepicker.css') }}">

 {% block stylesheets %}{% endblock %}
</head>
<body data-admin-dir="{{ admin_dir|default('/admin') }}" class="bg-white dark:bg-slate-950">
 <div class="min-h-screen flex flex-col">
  {# ===== TOP HEADER/NAVBAR ===== #}
  <header class="sticky top-0 z-40 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 shadow-sm">
   <div class="flex items-center justify-between px-4 sm:px-6 lg:px-8 py-2.5 gap-3">
    {# Mobile menu toggle #}
    <button id="sidebarToggle" class="lg:hidden topbar-btn" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="adminSidebar">
     <i class="lucide lucide-menu w-5 h-5"></i>
    </button>

    {# Brand #}
    <a class="flex items-center gap-2 flex-shrink-0" href="/admin/dashboard" aria-label="Go to dashboard">
     <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-600 text-white">
      <i class="lucide lucide-gauge w-4 h-4"></i>
     </div>
     <div class="hidden sm:block">
      <div class="text-sm font-bold text-slate-900 dark:text-white leading-none">BroxLab</div>
      <div class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight">Admin</div>
     </div>
    </a>

    {# Search bar with Cmd+K hint #}
    <div class="hidden lg:block admin-search-wrapper flex-1 max-w-md">
     <i class="lucide lucide-search search-icon"></i>
     <input
      id="adminGlobalSearch"
      type="search"
      class="search-input"
      placeholder="Search admin records…"
      value="{{ search|default(pagination.search|default('')) }}">
     <span class="kbd-hint" aria-hidden="true">Ctrl+K</span>
    </div>

    {# Right section - icons and user menu #}
    <div class="ml-auto flex items-center gap-0.5 sm:gap-1.5">
     {% set admin_unread_count = unread_count|default(0) %}

     {# Notification Bell #}
     <div class="relative">
      <button
       id="adminNotificationBell"
       type="button"
       aria-expanded="false"
       title="Notifications"
       class="topbar-btn relative"
       aria-label="Notifications">
       <i class="lucide lucide-bell w-[1.125rem] h-[1.125rem]"></i>
       {% if admin_unread_count > 0 %}
        <span class="absolute -top-0.5 -right-0.5 flex items-center justify-center min-w-[1.125rem] h-[1.125rem] text-[0.625rem] font-bold text-white bg-red-500 rounded-full px-1">
         <span id="adminNotificationCount">{{ admin_unread_count }}</span>
        </span>
       {% endif %}
      </button>
     </div>

     {# Theme Toggle #}
     <button
      id="broxThemeToggle"
      type="button"
      title="Toggle theme"
      aria-label="Toggle dark mode"
      aria-pressed="false"
      class="topbar-btn">
      <i class="lucide lucide-circle-half w-[1.125rem] h-[1.125rem]"></i>
     </button>

     {# Server Status Indicator #}
     <div class="relative">
      <button
       id="serverStatusIndicator"
       type="button"
       aria-expanded="false"
       title="Checking server status..."
       aria-label="Server status"
       class="topbar-btn gap-1.5 px-2.5 w-auto">
       <i class="lucide lucide-server w-[1.125rem] h-[1.125rem]" id="serverStatusIcon"></i>
       <span class="hidden md:inline text-xs" id="serverStatusText">Checking</span>
       <i class="lucide lucide-chevron-down w-3 h-3 opacity-50"></i>
      </button>
     </div>

     {# User Menu #}
     {% if auth_user.is_authenticated %}
      <div class="relative" data-admin-user-menu>
       <button
        id="adminUserMenu"
        type="button"
        aria-expanded="false"
        aria-haspopup="true"
        class="inline-flex items-center gap-1.5 px-1.5 py-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors group">
        <img src="{{ auth_user.profile_pic|default('/assets/images/default-avatar.png') }}" alt="Profile" class="w-7 h-7 rounded-full object-cover ring-2 ring-transparent group-hover:ring-indigo-300 dark:group-hover:ring-indigo-600 transition-all">
        <div class="hidden sm:block text-left">
         <div class="text-xs font-semibold text-slate-900 dark:text-white leading-tight">{{ auth_user.username }}</div>
         {% if auth_user.roles is not empty %}
          <div class="text-[0.625rem] font-medium text-indigo-600 dark:text-indigo-400 leading-tight">{{ auth_user.roles|join(', ')|upper }}</div>
         {% endif %}
        </div>
        <i class="lucide lucide-chevron-down w-3 h-3 text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-300 transition-colors"></i>
       </button>

       {# User dropdown menu #}
       <div
        data-admin-user-dropdown
        class="absolute right-0 mt-2 w-56 bg-white dark:bg-slate-800 rounded-lg shadow-lg dark:shadow-slate-900/50 border border-slate-200 dark:border-slate-700 divide-y divide-slate-100 dark:divide-slate-700 origin-top-right scale-95 opacity-0 invisible transition-all duration-150 ease-out pointer-events-none z-50"
        style="transform-origin: top right;">

        {# User info header #}
        <div class="px-4 py-3">
         <div class="flex items-center gap-3">
          <img src="{{ auth_user.profile_pic|default('/assets/images/default-avatar.png') }}" alt="Profile" class="w-10 h-10 rounded-full object-cover" loading="lazy" width="40" height="40">
          <div class="flex-1 min-w-0">
           <div class="text-sm font-semibold text-slate-900 dark:text-white truncate">{{ auth_user.username }}</div>
           <div class="text-xs text-slate-500 dark:text-slate-400 truncate">{{ auth_user.email|default('') }}</div>
          </div>
         </div>
        </div>

        {# Menu items #}
        <div class="py-2">
         <a href="/admin/account-settings" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
          <i class="lucide lucide-user w-4 h-4"></i>
          <span>Account Settings</span>
         </a>
         <a href="/admin/profile" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
          <i class="lucide lucide-user-circle w-4 h-4"></i>
          <span>View Profile</span>
         </a>
        </div>

        {# Logout #}
        <div class="py-2">
         <form method="POST" action="/logout" class="px-4 py-2">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <button type="submit" class="w-full flex items-center gap-3 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/20 px-0 py-2 rounded transition-colors -mx-0">
           <i class="lucide lucide-log-out w-4 h-4"></i>
           <span>Logout</span>
          </button>
         </form>
        </div>
       </div>
      </div>
     {% endif %}

