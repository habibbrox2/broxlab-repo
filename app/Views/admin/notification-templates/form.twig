{% extends"admin/layout.twig" %}
{% block title %}{{ title }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <link href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css"
 rel="stylesheet">
 <div class="w-full px-4 sm:px-6 py-4">
 <!-- Header -->
 <div class=" mb-4">
 <div>
 <i class="mdi mdi-bell-outline"></i>{{ title }}
 </div>
 <div>
 {% if template %}
 Edit and manage notification template settings
 {% else %}
 Create a new notification template
 {% endif %}
 </div>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <!-- Form Column -->
 <div class="lg:col-span-8">
 <form id="templateForm" class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <strong><i class="mdi mdi-pencil mr-2"></i>
 {% if template %}
 Edit
 {% else %}
 Create New
 {% endif %}
 Template</strong>
 </div>
 <div class="p-4">
 {% if template %}<input type="hidden" name="_method" value="PUT">{% endif %}
 <!-- Basic Information Section -->
 <div class="mb-4">
 <h6 class="text-uppercase font-bold mb-3">
 <i class="mdi mdi-information-outline mr-2"></i>Basic Information
 </h6>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="md:col-span-6 mb-3">
 <label class="form-label">
 Template Name <span class="text-red-600">*</span>
 </label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="name"
 name="name"
 value="{{ template.name ?? '' }}"
 required
 placeholder="e.g., Welcome Notification">
 </div>
 <div class="md:col-span-6 mb-3">
 <label class="form-label">
 Template Slug <span class="text-red-600">*</span>
 </label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="slug"
 name="slug"
 value="{{ template.slug ?? '' }}"
 required
 placeholder="e.g., welcome_notification"
 pattern="[a-z0-9_]+"
 title="Lowercase letters, numbers, and underscores only">  <small class="text-xs text-neutral-400">Used in code to reference this template</small>
 </div>
 </div>
 <div class="mb-3">
 <label class="form-label">Description</label>
 <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="description"
 name="description"
 rows="2"
 placeholder="What is this template used for?">{{ template.description ?? '' }}</textarea>
 </div>
 </div>
 <hr>
 <!-- Template Content Section -->
 <div class="mb-4">
 <h6 class="text-uppercase font-bold mb-3">
 <i class="mdi mdi-file-document-outline mr-2"></i>Template Content
 </h6>
 <div class="mb-3">
 <label class="form-label">
 Notification Title <span class="text-red-600">*</span>
 </label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="title"
 name="title"
 value="{{ template.title ?? '' }}"
 required
 placeholder="e.g., à¦¸à§à¦¬à¦¾à¦—à¦¤à¦® &#123;&#123; USER_NAME &#125;&#125;!"
 maxlength="255">  <small class="text-xs text-neutral-400">Supports variables like &#123;&#123; USER_NAME &#125;&#125;, &#123;&#123; APP_NAME &#125;&#125;, &#123;&#123; AMOUNT &#125;&#125;</small>
 </div>
 <div class="mb-3">
 <label class="form-label">
 Message Body <span class="text-red-600">*</span>
 </label>
 <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="body"
 name="body"
 rows="6"
 required
 placeholder="Notification message with &#123;&#123; VARIABLES &#125;&#125;...">{{ template.body ?? '' }}</textarea>  <small class="text-xs text-neutral-400">Supports markdown and template variables. Use &#123;&#123; VARIABLE_NAME &#125;&#125; syntax.</small>
 </div>
 <!-- Live Preview -->
 <div class="p-4 rounded-lg bg-neutral-50 text-neutral-600 border border-neutral-200">
 <strong class="block mb-2"><i class="mdi mdi-eye-outline mr-1"></i>Live Preview</strong>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="md:col-span-6">
 <small class="text-slate-500 block mb-1">Title</small>
 <div id="titlePreview" class="p-2 bg-white border rounded truncate">(Type to preview)</div>
 </div>
 <div class="md:col-span-6">
 <small class="text-slate-500 block mb-1">Body (first 100 chars)</small>
 <div id="bodyPreview" class="p-2 bg-white border rounded ">(Type to preview)</div>
 </div>
 </div>
 </div>
 </div>
 <hr>
 <!-- Channels & Configuration -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="md:col-span-6 mb-4">
 <h6 class="text-uppercase font-bold mb-3">
 <i class="mdi mdi-send-outline mr-2"></i>Delivery Channels
 </h6>
 <div class="flex items-start gap-2 mb-2">
 <input type="checkbox"
 class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
 id="ch_in_app"
 name="channels"
 value="in_app"
 {% if template and 'in_app' in (template.channels|default([])) %}checked{% endif %}>
 <label class="text-sm text-slate-700" for="ch_in_app">
 <i class="mdi mdi-bell mr-1"></i><strong>In-App Notification</strong>
 <br>
 <small class="text-slate-500">Shows in user dashboard</small>
 </label>
 </div>
 <div class="flex items-start gap-2 mb-2">
 <input type="checkbox"
 class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
 id="ch_fcm"
 name="channels"
 value="fcm"
 {% if template and 'fcm' in (template.channels|default([])) %}checked{% endif %}>
 <label class="text-sm text-slate-700" for="ch_fcm">
 <i class="mdi mdi-mobile mr-1"></i><strong>Push Notification (FCM)</strong>
 <br>
 <small class="text-slate-500">Mobile and web browsers</small>
 </label>
 </div>
 <div class="flex items-start gap-2 mb-2">
 <input type="checkbox"
 class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
 id="ch_email"
 name="channels"
 value="email"
 {% if template and 'email' in (template.channels|default([])) %}checked{% endif %}>
 <label class="text-sm text-slate-700" for="ch_email">
 <i class="mdi mdi-email mr-1"></i><strong>Email</strong>
 <br>
 <small class="text-slate-500">Sent via SMTP</small>
 </label>
 </div>
 <div class="flex items-start gap-2">
 <input type="checkbox"
 class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
 id="ch_sms"
 name="channels"
 value="sms"
 {% if template and 'sms' in (template.channels|default([])) %}checked{% endif %}>
 <label class="text-sm text-slate-700" for="ch_sms">
 <i class="mdi mdi-message-text mr-1"></i><strong>SMS</strong>
 <br>
 <small class="text-slate-500">Text messages</small>
 </label>
 </div>
 </div>
 <div class="md:col-span-6 mb-4">
 <h6 class="text-uppercase font-bold mb-3">
 <i class="mdi mdi-tag-multiple-outline mr-2"></i>Template Variables
 </h6>
 <div id="variablesList" class="mb-3 ">
 {% if template and template.variables %}
 {% for key, placeholder in template.variables %}
 <div class="input-group input-group-sm mb-2">
 <span class="inline-flex items-center">&#123;&#123;</span>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 placeholder="Variable name"
 value="{{ key }}"
 readonly>
 <span class="inline-flex items-center">&#125;&#125;</span>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 placeholder="Description"
 value="{{ placeholder }}">
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-red-600 hover:bg-red-100"
 onclick="removeVariable(this)"
 aria-label="Remove variable">
 <i class="mdi mdi-delete"></i>
 </button>
 </div>
 {% endfor %}
 {% endif %}
 </div>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100 modern-px-3 py-1.5 text-xs w-full"
 onclick="addVariable()">
 <i class="mdi mdi-plus mr-1"></i>Add Variable
 </button>
 </div>
 </div>
 <hr>
 <!-- Visual Settings -->
 <div class="mb-4">
 <h6 class="text-uppercase font-bold mb-3">
 <i class="mdi mdi-palette-outline mr-2"></i>Visual Settings
 </h6>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="md:col-span-6 mb-3">
 <label class="form-label">Icon Class (MDI)</label>
 <div class="input-group">
 <span class="inline-flex items-center"><i class="mdi mdi-bell"></i></span>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="icon"
 name="icon"
 value="{{ template.icon ?? '' }}"
 placeholder="e.g., bell, check-circle, star">
 </div>  <small class="text-xs text-neutral-400">See <a href="https://materialdesignicons.com/" target="_blank">MDI Icons</a></small>
 </div>
 <div class="md:col-span-6 mb-3">
 <label class="form-label">Color Code</label>
 <div class="input-group">
 <input type="color"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 focus:border-indigo-500-color"
 id="color"
 name="color"
 value="{{ template.color ?? '#0d6efd' }}">
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="colorText"
 value="{{ template.color ?? '#0d6efd' }}"
 placeholder="#0d6efd">
 </div>
 </div>
 </div>
 <div class="flex items-start gap-2 mt-3">
 <input type="checkbox"
 class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
 id="is_active"
 name="is_active"
 value="1"
 {% if not template or template.is_active %}checked{% endif %}>
 <label class="text-sm text-slate-700" for="is_active">
 <strong>Active</strong> - Enable this template for use
 </label>
 </div>
 </div>
 <!-- Form Actions -->
 <div class="flex gap-2 pt-3 border-t border-slate-200">
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
 <i class="mdi mdi-content-save mr-2"></i>
 {% if template %}
 Save Changes
 {% else %}
 Create Template
 {% endif %}
 </button>
 {% if template %}
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-sky-500 text-white hover:bg-sky-600"
 onclick="testSendTemplate()">
 <i class="mdi mdi-send-clock mr-2"></i>Test Send
 </button>
 {% endif %}
 <a href="/admin/notification-templates"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100 ms-auto">Cancel</a>
 </div>
 </div>
 </form>
 </div>
 <!-- Help Sidebar -->
 <div class="lg:col-span-4">
 <div class=" border border-slate-200 bg-white shadow-sm sticky-top ">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <strong><i class="mdi mdi-help-circle-outline mr-2"></i>Help & Guide</strong>
 </div>
 <div class="p-4 small">
 <div class="mb-3">
 <strong><i class="mdi mdi-tag mr-2"></i>Variables</strong>
 <p class="text-slate-500 mb-2">Use double braces with uppercase variable names:</p>
 <code class="block bg-slate-100 p-2 rounded mb-2">&#123;&#123; USER_NAME &#125;&#125;
 <br>
 &#123;&#123; EMAIL &#125;&#125;
 <br>
 &#123;&#123; AMOUNT &#125;&#125;</code>
 </div>
 <div class="mb-3">
 <strong><i class="mdi mdi-send-outline mr-2"></i>Channels</strong>
 <ul class="list-none pl-0 text-slate-500">
 <li>
 ðŸ“± <strong>In-App:</strong> Dashboard notifications
 </li>
 <li>
 ðŸ“² <strong>FCM:</strong> Mobile push
 </li>
 <li>
 âœ‰ï¸ <strong>Email:</strong> Email delivery
 </li>
 <li>
 ðŸ’¬ <strong>SMS:</strong> Text messages
 </li>
 </ul>
 </div>
 <div class="mb-3">
 <strong><i class="mdi mdi-palette mr-2"></i>Colors</strong>
 <p class="text-slate-500 mb-2">Use hex color codes:</p>
 <div class="flex gap-1">
 <span title="#0d6efd"></span>
 <span title="#198754"></span>
 <span title="#dc3545"></span>
 <span title="#ffc107"></span>
 </div>
 </div>
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200 py-2 mb-0">
 <small><i class="mdi mdi-lightbulb-outline mr-1"></i> Use the"Test Send" feature to preview your template before publishing.</small>
 </div>
 </div>
 </div>
 </div>
</div>
</div>
<script>
// Color picker sync
document.getElementById('color')?.addEventListener('change', function() {
 document.getElementById('colorText').value = this.value;
});

document.getElementById('colorText')?.addEventListener('input', function() {
 if (/^#[0-9A-F]{6}$/i.test(this.value)) {
 document.getElementById('color').value = this.value;
 }
});

// Live preview
function updatePreview() {
 const title = document.getElementById('title').value;
 const body = document.getElementById('body').value;
 document.getElementById('titlePreview').textContent = title || '(Type to preview)';
 document.getElementById('bodyPreview').textContent = (body.substring(0, 100)) + (body.length > 100 ? '...' : '') || '(Type to preview)';
}

document.getElementById('title')?.addEventListener('input', updatePreview);
document.getElementById('body')?.addEventListener('input', updatePreview);

// Variable management
function addVariable() {
 const list = document.getElementById('variablesList');
 const html = `<div class="input-group input-group-sm mb-2">
 <span class="inline-flex items-center">&#123;&#123;</span>
 <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" placeholder="Variable name" required>
 <span class="inline-flex items-center">&#125;&#125;</span>
 <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" placeholder="Description">
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-red-600 hover:bg-red-100" onclick="removeVariable(this)" aria-label="Remove variable">
 <i class="mdi mdi-delete"></i>
 </button>
 </div>`;
 list.insertAdjacentHTML('beforeend', html);
}

function removeVariable(inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition) {
 inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition.closest('.input-group')?.remove();
}

// Form submission
document.getElementById('templateForm')?.addEventListener('submit', async function(e) {
 e.preventDefault();

 const formData = new FormData(this);
 const url = `/admin/notification-templates{% if template %}/{{ template.id }}{% endif %}`;

 // Collect variables
 const variables = {};
 document.querySelectorAll('#variablesList .input-group').forEach(group => {
 const inputs = group.querySelectorAll('input');
 const name = inputs[1]?.value || '';
 if (name) {
 variables[name] = inputs[3]?.value || '';
 }
 });
 formData.set('variables', JSON.stringify(variables));

 // Collect channels
 const channels = [];
 document.querySelectorAll('input[name="channels"]:checked').forEach(cb => {
 channels.push(cb.value);
 });
 formData.set('channels', JSON.stringify(channels));

 try {
 const response = await fetch(url, { method: 'POST', body: formData });
 const data = await response.json();

 if (data.success) {
 Swal.fire('Success!', data.message, 'success').then(() => {
 if (data.redirect) {
 window.location.href = data.redirect;
 } else {
 history.back();
 }
 });
 } else {
 Swal.fire('Error', data.message || 'Failed to save', 'error');
 }
 } catch (e) {
 Swal.fire('Error', e.message, 'error');
 }
});

{% if template %}
function testSendTemplate() {
 const { value: userId } = Swal.fire({
 title: 'Test Send',
 input: 'number',
 inputLabel: 'User ID',
 inputPlaceholder: 'Enter user ID',
 showCancelButton: true,
 inputAttributes: { min: 1 }
 }).then(result => result.value);

 if (!userId) return;

 Swal.fire('Sending...', 'Please wait', 'info');

 const formData = new FormData();
 formData.append('user_id', userId);
 Array.from(document.querySelectorAll('input[name="channels"]:checked')).forEach(ch => {
 formData.append('channels[]', ch.value);
 });

 fetch('/admin/notification-templates/{{ template.id }}/test-send', { method: 'POST', body: formData })
 .then(r => r.json())
 .then(data => {
 if (data.success) {
 Swal.fire('Sent!', `Sent to ${data.details.sent} channel(s)`, 'success');
 } else {
 Swal.fire('Error', data.message, 'error');
 }
 })
 .catch(e => Swal.fire('Error', e.message, 'error'));
}
{% endif %}
</script>
{% endblock %}





