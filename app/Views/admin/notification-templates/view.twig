{% extends"admin/layout.twig" %}
{% block title %}{{ template.name }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <link href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css"
 rel="stylesheet">
 <div class="w-full px-4 sm:px-6 py-4">
 <!-- Header -->
 <div class=" mb-4">
 <div>
 {% if template.icon %}
 <i class="mdi mdi-{{ template.icon }}"></i>
 {% else %}
 <i class="mdi mdi-bell-outline"></i>
 {% endif %}
 {{ template.name }}
 </div>
 <div>Template Details & Configuration</div>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <!-- Main Content Column -->
 <div class="lg:col-span-8">
 <!-- Template Info Card -->
 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <strong><i class="mdi mdi-information-outline mr-2"></i>Template Information</strong>
 </div>
 <div class="p-4">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="md:col-span-6">
 <small class="text-slate-500 block mb-1">Slug</small>
 <code class="bg-slate-100 p-2 rounded block">{{ template.slug }}</code>
 </div>
 <div class="md:col-span-6">
 <small class="text-slate-500 block mb-1">Type</small>
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-600"><i class="mdi mdi-bell"></i> Notification Template</span>
 </div>
 </div>
 {% if template.description %}
 <div class="mb-3">
 <small class="text-slate-500 block mb-1">Description</small>
 <p class="mb-0">{{ template.description }}</p>
 </div>
 {% endif %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="md:col-span-6 mb-3">
 <small class="text-slate-500 block mb-1">Created</small>
 <span><i class="mdi mdi-calendar"></i> {{ template.created_at|date("M d, Y H:i") }}</span>
 </div>
 <div class="md:col-span-6 mb-3">
 <small class="text-slate-500 block mb-1">Created By</small>
 <span>
 {% if template.created_by %}
 System User #{{ template.created_by }}
 {% else %}
 System
 {% endif %}
 </span>
 </div>
 </div>
 {% if template.updated_at and template.updated_at != template.created_at %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="md:col-span-6">
 <small class="text-slate-500 block mb-1">Last Updated</small>
 <span><i class="mdi mdi-calendar-clock"></i> {{ template.updated_at|date("M d, Y H:i") }}</span>
 </div>
 <div class="md:col-span-6">
 <small class="text-slate-500 block mb-1">Updated By</small>
 <span>
 {% if template.updated_by %}
 User #{{ template.updated_by }}
 {% else %}
 -
 {% endif %}
 </span>
 </div>
 </div>
 {% endif %}
 </div>
 </div>
 <!-- Template Content Card -->
 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <strong><i class="mdi mdi-file-document-outline mr-2"></i>Content Preview</strong>
 </div>
 <div class="p-4">
 <div class="mb-4">
 <small class="text-slate-500 block mb-2"><strong>Title Template</strong></small>
 <div class="p-4 rounded-lg bg-neutral-50 text-neutral-600 border border-neutral-200 p-3">
 <strong>{{ template.title }}</strong>
 </div>
 </div>
 <div>
 <small class="text-slate-500 block mb-2"><strong>Message Body</strong></small>
 <div class="p-4 rounded-lg bg-neutral-50 text-neutral-600 border border-neutral-200 p-3 ">{{ template.body }}</div>
 </div>
 </div>
 </div>
 <!-- Configuration Card -->
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <strong><i class="mdi mdi-cogs-outline mr-2"></i>Configuration & Status</strong>
 </div>
 <div class="p-4">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="md:col-span-6">
 <small class="text-slate-500 block mb-2"><strong>Delivery Channels</strong></small>
 <div class="flex flex-wrap gap-2">
 {% set channels = template.channels is iterable ? template.channels : template.channels|json_decode %}
 {% for channel in channels %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-indigo-600">
 {% if channel == 'in_app' %}
 <i class="mdi mdi-bell"></i> In-App
 {% elseif channel == 'fcm' %}
 <i class="mdi mdi-mobile-alert"></i> FCM Push
 {% elseif channel == 'email' %}
 <i class="mdi mdi-email"></i> Email
 {% elseif channel == 'sms' %}
 <i class="mdi mdi-message-text"></i> SMS
 {% else %}
 {{ channel }}
 {% endif %}
 </span>
 {% endfor %}
 </div>
 </div>
 <div class="md:col-span-6">
 <small class="text-slate-500 block mb-2"><strong>Status</strong></small>
 <div>
 {% if template.is_active %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-emerald-600"><i class="mdi mdi-check-circle"></i> Active</span>
 {% else %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-600"><i class="mdi mdi-circle-outline"></i> Inactive</span>
 {% endif %}
 {% if template.deleted_at %}<span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-red-600"><i class="mdi mdi-trash-can"></i> Deleted</span>{% endif %}
 </div>
 </div>
 </div>
 {% if template.icon or template.color %}
 <hr class="my-3">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 {% if template.icon %}
 <div class="md:col-span-6">
 <small class="text-slate-500 block mb-2"><strong>Icon</strong></small>
 <div>
 <i class="mdi mdi-{{ template.icon }} mr-2 "></i>
 <code>mdi-{{ template.icon }}</code>
 </div>
 </div>
 {% endif %}
 {% if template.color %}
 <div class="md:col-span-6">
 <small class="text-slate-500 block mb-2"><strong>Color</strong></small>
 <div>
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold"
 style="background-color: {{ template.color }};
 padding: 8px 12px;
 font-size: 12px">{{ template.color }}</span>
 </div>
 </div>
 {% endif %}
 </div>
 {% endif %}
 </div>
 </div>
 </div>
 <!-- Sidebar -->
 <div class="lg:col-span-4">
 <!-- Variables Card -->
 <div class=" border border-slate-200 bg-white shadow-sm sticky-top mb-4 ">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <strong><i class="mdi mdi-tag-multiple mr-2"></i>Template Variables</strong>
 </div>
 <div class="p-4 small">
 {% set variables = template.variables is iterable ? template.variables : template.variables|json_decode %}
 {% if variables and variables|length > 0 %}
 <p class="text-slate-500 mb-3">Variables to provide when sending this notification:</p>
 <div class="list-group list-group-sm">
 {% for key, desc in variables %}
 <div class="list-group-item py-2">
 <code class="block mb-1">&#123;&#123; {{ key }} &#125;&#125;</code>
 {% if desc %}
 <small class="text-slate-500">{{ desc }}</small>
 {% else %}
 <small class="text-slate-500 text-slate-600">No description</small>
 {% endif %}
 </div>
 {% endfor %}
 </div>
 {% else %}
 <p class="text-slate-500 mb-0">No variables defined for this template.</p>
 {% endif %}
 </div>
 </div>
 <!-- Usage Example Card -->
 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <strong><i class="mdi mdi-code-braces mr-2"></i>Usage Example</strong>
 </div>
 <div class="p-4 p-0">
 <pre class="mb-0 "><code>&lt;?php
 \$result = sendTemplateNotification(
 '{{ template.slug }}',
 \$userId,
 [
 {% for key in (template.variables is iterable ? template.variables : template.variables|json_decode)|keys %}
 '{{ key }}' => 'value',
 {% endfor %}
 ],
 ['in_app','fcm','email']
 );
 ?&gt;</code></pre>
 </div>
 </div>
 <!-- Actions Card -->
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <strong><i class="mdi mdi-tools mr-2"></i>Actions</strong>
 </div>
 <div class="p-4">
 <a href="/admin/notification-templates/{{ template.id }}/edit"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 w-full mb-2">
 <i class="mdi mdi-pencil mr-2"></i>Edit Template
 </a>
 <a href="/admin/notification-templates"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100 w-full">
 <i class="mdi mdi-arrow-left mr-2"></i>Back to List
 </a>
 </div>
 </div>
 </div>
 </div>
 </div>
{% endblock %}




