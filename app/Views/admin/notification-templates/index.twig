{% extends"admin/layout.twig" %}
{% block title %}{{ title }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="space-y-6">
 <section class="admin-page-header">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-bell-ring"></i>
     Notification Templates
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Manage notification templates</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600">Maintain reusable templates for multi-channel delivery.</p>
   </div>
   <a href="/admin/notification-templates/create" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
    <i class="lucide lucide-plus-circle"></i>
    Create Template
   </a>
  </div>
 </section>

 <section class="admin-panel-card">
  <form class="grid gap-4 lg:grid-cols-12" method="get">
   <div class="lg:col-span-6">
    <label class="form-label" for="searchTemplates">Search Templates</label>
    <div class="flex overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
     <span class="inline-flex items-center border-r border-slate-200 bg-slate-50 px-3 text-slate-400"><i class="lucide lucide-search"></i></span>
     <input type="text" class="w-full border-0 px-4 py-3 text-sm shadow-none focus:ring-0" placeholder="Search by name or slug..." id="searchTemplates" name="search" value="{{ request.get.search|default('') }}">
    </div>
   </div>
   <div class="lg:col-span-3">
    <label class="form-label">Show Per Page</label>
    <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" onchange="location.href='?limit=' + this.value">
     <option value="10" {% if request.get.limit == 10 %}selected{% endif %}>10 per page</option>
     <option value="20" {% if request.get.limit == 20 %}selected{% endif %}>20 per page</option>
     <option value="50" {% if request.get.limit == 50 %}selected{% endif %}>50 per page</option>
    </select>
   </div>
   <div class="lg:col-span-3 flex items-end">
    <a href="/admin/notification-templates/create" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
     <i class="lucide lucide-plus"></i>Create Template
    </a>
   </div>
  </form>
 </section>

 <section class="admin-panel-card">
  <div class="flex items-center justify-between border-b border-slate-200/80 pb-4">
   <div>
    <h2 class="text-lg font-semibold text-slate-950">Notification Templates</h2>
    <p class="mt-1 text-sm text-slate-500">{{ pagination.total }} total templates.</p>
   </div>
  </div>

  <div class="table-responsive mt-5">
   <table class="table">
    <thead>
     <tr>
      <th width="5%">ID</th>
      <th width="20%">Name</th>
      <th width="15%">Slug</th>
      <th width="20%">Channels</th>
      <th width="10%">Status</th>
      <th width="20%">Actions</th>
      <th width="10%">Created</th>
     </tr>
    </thead>
    <tbody>
     {% if templates %}
     {% for template in templates %}
     <tr>
      <td data-label="ID"><small class="text-slate-500">#{{ template.id }}</small></td>
      <td data-label="Name">
       <strong class="block text-slate-900">{{ template.name }}</strong>
       {% if template.description %}<small class="mt-1 block text-slate-500">{{ template.description|truncate(50) }}</small>{% endif %}
      </td>
      <td data-label="Slug"><code class="rounded-lg bg-slate-100 px-2 py-1 text-xs text-slate-600">{{ template.slug }}</code></td>
      <td data-label="Channels">
       {% set channels = template.channels is iterable ? template.channels : template.channels|json_decode %}
       <div class="flex flex-wrap gap-1.5">
        {% for channel in channels %}
        <span class="inline-flex items-center rounded-full bg-sky-100 px-2 py-0.5 text-xs font-semibold text-sky-700">
         {% if channel == 'in_app' %}
          <i class="lucide lucide-bell mr-1"></i> In-App
         {% elseif channel == 'fcm' %}
          <i class="lucide lucide-smartphone mr-1"></i> FCM
         {% elseif channel == 'email' %}
          <i class="lucide lucide-mail mr-1"></i> Email
         {% elseif channel == 'sms' %}
          <i class="lucide lucide-message-square mr-1"></i> SMS
         {% else %}
          {{ channel }}
         {% endif %}
        </span>
        {% endfor %}
       </div>
      </td>
      <td data-label="Status">
       {% if template.is_active %}
        <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700"><i class="lucide lucide-check-circle mr-1"></i> Active</span>
       {% else %}
        <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700"><i class="lucide lucide-circle-dot mr-1"></i> Inactive</span>
       {% endif %}
      </td>
      <td data-label="Actions">
       <div class="flex flex-wrap gap-2">
        <a href="/admin/notification-templates/{{ template.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" title="View"><i class="lucide lucide-eye"></i></a>
        <a href="/admin/notification-templates/{{ template.id }}/edit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-indigo-700" title="Edit"><i class="lucide lucide-pencil"></i></a>
        <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-rose-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-rose-700" title="Delete" onclick="deleteTemplate({{ template.id }})" aria-label="Delete template"><i class="lucide lucide-trash-2"></i></button>
       </div>
      </td>
      <td data-label="Created"><small class="text-slate-500">{{ template.created_at|date("M d, Y") }}</small></td>
     </tr>
     {% endfor %}
     {% else %}
     <tr>
      <td colspan="7" class="py-8 text-center text-slate-500">
       <i class="lucide lucide-inbox text-3xl"></i>
       <p class="mt-3">No templates found. <a href="/admin/notification-templates/create" class="text-indigo-600 hover:underline">Create one now</a></p>
      </td>
     </tr>
     {% endif %}
    </tbody>
   </table>
  </div>

  {% if pagination.pages > 1 %}
  <nav class="mt-4" aria-label="Page navigation">
   <ul class="pagination justify-center">
    {% if pagination.offset > 0 %}
    <li class="page-item"><a class="page-link" href="?offset=0&limit={{ pagination.limit }}">First</a></li>
    {% endif %}
    {% for i in 0..(pagination.pages - 1) %}
    {% if loop.index0 * pagination.limit >= pagination.offset - (pagination.limit * 2) and loop.index0 * pagination.limit <= pagination.offset + (pagination.limit * 2) %}
    <li class="page-item {% if loop.index0 * pagination.limit == pagination.offset %}active{% endif %}">
     <a class="page-link" href="?offset={{ loop.index0 * pagination.limit }}&limit={{ pagination.limit }}">{{ loop.index }}</a>
    </li>
    {% endif %}
    {% endfor %}
    {% if pagination.offset + pagination.limit < pagination.total %}
    <li class="page-item"><a class="page-link" href="?offset={{ (pagination.pages - 1) * pagination.limit }}&limit={{ pagination.limit }}">Last</a></li>
    {% endif %}
   </ul>
  </nav>
  {% endif %}
 </section>
</div>
<script>
function deleteTemplate(id) {
 Swal.fire({
  title: 'Delete Template?',
  text: 'This action can be undone from the admin panel.',
  icon: 'warning',
  showCancelButton: true,
  confirmButtonText: 'Yes, Delete',
  cancelButtonText: 'Cancel',
  confirmButtonColor: '#dc3545'
 }).then(result => {
  if (!result.isConfirmed) return;

  fetch(`/admin/notification-templates/${id}`, {
   method: 'DELETE',
   headers: { 'Content-Type': 'application/json' }
  })
   .then(r => r.json())
   .then(data => {
    if (data.success) {
     Swal.fire('Deleted!', 'Template deleted successfully.', 'success').then(() => location.reload());
    } else {
     Swal.fire('Error', data.message || 'Failed to delete template.', 'error');
    }
   })
   .catch(e => Swal.fire('Error', e.message, 'error'));
 });
}

document.getElementById('searchTemplates')?.addEventListener('input', function(e) {
 const searchText = e.target.value.toLowerCase();
 document.querySelectorAll('.notification-templates-table tbody tr').forEach((row) => {
  const name = row.querySelector('td:nth-child(2)')?.textContent.toLowerCase() || '';
  const slug = row.querySelector('td:nth-child(3)')?.textContent.toLowerCase() || '';
  row.style.display = (name.includes(searchText) || slug.includes(searchText)) ? '' : 'none';
 });
});
</script>
{% endblock %}
