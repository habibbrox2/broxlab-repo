{% extends"admin/layout.twig" %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4" data-email-template-list="true">
 <!-- Page Header -->
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-mail mr-2"></i>
 Email Templates
 </div>
 <div>Manage email notification templates</div>
 </div>
 {% if templates|length > 0 %}
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class="p-4 p-0">
 <div class="overflow-x-auto">
 <table class="table table-stacked table-hover mb-0">
 <thead class="table-light">
 <tr>
 <th>Name</th>
 <th>Slug</th>
 <th>Description</th>
 <th>Status</th>
 <th>Last Updated</th>
 <th>Actions</th>
 </tr>
 </thead>
 <tbody>
 {% for template in templates %}
 <tr>
 <td data-label="Name">
 <strong>{{ template.name }}</strong>
 </td>
 <td data-label="Slug">
 <code class="bg-slate-100">{{ template.slug }}</code>
 </td>
 <td data-label="Description">
 <small class="text-slate-500">{{ template.description|default("N/A") |truncate(50) }}</small>
 </td>
 <td data-label="Status">
 {% if template.is_active %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-emerald-600">Active</span>
 {% else %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-600">Inactive</span>
 {% endif %}
 </td>
 <td data-label="Last Updated">
 <small class="text-slate-500">{{ template.updated_at|date("M d, Y H:i") }}</small>
 </td>
 <td data-label="Actions">
 <a href="{{ admin_dir }}/email-templates/{{ template.id }}/edit"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs bg-indigo-600 text-white hover:bg-indigo-700">
 <i class="lucide lucide-pencil"></i> Edit
 </a>
 {% if template.slug not in ['welcome_email', 'email_verification', 'password_reset'] %}
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs bg-red-600 text-white hover:bg-red-700"
 onclick="deleteTemplate({{ template.id }}, '{{ template.name }}')">
 <i class="lucide lucide-trash-2"></i> Delete
 </button>
 {% endif %}
 </td>
 </tr>
 {% endfor %}
 </tbody>
 </table>
 </div>
 </div>
 </div>
 {% else %}
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200">
 <i class="lucide lucide-info"></i> No email templates found.
 </div>
 {% endif %}
 </div>
{% endblock %}





