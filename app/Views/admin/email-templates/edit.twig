{% extends"admin/layout.twig" %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="w-full px-4 sm:px-6 mt-4">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
 <div class="md:col-span-8">
 <h1 class="h3 inline-block">Edit Email Template</h1>
 <p class="text-slate-500">
 {{ template.name }} <code class="bg-slate-100">{{ template.slug }}</code>
 </p>
 </div>
 <div class="md:col-span-4 text-right">
 <a href="{{ admin_dir }}/email-templates"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100">
 <i class="lucide lucide-arrow-left"></i> Back
 </a>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-sky-500 text-white hover:bg-sky-600"
 id="previewBtn"
 data-brox-toggle="modal"
 data-brox-target="#previewModal">
 <i class="lucide lucide-eye"></i> Preview Template
 </button>
 </div>
 </div>
 <form method="POST"
 action="{{ admin_dir }}/email-templates/{{ template.id }}"
 id="emailTemplateForm"
 data-template-id="{{ template.id }}">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="lg:col-span-8">
 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class=" border-slate-200 px-4 py-3">
 <h5 class="mb-0">Template Content</h5>
 </div>
 <div class="p-4">
 <div class="mb-3">
 <label for="subject" class="form-label">Email Subject *</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="subject"
 name="subject"
 value="{{ template.subject }}"
 required>  <small class="text-xs text-neutral-400">You can use variables like {{'{{'}}VARIABLE{{'}}'}}</small>
 </div>
 <div class="mb-3">
 <label for="body" class="form-label">Email Body *</label>
 <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 html-editor"
 id="body"
 name="body"
 rows="20"
 required>{{ template.body }}</textarea>  <small class="text-xs text-neutral-400">Supports HTML. Use {{'{{'}}VARIABLE{{'}}'}} for dynamic content.</small>
 </div>
 <div class="mb-3">
 <label for="description" class="form-label">Description</label>
 <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="description"
 name="description"
 rows="3"
 placeholder="Template purpose and notes">{{ template.description|default('') }}</textarea>
 </div>
 </div>
 </div>
 </div>
 <div class="lg:col-span-4">
 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class=" border-slate-200 px-4 py-3">
 <h5 class="mb-0">Settings</h5>
 </div>
 <div class="p-4">
 <div class="flex items-start gap-2 form-switch mb-3">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
 type="checkbox"
 id="is_active"
 name="is_active"
 {% if template.is_active %}checked{% endif %}>
 <label class="text-sm text-slate-700" for="is_active">Active</label>
 </div>
 <hr>
 <h6 class="mb-3">Template Variables</h6>
 {% if variables|length > 0 %}
 <div class="list-group list-group-sm">
 {% for var, val in variables %}
 <div class="list-group-item flex justify-between items-center">
 <code>{{'{{'}}{{ var }}{{'}}'}}</code>
 <small class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-600">Dynamic</small>
 </div>
 {% endfor %}
 </div>
 {% else %}
 <p class="text-slate-500 small mb-0">No variables detected in template.</p>
 {% endif %}
 <div class="mt-3 p-3 bg-slate-100 rounded small">
 <strong>Usage Tips:</strong>
 <ul class="mb-0 mt-2">
 <li>Add {{'{{'}}VARIABLE{{'}}'}} to your template content</li>
 <li>Variables are replaced with actual values when sending</li>
 <li>Use descriptive variable names in UPPERCASE</li>
 </ul>
 </div>
 </div>
 </div>
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3">
 <h5 class="mb-0">Info</h5>
 </div>
 <div class="p-4 small">
 <div class="mb-2">
 <strong>Created:</strong>
 <br>
 <small class="text-slate-500">{{ template.created_at|date("M d, Y H:i") }}</small>
 </div>
 <div class="mb-2">
 <strong>Last Updated:</strong>
 <br>
 <small class="text-slate-500">{{ template.updated_at|date("M d, Y H:i") }}</small>
 </div>
 </div>
 </div>
 </div>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mt-4">
 <div class="col">
 <a href="{{ admin_dir }}/email-templates"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100">
 <i class="lucide lucide-x"></i> Cancel
 </a>
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
 <i class="lucide lucide-check"></i> Save Changes
 </button>
 </div>
 </div>
 </form>
 </div>
 <!-- Preview Modal -->
 <div class="modal fade" id="previewModal" tabindex="-1">
 <div class="modal-dialog modal-xl modal-dialog-scrollable">
 <div class="modal-content">
 <div class="modal-header">
 <h5 class="modal-title">Template Preview</h5>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition" data-brox-dismiss="modal"></button>
 </div>
 <div class="modal-body">
 <div class="mb-3">
 <label class="form-label">
 <strong>Subject:</strong>
 </label>
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200" id="previewSubject">Loading...</div>
 </div>
 <hr>
 <div class="mb-3">
 <label class="form-label">
 <strong>Email Body:</strong>
 </label>
 <div class="border rounded p-3 bg-slate-100 " id="previewBody">Loading...</div>
 </div>
 </div>
 <div class="modal-footer">
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200" data-brox-dismiss="modal">Close</button>
 </div>
 </div>
 </div>
 </div>
{% endblock %}




