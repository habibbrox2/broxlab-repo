{% extends "admin/layout.twig" %}

{% block title %}Incoming Scrapes - {{ parent() }}{% endblock %}

{% block content %}
<style>
  .incoming-shell {
    --incoming-ink: #0f172a;
    --incoming-muted: #64748b;
    --incoming-line: #e2e8f0;
    --incoming-soft: #f8fafc;
    --incoming-accent: #0f766e;
    --incoming-accent-soft: #ccfbf1;
  }
  .incoming-shell .incoming-hero {
    border: 1px solid var(--incoming-line);
    border-radius: 1rem;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    padding: 1.25rem 1.35rem;
    margin-bottom: 1rem;
  }
  .incoming-shell .incoming-hero h1 {
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--incoming-ink);
    margin-bottom: 0.35rem;
  }
  .incoming-shell .incoming-hero p {
    color: var(--incoming-muted);
    margin: 0;
  }
  .incoming-shell .incoming-stat {
    border: 1px solid var(--incoming-line);
    border-radius: 0.9rem;
    background: #fff;
    height: 100%;
  }
  .incoming-shell .incoming-stat .card-body {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .incoming-shell .incoming-stat-icon {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.7rem;
    background: var(--incoming-accent-soft);
    color: var(--incoming-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  .incoming-shell .incoming-stat-value {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--incoming-ink);
    line-height: 1.1;
  }
  .incoming-shell .incoming-stat-label {
    color: var(--incoming-muted);
    font-size: 0.8rem;
  }
  .incoming-shell .incoming-filter-card,
  .incoming-shell .incoming-item-card {
    border: 1px solid var(--incoming-line);
    border-radius: 0.95rem;
  }
  .incoming-shell .incoming-filter-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--incoming-ink);
  }
  .incoming-shell .incoming-item-card .card-body {
    padding: 1rem 1.05rem;
  }
  .incoming-shell .incoming-thumb {
    aspect-ratio: 4 / 3;
    border-radius: 0.8rem;
    overflow: hidden;
    background: #f1f5f9;
    border: 1px solid var(--incoming-line);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .incoming-shell .incoming-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .incoming-shell .incoming-thumb-fallback {
    font-size: 0.8rem;
    color: var(--incoming-muted);
    text-align: center;
    padding: 0.75rem;
  }
  .incoming-shell .incoming-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .incoming-shell .incoming-pill-articles {
    background: #dcfce7;
    color: #166534;
  }
  .incoming-shell .incoming-pill-mobiles {
    background: #dbeafe;
    color: #1d4ed8;
  }
  .incoming-shell .incoming-title {
    color: var(--incoming-ink);
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }
  .incoming-shell .incoming-meta {
    color: var(--incoming-muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }
  .incoming-shell .incoming-summary {
    color: #334155;
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .incoming-shell .incoming-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .incoming-shell .incoming-tag {
    background: #e2e8f0;
    color: #1e293b;
    font-size: 0.74rem;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    font-weight: 700;
  }
  .incoming-shell .incoming-side {
    border-left: 1px solid var(--incoming-line);
    padding-left: 1rem;
    height: 100%;
  }
  .incoming-shell .incoming-side-label {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--incoming-muted);
    margin-bottom: 0.1rem;
  }
  .incoming-shell .incoming-side-value {
    font-weight: 700;
    color: var(--incoming-ink);
    word-break: break-word;
  }
  .incoming-shell .incoming-checkbox {
    width: 20px;
    height: 20px;
    cursor: pointer;
    margin-right: 0.5rem;
  }
  .incoming-shell .bulk-actions-bar {
    background: #f0f9ff;
    border: 1px solid #0ea5e9;
    border-radius: 0.95rem;
    padding: 1rem;
    margin-bottom: 1rem;
    display: none;
  }
  .incoming-shell .bulk-actions-bar.show {
    display: block;
  }
  .incoming-shell .bulk-actions-bar .selected-count {
    font-weight: 700;
    color: #0284c7;
  }
  .incoming-shell .item-row.selected {
    background: #f0f9ff;
    border: 2px solid #0ea5e9;
  }
  @media (max-width: 767.98px) {
    .incoming-shell .incoming-hero {
      padding: 1rem;
    }
    .incoming-shell .incoming-hero h1 {
      font-size: 1.3rem;
    }
    .incoming-shell .incoming-side {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--incoming-line);
      padding-top: 0.85rem;
      margin-top: 0.85rem;
    }
  }
</style>

{% set incoming_total = scraping_stats.total|default(scraping_stats.total_items|default(total)) %}

<div class="incoming-shell">
  <div class="incoming-hero">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
      <div>
        <h1>Incoming Scrapes</h1>
        <p>Queued records from `push_incoming_items` before or after publish processing.</p>
      </div>
      <a class="btn btn-outline-secondary btn-sm" href="/admin/scrap-control-center">Back to Control Center</a>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-lg-3 col-6">
      <div class="card incoming-stat">
        <div class="card-body">
          <span class="incoming-stat-icon"><i class="bi bi-box-seam"></i></span>
          <div>
            <div class="incoming-stat-value">{{ incoming_total }}</div>
            <div class="incoming-stat-label">Total Items</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-6">
      <div class="card incoming-stat">
        <div class="card-body">
          <span class="incoming-stat-icon"><i class="bi bi-file-earmark-text"></i></span>
          <div>
            <div class="incoming-stat-value">{{ scraping_stats.pending|default(0) }}</div>
            <div class="incoming-stat-label">Pending</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-6">
      <div class="card incoming-stat">
        <div class="card-body">
          <span class="incoming-stat-icon"><i class="bi bi-phone"></i></span>
          <div>
            <div class="incoming-stat-value">{{ scraping_stats.published|default(0) }}</div>
            <div class="incoming-stat-label">Published</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-6">
      <div class="card incoming-stat">
        <div class="card-body">
          <span class="incoming-stat-icon"><i class="bi bi-clock-history"></i></span>
          <div>
            <div class="incoming-stat-value">{{ scraping_stats.failed|default(0) }}</div>
            <div class="incoming-stat-label">Failed</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card" style="border: 1px solid #e2e8f0; border-radius: 0.95rem; margin-bottom: 1rem;">
    <div class="card-body">
      <div style="font-weight: 700; color: #0f172a; margin-bottom: 0.75rem;">Quick Navigation</div>
      <div class="row g-2">
        <div class="col-md-3">
          <a href="/admin/scrap-control-center/all-pipeline-logs" class="btn btn-outline-info btn-sm w-100">
            <i class="bi bi-file-text"></i> All Logs
          </a>
        </div>
        <div class="col-md-3">
          <a href="/admin/scrap-control-center/pipeline-runs" class="btn btn-outline-primary btn-sm w-100">
            <i class="bi bi-play-circle"></i> Pipeline Runs
          </a>
        </div>
        <div class="col-md-3">
          <a href="/admin/scrap-control-center/failed-pipeline-logs" class="btn btn-outline-danger btn-sm w-100">
            <i class="bi bi-exclamation-circle"></i> Failed Logs
          </a>
        </div>
        <div class="col-md-3">
          <a href="/admin/scrap-control-center/incoming" class="btn btn-success btn-sm w-100" style="pointer-events: none;">
            <i class="bi bi-inbox"></i> Incoming Items
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="card incoming-filter-card mb-4">
    <div class="card-body">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
          <div class="incoming-filter-title">Filters</div>
          <div class="text-muted small">Focus the queue by content type or page size.</div>
        </div>
      </div>

      <form method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label">Type</label>
          <select name="type" class="form-control">
            <option value="">All</option>
            <option value="articles" {{ type_filter == 'articles' ? 'selected' }}>Articles</option>
            <option value="mobiles" {{ type_filter == 'mobiles' ? 'selected' }}>Mobiles</option>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">Status</label>
          <select name="status" class="form-control">
            <option value="">All</option>
            <option value="pending" {{ status_filter == 'pending' ? 'selected' }}>Pending</option>
            <option value="published" {{ status_filter == 'published' ? 'selected' }}>Published</option>
            <option value="failed" {{ status_filter == 'failed' ? 'selected' }}>Failed</option>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">Per Page</label>
          <select name="limit" class="form-control">
            {% for l in [12, 24, 50, 100] %}
              <option value="{{ l }}" {{ limit == l ? 'selected' }}>{{ l }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-1">
          <button class="btn btn-primary w-100" type="submit">Apply Filters</button>
        </div>
        <div class="col-md-1">
          <a class="btn btn-outline-secondary w-100" href="/admin/scrap-control-center/incoming">Reset</a>
        </div>
      </form>
    </div>
  </div>

  {% if items|length > 0 %}
    <div class="bulk-actions-bar" id="bulkActionsBar">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <label class="form-check-label">
            <input type="checkbox" id="selectAllCheckbox" class="incoming-checkbox form-check-input">
            <span class="selected-count"><span id="selectedCount">0</span> items selected</span>
          </label>
        </div>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-sm btn-outline-danger" id="bulkDeleteBtn" disabled>
            <i class="bi bi-trash"></i> Delete Selected
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="cancelBulkBtn">
            Cancel
          </button>
        </div>
      </div>
    </div>
    <div class="row g-3">
      {% for item in items %}
        <div class="col-12 item-row" data-item-id="{{ item.id }}" data-item-type="{{ item.display_type }}">
          <div class="card incoming-item-card">
            <div class="card-body">
              <div class="row g-3 align-items-stretch">
                <div class="col-md-1 d-flex align-items-center justify-content-center" style="min-height: 150px;">
                  <input type="checkbox" class="incoming-checkbox form-check-input item-checkbox" data-item-id="{{ item.id }}">
                </div>
                <div class="col-md-1 col-lg-1">
                  <div class="incoming-thumb h-100">
                    {% if item.image_src %}
                      <img src="{{ item.image_src }}" alt="{{ item.title_text|default('Incoming item') }}">
                    {% else %}
                      <div class="incoming-thumb-fallback">
                        <i class="bi bi-image d-block fs-4 mb-1"></i>
                        No image
                      </div>
                    {% endif %}
                  </div>
                </div>
                <div class="col-md-6 col-lg-7">
                  <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="incoming-pill {{ item.display_type == 'mobiles' ? 'incoming-pill-mobiles' : 'incoming-pill-articles' }}">
                      <i class="bi {{ item.display_type == 'mobiles' ? 'bi-phone' : 'bi-file-earmark-text' }}"></i>
                      {{ item.display_type_label|default(item.data_type|default('Item')) }}
                    </span>
                    {% if item.category %}
                      <span class="badge text-bg-light border">{{ item.category }}</span>
                    {% endif %}
                    {% if item.brand %}
                      <span class="badge text-bg-light border">{{ item.brand }}</span>
                    {% endif %}
                  </div>

                  <div class="incoming-title">
                    {{ item.title_text|default(item.title|default('Untitled item')) }}
                  </div>

                  <div class="incoming-meta mb-2">
                    <div>
                      <strong>Source:</strong> {{ item.source|default('-') }}
                      {% if item.source_url %}
                        <span class="text-muted">•</span>
                        <a href="{{ item.source_url }}" target="_blank" rel="noopener">Open source</a>
                      {% endif %}
                    </div>
                    <div>
                      <strong>Received:</strong> {{ item.received_at|default('-') }}
                      {% if item.publish_status %}
                        <span class="text-muted">•</span>
                        <strong>Status:</strong> {{ item.publish_status }}
                      {% endif %}
                      {% if item.scraped_at %}
                        <span class="text-muted">•</span>
                        <strong>Scraped:</strong> {{ item.scraped_at }}
                      {% endif %}
                    </div>
                  </div>

                  <div class="incoming-summary mb-3">
                    {{ item.summary_text|default(item.excerpt|default('No summary available.'))|slice(0, 240) }}
                  </div>

                  {% if item.tags is defined and item.tags|length > 0 %}
                    <div class="incoming-tags">
                      {% for tag in item.tags|slice(0, 6) %}
                        <span class="incoming-tag">{{ tag }}</span>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>

                <div class="col-md-3 col-lg-2">
                  <div class="incoming-side">
                    {% if item.author %}
                      <div class="mb-2">
                        <div class="incoming-side-label">Author</div>
                        <div class="incoming-side-value">{{ item.author }}</div>
                      </div>
                    {% endif %}
                    {% if item.price_text %}
                      <div class="mb-2">
                        <div class="incoming-side-label">Price</div>
                        <div class="incoming-side-value">{{ item.price_text }}</div>
                      </div>
                    {% endif %}
                    {% if item.status_text %}
                      <div class="mb-2">
                        <div class="incoming-side-label">Status</div>
                        <div class="incoming-side-value">{{ item.status_text }}</div>
                      </div>
                    {% endif %}
                    {% if item.model %}
                      <div class="mb-2">
                        <div class="incoming-side-label">Model</div>
                        <div class="incoming-side-value">{{ item.model }}</div>
                      </div>
                    {% endif %}
                    <div class="d-grid gap-2 mt-3">
                      <a class="btn btn-primary btn-sm" href="/admin/scrap-control-center/incoming/{{ item.display_type }}/{{ item.id }}">View Details</a>
                      <button class="btn btn-outline-danger btn-sm delete-incoming-item" data-item-id="{{ item.id }}" data-item-type="{{ item.display_type }}" data-item-title="{{ item.title_text|default(item.title|default('Untitled item'))|slice(0, 30) }}">Delete Item</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if total_pages > 1 %}
      <nav aria-label="incoming pagination">
        <ul class="pagination justify-content-center mt-4">
          {% if current_page_number > 1 %}
            <li class="page-item">
              <a class="page-link" href="?page={{ current_page_number - 1 }}&type={{ type_filter }}&limit={{ limit }}">&laquo;</a>
            </li>
          {% endif %}
          {% for p in 1..total_pages %}
            {% if p == current_page_number or p == 1 or p == total_pages or (p >= current_page_number - 2 and p <= current_page_number + 2) %}
              <li class="page-item {{ p == current_page_number ? 'active' }}">
                <a class="page-link" href="?page={{ p }}&type={{ type_filter }}&limit={{ limit }}">{{ p }}</a>
              </li>
            {% endif %}
          {% endfor %}
          {% if current_page_number < total_pages %}
            <li class="page-item">
              <a class="page-link" href="?page={{ current_page_number + 1 }}&type={{ type_filter }}&limit={{ limit }}">&raquo;</a>
            </li>
          {% endif %}
        </ul>
      </nav>
    {% endif %}
  {% else %}
    <div class="card border-0 shadow-sm">
      <div class="card-body py-5 text-center">
        <div class="text-muted">No incoming items found.</div>
      </div>
    </div>
  {% endif %}
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const bulkActionsBar = document.getElementById("bulkActionsBar");
    const selectAllCheckbox = document.getElementById("selectAllCheckbox");
    const bulkDeleteBtn = document.getElementById("bulkDeleteBtn");
    const cancelBulkBtn = document.getElementById("cancelBulkBtn");
    const selectedCountSpan = document.getElementById("selectedCount");
    const itemCheckboxes = document.querySelectorAll(".item-checkbox");
    const itemRows = document.querySelectorAll(".item-row");
    
    // Update bulk actions bar visibility and button states
    function updateBulkActionsBar() {
        const selectedItems = Array.from(itemCheckboxes).filter(cb => cb.checked);
        const selectedCount = selectedItems.length;
        
        if (selectedCount > 0) {
            bulkActionsBar.classList.add("show");
            selectedCountSpan.textContent = selectedCount;
            bulkDeleteBtn.disabled = false;
        } else {
            bulkActionsBar.classList.remove("show");
            selectedCountSpan.textContent = "0";
            bulkDeleteBtn.disabled = true;
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = false;
        }
        
        // Update row highlight
        itemRows.forEach(row => {
            const checkbox = row.querySelector(".item-checkbox");
            if (checkbox && checkbox.checked) {
                row.classList.add("selected");
            } else {
                row.classList.remove("selected");
            }
        });
    }
    
    // Handle individual checkbox changes
    itemCheckboxes.forEach(checkbox => {
        checkbox.addEventListener("change", function() {
            updateBulkActionsBar();
            updateSelectAllCheckbox();
        });
    });
    
    // Update select-all checkbox state
    function updateSelectAllCheckbox() {
        const totalCheckboxes = itemCheckboxes.length;
        const checkedCheckboxes = Array.from(itemCheckboxes).filter(cb => cb.checked).length;
        
        if (checkedCheckboxes === 0) {
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = false;
        } else if (checkedCheckboxes === totalCheckboxes) {
            selectAllCheckbox.checked = true;
            selectAllCheckbox.indeterminate = false;
        } else {
            selectAllCheckbox.indeterminate = true;
        }
    }
    
    // Handle select-all checkbox
    selectAllCheckbox.addEventListener("change", function() {
        itemCheckboxes.forEach(checkbox => {
            checkbox.checked = this.checked;
        });
        updateBulkActionsBar();
    });
    
    // Handle bulk delete
    bulkDeleteBtn.addEventListener("click", function() {
        const selectedItems = Array.from(itemCheckboxes)
            .filter(cb => cb.checked)
            .map(cb => ({
                id: cb.getAttribute("data-item-id"),
                type: cb.closest(".item-row").getAttribute("data-item-type")
            }));
        
        if (selectedItems.length === 0) return;
        
        const itemText = selectedItems.length === 1 ? "1 item" : selectedItems.length + " items";
        if (!confirm(`Are you sure you want to delete ${itemText}?\n\nThis action cannot be undone.`)) {
            return;
        }
        
        bulkDeleteBtn.disabled = true;
        bulkDeleteBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Deleting...';
        
        // Delete items sequentially
        let completed = 0;
        selectedItems.forEach(item => {
            fetch(`/admin/api/scrap-control-center/incoming/delete/${item.id}`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                },
                body: JSON.stringify({
                    _csrf: document.querySelector("meta[name=\"csrf-token\"]")?.getAttribute("content") || ""
                })
            })
            .then(response => response.json())
            .then(data => {
                completed++;
                if (data.ok) {
                    const row = document.querySelector(`.item-row[data-item-id="${item.id}"]`);
                    if (row) {
                        row.closest(".col-12").remove();
                    }
                }
                
                if (completed === selectedItems.length) {
                    updateBulkActionsBar();
                    bulkDeleteBtn.innerHTML = '<i class="bi bi-trash"></i> Delete Selected';
                    showAlert(`${completed} item(s) deleted successfully`, "success");
                }
            })
            .catch(error => {
                completed++;
                if (completed === selectedItems.length) {
                    bulkDeleteBtn.disabled = false;
                    bulkDeleteBtn.innerHTML = '<i class="bi bi-trash"></i> Delete Selected';
                    showAlert("Some items failed to delete", "danger");
                    console.error("Bulk delete error:", error);
                }
            });
        });
    });
    
    // Handle cancel bulk actions
    cancelBulkBtn.addEventListener("click", function() {
        itemCheckboxes.forEach(checkbox => {
            checkbox.checked = false;
        });
        updateBulkActionsBar();
    });
    
    // Handle delete individual item buttons
    document.querySelectorAll(".delete-incoming-item").forEach(button => {
        button.addEventListener("click", function() {
            const itemId = this.getAttribute("data-item-id");
            const itemType = this.getAttribute("data-item-type");
            const itemTitle = this.getAttribute("data-item-title");
            
            if (confirm(`Are you sure you want to delete this ${itemType} item?\n\n"${itemTitle}"\n\nThis action cannot be undone.`)) {
                // Show loading state
                this.disabled = true;
                this.innerHTML = "<i class=\"bi bi-hourglass-split\"></i> Deleting...";
                
                // Make the delete request
                fetch(`/admin/api/scrap-control-center/incoming/delete/${itemId}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body: JSON.stringify({
                        _csrf: document.querySelector("meta[name=\"csrf-token\"]")?.getAttribute("content") || ""
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.ok) {
                        // Remove the item card from the page
                        this.closest(".col-12").remove();
                        
                        // Update stats if available
                        const totalElement = document.querySelector(".incoming-stat-value");
                        if (totalElement) {
                            const currentTotal = parseInt(totalElement.textContent) || 0;
                            totalElement.textContent = Math.max(0, currentTotal - 1);
                        }
                        
                        // Show success message
                        showAlert("Item deleted successfully", "success");
                    } else {
                        this.disabled = false;
                        this.innerHTML = "Delete Item";
                        showAlert(data.error || "Failed to delete item", "danger");
                    }
                })
                .catch(error => {
                    this.disabled = false;
                    this.innerHTML = "Delete Item";
                    showAlert("Network error occurred", "danger");
                    console.error("Delete error:", error);
                });
            }
        });
    });
    
    function showAlert(message, type) {
        // Create alert element
        const alertDiv = document.createElement("div");
        alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
        alertDiv.style.cssText = "top: 20px; right: 20px; z-index: 9999; min-width: 300px;";
        alertDiv.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        
        document.body.appendChild(alertDiv);
        
        // Auto remove after 5 seconds
        setTimeout(() => {
            if (alertDiv.parentNode) {
                alertDiv.remove();
            }
        }, 5000);
    }
});
</script>
{% endblock %}
