{% extends "admin/layout.twig" %}

{% block title %}Job Positions Library{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% set current_page = current_page|default('job-positions') %}

{% block content %}
<div class="w-full px-4 sm:px-6 py-4">
 {# Hero Header #}
 <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
   <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Job Positions Library</h1>
   <p class="text-sm text-slate-500 mt-1">Manage resume content suggestions for different job titles and professions.</p>
  </div>
  <div class="flex gap-2">
   <a href="/admin/job-positions/create" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
    <i class="lucide lucide-plus-circle w-4 h-4"></i> Add Position
   </a>
   <a href="/admin/cv-templates" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition border border-slate-300 text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800">
    <i class="lucide lucide-arrow-left w-4 h-4"></i> CV Templates
   </a>
  </div>
 </div>

 {# Stats Cards #}
 {% if stats is defined %}
 <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
  <div class="rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800 p-4">
   <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-lg bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center text-indigo-600 dark:text-indigo-400">
     <i class="lucide lucide-briefcase w-5 h-5"></i>
    </div>
    <div>
     <div class="text-2xl font-bold text-slate-900 dark:text-white">{{ stats.total|default(0) }}</div>
     <div class="text-xs text-slate-500">Total Positions</div>
    </div>
   </div>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800 p-4">
   <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-lg bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
     <i class="lucide lucide-check-circle w-5 h-5"></i>
    </div>
    <div>
     <div class="text-2xl font-bold text-slate-900 dark:text-white">{{ stats.active|default(0) }}</div>
     <div class="text-xs text-slate-500">Active</div>
    </div>
   </div>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800 p-4">
   <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-lg bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-amber-600 dark:text-amber-400">
     <i class="lucide lucide-layers w-5 h-5"></i>
    </div>
    <div>
     <div class="text-2xl font-bold text-slate-900 dark:text-white">{{ stats.categories|default(0) }}</div>
     <div class="text-xs text-slate-500">Categories</div>
    </div>
   </div>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800 p-4">
   <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-lg bg-sky-100 dark:bg-sky-900/30 flex items-center justify-center text-sky-600 dark:text-sky-400">
     <i class="lucide lucide-file-text w-5 h-5"></i>
    </div>
    <div>
     <div class="text-2xl font-bold text-slate-900 dark:text-white">{{ stats.total_summaries|default(0) }}</div>
     <div class="text-xs text-slate-500">Summaries</div>
    </div>
   </div>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800 p-4">
   <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-lg bg-violet-100 dark:bg-violet-900/30 flex items-center justify-center text-violet-600 dark:text-violet-400">
     <i class="lucide lucide-list-checks w-5 h-5"></i>
    </div>
    <div>
     <div class="text-2xl font-bold text-slate-900 dark:text-white">{{ stats.total_bullets|default(0) }}</div>
     <div class="text-xs text-slate-500">Bullet Points</div>
    </div>
   </div>
  </div>
 </div>
 {% endif %}

 {# Filters #}
 <div class="rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800 mb-4">
  <div class="p-4">
   <form class="flex flex-wrap gap-3 items-end" method="get" action="">
    <div class="flex-1 min-w-[200px]">
     <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Search</label>
     <div class="flex items-center rounded-lg border border-slate-300 dark:border-slate-600 overflow-hidden focus-within:ring-2 focus-within:ring-indigo-500/20 focus-within:border-indigo-500 bg-white dark:bg-slate-800">
      <span class="shrink-0 flex items-center px-3 py-2 bg-slate-50 dark:bg-slate-700 border-r border-slate-300 dark:border-slate-600 text-slate-400">
       <i class="lucide lucide-search w-4 h-4"></i>
      </span>
      <input type="text" name="search" value="{{ search|default('') }}"
       class="w-full border-0 px-3 py-2 text-sm focus:outline-none bg-transparent dark:text-white"
       placeholder="Search by title, slug, or category">
     </div>
    </div>
    <div>
     <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Status</label>
     <select name="status" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm bg-white dark:bg-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      <option value="all" {% if status == 'all' %}selected{% endif %}>All</option>
      <option value="active" {% if status == 'active' %}selected{% endif %}>Active</option>
      <option value="inactive" {% if status == 'inactive' %}selected{% endif %}>Inactive</option>
     </select>
    </div>
    <div>
     <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Per page</label>
     <select name="limit" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm bg-white dark:bg-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      {% for size in [10, 20, 50, 100] %}
      <option value="{{ size }}" {% if limit == size %}selected{% endif %}>{{ size }}</option>
      {% endfor %}
     </select>
    </div>
    <div>
     <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
      <i class="lucide lucide-filter w-4 h-4"></i> Apply
     </button>
    </div>
    <div>
     <a href="/admin/job-positions" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition border border-slate-300 text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800">
      <i class="lucide lucide-rotate-ccw w-4 h-4"></i> Reset
     </a>
    </div>
   </form>
  </div>
 </div>

 {# Positions Table #}
 {% if positions is not empty %}
 <div class="rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800 overflow-hidden">
  <div class="overflow-x-auto">
   <table class="w-full text-left text-sm">
    <thead>
     <tr class="border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50">
      <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300">ID</th>
      <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300">Title</th>
      <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300">Slug</th>
      <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300">Category</th>
      <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300">Status</th>
      <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300">Created</th>
      <th class="px-4 py-3 font-semibold text-slate-700 dark:text-slate-300 text-center">Actions</th>
     </tr>
    </thead>
    <tbody>
     {% for position in positions %}
     <tr class="border-b border-slate-100 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors" data-id="{{ position.id }}">
      <td class="px-4 py-3 font-semibold text-slate-900 dark:text-white">#{{ position.id }}</td>
      <td class="px-4 py-3">
       <div class="font-semibold text-slate-900 dark:text-white">{{ position.title }}</div>
      </td>
      <td class="px-4 py-3 text-slate-500 font-mono text-xs">{{ position.slug }}</td>
      <td class="px-4 py-3">
       {% if position.category %}
       <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300">
        {{ position.category }}
       </span>
       {% else %}
       <span class="text-slate-400">—</span>
       {% endif %}
      </td>
      <td class="px-4 py-3">
       {% if position.is_active %}
       <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">
        <i class="lucide lucide-check-circle w-3 h-3 mr-1"></i> Active
       </span>
       {% else %}
       <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-400">
        <i class="lucide lucide-x-circle w-3 h-3 mr-1"></i> Inactive
       </span>
       {% endif %}
      </td>
      <td class="px-4 py-3 text-slate-500 text-xs">{{ position.created_at ? position.created_at|date('M d, Y') : '—' }}</td>
      <td class="px-4 py-3 text-center">
       <div class="flex items-center justify-center gap-1">
        <a href="/admin/job-positions/{{ position.id }}/edit"
         class="inline-flex items-center justify-center rounded-lg px-3 py-1.5 text-xs font-medium transition bg-indigo-600 text-white hover:bg-indigo-700"
         title="Edit position">
         <i class="lucide lucide-pencil w-3.5 h-3.5 mr-1"></i> Edit
        </a>
        <form method="post" action="/admin/job-positions/{{ position.id }}/toggle" class="inline" data-toggle-form>
         <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
         <button type="submit"
          class="inline-flex items-center justify-center rounded-lg px-3 py-1.5 text-xs font-medium transition {% if position.is_active %}bg-amber-500 text-white hover:bg-amber-600{% else %}bg-emerald-600 text-white hover:bg-emerald-700{% endif %}"
          title="{% if position.is_active %}Deactivate{% else %}Activate{% endif %}">
          <i class="lucide {% if position.is_active %}lucide-pause{% else %}lucide-play{% endif %} w-3.5 h-3.5 mr-1"></i>
          {% if position.is_active %}Disable{% else %}Enable{% endif %}
         </button>
        </form>
        <form method="post" action="/admin/job-positions/{{ position.id }}/delete" class="inline" onsubmit="return confirm('Are you sure you want to delete this position and all its content?');">
         <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
         <button type="submit"
          class="inline-flex items-center justify-center rounded-lg px-3 py-1.5 text-xs font-medium transition bg-red-500 text-white hover:bg-red-600"
          title="Delete position">
          <i class="lucide lucide-trash-2 w-3.5 h-3.5 mr-1"></i> Delete
         </button>
        </form>
       </div>
      </td>
     </tr>
     {% endfor %}
    </tbody>
   </table>
  </div>
 </div>

 {# Pagination #}
 {% if total_pages > 1 %}
 <div class="flex items-center justify-between mt-4">
  <div class="text-sm text-slate-500">
   Showing page {{ page }} of {{ total_pages }} ({{ total }} total positions)
  </div>
  <div class="flex gap-1">
   {% if page > 1 %}
   <a href="?page={{ page - 1 }}&limit={{ limit }}&search={{ search|url_encode }}&status={{ status }}"
    class="inline-flex items-center justify-center rounded-lg px-3 py-2 text-sm font-medium border border-slate-300 text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800">
    <i class="lucide lucide-chevron-left w-4 h-4"></i> Previous
   </a>
   {% endif %}
   {% if page < total_pages %}
   <a href="?page={{ page + 1 }}&limit={{ limit }}&search={{ search|url_encode }}&status={{ status }}"
    class="inline-flex items-center justify-center rounded-lg px-3 py-2 text-sm font-medium border border-slate-300 text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800">
    Next <i class="lucide lucide-chevron-right w-4 h-4"></i>
   </a>
   {% endif %}
  </div>
 </div>
 {% endif %}

 {% else %}
 <div class="rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800 p-12 text-center">
  <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center">
   <i class="lucide lucide-briefcase w-8 h-8 text-slate-400"></i>
  </div>
  <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">No Job Positions Found</h3>
  <p class="text-sm text-slate-500 mb-6 max-w-md mx-auto">
   Create your first job position to start building a library of professional summaries, bullet points, and skill suggestions for the CV Builder.
  </p>
  <a href="/admin/job-positions/create" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
   <i class="lucide lucide-plus-circle w-4 h-4"></i> Create First Position
  </a>
 </div>
 {% endif %}
</div>
{% endblock %}
