{% extends"admin/layout.twig" %}
{% import"_macros/dashboard_macros.twig" as ui %}
{% block title %}Admin Dashboard{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}

{# ── Gradient Page Header ── #}
<div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-900 text-white shadow-xl shadow-slate-900/20">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.25),transparent_55%)]" aria-hidden="true"></div>
  <div class="relative px-6 py-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-4">
      <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center flex-shrink-0">
        <i class="lucide lucide-gauge w-5 h-5 text-white"></i>
      </div>
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-1">Dashboard</p>
        <h1 class="text-xl font-bold text-white">Welcome back, {{ admin_user.full_name|default(admin_user.username|title) }}</h1>
        <p class="text-sm text-white/60 mt-0.5 max-w-md">Content overview for {{ "now"|date("F j, Y") }}</p>
      </div>
    </div>
    <div class="flex gap-2">
      <a href="/admin/posts/create" class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
        <i class="lucide lucide-pencil w-4 h-4"></i> New Post
      </a>
      <a href="/admin/applications" class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
        <i class="lucide lucide-briefcase w-4 h-4"></i> Applications
      </a>
      <a href="/admin/applications/receipts" class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
        <i class="lucide lucide-receipt w-4 h-4"></i> Receipts
      </a>
    </div>
  </div>
</div>

{% if user_roles and user_roles|length > 0 %}
<div class="scroll-fade-in flex items-start gap-4 rounded-2xl border border-indigo-200/50 dark:border-indigo-800/40 bg-gradient-to-r from-indigo-50/80 to-sky-50/80 dark:from-indigo-950/30 dark:to-sky-950/30 p-4 shadow-sm" role="alert">
  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400">
    <i class="lucide lucide-shield-check w-4 h-4"></i>
  </div>
  <div class="min-w-0 flex-1">
   <div class="mb-2 text-sm font-semibold text-slate-900 dark:text-white">Your Access Level</div>
   <div class="flex flex-wrap gap-2">
    {% for role in user_roles %}
    <span class="inline-flex items-center gap-1 rounded-full border border-indigo-200/60 dark:border-indigo-700/40 bg-white dark:bg-slate-800 px-2.5 py-0.5 text-xs font-medium text-indigo-700 dark:text-indigo-400 shadow-sm">
     <i class="lucide lucide-shield-check w-3 h-3"></i>{{ role.name|replace({" ":""})|title }}
    </span>
    {% endfor %}
   </div>
   {% if user_permissions and user_permissions|length > 0 %}
    {% set module_names = [] %}
    {% for permission in user_permissions %}
     {% if permission.module is not null %}
      {% set module_names = module_names | merge([permission.module]) %}
     {% endif %}
    {% endfor %}
    <p class="mt-2 text-sm text-slate-600/80 dark:text-slate-400/80">
     You have <strong>{{ user_permissions|length }}</strong> permissions across {{ module_names|unique|length }} modules.
    </p>
   {% endif %}
  </div>
  <button type="button" class="flex h-7 w-7 shrink-0 cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent text-indigo-400 dark:text-indigo-500 transition-all duration-150 hover:bg-indigo-100 dark:hover:bg-indigo-900/30 hover:text-indigo-700 dark:hover:text-indigo-300" data-brox-dismiss="alert" aria-label="Close">
   <i class="lucide lucide-x w-3.5 h-3.5"></i>
  </button>
</div>
{% endif %}

{# ── Stat Cards ── #}
<section class="scroll-fade-in grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <!-- Total Posts -->
  <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm p-5 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-600 mb-1">Total Posts</p>
        <p class="text-2xl font-bold text-slate-900 dark:text-white tabular-nums">{{ stats.total_posts|default(0) }}</p>
        {% if stats.new_posts_today|default(0) > 0 %}
        <p class="text-xs text-emerald-600 dark:text-emerald-400 mt-1 flex items-center gap-1">
          <i class="lucide lucide-trending-up w-3 h-3"></i> +{{ stats.new_posts_today }} today
        </p>
        {% endif %}
      </div>
      <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
        <i class="lucide lucide-file-text w-5 h-5 text-indigo-600 dark:text-indigo-400"></i>
      </div>
    </div>
  </div>
  <!-- Comments Today -->
  <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm p-5 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-600 mb-1">Comments Today</p>
        <p class="text-2xl font-bold text-slate-900 dark:text-white tabular-nums">{{ stats.today_comments|default(0) }}</p>
        <p class="text-xs text-slate-400 dark:text-slate-600 mt-1">Last sync {{ last_sync_at|default("now")|date("H:i") }}</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-sky-50 dark:bg-sky-900/30 flex items-center justify-center flex-shrink-0">
        <i class="lucide lucide-message-circle w-5 h-5 text-sky-600 dark:text-sky-400"></i>
      </div>
    </div>
  </div>
  <!-- Pending Reviews -->
  <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm p-5 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-600 mb-1">Pending Reviews</p>
        <p class="text-2xl font-bold text-slate-900 dark:text-white tabular-nums">{{ stats.pending_reviews|default(0) }}</p>
        {% if stats.draft_count|default(0) > 0 %}
        <p class="text-xs text-slate-400 dark:text-slate-600 mt-1">{{ stats.draft_count }} drafts</p>
        {% endif %}
      </div>
      <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-900/30 flex items-center justify-center flex-shrink-0">
        <i class="lucide lucide-hourglass w-5 h-5 text-amber-600 dark:text-amber-400"></i>
      </div>
    </div>
  </div>
  <!-- Subscribers -->
  <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm p-5 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-600 mb-1">Subscribers</p>
        <p class="text-2xl font-bold text-slate-900 dark:text-white tabular-nums">{{ stats.subscribers|default(0) }}</p>
        {% if stats.new_subscribers|default(0) > 0 %}
        <p class="text-xs text-emerald-600 dark:text-emerald-400 mt-1 flex items-center gap-1">
          <i class="lucide lucide-trending-up w-3 h-3"></i> +{{ stats.new_subscribers }} new
        </p>
        {% endif %}
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0">
        <i class="lucide lucide-users w-5 h-5 text-emerald-600 dark:text-emerald-400"></i>
      </div>
    </div>
  </div>
</section>

{# ── Service Stats Section ── #}
<section class="scroll-fade-in overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
  <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
    <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
      <i class="lucide lucide-layers w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
    </div>
    <div class="flex-1">
      <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Service Application & Payment Stats</h3>
      <p class="text-xs text-slate-400 dark:text-slate-600">Quick view of service operations and payment activity.</p>
    </div>
    <div class="flex gap-2">
      <a href="/admin/applications" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:-translate-y-0.5 transition-all duration-150">Applications</a>
      <a href="/admin/applications/receipts" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:-translate-y-0.5 transition-all duration-150">Receipts</a>
    </div>
  </div>
  <div class="p-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm p-5 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-600 mb-1">Service Applications</p>
          <p class="text-2xl font-bold text-slate-900 dark:text-white tabular-nums">{{ stats.service_applications_total|default(0) }}</p>
          <p class="text-xs text-slate-400 dark:text-slate-600 mt-1">Pending {{ stats.service_applications_pending|default(0) }}</p>
        </div>
        <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
          <i class="lucide lucide-file-text w-5 h-5 text-indigo-600 dark:text-indigo-400"></i>
        </div>
      </div>
    </div>
    <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm p-5 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-600 mb-1">Approved</p>
          <p class="text-2xl font-bold text-slate-900 dark:text-white tabular-nums">{{ stats.service_applications_approved|default(0) }}</p>
          <p class="text-xs text-red-600 dark:text-red-400 mt-1 flex items-center gap-1">
            <i class="lucide lucide-trending-down w-3 h-3"></i> {{ stats.service_applications_rejected|default(0) }} rejected
          </p>
        </div>
        <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0">
          <i class="lucide lucide-check-circle w-5 h-5 text-emerald-600 dark:text-emerald-400"></i>
        </div>
      </div>
    </div>
    <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm p-5 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-600 mb-1">Payment Records</p>
          <p class="text-2xl font-bold text-slate-900 dark:text-white tabular-nums">{{ stats.service_payments_total|default(0) }}</p>
          <p class="text-xs text-slate-400 dark:text-slate-600 mt-1">Paid {{ stats.service_payments_paid|default(0) }}</p>
        </div>
        <div class="w-10 h-10 rounded-xl bg-sky-50 dark:bg-sky-900/30 flex items-center justify-center flex-shrink-0">
          <i class="lucide lucide-credit-card w-5 h-5 text-sky-600 dark:text-sky-400"></i>
        </div>
      </div>
    </div>
    <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm p-5 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-600 mb-1">Payment Revenue</p>
          <p class="text-2xl font-bold text-slate-900 dark:text-white tabular-nums">{{ stats.service_payments_revenue|default(0)|number_format(2) }}</p>
          <p class="text-xs text-red-600 dark:text-red-400 mt-1 flex items-center gap-1">
            <i class="lucide lucide-trending-down w-3 h-3"></i> {{ stats.service_payments_failed|default(0) }} failed
          </p>
        </div>
        <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-900/30 flex items-center justify-center flex-shrink-0">
          <i class="lucide lucide-circle-dollar-sign w-5 h-5 text-amber-600 dark:text-amber-400"></i>
        </div>
      </div>
    </div>
  </div>
</section>

{# ── Two-column layout: Recent Posts + Right Sidebar ── #}
<div class="grid gap-6 xl:grid-cols-12">
  <div class="xl:col-span-8 space-y-6">
    {# ── Recent Posts Table ── #}
    <section class="scroll-fade-in overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
      <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
        <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
          <i class="lucide lucide-file-text w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
        </div>
        <div class="flex-1">
          <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Recent Posts</h3>
          <p class="text-xs text-slate-400 dark:text-slate-600">Latest content activity</p>
        </div>
        <a href="/admin/posts" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:-translate-y-0.5 transition-all duration-150">
          View all
          <i class="lucide lucide-arrow-right w-3 h-3"></i>
        </a>
      </div>

      {% if recent_posts is not empty %}
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">ID</th>
              <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Title</th>
              <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Author</th>
              <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Status</th>
              <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Published</th>
              <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {% for post in recent_posts %}
            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors duration-100">
              <td class="px-4 py-3 text-sm text-slate-700 dark:text-slate-300"><span class="font-semibold text-slate-900 dark:text-white">#{{ post.id }}</span></td>
              <td class="px-4 py-3 text-sm font-medium text-slate-700 dark:text-slate-300">{{ post.title }}</td>
              <td class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400">{{ post.author_name }}</td>
              <td class="px-4 py-3">{{ ui.status_badge(post.status) }}</td>
              <td class="px-4 py-3 text-xs text-slate-400 dark:text-slate-600">{{ post.published_at|date("d M, Y") }}</td>
              <td class="px-4 py-3 text-right">
                <div class="flex items-center gap-1">
                  <a href="/admin/posts/view?id={{ post.id }}" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-950/30 transition-all duration-150" title="View">
                    <i class="lucide lucide-eye w-3.5 h-3.5"></i>
                  </a>
                  <a href="/admin/posts/edit?id={{ post.id }}" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-950/30 transition-all duration-150" title="Edit">
                    <i class="lucide lucide-pencil w-3.5 h-3.5"></i>
                  </a>
                </div>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="flex flex-col items-center justify-center py-16 text-center">
        <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-4">
          <i class="lucide lucide-inbox w-7 h-7 text-slate-400 dark:text-slate-600"></i>
        </div>
        <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-1">No recent posts</h3>
        <p class="text-sm text-slate-400 dark:text-slate-600 mb-5 max-w-xs">New blog posts will appear here.</p>
      </div>
      {% endif %}
    </section>
  </div>

  <div class="xl:col-span-4 space-y-6">
    {# ── Quick Actions ── #}
    <section class="scroll-fade-in overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
      <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
        <div class="w-7 h-7 rounded-lg bg-amber-50 dark:bg-amber-900/30 flex items-center justify-center flex-shrink-0">
          <i class="lucide lucide-zap w-4 h-4 text-amber-600 dark:text-amber-400"></i>
        </div>
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Quick Actions</h3>
      </div>
      <div class="p-5 grid gap-2">
        <a class="group inline-flex items-center gap-2.5 rounded-lg border border-indigo-100 dark:border-indigo-900/30 bg-indigo-50/50 dark:bg-indigo-950/20 px-4 py-2.5 text-xs font-semibold text-indigo-700 dark:text-indigo-400 transition-all hover:bg-indigo-100 dark:hover:bg-indigo-950/40 hover:-translate-y-0.5" href="/admin/posts/create">
          <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 transition-transform group-hover:scale-110"><i class="lucide lucide-pencil w-3.5 h-3.5"></i></div>
          New Post
          <i class="lucide lucide-arrow-right ml-auto w-3.5 h-3.5 text-indigo-300 dark:text-indigo-600"></i>
        </a>
        <a class="group inline-flex items-center gap-2.5 rounded-lg border border-amber-100 dark:border-amber-900/30 bg-amber-50/50 dark:bg-amber-950/20 px-4 py-2.5 text-xs font-semibold text-amber-700 dark:text-amber-400 transition-all hover:bg-amber-100 dark:hover:bg-amber-950/40 hover:-translate-y-0.5" href="/admin/categories">
          <div class="flex h-7 w-7 items-center justify-center rounded-md bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 transition-transform group-hover:scale-110"><i class="lucide lucide-folder w-3.5 h-3.5"></i></div>
          Categories
          <i class="lucide lucide-arrow-right ml-auto w-3.5 h-3.5 text-amber-300 dark:text-amber-600"></i>
        </a>
        <a class="group inline-flex items-center gap-2.5 rounded-lg border border-cyan-100 dark:border-cyan-900/30 bg-cyan-50/50 dark:bg-cyan-950/20 px-4 py-2.5 text-xs font-semibold text-cyan-700 dark:text-cyan-400 transition-all hover:bg-cyan-100 dark:hover:bg-cyan-950/40 hover:-translate-y-0.5" href="/admin/tags">
          <div class="flex h-7 w-7 items-center justify-center rounded-md bg-cyan-100 dark:bg-cyan-900/30 text-cyan-600 dark:text-cyan-400 transition-transform group-hover:scale-110"><i class="lucide lucide-hash w-3.5 h-3.5"></i></div>
          Tags
          <i class="lucide lucide-arrow-right ml-auto w-3.5 h-3.5 text-cyan-300 dark:text-cyan-600"></i>
        </a>
        <a class="group inline-flex items-center gap-2.5 rounded-lg border border-sky-100 dark:border-sky-900/30 bg-sky-50/50 dark:bg-sky-950/20 px-4 py-2.5 text-xs font-semibold text-sky-700 dark:text-sky-400 transition-all hover:bg-sky-100 dark:hover:bg-sky-950/40 hover:-translate-y-0.5" href="/admin/comments">
          <div class="flex h-7 w-7 items-center justify-center rounded-md bg-sky-100 dark:bg-sky-900/30 text-sky-600 dark:text-sky-400 transition-transform group-hover:scale-110"><i class="lucide lucide-message-circle w-3.5 h-3.5"></i></div>
          Comments
          <i class="lucide lucide-arrow-right ml-auto w-3.5 h-3.5 text-sky-300 dark:text-sky-600"></i>
        </a>
      </div>
    </section>

    {# ── Recent Comments ── #}
    <section class="scroll-fade-in overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
      <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
        <div class="w-7 h-7 rounded-lg bg-emerald-50 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0">
          <i class="lucide lucide-message-circle w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
        </div>
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Recent Comments</h3>
      </div>
      <div class="p-5">
       {% if recent_comments is not empty %}
        <ul class="space-y-3">
         {% for comment in recent_comments %}
          <li class="group rounded-lg border border-transparent p-3 transition-all hover:border-slate-100 dark:hover:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800/40">
           <div class="flex items-start gap-2.5">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 text-xs font-bold">{{ comment.author|first|default('?')|upper }}</div>
            <div class="min-w-0 flex-1">
             <div class="text-sm font-semibold text-slate-900 dark:text-white">{{ comment.author }}</div>
             <div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">On: {{ comment.post_title }}</div>
             <div class="mt-0.5 text-xs text-slate-400 dark:text-slate-600">{{ comment.created_at|date("d M, Y h:i A") }}</div>
            </div>
           </div>
          </li>
         {% endfor %}
        </ul>
       {% else %}
        <div class="flex flex-col items-center justify-center py-12 text-center">
         <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-4">
          <i class="lucide lucide-inbox w-7 h-7 text-slate-400 dark:text-slate-600"></i>
         </div>
         <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-1">No comments yet</h3>
         <p class="text-sm text-slate-400 dark:text-slate-600 max-w-xs">Readers' comments will appear here.</p>
        </div>
       {% endif %}
      </div>
    </section>
  </div>
</div>

{# ── Posts & Comments Trend Chart ── #}
<section class="scroll-fade-in overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
  <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
    <div class="w-7 h-7 rounded-lg bg-cyan-50 dark:bg-cyan-900/30 flex items-center justify-center flex-shrink-0">
      <i class="lucide lucide-bar-chart-3 w-4 h-4 text-cyan-600 dark:text-cyan-400"></i>
    </div>
    <div class="flex-1">
      <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Posts & Comments Trend</h3>
      <p class="text-xs text-slate-400 dark:text-slate-600">Last 30 days trend</p>
    </div>
    <div class="inline-flex items-center gap-1 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-medium text-slate-500 dark:text-slate-400 shadow-sm">Last 30 days</div>
  </div>
  <div class="p-5">
   <div id="chart-posts" class="chart-container w-full min-h-[200px]"></div>
  </div>
</section>

<div id="admin-dashboard-data"
  data-trend-labels="{{ trend.labels|default([]) |json_encode|e('html_attr') }}"
  data-trend-series="{{ trend.series|default([]) |json_encode|e('html_attr') }}"></div>
{% endblock %}
{% block scripts %}{{ parent() }}{% endblock %}
