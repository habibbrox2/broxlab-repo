{% extends"admin/layout.twig" %}
{% import"_macros/dashboard_macros.twig" as ui %}
{% block title %}Admin Dashboard{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="space-y-6">
 <section class="admin-page-header">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-gauge"></i>
     Dashboard
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
     Welcome back, {{ admin_user.full_name|default(admin_user.username|title) }}
    </h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600 sm:text-base">
     Content overview and operational snapshot for {{"now"|date("F j, Y") }}.
    </p>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/posts/create" class="btn btn-primary">
     <i class="lucide lucide-pencil"></i>
     New Post
    </a>
    <a href="/admin/applications" class="btn btn-secondary">
     <i class="lucide lucide-briefcase"></i>
     Applications
    </a>
    <a href="/admin/applications/receipts" class="btn btn-secondary">
     <i class="lucide lucide-receipt"></i>
     Receipts
    </a>
   </div>
  </div>
 </section>

 {% if user_roles and user_roles|length > 0 %}
 <div class="alert alert-info" role="alert">
  <div class="flex-1">
   <div class="mb-2 flex items-center gap-2 font-semibold text-sky-900">
    <i class="lucide lucide-shield-check"></i>
    Your Access Level
   </div>
   <div class="flex flex-wrap gap-2">
    {% for role in user_roles %}
    <span class="badge bg-slate-950 text-white">
     <i class="lucide lucide-shield-check mr-1"></i>{{ role.name|replace({"_":""}) |title }}
    </span>
    {% endfor %}
   </div>
   {% if user_permissions and user_permissions|length > 0 %}
    {% set module_names = [] %}
    {% for permission in user_permissions %}
     {% if permission.module is not null %}
      {% set module_names = module_names | merge([permission.module]) %}
     {% endif %}
    {% endfor %}
    <p class="mt-3 text-sm text-sky-900/80">
     You have <strong>{{ user_permissions|length }}</strong> permissions across {{ module_names|unique|length }} modules.
    </p>
   {% endif %}
  </div>
  <button type="button" class="btn btn-secondary shrink-0" data-brox-dismiss="alert" aria-label="Close">
   <i class="lucide lucide-x"></i>
  </button>
 </div>
 {% endif %}

 <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <div class="success">
   <div class="stat-label">Total Posts</div>
   <div class="stat-value">{{ stats.total_posts|default(0) }}</div>
   <div class="stat-change">+{{ stats.new_posts_today|default(0) }} today</div>
   <i class="lucide lucide-file-text stat-icon"></i>
  </div>
  <div class="info">
   <div class="stat-label">Comments Today</div>
   <div class="stat-value">{{ stats.today_comments|default(0) }}</div>
   <div class="stat-change">Last sync {{ last_sync_at|default("now") |date("H:i") }}</div>
   <i class="lucide lucide-message-circle stat-icon"></i>
  </div>
  <div class="warning">
   <div class="stat-label">Pending Reviews</div>
   <div class="stat-value">{{ stats.pending_reviews|default(0) }}</div>
   <div class="stat-change">Drafts: {{ stats.draft_count|default(0) }}</div>
   <i class="lucide lucide-hourglass stat-icon"></i>
  </div>
  <div class="primary">
   <div class="stat-label">Subscribers</div>
   <div class="stat-value">{{ stats.subscribers|default(0) }}</div>
   <div class="stat-change">New: {{ stats.new_subscribers|default(0) }}</div>
   <i class="lucide lucide-users stat-icon"></i>
  </div>
 </section>

 <section class="admin-panel-card">
  <div class="flex flex-col gap-4 border-b border-slate-200/80 pb-4 lg:flex-row lg:items-center lg:justify-between">
   <div>
    <h2 class="text-lg font-semibold text-slate-950">Service Application & Payment Stats</h2>
    <p class="mt-1 text-sm text-slate-500">Quick view of service operations and payment activity.</p>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/applications" class="btn btn-secondary btn-sm">Applications</a>
    <a href="/admin/applications/receipts" class="btn btn-secondary btn-sm">Receipts</a>
   </div>
  </div>
  <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
   <a href="/admin/applications" class="no-underline text-inherit">
    <div class="primary h-full">
     <div class="stat-label">Service Applications</div>
     <div class="stat-value">{{ stats.service_applications_total|default(0) }}</div>
     <div class="stat-change">Pending {{ stats.service_applications_pending|default(0) }} · Processing {{ stats.service_applications_processing|default(0) }}</div>
     <i class="lucide lucide-file-text stat-icon"></i>
    </div>
   </a>
   <a href="/admin/applications?status=approved" class="no-underline text-inherit">
    <div class="success h-full">
     <div class="stat-label">Approved</div>
     <div class="stat-value">{{ stats.service_applications_approved|default(0) }}</div>
     <div class="stat-change">Rejected {{ stats.service_applications_rejected|default(0) }}</div>
     <i class="lucide lucide-check-circle stat-icon"></i>
    </div>
   </a>
   <a href="/admin/applications/receipts" class="no-underline text-inherit">
    <div class="info h-full">
     <div class="stat-label">Payment Records</div>
     <div class="stat-value">{{ stats.service_payments_total|default(0) }}</div>
     <div class="stat-change">Paid {{ stats.service_payments_paid|default(0) }} · Pending {{ stats.service_payments_pending|default(0) }}</div>
     <i class="lucide lucide-credit-card stat-icon"></i>
    </div>
   </a>
   <a href="/admin/applications/receipts" class="no-underline text-inherit">
    <div class="warning h-full">
     <div class="stat-label">Payment Revenue</div>
     <div class="stat-value">{{ stats.service_payments_revenue|default(0) |number_format(2) }}</div>
     <div class="stat-change">Failed {{ stats.service_payments_failed|default(0) }}</div>
     <i class="lucide lucide-circle-dollar-sign stat-icon"></i>
    </div>
   </a>
  </div>
 </section>

 <div class="grid gap-6 xl:grid-cols-12">
  <div class="xl:col-span-8">
   <section class="admin-panel-card">
    <div class="flex items-center justify-between gap-3 border-b border-slate-200/80 pb-4">
     <div>
      <h2 class="text-lg font-semibold text-slate-950">Recent Posts</h2>
      <p class="mt-1 text-sm text-slate-500">Latest content activity from the editorial team.</p>
     </div>
     <a href="/admin/posts" class="btn btn-ghost btn-sm">
      View all
      <i class="lucide lucide-arrow-right"></i>
     </a>
    </div>

    {% if recent_posts is not empty %}
     <div class="table-responsive mt-5">
      <table class="table table-stacked">
       <thead>
        <tr>
         <th>ID</th>
         <th>Title</th>
         <th>Author</th>
         <th>Status</th>
         <th>Published</th>
         <th class="text-right">Action</th>
        </tr>
       </thead>
       <tbody>
        {% for post in recent_posts %}
        <tr>
         <td data-label="ID" class="font-semibold text-slate-900">#{{ post.id }}</td>
         <td data-label="Title" class="font-medium text-slate-900">{{ post.title }}</td>
         <td data-label="Author">{{ post.author_name }}</td>
         <td data-label="Status">{{ ui.status_badge(post.status) }}</td>
         <td data-label="Published" class="text-slate-500">{{ post.published_at|date("d M, Y h:i A") }}</td>
         <td data-label="Action" class="text-right">
          <div class="inline-flex items-center gap-2">
           <a href="/admin/posts/view?id={{ post.id }}" class="btn btn-secondary btn-sm">View</a>
           <a href="/admin/posts/edit?id={{ post.id }}" class="btn btn-primary btn-sm">Edit</a>
          </div>
         </td>
        </tr>
        {% endfor %}
       </tbody>
      </table>
     </div>
    {% else %}
     <div class="mt-5">
      {{ ui.empty_state('No recent posts', 'New blog posts will appear here.') }}
     </div>
    {% endif %}
   </section>
  </div>

  <div class="xl:col-span-4 space-y-6">
   <section class="admin-panel-card">
    <div class="border-b border-slate-200/80 pb-4">
     <h2 class="text-lg font-semibold text-slate-950">Quick Actions</h2>
     <p class="mt-1 text-sm text-slate-500">Common editorial shortcuts.</p>
    </div>
    <div class="mt-5 grid gap-2">
     <a class="btn btn-secondary w-full justify-start" href="/admin/posts/create"><i class="lucide lucide-pencil"></i> New Post</a>
     <a class="btn btn-secondary w-full justify-start" href="/admin/categories"><i class="lucide lucide-folder"></i> Categories</a>
     <a class="btn btn-secondary w-full justify-start" href="/admin/tags"><i class="lucide lucide-hash"></i> Tags</a>
     <a class="btn btn-secondary w-full justify-start" href="/admin/comments"><i class="lucide lucide-message-circle"></i> Comments</a>
    </div>
   </section>

   <section class="admin-panel-card">
    <div class="border-b border-slate-200/80 pb-4">
     <h2 class="text-lg font-semibold text-slate-950">Recent Comments</h2>
    </div>
    <div class="mt-5">
     {% if recent_comments is not empty %}
      <ul class="space-y-4">
       {% for comment in recent_comments %}
        <li class="rounded-2xl border border-slate-200/80 bg-slate-50/80 p-4">
         <div class="font-semibold text-slate-900">{{ comment.author }}</div>
         <div class="mt-1 text-sm text-slate-500">On: {{ comment.post_title }}</div>
         <div class="mt-1 text-xs text-slate-400">{{ comment.created_at|date("d M, Y h:i A") }}</div>
        </li>
       {% endfor %}
      </ul>
     {% else %}
      {{ ui.empty_state('No comments yet',"Readers' comments will appear here.") }}
     {% endif %}
    </div>
   </section>
  </div>
 </div>

 <section class="admin-panel-card">
  <div class="flex items-center justify-between gap-3 border-b border-slate-200/80 pb-4">
   <div>
    <h2 class="text-lg font-semibold text-slate-950">Posts & Comments Trend</h2>
    <p class="mt-1 text-sm text-slate-500">Last 30 days trend placeholder for the chart widget.</p>
   </div>
   <div class="text-sm text-slate-500">Last 30 days</div>
  </div>
  <div class="mt-5">
   <div id="chart-posts" class="chart-container w-full"></div>
  </div>
 </section>

 <div id="admin-dashboard-data"
  data-trend-labels="{{ trend.labels|default([]) |json_encode|e('html_attr') }}"
  data-trend-series="{{ trend.series|default([]) |json_encode|e('html_attr') }}"></div>
</div>
{% endblock %}
{% block scripts %}{{ parent() }}{% endblock %}
