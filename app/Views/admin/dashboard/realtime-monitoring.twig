{% extends"admin/layout.twig" %}

{% block title %}Real-time Monitoring - {{ parent() }}{% endblock %}

{% block content %}

<div class="w-full px-4 sm:px-6 py-4">
 <!-- Hero Section -->
 <div class="relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 shadow-2xl">
 <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(255,255,255,0.08),transparent_60%)]"></div>
 <div class="absolute -top-6 -right-6 h-32 w-32 rounded-full bg-indigo-500/20 blur-3xl"></div>
 <div class="relative flex items-start justify-between gap-4 px-6 py-5 sm:px-8">
 <div>
 <div class="flex items-center gap-3">
 <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 backdrop-blur-sm">
 <i class="lucide lucide-activity text-white" w-5 h-5></i>
 </div>
 <div>
 <h1 class="text-xl font-bold text-white">Real-time Monitoring</h1>
 <p class="mt-0.5 text-sm text-indigo-200">System activity and health monitoring dashboard</p>
 </div>
 </div>
 </div>
 <button class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white shadow-sm backdrop-blur-sm transition-all duration-200 hover:bg-white/20 hover:shadow-md active:scale-[0.97]" id="refreshMainBtn" onclick="refreshAllData()">
 <i class="lucide lucide-refresh-cw" w-4 h-4></i>
 Refresh Now
 </button>
 </div>
 </div>

 <!-- Key Metrics -->
 <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-6">
 <div class="group relative overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md">
 <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-500"></div>
 <div class="p-4">
 <div class="mb-2 flex items-start justify-between">
 <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Active Users (15 min)</span>
 <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600 shadow-sm"><i class="lucide lucide-users" w-4 h-4></i></div>
 </div>
 <div class="text-2xl font-bold text-slate-900" id="activeUsersCount">-</div>
 <div class="mt-1 text-xs text-slate-500" id="activeUsersChange">Loading...</div>
 </div>
 </div>

 <div class="group relative overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md">
 <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-emerald-500 to-green-500"></div>
 <div class="p-4">
 <div class="mb-2 flex items-start justify-between">
 <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Successful Logins (24h)</span>
 <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600 shadow-sm"><i class="lucide lucide-check-circle" w-4 h-4></i></div>
 </div>
 <div class="text-2xl font-bold text-slate-900" id="successfulLoginsCount">-</div>
 <div class="mt-1 text-xs text-slate-500" id="successfulLoginsPercent">-</div>
 </div>
 </div>

 <div class="group relative overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md">
 <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-red-500 to-rose-500"></div>
 <div class="p-4">
 <div class="mb-2 flex items-start justify-between">
 <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Failed Logins (24h)</span>
 <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-red-100 text-red-600 shadow-sm"><i class="lucide lucide-alert-circle" w-4 h-4></i></div>
 </div>
 <div class="text-2xl font-bold text-slate-900" id="failedLoginsCount">-</div>
 <div class="mt-1 text-xs text-slate-500" id="failedLoginsPercent">-</div>
 </div>
 </div>

 <div class="group relative overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md">
 <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-amber-500 to-orange-500"></div>
 <div class="p-4">
 <div class="mb-2 flex items-start justify-between">
 <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Active Alerts</span>
 <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-100 text-amber-600 shadow-sm"><i class="lucide lucide-alert-triangle" w-4 h-4></i></div>
 </div>
 <div class="text-2xl font-bold text-slate-900" id="activeAlertsCount">-</div>
 <div class="mt-1 text-xs text-slate-500" id="alertsStatus">Checking...</div>
 </div>
 </div>
 </div>

 <!-- System Health -->
 <div class="scroll-fade-in mb-6 overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2 border-b border-slate-200 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-4 py-3">
 <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600 shadow-sm"><i class="lucide lucide-cpu" w-4 h-4></i></div>
 <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">System Health</h2>
 </div>
 <div id="systemHealthContent" class="grid grid-cols-1 gap-4 p-4 sm:grid-cols-3">
 <div class="rounded-lg border border-slate-100 bg-slate-50/50 p-4">
 <div class="mb-1 text-xs font-semibold uppercase tracking-wider text-slate-500">Database Status</div>
 <div class="text-lg font-bold text-slate-900" id="dbStatus">Checking...</div>
 <div class="mt-1 text-xs text-slate-400" id="dbInfo">-</div>
 </div>
 <div class="rounded-lg border border-slate-100 bg-slate-50/50 p-4">
 <div class="mb-1 text-xs font-semibold uppercase tracking-wider text-slate-500">Disk Usage</div>
 <div class="text-lg font-bold text-slate-900" id="diskUsage">Checking...</div>
 <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-slate-200">
 <div class="h-full rounded-full bg-emerald-500 transition-all duration-500" id="diskBar" style="width: 0%;"></div>
 </div>
 </div>
 <div class="rounded-lg border border-slate-100 bg-slate-50/50 p-4">
 <div class="mb-1 text-xs font-semibold uppercase tracking-wider text-slate-500">PHP Version</div>
 <div class="text-lg font-bold text-slate-900" id="phpVersion">Checking...</div>
 <div class="mt-1 text-xs text-slate-400" id="phpMemory">-</div>
 </div>
 </div>
 </div>

 <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 mb-6">
 <!-- Real-time Activity Feed -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2 border-b border-slate-200 bg-gradient-to-r from-sky-50/50 to-cyan-50/50 px-4 py-3">
 <div class="flex h-7 w-7 items-center justify-center rounded-md bg-sky-100 text-sky-600 shadow-sm"><i class="lucide lucide-clock" w-4 h-4></i></div>
 <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Recent Activity (Last Hour)</h2>
 </div>
 <div id="activityFeed">
 <div class="text-center text-slate-400 py-8">Loading activity feed...</div>
 </div>
 </div>

 <!-- Active Users -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2 border-b border-slate-200 bg-gradient-to-r from-blue-50/50 to-indigo-50/50 px-4 py-3">
 <div class="flex h-7 w-7 items-center justify-center rounded-md bg-blue-100 text-blue-600 shadow-sm"><i class="lucide lucide-user-check" w-4 h-4></i></div>
 <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Currently Active Users</h2>
 </div>
 <div id="activeUsersList" class="flex flex-wrap gap-2 p-4">
 <div class="w-full text-center text-slate-400 py-8">Loading active users...</div>
 </div>
 </div>
 </div>

 <!-- Alerts Section -->
 <div class="scroll-fade-in mb-6 overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2 border-b border-slate-200 bg-gradient-to-r from-amber-50/50 to-orange-50/50 px-4 py-3">
 <div class="flex h-7 w-7 items-center justify-center rounded-md bg-amber-100 text-amber-600 shadow-sm"><i class="lucide lucide-alert-triangle" w-4 h-4></i></div>
 <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Active Alerts & Warnings</h2>
 </div>
 <div id="alertsList" class="p-4">
 <div class="text-center text-slate-400 py-8">Scanning for alerts...</div>
 </div>
 </div>

 <!-- Auto-refresh Settings -->
 <div class="scroll-fade-in mb-6 overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2 border-b border-slate-200 bg-gradient-to-r from-slate-50/50 to-slate-100/50 px-4 py-3">
 <div class="flex h-7 w-7 items-center justify-center rounded-md bg-slate-100 text-slate-600 shadow-sm"><i class="lucide lucide-settings" w-4 h-4></i></div>
 <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Auto-Refresh Settings</h2>
 </div>
 <div class="flex flex-wrap items-center gap-4 p-4">
 <label class="flex cursor-pointer items-center gap-3">
 <input type="checkbox" id="autoRefreshToggle" class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-2 focus:ring-indigo-500/30" onchange="toggleAutoRefresh()" checked>
 <span class="text-sm text-slate-700">Enable auto-refresh every
 <input type="number" id="refreshInterval" value="10" min="5" max="60" class="mx-1 inline-block w-16 rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 text-center text-sm text-slate-700 focus:border-indigo-300 focus:outline-none focus:ring-2 focus:ring-indigo-500/30"> seconds
 </span>
 </label>
 <span id="nextRefreshTime" class="text-xs text-slate-400"></span>
 </div>
 </div>
</div>



{% endblock %}




