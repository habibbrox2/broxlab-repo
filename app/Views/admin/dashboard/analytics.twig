{% extends"admin/layout.twig" %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <!-- Page Header -->
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-trending-up mr-2"></i>
 Analytics Dashboard
 </div>
 <div>System analytics and reporting</div>
 </div>
 <!-- Page Header -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
 <div class="col-span-12 flex justify-between items-center">
 <div>
 <h1 class="h3 mb-0">Analytics Dashboard</h1>
 <p class="text-slate-500 small mt-1">Real-time analytics and activity monitoring</p>
 </div>
 <button id="refreshBtnHeader"
 data-action="refresh-dashboard"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 px-3 py-1.5 text-xs"
 title="Refresh dashboard data">
 <i class="lucide lucide-refresh-cw mr-2"></i>Refresh
 </button>
 </div>
 </div>
 <!-- Alert Summary -->
 {% if alert_summary.total_alerts > 0 %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
 <div class="col-span-12">
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200" role="alert">
 <h4 >
 <i class="lucide lucide-alert-triangle"></i> Security Alerts
 </h4>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mt-3">
 <div class="md:col-span-2">
 <strong>Total:</strong>
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold font-semibold-danger">{{ alert_summary.total_alerts }}</span>
 </div>
 {% if alert_summary.critical > 0 %}
 <div class="md:col-span-2">
 <strong>Critical:</strong>
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold font-semibold-danger">{{ alert_summary.critical }}</span>
 </div>
 {% endif %}
 {% if alert_summary.high > 0 %}
 <div class="md:col-span-2">
 <strong>High:</strong>
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold font-semibold-warning">{{ alert_summary.high }}</span>
 </div>
 {% endif %}
 {% if alert_summary.medium > 0 %}
 <div class="md:col-span-2">
 <strong>Medium:</strong>
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold font-semibold-info">{{ alert_summary.medium }}</span>
 </div>
 {% endif %}
 </div>
 <hr class="my-3">
 <small><a href="#recent-alerts">View recent alerts ?</a></small>
 </div>
 </div>
 </div>
 {% endif %}
 <!-- Daily Overview -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
 <div class="lg:col-span-3 md:col-span-6 mb-3">
 <div class=" border border-slate-200 bg-white shadow-sm stats-rounded-xl shadow-sm-visitors">
 <div class="p-4">
 <div class="stat-label">Total Visitors</div>
 <div class="stat-value" id="totalVisitors">0</div>
 <small class="text-slate-500">Last 30 days</small>
 </div>
 </div>
 </div>
 <div class="lg:col-span-3 md:col-span-6 mb-3">
 <div class=" border border-slate-200 bg-white shadow-sm stats-rounded-xl shadow-sm-posts">
 <div class="p-4">
 <div class="stat-label">Total Posts</div>
 <div class="stat-value" id="totalPosts">0</div>
 <small class="text-slate-500">Published content</small>
 </div>
 </div>
 </div>
 <div class="lg:col-span-3 md:col-span-6 mb-3">
 <div class=" border border-slate-200 bg-white shadow-sm stats-rounded-xl shadow-sm-pages">
 <div class="p-4">
 <div class="stat-label">Total Pages</div>
 <div class="stat-value" id="totalPages">0</div>
 <small class="text-slate-500">Static pages</small>
 </div>
 </div>
 </div>
 <div class="lg:col-span-3 md:col-span-6 mb-3">
 <div class=" border border-slate-200 bg-white shadow-sm stats-rounded-xl shadow-sm-users">
 <div class="p-4">
 <div class="stat-label">Total Users</div>
 <div class="stat-value" id="totalUsers">0</div>
 <small class="text-slate-500">Registered users</small>
 </div>
 </div>
 </div>
 </div>
 <!-- Detailed Stats -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
 <div class="lg:col-span-3 mb-3">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <h6 class="mb-0">
 <i class="lucide lucide-file-text"></i> Content Tracking
 </h6>
 </div>
 <div class="p-4">
 <div class="overflow-x-auto">
 <table class="table">
 <tbody>
 <tr>
 <td>Total Content Events</td>
 <td class="text-right">
 <strong id="pageImpressions">0</strong>
 </td>
 </tr>
 <tr>
 <td>Unique Content Events</td>
 <td class="text-right">
 <strong id="pageUniqueImpressions">0</strong>
 </td>
 </tr>
 <tr>
 <td>Top Content</td>
 <td class="text-right small" id="topPage">N/A</td>
 </tr>
 </tbody>
 </table>
 </div>
 </div>
 </div>
 </div>
 <div class="lg:col-span-3 mb-3">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <h6 class="mb-0">
 <i class="lucide lucide-bookmark"></i> Content Tracking
 </h6>
 </div>
 <div class="p-4">
 <div class="overflow-x-auto">
 <table class="table">
 <tbody>
 <tr>
 <td>Total Content Events</td>
 <td class="text-right">
 <strong id="postImpressions">0</strong>
 </td>
 </tr>
 <tr>
 <td>Unique Content Events</td>
 <td class="text-right">
 <strong id="postUniqueImpressions">0</strong>
 </td>
 </tr>
 <tr>
 <td>Top Content</td>
 <td class="text-right small" id="topPost">N/A</td>
 </tr>
 </tbody>
 </table>
 </div>
 </div>
 </div>
 </div>
 <div class="lg:col-span-3 mb-3">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <h6 class="mb-0">
 <i class="lucide lucide-briefcase"></i> Content Tracking
 </h6>
 </div>
 <div class="p-4">
 <div class="overflow-x-auto">
 <table class="table">
 <tbody>
 <tr>
 <td>Total Content Events</td>
 <td class="text-right">
 <strong id="serviceImpressions">0</strong>
 </td>
 </tr>
 <tr>
 <td>Unique Content Events</td>
 <td class="text-right">
 <strong id="serviceUniqueImpressions">0</strong>
 </td>
 </tr>
 <tr>
 <td>Top Content</td>
 <td class="text-right small" id="topService">N/A</td>
 </tr>
 </tbody>
 </table>
 </div>
 </div>
 </div>
 </div>
 <div class="lg:col-span-3 mb-3">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <h6 class="mb-0">
 <i class="lucide lucide-megaphone"></i> Advertisement
 </h6>
 </div>
 <div class="p-4">
 <div class="overflow-x-auto">
 <table class="table">
 <tbody>
 <tr>
 <td>Total Inquiries</td>
 <td class="text-right">
 <strong id="totalInquiries">0</strong>
 </td>
 </tr>
 <tr>
 <td>Pending</td>
 <td class="text-right">
 <strong id="pendingInquiries">0</strong>
 </td>
 </tr>
 <tr>
 <td>Approved</td>
 <td class="text-right">
 <strong id="approvedInquiries">0</strong>
 </td>
 </tr>
 </tbody>
 </table>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Recent Client Events -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
 <div class="col-span-12">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <h6 class="mb-0">
 <i class="lucide lucide-podcast"></i> Recent Client Events
 </h6>
 </div>
 <div class="p-4">
 <div class="overflow-x-auto">
 <table class="table table-striped">
 <thead>
 <tr>
 <th>Event</th>
 <th>User</th>
 <th>Firebase UID</th>
 <th>Params</th>
 <th>IP</th>
 <th>When</th>
 </tr>
 </thead>
 <tbody>
 {% for e in recent_events %}
 <tr>
 <td>{{ e.event_name }}</td>
 <td>{{ e.user_id ?: 'guest' }}</td>
 <td>{{ e.firebase_uid ?: '-' }}</td>
 <td>
 <small>{{ e.event_params ?: '-' }}</small>
 </td>
 <td>{{ e.ip_address ?: '-' }}</td>
 <td class="small text-slate-500">{{ e.created_at }}</td>
 </tr>
 {% else %}
 <tr>
 <td colspan="6" class="text-slate-500">No recent events</td>
 </tr>
 {% endfor %}
 </tbody>
 </table>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Reports Tab Section -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
 <div class="col-span-12">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <ul class="flex flex-wrap gap-1 border-b border-slate-200 pb-0" role="tablist">
 <li>
 <a class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-indigo-600 px-4 py-2.5 text-sm font-semibold text-indigo-700 transition"
 id="daily-tab"
 data-brox-toggle="tab"
 data-brox-target="#daily-report"
 role="tab"
 aria-controls="daily-report"
 aria-selected="true">Daily Report</a>
 </li>
 <li>
 <a class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-300 hover:text-slate-900"
 id="weekly-tab"
 data-brox-toggle="tab"
 data-brox-target="#weekly-report"
 role="tab"
 aria-controls="weekly-report"
 aria-selected="false">Weekly Report</a>
 </li>
 <li>
 <a class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-300 hover:text-slate-900"
 id="monthly-tab"
 data-brox-toggle="tab"
 data-brox-target="#monthly-report"
 role="tab"
 aria-controls="monthly-report"
 aria-selected="false">Monthly Report</a>
 </li>
 </ul>
 </div>
 <div class="p-4">
 <div class="tab-content">
 <!-- Daily Report Tab -->
 <div class="tab-pane block" id="daily-report" role="tabpanel">
 <h6 class="mb-3">Analytics for {{ today }}</h6>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="md:col-span-6 mb-3">
 <h6>Login Activity</h6>
 <canvas id="daily-login-chart"></canvas>
 </div>
 <div class="md:col-span-6 mb-3">
 <h6>Visitor Trends</h6>
 <canvas id="daily-visitor-chart"></canvas>
 </div>
 </div>
 </div>
 <!-- Weekly Report Tab -->
 <div class="tab-pane hidden" id="weekly-report" role="tabpanel">
 <h6 class="mb-3">Weekly Analytics Summary</h6>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="md:col-span-6 mb-3">
 <h6>Daily Breakdown</h6>
 <canvas id="weekly-chart"></canvas>
 </div>
 <div class="md:col-span-6 mb-3">
 <h6>Top Content</h6>
 <div class="overflow-x-auto">
 <table class="table">
 <thead>
 <tr>
 <th>Page/Post</th>
 <th class="text-right">Score</th>
 </tr>
 </thead>
 <tbody>
 {% if weekly_report.top_pages %}
 {% for page in weekly_report.top_pages|slice(0, 3) %}
 <tr>
 <td>{{ page.title|truncate(30) }}</td>
 <td class="text-right">Tracked</td>
 </tr>
 {% endfor %}
 {% endif %}
 </tbody>
 </table>
 </div>
 </div>
 </div>
 </div>
 <!-- Monthly Report Tab -->
 <div class="tab-pane hidden" id="monthly-report" role="tabpanel">
 <h6 class="mb-3">Monthly Analytics Summary</h6>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="md:col-span-4 mb-3">
 <h6>Browser Distribution</h6>
 <canvas id="browser-chart"></canvas>
 </div>
 <div class="md:col-span-4 mb-3">
 <h6>OS Distribution</h6>
 <canvas id="os-chart"></canvas>
 </div>
 <div class="md:col-span-4 mb-3">
 <h6>Monthly Stats</h6>
 <div class="overflow-x-auto">
 <table class="table">
 <tbody>
 <tr>
 <td>Total Visitors</td>
 <td class="text-right">
 <strong>{{ monthly_report.total_visitors.unique ?? 0 }}</strong>
 </td>
 </tr>
 <tr>
 <td>Total Logins</td>
 <td class="text-right">
 <strong>{{ monthly_report.login_stats.total ?? 0 }}</strong>
 </td>
 </tr>
 <tr>
 <td>Failed Logins</td>
 <td class="text-right">
 <strong>{{ monthly_report.login_stats.failed ?? 0 }}</strong>
 </td>
 </tr>
 </tbody>
 </table>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Security Alerts Section -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
 <div class="col-span-12">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <h6 class="mb-0">
 <i class="lucide lucide-shield"></i> Security Alerts (Real-time)
 </h6>
 </div>
 <div class="p-4">
 <div class="alerts-container" id="securityAlerts">
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200">Loading security alerts...</div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Charts Section -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
 <div class="lg:col-span-6">
 <div class="chart-container">
 <div class="chart-title">Daily Activity Trend (30 days)</div>
 <canvas id="dailyActivityChart"></canvas>
 </div>
 </div>
 <div class="lg:col-span-6">
 <div class="chart-container">
 <div class="chart-title">Login Success/Failure Rate</div>
 <canvas id="loginSuccessChart"></canvas>
 </div>
 </div>
 </div>
 <!-- Data Tables Section -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="col-span-12">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <ul class="flex flex-wrap gap-1 border-b border-slate-200 pb-0" role="tablist">
 <li role="presentation">
 <button class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-indigo-600 px-4 py-2.5 text-sm font-semibold text-indigo-700 transition"
 id="login-audit-tab"
 data-brox-toggle="tab"
 data-brox-target="#login-audit"
 type="button">Login Audit</button>
 </li>
 <li role="presentation">
 <button class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-300 hover:text-slate-900"
 id="oauth-audit-tab"
 data-brox-toggle="tab"
 data-brox-target="#oauth-audit"
 type="button">OAuth Audit</button>
 </li>
 <li role="presentation">
 <button class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-300 hover:text-slate-900"
 id="activity-logs-tab"
 data-brox-toggle="tab"
 data-brox-target="#activity-logs"
 type="button">Activity Logs</button>
 </li>
 </ul>
 </div>
 <div class="p-4">
 <div class="tab-content">
 <!-- Login Audit Tab -->
 <div class="tab-pane block" id="login-audit" role="tabpanel">
 <div class="overflow-x-auto">
 <table class="table analytics-table table-hover">
 <thead>
 <tr>
 <th>User ID</th>
 <th>Status</th>
 <th>IP Address</th>
 <th>User Agent</th>
 <th>Date/Time</th>
 </tr>
 </thead>
 <tbody id="loginAuditBody">
 <tr>
 <td colspan="5" class="text-center text-slate-500">Loading...</td>
 </tr>
 </tbody>
 </table>
 </div>
 </div>
 <!-- OAuth Audit Tab -->
 <div class="tab-pane hidden" id="oauth-audit" role="tabpanel">
 <div class="overflow-x-auto">
 <table class="table analytics-table table-hover">
 <thead>
 <tr>
 <th>User ID</th>
 <th>Action</th>
 <th>Provider</th>
 <th>Status</th>
 <th>Error</th>
 <th>Date/Time</th>
 </tr>
 </thead>
 <tbody id="oauthAuditBody">
 <tr>
 <td colspan="6" class="text-center text-slate-500">Loading...</td>
 </tr>
 </tbody>
 </table>
 </div>
 </div>
 <!-- Activity Logs Tab -->
 <div class="tab-pane hidden" id="activity-logs" role="tabpanel">
 <div class="overflow-x-auto">
 <table class="table analytics-table table-hover">
 <thead>
 <tr>
 <th>Action</th>
 <th>Module</th>
 <th>User ID</th>
 <th>Status</th>
 <th>Date/Time</th>
 </tr>
 </thead>
 <tbody id="activityLogsBody">
 <tr>
 <td colspan="5" class="text-center text-slate-500">Loading...</td>
 </tr>
 </tbody>
 </table>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Management Section -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mt-4">
 <div class="col-span-12">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100">
 <h6 class="mb-0">
 <i class="lucide lucide-settings"></i> Management Tools
 </h6>
 </div>
 <div class="p-4">
 <div class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition-group-control flex flex-wrap">
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition inline-flex transition-control text-indigo-600 hover:bg-indigo-100"
 id="refreshBtnTools"
 data-action="refresh-dashboard">
 <i class="lucide lucide-refresh-cw"></i> Refresh Data
 </button>
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition inline-flex transition-control text-red-600 hover:bg-red-100" id="clearLogsBtn">
 <i class="lucide lucide-trash-2"></i> Clear Old Logs
 </button>
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition inline-flex transition-control transition-ghost-success" id="exportBtn">
 <i class="lucide lucide-download"></i> Export Data
 </button>
 </div>
 <small class="block text-slate-500 mt-3">
 <i class="lucide lucide-info"></i> Clear logs: Removes records older than 90 days |
 Export: Download audit logs in CSV or JSON format
 </small>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Export Modal -->
 <div class="modal fade" id="exportModal" tabindex="-1">
 <div class="modal-dialog">
 <div class="modal-content">
 <div class="modal-header">
 <h5 class="modal-title">Export Analytics Data</h5>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition" data-brox-dismiss="modal"></button>
 </div>
 <div class="modal-body">
 <div class="mb-3">
 <label class="form-label">Data Type</label>
 <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="exportDataType">
 <option value="all">All Data</option>
 <option value="login_audit">Login Audit Only</option>
 <option value="oauth_audit">OAuth Audit Only</option>
 <option value="activity_logs">Activity Logs Only</option>
 </select>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="md:col-span-6">
 <label class="form-label">Start Date</label>
 <input type="date" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="exportStartDate">
 </div>
 <div class="md:col-span-6">
 <label class="form-label">End Date</label>
 <input type="date" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="exportEndDate">
 </div>
 </div>
 </div>
 <div class="modal-footer">
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200"
 data-brox-dismiss="modal">Cancel</button>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200" id="exportCsvBtn">
 <i class="lucide lucide-file-text"></i> Export CSV
 </button>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700"
 id="exportJsonBtn">
 <i class="lucide lucide-file-code"></i> Export JSON
 </button>
 </div>
 </div>
 </div>
 </div>
 <!-- Dashboard data (read by analytics-dashboard.js) -->
 <div id="analytics-dashboard-data"
 data-daily-stats='{{ daily_report.stats|json_encode|e("html_attr") }}'
 data-daily-logins='{{ daily_report.logins|json_encode|e("html_attr") }}'
 data-weekly-stats='{{ weekly_report.stats|json_encode|e("html_attr") }}'
 data-monthly-stats='{{ monthly_report.stats|json_encode|e("html_attr") }}'></div>
{% endblock %}
{% block scripts %}
 <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"
 defer></script>
 <script src="{{ asset('/assets/js/dist/analytics-dashboard.js') }}" defer></script>
{% endblock %}






