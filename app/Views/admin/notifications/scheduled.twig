{% extends 'admin/layout.twig' %}
{% block title %}Scheduled Notifications{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4" id="scheduledNotificationsRoot">
 <section class="admin-page-header">
  <div class="flex flex-wrap items-end justify-between gap-3">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600"><i class="lucide lucide-calendar"></i> Notifications</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Scheduled Notifications</h1>
    <p class="mt-2 text-sm text-slate-600">Plan, review, and manage notification schedules.</p>
   </div>
   <button class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" data-action="open-schedule-modal"><i class="lucide lucide-plus"></i> New Schedule</button>
  </div>
 </section>

 <section class="admin-panel-card">
  <ul class="flex flex-wrap gap-1 border-b border-slate-200 pb-0" role="tablist">
   <li role="presentation"><button class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-indigo-600 px-4 py-2.5 text-sm font-semibold text-indigo-700 transition" id="scheduled-tab" data-brox-toggle="tab" data-brox-target="#scheduled-content" type="button" role="tab">Scheduled</button></li>
   <li role="presentation"><button class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-300 hover:text-slate-900" id="sent-tab" data-brox-toggle="tab" data-brox-target="#sent-content" type="button" role="tab">Sent</button></li>
   <li role="presentation"><button class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-300 hover:text-slate-900" id="failed-tab" data-brox-toggle="tab" data-brox-target="#failed-content" type="button" role="tab">Failed</button></li>
   <li role="presentation"><button class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-300 hover:text-slate-900" id="draft-tab" data-brox-toggle="tab" data-brox-target="#draft-content" type="button" role="tab">Draft</button></li>
  </ul>
 </section>

 <div class="tab-content">
  <div class="tab-pane fade show active" id="scheduled-content" role="tabpanel"><div class="admin-panel-card"><div id="scheduled-list" class="py-5 text-center text-slate-500">Loading...</div></div></div>
  <div class="tab-pane fade" id="sent-content" role="tabpanel"><div class="admin-panel-card"><div id="sent-list" class="py-5 text-center text-slate-500">Loading...</div></div></div>
  <div class="tab-pane fade" id="failed-content" role="tabpanel"><div class="admin-panel-card"><div id="failed-list" class="py-5 text-center text-slate-500">Loading...</div></div></div>
  <div class="tab-pane fade" id="draft-content" role="tabpanel"><div class="admin-panel-card"><div id="draft-list" class="py-5 text-center text-slate-500">Loading...</div></div></div>
 </div>

 <div class="modal fade" id="scheduleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
   <div class="modal-content">
    <div class="modal-header">
     <h5 class="modal-title">Create Scheduled Notification</h5>
     <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition" data-brox-dismiss="modal" aria-label="Close"></button>
    </div>
    <form id="scheduleForm">
     <div class="modal-body">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
       <div><label class="form-label" for="notifTitle">Title</label><input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="notifTitle" required></div>
       <div><label class="form-label" for="recipientType">Recipient Type</label><select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="recipientType" required><option value="all">All</option><option value="guest">Guest</option><option value="user">Specific Users</option></select></div>
       <div class="md:col-span-2"><label class="form-label" for="notifBody">Message</label><textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="notifBody" rows="3" required></textarea></div>
       <div><label class="form-label" for="scheduledDate">Date</label><input type="date" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="scheduledDate" required></div>
       <div><label class="form-label" for="scheduledTime">Time</label><input type="time" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="scheduledTime" required></div>
       <div><label class="form-label" for="userTimezone">Timezone</label><select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="userTimezone" required><option value="Asia/Dhaka" selected>Asia/Dhaka</option><option value="UTC">UTC</option><option value="Asia/Kolkata">Asia/Kolkata</option><option value="Europe/London">Europe/London</option><option value="America/New_York">America/New_York</option></select></div>
       <div class="md:col-span-2" id="recipientIdsDiv"><label class="form-label" for="recipientIds">User IDs (comma separated)</label><input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="recipientIds" placeholder="Example: 1,2,3"></div>
       <div class="md:col-span-2">
        <label class="form-label block">Channels</label>
        <div class="flex items-start gap-2"><input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" id="channel-push" value="push" checked><label class="text-sm text-slate-700" for="channel-push">Push</label></div>
        <div class="flex items-start gap-2"><input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" id="channel-in_app" value="in_app"><label class="text-sm text-slate-700" for="channel-in_app">In-App</label></div>
        <div class="flex items-start gap-2"><input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" id="channel-email" value="email"><label class="text-sm text-slate-700" for="channel-email">Email</label></div>
       </div>
      </div>
     </div>
     <div class="modal-footer">
      <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" data-brox-dismiss="modal">Cancel</button>
      <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" id="submitBtn"><i class="lucide lucide-check"></i> Schedule</button>
     </div>
    </form>
   </div>
  </div>
 </div>
</div>
{% endblock %}
