{% extends"admin/layout.twig" %}
{% block title %}Notification Pause/Resume{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
    <!-- Gradient Header -->
    <div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-sky-500 via-indigo-500 to-violet-500 p-6 shadow-lg">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"></div>
        <div class="relative flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/20 backdrop-blur-sm">
                <i class="lucide lucide-pause-circle text-2xl text-white"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-white sm:text-3xl">Pause / Resume Notifications</h1>
                <p class="mt-1 text-sm text-indigo-100">Pause or resume a notification campaign by ID.</p>
            </div>
        </div>
    </div>

    <!-- Pause/Resume Form Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden max-w-2xl">
        <div class="border-b border-slate-100 bg-gradient-to-r from-amber-50/50 to-orange-50/50 px-5 py-4">
            <div class="flex items-center gap-2">
                <i class="lucide lucide-sliders-horizontal text-amber-500" style="width:1.125em;height:1.125em;"></i>
                <h2 class="text-sm font-semibold text-slate-900">Campaign Controls</h2>
            </div>
        </div>
        <div class="p-5">
            <form id="pauseResumeForm" class="space-y-4">
                <div>
                    <label for="notification_id" class="block text-sm font-medium text-slate-700 mb-1">Notification ID</label>
                    <input type="number" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="notification_id" name="notification_id" required />
                </div>
                <div>
                    <label for="reason" class="block text-sm font-medium text-slate-700 mb-1">Reason (optional)</label>
                    <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="reason" name="reason" rows="3"></textarea>
                </div>
                <div class="flex flex-wrap gap-2">
                    <button type="button" id="pauseBtn" class="inline-flex items-center justify-center gap-2 rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-black transition hover:bg-amber-600"><i class="lucide lucide-pause"></i> Pause</button>
                    <button type="button" id="resumeBtn" class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700"><i class="lucide lucide-play"></i> Resume</button>
                </div>
                <div id="prResult" class="mt-3"></div>
            </form>
        </div>
    </div>
    <div id="toast-container" aria-live="polite"></div>
</div>
{% endblock %}
