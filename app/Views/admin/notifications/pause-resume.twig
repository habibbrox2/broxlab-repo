{% extends"admin/layout.twig" %}
{% block title %}Notification Pause/Resume{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4">
 <section class="admin-page-header">
  <div>
   <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
    <i class="lucide lucide-pause-circle"></i>
    Campaign Controls
   </p>
   <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Pause / Resume Notifications</h1>
   <p class="mt-2 text-sm text-slate-600">Pause or resume a notification campaign by ID.</p>
  </div>
 </section>

 <section class="admin-panel-card max-w-2xl">
  <form id="pauseResumeForm" class="space-y-4">
   <div>
    <label for="notification_id" class="form-label">Notification ID</label>
    <input type="number" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="notification_id" name="notification_id" required />
   </div>
   <div>
    <label for="reason" class="form-label">Reason (optional)</label>
    <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="reason" name="reason" rows="3"></textarea>
   </div>
   <div class="flex flex-wrap gap-2">
    <button type="button" id="pauseBtn" class="inline-flex items-center justify-center gap-2 rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-black transition hover:bg-amber-600"><i class="lucide lucide-pause"></i> Pause</button>
    <button type="button" id="resumeBtn" class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700"><i class="lucide lucide-play"></i> Resume</button>
   </div>
   <div id="prResult" class="mt-3"></div>
  </form>
 </section>
 <div id="toast-container" aria-live="polite"></div>
</div>
{% endblock %}
