{% extends 'admin/layout.twig' %}
{% block title %}Offline Notification Manager{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4" id="offlineHandlerRoot">
 <section class="admin-page-header">
  <div class="flex flex-wrap items-end justify-between gap-3">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-wifi-off"></i>
     Offline Notification Manager
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Buffered Delivery Control</h1>
    <p class="mt-2 text-sm text-slate-600">Manage buffered notifications, retry queue, and delivery history.</p>
   </div>
   <div class="flex flex-wrap gap-2">
    <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" data-action="refresh-buffer">
     <i class="lucide lucide-refresh-cw"></i> Refresh
    </button>
    <button class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" data-action="process-queue">
     <i class="lucide lucide-zap"></i> Process Queue
    </button>
    <button class="inline-flex items-center justify-center gap-2 rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-black transition hover:bg-amber-600" data-action="simulate-offline">
     <i class="lucide lucide-plug"></i> Simulate Offline
    </button>
   </div>
  </div>
 </section>

 <section class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
  <div class="admin-panel-card"><p class="text-sm text-slate-500">Buffered</p><div class="mt-2 text-3xl font-bold text-slate-950" id="bufferCount">0</div></div>
  <div class="admin-panel-card"><p class="text-sm text-slate-500">Retry Queue</p><div class="mt-2 text-3xl font-bold text-slate-950" id="retryCount">0</div></div>
  <div class="admin-panel-card"><p class="text-sm text-slate-500">Success</p><div class="mt-2 text-3xl font-bold text-slate-950" id="successCount">0</div></div>
  <div class="admin-panel-card"><p class="text-sm text-slate-500">Failure Rate</p><div class="mt-2 text-3xl font-bold text-slate-950" id="failureRate">0%</div></div>
 </section>

 <section class="grid grid-cols-1 gap-4 xl:grid-cols-3">
  <div class="admin-panel-card xl:col-span-3">
   <div class="mb-4 flex items-center justify-between gap-2">
    <h2 class="text-lg font-semibold text-slate-950">Buffered Notifications</h2>
    <div class="flex flex-wrap gap-2">
     <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" data-action="refresh-buffer">Refresh</button>
     <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" data-action="clear-expired-cache">Clear Expired</button>
     <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-100" data-action="clear-all-buffer">Clear All</button>
    </div>
   </div>
   <div class="overflow-x-auto">
    <table class="table">
     <thead><tr><th>ID</th><th>Title</th><th>Saved At</th><th>Status</th><th>Action</th></tr></thead>
     <tbody id="bufferedTable"><tr><td colspan="5" class="py-4 text-center text-slate-500">Loading...</td></tr></tbody>
    </table>
   </div>
  </div>

  <div class="admin-panel-card xl:col-span-3">
   <div class="mb-4 flex items-center justify-between gap-2">
    <h2 class="text-lg font-semibold text-slate-950">Retry Queue</h2>
    <div class="flex flex-wrap gap-2">
     <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" data-action="filter-retry-queue" data-filter="all">All</button>
     <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" data-action="filter-retry-queue" data-filter="pending">Pending</button>
     <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" data-action="filter-retry-queue" data-filter="failed">Failed</button>
    </div>
   </div>
   <div class="overflow-x-auto">
    <table class="table">
     <thead><tr><th>ID</th><th>Notification</th><th>Retry</th><th>Next Retry</th><th>Status</th><th>Action</th></tr></thead>
     <tbody id="retryQueueTable"><tr><td colspan="6" class="py-4 text-center text-slate-500">Loading...</td></tr></tbody>
    </table>
   </div>
  </div>

  <div class="admin-panel-card xl:col-span-3">
   <div class="mb-4 flex items-center justify-between gap-2">
    <h2 class="text-lg font-semibold text-slate-950">Delivery History</h2>
    <div class="flex flex-wrap gap-2">
     <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" data-action="filter-history" data-filter="all">All</button>
     <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" data-action="filter-history" data-filter="success">Success</button>
     <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" data-action="filter-history" data-filter="failed">Failed</button>
    </div>
   </div>
   <div class="overflow-x-auto">
    <table class="table">
     <thead><tr><th>Time</th><th>Notification</th><th>Retry</th><th>Status</th><th>Error</th></tr></thead>
     <tbody id="deliveryHistoryTable"><tr><td colspan="5" class="py-4 text-center text-slate-500">Loading...</td></tr></tbody>
    </table>
   </div>
  </div>
 </section>

 <div class="modal fade" id="offlineModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
   <div class="modal-content">
    <div class="modal-header">
     <h5 class="modal-title">Offline Mode Simulation</h5>
     <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition" data-brox-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
     <div class="flex items-start gap-2 mb-2">
      <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="radio" name="offlineMode" id="offlineModeQueue" value="queue" checked>
      <label class="text-sm text-slate-700" for="offlineModeQueue">Queue new notifications</label>
     </div>
     <div class="flex items-start gap-2 mb-2">
      <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="radio" name="offlineMode" id="offlineModeRetry" value="retry">
      <label class="text-sm text-slate-700" for="offlineModeRetry">Force retry mode</label>
     </div>
     <div class="flex items-start gap-2">
      <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="radio" name="offlineMode" id="offlineModeDrop" value="drop">
      <label class="text-sm text-slate-700" for="offlineModeDrop">Drop network requests</label>
     </div>
    </div>
    <div class="modal-footer">
     <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" data-brox-dismiss="modal">Close</button>
     <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" data-action="apply-offline-mode">Apply</button>
    </div>
   </div>
  </div>
 </div>
</div>
{% endblock %}
