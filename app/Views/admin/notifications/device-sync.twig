{% extends 'admin/layout.twig' %}
{% block title %}Device Sync Manager{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4" id="deviceSyncRoot">
 <section class="admin-page-header">
  <div class="flex flex-wrap items-end justify-between gap-3">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-smartphone"></i>
     Multi-Device Sync Manager
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Device Sync</h1>
    <p class="mt-2 text-sm text-slate-600">Monitor and control sync state across registered devices.</p>
   </div>
   <div class="flex flex-wrap gap-2">
    <button class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" onclick="manualSync()">
     <i class="lucide lucide-repeat"></i> Manual Sync
    </button>
    <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" onclick="refreshDeviceList()">
     <i class="lucide lucide-refresh-cw"></i> Refresh
    </button>
   </div>
  </div>
 </section>

 <section class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
  <div class="admin-panel-card"><p class="text-sm text-slate-500">Active Devices</p><div class="mt-2 text-3xl font-bold text-slate-950" id="activeDevicesCount">0</div></div>
  <div class="admin-panel-card"><p class="text-sm text-slate-500">Pending Sync</p><div class="mt-2 text-3xl font-bold text-slate-950" id="pendingSyncCount">0</div></div>
  <div class="admin-panel-card"><p class="text-sm text-slate-500">Synced Items</p><div class="mt-2 text-3xl font-bold text-slate-950" id="syncedItemsCount">0</div></div>
  <div class="admin-panel-card"><p class="text-sm text-slate-500">Sync Rate</p><div class="mt-2 text-3xl font-bold text-slate-950" id="syncRatePercent">0%</div></div>
 </section>

 <section class="admin-panel-card">
  <div class="flex items-start gap-2">
   <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" id="autoSyncToggle">
   <label class="text-sm text-slate-700" for="autoSyncToggle">Auto sync every 30 seconds</label>
  </div>
 </section>

 <section class="grid grid-cols-1 gap-4 lg:grid-cols-12">
  <div class="lg:col-span-7">
   <section class="admin-panel-card h-full">
    <div class="mb-4 flex items-center gap-2">
     <i class="lucide lucide-list text-indigo-600"></i>
     <h2 class="text-lg font-semibold text-slate-950">Registered Devices</h2>
    </div>
    <div class="overflow-x-auto">
     <table class="table">
      <thead>
       <tr>
        <th>Device</th>
        <th>ID</th>
        <th>Type</th>
        <th>Last Active</th>
        <th>Actions</th>
       </tr>
      </thead>
      <tbody id="devicesTableBody">
       <tr><td colspan="5" class="py-4 text-center text-slate-500">Loading...</td></tr>
      </tbody>
     </table>
    </div>
   </section>
  </div>
  <div class="lg:col-span-5">
   <section class="admin-panel-card h-full">
    <div class="mb-4 flex items-center justify-between gap-2">
     <h2 class="text-lg font-semibold text-slate-950">Sync Logs</h2>
     <div class="flex flex-wrap gap-2">
      <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" onclick="filterSyncLog('all')">All</button>
      <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" onclick="filterSyncLog('sync')">Sync</button>
      <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" onclick="filterSyncLog('read')">Read</button>
      <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" onclick="clearSyncLog()">Clear</button>
     </div>
    </div>
    <div class="overflow-x-auto">
     <table class="table">
      <thead>
       <tr>
        <th>Time</th>
        <th>Action</th>
        <th>Notification</th>
        <th>Device</th>
        <th>Status</th>
       </tr>
      </thead>
      <tbody id="syncLogBody">
       <tr><td colspan="5" class="py-4 text-center text-slate-500">Loading...</td></tr>
      </tbody>
     </table>
    </div>
   </section>
  </div>
 </section>
</div>
{% endblock %}
