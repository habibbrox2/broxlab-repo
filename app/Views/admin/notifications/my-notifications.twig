{% extends 'admin/layout.twig' %}
{% block title %}My Notifications{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
    <!-- Gradient Header -->
    <div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-sky-500 via-indigo-500 to-violet-500 p-6 shadow-lg">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"></div>
        <div class="relative flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/20 backdrop-blur-sm">
                    <i class="lucide lucide-bell text-2xl text-white"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-white sm:text-3xl">My Notifications</h1>
                    <p class="mt-1 text-sm text-indigo-100">Personal and account-targeted notifications for this admin account.</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center rounded-full bg-white/20 px-3 py-1 text-xs font-semibold text-white backdrop-blur-sm">Unread: {{ unread_count|default(0) }}</span>
                {% if unread_count|default(0) > 0 %}
                <button type="button" id="markAllReadBtn" class="inline-flex items-center justify-center gap-2 rounded-lg bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/20"><i class="lucide lucide-check-check"></i> Mark All Read</button>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="flex justify-start">
        <a href="/admin/notifications" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 hover:-translate-y-0.5"><i class="lucide lucide-arrow-left"></i> Back</a>
    </div>

    <!-- Notifications List Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="lucide lucide-list text-indigo-500" style="width:1.125em;height:1.125em;"></i>
                    <h2 class="text-sm font-semibold text-slate-900">Notifications</h2>
                </div>
                <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700">{{ notifications|length }} total</span>
            </div>
        </div>
        <div>
            {% if notifications is not empty %}
            <div class="divide-y divide-slate-100">
                {% for notif in notifications %}
                <div class="px-5 py-4 {% if notif.is_read == 0 %}bg-indigo-50/20{% endif %} transition hover:bg-slate-50/50" data-notification-id="{{ notif.id }}">
                    <div class="flex justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="mb-2 flex flex-wrap items-center gap-2">
                                <strong class="text-slate-900">{{ notif.title|default("Notification") }}</strong>
                                {% if notif.is_read == 0 %}<span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-semibold text-indigo-700">New</span>{% endif %}
                                {% if notif.type is defined and notif.type %}<span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600">{{ notif.type }}</span>{% endif %}
                            </div>
                            <div class="mb-3 text-sm text-slate-600">{{ notif.message|default("") }}</div>
                            <div class="flex flex-wrap gap-2">
                                {% if notif.action_url is defined and notif.action_url %}
                                <a class="inline-flex items-center justify-center gap-2 rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-2 text-xs font-semibold text-indigo-700 transition hover:bg-indigo-100" href="{{ notif.action_url }}"><i class="lucide lucide-arrow-right"></i> Open</a>
                                {% endif %}
                                {% if notif.is_read == 0 %}
                                <button type="button" class="js-mark-read inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" data-id="{{ notif.id }}"><i class="lucide lucide-check"></i> Mark Read</button>
                                {% endif %}
                            </div>
                        </div>
                        <small class="text-nowrap text-slate-400">{{ notif.created_at|date("d M Y H:i") }}</small>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="flex flex-col items-center justify-center py-12 text-center">
                <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-full bg-slate-100">
                    <i class="lucide lucide-inbox text-3xl text-slate-400"></i>
                </div>
                <p class="text-sm font-medium text-slate-600">No notifications found</p>
                <p class="text-xs text-slate-400 mt-1">You're all caught up!</p>
            </div>
            {% endif %}
        </div>
    </div>

    {% if total_pages|default(1) > 1 %}
    <nav class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm" aria-label="Notification pagination">
        <a class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 {% if page|default(1) <= 1 %}pointer-events-none opacity-50{% endif %}" href="?page={{ (page|default(1) - 1) > 0 ? (page|default(1) - 1) : 1 }}">
            <i class="lucide lucide-chevron-left" style="width:0.875em;height:0.875em;"></i> Previous
        </a>
        <span class="text-sm text-slate-500">Page {{ page|default(1) }} of {{ total_pages }}</span>
        <a class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 {% if page|default(1) >= total_pages %}pointer-events-none opacity-50{% endif %}" href="?page={{ (page|default(1) + 1) <= total_pages ? (page|default(1) + 1) : total_pages }}">
            Next <i class="lucide lucide-chevron-right" style="width:0.875em;height:0.875em;"></i>
        </a>
    </nav>
    {% endif %}
</div>
{% endblock %}
{% block scripts %}
<script>
(function () {
 async function postJson(url, payload) {
  const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
  const response = await fetch(url, {
   method: 'POST',
   headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
   body: JSON.stringify(payload || {})
  });
  return response.json().catch(() => ({ success: false }));
 }

 document.querySelectorAll('.js-mark-read').forEach((button) => {
  button.addEventListener('click', async () => {
   const id = Number(button.dataset.id || 0);
   if (!id) return;
   const data = await postJson('/api/notification/mark-read', { notification_id: id });
   if (data && data.success) window.location.reload();
  });
 });

 const markAllBtn = document.getElementById('markAllReadBtn');
 if (!markAllBtn) return;
 markAllBtn.addEventListener('click', async () => {
  const data = await postJson('/api/notification/mark-all-read', {});
  if (data && data.success) window.location.reload();
 });
})();
</script>
{% endblock %}
