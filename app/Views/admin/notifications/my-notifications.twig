{% extends 'admin/layout.twig' %}
{% block title %}My Notifications{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
 <section class="admin-page-header">
  <div class="flex flex-wrap items-end justify-between gap-3">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600"><i class="lucide lucide-bell"></i> Notifications</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">My Notifications</h1>
    <p class="mt-2 text-sm text-slate-600">Personal and account-targeted notifications for this admin account.</p>
   </div>
   <div class="flex items-center gap-2">
    <span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-semibold text-indigo-700">Unread: {{ unread_count|default(0) }}</span>
    {% if unread_count|default(0) > 0 %}
    <button type="button" id="markAllReadBtn" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700"><i class="lucide lucide-check-check"></i> Mark All Read</button>
    {% endif %}
   </div>
  </div>
 </section>

 <div class="flex justify-start">
  <a href="/admin/notifications" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"><i class="lucide lucide-arrow-left"></i> Back</a>
 </div>

 <section class="admin-panel-card">
  {% if notifications is not empty %}
  <div class="divide-y divide-slate-200">
   {% for notif in notifications %}
   <div class="py-4 {% if notif.is_read == 0 %}bg-slate-50{% endif %}" data-notification-id="{{ notif.id }}">
    <div class="flex justify-between gap-3">
     <div class="min-w-0 flex-1">
      <div class="mb-2 flex flex-wrap items-center gap-2">
       <strong class="text-slate-950">{{ notif.title|default("Notification") }}</strong>
       {% if notif.is_read == 0 %}<span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-semibold text-indigo-700">New</span>{% endif %}
       {% if notif.type is defined and notif.type %}<span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">{{ notif.type }}</span>{% endif %}
      </div>
      <div class="mb-3 text-sm text-slate-600">{{ notif.message|default("") }}</div>
      <div class="flex flex-wrap gap-2">
       {% if notif.action_url is defined and notif.action_url %}
       <a class="inline-flex items-center justify-center gap-2 rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-2 text-xs font-semibold text-indigo-700 transition hover:bg-indigo-100" href="{{ notif.action_url }}"><i class="lucide lucide-arrow-right"></i> Open</a>
       {% endif %}
       {% if notif.is_read == 0 %}
       <button type="button" class="js-mark-read inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" data-id="{{ notif.id }}"><i class="lucide lucide-check"></i> Mark Read</button>
       {% endif %}
      </div>
     </div>
     <small class="text-nowrap text-slate-500">{{ notif.created_at|date("d M Y H:i") }}</small>
    </div>
   </div>
   {% endfor %}
  </div>
  {% else %}
  <div class="py-10 text-center text-slate-500"><i class="lucide lucide-inbox mb-2 block text-4xl"></i>No notifications found.</div>
  {% endif %}
 </section>

 {% if total_pages|default(1) > 1 %}
 <nav class="mt-3" aria-label="Notification pagination">
  <ul class="pagination">
   <li class="page-item {% if page|default(1) <= 1 %}disabled{% endif %}"><a class="page-link" href="?page={{ (page|default(1) - 1) > 0 ? (page|default(1) - 1) : 1 }}">Previous</a></li>
   <li class="page-item disabled"><span class="page-link">Page {{ page|default(1) }} of {{ total_pages }}</span></li>
   <li class="page-item {% if page|default(1) >= total_pages %}disabled{% endif %}"><a class="page-link" href="?page={{ (page|default(1) + 1) <= total_pages ? (page|default(1) + 1) : total_pages }}">Next</a></li>
  </ul>
 </nav>
 {% endif %}
</div>
{% endblock %}
{% block scripts %}
<script>
(function () {
 async function postJson(url, payload) {
  const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
  const response = await fetch(url, {
   method: 'POST',
   headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
   body: JSON.stringify(payload || {})
  });
  return response.json().catch(() => ({ success: false }));
 }

 document.querySelectorAll('.js-mark-read').forEach((button) => {
  button.addEventListener('click', async () => {
   const id = Number(button.dataset.id || 0);
   if (!id) return;
   const data = await postJson('/api/notification/mark-read', { notification_id: id });
   if (data && data.success) window.location.reload();
  });
 });

 const markAllBtn = document.getElementById('markAllReadBtn');
 if (!markAllBtn) return;
 markAllBtn.addEventListener('click', async () => {
  const data = await postJson('/api/notification/mark-all-read', {});
  if (data && data.success) window.location.reload();
 });
})();
</script>
{% endblock %}
