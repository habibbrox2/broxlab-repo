{% extends"admin/layout.twig" %}
{% block title %}Notifications Kill Switch{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4">
 <section class="admin-page-header">
  <div>
   <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
    <i class="lucide lucide-toggle-right"></i>
    Notifications Safety
   </p>
   <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Kill Switch Control</h1>
   <p class="mt-2 text-sm text-slate-600">Stop or resume notifications in an emergency.</p>
  </div>
 </section>

 <section class="admin-panel-card max-w-2xl">
  <div class="mb-4">
   <label class="form-label">Status</label>
   <div>
    <button id="toggleBtn" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition"></button>
   </div>
  </div>
  <div class="mb-4">
   <label class="form-label">Maintenance message</label>
   <textarea id="maintenanceMsg" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" rows="3"></textarea>
  </div>
  <div>
   <button id="saveBtn" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700"><i class="lucide lucide-save"></i> Save</button>
  </div>
 </section>
</div>
{% endblock %}
