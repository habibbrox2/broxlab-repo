{% extends 'admin/layout.twig' %}
{% block title %}Draft Notifications - Admin Panel{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
 <section class="admin-page-header">
  <div class="flex flex-wrap items-end justify-between gap-3">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-file-text"></i>
     Draft Notifications
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Notification Drafts</h1>
    <p class="mt-2 text-sm text-slate-600">Manage notification drafts.</p>
   </div>
   <a href="/admin/notifications/send" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
    <i class="lucide lucide-plus-circle"></i> Create New Notification
   </a>
  </div>
 </section>

 <div class="flex items-center justify-between gap-3">
  <a href="/admin/notifications" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
   <i class="lucide lucide-arrow-left"></i> Go Back
  </a>
 </div>

 <section class="admin-panel-card">
  <div id="draftsList">
   <div class="flex items-center justify-center py-12 text-slate-500">
    <div class="inline-spinner" role="status">
     <span class="sr-only">Loading drafts...</span>
    </div>
   </div>
  </div>
 </section>
</div>

<div class="modal fade" id="editDraftModal" tabindex="-1">
 <div class="modal-dialog modal-lg">
  <div class="modal-content">
   <div class="modal-header">
    <h5 class="modal-title">Edit Draft Notification</h5>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition" data-brox-dismiss="modal"></button>
   </div>
   <div class="modal-body">
    <form id="editDraftForm">
     <input type="hidden" id="editDraftId">
     <div class="mb-3">
      <label class="form-label">Title</label>
      <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="editTitle" required>
     </div>
     <div class="mb-3">
      <label class="form-label">Message</label>
      <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="editMessage" rows="4" required></textarea>
     </div>
     <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div>
       <label class="form-label">Type</label>
       <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="editType">
        <option value="general">General</option>
        <option value="promotion">Promotion</option>
        <option value="announcement">Announcement</option>
        <option value="update">Update</option>
        <option value="warning">Warning</option>
        <option value="urgent">Urgent</option>
       </select>
      </div>
      <div>
       <label class="form-label">Recipient Type</label>
       <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="editRecipientType">
        <option value="all">All Recipients</option>
        <option value="guest">Guest Users</option>
        <option value="specific">Specific Users</option>
        <option value="role">Role</option>
        <option value="permission">Permission</option>
       </select>
      </div>
     </div>
     <div class="mb-3 mt-3">
      <label class="form-label">Action URL (Optional)</label>
      <input type="url" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="editActionUrl" placeholder="/path/to/action">
     </div>
    </form>
   </div>
   <div class="modal-footer">
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" data-brox-dismiss="modal">Cancel</button>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" data-action="save-draft"><i class="lucide lucide-save"></i> Save Changes</button>
   </div>
  </div>
 </div>
</div>
{% endblock %}
