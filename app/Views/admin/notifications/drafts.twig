{% extends 'admin/layout.twig' %}
{% block title %}Draft Notifications - Admin Panel{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">

  <!-- Gradient Header -->
  <div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 sm:p-8 shadow-lg">
   <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/5 blur-3xl"></div>
   <div class="pointer-events-none absolute -bottom-8 left-1/3 h-28 w-28 rounded-full bg-indigo-400/10 blur-2xl"></div>
   <div class="relative flex flex-wrap items-end justify-between gap-4">
    <div class="flex items-start gap-4">
     <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur-sm">
      <i class="lucide lucide-file-text text-2xl text-white"></i>
     </div>
     <div>
      <h1 class="text-2xl font-bold text-white sm:text-3xl">Notification Drafts</h1>
      <p class="mt-1 text-sm text-indigo-200/80">Manage and edit your draft notifications.</p>
     </div>
    </div>
    <div class="flex flex-wrap gap-2">
     <a href="/admin/notifications/send" class="inline-flex items-center gap-2 rounded-lg bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/20 hover:-translate-y-0.5">
      <i class="lucide lucide-plus-circle" style="width:1em;height:1em;"></i> Create New
     </a>
     <a href="/admin/notifications" class="inline-flex items-center gap-2 rounded-lg bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/20 hover:-translate-y-0.5">
      <i class="lucide lucide-arrow-left" style="width:1em;height:1em;"></i> Go Back
     </a>
    </div>
   </div>
  </div>

  <!-- Drafts List Card -->
  <div class="rounded-xl border border-slate-200/80 bg-white shadow-sm overflow-hidden">
   <div class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-3">
    <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
     <i class="lucide lucide-file-text" style="width:0.875em;height:0.875em;"></i>
    </div>
    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">Draft Notifications</h2>
   </div>
   <div class="p-5">
    <div id="draftsList">
     <div class="flex flex-col items-center justify-center py-12 text-slate-500">
      <div class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-solid border-indigo-600 border-r-transparent" role="status">
       <span class="sr-only">Loading drafts...</span>
      </div>
      <p class="mt-3 text-sm text-slate-500">Loading drafts...</p>
     </div>
    </div>
   </div>
  </div>
</div>

<!-- Edit Draft Modal -->
<div class="fixed inset-0 z-50 hidden" id="editDraftModal" tabindex="-1">
 <div class="fixed inset-0 bg-black/50 backdrop-blur-sm transition-opacity" data-brox-dismiss="modal"></div>
 <div class="fixed inset-0 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-3xl overflow-hidden" role="dialog" aria-modal="true">
   <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200 bg-gradient-to-r from-indigo-50/50 to-violet-50/50">
    <h5 class="text-lg font-semibold text-slate-900 m-0">Edit Draft</h5>
    <button type="button" class="w-8 h-8 flex items-center justify-center border-0 bg-transparent text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg transition-all duration-150 cursor-pointer" data-brox-dismiss="modal">
     <i class="lucide lucide-x text-lg"></i>
    </button>
   </div>
   <div class="p-6">
    <form id="editDraftForm">
     <input type="hidden" id="editDraftId">
     <div class="mb-4">
      <label class="block text-sm font-medium text-slate-700 mb-1.5">Title <span class="text-rose-500">*</span></label>
      <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="editTitle" required>
     </div>
     <div class="mb-4">
      <label class="block text-sm font-medium text-slate-700 mb-1.5">Message <span class="text-rose-500">*</span></label>
      <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="editMessage" rows="4" required></textarea>
     </div>
     <div class="grid grid-cols-1 gap-4 md:grid-cols-2 mb-4">
      <div>
       <label class="block text-sm font-medium text-slate-700 mb-1.5">Type</label>
       <select class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="editType">
        <option value="general">General</option>
        <option value="promotion">Promotion</option>
        <option value="announcement">Announcement</option>
        <option value="update">Update</option>
        <option value="warning">Warning</option>
        <option value="urgent">Urgent</option>
       </select>
      </div>
      <div>
       <label class="block text-sm font-medium text-slate-700 mb-1.5">Recipient Type</label>
       <select class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="editRecipientType">
        <option value="all">All Recipients</option>
        <option value="guest">Guest Users</option>
        <option value="specific">Specific Users</option>
        <option value="role">Role</option>
        <option value="permission">Permission</option>
       </select>
      </div>
     </div>
     <div class="mb-4">
      <label class="block text-sm font-medium text-slate-700 mb-1.5">Action URL (Optional)</label>
      <input type="url" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="editActionUrl" placeholder="/path/to/action">
     </div>
    </form>
   </div>
   <div class="flex items-center justify-end gap-2 px-6 py-4 border-t border-slate-200 bg-slate-50 rounded-b-xl">
    <button type="button" class="inline-flex items-center px-4 py-2 rounded-lg border border-slate-300 bg-white text-slate-700 text-sm font-semibold hover:bg-slate-100 transition-all" data-brox-dismiss="modal">Cancel</button>
    <button type="button" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 transition-all shadow-sm active:scale-[0.97]" data-action="save-draft">
     <i class="lucide lucide-save" style="width:1em;height:1em;"></i> Save Changes
    </button>
   </div>
  </div>
 </div>
</div>
{% endblock %}
