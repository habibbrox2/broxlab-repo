{% extends"admin/layout.twig" %}
{% block title %}Send By Topic{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
    <!-- Gradient Header -->
    <div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-sky-500 via-indigo-500 to-violet-500 p-6 shadow-lg">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"></div>
        <div class="relative flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/20 backdrop-blur-sm">
                <i class="lucide lucide-broadcast text-2xl text-white"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-white sm:text-3xl">Send Notification By Topic</h1>
                <p class="mt-1 text-sm text-indigo-100">Target every subscriber of a topic with a single notification.</p>
            </div>
        </div>
    </div>

    <!-- Send Form Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden max-w-3xl">
        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
            <div class="flex items-center gap-2">
                <i class="lucide lucide-send text-indigo-500" w-[18px] h-[18px]></i>
                <h2 class="text-sm font-semibold text-slate-900">Send Notification</h2>
            </div>
        </div>
        <div class="p-5">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Topic</label>
                    <select id="topicSelect" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"></select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Title</label>
                    <input id="title" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Message</label>
                    <textarea id="message" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" rows="4"></textarea>
                </div>
                <div class="flex justify-end">
                    <button id="sendBtn" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700"><i class="lucide lucide-send"></i> Send</button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
