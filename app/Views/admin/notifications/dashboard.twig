{% extends 'admin/layout.twig' %}
{% block title %}Notifications Dashboard{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="space-y-6" id="notificationsDashboardRealtime">
 <section class="admin-page-header">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-bell-off"></i>
     Notifications
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Notifications Dashboard</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600">Real-time monitoring, delivery metrics, and notification operations.</p>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/notifications/send" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700"><i class="lucide lucide-send"></i> Send</a>
    <a href="/admin/notifications/list" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"><i class="lucide lucide-list-checks"></i> All Notifications</a>
   </div>
  </div>
 </section>

 <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <div class="admin-panel-card"><p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-600">Sent Today</p><div class="mt-2 text-3xl font-bold text-slate-950" id="sentToday">{{ stats.sent_today|default(0) }}</div><p class="mt-1 text-sm text-slate-500">+0%</p></div>
  <div class="admin-panel-card"><p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600">Open Rate</p><div class="mt-2 text-3xl font-bold text-slate-950" id="openRate">{{ stats.open_rate|default(0) }}%</div><p class="mt-1 text-sm text-slate-500">+0%</p></div>
  <div class="admin-panel-card"><p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-600">Scheduled Pending</p><div class="mt-2 text-3xl font-bold text-slate-950" id="scheduledPending">{{ stats.scheduled_pending|default(0) }}</div><p class="mt-1 text-sm text-slate-500">Next run: <span id="nextScheduledTime">--</span></p></div>
  <div class="admin-panel-card"><p class="text-xs font-semibold uppercase tracking-[0.2em] text-indigo-600">System Health</p><div class="mt-2 text-3xl font-bold text-slate-950" id="systemHealth">OK</div><p class="mt-1 text-sm text-slate-500" id="systemHealthDetail">No incidents detected</p></div>
 </section>

 <section class="admin-panel-card">
  <div class="border-b border-slate-200/80 pb-4">
   <h2 class="text-lg font-semibold text-slate-950">Quick Actions</h2>
   <p class="mt-1 text-sm text-slate-500">High frequency actions for operators.</p>
  </div>
  <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
   <a href="/admin/notifications/send" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700"><i class="lucide lucide-send"></i> Send</a>
   <a href="/admin/notifications/scheduled" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"><i class="lucide lucide-calendar"></i> Scheduled</a>
   <a href="/admin/notifications/device-sync" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"><i class="lucide lucide-smartphone"></i> Device Sync</a>
   <a href="/admin/notifications/offline-handler" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"><i class="lucide lucide-wifi-off"></i> Offline</a>
  </div>
 </section>

 <section class="admin-panel-card">
  <ul class="flex flex-wrap gap-1 border-b border-slate-200 pb-0" role="tablist">
   <li><button class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-indigo-600 px-4 py-2.5 text-sm font-semibold text-indigo-700 transition" data-brox-toggle="tab" data-brox-target="#overview" type="button"><i class="lucide lucide-gauge"></i>Overview</button></li>
   <li><button class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-300 hover:text-slate-900" data-brox-toggle="tab" data-brox-target="#recent" type="button"><i class="lucide lucide-clock"></i>Recent</button></li>
   <li><button class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-300 hover:text-slate-900" data-brox-toggle="tab" data-brox-target="#features" type="button"><i class="lucide lucide-star"></i>Features</button></li>
  </ul>

  <div class="pt-5 tab-content">
   <div class="tab-pane fade show active" id="overview">
    <div class="grid gap-4 lg:grid-cols-2">
     <div class="admin-panel-card">
      <h3 class="text-base font-semibold text-slate-950">Delivery Overview</h3>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
       <div class="rounded-2xl bg-slate-50 p-4"><div class="text-sm text-slate-500">Total Sent</div><div class="mt-1 text-2xl font-semibold text-slate-950">{{ stats.total_sent|default(0) }}</div></div>
       <div class="rounded-2xl bg-slate-50 p-4"><div class="text-sm text-slate-500">Delivered</div><div class="mt-1 text-2xl font-semibold text-emerald-600">{{ stats.delivered|default(0) }}</div></div>
       <div class="rounded-2xl bg-slate-50 p-4"><div class="text-sm text-slate-500">Failed</div><div class="mt-1 text-2xl font-semibold text-rose-600">{{ stats.failed|default(0) }}</div></div>
       <div class="rounded-2xl bg-slate-50 p-4"><div class="text-sm text-slate-500">Pending</div><div class="mt-1 text-2xl font-semibold text-amber-600">{{ stats.pending|default(0) }}</div></div>
      </div>
     </div>
     <div class="admin-panel-card">
      <h3 class="text-base font-semibold text-slate-950">Feature Status</h3>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
       <div class="rounded-2xl bg-slate-50 p-4 text-center"><i class="lucide lucide-calendar mb-2 block text-2xl text-amber-500"></i><div class="text-sm font-medium text-slate-600">Scheduler</div><span class="mt-2 inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700">Active</span></div>
       <div class="rounded-2xl bg-slate-50 p-4 text-center"><i class="lucide lucide-smartphone mb-2 block text-2xl text-sky-500"></i><div class="text-sm font-medium text-slate-600">Multi-Device</div><span class="mt-2 inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700">Active</span></div>
       <div class="rounded-2xl bg-slate-50 p-4 text-center"><i class="lucide lucide-wifi-off mb-2 block text-2xl text-slate-500"></i><div class="text-sm font-medium text-slate-600">Offline</div><span class="mt-2 inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700">Active</span></div>
       <div class="rounded-2xl bg-slate-50 p-4 text-center"><i class="lucide lucide-key mb-2 block text-2xl text-indigo-500"></i><div class="text-sm font-medium text-slate-600">Security</div><span class="mt-2 inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700">Active</span></div>
      </div>
     </div>
    </div>
   </div>

   <div class="tab-pane fade" id="recent">
    <div class="overflow-x-auto">
     <table class="table">
      <thead><tr><th>Title</th><th>Type</th><th>Status</th><th>Created</th><th class="text-center">Actions</th></tr></thead>
      <tbody>
       {% for n in recent_notifications|default([]) %}
       <tr>
        <td data-label="Title" class="font-medium text-slate-900">{{ n.title }}</td>
        <td data-label="Type"><span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-semibold text-indigo-700">{{ n.type }}</span></td>
        <td data-label="Status">{{ n.status|default('pending') }}</td>
        <td data-label="Created" class="text-slate-500">{{ n.created_at|date("d M Y H:i") }}</td>
        <td data-label="Actions" class="text-center"><a href="/admin/notifications/view?id={{ n.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50">View</a></td>
       </tr>
       {% else %}
       <tr><td colspan="5" class="py-8 text-center text-slate-500">No recent notifications.</td></tr>
       {% endfor %}
      </tbody>
     </table>
    </div>
   </div>

   <div class="tab-pane fade" id="features">
    <div class="grid gap-4 lg:grid-cols-3">
     <div class="admin-panel-card"><h3 class="text-base font-semibold text-slate-950">Operational tools</h3><p class="mt-2 text-sm text-slate-500">Delivery monitoring, scheduling, and device sync stay accessible from the same interface.</p></div>
     <div class="admin-panel-card"><h3 class="text-base font-semibold text-slate-950">Status visibility</h3><p class="mt-2 text-sm text-slate-500">Operators can check system health and delivery state at a glance.</p></div>
     <div class="admin-panel-card"><h3 class="text-base font-semibold text-slate-950">Future-friendly</h3><p class="mt-2 text-sm text-slate-500">This section keeps the layout ready for charts and live telemetry widgets.</p></div>
    </div>
   </div>
  </div>
 </section>
</div>
{% endblock %}
{% block scripts %}{% endblock %}
