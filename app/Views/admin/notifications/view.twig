{% extends 'admin/layout.twig' %}
{% block title %}Notification Details - Admin Panel{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
 <section class="admin-page-header">
  <div class="flex flex-wrap items-end justify-between gap-3">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-bell"></i>
     Notification Details
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Notification #{{ notification.id }}</h1>
    <p class="mt-2 text-sm text-slate-600">View notification details.</p>
   </div>
   <a href="/admin/notifications/list" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
    <i class="lucide lucide-arrow-left"></i> Back to List
   </a>
  </div>
 </section>

 <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
  <div class="lg:col-span-8 space-y-4">
   <section class="admin-panel-card">
    <h2 class="mb-4 text-lg font-semibold text-slate-950">Notification Information</h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
     <div><p class="text-xs uppercase tracking-[0.2em] text-slate-500">Title</p><p class="mt-1 text-lg font-semibold text-slate-950">{{ notification.title }}</p></div>
     <div><p class="text-xs uppercase tracking-[0.2em] text-slate-500">Type</p><span class="mt-1 inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-semibold text-indigo-700">{{ notification.type }}</span></div>
    </div>
    <div class="mt-4">
     <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Message</p>
     <p class="mt-1 rounded-lg bg-slate-50 p-4 text-sm text-slate-700">{{ notification.message }}</p>
    </div>
    <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
     <div><p class="text-xs uppercase tracking-[0.2em] text-slate-500">Created At</p><p class="mt-1 text-sm text-slate-700">{{ notification.created_at|date("d M Y H:i:s") }}</p></div>
     <div><p class="text-xs uppercase tracking-[0.2em] text-slate-500">Status</p><span class="mt-1 inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {% if notification.sent_to_all_at %}bg-emerald-100 text-emerald-700{% elseif notification.status == 'draft' %}bg-amber-100 text-amber-700{% else %}bg-slate-100 text-slate-700{% endif %}">{% if notification.sent_to_all_at %}Sent{% elseif notification.status == 'draft' %}Draft{% else %}Pending{% endif %}</span></div>
    </div>
    {% if notification.action_url %}
    <div class="mt-4">
     <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Action URL</p>
     <a href="{{ notification.action_url }}" target="_blank" class="mt-1 break-all text-sm text-indigo-600 hover:underline">{{ notification.action_url }}</a>
    </div>
    {% endif %}
   </section>

   <section class="admin-panel-card">
    <h2 class="mb-4 text-lg font-semibold text-slate-950">Delivery Statistics</h2>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 text-center">
     <div><div class="text-3xl font-bold text-indigo-600">{{ statistics.total ?? 0 }}</div><p class="mt-1 text-sm text-slate-500">Total Recipients</p></div>
     <div><div class="text-3xl font-bold text-emerald-600">{{ statistics.sent ?? 0 }}</div><p class="mt-1 text-sm text-slate-500">Delivered</p></div>
     <div><div class="text-3xl font-bold text-rose-600">{{ statistics.failed ?? 0 }}</div><p class="mt-1 text-sm text-slate-500">Failed</p></div>
     <div><div class="text-3xl font-bold text-amber-600">{% if statistics.total > 0 %}{{ ((statistics.sent ?? 0) / (statistics.total ?? 1) * 100)|round(1) }}%{% else %}0%{% endif %}</div><p class="mt-1 text-sm text-slate-500">Success Rate</p></div>
    </div>
    <div class="mt-4 overflow-hidden rounded-full bg-slate-100">
     {% if statistics.total > 0 %}
     <div class="flex h-3">
      <div class="bg-emerald-500" style="width: {{ (statistics.sent ?? 0) / (statistics.total ?? 1) * 100 }}%"></div>
      <div class="bg-rose-500" style="width: {{ (statistics.failed ?? 0) / (statistics.total ?? 1) * 100 }}%"></div>
     </div>
     {% endif %}
    </div>
   </section>

   <section class="admin-panel-card">
    <h2 class="mb-4 flex items-center gap-2 text-lg font-semibold text-slate-950"><i class="lucide lucide-list text-indigo-600"></i> Delivery Logs (Total: {{ delivery_logs|length }})</h2>
    {% if delivery_logs|length > 0 %}
    <div class="overflow-x-auto">
     <table class="table">
      <thead>
       <tr>
        <th width="10%">ID</th>
        <th width="15%">User</th>
        <th width="25%">Device/Token</th>
        <th width="15%">Channel</th>
        <th width="15%">Status</th>
        <th width="20%">Time</th>
       </tr>
      </thead>
      <tbody>
       {% for log in delivery_logs|slice(0, 50) %}
       <tr>
        <td>#{{ log.id }}</td>
        <td>{% if log.user_id %}<a href="/admin/users/edit?id={{ log.user_id }}" class="text-indigo-600 hover:underline">User #{{ log.user_id }}</a>{% else %}<span class="text-slate-500">Guest</span>{% endif %}</td>
        <td><small class="text-slate-500" title="{{ log.token }}">{{ log.device_id ?? (log.token|slice(0, 20) ~ '...') }}</small></td>
        <td><span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">{{ log.channel ?? 'push' }}</span></td>
        <td><span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {{ log.status == 'sent' ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700' }}">{{ log.status|upper }}</span></td>
        <td><small class="text-slate-500">{{ log.created_at|date("d M H:i:s") }}</small></td>
       </tr>
       {% endfor %}
      </tbody>
     </table>
    </div>
    {% if delivery_logs|length > 50 %}
    <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
     <i class="lucide lucide-info mr-2"></i> Showing first 50 logs out of: {{ delivery_logs|length }}
    </div>
    {% endif %}
    {% else %}
    <div class="py-8 text-center text-slate-500">
     <i class="lucide lucide-inbox mb-3 block text-3xl"></i>
     No delivery logs found
    </div>
    {% endif %}
   </section>
  </div>

  <div class="lg:col-span-4 space-y-4">
   <section class="admin-panel-card">
    <h2 class="mb-4 text-lg font-semibold text-slate-950">Quick Actions</h2>
    <div class="space-y-2">
     <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" data-action="resend-notification"><i class="lucide lucide-refresh-cw"></i> Resend Notification</button>
     <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" data-action="duplicate-notification"><i class="lucide lucide-files"></i> Duplicate Notification</button>
     <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-700" data-action="delete-notification"><i class="lucide lucide-trash-2"></i> Delete</button>
    </div>
   </section>

   <section class="admin-panel-card">
    <h2 class="mb-4 text-lg font-semibold text-slate-950">Metadata</h2>
    <div class="space-y-3 text-sm text-slate-700">
     <div><strong>Notification ID:</strong> #{{ notification.id }}</div>
     <div><strong>Created By:</strong> {% if notification.created_by %}<a href="/admin/users/edit?id={{ notification.created_by }}" class="text-indigo-600 hover:underline">User #{{ notification.created_by }}</a>{% else %}System{% endif %}</div>
     <div><strong>Created At:</strong> {{ notification.created_at|date("d M Y H:i:s") }}</div>
     <div><strong>Last Updated:</strong> {{ notification.updated_at|date("d M Y H:i:s") }}</div>
    </div>
   </section>
  </div>
 </div>

 <div id="notification-view-data" data-notification-id="{{ notification.id }}"></div>
</div>
{% endblock %}
