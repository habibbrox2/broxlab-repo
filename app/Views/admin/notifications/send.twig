{% extends 'admin/layout.twig' %}
{% block title %}Send Notification - Admin Panel{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block stylesheets %}{{ parent() }}{% endblock %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <!-- Page Header -->
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-bell mr-2"></i>
 Send Notification
 </div>
 <div>Create and send notifications</div>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
 <div class="col-span-12">
 <a href="/admin/notifications"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs inline-flex text-slate-600 hover:bg-slate-100 mb-3">
 <i class="lucide lucide-arrow-left mr-1"></i>Back
 </a>
 <h2 class="mb-0">
 <i class="lucide lucide-send mr-2"></i>Send Notification
 </h2>
 <small class="text-slate-500">Create and send notifications to users, in-app or via push</small>
 </div>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="lg:col-span-8">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3">
 <h5 class="mb-0">Notification Form</h5>
 </div>
 <div class="p-4">
 <form id="notificationForm" class="needs-validation">
 <!-- Recipient Selection -->
 <div class="mb-3">
 <label for="recipientType" class="form-label font-bold">
 Select Recipients <span class="text-red-600">*</span>
 </label>
 <select id="recipientType" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" required>
 <option value="">-- Select Recipient Type --</option>
 <option value="all" selected>All Recipients (Users + Guests)</option>
 <option value="guest">Only Guest Users</option>
 <option value="specific">Specific Users</option>
 <option value="role">By Role</option>
 <option value="permission">By Permission</option>
 </select>
 <small class="text-slate-500 block mt-2">
 <i class="lucide lucide-info"></i>
 <strong>All Recipients:</strong> This will send to all users and guest devices
 </small>
 <div id="recipientInfo"></div>
 </div>
 <!-- Specific User Selection -->
 <div id="specificUserDiv" class="mb-3 ">
 <label for="specificUsers" class="form-label font-bold">Select Specific Users</label>
 <select id="specificUsers" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" multiple size="5">
 <option value="">-- Loading users --</option>
 </select>
 <small class="text-slate-500 block mt-2">
 <i class="lucide lucide-info"></i> Hold Ctrl/Cmd to select multiple users
 </small>
 </div>
 <!-- Role Selection -->
 <div id="roleDiv" class="mb-3 ">
 <label for="roleSelect" class="form-label font-bold">Select Role</label>
 <select id="roleSelect" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
 <option value="">-- Select Role --</option>
 </select>
 </div>
 <!-- Permission Selection -->
 <div id="permissionDiv" class="mb-3 ">
 <label for="permissionSelect" class="form-label font-bold">Select Permission</label>
 <select id="permissionSelect" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
 <option value="">-- Select Permission --</option>
 </select>
 </div>
 <!-- Recipient Preview -->
 <div id="recipientPreview" class="mb-3 ">
 <div class="recipient-preview-rounded-xl border border-slate-200 bg-white shadow-sm">
 <div class="recipient-preview-meta">
 <span class="recipient-preview-icon"><i class="lucide lucide-users"></i></span>
 <div>
 <div class="recipient-preview-count">
 Total <span id="recipientCount">0</span> recipients
 </div>
 <p class="recipient-preview-sub">This is the live count based on your current recipient filter.</p>
 </div>
 </div>
 <div class="recipient-preview-actions">
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs inline-flex text-sky-600 hover:bg-sky-100"
 id="previewBtn">
 <i class="lucide lucide-eye mr-1"></i>View Details
 </button>
 </div>
 </div>
 </div>
 <!-- Notification Content -->
 <hr class="my-4">
 <h5 class="mb-3">Notification Content</h5>
 <div class="mb-3">
 <label for="notificationTemplate" class="form-label font-bold">
 Notification Template (Optional)
 </label>
 <select id="notificationTemplate" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
 <option value="">-- Manual Custom Message --</option>
 {% for template in notification_templates|default([]) %}
 <option value="{{ template.slug }}"
 data-template-id="{{ template.id }}"
 data-template-vars="{{ template.variables|json_encode|e('html_attr') }}"
 data-template-channels="{{ template.channels|json_encode|e('html_attr') }}">
 {{ template.name }} ({{ template.slug }})
 </option>
 {% endfor %}
 </select>
 <small class="text-slate-500 block mt-1">Selecting a template auto-fills title/message and sends push in template format.</small>
 </div>
 <div class="mb-3" id="templateVariablesWrap" style="display:none;">
 <label for="templateVariables" class="form-label font-bold">
 Template Variables JSON (Optional)
 </label>
 <textarea id="templateVariables"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 rows="3"
 placeholder='{"SERVICE_NAME":"Birth Certificate","REASON":"Missing document"}'></textarea>
 <div class="flex items-center justify-between mt-2">
 <small class="text-slate-500">Valid JSON object format only. Example: {"KEY":"Value"}</small>
 <button type="button"
 id="applyTemplatePreviewBtn"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs inline-flex text-sky-600 hover:bg-sky-100">
 <i class="lucide lucide-wand mr-1"></i>Apply Template
 </button>
 </div>
 </div>
 <div class="mb-3">
 <label for="notificationTitle" class="form-label font-bold">
 Title <span class="text-red-600">*</span>
 </label>
 <input type="text"
 id="notificationTitle"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 placeholder="Example: New Phone Released"
 required
 maxlength="100">
 <small class="text-slate-500 block mt-1">Maximum 100 characters</small>
 </div>
 <div class="mb-3">
 <label for="notificationMessage" class="form-label font-bold">
 Message <span class="text-red-600">*</span>
 </label>
 <textarea id="notificationMessage"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 rows="4"
 placeholder="Write your notification message here..."
 required
 maxlength="500"></textarea>
 <small class="text-slate-500 block mt-1">
 Maximum 500 characters | Words: <span id="wordCount">0</span>
 </small>
 </div>
 <!-- Notification Type -->
 <div class="mb-3">
 <label for="notificationType" class="form-label font-bold">Notification Type</label>
 <select id="notificationType" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
 <option value="general">General</option>
 <option value="promotion">Promotion</option>
 <option value="announcement">Announcement</option>
 <option value="update">Update</option>
 <option value="warning">Warning</option>
 <option value="urgent">Urgent</option>
 </select>
 </div>
 <!-- Action URL -->
 <div class="mb-3">
 <label for="actionUrl" class="form-label font-bold">Action URL (Optional)</label>
 <input type="url"
 id="actionUrl"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 placeholder="https://example.com/page">
 <small class="text-slate-500 block mt-1">Where users will be redirected when they click</small>
 </div>
 <!-- Send Options -->
 <hr class="my-4">
 <h5 class="mb-3">Send Options</h5>
 <div class="mb-3">
 <label class="form-label font-bold">Select Channels</label>
 <div class="flex items-start gap-2">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
 type="checkbox"
 id="channelPush"
 value="push"
 checked>
 <label class="text-sm text-slate-700" for="channelPush">
 <i class="lucide lucide-bell"></i> Push Notification
 </label>
 </div>
 <div class="flex items-start gap-2">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
 type="checkbox"
 id="channelInApp"
 value="in_app"
 checked>
 <label class="text-sm text-slate-700" for="channelInApp">
 <i class="lucide lucide-inbox"></i> In-App Notification
 </label>
 </div>
 <div class="flex items-start gap-2">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
 type="checkbox"
 id="channelEmail"
 value="email">
 <label class="text-sm text-slate-700" for="channelEmail">
 <i class="lucide lucide-mail"></i> Email Notification
 </label>
 </div>
 </div>
 <div class="mb-3">
 <label for="scheduledTime" class="form-label font-bold">Schedule Time (Optional)</label>
 <input type="datetime-local"
 id="scheduledTime"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 placeholder="Example: 2024-12-31T23:59">
 <small class="text-slate-500 block mt-1">Leave empty to send immediately</small>
 </div>
 <div class="flex items-start gap-2 mb-4">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" id="saveDraft">
 <label class="text-sm text-slate-700" for="saveDraft">Save as draft (Don't send now)</label>
 </div>
 <!-- Buttons -->
 <div class="flex gap-2">
 <button type="submit"
 id="submitBtn"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 px-3 py-1.5 text-xs"
 disabled>
 <i class="lucide lucide-check mr-2"></i>Send Notification
 </button>
 <button type="reset" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200 px-3 py-1.5 text-xs">
 <i class="lucide lucide-refresh-cw mr-2"></i>Reset Form
 </button>
 <a href="/admin/notifications"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200 px-3 py-1.5 text-xs ms-auto">
 <i class="lucide lucide-arrow-left mr-2"></i>Go Back
 </a>
 </div>
 </form>
 </div>
 </div>
 </div>
 <!-- Sidebar - Preview & Statistics -->
 <div class="lg:col-span-4">
 <!-- Preview Card -->
 <div class=" border border-slate-200 bg-white shadow-sm mb-3" style="background: #f8f9fa;">
 <div class=" border-slate-200 px-4 py-3 bg-white">
 <h6 class="mb-0"><i class="lucide lucide-smartphone mr-2"></i>Live Preview</h6>
 </div>
 <div class="p-4 flex justify-center items-center" style="min-height: 250px; background-image: radial-gradient(circle at 50% 50%, #e2e8f0 0%, #f8f9fa 100%);">

 <!-- Mobile Push Bubble -->
 <div class="notification-preview bg-white rounded-2xl shadow-sm p-3 w-full relative" style="max-width: 320px; transition: all 0.2s ease;">

 <!-- Header -->
 <div class="flex items-center justify-between mb-2">
 <div class="flex items-center gap-2">
 <div class="bg-indigo-600 rounded text-white flex items-center justify-center" style="width: 20px; height: 20px;">
 <i class="lucide lucide-bell" style="font-size: 0.65rem;"></i>
 </div>
 <span class="small font-semibold text-slate-900" style="font-size: 0.8rem;">App Notification</span>
 </div>
 <span class="small text-slate-500" style="font-size: 0.75rem;">now</span>
 </div>

 <!-- Content -->
 <h6 class="mb-1 font-bold text-slate-900 text-break" id="previewTitle" style="font-size: 0.95rem;">Notification Title</h6>
 <p class="mb-0 text-slate-600 text-break" id="previewMessage" style="font-size: 0.85rem; line-height: 1.4;">Notification message will appear here...</p>

 <!-- Footer Meta -->
 <div class="mt-2 pt-2 border-top">
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-100 text-slate-900 font-normal border" id="previewType">Type: General</span>
 </div>
 </div>

 </div>
 </div>
 <!-- Statistics Card -->
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3">
 <h6 class="mb-0">Statistics</h6>
 </div>
 <div class="p-4">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 text-center">
 <div class="col-span-6 mb-3">
 <div class="h4 text-indigo-600 mb-1" id="totalUsers">0</div>
 <small class="text-slate-500">Total Recipients</small>
 </div>
 <div class="col-span-6">
 <div class="h4 text-emerald-600 mb-1" id="guestUsers">0</div>
 <small class="text-slate-500">Guests</small>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Modal for Recipient Preview -->
 <div class="modal fade" id="recipientModal" tabindex="-1">
 <div class="modal-dialog modal-xl"
 role="dialog"
 aria-labelledby="recipientModalTitle"
 aria-hidden="true">
 <div class="modal-content border-0 shadow-lg">
 <div class=" border-slate-200 px-4 py-3">
 <div>
 <h5 class="modal-title mb-0" id="recipientModalTitle">
 <i class="lucide lucide-users mr-2"></i>Recipient List
 </h5>
 <small class="text-white/70">Recipient preview details</small>
 </div>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-white text-slate-700 hover:bg-slate-100"
 data-brox-dismiss="modal"
 aria-label="Close"></button>
 </div>
 <div class="p-4">
 <div class="recipient-modal-summary">
 <div class="flex items-center gap-2">
 <i class="lucide lucide-shield-check text-emerald-600"></i>
 <small class="text-slate-500 mb-0">Recipient data is generated from current selection.</small>
 </div>
 <span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-semibold text-indigo-700">
 <i class="lucide lucide-users mr-1"></i><span id="recipientTotalCount">0</span> Recipients
 </span>
 </div>
 <div class="recipient-filter-toolbar">
 <div class="recipient-filter-search">
 <input type="text"
 id="recipientSearchInput"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 placeholder="Search by username or email">
 </div>
 <div class="recipient-filter-device">
 <select id="recipientDeviceFilter" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
 <option value="">All Devices</option>
 <option value="web">Web</option>
 <option value="android">Android</option>
 <option value="ios">iOS</option>
 <option value="desktop">Desktop</option>
 </select>
 </div>
 <div class="recipient-filter-clear">
 <button type="button"
 id="recipientFilterReset"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs inline-flex text-slate-600 hover:bg-slate-100">
 <i class="lucide lucide-rotate-ccw mr-1"></i>Clear
 </button>
 </div>
 <div class="recipient-filter-meta">
 <span>Filtered: <strong id="recipientFilteredCount">0</strong></span>
 <small id="recipientFilterHint">Type to narrow recipients</small>
 </div>
 </div>
 <div id="recipientList">
 <div class="text-center text-slate-500 py-5">
 <i class="lucide lucide-hourglass text-4xl block mb-3"></i>
 <div class="font-semibold">Loading recipient preview...</div>
 <small>Please wait</small>
 </div>
 </div>
 </div>
 <div class="modal-footer border-top bg-slate-100">
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200"
 data-brox-dismiss="modal">Close</button>
 </div>
 </div>
 </div>
 </div>
{% endblock %}
