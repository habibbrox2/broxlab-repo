{% extends 'admin/layout.twig' %}
{% block title %}Send Notification - Admin Panel{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block stylesheets %}{{ parent() }}{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4">

 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 text-white shadow-2xl shadow-indigo-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-violet-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-send" style="width:1.5em;height:1.5em;"></i>
    </div>
    <div>
     <h1 class="text-xl font-black tracking-tight sm:text-2xl">Send Notification</h1>
     <p class="mt-1 text-sm text-indigo-200/80">Create and send notifications to users, in-app or via push</p>
    </div>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/notifications" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-arrow-left" style="width:0.875em;height:0.875em;"></i> Back to Dashboard
    </a>
   </div>
  </div>
 </div>

 <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
  {# ── Main Form Card ── #}
  <div class="lg:col-span-8">
   <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
      <i class="lucide lucide-edit" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Notification Form</h2>
      <p class="text-xs text-slate-500">Compose and send notifications</p>
     </div>
    </div>
    <div class="p-5">
     <form id="notificationForm" class="needs-validation">
      <!-- Recipient Selection -->
      <div class="mb-4">
       <label for="recipientType" class="block text-sm font-semibold text-slate-700 mb-1.5">
        Select Recipients <span class="text-rose-500">*</span>
       </label>
       <select id="recipientType" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" required>
        <option value="">-- Select Recipient Type --</option>
        <option value="all" selected>All Recipients (Users + Guests)</option>
        <option value="guest">Only Guest Users</option>
        <option value="specific">Specific Users</option>
        <option value="role">By Role</option>
        <option value="permission">By Permission</option>
       </select>
       <div class="mt-1.5 flex items-start gap-1.5 text-xs text-slate-500">
        <i class="lucide lucide-info shrink-0 mt-0.5" style="width:0.875em;height:0.875em;"></i>
        <span><strong>All Recipients:</strong> This will send to all users and guest devices</span>
       </div>
       <div id="recipientInfo"></div>
      </div>

      <!-- Specific User Selection -->
      <div id="specificUserDiv" class="mb-4 hidden">
       <label for="specificUsers" class="block text-sm font-semibold text-slate-700 mb-1.5">Select Specific Users</label>
       <select id="specificUsers" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" multiple size="5">
        <option value="">-- Loading users --</option>
       </select>
       <p class="mt-1 text-xs text-slate-500"><i class="lucide lucide-info" style="width:0.875em;height:0.875em;"></i> Hold Ctrl/Cmd to select multiple users</p>
      </div>

      <!-- Role Selection -->
      <div id="roleDiv" class="mb-4 hidden">
       <label for="roleSelect" class="block text-sm font-semibold text-slate-700 mb-1.5">Select Role</label>
       <select id="roleSelect" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
        <option value="">-- Select Role --</option>
       </select>
      </div>

      <!-- Permission Selection -->
      <div id="permissionDiv" class="mb-4 hidden">
       <label for="permissionSelect" class="block text-sm font-semibold text-slate-700 mb-1.5">Select Permission</label>
       <select id="permissionSelect" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
        <option value="">-- Select Permission --</option>
       </select>
      </div>

      <!-- Recipient Preview -->
      <div id="recipientPreview" class="mb-4 hidden">
       <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-4">
        <div class="flex items-center gap-3">
         <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-100 text-indigo-600">
          <i class="lucide lucide-users" style="width:1em;height:1em;"></i>
         </div>
         <div>
          <div class="text-sm font-semibold text-slate-900">
           Total <span id="recipientCount">0</span> recipients
          </div>
          <p class="mt-0.5 text-xs text-slate-500">Live count based on your current recipient filter.</p>
         </div>
        </div>
        <button type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-sky-600 shadow-sm transition-all hover:bg-sky-50 hover:-translate-y-0.5" id="previewBtn">
         <i class="lucide lucide-eye" style="width:0.875em;height:0.875em;"></i> View Details
        </button>
       </div>
      </div>

      <hr class="my-5 border-slate-200">

      <h5 class="mb-4 text-sm font-bold text-slate-900">Notification Content</h5>

      <div class="mb-4">
       <label for="notificationTemplate" class="block text-sm font-semibold text-slate-700 mb-1.5">Notification Template (Optional)</label>
       <select id="notificationTemplate" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
        <option value="">-- Manual Custom Message --</option>
        {% for template in notification_templates|default([]) %}
        <option value="{{ template.slug }}"
         data-template-id="{{ template.id }}"
         data-template-vars="{{ template.variables|json_encode|e('html_attr') }}"
         data-template-channels="{{ template.channels|json_encode|e('html_attr') }}">{{ template.name }} ({{ template.slug }})</option>
        {% endfor %}
       </select>
       <p class="mt-1 text-xs text-slate-500">Selecting a template auto-fills title/message and sends push in template format.</p>
      </div>

      <div class="mb-4 hidden" id="templateVariablesWrap">
       <label for="templateVariables" class="block text-sm font-semibold text-slate-700 mb-1.5">Template Variables JSON (Optional)</label>
       <textarea id="templateVariables" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 font-mono" rows="3" placeholder='{"SERVICE_NAME":"Birth Certificate","REASON":"Missing document"}'></textarea>
       <div class="mt-2 flex items-center justify-between">
        <p class="text-xs text-slate-500">Valid JSON object format only. Example: {"KEY":"Value"}</p>
        <button type="button" id="applyTemplatePreviewBtn" class="inline-flex items-center gap-1.5 rounded-lg border border-sky-200 bg-white px-3 py-1.5 text-xs font-semibold text-sky-600 shadow-sm transition-all hover:bg-sky-50 hover:-translate-y-0.5">
         <i class="lucide lucide-wand" style="width:0.875em;height:0.875em;"></i> Apply Template
        </button>
       </div>
      </div>

      <div class="mb-4">
       <label for="notificationTitle" class="block text-sm font-semibold text-slate-700 mb-1.5">Title <span class="text-rose-500">*</span></label>
       <input type="text" id="notificationTitle" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" placeholder="Example: New Phone Released" required maxlength="100">
       <p class="mt-1 text-xs text-slate-500">Maximum 100 characters</p>
      </div>

      <div class="mb-4">
       <label for="notificationMessage" class="block text-sm font-semibold text-slate-700 mb-1.5">Message <span class="text-rose-500">*</span></label>
       <textarea id="notificationMessage" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" rows="4" placeholder="Write your notification message here..." required maxlength="500"></textarea>
       <p class="mt-1 text-xs text-slate-500">Maximum 500 characters | Words: <span id="wordCount">0</span></p>
      </div>

      <div class="mb-4">
       <label for="notificationType" class="block text-sm font-semibold text-slate-700 mb-1.5">Notification Type</label>
       <select id="notificationType" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
        <option value="general">General</option>
        <option value="promotion">Promotion</option>
        <option value="announcement">Announcement</option>
        <option value="update">Update</option>
        <option value="warning">Warning</option>
        <option value="urgent">Urgent</option>
       </select>
      </div>

      <div class="mb-4">
       <label for="actionUrl" class="block text-sm font-semibold text-slate-700 mb-1.5">Action URL (Optional)</label>
       <input type="url" id="actionUrl" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" placeholder="https://example.com/page">
       <p class="mt-1 text-xs text-slate-500">Where users will be redirected when they click</p>
      </div>

      <hr class="my-5 border-slate-200">

      <h5 class="mb-4 text-sm font-bold text-slate-900">Send Options</h5>

      <div class="mb-4 space-y-2">
       <label class="block text-sm font-semibold text-slate-700 mb-1.5">Select Channels</label>
       <div class="flex items-center gap-3">
        <label class="flex items-center gap-2 cursor-pointer">
         <input class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" id="channelPush" value="push" checked>
         <span class="text-sm text-slate-700"><i class="lucide lucide-bell" style="width:1em;height:1em;"></i> Push Notification</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
         <input class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" id="channelInApp" value="in_app" checked>
         <span class="text-sm text-slate-700"><i class="lucide lucide-inbox" style="width:1em;height:1em;"></i> In-App</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
         <input class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" id="channelEmail" value="email">
         <span class="text-sm text-slate-700"><i class="lucide lucide-mail" style="width:1em;height:1em;"></i> Email</span>
        </label>
       </div>
      </div>

      <div class="mb-4">
       <label for="scheduledTime" class="block text-sm font-semibold text-slate-700 mb-1.5">Schedule Time (Optional)</label>
       <input type="datetime-local" id="scheduledTime" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
       <p class="mt-1 text-xs text-slate-500">Leave empty to send immediately</p>
      </div>

      <div class="mb-5">
       <label class="flex items-center gap-2 cursor-pointer">
        <input class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" id="saveDraft">
        <span class="text-sm text-slate-700">Save as draft (Don't send now)</span>
       </label>
      </div>

      <div class="flex flex-wrap items-center gap-3">
       <button type="submit" id="submitBtn" class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 hover:shadow-md active:scale-[0.97]" disabled>
        <i class="lucide lucide-send" style="width:1em;height:1em;"></i> Send Notification
       </button>
       <button type="reset" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-all hover:bg-slate-50 hover:-translate-y-0.5">
        <i class="lucide lucide-refresh-cw" style="width:1em;height:1em;"></i> Reset
       </button>
       <a href="/admin/notifications" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-all hover:bg-slate-50 hover:-translate-y-0.5 ml-auto">
        <i class="lucide lucide-arrow-left" style="width:1em;height:1em;"></i> Go Back
       </a>
      </div>
     </form>
    </div>
   </section>
  </div>

  {# ── Sidebar ── #}
  <div class="lg:col-span-4 space-y-4">
   <!-- Live Preview Card -->
   <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-sky-50/50 to-cyan-50/50 px-4 py-3">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-sky-100 text-sky-600">
      <i class="lucide lucide-smartphone" style="width:1em;height:1em;"></i>
     </div>
     <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Live Preview</h2>
    </div>
    <div class="flex items-center justify-center p-4" style="min-height:250px;background-image:radial-gradient(circle at 50% 50%,#e2e8f0 0%,#f8f9fa 100%);">
     <div class="w-full max-w-xs rounded-2xl bg-white p-4 shadow-sm transition-all duration-200">
      <div class="mb-3 flex items-center justify-between">
       <div class="flex items-center gap-2">
        <div class="flex h-5 w-5 items-center justify-center rounded bg-indigo-600 text-white"><i class="lucide lucide-bell" style="width:0.65em;height:0.65em;"></i></div>
        <span class="text-xs font-semibold text-slate-900">App Notification</span>
       </div>
       <span class="text-xs text-slate-400">now</span>
      </div>
      <h6 class="mb-1 text-sm font-bold text-slate-900 break-words" id="previewTitle">Notification Title</h6>
      <p class="mb-0 text-xs text-slate-600 break-words leading-relaxed" id="previewMessage">Notification message will appear here...</p>
      <div class="mt-3 border-t border-slate-100 pt-2">
       <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600" id="previewType">Type: General</span>
      </div>
     </div>
    </div>
   </section>

   <!-- Statistics Card -->
   <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-4 py-3">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
      <i class="lucide lucide-bar-chart-3" style="width:1em;height:1em;"></i>
     </div>
     <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Statistics</h2>
    </div>
    <div class="p-4">
     <div class="grid grid-cols-2 gap-4 text-center">
      <div>
       <div class="text-2xl font-bold text-indigo-600" id="totalUsers">0</div>
       <p class="mt-1 text-xs text-slate-500">Total Recipients</p>
      </div>
      <div>
       <div class="text-2xl font-bold text-emerald-600" id="guestUsers">0</div>
       <p class="mt-1 text-xs text-slate-500">Guests</p>
      </div>
     </div>
    </div>
   </section>
  </div>
 </div>

 <!-- Recipient Preview Modal -->
 <div class="modal" id="recipientModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog max-w-5xl">
   <div class="modal-content">
    <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
     <div>
      <h5 class="text-sm font-bold text-slate-900" id="recipientModalTitle"><i class="lucide lucide-users mr-2" style="width:1em;height:1em;"></i>Recipient List</h5>
      <p class="mt-0.5 text-xs text-slate-500">Recipient preview details</p>
     </div>
     <button type="button" class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-600" data-brox-dismiss="modal" aria-label="Close">
      <i class="lucide lucide-x" style="width:1em;height:1em;"></i>
     </button>
    </div>
    <div class="p-5">
     <div class="mb-4 flex items-center justify-between">
      <div class="flex items-center gap-2 text-xs text-slate-500">
       <i class="lucide lucide-shield-check text-emerald-600" style="width:1em;height:1em;"></i>
       Recipient data is generated from current selection.
      </div>
      <span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-semibold text-indigo-700">
       <i class="lucide lucide-users mr-1" style="width:0.875em;height:0.875em;"></i><span id="recipientTotalCount">0</span> Recipients
      </span>
     </div>
     <div class="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <input type="text" id="recipientSearchInput" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" placeholder="Search by username or email">
      <select id="recipientDeviceFilter" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
       <option value="">All Devices</option>
       <option value="web">Web</option>
       <option value="android">Android</option>
       <option value="ios">iOS</option>
       <option value="desktop">Desktop</option>
      </select>
      <button type="button" id="recipientFilterReset" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 shadow-sm transition-all hover:bg-slate-50 hover:-translate-y-0.5">
       <i class="lucide lucide-rotate-ccw" style="width:0.875em;height:0.875em;"></i> Clear
      </button>
      <div class="flex items-center gap-1 text-xs text-slate-500">
       <span>Filtered: <strong id="recipientFilteredCount">0</strong></span>
       <span class="text-slate-300">|</span>
       <span id="recipientFilterHint">Type to narrow recipients</span>
      </div>
     </div>
     <div id="recipientList">
      <div class="py-8 text-center text-slate-500">
       <i class="lucide lucide-hourglass mx-auto text-slate-300" style="width:2em;height:2em;"></i>
       <div class="mt-2 text-sm font-semibold">Loading recipient preview...</div>
       <p class="mt-1 text-xs">Please wait</p>
      </div>
     </div>
    </div>
    <div class="flex items-center justify-end border-t border-slate-200 bg-slate-50 px-5 py-4">
     <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition-all hover:bg-slate-50 active:scale-[0.97]" data-brox-dismiss="modal">Close</button>
    </div>
   </div>
  </div>
 </div>
</div>
{% endblock %}
