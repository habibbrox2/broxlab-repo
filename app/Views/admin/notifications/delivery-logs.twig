{% extends 'admin/layout.twig' %}
{% block title %}Notification Delivery Logs{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
    <!-- Gradient Header -->
    <div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-sky-500 via-indigo-500 to-violet-500 p-6 shadow-lg">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"></div>
        <div class="relative flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/20 backdrop-blur-sm">
                    <i class="lucide lucide-file-text text-2xl text-white"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-white sm:text-3xl">Notification Delivery Logs</h1>
                    <p class="mt-1 text-sm text-indigo-100">Search and filter notification delivery records.</p>
                </div>
            </div>
            <a href="/admin/notifications" class="inline-flex items-center justify-center gap-2 rounded-lg bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/20">
                <i class="lucide lucide-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-slate-100 bg-gradient-to-r from-amber-50/50 to-orange-50/50 px-5 py-4">
            <div class="flex items-center gap-2">
                <i class="lucide lucide-filter text-amber-500" w-[18px] h-[18px]></i>
                <h2 class="text-sm font-semibold text-slate-900">Filters</h2>
            </div>
        </div>
        <div class="p-5">
            <form id="logsFilterForm" class="grid grid-cols-1 gap-4 md:grid-cols-12">
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
                    <select name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                        <option value="all" {{ filters.status == 'all' ? 'selected' : '' }}>All</option>
                        <option value="sent" {{ filters.status == 'sent' ? 'selected' : '' }}>Sent</option>
                        <option value="failed" {{ filters.status == 'failed' ? 'selected' : '' }}>Failed</option>
                        <option value="pending" {{ filters.status == 'pending' ? 'selected' : '' }}>Pending</option>
                    </select>
                </div>
                <div class="md:col-span-3">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Device ID</label>
                    <input type="text" name="device_id" value="{{ filters.device_id }}" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                </div>
                <div class="md:col-span-3">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Token / Partial</label>
                    <input type="text" name="token" value="{{ filters.token }}" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                </div>
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-slate-700 mb-1">User ID</label>
                    <input type="text" name="user_id" value="{{ filters.user_id }}" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                </div>
                <div class="md:col-span-12 flex gap-4">
                    <div class="flex-1">
                        <label class="block text-sm font-medium text-slate-700 mb-1">From</label>
                        <input type="date" name="from" value="{{ filters.from }}" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 datepicker">
                    </div>
                    <div class="flex-1">
                        <label class="block text-sm font-medium text-slate-700 mb-1">To</label>
                        <input type="date" name="to" value="{{ filters.to }}" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 datepicker">
                    </div>
                    <div class="flex items-end gap-2">
                        <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700"><i class="lucide lucide-filter"></i> Filter</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Logs Table Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
            <div class="flex items-center gap-2">
                <i class="lucide lucide-list text-indigo-500" w-[18px] h-[18px]></i>
                <h2 class="text-sm font-semibold text-slate-900">Delivery Logs</h2>
            </div>
        </div>
        <div class="overflow-x-auto">
            {% if logs is empty %}
            <div class="py-10 text-center text-slate-500">No logs found for these filters.</div>
            {% else %}
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/50">
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Created</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Notification</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">User ID</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Device ID</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Token</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Status</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Channel</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">IP</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Response</th>
                    </tr>
                </thead>
                <tbody>
                    {% for l in logs %}
                    <tr class="border-b border-slate-50 transition hover:bg-indigo-50/30">
                        <td class="px-5 py-3 text-sm text-slate-600">{{ l.created_at }}</td>
                        <td class="px-5 py-3">{{ l.notification_id }}</td>
                        <td class="px-5 py-3 text-slate-600">{{ l.user_id ?: '-' }}</td>
                        <td class="px-5 py-3"><code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">{{ l.device_id ?: '-' }}</code></td>
                        <td class="px-5 py-3"><small class="text-slate-500">{{ l.token[:40] }}{{ l.token|length > 40 ? '...' : '' }}</small></td>
                        <td class="px-5 py-3">
                            {% set status_class = l.status == 'sent' ? 'bg-emerald-50 text-emerald-700' : (l.status == 'failed' ? 'bg-rose-50 text-rose-700' : 'bg-slate-100 text-slate-600') %}
                            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold {{ status_class }}">{{ l.status }}</span>
                        </td>
                        <td class="px-5 py-3 text-slate-600">{{ l.channel ?: '-' }}</td>
                        <td class="px-5 py-3 text-slate-600">{{ l.ip_address ?: '-' }}</td>
                        <td class="px-5 py-3"><small class="text-slate-500">{{ l.response|length > 120 ? l.response[:120] ~ '...' : l.response }}</small></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
