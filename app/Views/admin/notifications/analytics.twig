{% extends 'admin/layout.twig' %}
{% block title %}Google Analytics Dashboard - FCM{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4" id="notificationsAnalyticsRoot">
 <section class="admin-page-header">
  <div>
   <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
    <i class="lucide lucide-trending-up"></i>
    Notifications Analytics
   </p>
   <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Google Analytics Dashboard</h1>
   <p class="mt-2 max-w-2xl text-sm text-slate-600">Firebase Cloud Messaging and notification performance analytics.</p>
  </div>
 </section>

 <section class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
  <div class="admin-panel-card">
   <p class="text-xs font-semibold uppercase tracking-[0.2em] text-indigo-600">Notifications Sent</p>
   <div class="mt-2 text-3xl font-bold text-slate-950" id="totalNotificationsSent">-</div>
   <p class="mt-1 text-sm text-slate-500">All-time total</p>
  </div>
  <div class="admin-panel-card">
   <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-600">Delivered</p>
   <div class="mt-2 text-3xl font-bold text-slate-950" id="totalDelivered">-</div>
   <p class="mt-1 text-sm text-slate-500">Successfully sent</p>
  </div>
  <div class="admin-panel-card">
   <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-600">Clicks</p>
   <div class="mt-2 text-3xl font-bold text-slate-950" id="totalClicked">-</div>
   <p class="mt-1 text-sm text-slate-500">Total interactions</p>
  </div>
  <div class="admin-panel-card">
   <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-600">Permission Granted</p>
   <div class="mt-2 text-3xl font-bold text-slate-950" id="totalPermissionGranted">-</div>
   <p class="mt-1 text-sm text-slate-500">Users granted permission</p>
  </div>
 </section>

 <section class="admin-panel-card border border-sky-200 bg-sky-50">
  <h2 class="flex items-center gap-2 text-base font-semibold text-sky-900">
   <i class="lucide lucide-info"></i> Google Analytics Integration
  </h2>
  <p class="mt-2 text-sm text-sky-800">
   This dashboard tracks Firebase Console and Google Analytics notification events.
  </p>
  <ul class="mt-3 space-y-2 text-sm text-sky-800">
   <li><strong>fcm_notification_sent</strong> - Notification sent</li>
   <li><strong>fcm_notification_delivered</strong> - Notification delivered</li>
   <li><strong>fcm_notification_clicked</strong> - Notification clicked</li>
   <li><strong>notification_permission_changed</strong> - Permission preference changed</li>
   <li><strong>fcm_token_generated</strong> - Token generated</li>
   <li><strong>fcm_token_migrated</strong> - Token migrated</li>
   <li><strong>user_login/logout</strong> - User login/logout events</li>
  </ul>
 </section>

 <section class="grid grid-cols-1 gap-4 xl:grid-cols-2">
  <div class="admin-panel-card">
   <div class="mb-4 flex items-center gap-2">
    <i class="lucide lucide-chart-column text-indigo-600"></i>
    <h2 class="text-lg font-semibold text-slate-950">Notification Flow</h2>
   </div>
   <canvas id="notificationFlowChart"></canvas>
  </div>
  <div class="admin-panel-card">
   <div class="mb-4 flex items-center gap-2">
    <i class="lucide lucide-pie-chart text-indigo-600"></i>
    <h2 class="text-lg font-semibold text-slate-950">Channel Breakdown</h2>
   </div>
   <canvas id="channelChart"></canvas>
  </div>
 </section>

 <section class="grid grid-cols-1 gap-4 xl:grid-cols-2">
  <div class="admin-panel-card">
   <div class="mb-4 flex items-center gap-2">
    <i class="lucide lucide-link text-slate-700"></i>
    <h2 class="text-lg font-semibold text-slate-950">Firebase Console & Analytics Setup</h2>
   </div>
   <p class="text-sm text-slate-600">To view analytics data in Firebase Console, follow these steps:</p>
   <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-slate-600">
    <li><a href="https://console.firebase.google.com/" target="_blank" rel="noreferrer" class="text-indigo-600 hover:underline">Open Firebase Console</a></li>
    <li>Open your project <strong>Current Project</strong></li>
    <li>Go to <strong>Analytics &gt; Dashboard</strong></li>
    <li>Review custom events under <strong>Analytics Events</strong></li>
   </ol>
   <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
    <strong>Note:</strong> Analytics data may take some time to appear, especially for newly generated events.
   </div>
  </div>
  <div class="admin-panel-card">
   <div class="mb-4 flex items-center gap-2">
    <i class="lucide lucide-code text-slate-700"></i>
    <h2 class="text-lg font-semibold text-slate-950">JavaScript Implementation</h2>
   </div>
   <p class="text-sm text-slate-600">Use these frontend methods to track notification analytics events.</p>
   <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
     <h3 class="mb-2 text-sm font-semibold text-slate-900">Notification Events</h3>
     <pre class="overflow-x-auto rounded-lg bg-slate-950 p-4 text-xs text-slate-100"><code>// Frontend - notifications.js
AnalyticsSystem.trackNotificationSent()
AnalyticsSystem.trackNotificationDelivered()
AnalyticsSystem.trackNotificationClicked()
AnalyticsSystem.trackNotificationDismissed()
AnalyticsSystem.trackNotificationRead()</code></pre>
    </div>
    <div>
     <h3 class="mb-2 text-sm font-semibold text-slate-900">Token &amp; User Events</h3>
     <pre class="overflow-x-auto rounded-lg bg-slate-950 p-4 text-xs text-slate-100"><code>// Frontend - notifications.js
AnalyticsSystem.trackTokenGenerated()
AnalyticsSystem.trackTokenMigration()
AnalyticsSystem.trackUserLogin()
AnalyticsSystem.trackUserLogout()</code></pre>
    </div>
   </div>
   <div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
    <strong>Tracks:</strong> Real-time notification tracking, user engagement metrics, token management monitoring, admin actions logging, and error tracking.
   </div>
  </div>
</section>
</div>
{% endblock %}
{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" defer></script>
{% endblock %}
