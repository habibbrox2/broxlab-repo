{% extends"admin/layout.twig" %}
{% block title %}FCM Delete Audit Log{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
    <!-- Gradient Header -->
    <div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-sky-500 via-indigo-500 to-violet-500 p-6 shadow-lg">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"></div>
        <div class="relative flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/20 backdrop-blur-sm">
                    <i class="lucide lucide-file-text text-2xl text-white"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-white sm:text-3xl">FCM Delete Audit</h1>
                    <p class="mt-1 text-sm text-indigo-100">Recent permanent delete operations for FCM device tokens.</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a href="/admin/notification-fcm-deletes/download" class="inline-flex items-center justify-center gap-2 rounded-lg bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/20"><i class="lucide lucide-download"></i> Download Raw Log</a>
                <a href="/admin/notification-subscribers" class="inline-flex items-center justify-center gap-2 rounded-lg bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/20"><i class="lucide lucide-arrow-left"></i> Back to Subscribers</a>
            </div>
        </div>
    </div>

    <!-- Audit Table Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
            <div class="flex items-center gap-2">
                <i class="lucide lucide-list text-indigo-500" style="width:1.125em;height:1.125em;"></i>
                <h2 class="text-sm font-semibold text-slate-900">Audit Entries</h2>
            </div>
        </div>
        <div class="overflow-x-auto p-0">
            {% if entries is empty %}
            <div class="py-10 text-center text-slate-500">No audit entries found.</div>
            {% else %}
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="border-b border-slate-100 bg-slate-50/50">
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Timestamp</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Admin ID</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Device ID</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">IP</th>
                        <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Raw</th>
                    </tr>
                </thead>
                <tbody>
                    {% for e in entries %}
                    <tr class="border-b border-slate-50 transition hover:bg-indigo-50/30">
                        <td class="px-5 py-3">{{ e.ts ?: '-' }}</td>
                        <td class="px-5 py-3">{{ e.admin_id ?: '-' }}</td>
                        <td class="px-5 py-3"><code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">{{ e.device_id ?: (e.raw ?: '-') }}</code></td>
                        <td class="px-5 py-3 text-slate-600">{{ e.ip ?: '-' }}</td>
                        <td class="px-5 py-3"><small class="text-slate-500">{{ (e.raw ?: (e|json_encode))|slice(0, 160) }}{{ (e.raw ?: (e|json_encode))|length > 160 ? '...' : '' }}</small></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
