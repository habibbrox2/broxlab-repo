{% extends"admin/layout.twig" %}
{% block title %}FCM Delete Audit Log{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
 <section class="admin-page-header">
  <div class="flex flex-wrap items-end justify-between gap-3">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600"><i class="lucide lucide-file-text"></i> Audit</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">FCM Delete Audit</h1>
    <p class="mt-2 text-sm text-slate-600">Recent permanent delete operations for FCM device tokens.</p>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/notification-fcm-deletes/download" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">Download Raw Log</a>
    <a href="/admin/notification-subscribers" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Back to Subscribers</a>
   </div>
  </div>
 </section>

 <section class="admin-panel-card">
  {% if entries is empty %}
  <div class="py-8 text-center text-slate-500">No audit entries found.</div>
  {% else %}
  <div class="overflow-x-auto">
   <table class="table">
    <thead><tr><th>Timestamp</th><th>Admin ID</th><th>Device ID</th><th>IP</th><th>Raw</th></tr></thead>
    <tbody>
     {% for e in entries %}
     <tr>
      <td>{{ e.ts ?: '-' }}</td>
      <td>{{ e.admin_id ?: '-' }}</td>
      <td><code>{{ e.device_id ?: (e.raw ?: '-') }}</code></td>
      <td>{{ e.ip ?: '-' }}</td>
      <td><small>{{ (e.raw ?: (e|json_encode))|slice(0, 160) }}{{ (e.raw ?: (e|json_encode))|length > 160 ? '...' : '' }}</small></td>
     </tr>
     {% endfor %}
    </tbody>
   </table>
  </div>
  {% endif %}
 </section>
</div>
{% endblock %}
