{% extends"admin/layout.twig" %}
{% block title %}Topics Management{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
    <!-- Gradient Header -->
    <div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-sky-500 via-indigo-500 to-violet-500 p-6 shadow-lg">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"></div>
        <div class="relative flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/20 backdrop-blur-sm">
                <i class="lucide lucide-tags text-2xl text-white"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-white sm:text-3xl">Topics Management</h1>
                <p class="mt-1 text-sm text-indigo-100">Browse and manage notification topics.</p>
            </div>
        </div>
    </div>

    <!-- Topics List Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
            <div class="flex items-center gap-2">
                <i class="lucide lucide-list text-indigo-500" w-[18px] h-[18px]></i>
                <h2 class="text-sm font-semibold text-slate-900">Topics</h2>
            </div>
        </div>
        <div class="p-5">
            <div id="topicsList" class="space-y-3">
                <div class="rounded-lg border border-dashed border-slate-200 px-4 py-10 text-center text-slate-500">
                    Loading topics...
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
