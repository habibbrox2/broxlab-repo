{% extends"admin/layout.twig" %}
{% block title %}Topics Management{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
 <section class="admin-page-header">
  <div>
   <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
    <i class="lucide lucide-tags"></i>
    Notification Topics
   </p>
   <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Topics Management</h1>
   <p class="mt-2 text-sm text-slate-600">Browse and manage notification topics.</p>
  </div>
 </section>

 <section class="admin-panel-card">
  <div id="topicsList" class="space-y-3">
   <div class="rounded-lg border border-dashed border-slate-200 px-4 py-10 text-center text-slate-500">
    Loading topics...
   </div>
  </div>
 </section>
</div>
{% endblock %}
