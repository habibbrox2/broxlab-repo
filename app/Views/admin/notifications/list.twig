{% extends 'admin/layout.twig' %}
{% block title %}All Notifications{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="px-4 sm:px-6 lg:px-8 py-5 space-y-5">

 {# ── Page Header Banner ── #}
 <div class="relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-900 text-white shadow-xl shadow-slate-900/20">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.25),transparent_55%)]" aria-hidden="true"></div>
  <div class="relative px-6 py-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-4">
    <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center flex-shrink-0">
     <i class="lucide lucide-bell w-5 h-5 text-white"></i>
    </div>
    <div>
     <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-1">Notifications</p>
     <h1 class="text-xl font-bold text-white">All Notifications</h1>
     <p class="text-sm text-white/60 mt-0.5 max-w-md">View, search, and resend notification records.</p>
    </div>
   </div>
   <div class="flex gap-2">
    <a href="/admin/notifications/send" class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
     <i class="lucide lucide-send w-4 h-4"></i> Send Notification
    </a>
   </div>
  </div>
 </div>

 {# ── Filter Card ── #}
 <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
  <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
   <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
    <i class="lucide lucide-sliders-horizontal w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
   </div>
   <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Filter Notifications</h3>
  </div>
  <div class="p-5">
   <form method="get" class="grid gap-4 lg:grid-cols-12">
    <div class="lg:col-span-3">
     <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5" for="notification-search">Search</label>
     <div class="flex overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 shadow-sm focus-within:ring-2 focus-within:ring-indigo-500/10 focus-within:border-indigo-400 transition-all">
      <span class="inline-flex items-center border-r border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 text-slate-400">
       <i class="lucide lucide-search w-3.5 h-3.5"></i>
      </span>
      <input id="notification-search" type="text" name="search" value="{{ pagination.search|default('') }}"
       class="w-full border-0 px-4 py-2.5 text-sm bg-transparent text-slate-900 dark:text-slate-100 focus:ring-0 placeholder:text-slate-400 dark:placeholder:text-slate-600"
       placeholder="Search by ID, title, message, type or status...">
     </div>
    </div>
    <div class="lg:col-span-2">
     <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5" for="notification-type">Type</label>
     <select id="notification-type" name="type"
      class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 cursor-pointer appearance-none transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600">
      <option value="">All Types</option>
      <option value="general" {% if pagination.type == 'general' %}selected{% endif %}>General</option>
      <option value="update" {% if pagination.type == 'update' %}selected{% endif %}>Update</option>
      <option value="broadcast" {% if pagination.type == 'broadcast' %}selected{% endif %}>Broadcast</option>
      <option value="targeted" {% if pagination.type == 'targeted' %}selected{% endif %}>Targeted</option>
     </select>
    </div>
    <div class="lg:col-span-2">
     <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5" for="notification-status">Status</label>
     <select id="notification-status" name="status"
      class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 cursor-pointer appearance-none transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600">
      <option value="">All Status</option>
      <option value="draft" {% if pagination.status == 'draft' %}selected{% endif %}>Draft</option>
      <option value="scheduled" {% if pagination.status == 'scheduled' %}selected{% endif %}>Scheduled</option>
      <option value="sent" {% if pagination.status == 'sent' %}selected{% endif %}>Sent</option>
      <option value="failed" {% if pagination.status == 'failed' %}selected{% endif %}>Failed</option>
      <option value="pending" {% if pagination.status == 'pending' %}selected{% endif %}>Pending</option>
     </select>
    </div>
    <div class="lg:col-span-2">
     <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5" for="notification-sort">Sort By</label>
     <select id="notification-sort" name="sort"
      class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 cursor-pointer appearance-none transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600">
      <option value="created_at" {% if pagination.sort|default('created_at') == 'created_at' %}selected{% endif %}>Created Date</option>
      <option value="updated_at" {% if pagination.sort|default('created_at') == 'updated_at' %}selected{% endif %}>Updated Date</option>
      <option value="id" {% if pagination.sort|default('created_at') == 'id' %}selected{% endif %}>ID</option>
      <option value="title" {% if pagination.sort|default('created_at') == 'title' %}selected{% endif %}>Title</option>
      <option value="type" {% if pagination.sort|default('created_at') == 'type' %}selected{% endif %}>Type</option>
      <option value="status" {% if pagination.sort|default('created_at') == 'status' %}selected{% endif %}>Status</option>
     </select>
    </div>
    <div class="lg:col-span-1">
     <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5" for="notification-order">Order</label>
     <select id="notification-order" name="order"
      class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 cursor-pointer appearance-none transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600">
      <option value="DESC" {% if pagination.order|default('DESC') == 'DESC' %}selected{% endif %}>DESC</option>
      <option value="ASC" {% if pagination.order|default('DESC') == 'ASC' %}selected{% endif %}>ASC</option>
     </select>
    </div>
    <div class="lg:col-span-1">
     <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5" for="notification-limit">Limit</label>
     <select id="notification-limit" name="limit"
      class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 cursor-pointer appearance-none transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600">
      <option value="10" {% if pagination.per_page|default(50) == 10 %}selected{% endif %}>10</option>
      <option value="20" {% if pagination.per_page|default(50) == 20 %}selected{% endif %}>20</option>
      <option value="50" {% if pagination.per_page|default(50) == 50 %}selected{% endif %}>50</option>
      <option value="100" {% if pagination.per_page|default(50) == 100 %}selected{% endif %}>100</option>
     </select>
    </div>
    <div class="lg:col-span-12 flex flex-wrap justify-end gap-2">
     <a href="/admin/notifications/list" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
      <i class="lucide lucide-x w-4 h-4"></i> Reset
     </a>
     <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm shadow-indigo-500/20 hover:shadow-md hover:shadow-indigo-500/25 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
      <i class="lucide lucide-filter w-4 h-4"></i> Apply
     </button>
    </div>
   </form>
  </div>
 </div>

 {# ── Notifications Table ── #}
 {% if notifications is not empty %}
 <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
  <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
   <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
    <i class="lucide lucide-database w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
   </div>
   <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Notifications</h3>
  </div>
  <div class="p-5">
   <div class="overflow-x-auto">
    <table class="w-full text-left">
     <thead>
      <tr class="border-b border-slate-100 dark:border-slate-800">
       <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">ID</th>
       <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Title</th>
       <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Type</th>
       <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Status</th>
       <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Created</th>
       <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap text-right">Actions</th>
      </tr>
     </thead>
     <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
      {% for n in notifications %}
      <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors duration-100">
       <td class="px-4 py-3 font-mono text-xs text-slate-500 dark:text-slate-400">#{{ n.id }}</td>
       <td class="px-4 py-3 text-sm font-semibold text-slate-900 dark:text-white max-w-[250px] truncate" title="{{ n.title|e('html_attr') }}">{{ n.title }}</td>
       <td class="px-4 py-3">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-400">{{ n.type }}</span>
       </td>
       <td class="px-4 py-3">
        {% set row_status = (n.status|default('')|lower|trim) %}
        {% set delivery_status = (n.delivery_status|default('')|lower|trim) %}
        {% if row_status == 'draft' %}
         <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400">
          <span class="w-1 h-1 rounded-full bg-amber-500"></span> Draft
         </span>
        {% elseif row_status == 'scheduled' %}
         <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-400">
          <span class="w-1 h-1 rounded-full bg-sky-500"></span> Scheduled
         </span>
        {% elseif row_status == 'failed' or delivery_status == 'failed' %}
         <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-400">
          <span class="w-1 h-1 rounded-full bg-red-500"></span> Failed
         </span>
        {% elseif row_status == 'sent' or n.sent_to_all_at %}
         <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400">
          <span class="w-1 h-1 rounded-full bg-emerald-500"></span> Sent
         </span>
        {% else %}
         <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
          <span class="w-1 h-1 rounded-full bg-slate-400"></span> Pending
         </span>
        {% endif %}
       </td>
       <td class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400">{{ n.created_at|date("d M Y H:i") }}</td>
       <td class="px-4 py-3 text-right">
        <div class="flex items-center justify-end gap-2">
         <a href="/admin/notifications/view?id={{ n.id }}" class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150" title="View">
          <i class="lucide lucide-eye w-3 h-3"></i> View
         </a>
         <button class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150" data-action="resend-notification" data-notification-id="{{ n.id }}" {% if n.status == 'draft' %}disabled{% endif %}>
          <i class="lucide lucide-refresh-cw w-3 h-3"></i> Resend
         </button>
        </div>
       </td>
      </tr>
      {% endfor %}
     </tbody>
    </table>
   </div>
   <div class="mt-6 border-t border-slate-100 dark:border-slate-800 pt-4">{% include "admin/partials/pagination.twig" %}</div>
  </div>
 </div>
 {% else %}
 <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
  <div class="flex flex-col items-center justify-center py-16 text-center">
   <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-4">
    <i class="lucide lucide-bell w-7 h-7 text-slate-400 dark:text-slate-600"></i>
   </div>
   <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-1">No notifications found</h3>
   <p class="text-sm text-slate-400 dark:text-slate-600 mb-5 max-w-xs">Notifications will appear here once sent.</p>
  </div>
 </div>
 {% endif %}
</div>
{% endblock %}
{% block scripts %}{% endblock %}
