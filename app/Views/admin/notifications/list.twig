{% extends 'admin/layout.twig' %}
{% block title %}All Notifications{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="space-y-6">
 <section class="admin-page-header">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600"><i class="lucide lucide-bell"></i> Notifications</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">All Notifications</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600">View, search, and resend notification records.</p>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/notifications" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"><i class="lucide lucide-arrow-left"></i> Go Back</a>
    <a href="/admin/notifications/send" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700"><i class="lucide lucide-send"></i> Send Notification</a>
   </div>
  </div>
 </section>

 <section class="admin-panel-card">
  <form method="get" class="grid gap-4 lg:grid-cols-12">
   <div class="lg:col-span-3">
    <label class="form-label" for="notification-search">Search</label>
    <div class="flex overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
     <span class="inline-flex items-center border-r border-slate-200 bg-slate-50 px-3 text-slate-400"><i class="lucide lucide-search"></i></span>
     <input id="notification-search" type="text" name="search" value="{{ pagination.search|default('') }}" class="w-full border-0 px-4 py-3 text-sm shadow-none focus:ring-0" placeholder="Search by ID, title, message, type or status...">
    </div>
   </div>
   <div class="lg:col-span-2">
    <label class="form-label" for="notification-type">Type</label>
    <select id="notification-type" name="type">
     <option value="">All Types</option>
     <option value="general" {% if pagination.type == 'general' %}selected{% endif %}>General</option>
     <option value="update" {% if pagination.type == 'update' %}selected{% endif %}>Update</option>
     <option value="broadcast" {% if pagination.type == 'broadcast' %}selected{% endif %}>Broadcast</option>
     <option value="targeted" {% if pagination.type == 'targeted' %}selected{% endif %}>Targeted</option>
    </select>
   </div>
   <div class="lg:col-span-2">
    <label class="form-label" for="notification-status">Status</label>
    <select id="notification-status" name="status">
     <option value="">All Status</option>
     <option value="draft" {% if pagination.status == 'draft' %}selected{% endif %}>Draft</option>
     <option value="scheduled" {% if pagination.status == 'scheduled' %}selected{% endif %}>Scheduled</option>
     <option value="sent" {% if pagination.status == 'sent' %}selected{% endif %}>Sent</option>
     <option value="failed" {% if pagination.status == 'failed' %}selected{% endif %}>Failed</option>
     <option value="pending" {% if pagination.status == 'pending' %}selected{% endif %}>Pending</option>
    </select>
   </div>
   <div class="lg:col-span-2">
    <label class="form-label" for="notification-sort">Sort By</label>
    <select id="notification-sort" name="sort">
     <option value="created_at" {% if pagination.sort|default('created_at') == 'created_at' %}selected{% endif %}>Created Date</option>
     <option value="updated_at" {% if pagination.sort|default('created_at') == 'updated_at' %}selected{% endif %}>Updated Date</option>
     <option value="id" {% if pagination.sort|default('created_at') == 'id' %}selected{% endif %}>ID</option>
     <option value="title" {% if pagination.sort|default('created_at') == 'title' %}selected{% endif %}>Title</option>
     <option value="type" {% if pagination.sort|default('created_at') == 'type' %}selected{% endif %}>Type</option>
     <option value="status" {% if pagination.sort|default('created_at') == 'status' %}selected{% endif %}>Status</option>
    </select>
   </div>
   <div class="lg:col-span-1">
    <label class="form-label" for="notification-order">Order</label>
    <select id="notification-order" name="order">
     <option value="DESC" {% if pagination.order|default('DESC') == 'DESC' %}selected{% endif %}>DESC</option>
     <option value="ASC" {% if pagination.order|default('DESC') == 'ASC' %}selected{% endif %}>ASC</option>
    </select>
   </div>
   <div class="lg:col-span-1">
    <label class="form-label" for="notification-limit">Limit</label>
    <select id="notification-limit" name="limit">
     <option value="10" {% if pagination.per_page|default(50) == 10 %}selected{% endif %}>10</option>
     <option value="20" {% if pagination.per_page|default(50) == 20 %}selected{% endif %}>20</option>
     <option value="50" {% if pagination.per_page|default(50) == 50 %}selected{% endif %}>50</option>
     <option value="100" {% if pagination.per_page|default(50) == 100 %}selected{% endif %}>100</option>
    </select>
   </div>
   <div class="lg:col-span-12 flex flex-wrap justify-end gap-2">
    <a href="/admin/notifications/list" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"><i class="lucide lucide-x-circle"></i> Reset</a>
    <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700"><i class="lucide lucide-filter"></i> Apply</button>
   </div>
  </form>
 </section>

 {% if notifications is not empty %}
 <section class="admin-panel-card">
  <div class="overflow-x-auto">
   <table class="table">
    <thead><tr><th>ID</th><th>Title</th><th>Type</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead>
    <tbody>
     {% for n in notifications %}
     <tr>
      <td class="font-mono text-slate-600">#{{ n.id }}</td>
      <td><strong class="block max-w-[250px] truncate text-slate-900" title="{{ n.title|e('html_attr') }}">{{ n.title }}</strong></td>
      <td><span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-semibold text-indigo-700">{{ n.type }}</span></td>
      <td>
       {% set row_status = (n.status|default('')|lower|trim) %}
       {% set delivery_status = (n.delivery_status|default('')|lower|trim) %}
       {% if row_status == 'draft' %}
        <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700">Draft</span>
       {% elseif row_status == 'scheduled' %}
        <span class="inline-flex items-center rounded-full bg-sky-100 px-2 py-0.5 text-xs font-semibold text-sky-700">Scheduled</span>
       {% elseif row_status == 'failed' or delivery_status == 'failed' %}
        <span class="inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-xs font-semibold text-rose-700">Failed</span>
       {% elseif row_status == 'sent' or n.sent_to_all_at %}
        <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700">Sent</span>
       {% else %}
        <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">Pending</span>
       {% endif %}
      </td>
      <td class="text-slate-500">{{ n.created_at|date("d M Y H:i") }}</td>
      <td>
       <div class="inline-flex flex-wrap gap-2">
        <a href="/admin/notifications/view?id={{ n.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" title="View"><i class="lucide lucide-eye"></i>View</a>
        <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" data-action="resend-notification" data-notification-id="{{ n.id }}" {% if n.status == 'draft' %}disabled{% endif %}><i class="lucide lucide-refresh-cw"></i>Resend</button>
       </div>
      </td>
     </tr>
     {% endfor %}
    </tbody>
   </table>
  </div>

  <div class="mt-6">{% include"admin/partials/pagination.twig" %}</div>
 </section>
 {% else %}
 <section class="admin-panel-card text-center">
  <i class="lucide lucide-inbox text-3xl text-slate-300"></i>
  <p class="mt-3 text-slate-500">No notifications found.</p>
 </section>
 {% endif %}
</div>
{% endblock %}
{% block scripts %}{% endblock %}
