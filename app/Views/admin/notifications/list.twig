{% extends 'admin/layout.twig' %}
{% block title %}All Notifications{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
 {# ── Gradient Page Header ── #}
 <section class="scroll-fade-in relative overflow-hidden rounded-xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 sm:p-8">
  <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/5 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-8 left-1/3 h-28 w-28 rounded-full bg-indigo-400/10 blur-2xl"></div>
  <div class="relative flex flex-wrap items-end justify-between gap-4">
   <div class="flex items-start gap-4">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur-sm">
     <i class="lucide lucide-bell text-2xl text-white"></i>
    </div>
    <div>
     <h1 class="text-2xl font-bold text-white sm:text-3xl">All Notifications</h1>
     <p class="mt-1 text-sm text-indigo-200/80">View, search, and resend notification records.</p>
    </div>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/notifications" class="inline-flex items-center justify-center gap-2 rounded-lg bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/20"><i class="lucide lucide-arrow-left"></i> Go Back</a>
    <a href="/admin/notifications/send" class="inline-flex items-center justify-center gap-2 rounded-lg bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/20"><i class="lucide lucide-send"></i> Send Notification</a>
   </div>
  </div>
 </section>

 {# ── Filter Card ── #}
 <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-3">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
    <i class="lucide lucide-filter text-sm"></i>
   </div>
   <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">Filter Notifications</h2>
  </div>
  <div class="p-5">
   <form method="get" class="grid gap-4 lg:grid-cols-12">
    <div class="lg:col-span-3">
     <label class="block text-sm font-medium text-slate-700 mb-1" for="notification-search">Search</label>
     <div class="flex overflow-hidden rounded-lg border border-slate-300 bg-white shadow-sm focus-within:ring-2 focus-within:ring-indigo-500/20 focus-within:border-indigo-500">
      <span class="inline-flex items-center border-r border-slate-200 bg-slate-50 px-3 text-slate-400"><i class="lucide lucide-search"></i></span>
      <input id="notification-search" type="text" name="search" value="{{ pagination.search|default('') }}" class="w-full border-0 px-4 py-2.5 text-sm shadow-none focus:ring-0" placeholder="Search by ID, title, message, type or status...">
     </div>
    </div>
    <div class="lg:col-span-2">
     <label class="block text-sm font-medium text-slate-700 mb-1" for="notification-type">Type</label>
     <select id="notification-type" name="type" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      <option value="">All Types</option>
      <option value="general" {% if pagination.type == 'general' %}selected{% endif %}>General</option>
      <option value="update" {% if pagination.type == 'update' %}selected{% endif %}>Update</option>
      <option value="broadcast" {% if pagination.type == 'broadcast' %}selected{% endif %}>Broadcast</option>
      <option value="targeted" {% if pagination.type == 'targeted' %}selected{% endif %}>Targeted</option>
     </select>
    </div>
    <div class="lg:col-span-2">
     <label class="block text-sm font-medium text-slate-700 mb-1" for="notification-status">Status</label>
     <select id="notification-status" name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      <option value="">All Status</option>
      <option value="draft" {% if pagination.status == 'draft' %}selected{% endif %}>Draft</option>
      <option value="scheduled" {% if pagination.status == 'scheduled' %}selected{% endif %}>Scheduled</option>
      <option value="sent" {% if pagination.status == 'sent' %}selected{% endif %}>Sent</option>
      <option value="failed" {% if pagination.status == 'failed' %}selected{% endif %}>Failed</option>
      <option value="pending" {% if pagination.status == 'pending' %}selected{% endif %}>Pending</option>
     </select>
    </div>
    <div class="lg:col-span-2">
     <label class="block text-sm font-medium text-slate-700 mb-1" for="notification-sort">Sort By</label>
     <select id="notification-sort" name="sort" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      <option value="created_at" {% if pagination.sort|default('created_at') == 'created_at' %}selected{% endif %}>Created Date</option>
      <option value="updated_at" {% if pagination.sort|default('created_at') == 'updated_at' %}selected{% endif %}>Updated Date</option>
      <option value="id" {% if pagination.sort|default('created_at') == 'id' %}selected{% endif %}>ID</option>
      <option value="title" {% if pagination.sort|default('created_at') == 'title' %}selected{% endif %}>Title</option>
      <option value="type" {% if pagination.sort|default('created_at') == 'type' %}selected{% endif %}>Type</option>
      <option value="status" {% if pagination.sort|default('created_at') == 'status' %}selected{% endif %}>Status</option>
     </select>
    </div>
    <div class="lg:col-span-1">
     <label class="block text-sm font-medium text-slate-700 mb-1" for="notification-order">Order</label>
     <select id="notification-order" name="order" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      <option value="DESC" {% if pagination.order|default('DESC') == 'DESC' %}selected{% endif %}>DESC</option>
      <option value="ASC" {% if pagination.order|default('DESC') == 'ASC' %}selected{% endif %}>ASC</option>
     </select>
    </div>
    <div class="lg:col-span-1">
     <label class="block text-sm font-medium text-slate-700 mb-1" for="notification-limit">Limit</label>
     <select id="notification-limit" name="limit" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      <option value="10" {% if pagination.per_page|default(50) == 10 %}selected{% endif %}>10</option>
      <option value="20" {% if pagination.per_page|default(50) == 20 %}selected{% endif %}>20</option>
      <option value="50" {% if pagination.per_page|default(50) == 50 %}selected{% endif %}>50</option>
      <option value="100" {% if pagination.per_page|default(50) == 100 %}selected{% endif %}>100</option>
     </select>
    </div>
    <div class="lg:col-span-12 flex flex-wrap justify-end gap-2">
     <a href="/admin/notifications/list" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 hover:-translate-y-0.5"><i class="lucide lucide-x-circle"></i> Reset</a>
     <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700 hover:-translate-y-0.5 hover:shadow-md"><i class="lucide lucide-filter"></i> Apply</button>
    </div>
   </form>
  </div>
 </section>

 {# ── Notifications Table ── #}
 {% if notifications is not empty %}
 <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-3">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
    <i class="lucide lucide-database text-sm"></i>
   </div>
   <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">Notifications</h2>
  </div>
  <div class="p-5">
   <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
     <thead>
      <tr class="border-b border-slate-200">
       <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">ID</th>
       <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Title</th>
       <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Type</th>
       <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Status</th>
       <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Created</th>
       <th class="px-3 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Actions</th>
      </tr>
     </thead>
     <tbody>
      {% for n in notifications %}
      <tr class="border-b border-slate-100 transition hover:bg-slate-50/50">
       <td class="px-3 py-3 font-mono text-slate-500">#{{ n.id }}</td>
       <td class="px-3 py-3"><strong class="block max-w-[250px] truncate text-slate-900" title="{{ n.title|e('html_attr') }}">{{ n.title }}</strong></td>
       <td class="px-3 py-3"><span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-700">{{ n.type }}</span></td>
       <td class="px-3 py-3">
        {% set row_status = (n.status|default('')|lower|trim) %}
        {% set delivery_status = (n.delivery_status|default('')|lower|trim) %}
        {% if row_status == 'draft' %}
         <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700">Draft</span>
        {% elseif row_status == 'scheduled' %}
         <span class="inline-flex items-center rounded-full bg-sky-50 px-2 py-0.5 text-xs font-semibold text-sky-700">Scheduled</span>
        {% elseif row_status == 'failed' or delivery_status == 'failed' %}
         <span class="inline-flex items-center rounded-full bg-rose-50 px-2 py-0.5 text-xs font-semibold text-rose-700">Failed</span>
        {% elseif row_status == 'sent' or n.sent_to_all_at %}
         <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700">Sent</span>
        {% else %}
         <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">Pending</span>
        {% endif %}
       </td>
       <td class="px-3 py-3 text-slate-500">{{ n.created_at|date("d M Y H:i") }}</td>
       <td class="px-3 py-3 text-right">
        <div class="inline-flex gap-2">
         <a href="/admin/notifications/view?id={{ n.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 hover:-translate-y-0.5 hover:shadow-md" title="View"><i class="lucide lucide-eye"></i>View</a>
         <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 hover:-translate-y-0.5 hover:shadow-md" data-action="resend-notification" data-notification-id="{{ n.id }}" {% if n.status == 'draft' %}disabled{% endif %}><i class="lucide lucide-refresh-cw"></i>Resend</button>
        </div>
       </td>
      </tr>
      {% endfor %}
     </tbody>
    </table>
   </div>

   <div class="mt-6">{% include "admin/partials/pagination.twig" %}</div>
  </div>
 </section>
 {% else %}
 <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
  <div class="p-8 text-center text-slate-500">
   <i class="lucide lucide-inbox text-3xl text-slate-300"></i>
   <p class="mt-3">No notifications found.</p>
  </div>
 </section>
 {% endif %}
</div>
{% endblock %}
{% block scripts %}{% endblock %}
