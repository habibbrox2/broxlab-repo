{% extends "admin/layout.twig" %}
{% block title %}Notification Subscribers{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4" id="notificationSubscribersRoot">
 {# ── Gradient Page Header ── #}
 <section class="scroll-fade-in relative overflow-hidden rounded-xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 sm:p-8">
  <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/5 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-8 left-1/3 h-28 w-28 rounded-full bg-indigo-400/10 blur-2xl"></div>
  <div class="relative flex flex-wrap items-end justify-between gap-4">
   <div class="flex items-start gap-4">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur-sm">
     <i class="lucide lucide-users text-2xl text-white"></i>
    </div>
    <div>
     <h1 class="text-2xl font-bold text-white sm:text-3xl">Notification Subscribers</h1>
     <p class="mt-1 text-sm text-indigo-200/80">Manage notification permission subscribers and guest devices.</p>
    </div>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/notification-fcm-deletes" class="inline-flex items-center justify-center gap-2 rounded-lg bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/20">Delete Audit</a>
    <button type="button" id="revokeAllBtn" class="inline-flex items-center justify-center gap-2 rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-black transition hover:bg-amber-600"><i class="lucide lucide-ban"></i> Revoke All (Filtered)</button>
    <button type="button" id="deleteAllBtn" class="inline-flex items-center justify-center gap-2 rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-700"><i class="lucide lucide-trash-2"></i> Delete All (Filtered)</button>
   </div>
  </div>
 </section>

 {# ── Filter Card ── #}
 <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-3">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
    <i class="lucide lucide-filter text-sm"></i>
   </div>
   <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">Filter Subscribers</h2>
  </div>
  <div class="p-5">
   <form id="subsFilterForm" class="grid grid-cols-1 gap-4 md:grid-cols-12">
    <div class="md:col-span-3">
     <label class="block text-sm font-medium text-slate-700 mb-1">Recipient</label>
     <select id="recipientFilter" name="recipient" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      <option value="all" {{ filters.recipient == 'all' ? 'selected' : '' }}>All</option>
      <option value="user" {{ filters.recipient == 'user' ? 'selected' : '' }}>Logged-in Users</option>
      <option value="guest" {{ filters.recipient == 'guest' ? 'selected' : '' }}>Guests</option>
     </select>
    </div>
    <div class="md:col-span-3">
     <label class="block text-sm font-medium text-slate-700 mb-1">Permission</label>
     <select id="permissionFilter" name="permission" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      <option value="all" {{ filters.permission == 'all' ? 'selected' : '' }}>Any permission</option>
      <option value="granted" {{ filters.permission == 'granted' ? 'selected' : '' }}>Granted</option>
      <option value="denied" {{ filters.permission == 'denied' ? 'selected' : '' }}>Denied</option>
      <option value="default" {{ filters.permission == 'default' ? 'selected' : '' }}>Default</option>
     </select>
    </div>
    <div class="md:col-span-3">
     <label class="block text-sm font-medium text-slate-700 mb-1">Search</label>
     <input type="text" id="searchInput" name="search" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" placeholder="Search by token, device ID, username, email" value="{{ filters.search }}">
    </div>
    <div class="md:col-span-2">
     <label class="block text-sm font-medium text-slate-700 mb-1">Per Page</label>
     <select id="perPage" name="per_page" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      <option value="10" {{ pagination.per_page == 10 ? 'selected' : '' }}>10</option>
      <option value="20" {{ pagination.per_page == 20 ? 'selected' : '' }}>20</option>
      <option value="50" {{ pagination.per_page == 50 ? 'selected' : '' }}>50</option>
      <option value="100" {{ pagination.per_page == 100 ? 'selected' : '' }}>100</option>
     </select>
    </div>
    <div class="md:col-span-1 flex items-end">
     <button type="button" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" onclick="applySubsFilter()">Filter</button>
    </div>
   </form>
  </div>
 </section>

 {# ── Subscribers Table ── #}
 <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
  <div class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-3">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
    <i class="lucide lucide-database text-sm"></i>
   </div>
   <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">Subscribers List</h2>
  </div>
  <div class="p-5">
   <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
     <thead>
      <tr class="border-b border-slate-200">
       <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">ID</th>
       <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">User</th>
       <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Device ID</th>
       <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Device Name</th>
       <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Token</th>
       <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Permission</th>
       <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Type</th>
       <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Created</th>
       <th class="px-3 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Action</th>
      </tr>
     </thead>
     <tbody id="subscribersTableBody">
      {% if subscribers is empty %}
      <tr><td colspan="9" class="py-8 text-center text-slate-500">
       <i class="lucide lucide-inbox text-3xl text-slate-300"></i>
       <p class="mt-2">No subscribers found</p>
      </td></tr>
      {% else %}
      {% for s in subscribers %}
      <tr class="border-b border-slate-100 transition hover:bg-slate-50/50">
       <td data-label="ID" class="px-3 py-3"><small class="text-slate-500">#{{ s.id }}</small></td>
       <td data-label="User" class="px-3 py-3">{% if s.user_id %}<strong class="text-slate-900">{{ s.username ?: s.email ?: ('UID:' ~ s.user_id) }}</strong>{% else %}<span class="text-slate-500">Guest</span>{% endif %}</td>
       <td data-label="Device ID" class="px-3 py-3"><code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">{{ s.device_id ?: '-' }}</code></td>
       <td data-label="Device Name" class="px-3 py-3 text-slate-600"><small>{{ s.device_name ?: '-' }}</small></td>
       <td data-label="Token" class="px-3 py-3"><code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">{{ s.token[:40] }}{{ s.token|length > 40 ? '...' : '' }}</code></td>
       <td data-label="Permission" class="px-3 py-3">
        {% set perm = s.permission ?: 'granted' %}
        {% set perm_class = perm == 'granted' ? 'bg-emerald-50 text-emerald-700' : (perm == 'default' ? 'bg-slate-100 text-slate-700' : 'bg-rose-50 text-rose-700') %}
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {{ perm_class }}">{{ perm }}</span>
       </td>
       <td data-label="Type" class="px-3 py-3 text-slate-600">{{ s.device_type ?: '-' }}</td>
       <td data-label="Created" class="px-3 py-3"><small class="text-slate-500">{{ s.created_at ?: '-' }}</small></td>
       <td class="px-3 py-3 text-right" data-label="Action">
        <div class="inline-flex gap-2">
         <button class="inline-flex items-center justify-center gap-2 rounded-lg bg-rose-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-rose-700 hover:-translate-y-0.5 hover:shadow-md" onclick="revokeDevice('{{ s.device_id }}', this)">Revoke</button>
         <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-100 hover:-translate-y-0.5 hover:shadow-md" onclick="deleteDevicePermanent('{{ s.device_id }}', this)">Delete</button>
        </div>
       </td>
      </tr>
      {% endfor %}
      {% endif %}
     </tbody>
    </table>
   </div>
  </div>
 </section>
</div>
{% endblock %}
