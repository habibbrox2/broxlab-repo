{% extends"admin/layout.twig" %}
{% block title %}Edit User{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-6">

 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 text-white shadow-2xl shadow-indigo-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-violet-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-pencil w-6 h-6"></i>
    </div>
    <div>
     <h1 class="text-xl font-black tracking-tight sm:text-2xl">Edit User: {{ user.username }}</h1>
     <p class="mt-1 text-sm text-indigo-200/80">Update user information and roles.</p>
    </div>
   </div>
   <a href="/admin/users" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
    <i class="lucide lucide-arrow-left w-3.5 h-3.5"></i> Back to Users
   </a>
  </div>
 </div>

 {# ── Edit User Form Card ── #}
 <section class="scroll-fade-in max-w-3xl">
  <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
   <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
    <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
     <i class="lucide lucide-user-cog w-4 h-4"></i>
    </div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Account Information</h2>
   </div>
   <div class="p-5">
    <form method="post" action="/admin/users/edit" class="space-y-4">
     <input type="hidden" name="id" value="{{ user.id }}">
     <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

     <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Username <span class="text-rose-500">*</span></label>
      <div class="relative">
       <i class="lucide lucide-at-sign absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 w-4 h-4"></i>
       <input type="text" name="username" value="{{ user.username }}" required class="w-full rounded-lg border border-slate-300 pl-10 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition">
      </div>
     </div>

     <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Email <span class="text-rose-500">*</span></label>
      <div class="relative">
       <i class="lucide lucide-mail absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 w-4 h-4"></i>
       <input type="email" name="email" value="{{ user.email }}" required class="w-full rounded-lg border border-slate-300 pl-10 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition">
      </div>
     </div>

     <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Password</label>
      <div class="relative">
       <i class="lucide lucide-lock absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 w-4 h-4"></i>
       <input type="password" name="password" placeholder="Leave blank to keep current password" class="w-full rounded-lg border border-slate-300 pl-10 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition">
      </div>
      <p class="mt-1 text-xs text-slate-500">Only fill if you want to change the password</p>
     </div>

     <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div>
       <label class="block text-sm font-medium text-slate-700 mb-1">First Name</label>
       <input type="text" name="first_name" value="{{ user.first_name }}" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition">
      </div>
      <div>
       <label class="block text-sm font-medium text-slate-700 mb-1">Last Name</label>
       <input type="text" name="last_name" value="{{ user.last_name }}" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition">
      </div>
     </div>

     <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
      <div class="relative">
       <i class="lucide lucide-activity absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 w-4 h-4"></i>
       <select name="status" class="w-full rounded-lg border border-slate-300 pl-10 pr-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition">
        {% for s in ['active','inactive','pending','banned'] %}
        <option value="{{ s }}" {% if user.status == s %}selected{% endif %}>{{ s|capitalize }}</option>
        {% endfor %}
       </select>
      </div>
     </div>

     {# ── Roles Assignment Card ── #}
     <div class="overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
      <div class="flex items-center gap-2.5 border-b border-slate-200 px-4 py-3">
       <div class="flex h-7 w-7 items-center justify-center rounded-md bg-violet-100 text-violet-600">
        <i class="lucide lucide-shield w-4 h-4"></i>
       </div>
       <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Assign Roles</h2>
      </div>
      <div class="p-4">
       {% if roles|length > 0 %}
       <div class="space-y-3">
        {% for role in roles %}
        <label class="flex items-start gap-3 rounded-lg border border-slate-200 bg-white p-3 transition-all hover:border-indigo-200 hover:shadow-sm cursor-pointer {% if role.id in userRoleIds %}ring-1 ring-indigo-200 bg-indigo-50/30{% endif %}">
         <input class="mt-0.5 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" name="roles[]" value="{{ role.id }}" id="role_{{ role.id }}" {% if role.id in userRoleIds %}checked{% endif %}>
         <span>
          <strong class="block text-sm text-slate-900">{{ role.name|capitalize }}</strong>
          {% if role.is_super_admin %}<span class="mt-0.5 inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-xs font-semibold text-rose-700">Super Admin</span>{% endif %}
         </span>
        </label>
        {% endfor %}
       </div>
       {% else %}
       <div class="flex items-center gap-2 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        <i class="lucide lucide-alert-triangle w-5 h-5"></i>
        <span>No roles available.</span>
       </div>
       {% endif %}
      </div>
     </div>

     {# ── Actions ── #}
     <div class="flex flex-wrap gap-2 pt-2">
      <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 hover:shadow-md active:scale-[0.97]">
       <i class="lucide lucide-check-circle w-4 h-4"></i> Update User
      </button>
      <a href="/admin/users" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-all hover:bg-slate-50 hover:-translate-y-0.5 active:scale-[0.97]">
       <i class="lucide lucide-x-circle w-4 h-4"></i> Cancel
      </a>
     </div>
    </form>
   </div>
  </div>
 </section>

 {# ── Effective Permissions Card ── #}
 {% if userRoles|length > 0 %}
 <section class="scroll-fade-in">
  <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
   <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-sky-50/50 to-cyan-50/50 px-5 py-4">
    <div class="flex h-7 w-7 items-center justify-center rounded-md bg-sky-100 text-sky-600">
     <i class="lucide lucide-key w-4 h-4"></i>
    </div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Effective Permissions</h2>
   </div>
   <div class="p-5">
    <div class="flex items-center justify-center rounded-lg bg-slate-50 py-6 text-sm text-slate-400">
     <i class="lucide lucide-loader-2 mr-2 animate-spin w-4 h-4"></i>
     Loading permissions...
    </div>
   </div>
  </div>
 </section>
 {% endif %}

 <div id="user-edit-data" data-user-id="{{ user.id }}"></div>
</div>
{% endblock %}
