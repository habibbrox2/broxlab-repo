{% extends"admin/layout.twig" %}
{% block title %}Edit User{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="space-y-6">
 <section class="admin-page-header">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-pencil"></i>
     User Management
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Edit User: {{ user.username }}</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600">Update user information and roles.</p>
   </div>
   <a href="/admin/users" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
    <i class="lucide lucide-arrow-left"></i> Back to Users
   </a>
  </div>
 </section>

 <section class="admin-panel-card max-w-4xl">
  <form method="post" action="/admin/users/edit" class="space-y-4">
   <input type="hidden" name="id" value="{{ user.id }}">
   <div>
    <label class="form-label">Username *</label>
    <input type="text" name="username" value="{{ user.username }}" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
   </div>
   <div>
    <label class="form-label">Email *</label>
    <input type="email" name="email" value="{{ user.email }}" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
   </div>
   <div>
    <label class="form-label">Password</label>
    <input type="password" name="password" placeholder="Leave blank to keep current password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
    <small class="text-slate-500">Only fill if you want to change password</small>
   </div>
   <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
     <label class="form-label">First Name</label>
     <input type="text" name="first_name" value="{{ user.first_name }}" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
    </div>
    <div>
     <label class="form-label">Last Name</label>
     <input type="text" name="last_name" value="{{ user.last_name }}" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
    </div>
   </div>
   <div>
    <label class="form-label">Status</label>
    <select name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
     {% for s in ['active','inactive','pending','banned'] %}
     <option value="{{ s }}" {% if user.status == s %}selected{% endif %}>{{ s|capitalize }}</option>
     {% endfor %}
    </select>
   </div>

   <section class="rounded-xl border border-slate-200 bg-slate-50">
    <div class="border-b border-slate-200 px-4 py-3">
     <h2 class="flex items-center gap-2 text-base font-semibold text-slate-950"><i class="lucide lucide-shield"></i> Assign Roles</h2>
    </div>
    <div class="p-4">
     {% if roles|length > 0 %}
     <div class="space-y-3">
      {% for role in roles %}
      <label class="flex items-start gap-3 rounded-lg border border-slate-200 bg-white p-3 {% if role.id in userRoleIds %}ring-1 ring-indigo-200{% endif %}">
       <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" name="roles[]" value="{{ role.id }}" id="role_{{ role.id }}" {% if role.id in userRoleIds %}checked{% endif %}>
       <span class="text-sm text-slate-700">
        <strong class="block text-slate-900">{{ role.name|upper }}</strong>
        {% if role.is_super_admin %}<span class="mt-1 inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-xs font-semibold text-rose-700">Super Admin</span>{% endif %}
       </span>
      </label>
      {% endfor %}
     </div>
     {% else %}
     <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">No roles available.</div>
     {% endif %}
    </div>
   </section>

   <div class="flex flex-wrap gap-2">
    <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
     <i class="lucide lucide-check-circle"></i> Update User
    </button>
    <a href="/admin/users" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Cancel</a>
   </div>
  </form>
 </section>

 {% if userRoles|length > 0 %}
 <section class="admin-panel-card max-w-4xl">
  <h2 class="mb-4 flex items-center gap-2 text-base font-semibold text-slate-950"><i class="lucide lucide-key"></i> Effective Permissions</h2>
  <div class="text-slate-500">Loading permissions...</div>
 </section>
 {% endif %}

 <div id="user-edit-data" data-user-id="{{ user.id }}"></div>
</div>
{% endblock %}
