{% extends"admin/layout.twig" %}
{% block title %}Edit User{% endblock %}
{% block stylesheets %}
 {% include 'admin/partials/_shared-form-styles.twig' %}
{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-6">

 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 text-white shadow-2xl shadow-indigo-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-violet-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-pencil" style="width:1.5em;height:1.5em;"></i>
    </div>
    <div>
     <h1 class="text-xl font-black tracking-tight sm:text-2xl">Edit User: {{ user.username }}</h1>
     <p class="mt-1 text-sm text-indigo-200/80">Update user information and roles.</p>
    </div>
   </div>
   <a href="/admin/users" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
    <i class="lucide lucide-arrow-left" style="width:0.875em;height:0.875em;"></i> Back to Users
   </a>
  </div>
 </div>

 {# ── Edit User Form Card ── #}
 <section class="scroll-fade-in max-w-3xl card-base">
  <div class="card-header">
   <h3 class="card-title">
    <i class="lucide lucide-user-cog"></i>
    Account Information
   </h3>
  </div>
  <div class="card-body">
   <form method="post" action="/admin/users/edit" class="space-y-4">
    <input type="hidden" name="id" value="{{ user.id }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    <div class="form-group">
     <label class="form-label">Username <span class="required">*</span></label>
     <div class="relative">
      <i class="lucide lucide-at-sign absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
      <input type="text" name="username" value="{{ user.username }}" required class="form-input pl-10">
     </div>
    </div>

    <div class="form-group">
     <label class="form-label">Email <span class="required">*</span></label>
     <div class="relative">
      <i class="lucide lucide-mail absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
      <input type="email" name="email" value="{{ user.email }}" required class="form-input pl-10">
     </div>
    </div>

    <div class="form-group">
     <label class="form-label">Password</label>
     <div class="relative">
      <i class="lucide lucide-lock absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
      <input type="password" name="password" placeholder="Leave blank to keep current password" class="form-input pl-10">
     </div>
     <span class="form-hint">Only fill if you want to change the password</span>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
     <div class="form-group">
      <label class="form-label">First Name</label>
      <input type="text" name="first_name" value="{{ user.first_name }}" class="form-input">
     </div>
     <div class="form-group">
      <label class="form-label">Last Name</label>
      <input type="text" name="last_name" value="{{ user.last_name }}" class="form-input">
     </div>
    </div>

    <div class="form-group">
     <label class="form-label">Status</label>
     <div class="relative">
      <i class="lucide lucide-activity absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
      <select name="status" class="form-select pl-10">
       {% for s in ['active','inactive','pending','banned'] %}
       <option value="{{ s }}" {% if user.status == s %}selected{% endif %}>{{ s|capitalize }}</option>
       {% endfor %}
      </select>
     </div>
    </div>

    {# ── Roles Assignment Card ── #}
    <div class="card-base">
     <div class="card-header">
      <h3 class="card-title">
       <i class="lucide lucide-shield"></i>
       Assign Roles
      </h3>
     </div>
     <div class="card-body">
      {% if roles|length > 0 %}
      <div class="space-y-3">
       {% for role in roles %}
       <label class="flex items-start gap-3 rounded-lg border border-slate-200 bg-white p-3 transition-all hover:border-indigo-200 hover:shadow-sm cursor-pointer {% if role.id in userRoleIds %}ring-1 ring-indigo-200 bg-indigo-50/30{% endif %}">
        <input class="mt-0.5 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" name="roles[]" value="{{ role.id }}" id="role_{{ role.id }}" {% if role.id in userRoleIds %}checked{% endif %}>
        <span>
         <strong class="block text-sm text-slate-900">{{ role.name|capitalize }}</strong>
         {% if role.is_super_admin %}<span class="mt-0.5 inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-xs font-semibold text-rose-700">Super Admin</span>{% endif %}
        </span>
       </label>
       {% endfor %}
      </div>
      {% else %}
      <div class="flex items-center gap-2 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
       <i class="lucide lucide-alert-triangle" style="width:1.125em;height:1.125em;"></i>
       <span>No roles available.</span>
      </div>
      {% endif %}
     </div>
    </div>

    {# ── Actions ── #}
    <div class="flex flex-wrap gap-2 pt-2">
     <button type="submit" class="btn-primary">
      <i class="lucide lucide-check-circle"></i> Update User
     </button>
     <a href="/admin/users" class="btn-outline">
      <i class="lucide lucide-x-circle"></i> Cancel
     </a>
    </div>
   </form>
  </div>
 </section>

 {# ── Effective Permissions Card ── #}
 {% if userRoles|length > 0 %}
 <section class="scroll-fade-in card-base">
  <div class="card-header">
   <h3 class="card-title">
    <i class="lucide lucide-key"></i>
    Effective Permissions
   </h3>
  </div>
  <div class="card-body">
   <div class="flex items-center justify-center rounded-lg bg-slate-50 py-6 text-sm text-slate-400">
    <i class="lucide lucide-loader-2 mr-2 animate-spin" style="width:1em;height:1em;"></i>
    Loading permissions...
   </div>
  </div>
 </section>
 {% endif %}

 <div id="user-edit-data" data-user-id="{{ user.id }}"></div>
</div>
{% endblock %}
