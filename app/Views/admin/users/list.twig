{% extends"admin/layout.twig" %}
{% block title %}Users{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="space-y-6">
 <section class="admin-page-header">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-users"></i>
     User Management
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Manage system users</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600">Search, filter, and maintain user accounts from one place.</p>
   </div>
   <a href="/admin/users/create" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
    <i class="lucide lucide-user-plus"></i>
    Create User
   </a>
  </div>
 </section>

 <section class="admin-panel-card">
  <form method="get" class="grid gap-4 lg:grid-cols-12">
   <div class="lg:col-span-5">
    <label class="form-label" for="user-search">Search</label>
    <div class="flex overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
     <span class="inline-flex items-center border-r border-slate-200 bg-slate-50 px-3 text-slate-400"><i class="lucide lucide-search"></i></span>
     <input id="user-search" type="text" name="search" value="{{ pagination.search|default('') }}" class="w-full border-0 px-4 py-3 text-sm shadow-none focus:ring-0" placeholder="Search by username, email, or name...">
    </div>
   </div>
   <div class="lg:col-span-2">
    <label class="form-label" for="user-status">Status</label>
    <select id="user-status" name="status">
     <option value="">All Status</option>
     <option value="active" {% if pagination.status == 'active' %}selected{% endif %}>Active</option>
     <option value="inactive" {% if pagination.status == 'inactive' %}selected{% endif %}>Inactive</option>
     <option value="pending" {% if pagination.status == 'pending' %}selected{% endif %}>Pending</option>
     <option value="banned" {% if pagination.status == 'banned' %}selected{% endif %}>Banned</option>
    </select>
   </div>
   <div class="lg:col-span-2">
    <label class="form-label" for="user-limit">Limit</label>
    <select id="user-limit" name="limit">
     <option value="10" {% if pagination.limit == 10 %}selected{% endif %}>10</option>
     <option value="20" {% if pagination.limit == 20 %}selected{% endif %}>20</option>
     <option value="50" {% if pagination.limit == 50 %}selected{% endif %}>50</option>
     <option value="100" {% if pagination.limit == 100 %}selected{% endif %}>100</option>
    </select>
   </div>
   <div class="lg:col-span-3 flex items-end justify-end">
    <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700 lg:w-auto">
     <i class="lucide lucide-filter"></i>
     Apply
    </button>
   </div>
  </form>
 </section>

 <section class="admin-panel-card">
  <div class="flex items-center justify-between gap-3 border-b border-slate-200/80 pb-4">
   <div>
    <h2 class="text-lg font-semibold text-slate-950">Users List</h2>
    <p class="mt-1 text-sm text-slate-500">Account overview with status, roles, and actions.</p>
   </div>
  </div>

  <div class="table-responsive mt-5">
   <table class="table">
    <thead>
     <tr>
      <th>ID</th>
      <th>Username</th>
      <th>Email</th>
      <th>Roles</th>
      <th>Status</th>
      <th class="text-center">Actions</th>
     </tr>
    </thead>
    <tbody>
     {% for user in users %}
     <tr>
      <td data-label="ID" class="font-semibold text-slate-900">{{ user.id }}</td>
      <td data-label="Username">
       <div class="font-semibold text-slate-900">{{ user.username }}</div>
       {% if user.first_name or user.last_name %}
        <div class="text-sm text-slate-500">{{ user.first_name }} {{ user.last_name }}</div>
       {% endif %}
      </td>
      <td data-label="Email" class="text-slate-600">{{ user.email }}</td>
      <td data-label="Roles">
       {% set roles = [] %}
       {% if user.roles is iterable %}
        {% for r in user.roles %}
         {% if r is iterable %}
          {% set roles = roles|merge([r.name|default('')]) %}
         {% else %}
          {% set roles = roles|merge([r]) %}
         {% endif %}
        {% endfor %}
       {% endif %}
       {% if roles|length > 0 %}
        <div class="flex flex-wrap gap-1.5">
         {% for role in roles %}
          {% if role %}
           <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">
            <i class="lucide lucide-shield-check mr-1"></i>{{ role|replace({"_":""})|title }}
           </span>
          {% endif %}
         {% endfor %}
        </div>
       {% else %}
        <span class="text-sm text-slate-500">No roles assigned</span>
       {% endif %}
      </td>
      <td data-label="Status">
       {% if user.status == 'active' %}
        <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700"><i class="lucide lucide-check-circle mr-1"></i>Active</span>
       {% elseif user.status == 'inactive' %}
        <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700"><i class="lucide lucide-ban mr-1"></i>Inactive</span>
       {% elseif user.status == 'pending' %}
        <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700"><i class="lucide lucide-hourglass mr-1"></i>Pending</span>
       {% elseif user.status == 'banned' %}
        <span class="inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-xs font-semibold text-rose-700"><i class="lucide lucide-alert-circle mr-1"></i>Banned</span>
       {% else %}
        <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">{{ user.status }}</span>
       {% endif %}
      </td>
      <td data-label="Actions" class="text-center">
       <div class="inline-flex flex-wrap justify-center gap-2">
        <a href="/admin/users/edit?id={{ user.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" title="Edit">
         <i class="lucide lucide-pencil"></i>
         Edit
        </a>
        <form method="POST" action="/admin/users/delete" class="inline">
         <input type="hidden" name="id" value="{{ user.id }}">
         <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-rose-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-rose-700" title="Delete" onclick="return confirm('Are you sure you want to delete this user?')">
          <i class="lucide lucide-trash-2"></i>
          Delete
         </button>
        </form>
       </div>
      </td>
     </tr>
     {% else %}
     <tr>
      <td colspan="6" class="py-8 text-center text-slate-500">
       <i class="lucide lucide-info mr-1"></i> No users found.
      </td>
     </tr>
     {% endfor %}
    </tbody>
   </table>
  </div>

  <div class="mt-6">
   {% include"admin/partials/pagination.twig" %}
  </div>
 </section>
</div>
{% endblock %}
