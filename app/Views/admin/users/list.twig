{% extends"admin/layout.twig" %}
{% block title %}Users{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4">

 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 text-white shadow-2xl shadow-indigo-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-violet-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-users" style="width:1.5em;height:1.5em;"></i>
    </div>
    <div>
     <h1 class="text-xl font-black tracking-tight sm:text-2xl">User Management</h1>
     <p class="mt-1 text-sm text-indigo-200/80">Search, filter, and maintain user accounts from one place.</p>
    </div>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/users/create" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-user-plus" style="width:0.875em;height:0.875em;"></i> Create User
    </a>
   </div>
  </div>
 </div>

 {# ── Filter Section ── #}
 <section class="scroll-fade-in mb-6 overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-amber-50/50 to-orange-50/50 px-5 py-4">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-amber-100 text-amber-600">
    <i class="lucide lucide-filter" style="width:1em;height:1em;"></i>
   </div>
   <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Filter Users</h2>
    <p class="text-xs text-slate-500">Search by username, email, or name</p>
   </div>
  </div>
  <form method="get" class="p-5">
   <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div>
     <label for="user-search" class="block text-xs font-medium text-slate-500 mb-1">Search</label>
     <div class="relative">
      <i class="lucide lucide-search absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400" style="width:0.875em;height:0.875em;"></i>
      <input id="user-search" type="text" name="search" value="{{ pagination.search|default('') }}" placeholder="Username, email, or name…" class="w-full rounded-lg border border-slate-300 pl-8 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
     </div>
    </div>
    <div>
     <label for="user-status" class="block text-xs font-medium text-slate-500 mb-1">Status</label>
     <select id="user-status" name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      <option value="">All</option>
      <option value="active" {% if pagination.status == 'active' %}selected{% endif %}>Active</option>
      <option value="inactive" {% if pagination.status == 'inactive' %}selected{% endif %}>Inactive</option>
      <option value="pending" {% if pagination.status == 'pending' %}selected{% endif %}>Pending</option>
      <option value="banned" {% if pagination.status == 'banned' %}selected{% endif %}>Banned</option>
     </select>
    </div>
    <div>
     <label for="user-limit" class="block text-xs font-medium text-slate-500 mb-1">Per Page</label>
     <select id="user-limit" name="limit" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      <option value="10" {% if pagination.limit == 10 %}selected{% endif %}>10</option>
      <option value="20" {% if pagination.limit == 20 %}selected{% endif %}>20</option>
      <option value="50" {% if pagination.limit == 50 %}selected{% endif %}>50</option>
      <option value="100" {% if pagination.limit == 100 %}selected{% endif %}>100</option>
     </select>
    </div>
    <div class="flex items-end">
     <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 hover:shadow-md active:scale-[0.97] w-full">
      <i class="lucide lucide-filter" style="width:1em;height:1em;"></i> Apply
     </button>
    </div>
   </div>
  </form>
 </section>

 {# ── Users List Table ── #}
 <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
    <i class="lucide lucide-users" style="width:1em;height:1em;"></i>
   </div>
   <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Users List</h2>
    <p class="text-xs text-slate-500">Account overview with status, roles, and actions</p>
   </div>
  </div>
  <div class="overflow-x-auto">
   <table class="w-full text-left text-sm">
    <thead>
     <tr class="border-b border-slate-100 bg-slate-50/50">
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">ID</th>
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Username</th>
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Email</th>
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Roles</th>
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Status</th>
      <th class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Actions</th>
     </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
     {% for user in users %}
     <tr class="transition-colors duration-150 hover:bg-indigo-50/30">
      <td class="px-5 py-3.5"><span class="font-semibold text-slate-900">{{ user.id }}</span></td>
      <td class="px-5 py-3.5">
       <div class="font-semibold text-slate-900">{{ user.username }}</div>
       {% if user.first_name or user.last_name %}
        <div class="text-xs text-slate-500">{{ user.first_name }} {{ user.last_name }}</div>
       {% endif %}
      </td>
      <td class="px-5 py-3.5 text-sm text-slate-600">{{ user.email }}</td>
      <td class="px-5 py-3.5">
       {% set roles = [] %}
       {% if user.roles is iterable %}
        {% for r in user.roles %}
         {% if r is iterable %}
          {% set roles = roles|merge([r.name|default('')]) %}
         {% else %}
          {% set roles = roles|merge([r]) %}
         {% endif %}
        {% endfor %}
       {% endif %}
       {% if roles|length > 0 %}
        <div class="flex flex-wrap gap-1">
         {% for role in roles %}
          {% if role %}
           <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">{{ role|replace({" ":""})|title }}</span>
          {% endif %}
         {% endfor %}
        </div>
       {% else %}
        <span class="text-xs text-slate-400">No roles</span>
       {% endif %}
      </td>
      <td class="px-5 py-3.5">
       {% set status_map = {'active':'bg-emerald-50 text-emerald-700','inactive':'bg-slate-100 text-slate-600','pending':'bg-amber-50 text-amber-700','banned':'bg-rose-50 text-rose-700'} %}
       <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {{ status_map[user.status]|default('bg-slate-100 text-slate-600') }}">{{ user.status|title }}</span>
      </td>
      <td class="px-5 py-3.5 text-right">
       <div class="inline-flex items-center gap-1.5">
        <a href="/admin/users/edit?id={{ user.id }}" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-600 shadow-sm transition-all hover:bg-slate-50 hover:-translate-y-0.5" title="Edit">
         <i class="lucide lucide-pencil" style="width:0.75em;height:0.75em;"></i>
        </a>
        <form method="POST" action="/admin/users/delete" class="inline" onsubmit="return confirm('Delete this user?')">
         <input type="hidden" name="id" value="{{ user.id }}">
         <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-rose-600 px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm transition-all hover:bg-rose-700 hover:-translate-y-0.5" title="Delete">
          <i class="lucide lucide-trash-2" style="width:0.75em;height:0.75em;"></i>
         </button>
        </form>
       </div>
      </td>
     </tr>
     {% else %}
     <tr>
      <td colspan="6" class="px-5 py-8 text-center text-slate-500">
       <i class="lucide lucide-inbox mx-auto text-slate-300" style="width:2em;height:2em;"></i>
       <p class="mt-2 text-sm">No users found.</p>
      </td>
     </tr>
     {% endfor %}
    </tbody>
   </table>
  </div>
  <div class="border-t border-slate-100 px-5 py-4">
   {% include "admin/partials/pagination.twig" %}
  </div>
 </section>
</div>
{% endblock %}
