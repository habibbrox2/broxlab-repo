{% extends"admin/layout.twig" %}
{% block title %}Add New User{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="space-y-6">
 <section class="admin-page-header">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-user-plus"></i>
     User Management
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Create New User</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600">Add a new user to the system.</p>
   </div>
   <a href="/admin/users" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
    <i class="lucide lucide-arrow-left"></i> Back to Users
   </a>
  </div>
 </section>

 <section class="admin-panel-card max-w-4xl">
  <form method="post" action="/admin/users/create" class="space-y-4">
   <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
   <div>
    <label for="username" class="form-label">Username *</label>
    <input type="text" id="username" name="username" value="{{ old('username') }}" placeholder="unique username" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
    {% if error('username') %}<div class="mt-1 text-sm text-rose-600">{{ error('username') }}</div>{% endif %}
   </div>
   <div>
    <label for="email" class="form-label">Email *</label>
    <input type="email" id="email" name="email" value="{{ old('email') }}" placeholder="user@example.com" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
    {% if error('email') %}<div class="mt-1 text-sm text-rose-600">{{ error('email') }}</div>{% endif %}
   </div>
   <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
     <label for="password" class="form-label">Password *</label>
     <input type="password" id="password" name="password" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
    </div>
    <div>
     <label for="password_confirmation" class="form-label">Confirm Password *</label>
     <input type="password" id="password_confirmation" name="password_confirmation" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
    </div>
   </div>
   <div>
    <label for="status" class="form-label">Status</label>
    <select id="status" name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
     <option value="active" {{ old('status') == 'active' ? 'selected' : '' }}>Active</option>
     <option value="inactive" {{ old('status') == 'inactive' ? 'selected' : '' }}>Inactive</option>
    </select>
   </div>

   <section class="rounded-xl border border-slate-200 bg-slate-50">
    <div class="border-b border-slate-200 px-4 py-3">
     <h2 class="flex items-center gap-2 text-base font-semibold text-slate-950"><i class="lucide lucide-shield"></i> Assign Roles</h2>
    </div>
    <div class="p-4">
     {% if roles is defined and roles|length > 0 %}
     <div class="space-y-3">
      {% for role in roles %}
      <label class="flex items-start gap-3 rounded-lg border border-slate-200 bg-white p-3">
       <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" name="roles[]" value="{{ role.id }}" id="role_{{ role.id }}" {{ role.id in old('roles', []) ? 'checked' : '' }}>
       <span class="text-sm text-slate-700">{{ role.name|capitalize }}</span>
      </label>
      {% endfor %}
     </div>
     {% else %}
     <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
      <i class="lucide lucide-alert-triangle mr-2"></i>
      No roles available.
      <a href="/admin/roles" class="font-semibold text-amber-900 underline">Create roles first</a>
     </div>
     {% endif %}
    </div>
   </section>

   <div class="flex flex-wrap gap-2">
    <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
     <i class="lucide lucide-check-circle"></i> Create User
    </button>
    <a href="/admin/users" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
     <i class="lucide lucide-x-circle"></i> Cancel
    </a>
   </div>
  </form>
 </section>
</div>
{% endblock %}
