{% extends"admin/layout.twig" %}
{% block title %}All Posts{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="space-y-6">
 <section class="admin-page-header">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-file-text"></i>
     Posts Management
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Manage all blog posts</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600">Search, sort, and maintain the editorial catalog.</p>
   </div>
   <a href="/admin/posts/create" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
    <i class="lucide lucide-plus-circle"></i>
    Add New Post
   </a>
  </div>
 </section>

 <section class="admin-panel-card">
  <form class="grid gap-4 lg:grid-cols-12" method="get" action="">
   <div class="lg:col-span-4">
    <label class="form-label" for="post-search">Search</label>
    <div class="flex overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
     <span class="inline-flex items-center border-r border-slate-200 bg-slate-50 px-3 text-slate-400"><i class="lucide lucide-search"></i></span>
     <input id="post-search" type="text" name="search" value="{{ search|default('') }}" class="w-full border-0 px-4 py-3 text-sm shadow-none focus:ring-0" placeholder="Search by title...">
    </div>
   </div>
   <div class="lg:col-span-3">
    <label class="form-label" for="post-sort">Sort</label>
    <select id="post-sort" name="sort">
     <option value="created_at" {{ sort|default('created_at') == 'created_at' ? 'selected' : '' }}>Latest</option>
     <option value="title" {{ sort|default('created_at') == 'title' ? 'selected' : '' }}>Title</option>
    </select>
   </div>
   <div class="lg:col-span-2">
    <label class="form-label" for="post-order">Order</label>
    <select id="post-order" name="order">
     <option value="DESC" {{ order|default('DESC') == 'DESC' ? 'selected' : '' }}>Desc</option>
     <option value="ASC" {{ order|default('DESC') == 'ASC' ? 'selected' : '' }}>Asc</option>
    </select>
   </div>
   <div class="lg:col-span-2">
    <label class="form-label" for="post-limit">Limit</label>
    <select id="post-limit" name="limit">
     <option value="10" {{ limit|default(20) == 10 ? 'selected' : '' }}>10</option>
     <option value="20" {{ limit|default(20) == 20 ? 'selected' : '' }}>20</option>
     <option value="50" {{ limit|default(20) == 50 ? 'selected' : '' }}>50</option>
     <option value="100" {{ limit|default(20) == 100 ? 'selected' : '' }}>100</option>
    </select>
   </div>
   <div class="lg:col-span-1 flex items-end">
    <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
     <i class="lucide lucide-filter"></i>
    </button>
   </div>
  </form>
 </section>

 {% if posts is not empty %}
 <section class="admin-panel-card">
  <div class="flex items-center justify-between border-b border-slate-200/80 pb-4">
   <div>
    <h2 class="text-lg font-semibold text-slate-950">Posts</h2>
    <p class="mt-1 text-sm text-slate-500">Editorial overview with status and quick actions.</p>
   </div>
  </div>
  <div class="table-responsive mt-5">
   <table class="table">
    <thead>
     <tr>
      <th>#</th>
      <th>Title</th>
      <th>Author</th>
      <th>Permalink</th>
      <th>Status</th>
      <th class="text-center">Actions</th>
     </tr>
    </thead>
    <tbody>
     {% for post in posts %}
     <tr>
      <td data-label="#" class="font-semibold text-slate-900">{{ post.id }}</td>
      <td data-label="Title" class="font-medium text-slate-900">{{ post.title }}</td>
      <td data-label="Author" class="text-slate-600"><i class="lucide lucide-user-circle mr-1 text-slate-400"></i>{{ post.author ?? 'N/A' }}</td>
      <td data-label="Permalink"><code class="rounded-lg bg-slate-100 px-3 py-1 text-xs text-slate-600">{{ post.slug }}</code></td>
      <td data-label="Status">
       <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {{ post.published ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' }}">
        <i class="lucide {{ post.published ? 'lucide-check-circle' : 'lucide-pencil' }} mr-1"></i>
        {{ post.published ? 'Published' : 'Draft' }}
       </span>
      </td>
      <td data-label="Actions" class="text-center">
       <div class="inline-flex flex-wrap justify-center gap-2">
        <a href="/admin/posts/view?id={{ post.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" title="View"><i class="lucide lucide-eye"></i>View</a>
        <a href="/admin/posts/edit?id={{ post.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-indigo-700" title="Edit"><i class="lucide lucide-pencil"></i>Edit</a>
        <a href="/admin/posts/delete?id={{ post.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg bg-rose-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-rose-700" title="Delete" onclick="return confirm('Are you sure you want to delete this post?');"><i class="lucide lucide-trash-2"></i>Delete</a>
       </div>
      </td>
     </tr>
     {% endfor %}
    </tbody>
   </table>
  </div>
 </section>

 <div>{% include"admin/partials/pagination.twig" %}</div>
 {% else %}
 <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex items-center gap-3 text-slate-500">
   <i class="lucide lucide-info"></i>
   <div>No posts found.</div>
  </div>
 </div>
 {% endif %}
</div>
{% endblock %}
