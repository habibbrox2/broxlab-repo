{% extends"admin/layout.twig" %}
{% block title %}{{ post.title }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-file-text mr-2"></i>
 Post Details
 </div>
 <div>View post information</div>
 </div>

 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class=" border-slate-200 px-4 py-3">
 <h4 class="mb-0">
 <i class="lucide lucide-file-text mr-2"></i>{{ post.title }}
 </h4>
 </div>
 <div class="p-4">
 <p class="mb-1 text-slate-500">
 <i class="lucide lucide-user mr-1"></i> <strong>{{ post.author }}</strong>
 <span class="mx-2">|</span>
 <i class="lucide lucide-calendar mr-1"></i> {{ post.created_at|date("Y-m-d H:i") }}
 </p>
 <p class="small mb-2">
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-600">
 <i class="lucide lucide-link mr-1"></i>
 <a href="/posts/{{ post.id }}/{{ post.slug|url_encode }}" target="_blank" class="text-white text-decoration-underline">{{ post.slug }}</a>
 </span>
 </p>
 {% if post.categories is defined and post.categories|length > 0 %}
 <p class="mb-2">
 <i class="lucide lucide-folder-open text-amber-600 mr-1"></i>
 {% for category in post.categories %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-amber-500 text-surface-dark mr-1">{{ category.name }}</span>
 {% endfor %}
 </p>
 {% endif %}
 {% if post.tags is defined and post.tags|length > 0 %}
 <p class="mb-0">
 <i class="lucide lucide-tags text-indigo-600 mr-1"></i>
 {% for tag in post.tags %}<span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-100 text-surface-dark border mr-1">#{{ tag.name }}</span>{% endfor %}
 </p>
 {% endif %}
 </div>
 </div>

 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class="p-4">{{ post.content|raw }}</div>
 </div>

 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class=" border-slate-200 px-4 py-3">
 <h5 class="mb-0">
 <i class="lucide lucide-message-circle mr-2"></i>Comments & Feedback
 </h5>
 </div>
 <div class="p-4">
 <p class="text-slate-500">
 <i class="lucide lucide-info mr-1"></i>
 Comments are managed through the main Comments panel.
 <a href="/admin/comments" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs bg-indigo-600 text-white hover:bg-indigo-700 ml-2">
 <i class="lucide lucide-message-circle mr-1"></i>Go to Comments Management
 </a>
 </p>
 <p class="mb-0">
 <small class="text-slate-500">
 <i class="lucide lucide-users mr-1"></i>Users can post comments on the public post page at:
 <a href="/posts/{{ post.id }}/{{ post.slug|url_encode }}" target="_blank" class="text-indigo-600">/posts/{{ post.id }}/{{ post.slug }}</a>
 </small>
 </p>
 </div>
 </div>

 <div class="flex justify-end">
 <a href="/admin/posts" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200">
 <i class="lucide lucide-arrow-left mr-1"></i> Back to Posts
 </a>
 </div>
 </div>
{% endblock %}




