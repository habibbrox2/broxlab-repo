{% extends"admin/layout.twig" %}
{% block title %}Edit Admin Profile{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <!-- Page Header -->
 <div class=" mb-4">
 <h1>
 <i class="lucide lucide-user-circle"></i> Edit Admin Profile
 </h1>
 <p>Update your profile information and settings</p>
 </div>
 <!-- Tab Navigation -->
 <ul class="mb-4 flex flex-wrap gap-1 border-b border-slate-200 pb-0" id="profileTabs" role="tablist">
 <li role="presentation">
 <button class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-indigo-600 px-4 py-2.5 text-sm font-semibold text-indigo-700 transition"
 id="edit-tab"
 data-brox-toggle="tab"
 data-brox-target="#edit"
 type="button"
 role="tab"
 aria-controls="edit"
 aria-selected="true">
 <i class="lucide lucide-pencil"></i> Edit Profile
 </button>
 </li>
 <li role="presentation">
 <button class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-300 hover:text-slate-900"
 id="password-tab"
 data-brox-toggle="tab"
 data-brox-target="#password"
 type="button"
 role="tab"
 aria-controls="password"
 aria-selected="false">
 <i class="lucide lucide-key"></i> Change Password
 </button>
 </li>
 <li role="presentation">
 <button class="inline-flex items-center gap-2 rounded-t-xl border-b-2 border-transparent px-4 py-2.5 text-sm font-medium text-slate-600 transition hover:border-slate-300 hover:text-slate-900"
 id="security-tab"
 data-brox-toggle="tab"
 data-brox-target="#security"
 type="button"
 role="tab"
 aria-controls="security"
 aria-selected="false">
 <i class="lucide lucide-shield"></i> 2FA Settings
 </button>
 </li>
 </ul>
 <!-- Tab Content -->
 <div class="tab-content" id="profileTabContent">
 <!-- Edit Profile Tab -->
 <div class="tab-pane fade show active"
 id="edit"
 role="tabpanel"
 aria-labelledby="edit-tab">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 border-primary">
 <h5 class="mb-0">
 <i class="lucide lucide-pencil"></i> Profile Information
 </h5>
 </div>
 <div class="p-4">
 <form method="POST"
 action="/admin/profile/edit"
 enctype="multipart/form-data">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <!-- Username & Email -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="md:col-span-6">
 <label for="username" class="form-label">Username</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="username"
 name="username"
 value="{{ user.username }}"
 placeholder="Enter username"
 required>
 </div>
 <div class="md:col-span-6">
 <label for="email" class="form-label">Email</label>
 <input type="email"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="email"
 name="email"
 value="{{ user.email }}"
 placeholder="Enter email"
 required>
 </div>
 </div>
 <!-- First Name & Last Name -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="md:col-span-6">
 <label for="first_name" class="form-label">First Name</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="first_name"
 name="first_name"
 value="{{ user.first_name }}"
 placeholder="Enter first name">
 </div>
 <div class="md:col-span-6">
 <label for="last_name" class="form-label">Last Name</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="last_name"
 name="last_name"
 value="{{ user.last_name }}"
 placeholder="Enter last name">
 </div>
 </div>
 <!-- Gender, DOB & Phone -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="md:col-span-4">
 <label for="gender" class="form-label">Gender</label>
 <select id="gender" name="gender" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
 <option value="" {% if not user.gender %}selected{% endif %}>Select</option>
 <option value="male" {% if user.gender == 'male' %}selected{% endif %}>Male</option>
 <option value="female" {% if user.gender == 'female' %}selected{% endif %}>Female</option>
 <option value="other" {% if user.gender == 'other' %}selected{% endif %}>Other</option>
 </select>
 </div>
 <div class="md:col-span-4">
 <label for="dob" class="form-label">Date of Birth</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 datepicker"
 id="dob"
 name="dob"
 value="{{ user.dob ? user.dob|date("d-m-Y") : '' }}"
 placeholder="DD-MM-YYYY"
 autocomplete="off">
 </div>
 <div class="md:col-span-4">
 <label for="phone" class="form-label">Phone</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="phone"
 name="phone"
 value="{{ user.phone }}"
 placeholder="Enter phone number">
 </div>
 </div>
 <!-- Alternate Phone & Address -->
 <div class="mb-3">
 <label for="alternate_phone" class="form-label">Alternate Phone</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="alternate_phone"
 name="alternate_phone"
 value="{{ user.alternate_phone }}"
 placeholder="Enter alternate phone number">
 </div>
 <div class="mb-3">
 <label for="address" class="form-label">Address</label>
 <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="address" name="address" rows="2">{{ user.address }}</textarea>
 </div>
 <!-- City, State & Zipcode -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="md:col-span-4">
 <label for="city" class="form-label">City</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="city"
 name="city"
 value="{{ user.city }}"
 placeholder="Enter city">
 </div>
 <div class="md:col-span-4">
 <label for="state" class="form-label">State</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="state"
 name="state"
 value="{{ user.state }}"
 placeholder="Enter state">
 </div>
 <div class="md:col-span-4">
 <label for="zipcode" class="form-label">Zipcode</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="zipcode"
 name="zipcode"
 value="{{ user.zipcode }}"
 placeholder="Enter zipcode">
 </div>
 </div>
 <!-- Country -->
 <div class="mb-3">
 <label for="country" class="form-label">Country</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="country"
 name="country"
 value="{{ user.country }}"
 placeholder="Enter country">
 </div>
 <!-- Social Links -->
 <h5 class="mt-4 mb-3">
 <i class="lucide lucide-share-2 mr-2 text-sky-600"></i>Social Links
 </h5>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="md:col-span-6 mb-2">
 <label for="facebook_url" class="form-label">Facebook</label>
 <input type="url"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="facebook_url"
 name="facebook_url"
 value="{{ user.facebook_url|default("") }}"
 placeholder="Enter Facebook profile URL">
 </div>
 <div class="md:col-span-6 mb-2">
 <label for="twitter_url" class="form-label">Twitter</label>
 <input type="url"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="twitter_url"
 name="twitter_url"
 value="{{ user.twitter_url|default("") }}"
 placeholder="Enter Twitter profile URL">
 </div>
 <div class="md:col-span-6 mb-2">
 <label for="instagram_url" class="form-label">Instagram</label>
 <input type="url"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="instagram_url"
 name="instagram_url"
 value="{{ user.instagram_url|default("") }}"
 placeholder="Enter Instagram profile URL">
 </div>
 <div class="md:col-span-6 mb-2">
 <label for="linkedin_url" class="form-label">LinkedIn</label>
 <input type="url"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="linkedin_url"
 name="linkedin_url"
 value="{{ user.linkedin_url|default("") }}"
 placeholder="Enter LinkedIn profile URL">
 </div>
 </div>
 <!-- Profile Picture -->
 <div class="mb-3">
 <label for="profile_pic" class="form-label">Profile Picture</label>
 {% if user.profile_pic %}
 <div class="mb-2">
 <img src="{{ user.profile_pic }}"
 alt="Profile Picture"
 class="img-thumbnail"
 width="120">
 </div>
 {% endif %}
 <input type="file"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="profile_pic"
 name="profile_pic"
 accept="image/*">
 </div>
 <!-- Submit & Cancel Buttons -->
 <div class="flex justify-start gap-2 mt-3">
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-emerald-600 text-white hover:bg-emerald-700">
 <i class="lucide lucide-check-circle mr-1"></i> Update Profile
 </button>
 <a href="/admin/profile" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100">
 <i class="lucide lucide-x-circle mr-1"></i> Cancel
 </a>
 </div>
 </form>
 </div>
 </div>
 </div>
 <!-- Change Password Tab -->
 <div class="tab-pane fade"
 id="password"
 role="tabpanel"
 aria-labelledby="password-tab">
 <div class=" border border-slate-200 bg-white shadow-sm rounded-2xl p-4">
 <h5 class="mb-3">
 <i class="lucide lucide-key mr-1"></i> Change Password
 </h5>
 <p class="text-slate-500 mb-4">Update your password to keep your admin account secure.</p>
 <a href="/admin/profile/password" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
 <i class="lucide lucide-arrow-right mr-1"></i> Go to Change Password
 </a>
 </div>
 </div>
 <!-- 2FA Settings Tab -->
 <div class="tab-pane fade"
 id="security"
 role="tabpanel"
 aria-labelledby="security-tab">
 <div class=" border border-slate-200 bg-white shadow-sm rounded-2xl p-4">
 <h5 class="mb-3">
 <i class="lucide lucide-shield mr-1"></i> Two-Factor Authentication (2FA)
 </h5>
 <p class="text-slate-500 mb-4">Add an extra layer of security to your admin account using two-factor authentication.</p>
 <a href="/admin/security/2fa" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-emerald-600 text-white hover:bg-emerald-700">
 <i class="lucide lucide-shield-check mr-1"></i> Manage 2FA Settings
 </a>
 </div>
 </div>
 </div>
 </div>
{% endblock %}





