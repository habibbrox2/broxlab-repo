{% extends"admin/layout.twig" %}
{% block title %}Admin Profile{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-shield"></i>
 Admin Profile
 </div>
 <div>View and manage your admin profile information</div>
 </div>
 <div class="flex justify-end gap-2 mb-4">
 <a href="/admin/profile/edit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
 <i class="lucide lucide-pencil mr-1"></i> Edit Profile
 </a>
 <a href="/admin/profile/password" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200">
 <i class="lucide lucide-key mr-1"></i> Change Password
 </a>
 <a href="/admin/security/2fa" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition inline-flex transition-ghost-success">
 <i class="lucide lucide-shield mr-1"></i> 2FA Settings
 </a>
 </div>
 {% set role_names = [] %}
 {% if user.roles is iterable %}
 {% for role_item in user.roles %}
 {% if role_item.name is defined and role_item.name %}
 {% set role_names = role_names|merge([role_item.name]) %}
 {% elseif role_item is not iterable and role_item %}
 {% set role_names = role_names|merge([role_item]) %}
 {% endif %}
 {% endfor %}
 {% endif %}
 {% set primary_role = role_names|first|default(user.role|default('')) %}
 {% if (primary_role is empty) and user.is_super_admin %}
 {% set primary_role ="super_admin" %}
 {% endif %}
 {% if primary_role is empty %}
 {% set primary_role ="N/A" %}
 {% endif %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <!-- Basic Info Card -->
 <div class="md:col-span-6">
 <div class=" border border-slate-200 bg-white shadow-sm h-full">
 <div class="p-4">
 <h5 class=" mb-3">
 <i class="lucide lucide-user-check mr-2 text-indigo-600"></i>Basic Information
 </h5>
 <ul class="flex flex-col divide-y divide-slate-100">
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Username:</strong> {{ user.username }}
 </li>
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Email:</strong> {{ user.email }}
 </li>
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Full Name:</strong> {{ user.first_name }} {{ user.last_name }}
 </li>
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Gender:</strong> {{ user.gender|default("N/A") }}
 </li>
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Date of Birth:</strong> {{ user.dob ? user.dob|date("d M, Y") : 'N/A' }}
 </li>
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Phone:</strong> {{ user.phone|default("N/A") }}
 </li>
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Alternate Phone:</strong> {{ user.alternate_phone|default("N/A") }}
 </li>
 </ul>
 </div>
 </div>
 </div>
 <!-- Address & Status Card -->
 <div class="md:col-span-6">
 <div class=" border border-slate-200 bg-white shadow-sm h-full">
 <div class="p-4">
 <h5 class=" mb-3">
 <i class="lucide lucide-map-pin mr-2 text-emerald-600"></i>Address & Status
 </h5>
 <ul class="flex flex-col divide-y divide-slate-100">
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Address:</strong> {{ user.address }}, {{ user.city }}, {{ user.state }}, {{ user.country }} - {{ user.zipcode }}
 </li>
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Role:</strong> <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-red-600">{{ primary_role|replace({"_":""}) |title }}</span>
 </li>
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Status:</strong> <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-{{ user.status == 'active' ? 'success' : 'secondary' }}">{{ user.status|capitalize }}</span>
 </li>
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Email Verified:</strong> {{ user.email_verified ? 'Yes' : 'No' }}
 </li>
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Phone Verified:</strong> {{ user.phone_verified ? 'Yes' : 'No' }}
 </li>
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Last Login:</strong> {{ user.last_login|default("Never") }}
 </li>
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Login IP:</strong> {{ user.login_ip|default("N/A") }}
 </li>
 <li class="flex items-center justify-between px-4 py-3">
 <strong>Device:</strong> {{ user.login_device|default("N/A") }}
 </li>
 </ul>
 </div>
 </div>
 </div>
 <!-- Roles Card -->
 <div class="md:col-span-6">
 <div class=" border border-slate-200 bg-white shadow-sm h-full">
 <div class="p-4">
 <h5 class=" mb-3">
 <i class="lucide lucide-user-check mr-2 text-indigo-600"></i>Roles
 </h5>
 {% if role_names|length > 0 %}
 <ul class="flex flex-col divide-y divide-slate-100">
 {% for role_name in role_names %}
 <li class="flex items-center justify-between px-4 py-3">{{ role_name|replace({"_":""}) |title }}</li>
 {% endfor %}
 </ul>
 {% elseif user.role %}
 <ul class="flex flex-col divide-y divide-slate-100">
 <li class="flex items-center justify-between px-4 py-3">{{ user.role|replace({"_":""}) |title }}</li>
 </ul>
 {% else %}
 <p class="text-slate-500">No roles assigned</p>
 {% endif %}
 </div>
 </div>
 </div>
 <!-- Social Links Card -->
 <div class="col-span-12">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class="p-4">
 <h5 class=" mb-3">
 <i class="lucide lucide-share-2 mr-2 text-sky-600"></i>Social Links
 </h5>
 <p class="mb-0">
 {% set has_social = user.facebook_url or user.twitter_url or user.instagram_url or user.linkedin_url %}
 {% if has_social %}
 {% if user.facebook_url %}
 <a href="{{ user.facebook_url }}" target="_blank" class="mr-3"><i class="lucide lucide-facebook text-indigo-600"></i> Facebook</a>
 {% endif %}
 {% if user.twitter_url %}
 <a href="{{ user.twitter_url }}" target="_blank" class="mr-3"><i class="lucide lucide-twitter text-sky-600"></i> Twitter</a>
 {% endif %}
 {% if user.instagram_url %}
 <a href="{{ user.instagram_url }}" target="_blank" class="mr-3"><i class="lucide lucide-instagram text-red-600"></i> Instagram</a>
 {% endif %}
 {% if user.linkedin_url %}
 <a href="{{ user.linkedin_url }}" target="_blank" class="mr-3"><i class="lucide lucide-linkedin text-indigo-600"></i> LinkedIn</a>
 {% endif %}
 {% else %}
 N/A
 {% endif %}
 </p>
 </div>
 </div>
 </div>
 </div>
 </div>
{% endblock %}




