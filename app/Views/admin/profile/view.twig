{% extends"admin/layout.twig" %}
{% block title %}Admin Profile{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="space-y-6">
 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 text-white shadow-2xl shadow-indigo-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-violet-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-user-circle" style="width:1.5em;height:1.5em;"></i>
    </div>
    <div>
     <h1 class="text-xl font-black tracking-tight sm:text-2xl">Admin Profile</h1>
     <p class="mt-1 text-sm text-indigo-200/80">View and manage your admin profile information</p>
    </div>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/profile/edit" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-pencil" style="width:0.875em;height:0.875em;"></i> Edit Profile
    </a>
    <a href="/admin/profile/password" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-key" style="width:0.875em;height:0.875em;"></i> Change Password
    </a>
    <a href="/admin/security/2fa" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-shield" style="width:0.875em;height:0.875em;"></i> 2FA Settings
    </a>
   </div>
  </div>
 </div>

 {% set role_names = [] %}
 {% if user.roles is iterable %}
  {% for role_item in user.roles %}
   {% if role_item.name is defined and role_item.name %}
    {% set role_names = role_names|merge([role_item.name]) %}
   {% elseif role_item is not iterable and role_item %}
    {% set role_names = role_names|merge([role_item]) %}
   {% endif %}
  {% endfor %}
 {% endif %}
 {% set primary_role = role_names|first|default(user.role|default('')) %}
 {% if (primary_role is empty) and user.is_super_admin %}
  {% set primary_role ="super_admin" %}
 {% endif %}
 {% if primary_role is empty %}
  {% set primary_role ="N/A" %}
 {% endif %}

 <div class="grid grid-cols-1 gap-5 lg:grid-cols-12">
  {# Basic Info Card #}
  <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md lg:col-span-6">
   <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
    <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
     <i class="lucide lucide-user-check" style="width:0.875em;height:0.875em;"></i>
    </div>
    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">Basic Information</h2>
   </div>
   <div class="p-5">
    <dl class="space-y-0 divide-y divide-slate-100">
     <div class="flex items-center justify-between px-4 py-3"><dt class="text-sm font-semibold text-slate-700">Username:</dt><dd class="text-sm text-slate-600 m-0">{{ user.username }}</dd></div>
     <div class="flex items-center justify-between px-4 py-3"><dt class="text-sm font-semibold text-slate-700">Email:</dt><dd class="text-sm text-slate-600 m-0">{{ user.email }}</dd></div>
     <div class="flex items-center justify-between px-4 py-3"><dt class="text-sm font-semibold text-slate-700">Full Name:</dt><dd class="text-sm text-slate-600 m-0">{{ user.first_name }} {{ user.last_name }}</dd></div>
     <div class="flex items-center justify-between px-4 py-3"><dt class="text-sm font-semibold text-slate-700">Gender:</dt><dd class="text-sm text-slate-600 m-0">{{ user.gender|default("N/A") }}</dd></div>
     <div class="flex items-center justify-between px-4 py-3"><dt class="text-sm font-semibold text-slate-700">DOB:</dt><dd class="text-sm text-slate-600 m-0">{{ user.dob ? user.dob|date("d M, Y") : 'N/A' }}</dd></div>
     <div class="flex items-center justify-between px-4 py-3"><dt class="text-sm font-semibold text-slate-700">Phone:</dt><dd class="text-sm text-slate-600 m-0">{{ user.phone|default("N/A") }}</dd></div>
     <div class="flex items-center justify-between px-4 py-3"><dt class="text-sm font-semibold text-slate-700">Alt Phone:</dt><dd class="text-sm text-slate-600 m-0">{{ user.alternate_phone|default("N/A") }}</dd></div>
    </dl>
   </div>
  </div>

  {# Address & Status Card #}
  <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md lg:col-span-6">
   <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-emerald-50/50 to-teal-50/50 px-5 py-4">
    <div class="flex h-7 w-7 items-center justify-center rounded-md bg-emerald-100 text-emerald-600">
     <i class="lucide lucide-map-pin" style="width:0.875em;height:0.875em;"></i>
    </div>
    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">Address & Status</h2>
   </div>
   <div class="p-5">
    <dl class="space-y-0 divide-y divide-slate-100">
     <div class="flex items-center justify-between px-4 py-3"><dt class="text-sm font-semibold text-slate-700">Address:</dt><dd class="text-sm text-slate-600 m-0">{{ user.address }}, {{ user.city }}, {{ user.state }}, {{ user.country }} - {{ user.zipcode }}</dd></div>
     <div class="flex items-center justify-between px-4 py-3">
      <dt class="text-sm font-semibold text-slate-700">Role:</dt>
      <dd><span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-semibold text-indigo-700">{{ primary_role|replace({"_:":""}) |title }}</span></dd>
     </div>
     <div class="flex items-center justify-between px-4 py-3">
      <dt class="text-sm font-semibold text-slate-700">Status:</dt>
      <dd><span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold {{ user.status == 'active' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' }}">{{ user.status|capitalize }}</span></dd>
     </div>
     <div class="flex items-center justify-between px-4 py-3"><dt class="text-sm font-semibold text-slate-700">Email Verified:</dt><dd class="text-sm text-slate-600 m-0">{{ user.email_verified ? 'Yes' : 'No' }}</dd></div>
     <div class="flex items-center justify-between px-4 py-3"><dt class="text-sm font-semibold text-slate-700">Phone Verified:</dt><dd class="text-sm text-slate-600 m-0">{{ user.phone_verified ? 'Yes' : 'No' }}</dd></div>
     <div class="flex items-center justify-between px-4 py-3"><dt class="text-sm font-semibold text-slate-700">Last Login:</dt><dd class="text-sm text-slate-600 m-0">{{ user.last_login|default("Never") }}</dd></div>
     <div class="flex items-center justify-between px-4 py-3"><dt class="text-sm font-semibold text-slate-700">Login IP:</dt><dd class="text-sm text-slate-600 m-0">{{ user.login_ip|default("N/A") }}</dd></div>
     <div class="flex items-center justify-between px-4 py-3"><dt class="text-sm font-semibold text-slate-700">Device:</dt><dd class="text-sm text-slate-600 m-0">{{ user.login_device|default("N/A") }}</dd></div>
    </dl>
   </div>
  </div>

  {# Roles Card #}
  <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md lg:col-span-6">
   <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-violet-50/50 to-fuchsia-50/50 px-5 py-4">
    <div class="flex h-7 w-7 items-center justify-center rounded-md bg-violet-100 text-violet-600">
     <i class="lucide lucide-shield" style="width:0.875em;height:0.875em;"></i>
    </div>
    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">Roles</h2>
   </div>
   <div class="p-5">
    {% if role_names|length > 0 %}
     <div class="flex flex-wrap gap-2">
      {% for role_name in role_names %}
       <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-semibold text-indigo-700">{{ role_name|replace({"_:":""}) |title }}</span>
      {% endfor %}
     </div>
    {% elseif user.role %}
     <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-semibold text-indigo-700">{{ user.role|replace({"_:":""}) |title }}</span>
    {% else %}
     <p class="text-sm text-slate-500 m-0">No roles assigned</p>
    {% endif %}
   </div>
  </div>

  {# Social Links Card #}
  <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md lg:col-span-6">
   <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-sky-50/50 to-cyan-50/50 px-5 py-4">
    <div class="flex h-7 w-7 items-center justify-center rounded-md bg-sky-100 text-sky-600">
     <i class="lucide lucide-share-2" style="width:0.875em;height:0.875em;"></i>
    </div>
    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">Social Links</h2>
   </div>
   <div class="p-5">
    {% set has_social = user.facebook_url or user.twitter_url or user.instagram_url or user.linkedin_url %}
    {% if has_social %}
     <div class="flex flex-wrap gap-3">
      {% if user.facebook_url %}<a href="{{ user.facebook_url }}" target="_blank" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"><i class="lucide lucide-facebook text-indigo-600" style="width:0.875em;height:0.875em;"></i> Facebook</a>{% endif %}
      {% if user.twitter_url %}<a href="{{ user.twitter_url }}" target="_blank" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"><i class="lucide lucide-share-2 text-sky-600" style="width:0.875em;height:0.875em;"></i> Twitter</a>{% endif %}
      {% if user.instagram_url %}<a href="{{ user.instagram_url }}" target="_blank" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"><i class="lucide lucide-instagram text-rose-600" style="width:0.875em;height:0.875em;"></i> Instagram</a>{% endif %}
      {% if user.linkedin_url %}<a href="{{ user.linkedin_url }}" target="_blank" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"><i class="lucide lucide-briefcase text-indigo-600" style="width:0.875em;height:0.875em;"></i> LinkedIn</a>{% endif %}
     </div>
    {% else %}
     <p class="text-sm text-slate-500 m-0">No social links configured</p>
    {% endif %}
   </div>
  </div>
 </div>
</div>
{% endblock %}
