{% extends"admin/layout.twig" %}
{% block title %}Change Admin Password{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-key"></i>
 Update Admin Password
 </div>
 <div>Change your account password</div>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="lg:col-span-6 offset-lg-3">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class="p-4">
 <form method="POST" action="/admin/profile/password">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <div class="mb-3">
 <label for="current_password" class="form-label">Current Password</label>
 <input type="password"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="current_password"
 name="current_password"
 required>
 </div>
 <div class="mb-3">
 <label for="new_password" class="form-label">New Password</label>
 <input type="password"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="new_password"
 name="new_password"
 required>
 </div>
 <div class="mb-3">
 <label for="confirm_password" class="form-label">Confirm New Password</label>
 <input type="password"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="confirm_password"
 name="confirm_password"
 required>
 </div>
 <div class="flex gap-2">
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
 <i class="lucide lucide-key mr-1"></i> Change Password
 </button>
 <a href="/admin/profile" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100"><i class="lucide lucide-x-circle mr-1"></i> Cancel</a>
 </div>
 </form>
 </div>
 </div>
 </div>
 </div>
 </div>
{% endblock %}




