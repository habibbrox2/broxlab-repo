{% extends "admin/layout.twig" %}

{% block title %}Pipeline Runs - {{ parent() }}{% endblock %}

{% block content %}
<style>
  .pipeline-shell {
    --pipeline-ink: #0f172a;
    --pipeline-muted: #64748b;
    --pipeline-line: #e2e8f0;
    --pipeline-soft: #f8fafc;
  }
  .pipeline-shell .hero {
    border: 1px solid var(--pipeline-line);
    border-radius: 1rem;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    padding: 1.25rem 1.35rem;
    margin-bottom: 1rem;
  }
  .pipeline-shell .hero h1 {
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--pipeline-ink);
    margin-bottom: 0.35rem;
  }
  .pipeline-shell .hero p {
    color: var(--pipeline-muted);
    margin: 0;
  }
  .pipeline-shell .stat-card {
    border: 1px solid var(--pipeline-line);
    border-radius: 0.9rem;
    background: #fff;
  }
  .pipeline-shell .stat-icon {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  .pipeline-shell .stat-icon.success {
    background: #dcfce7;
    color: #16a34a;
  }
  .pipeline-shell .stat-icon.warning {
    background: #fef3c7;
    color: #d97706;
  }
  .pipeline-shell .stat-icon.error {
    background: #fee2e2;
    color: #dc2626;
  }
  .pipeline-shell .stat-value {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--pipeline-ink);
    line-height: 1.1;
  }
  .pipeline-shell .stat-label {
    color: var(--pipeline-muted);
    font-size: 0.8rem;
  }
  .pipeline-shell .filter-card {
    border: 1px solid var(--pipeline-line);
    border-radius: 0.95rem;
  }
  .pipeline-shell .filter-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--pipeline-ink);
  }
  .pipeline-shell .run-card {
    border: 1px solid var(--pipeline-line);
    border-radius: 0.95rem;
    margin-bottom: 0.75rem;
    background: #fff;
  }
  .pipeline-shell .run-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .pipeline-shell .run-status.success {
    background: #dcfce7;
    color: #16a34a;
  }
  .pipeline-shell .run-status.partial {
    background: #fef3c7;
    color: #92400e;
  }
  .pipeline-shell .run-status.failed {
    background: #fee2e2;
    color: #dc2626;
  }
  .pipeline-shell .checkbox {
    width: 20px;
    height: 20px;
    cursor: pointer;
  }
  .pipeline-shell .bulk-actions {
    background: #f0f9ff;
    border: 1px solid #0ea5e9;
    border-radius: 0.95rem;
    padding: 1rem;
    margin-bottom: 1rem;
    display: none;
  }
  .pipeline-shell .bulk-actions.show {
    display: block;
  }
</style>

<div class="pipeline-shell">
  <div class="hero">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
      <div>
        <h1>Pipeline Runs</h1>
        <p>Monitor all scraper pipeline executions and their results.</p>
      </div>
      <a class="btn btn-outline-secondary btn-sm" href="/admin/scrap-control-center">Back to Control Center</a>
    </div>
  </div>

  <div class="card" style="border: 1px solid #e2e8f0; border-radius: 0.95rem; margin-bottom: 1rem;">
    <div class="card-body">
      <div style="font-weight: 700; color: #0f172a; margin-bottom: 0.75rem;">Quick Navigation</div>
      <div class="row g-2">
        <div class="col-md-3">
          <a href="/admin/scrap-control-center/all-pipeline-logs" class="btn btn-outline-info btn-sm w-100">
            <i class="bi bi-file-text"></i> All Logs
          </a>
        </div>
        <div class="col-md-3">
          <a href="/admin/scrap-control-center/pipeline-runs" class="btn btn-primary btn-sm w-100" style="pointer-events: none;">
            <i class="bi bi-play-circle"></i> Pipeline Runs
          </a>
        </div>
        <div class="col-md-3">
          <a href="/admin/scrap-control-center/failed-pipeline-logs" class="btn btn-outline-danger btn-sm w-100">
            <i class="bi bi-exclamation-circle"></i> Failed Logs
          </a>
        </div>
        <div class="col-md-3">
          <a href="/admin/scrap-control-center/incoming" class="btn btn-outline-success btn-sm w-100">
            <i class="bi bi-inbox"></i> Incoming Items
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-lg-2 col-6">
      <div class="card stat-card">
        <div class="card-body">
          <div class="d-flex align-items-center gap-2">
            <span class="stat-icon success"><i class="bi bi-check-circle"></i></span>
            <div>
              <div class="stat-value">0</div>
              <div class="stat-label">Successful</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-2 col-6">
      <div class="card stat-card">
        <div class="card-body">
          <div class="d-flex align-items-center gap-2">
            <span class="stat-icon warning"><i class="bi bi-exclamation-circle"></i></span>
            <div>
              <div class="stat-value">0</div>
              <div class="stat-label">Partial</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-2 col-6">
      <div class="card stat-card">
        <div class="card-body">
          <div class="d-flex align-items-center gap-2">
            <span class="stat-icon error"><i class="bi bi-x-circle"></i></span>
            <div>
              <div class="stat-value">0</div>
              <div class="stat-label">Failed</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-2 col-6">
      <div class="card stat-card">
        <div class="card-body">
          <div class="d-flex align-items-center gap-2">
            <span class="stat-icon"><i class="bi bi-hourglass-split"></i></span>
            <div>
              <div class="stat-value">0</div>
              <div class="stat-label">Total</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card filter-card mb-4">
    <div class="card-body">
      <div class="filter-title mb-3">Filters</div>
      <form method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label">Action</label>
          <select name="action" class="form-control">
            <option value="">All Actions</option>
            <option value="run-pipeline" {{ action_filter == 'run-pipeline' ? 'selected' }}>Run Pipeline</option>
            <option value="auto-run-pipeline" {{ action_filter == 'auto-run-pipeline' ? 'selected' }}>Auto Run Pipeline</option>
            <option value="cron-run-pipeline" {{ action_filter == 'cron-run-pipeline' ? 'selected' }}>Cron Run Pipeline</option>
            <option value="publish-pending" {{ action_filter == 'publish-pending' ? 'selected' }}>Publish Pending</option>
          </select>
        </div>
        <div class="col-md-3">
          <button class="btn btn-primary w-100" type="submit">Apply Filters</button>
        </div>
        <div class="col-md-3">
          <a class="btn btn-outline-secondary w-100" href="/admin/scrap-control-center/pipeline-runs">Reset</a>
        </div>
      </form>
    </div>
  </div>

  {% if runs|length > 0 %}
    <div class="bulk-actions" id="bulkActionsBar">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <label class="form-check-label">
          <input type="checkbox" id="selectAllCheckbox" class="checkbox form-check-input">
          <span><span id="selectedCount">0</span> runs selected</span>
        </label>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-sm btn-outline-danger" id="bulkDeleteBtn" disabled>
            <i class="bi bi-trash"></i> Delete Selected
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="cancelBulkBtn">
            Cancel
          </button>
        </div>
      </div>
    </div>

    {% for run in runs %}
      <div class="card run-card" data-run-id="{{ run.id }}">
        <div class="card-body">
          <div class="row align-items-start">
            <div class="col-md-1 d-flex align-items-center">
              <input type="checkbox" class="checkbox form-check-input run-checkbox" data-run-id="{{ run.id }}">
            </div>
            <div class="col-md-11">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <div class="fw-bold">
                    Run #{{ run.id }} - {{ run.action_name|default('Unknown') }}
                    <span class="run-status {{ run.status|default('failed') }}">
                      <i class="bi bi-{{ run.status == 'success' ? 'check-circle' : (run.status == 'partial' ? 'exclamation-circle' : 'x-circle') }}"></i>
                      {{ run.status|upper }}
                    </span>
                  </div>
                  <div class="text-muted small mt-1">
                    Started: {{ run.started_at|date('M d, Y H:i:s') }}
                    • Duration: {{ run.duration_ms|default(0) }}ms
                    • Trigger: {{ run.trigger_source|default('manual') }}
                  </div>
                </div>
                <a class="btn btn-sm btn-outline-primary" href="/admin/scrap-control-center/pipeline-runs/{{ run.id }}">
                  Details <i class="bi bi-arrow-right"></i>
                </a>
              </div>

              <div class="row g-3 mt-2" style="font-size: 0.85rem;">
                <div class="col-sm-2">
                  <div class="text-muted">Fetched</div>
                  <div class="fw-bold">{{ run.fetched_count|default(0) }}</div>
                </div>
                <div class="col-sm-2">
                  <div class="text-muted">Published</div>
                  <div class="fw-bold text-success">{{ run.published_count|default(0) }}</div>
                </div>
                <div class="col-sm-2">
                  <div class="text-muted">Failed</div>
                  <div class="fw-bold text-danger">{{ run.failed_count|default(0) }}</div>
                </div>
                <div class="col-sm-2">
                  <div class="text-muted">Skipped</div>
                  <div class="fw-bold">{{ run.skipped_duplicates|default(0) }}</div>
                </div>
                <div class="col-sm-2">
                  <div class="text-muted">AI Used</div>
                  <div class="fw-bold">{{ run.ai_used_count|default(0) }}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}

    {% if total_pages > 1 %}
      <nav aria-label="pagination" class="mt-4">
        <ul class="pagination justify-content-center">
          {% if current_page_number > 1 %}
            <li class="page-item">
              <a class="page-link" href="?page={{ current_page_number - 1 }}&action={{ action_filter }}">&laquo;</a>
            </li>
          {% endif %}
          {% for p in 1..total_pages %}
            {% if p == current_page_number or p == 1 or p == total_pages or (p >= current_page_number - 2 and p <= current_page_number + 2) %}
              <li class="page-item {{ p == current_page_number ? 'active' }}">
                <a class="page-link" href="?page={{ p }}&action={{ action_filter }}">{{ p }}</a>
              </li>
            {% endif %}
          {% endfor %}
          {% if current_page_number < total_pages %}
            <li class="page-item">
              <a class="page-link" href="?page={{ current_page_number + 1 }}&action={{ action_filter }}">&raquo;</a>
            </li>
          {% endif %}
        </ul>
      </nav>
    {% endif %}
  {% else %}
    <div class="card border-0 shadow-sm">
      <div class="card-body py-5 text-center">
        <div class="text-muted">No pipeline runs found.</div>
      </div>
    </div>
  {% endif %}
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const bulkActionsBar = document.getElementById("bulkActionsBar");
    const selectAllCheckbox = document.getElementById("selectAllCheckbox");
    const bulkDeleteBtn = document.getElementById("bulkDeleteBtn");
    const cancelBulkBtn = document.getElementById("cancelBulkBtn");
    const selectedCountSpan = document.getElementById("selectedCount");
    const runCheckboxes = document.querySelectorAll(".run-checkbox");
    const runCards = document.querySelectorAll(".run-card");
    
    function updateBulkActionsBar() {
        const selectedRuns = Array.from(runCheckboxes).filter(cb => cb.checked);
        const selectedCount = selectedRuns.length;
        
        if (selectedCount > 0) {
            bulkActionsBar.classList.add("show");
            selectedCountSpan.textContent = selectedCount;
            bulkDeleteBtn.disabled = false;
        } else {
            bulkActionsBar.classList.remove("show");
            selectedCountSpan.textContent = "0";
            bulkDeleteBtn.disabled = true;
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = false;
        }
        
        runCards.forEach(card => {
            const checkbox = card.querySelector(".run-checkbox");
            if (checkbox && checkbox.checked) {
                card.style.backgroundColor = "#f0f9ff";
            } else {
                card.style.backgroundColor = "#fff";
            }
        });
    }
    
    runCheckboxes.forEach(checkbox => {
        checkbox.addEventListener("change", function() {
            updateBulkActionsBar();
            updateSelectAllCheckbox();
        });
    });
    
    function updateSelectAllCheckbox() {
        const totalCheckboxes = runCheckboxes.length;
        const checkedCheckboxes = Array.from(runCheckboxes).filter(cb => cb.checked).length;
        
        if (checkedCheckboxes === 0) {
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = false;
        } else if (checkedCheckboxes === totalCheckboxes) {
            selectAllCheckbox.checked = true;
            selectAllCheckbox.indeterminate = false;
        } else {
            selectAllCheckbox.indeterminate = true;
        }
    }
    
    selectAllCheckbox.addEventListener("change", function() {
        runCheckboxes.forEach(checkbox => {
            checkbox.checked = this.checked;
        });
        updateBulkActionsBar();
    });
    
    bulkDeleteBtn.addEventListener("click", function() {
        const selectedRuns = Array.from(runCheckboxes)
            .filter(cb => cb.checked)
            .map(cb => cb.getAttribute("data-run-id"));
        
        if (selectedRuns.length === 0) return;
        
        const runText = selectedRuns.length === 1 ? "1 run" : selectedRuns.length + " runs";
        if (!confirm(`Delete ${runText}? This action cannot be undone.`)) {
            return;
        }
        
        bulkDeleteBtn.disabled = true;
        bulkDeleteBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Deleting...';
        
        let completed = 0;
        selectedRuns.forEach(runId => {
            fetch(`/admin/api/scrap-control-center/pipeline-runs/${runId}/delete`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                },
                body: JSON.stringify({
                    _csrf: document.querySelector("meta[name=\"csrf-token\"]")?.getAttribute("content") || ""
                })
            })
            .then(response => response.json())
            .then(data => {
                completed++;
                if (data.ok) {
                    const card = document.querySelector(`.run-card[data-run-id="${runId}"]`);
                    if (card) {
                        card.remove();
                    }
                }
                
                if (completed === selectedRuns.length) {
                    bulkDeleteBtn.disabled = false;
                    bulkDeleteBtn.innerHTML = '<i class="bi bi-trash"></i> Delete Selected';
                    updateBulkActionsBar();
                    showAlert(`${completed} run(s) deleted`, "success");
                }
            })
            .catch(error => {
                completed++;
                if (completed === selectedRuns.length) {
                    bulkDeleteBtn.disabled = false;
                    bulkDeleteBtn.innerHTML = '<i class="bi bi-trash"></i> Delete Selected';
                    showAlert("Failed to delete some runs", "danger");
                }
            });
        });
    });
    
    cancelBulkBtn.addEventListener("click", function() {
        runCheckboxes.forEach(checkbox => {
            checkbox.checked = false;
        });
        updateBulkActionsBar();
    });
    
    function showAlert(message, type) {
        const alertDiv = document.createElement("div");
        alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
        alertDiv.style.cssText = "top: 20px; right: 20px; z-index: 9999; min-width: 300px;";
        alertDiv.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.body.appendChild(alertDiv);
        setTimeout(() => {
            if (alertDiv.parentNode) {
                alertDiv.remove();
            }
        }, 5000);
    }
});
</script>
{% endblock %}
