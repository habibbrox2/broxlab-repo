{% extends"admin/layout.twig" %}

{% block title %}All Pipeline Logs - {{ parent() }}{% endblock %}

{% block content %}
<style>
 .pipeline-shell {
 --pipeline-ink: #0f172a;
 --pipeline-muted: #64748b;
 --pipeline-line: #e2e8f0;
 --pipeline-soft: #f8fafc;
 }
 .pipeline-shell .hero {
 border: 1px solid var(--pipeline-line);
 border-radius: 1rem;
 background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
 padding: 1.25rem 1.35rem;
 margin-bottom: 1rem;
 }
 .pipeline-shell .hero h1 {
 font-size: 1.55rem;
 font-weight: 700;
 color: var(--pipeline-ink);
 margin-bottom: 0.35rem;
 }
 .pipeline-shell .hero p {
 color: var(--pipeline-muted);
 margin: 0;
 }
 .pipeline-shell .card-panel {
 border: 1px solid var(--pipeline-line);
 border-radius: 0.9rem;
 background: #fff;
 }
 .pipeline-shell .stat-icon {
 width: 2.6rem;
 height: 2.6rem;
 border-radius: 0.7rem;
 display: inline-flex;
 align-items: center;
 justify-content: center;
 flex: 0 0 auto;
 }
 .pipeline-shell .stat-icon.success {
 background: #dcfce7;
 color: #16a34a;
 }
 .pipeline-shell .stat-icon.warning {
 background: #fef3c7;
 color: #d97706;
 }
 .pipeline-shell .stat-icon.error {
 background: #fee2e2;
 color: #dc2626;
 }
 .pipeline-shell .stat-value {
 font-size: 1.25rem;
 font-weight: 700;
 color: var(--pipeline-ink);
 line-height: 1.1;
 }
 .pipeline-shell .stat-label {
 color: var(--pipeline-muted);
 font-size: 0.8rem;
 }
 .pipeline-shell .filter-panel {
 border: 1px solid var(--pipeline-line);
 border-radius: 0.95rem;
 }
 .pipeline-shell .filter-title {
 font-size: 1rem;
 font-weight: 700;
 color: var(--pipeline-ink);
 }
 .pipeline-shell .log-card {
 border: 1px solid var(--pipeline-line);
 border-radius: 0.95rem;
 margin-bottom: 0.75rem;
 background: #fff;
 }
 .pipeline-shell .log-status {
 display: inline-flex;
 align-items: center;
 gap: 0.5rem;
 padding: 0.3rem 0.7rem;
 border-radius: 999px;
 font-size: 0.8rem;
 font-weight: 700;
 }
 .pipeline-shell .log-status.success {
 background: #dcfce7;
 color: #16a34a;
 }
 .pipeline-shell .log-status.partial {
 background: #fef3c7;
 color: #92400e;
 }
 .pipeline-shell .log-status.failed {
 background: #fee2e2;
 color: #dc2626;
 }
 .pipeline-shell .checkbox {
 width: 20px;
 height: 20px;
 cursor: pointer;
 }
 .pipeline-shell .bulk-actions {
 background: #f0f9ff;
 border: 1px solid #0ea5e9;
 border-radius: 0.95rem;
 padding: 1rem;
 margin-bottom: 1rem;
 display: none;
 }
 .pipeline-shell .bulk-actions.show {
 display: block;
 }
</style>

<div class="pipeline-shell">
 <div class="hero">
 <div class="flex flex-wrap justify-between items-start gap-3">
 <div>
 <h1>All Pipeline Logs</h1>
 <p>Complete execution history of all scraper pipeline runs.</p>
 </div>
 <a class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100" href="/admin/scrap-control-center">Back to Control Center</a>
 </div>
 </div>

 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3 mb-4">
 <div class="lg:col-span-2 col-span-6">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm ">
 <div class="p-4">
 <div class="flex items-center gap-2">
 <span class="stat-icon success"><i class="lucide lucide-check-circle"></i></span>
 <div>
 <div class="stat-value">{{ stats.success|default(0) }}</div>
 <div class="stat-label">Successful</div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <div class="lg:col-span-2 col-span-6">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm card-panel">
 <div class="p-4">
 <div class="flex items-center gap-2">
 <span class="stat-icon warning"><i class="lucide lucide-alert-circle"></i></span>
 <div>
 <div class="stat-value">{{ stats.partial|default(0) }}</div>
 <div class="stat-label">Partial</div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <div class="lg:col-span-2 col-span-6">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm card-panel">
 <div class="p-4">
 <div class="flex items-center gap-2">
 <span class="stat-icon error"><i class="lucide lucide-x-circle"></i></span>
 <div>
 <div class="stat-value">{{ stats.failed|default(0) }}</div>
 <div class="stat-label">Failed</div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <div class="lg:col-span-2 col-span-6">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm card-panel">
 <div class="p-4">
 <div class="flex items-center gap-2">
 <span class="stat-icon"><i class="lucide lucide-hourglass"></i></span>
 <div>
 <div class="stat-value">{{ total|default(0) }}</div>
 <div class="stat-label">Total</div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>

 <div class="rounded-xl border border-slate-200 bg-white shadow-sm card-panel mb-4">
 <div class="p-4">
 <div style="font-weight: 700; color: #0f172a; margin-bottom: 0.75rem;">Quick Navigation</div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-2">
 <div class="md:col-span-3">
 <a href="/admin/scrap-control-center/all-pipeline-logs" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-sky-500 text-white hover:bg-sky-600 px-3 py-1.5 text-xs w-full" style="pointer-events: none;">
 <i class="lucide lucide-file-text"></i> All Logs
 </a>
 </div>
 <div class="md:col-span-3">
 <a href="/admin/scrap-control-center/pipeline-runs" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-indigo-600 hover:bg-indigo-100 px-3 py-1.5 text-xs w-full">
 <i class="lucide lucide-play-circle"></i> Pipeline Runs
 </a>
 </div>
 <div class="md:col-span-3">
 <a href="/admin/scrap-control-center/failed-pipeline-logs" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-red-600 hover:bg-red-100 px-3 py-1.5 text-xs w-full">
 <i class="lucide lucide-alert-circle"></i> Failed Logs
 </a>
 </div>
 <div class="md:col-span-3">
 <a href="/admin/scrap-control-center/incoming" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition transition-ghost-success px-3 py-1.5 text-xs w-full">
 <i class="lucide lucide-inbox"></i> Incoming Items
 </a>
 </div>
 </div>
 </div>
 </div>

 <div class="rounded-xl border border-slate-200 bg-white shadow-sm filter-panel mb-4">
 <div class="p-4">
 <div class="filter-title mb-3">Filters</div>
 <form method="get" class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3 items-end">
 <div class="md:col-span-3">
 <label class="form-label">Action</label>
 <select name="action" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
 <option value="">All Actions</option>
 <option value="run-pipeline" {{ action_filter == 'run-pipeline' ? 'selected' }}>Run Pipeline</option>
 <option value="auto-run-pipeline" {{ action_filter == 'auto-run-pipeline' ? 'selected' }}>Auto Run Pipeline</option>
 <option value="cron-run-pipeline" {{ action_filter == 'cron-run-pipeline' ? 'selected' }}>Cron Run Pipeline</option>
 <option value="publish-pending" {{ action_filter == 'publish-pending' ? 'selected' }}>Publish Pending</option>
 </select>
 </div>
 <div class="md:col-span-3">
 <label class="form-label">Status</label>
 <select name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
 <option value="">All Statuses</option>
 <option value="success" {{ status_filter == 'success' ? 'selected' }}>Success</option>
 <option value="partial" {{ status_filter == 'partial' ? 'selected' }}>Partial</option>
 <option value="failed" {{ status_filter == 'failed' ? 'selected' }}>Failed</option>
 </select>
 </div>
 <div class="md:col-span-2">
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 w-full" type="submit">Apply Filters</button>
 </div>
 <div class="md:col-span-2">
 <a class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100 w-full" href="/admin/scrap-control-center/all-pipeline-logs">Reset</a>
 </div>
 </form>
 </div>
 </div>

 {% if logs|length > 0 %}
 <div class="bulk-actions" id="bulkActionsBar">
 <div class="flex flex-wrap justify-between items-center gap-3">
 <label class="text-sm text-slate-700">
 <input type="checkbox" id="selectAllCheckbox" class="checkbox mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
 <span><span id="selectedCount">0</span> logs selected</span>
 </label>
 <div class="flex gap-2">
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-red-600 hover:bg-red-100" id="bulkDeleteBtn" disabled>
 <i class="lucide lucide-trash-2"></i> Delete Selected
 </button>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-100" id="cancelBulkBtn">
 Cancel
 </button>
 </div>
 </div>
 </div>

 {% for log in logs %}
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm log-card" data-log-id="{{ log.id }}">
 <div class="p-4">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 items-start">
 <div class="md:col-span-1 flex items-center">
 <input type="checkbox" class="checkbox mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 log-checkbox" data-log-id="{{ log.id }}">
 </div>
 <div class="md:col-span-10">
 <div class="flex justify-between items-start mb-2">
 <div>
 <div class="font-bold">
 Run #{{ log.id }} - {{ log.action_name|default('Unknown') }}
 <span class="log-status {{ log.status|default('failed') }}">
 <i class="lucide lucide-{{ log.status == 'success' ? 'check-circle' : (log.status 'partial' 'alert-circle' 'x-circle') }}"></i>
 {{ log.status|upper }}
 </span>
 </div>
 <div class="text-slate-500 small mt-1">
 Started: {{ log.started_at|date('M d, Y H:i:s') }}
 {% if log.finished_at %}
 â€¢ Finished: {{ log.finished_at|date('M d, Y H:i:s') }}
 {% endif %}
 â€¢ Duration: {{ log.duration_ms|default(0) }}ms
 â€¢ Trigger: {{ log.trigger_source|default('manual') }}
 </div>
 </div>
 <a class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-indigo-600 hover:bg-indigo-100" href="/admin/scrap-control-center/pipeline-runs/{{ log.id }}">
 Details <i class="lucide lucide-arrow-right"></i>
 </a>
 </div>

 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3 mt-2" style="font-size: 0.85rem;">
 <div class="sm:col-span-2">
 <div class="text-slate-500">Fetched</div>
 <div class="font-bold">{{ log.fetched_count|default(0) }}</div>
 </div>
 <div class="sm:col-span-2">
 <div class="text-slate-500">Published</div>
 <div class="font-bold text-emerald-600">{{ log.published_count|default(0) }}</div>
 </div>
 <div class="sm:col-span-2">
 <div class="text-slate-500">Failed</div>
 <div class="font-bold text-red-600">{{ log.failed_count|default(0) }}</div>
 </div>
 <div class="sm:col-span-2">
 <div class="text-slate-500">Skipped</div>
 <div class="font-bold">{{ log.skipped_duplicates|default(0) }}</div>
 </div>
 <div class="sm:col-span-2">
 <div class="text-slate-500">AI Used</div>
 <div class="font-bold">{{ log.ai_used_count|default(0) }}</div>
 </div>
 <div class="sm:col-span-2">
 <div class="text-slate-500">Provider</div>
 <div class="font-bold">{{ log.provider_name|default('N/A') }}</div>
 </div>
 </div>

 {% if log.error_message %}
 <div class="mt-3 p-2 bg-red-600 bg-opacity-10 border border-danger border-opacity-25 rounded small text-red-600">
 <strong>Error:</strong> {{ log.error_message }}
 </div>
 {% endif %}
 </div>
 <div class="md:col-span-1 flex justify-end">
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-red-600 hover:bg-red-100 delete-log-inline-flex" data-log-id="{{ log.id }}" title="Delete this log">
 <i class="lucide lucide-trash-2"></i>
 </button>
 </div>
 </div>
 </div>
 </div>
 {% endfor %}

 {% if total_pages > 1 %}
 <nav aria-label="pagination" class="mt-4">
 <ul class="pagination justify-center">
 {% if current_page_number > 1 %}
 <li class="page-item">
 <a class="page-link" href="?page={{ current_page_number - 1 }}&action={{ action_filter }}&status={{ status_filter }}">&laquo;</a>
 </li>
 {% endif %}
 {% for p in 1..total_pages %}
 {% if p == current_page_number or p == 1 or p == total_pages or (p >= current_page_number - 2 and p <= current_page_number + 2) %}
 <li class="page-item {{ p == current_page_number ? 'active' }}">
 <a class="page-link" href="?page={{ p }}&action={{ action_filter }}&status={{ status_filter }}">{{ p }}</a>
 </li>
 {% endif %}
 {% endfor %}
 {% if current_page_number < total_pages %}
 <li class="page-item">
 <a class="page-link" href="?page={{ current_page_number + 1 }}&action={{ action_filter }}&status={{ status_filter }}">&raquo;</a>
 </li>
 {% endif %}
 </ul>
 </nav>
 {% endif %}
 {% else %}
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0">
 <div class="p-4 py-5 text-center">
 <div class="text-slate-500">No pipeline logs found.</div>
 </div>
 </div>
 {% endif %}
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
 const bulkActionsBar = document.getElementById("bulkActionsBar");
 const selectAllCheckbox = document.getElementById("selectAllCheckbox");
 const bulkDeleteBtn = document.getElementById("bulkDeleteBtn");
 const cancelBulkBtn = document.getElementById("cancelBulkBtn");
 const selectedCountSpan = document.getElementById("selectedCount");
 const logCheckboxes = document.querySelectorAll(".log-checkbox");
 const logCards = document.querySelectorAll(".log-card");
 const deleteLogBtns = document.querySelectorAll(".delete-log-btn");

 function updateBulkActionsBar() {
 const selectedLogs = Array.from(logCheckboxes).filter(cb => cb.checked);
 const selectedCount = selectedLogs.length;

 if (selectedCount > 0) {
 bulkActionsBar.classList.add("show");
 selectedCountSpan.textContent = selectedCount;
 bulkDeleteBtn.disabled = false;
 } else {
 bulkActionsBar.classList.remove("show");
 selectedCountSpan.textContent ="0";
 bulkDeleteBtn.disabled = true;
 selectAllCheckbox.checked = false;
 selectAllCheckbox.indeterminate = false;
 } logCards.forEach(card => {
  const checkbox = card.querySelector(".log-checkbox");
  if (checkbox && checkbox.checked) {
   card.style.backgroundColor ="#f0f9ff";
  } else {
   card.style.backgroundColor ="#fff";
  }
 });
 }

 logCheckboxes.forEach(checkbox => {
 checkbox.addEventListener("change", function() {
 updateBulkActionsBar();
 updateSelectAllCheckbox();
 });
 });

 function updateSelectAllCheckbox() {
 const totalCheckboxes = logCheckboxes.length;
 const checkedCheckboxes = Array.from(logCheckboxes).filter(cb => cb.checked).length;

 if (checkedCheckboxes === 0) {
 selectAllCheckbox.checked = false;
 selectAllCheckbox.indeterminate = false;
 } else if (checkedCheckboxes === totalCheckboxes) {
 selectAllCheckbox.checked = true;
 selectAllCheckbox.indeterminate = false;
 } else {
 selectAllCheckbox.indeterminate = true;
 }
 }

 selectAllCheckbox.addEventListener("change", function() {
 logCheckboxes.forEach(checkbox => {
 checkbox.checked = this.checked;
 });
 updateBulkActionsBar();
 });

 bulkDeleteBtn.addEventListener("click", function() {
 const selectedLogs = Array.from(logCheckboxes)
 .filter(cb => cb.checked)
 .map(cb => cb.getAttribute("data-log-id"));

 if (selectedLogs.length === 0) return;

 const logText = selectedLogs.length === 1 ?"1 log" : selectedLogs.length +" logs";
 if (!confirm(`Delete ${logText}? This action cannot be undone.`)) {
 return;
 }

 bulkDeleteBtn.disabled = true;
 bulkDeleteBtn.innerHTML = '<i class="lucide lucide-hourglass"></i> Deleting...';

 let completed = 0;
 selectedLogs.forEach(logId => {
 fetch(`/admin/api/scrap-control-center/pipeline-runs/${logId}/delete`, {
 method:"POST",
 headers: {"Content-Type":"application/json","X-Requested-With":"XMLHttpRequest"
 }
 })
 .then(response => {
 if (response.ok) {
 const card = document.querySelector(`.log-card[data-log-id="${logId}"]`);
   if (card) {
    card.style.opacity ="0";
    card.style.transition ="opacity 0.3s ease";
    setTimeout(() => card.remove(), 300);
 }
 }
 completed++;
 if (completed === selectedLogs.length) {
 bulkDeleteBtn.disabled = false;
 bulkDeleteBtn.innerHTML = '<i class="lucide lucide-trash-2"></i> Delete Selected';
 updateBulkActionsBar();
 location.reload();
 }
 })
 .catch(error => {
 console.error("Error deleting log:", error);
 completed++;
 if (completed === selectedLogs.length) {
 bulkDeleteBtn.disabled = false;
 bulkDeleteBtn.innerHTML = '<i class="lucide lucide-trash-2"></i> Delete Selected';
 }
 });
 });
 });

 cancelBulkBtn.addEventListener("click", function() {
 logCheckboxes.forEach(checkbox => {
 checkbox.checked = false;
 });
 updateBulkActionsBar();
 }); deleteLogBtns.forEach(btn => {
  btn.addEventListener("click", function() {
   const logId = this.getAttribute("data-log-id");
   const card = document.querySelector(`.log-card[data-log-id="${logId}"]`);

 if (!confirm("Delete this pipeline log? This action cannot be undone.")) {
 return;
 }

 const originalText = this.innerHTML;
 this.disabled = true;
 this.innerHTML = '<i class="lucide lucide-hourglass"></i>';

 fetch(`/admin/api/scrap-control-center/pipeline-runs/${logId}/delete`, {
 method:"POST",
 headers: {"Content-Type":"application/json","X-Requested-With":"XMLHttpRequest"
 }
 })
 .then(response => {
 if (response.ok) {
 rounded-xl border border-slate-200 bg-white shadow-sm.style.opacity ="0";
 rounded-xl border border-slate-200 bg-white shadow-sm.style.transition ="opacity 0.3s ease";
 setTimeout(() => rounded-xl border border-slate-200 bg-white shadow-sm.remove(), 300);
 setTimeout(() => location.reload(), 500);
 } else {
 this.disabled = false;
 this.innerHTML = originalText;
 alert("Failed to delete log");
 }
 })
 .catch(error => {
 console.error("Error deleting log:", error);
 this.disabled = false;
 this.innerHTML = originalText;
 alert("Error deleting log:" + error.message);
 });
 });
 });
});
</script>
{% endblock %}






