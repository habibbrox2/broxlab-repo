 // --- Streaming support ---
 async function streamGeneration(options) {
 generateBtn.disabled = true;
 generateBtn.innerHTML = '<span class="inline-spinner inline-spinner-sm mr-1"></span>Streaming...';
 statusEl.classList.remove('hidden');
 statusText.textContent = 'Streaming AI response...';

 var fullHtml = '';
 var title= '';
 var meta = {};
 var charCount = 0;

 try {
 showOverlay();
 showProgress(10, 'Starting stream...', 'Live Stream');

 var messages = [
 {
 role: 'system',
 content: 'You are a professional article writer. Generate a well-structured, SEO-optimized article. Include metadata for slug, SEO title, SEO description, tags, categories, and reader indexing when available. Return only the article and metadata. Do not include any intro sentence, apology, or commentary. First provide a compelling title on a line starting with"TITLE:", then the full article body with proper headings and paragraphs. Use markdown formatting.'
 },
 {
 role: 'user',
 content: buildUserPrompt(options)
 }
 ];

 var resp = await fetch('/api/admin/ai/chat', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
 body: JSON.stringify({
 messages: messages,
 stream: true,
 tools: []
 })
 });

 if (!resp.ok) {
 var errData = {};
 try {
 errData = await resp.json();
 } catch (_) {}
 throw new Error(errData.error || 'HTTP ' + resp.status);
 }

 // Read the stream
 var reader = resp.body.getReader();
 var decoder = new TextDecoder();
 var buffer = '';

 showProgress(25, 'Receiving content...', 'Live Stream');

 while (true) {
 var result = await reader.read();
 if (result.done) break;

 buffer += decoder.decode(result.value, { stream: true });
 var lines = buffer.split('\n');
 buffer = lines.pop() || '';

 for (var si = 0; si < lines.length; si++) {
 var line = lines[si].trim();
 if (!line || line === 'data: [DONE]') continue;
 if (line.startsWith('data: ')) {
 try {
 var parsed = JSON.parse(line.slice(6));
 var content = parsed.content || parsed.choices?.[0]?.delta?.content || '';
 if (content) {
 fullHtml += content;
 charCount = fullHtml.length;
 showProgress(Math.min(85, 25 + (charCount / 100)), charCount + ' chars received', 'Live Stream');
 
 // Live-update overlay text with partial content
 overlayText.innerHTML = '<small class="text-slate-500 block text-left" style="max-height:80px;overflow-y:auto;font-size:0.82rem;">'
 + escapeHtml(fullHtml.slice(-300))
 + '</small>';
 if (charsDisplay) charsDisplay.textContent = charCount + ' characters received';
 }
 } catch (_) { /* skip malformed SSE line */ }
 }
 }
 }

 // Process remaining buffer
 if (buffer.trim() && buffer.startsWith('data: ')) {
 try {
 var parsed = JSON.parse(buffer.slice(6));
 var content = parsed.content || parsed.choices?.[0]?.delta?.content || '';
 if (content) fullHtml += content;
 } catch (_) {}
 }

 showProgress(80, 'Processing ' + fullHtml.length + ' chars...', 'Live Stream');

 // Parse the full streamed text
 var rawText = fullHtml;
 var parsed = parseArticleResponse(rawText);
 title = parsed.title;
 lastHtml = parsed.content ? convertToHtml(parsed.title, parsed.content) : rawText;
 lastMeta = parsed.metadata || {};
 lastTitle = title;

 if (!lastHtml) {
 lastHtml = rawText;
 }

 // Apply results directly to form
 showProgress(90, 'Applying to form...', 'Finalizing');
 try {
 await applyToForm();
 // Show a brief flash indicator on the AI writer rounded-xl border border-slate-200 bg-white shadow-sm
 var statusFlash = document.getElementById('aiStatus');
 if (statusFlash) {
 statusFlash.classList.remove('hidden', 'flex');
 statusFlash.className = 'flex items-center gap-2 mt-3';
 statusFlash.innerHTML = '<span class="text-emerald-600"><i class="lucide lucide-check-circle mr-1"></i></span><small class="text-emerald-600 font-semibold">\u2713 Applied \u2014 fields updated with AI content</small>';
 setTimeout(function() {
 statusFlash.classList.add('hidden');
 }, 5000);
 }
 } catch (applyErr) {
 console.error('Auto-apply after stream failed:', applyErr);
 }

 } catch (err) {
 showCompletion(false, err.message || 'Stream error');
 resetBtn();
 return;
 }

 resetBtn();
showCompletion(true, 'Article streamed successfully! The form has been updated.');

 function resetBtn() {
 generateBtn.disabled = false;
 generateBtn.innerHTML = '<i class="lucide lucide-zap mr-1"></i>Generate with AI';
 }
 }

 // --- Prompt building ---
 function buildUserPrompt(options) {
 var prompt = 'Write an article';
 if (options.tone && options.tone !== 'informative') {
 prompt += ' in a ' + options.tone + ' tone';
 }
 if (options.length && options.length !== 'medium') {
 prompt += '. Make it ' + options.length + ' in length';
 }
 prompt += ' on the following topic: ' + options.topic + '.';
 if (options.keywords) {
 prompt += ' Include and emphasize these keywords: ' + options.keywords + '.';
 }
 prompt += '\n\nReturn only the article content and metadata. Do not add any intro sentence such as"I\'ll write this article for you" or any commentary.\nUse a clear title, well-structured sections, and include metadata in one of these formats: a JSON block or labeled lines. Use these labels if possible:\nTITLE:, SLUG:, META_TITLE:, META_DESCRIPTION:, TAGS:, CATEGORIES:, READER_INDEXING:.\n\nSet READER_INDEXING to one of: default, noindex, or nofollow.\nThe article body must be separate from metadata and use markdown headings and paragraphs.';
 return prompt;
 }

 function cleanRawArticleResponse(text) {
 if (!text) return '';
 text = String(text).replace(/\r\n/g, '\n');
 text = text.replace(/<tool_call[\s\S]*?<\/tool_call>/gi, '');
 text = text.replace(/<parameter[\s\S]*?<\/parameter>/gi, '');
 text = text.replace(/^.*tool_call.*$/gmi, '');
 text = text.replace(/^.*<parameter.*$/gmi, '');
 text = text.replace(/^.*<\/parameter>.*$/gmi, '');
 text = text.replace(/(?:\n\s*){3,}/g, '\n\n');
 return text.trim();
 }

 function parseJsonMetadata(text) {
 if (!text) return null;
 var fencedMatch = text.match(/```(?:json)?\s*([\s\S]*?)```/i);
 var candidate = fencedMatch ? fencedMatch[1] : (text.match(/\{[\s\S]*\}/) || [null])[0];
 if (!candidate) return null;
 try {
 return JSON.parse(candidate);
 } catch (e) {
 return null;
 }
 }

 function stripJsonMetadataBlock(text) {
 if (!text) return text;
 var fencedMatch = text.match(/```(?:json)?\s*[\s\S]*?```/i);
 if (fencedMatch) {
 return text.replace(fencedMatch[0], '');
 }
 var rawObjectMatch = text.match(/\{[\s\S]*\}/);
 if (rawObjectMatch) {
 return text.replace(rawObjectMatch[0], '');
 }
 return text;
 }

 function parseCommaSeparated(value) {
 return String(value || '')
 .split(/[;,]/)
 .map(function(item) {
 return item.trim();
 })
 .filter(Boolean);
 }

 function sanitizeGeneratedTitle(value) {
 var title = String(value || '')
 .replace(/^[\s"'â€œâ€'`]+|[\s"'â€œâ€'`]+$/g, '')
 .trim();
 if (!title) return '';
 if (isBoilerplateLine(title)) return '';
 if (/^(?:#{1,6}\s*)?metadata[:\s]*$/i.test(title)) return '';
 return title;
 }

 function normalizeReaderIndexing(value) {
 var normalized = String(value || '').trim().toLowerCase();
 if (normalized === 'default' || normalized === 'index' || normalized === 'follow' || normalized === '') {
 return '';
 }
 if (normalized === 'noindex' || normalized === 'nofollow') {
 return normalized;
 }
 return '';
 }

 function isBoilerplateLine(line) {
 var normalized = String(line || '').trim().toLowerCase();
 if (!normalized) return true;
 return (
 normalized.startsWith("i'll write this article for you") ||
 normalized.startsWith('i will write this article for you') ||
 normalized.startsWith("here's the content with metadata") ||
 normalized.startsWith('here is the content with metadata') ||
 normalized.startsWith("here's an article") ||
 normalized.startsWith('here is an article') ||
 normalized.startsWith('below is the article') ||
 normalized.startsWith('sure,') ||
 normalized.startsWith('of course,') ||
 normalized.startsWith('absolutely,') ||
 normalized.startsWith('certainly,')
 );
 }

 function cleanArticleBodyText(text) {
 var source = cleanRawArticleResponse(String(text || ''));
 if (!source) return '';

 var lines = source.split('\n');
 var bodyLines = [];
 var skipBlock = false;
 var inMetadataSection = false;

 for (var i = 0; i < lines.length; i++) {
 var line = lines[i].trim();
 if (!line) {
 if (bodyLines.length) bodyLines.push('');
 continue;
 }
 if (/^```/.test(line)) {
 skipBlock = !skipBlock;
 continue;
 }
 if (skipBlock) continue;
 if (/^<tool_call\b/i.test(line) || /^<\/tool_call>/i.test(line) || /^<parameter\b/i.test(line) || /^<\/parameter>/i.test(line)) {
 continue;
 }
 if (isBoilerplateLine(line)) {
 continue;
 }

 var metaCheck = applyMetadataLine(line, {
 title: '',
 slug: '',
 meta_title: '',
 meta_description: '',
 tags: [],
 categories: [],
 reader_indexing: ''
 });
 if (metaCheck.matched) {
 if (metaCheck.metadataMode) {
 inMetadataSection = true;
 }
 continue;
 }
 if (inMetadataSection) {
 continue;
 }
 if (/^TITLE:\s*/i.test(line)) {
 continue;
 }

 bodyLines.push(line);
 }

 return bodyLines.join('\n').trim();
 }

 function applyMetadataLine(line, metadata) {
 var raw = String(line || '').trim();
 if (!raw) return { matched: false, metadataMode: false };

 var labelMatch = raw.match(/^\s*(?:[-*]|\u2022)\s*(?:#{1,6}\s*)?(?:\*\*)?([A-Za-z][A-Za-z0-9 _-]*?)(?:\*\*)?\s*:\s*(.*)$/);
 if (!labelMatch) {
 if (/^(?:#{1,6}\s*)?metadata[:\s]*$/i.test(raw)) {
 return { matched: true, metadataMode: true };
 }
 return { matched: false, metadataMode: false };
 }

 var key = labelMatch[1].trim().toLowerCase().replace(/[\s_-]+/g, ' ');
 var value = String(labelMatch[2] || '').trim();

 if (key === 'metadata') {
 return { matched: true, metadataMode: true };
 }
 if (key === 'title' || key === 'headline') {
 metadata.title = sanitizeGeneratedTitle(value);
 return { matched: true, metadataMode: false };
 }
 if (key === 'slug' || key === 'url slug') {
 metadata.slug = slugifyText(value);
 return { matched: true, metadataMode: false };
 }
 if (key === 'meta title' || key === 'seo title') {
 metadata.meta_title = value;
 return { matched: true, metadataMode: false };
 }
 if (key === 'meta description' || key === 'seo description' || key === 'description') {
 metadata.meta_description = value;
 return { matched: true, metadataMode: false };
 }
 if (key === 'tags') {
 metadata.tags = parseCommaSeparated(value);
 return { matched: true, metadataMode: false };
 }
 if (key === 'categories' || key === 'category') {
 metadata.categories = parseCommaSeparated(value);
 return { matched: true, metadataMode: false };
 }
 if (key === 'reader indexing' || key === 'seo indexing' || key === 'indexing') {
 metadata.reader_indexing = normalizeReaderIndexing(value);
 return { matched: true, metadataMode: false };
 }

 return { matched: false, metadataMode: false };
 }


 function parseArticleResponse(text) {
 var rawText = String(text || '');
 var metadata = {
 title: '',
 slug: '',
 meta_title: '',
 meta_description: '',
 tags: [],
 categories: [],
 reader_indexing: ''
 };
 var title = '';
 var content = '';

 var jsonSource = parseJsonMetadata(rawText);
 if (jsonSource && typeof jsonSource === 'object') {
 metadata.title = sanitizeGeneratedTitle(jsonSource.title || jsonSource.headline || '');
 metadata.slug = String(jsonSource.slug || '').trim() || slugifyText(metadata.title);
 metadata.meta_title = String(jsonSource.meta_title || jsonSource.seo_title || '').trim();
 metadata.meta_description = String(jsonSource.meta_description || jsonSource.description || '').trim();
 metadata.tags = Array.isArray(jsonSource.tags) ? jsonSource.tags.map(String).map(function(t){return t.trim();}).filter(Boolean) : parseCommaSeparated(jsonSource.tags || '');
 metadata.categories = Array.isArray(jsonSource.categories) ? jsonSource.categories.map(String).map(function(c){return c.trim();}).filter(Boolean) : parseCommaSeparated(jsonSource.categories || '');
 metadata.reader_indexing = normalizeReaderIndexing(jsonSource.reader_indexing || jsonSource.seo_indexing || jsonSource.indexing || '');
 content = cleanArticleBodyText(jsonSource.content || jsonSource.body || jsonSource.article || '');
 title = metadata.title || title;
 }

 rawText = stripJsonMetadataBlock(content || rawText);
 rawText = cleanRawArticleResponse(rawText);
 if (typeof console !== 'undefined' && typeof console.debug === 'function') {
 console.debug('AI parser cleaned response snippet:', rawText.slice(0, 400));
 }
 var lines = rawText.split('\n');
 var contentLines = [];
 var skipBlock = false;
 var foundTitleLine = false;
 var inMetadataSection = false;

 for (var i = 0; i < lines.length; i++) {
 var line = lines[i].trim();
 if (!line) {
 if (foundTitleLine || contentLines.length) contentLines.push('');
 continue;
 }
 if (/^```/.test(line)) {
 skipBlock = !skipBlock;
 continue;
 }
 if (skipBlock) continue;
 if (/^<tool_call\b/i.test(line) || /^<\/tool_call>/i.test(line) || /^<parameter\b/i.test(line) || /^<\/parameter>/i.test(line)) {
 continue;
 }

 if (isBoilerplateLine(line)) {
 continue;
 }

 var metaResult = applyMetadataLine(line, metadata);
 if (metaResult.matched) {
 if (metaResult.metadataMode) {
 inMetadataSection = true;
 }
 continue;
 }
 if (inMetadataSection) {
 continue;
 }

 var upper = line.toUpperCase();
 if (upper.startsWith('TITLE:')) {
 metadata.title = line.substring(6).trim();
 title = metadata.title;
 foundTitleLine = true;
 continue;
 }
 if (upper.startsWith('SLUG:')) {
 metadata.slug = slugifyText(line.substring(5).trim());
 continue;
 }
 if (upper.startsWith('META_TITLE:')) {
 metadata.meta_title = line.substring(11).trim();
 continue;
 }
 if (upper.startsWith('META_DESCRIPTION:')) {
 metadata.meta_description = line.substring(17).trim();
 continue;
 }
 if (upper.startsWith('TAGS:')) {
 metadata.tags = parseCommaSeparated(line.substring(5));
 continue;
 }
 if (upper.startsWith('CATEGORIES:')) {
 metadata.categories = parseCommaSeparated(line.substring(11));
 continue;
 }
 if (upper.startsWith('READER_INDEXING:') || upper.startsWith('SEO_INDEXING:') || upper.startsWith('INDEXING:')) {
 metadata.reader_indexing = normalizeReaderIndexing(line.substring(line.indexOf(':') + 1).trim());
 continue;
 }

 if (!title && /^#{1,6}\s+/.test(line)) {
 title = line.replace(/^#{1,6}\s+/, '').trim();
 if (!metadata.title) {
 metadata.title = title;
 }
 foundTitleLine = true;
 continue;
 }

 contentLines.push(line);
 }

 if (!title && contentLines.length > 0) {
 title = contentLines[0].replace(/^#+\s*/, '').trim();
 if (!metadata.title) {
 metadata.title = title;
 }
 if (contentLines.length > 1) {
 contentLines = contentLines.slice(1);
 }
 }
 if (!content) {
 content = contentLines.join('\n').trim();
 }
 if (!metadata.slug && metadata.title) {
 metadata.slug = slugifyText(metadata.title);
 }
 if (!metadata.title && metadata.meta_title) {
 metadata.title = metadata.meta_title;
 }
 if (!title && metadata.title) {
 title = metadata.title;
 }
 metadata.reader_indexing = normalizeReaderIndexing(metadata.reader_indexing);

 return {
 title: String(title || '').trim(),
 content: String(content || '').trim(),
 metadata: metadata
 };
 }

