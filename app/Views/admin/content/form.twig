 });
 categoryNames.forEach(function(categoryName) {
 if (!categoryName) return;
 var normalized = String(categoryName).trim();
 if (!normalized) return;
 var lower = normalized.toLowerCase();
 if (nameMap[lower]) {
 var option = select.querySelector('option[value="' + nameMap[lower] + '"]');
 if (option) option.selected = true;
 } else {
 ensureHiddenCategoryInput(normalized);
 }
 });
 }

 function maybeSetContent(html) {
 if (!html) return false;
 var editor = window.editor_content;
 if (editor && typeof editor.setContent === 'function') {
 var existing = '';
 try { existing = String(editor.getContent() || '').trim(); } catch(_) {}
 if (!existing) {
 editor.setContent(html);
 return true;
 }
 return false;
 }
 var ci = document.getElementById('content-input');
 if (ci && !String(ci.value || '').trim()) {
 ci.value = html;
 return true;
 }
 return false;
 }

 function getHtmlSegments(html) {
 var parser = new DOMParser();
 var doc = parser.parseFromString('<div>' + html + '</div>', 'text/html');
 var wrapper = doc.body.firstChild;
 var segments = [];
 if (!wrapper) return [html];
 wrapper.childNodes.forEach(function(node) {
 if (node.nodeType === Node.TEXT_NODE) {
 segments.push(node.textContent || '');
 } else if (node.nodeType === Node.ELEMENT_NODE) {
 segments.push(node.outerHTML);
 }
 });
 return segments.length ? segments : [html];
 }

 async function typeContentIntoEditor(html) {
 if (!html) return;
 var editor = window.editor_content;
 var segments = getHtmlSegments(html);
 var current = '';
 if (editor && typeof editor.setContent === 'function') {
 for (var i = 0; i < segments.length; i++) {
 current += segments[i];
 editor.setContent(current);
 await new Promise(function(resolve) { setTimeout(resolve, 35); });
 }
 editor.setContent(html);
 } else {
 var ci = document.getElementById('content-input');
 if (ci) {
 ci.value = html;
 }
 }
 }

 function slugifyText(value) {
 return String(value || '')
 .toLowerCase()
 .trim()
 .replace(/[^a-z0-9\s-\u0980-\u09FF]+/g, '')
 .replace(/\s+/g, '-')
 .replace(/-+/g, '-')
 .replace(/^-+|-+$/g, '');
 }

 async function applyToForm() {
 var appliedAny = false;
 var generatedTitle = lastMeta.title || lastTitle;
 if (generatedTitle) {
 appliedAny = setFieldIfEmpty('title', generatedTitle) || appliedAny;
