 }

 resultsEl.innerHTML = html;

 resultsEl.querySelectorAll('.pexels-photo-card').forEach(function(card) {
 card.addEventListener('click', function() {
 resultsEl.querySelectorAll('.pexels-photo-card').forEach(function(c) { c.classList.remove('selected'); });
 card.classList.add('selected');
 selectedPhoto = {
 id: card.dataset.id,
 url: card.dataset.url,
 alt: card.dataset.alt,
 photographer: card.dataset.photographer,
 width: parseInt(card.dataset.width) || 0,
 height: parseInt(card.dataset.height) || 0
 };
 insertBtn.disabled = false;
 });
 });

 resultsEl.querySelectorAll('.pexels-page-btn').forEach(function(btn) {
 btn.addEventListener('click', function() {
 performSearch(currentQuery, parseInt(this.dataset.page));
 });
 });
 }

 insertBtn.addEventListener('click', async function() {
 if (!selectedPhoto) return;
 insertBtn.disabled = true;
 insertBtn.innerHTML = '<span class="inline-spinner inline-spinner-sm mr-1"></span>Downloading...';

 var selectedCard = resultsEl.querySelector('.pexels-photo-card.selected .pexels-loading-overlay');
 if (selectedCard) selectedCard.classList.add('active');

 try {
 var resp = await fetch('/api/pixabay/download-image', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
 body: JSON.stringify({
 image_url: selectedPhoto.url,
 alt_text: selectedPhoto.alt
 })
 });
 var data = await resp.json();

 if (data.success && data.url) {
 var editor = window.editor_content;
 var imgTag = '<img src="' + data.url + '" alt="' + escapeHtml(selectedPhoto.alt) + '" class="max-w-full h-auto">';
 if (editor && typeof editor.insertContent === 'function') {
 editor.insertContent(imgTag);
 } else if (editor && typeof editor.setContent === 'function') {
 var existing = '';
 try { existing = String(editor.getContent() || '').trim(); } catch(_) {}
 editor.setContent(existing + '\n\n' + imgTag);
 } else {
 var contentInput = document.getElementById('content-input');
 if (contentInput) {
 contentInput.value += '\n\n' + imgTag;
 }
 }

 var toastText = document.getElementById('prefillToastText');
 var toast = document.getElementById('prefillToast');
 if (toast && toastText) {
 toastText.textContent = '\u2713 Image inserted into editor';
 toast.classList.add('show');
 setTimeout(function() { toast.classList.remove('show'); }, 3000);
 }

 closeModal();
 } else {
 showError(data.error || 'Download failed');
 if (selectedCard) selectedCard.classList.remove('active');
 insertBtn.disabled = false;
 insertBtn.innerHTML = '<i class="lucide lucide-download mr-1"></i> Insert Selected';
 }
 } catch (err) {
 showError('Download error: ' + (err.message || 'Unknown'));
 if (selectedCard) selectedCard.classList.remove('active');
 insertBtn.disabled = false;
 insertBtn.innerHTML = '<i class="lucide lucide-download mr-1"></i> Insert Selected';
 }
 });

 pixabayBtn.addEventListener('click', openModal);
 closeBtn.addEventListener('click', closeModal);
 searchBtn.addEventListener('click', function() {
 performSearch(searchInput.value.trim());
 });
 searchInput.addEventListener('keydown', function(e) {
 if (e.key === 'Enter') {
 e.preventDefault();
 performSearch(searchInput.value.trim());
 }
 });

 modal.addEventListener('click', function(e) {
 if (e.target === modal) closeModal();
 });

 document.addEventListener('keydown', function(e) {
 if (e.key === 'Escape' && modal.classList.contains('active')) {
 closeModal();
 }
 });
 })();
 </script>
{% endblock %}







