{% block scripts %}
 {% set rte_version = getRTEVersion() %}
 <script src="/rtceditor/editor.bundle.js?v={{ rte_version }}" defer></script>
 <script>
 document.addEventListener('DOMContentLoaded', function () {
 const form = document.querySelector('form[data-autosave="true"]');
 if (!form) return;

 // ── Word Count & Character Count ──
 const editorShell = document.querySelector('[data-editor-shell="content"]');
 if (editorShell) {
  // Insert word counter bar below the editor
  const counterBar = document.createElement('div');
  counterBar.className = 'word-counter';
  counterBar.id = 'editorWordCounter';
  counterBar.innerHTML = '<span class="word-counter-item"><i class="lucide lucide-type w-3.5 h-3.5 text-indigo-500"></i> <strong id="wordCount">0</strong> words</span><span class="word-counter-item"><i class="lucide lucide-text-cursor w-3.5 h-3.5 text-indigo-500"></i> <strong id="charCount">0</strong> characters</span><span class="ml-auto text-slate-400" id="readingTime">< 1 min read</span>';
  editorShell.appendChild(counterBar);

  function updateWordCount() {
   const editor = window.editor_content;
   const html = editor && typeof editor.getContent === 'function'
    ? editor.getContent()
    : (document.getElementById('content-input')?.value || '');
   const text = String(html || '').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();
   const chars = text.length;
   const words = text ? text.split(/\s+/).filter(Boolean).length : 0;
   const wordEl = document.getElementById('wordCount');
   const charEl = document.getElementById('charCount');
   const readingEl = document.getElementById('readingTime');
   if (wordEl) wordEl.textContent = words.toLocaleString();
   if (charEl) charEl.textContent = chars.toLocaleString();
   if (readingEl) {
    const mins = Math.max(1, Math.ceil(words / 200));
    readingEl.textContent = mins + ' min' + (mins > 1 ? 's' : '') + ' read';
   }
  }

  // Poll for editor content changes (the RTE dispatches input events on the contenteditable)
  const editorEl = editorShell.querySelector('[contenteditable="true"]');
  if (editorEl) {
   editorEl.addEventListener('input', updateWordCount);
   editorEl.addEventListener('keyup', updateWordCount);
  }
  // Also watch for RTE ready event to attach listener
  document.addEventListener('rte:ready', function (e) {
   if (e.detail && e.detail.editorId === 'content') {
    setTimeout(updateWordCount, 100);
    var editor = window.editor_content;
    if (editor && editor.getEditor && typeof editor.getEditor === 'function') {
     var el = editor.getEditor();
     if (el) {
      el.addEventListener('input', updateWordCount);
      el.addEventListener('keyup', updateWordCount);
     }
    }
   }
  });
  setTimeout(updateWordCount, 500);
 }

 // ── Featured Image Drop Zone ──
 (function() {
  var dropzone = document.getElementById('featuredDropzone');
  var fileInput = document.getElementById('featuredFileInput');
  var hiddenInput = document.getElementById('featuredImageInput');
  var placeholder = document.getElementById('featuredPlaceholder');
  var preview = document.getElementById('featuredPreview');
  var previewImg = document.getElementById('featuredPreviewImg');
  var replaceBtn = document.getElementById('featuredReplaceBtn');
  var removeBtn = document.getElementById('featuredRemoveBtn');
  var pexelsBtn = document.getElementById('featuredPexelsBtn');
  var pixabayBtn = document.getElementById('featuredPixabayBtn');

  if (!dropzone) return;

  // Restore existing image if present
  function restoreExistingImage() {
   var existingUrl = hiddenInput ? hiddenInput.value : '';
   if (existingUrl && previewImg && placeholder && preview) {
    previewImg.src = existingUrl;
    placeholder.classList.add('hidden');
    preview.classList.remove('hidden');
    dropzone.classList.add('has-image');
   }
  }
  restoreExistingImage();

  function handleFile(file) {
   if (!file || !file.type.startsWith('image/')) {
    window.showMessage?.('Please select a valid image file', 'warning');
    return;
   }
   if (file.size > 5 * 1024 * 1024) {
    window.showMessage?.('Image must be under 5MB', 'warning');
    return;
   }

   // Show preview immediately
   var reader = new FileReader();
   reader.onload = function(e) {
    if (previewImg) previewImg.src = e.target.result;
    if (placeholder) placeholder.classList.add('hidden');
    if (preview) preview.classList.remove('hidden');
    if (dropzone) dropzone.classList.add('has-image');

    // Upload via FormData
    var formData = new FormData();
    formData.append('file', file);
    formData.append('type', 'featured');

    var xhr = new XMLHttpRequest();
    xhr.open('POST', '/api/media/upload');
    xhr.setRequestHeader('X-CSRF-Token', document.querySelector('meta[name="csrf-token"]')?.content || '');
    xhr.onload = function() {
     if (xhr.status === 200) {
      try {
       var data = JSON.parse(xhr.responseText);
       if (data.success && data.url && hiddenInput) {
        hiddenInput.value = data.url;
        if (previewImg) previewImg.src = data.url;
       } else if (data.url && hiddenInput) {
        hiddenInput.value = data.url;
       }
      } catch(_) {}
     }
    };
    xhr.send(formData);
   };
   reader.readAsDataURL(file);
  }

  // Click to upload
  dropzone.addEventListener('click', function(e) {
   if (e.target.closest('.featured-preview-actions')) return;
   if (fileInput) fileInput.click();
  });

  if (fileInput) {
   fileInput.addEventListener('change', function() {
    if (fileInput.files && fileInput.files[0]) {
     handleFile(fileInput.files[0]);
    }
   });
  }

  // Drag and drop
  dropzone.addEventListener('dragover', function(e) {
   e.preventDefault();
   e.stopPropagation();
   dropzone.classList.add('drag-over');
  });
  dropzone.addEventListener('dragleave', function(e) {
   e.preventDefault();
   e.stopPropagation();
   dropzone.classList.remove('drag-over');
  });
  dropzone.addEventListener('drop', function(e) {
   e.preventDefault();
   e.stopPropagation();
   dropzone.classList.remove('drag-over');
   var files = e.dataTransfer.files;
   if (files && files[0]) {
    handleFile(files[0]);
    if (fileInput) {
     var dt = new DataTransfer();
     dt.items.add(files[0]);
     fileInput.files = dt.files;
    }
   }
  });

  // Replace button
  if (replaceBtn) {
   replaceBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    if (fileInput) fileInput.click();
   });
  }

  // Remove button
  if (removeBtn) {
   removeBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    if (previewImg) previewImg.src = '';
    if (placeholder) placeholder.classList.remove('hidden');
    if (preview) preview.classList.add('hidden');
    if (dropzone) dropzone.classList.remove('has-image');
    if (hiddenInput) hiddenInput.value = '';
    if (fileInput) fileInput.value = '';
   });
  }

  // Pexels/Pixabay - use existing modal openers
  if (pexelsBtn) {
   pexelsBtn.addEventListener('click', function() {
    var pexelsModal = document.getElementById('pexelsModal');
    if (pexelsModal) pexelsModal.classList.add('active');
    var input = document.getElementById('pexelsSearchInput');
    if (input) input.focus();
   });
  }
  if (pixabayBtn) {
   pixabayBtn.addEventListener('click', function() {
    var pixabayModal = document.getElementById('pixabayModal');
    if (pixabayModal) pixabayModal.classList.add('active');
    var input = document.getElementById('pixabaySearchInput');
    if (input) input.focus();
   });
  }
 })();

