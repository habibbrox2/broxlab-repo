 // ── SEO Progress Bar Threshold Colors ──
 (function() {
  function updateProgressWithColors(inputId, progressId, countId, max) {
   var input = document.getElementById(inputId);
   var bar = document.getElementById(progressId);
   var count = document.getElementById(countId);
   if (!input || !bar || !count) return;

   function update() {
    var val = input.value.length;
    var pct = Math.min((val / max) * 100, 100);
    bar.style.width = pct + '%';
    // Reset classes
    bar.className = 'char-progress-bar';
    // Threshold: 70%+ amber, 90%+ red
    if (pct >= 90) {
     bar.classList.add('danger');
    } else if (pct >= 70) {
     bar.classList.add('warning');
    }
    count.textContent = val + '/' + max;
    count.className = 'text-slate-400 dark:text-slate-500';
    if (val > max) {
     count.classList.add('text-red-500');
     count.classList.remove('text-slate-400');
    }
   }

   input.addEventListener('input', update);
   update();
  }

  updateProgressWithColors('meta_title', 'metaTitleProgress', 'metaTitleCount', 60);
  updateProgressWithColors('meta_description', 'metaDescProgress', 'metaDescCount', 160);
 })();

