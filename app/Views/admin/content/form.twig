 if (!form) return;

 form.addEventListener('submit', function (event) {
 const editor = window.editor_content;
 const html = editor && typeof editor.getContent === 'function'
 ? editor.getContent()
 : (document.getElementById('content-input')?.value || '');
 const text = String(html || '').replace(/<[^>]+>/g, '').trim();

 if (!text) {
 event.preventDefault();
 alert('Content is required.');
 }
 });
 }, { once: true });
 </script>

 <!-- AI Article Writer Stream -->
 <script>
 // Global helper: escape HTML special characters (used by multiple IIFE blocks)
 function escapeHtml(str) {
 var d = document.createElement('div');
 d.textContent = str;
 return d.innerHTML;
 }

 (function() {
 'use strict';

 const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
 const aiModalEl = document.getElementById('aiWriterModal');
 const aiModal = (aiModalEl && typeof broxUI !== 'undefined' && broxUI.Modal)
 ? new broxUI.Modal(aiModalEl)
 : null;

 // Prefill flash indicator helpers
 function flashField(el, label) {
 if (!el) return;
 el.classList.add('prefill-flash');
 el.style.position = 'relative';
 setTimeout(function() { el.classList.remove('prefill-flash'); }, 2200);
 }

 function showPrefillToast(fieldNames) {
 if (!fieldNames.length) return;
 var toast = document.getElementById('prefillToast');
 var text = document.getElementById('prefillToastText');
 if (!toast || !text) return;
 text.textContent = '\u2713 Auto-filled: ' + fieldNames.join(', ');
 toast.classList.add('show');
 // Auto-dismiss after 5 seconds
 var timer = setTimeout(function() { toast.classList.remove('show'); }, 5000);
 // Close button
 var closeBtn = document.getElementById('prefillToastClose');
 if (closeBtn) {
 closeBtn.onclick = function() {
 clearTimeout(timer);
 toast.classList.remove('show');
 };
 }
 // Click anywhere on toast to dismiss
 toast.onclick = function(e) {
 if (e.target === closeBtn) return;
 clearTimeout(timer);
 toast.classList.remove('show');
 };
 }

 var aiDock = document.getElementById('aiWriterDock');
 var aiDockTitle = document.getElementById('aiWriterDockTitle');
 var aiDockStatus = document.getElementById('aiWriterDockStatus');
 var aiDockStatusBtn = document.getElementById('aiWriterDockStatusBtn');
 var aiRestoreBtn = document.getElementById('aiWriterRestoreBtn');
 var aiMinimizeBtn = document.getElementById('aiWriterMinimizeBtn');
 var aiWriterShouldDock = false;

 function setDockVisible(visible) {
 if (!aiDock) return;
 aiDock.classList.toggle('show', !!visible);
 aiDock.setAttribute('aria-hidden', visible ? 'false' : 'true');
 }

 function setDockState(title, status) {
 if (aiDockTitle) {
 aiDockTitle.textContent = title || 'AI Writer';
 }
 if (aiDockStatus) {
 aiDockStatus.textContent = status || 'Ready to generate your post.';
 }
 }

 function showDockAndHideModal() {
 aiWriterShouldDock = true;
 setDockVisible(true);
 if (aiModalEl && aiModalEl.contains(document.activeElement)) {
 document.activeElement.blur();
 }
 if (aiModal) {
 aiModal.hide();
 } else {
 var aiWriterModal = document.getElementById('aiWriterModal');
 if (aiWriterModal) {
 aiWriterModal.classList.remove('show');
 aiWriterModal.style.display = 'none';
 }
 }
 }

 function restoreDockedWriter() {
 aiWriterShouldDock = false;
 setDockVisible(false);
 if (aiModal) {
 aiModal.show();
 } else {
 var aiWriterModal = document.getElementById('aiWriterModal');
 if (aiWriterModal) {
 aiWriterModal.classList.add('show');
 aiWriterModal.style.display = 'block';
 }
 }
 setTimeout(function() {
 var topicInput = document.getElementById('aiTopic');
 if (topicInput) topicInput.focus();
 }, 250);
 }

 window.__aiWriterDock = {
 setState: setDockState,
 show: function (title, status) {
 setDockState(title, status);
 setDockVisible(true);
 },
 hide: function () {
 setDockVisible(false);
 },
 setDocked: function (value) {
 aiWriterShouldDock = !!value;
 }
 };

 // URL param prefill for AI Writer
 (function prefillAIWriterFromURL() {
 try {
 function safeDecodeUrlValue(val) {
 if (!val) return '';
 var s = String(val);
 // URLSearchParams already decodes most inputs; this is a best-effort for double-encoded payloads.
 try { s = decodeURIComponent(s); } catch (_) {}
 return s;
 }

 function sanitizePrefillHtml(html) {
 if (!html) return '';
 var raw = String(html);
 try {
 var doc = new DOMParser().parseFromString('<div>' + raw + '</div>', 'text/html');
 var root = doc.body && doc.body.firstChild;
 if (!root) return '';

 var allowed = {
 'ARTICLE': true,
 'P': true, 'H1': true, 'H2': true, 'H3': true,
 'UL': true, 'OL': true, 'LI': true,
 'STRONG': true, 'EM': true, 'B': true, 'I': true,
 'BR': true, 'BLOCKQUOTE': true,
 'A': true,
 'DIV': true, 'SPAN': true
 };

 function isSafeUrl(url) {
 var u = String(url || '').trim();
 if (!u) return true;
 if (/^javascript:/i.test(u)) return false;
 // Allow relative, http(s), mailto, tel.
 return /^(https?:|mailto:|tel:|\/|#)/i.test(u);
 }

 function cleanNode(node) {
 if (!node) return;
 if (node.nodeType === Node.COMMENT_NODE) {
 node.remove();
 return;
 }
 if (node.nodeType === Node.ELEMENT_NODE) {
 var tag = (node.tagName || '').toUpperCase();
 if (!allowed[tag]) {
 // Unwrap: keep the text/children but remove the element itself.
 var parent = node.parentNode;
 if (parent) {
 while (node.firstChild) parent.insertBefore(node.firstChild, node);
 parent.removeChild(node);
 } else {
 node.remove();
 }
 return;
 }

 // Strip dangerous attributes.
 Array.from(node.attributes || []).forEach(function (attr) {
 var name = (attr.name || '').toLowerCase();
 var value = attr.value || '';
 if (name.startsWith('on')) {
 node.removeAttribute(attr.name);
 return;
 }
 if (name === 'style') {
 node.removeAttribute(attr.name);
 return;
 }
 if ((name === 'href' || name === 'src') && !isSafeUrl(value)) {
 node.removeAttribute(attr.name);
 return;
 }
 if (tag !== 'A' && name === 'target') {
 node.removeAttribute(attr.name);
 return;
 }
 });
 }

 Array.from(node.childNodes || []).forEach(cleanNode);
 }

 cleanNode(root);
 return root.innerHTML || '';
 } catch (_) {
 return '';
 }
 }

 var params = new URLSearchParams(window.location.search);
 var topic = safeDecodeUrlValue(params.get('topic') || params.get('q') || '');
 var tone = params.get('tone') || '';
 var length = params.get('length') || '';
 var keywords = safeDecodeUrlValue(params.get('keywords') || '');
 var lang = params.get('language') || params.get('lang') || '';

 // Direct form field prefill from URL params
 var urlSlug = params.get('slug') || '';
 var urlContent = params.get('content') || '';
 var safeHtmlContent = sanitizePrefillHtml(safeDecodeUrlValue(urlContent));

 var prefilledFields = [];

 if (topic) {
 var titleInput = document.getElementById('title');
 if (titleInput && !titleInput.value.trim()) {
 titleInput.value = topic;
 flashField(titleInput, 'Title');
 prefilledFields.push('Title');
 }
 }
 if (urlSlug) {
 var slugInput = document.getElementById('seo');
 if (slugInput && !slugInput.value.trim()) {
 slugInput.value = urlSlug;
 flashField(slugInput, 'Slug');
 prefilledFields.push('Slug');
 }
 }
 if (safeHtmlContent) {
 try {
 var editor = window.editor_content;
 var contentFilled = false;
 if (editor && typeof editor.setContent === 'function') {
 // Check if editor already has content from the server
 var existing = '';
 try { existing = String(editor.getContent() || '').trim(); } catch(_) {}
 if (!existing) {
 editor.setContent(safeHtmlContent);
 contentFilled = true;
 }
 } else {
 var ci = document.getElementById('content-input');
 if (ci && !ci.value.trim()) {
 ci.value = safeHtmlContent;
 contentFilled = true;
 }
 }
 if (contentFilled) {
 var editorEl = document.querySelector('.modern-rich-editor');
 if (editorEl) flashField(editorEl, 'Content');
 prefilledFields.push('Content');
 }
 } catch(_) { /* ignore URL content errors */ }
 }

 if (topic || tone || keywords || lang) {
 var topicInput = document.getElementById('aiTopic');
