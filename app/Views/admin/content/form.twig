 async function startGeneration(options) {
 generateBtn.disabled = true;
 generateBtn.innerHTML = '<span class="inline-spinner inline-spinner-sm mr-1"></span>Generating...';
 statusEl.classList.remove('hidden');
 statusText.textContent = 'Starting generation...';
 syncDockStatus('Starting generation...');

 var fullTitle = '';
 var fullContent = '';
 var fetchError = null;

 try {
 showProgress(15, 'Sending request to AI...', 'Generating Article');

 var messages = [
 {
 role: 'system',
 content: 'You are a professional article writer. Generate a well-structured, SEO-optimized article. Include metadata for slug, SEO title, SEO description, tags, categories, and reader indexing when available. Return only the article and metadata. Do not include any intro sentence, apology, or commentary. First provide a compelling title on a line starting with"TITLE:", then the full article body with proper headings and paragraphs. Use markdown formatting.'
 },
 {
 role: 'user',
 content: buildUserPrompt(options)
 }
 ];

 var resp = await fetch('/api/admin/ai/chat', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
 body: JSON.stringify({
 messages: messages,
 stream: false,
 tools: []
 })
 });

 var data = await resp.json();

 if (data.success && data.content) {
 showProgress(70, 'Processing AI response...', 'Generating Article');
 statusText.textContent = 'Processing response...';
 syncDockStatus('Processing response...');

 var rawText = typeof data.content === 'string' ? data.content : JSON.stringify(data.content);
 var parsed = parseArticleResponse(rawText);
 fullTitle = parsed.title;
 fullContent = parsed.content;
 lastMeta = parsed.metadata || {};

 if (!fullContent || /<tool_call\b|<\/tool_call>/i.test(parsed.content || '')) {
 fetchError = 'AI response contained tool call metadata instead of readable article text. Please regenerate or check AI provider settings.';
 } else {
 showProgress(85, 'Article received (' + fullContent.length + ' chars)', 'Generating Article');
 if (charsDisplay) charsDisplay.textContent = fullContent.length + ' characters generated';
 syncDockStatus('Article received and ready to apply');
 }
 } else {
 fetchError = data.error || data.message || 'The AI returned an empty response. Please try again or check your AI provider settings.';
 if (!fetchError && data.raw) {
 fetchError = 'Unexpected AI payload: ' + JSON.stringify(data.raw);
 }
 }
 } catch(err) {
 fetchError = err.message || 'Network error. Please try again.';
 }

 // Handle error state
 if (fetchError) {
 statusText.textContent = 'Error: ' + fetchError;
 statusEl.classList.remove('hidden');
 statusEl.classList.add('flex', 'items-center', 'gap-2', 'mt-3');
 showCompletion(false, fetchError);
 resetBtn();
 return;
 }

 // Store results for preview
 lastTitle = fullTitle;
 lastHtml = convertToHtml(fullTitle, fullContent);
 syncDockStatus(fullTitle || 'Generated article ready');

 // Auto-save draft in background
 try {
 overlayText.textContent = 'Saving draft...';
 var postIdInput = document.getElementById('post_id');
 var slugInput = document.getElementById('seo');

 var formData = new FormData();
 formData.append('id', postIdInput?.value || '');
 formData.append('title', fullTitle);
 formData.append('content', lastHtml);
 if (slugInput && !slugInput.value && lastMeta.slug) {
 slugInput.value = lastMeta.slug;
 }
 formData.append('slug', slugInput?.value || '');
 formData.append('meta_title', document.getElementById('meta_title')?.value || '');
 formData.append('meta_description', document.getElementById('meta_description')?.value || '');
 formData.append('status', 'draft');

 var saveResp = await fetch('/api/posts/autosave', {
 method: 'POST',
 headers: { 'X-CSRF-Token': csrfToken },
 body: formData
 });
 var saveData = await saveResp.json();

 if (saveData.success && saveData.id) {
 if (postIdInput) postIdInput.value = saveData.id;
 var idInput = document.querySelector('form input[name="id"]');
 if (saveData.is_new && !idInput) {
 var hidden = document.createElement('input');
 hidden.type = 'hidden';
 hidden.name = 'id';
 hidden.value = saveData.id;
 document.querySelector('form[data-autosave="true"]')?.appendChild(hidden);
 }
 overlayText.textContent = 'Draft saved (ID: ' + saveData.id + ')';
 syncDockStatus('Draft saved (ID: ' + saveData.id + ')');
 } else {
 overlayText.textContent = 'Draft auto-save completed';
 syncDockStatus('Draft auto-save completed');
 }
 } catch(saveErr) {
 overlayText.textContent = 'Generation ready for preview';
 syncDockStatus('Generation ready for preview');
 }

 // Apply results directly to the live form so fields are prefilled
 try {
 await applyToForm();
 syncDockStatus('Fields applied to the form');
 } catch (applyErr) {
 console.error('Auto-apply failed:', applyErr);
 }

 resetBtn();
 showCompletion(true, 'Article generated - fields updated in the form.');

