   var slug = title.toLowerCase().trim()
    .replace(/[^a-z0-9\s\u0980-\u09FF]+/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-+|-+$/g, '');
   if (slug) {
    slugInput.value = slug;
    var slugText = document.getElementById('slugText');
    if (slugText) slugText.textContent = slug;
   }
  });
