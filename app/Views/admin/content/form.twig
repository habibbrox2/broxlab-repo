 // --- Floating AI Writer Button ---
 (function() {
 var fabBtn = document.getElementById('aiFabBtn');
 var aiModalEl = document.getElementById('aiWriterModal');
 var aiTopic = document.getElementById('aiTopic');

 if (!fabBtn || !aiModalEl) return;

 var aiModalInstance = (typeof broxUI !== 'undefined' && broxUI.Modal)
 ? new broxUI.Modal(aiModalEl)
 : null;

 function showFab() {
 fabBtn.classList.add('visible');
 }

 function hideFab() {
 fabBtn.classList.remove('visible');
 }

 function openModal() {
 if (window.__aiWriterDock && typeof window.__aiWriterDock.setDocked === 'function') {
 window.__aiWriterDock.setDocked(false);
 window.__aiWriterDock.hide();
 }
 if (aiModalInstance) {
 aiModalInstance.show();
 } else {
 aiModalEl.classList.add('show');
 aiModalEl.style.display = 'block';
 }
 hideFab();
 setTimeout(function() {
 if (aiTopic) aiTopic.focus();
 }, 250);
 }

 function closeModal() {
 if (window.__aiWriterDock && typeof window.__aiWriterDock.setDocked === 'function') {
 window.__aiWriterDock.setDocked(false);
 window.__aiWriterDock.hide();
 }
 if (aiModalInstance) {
 aiModalInstance.hide();
 } else {
 aiModalEl.classList.remove('show');
 aiModalEl.style.display = 'none';
 }
 showFab();
 }

 showFab();

 fabBtn.addEventListener('click', openModal);

 if (aiModalInstance) {
 aiModalEl.addEventListener('brox:shown', hideFab);
 aiModalEl.addEventListener('brox:hidden', showFab);
 } else {
 // Fallback close handlers for custom modal behavior
 aiModalEl.querySelectorAll('[data-brox-dismiss="modal"]').forEach(function(btn) {
 btn.addEventListener('click', function() {
 closeModal();
 });
 });

 aiModalEl.addEventListener('click', function(event) {
 if (event.target === aiModalEl) {
 closeModal();
 }
 });
 }

 document.addEventListener('keydown', function(e) {
 if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'a' || e.key === 'A')) {
 var tag = e.target.tagName;
 if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || e.target.isContentEditable) return;
 e.preventDefault();
 fabBtn.click();
 }
 });
 })();

 // --- Pexels Image Picker ---
 (function() {
 var pexelsBtn = document.getElementById('pexelsBtn');
 var modal = document.getElementById('pexelsModal');
 var closeBtn = document.getElementById('pexelsModalClose');
 var searchInput = document.getElementById('pexelsSearchInput');
 var searchBtn = document.getElementById('pexelsSearchBtn');
 var resultsEl = document.getElementById('pexelsResults');
 var insertBtn = document.getElementById('pexelsInsertBtn');
 var totalResults = document.getElementById('pexelsTotalResults');

 if (!pexelsBtn || !modal) return;

 var selectedPhoto = null;
 var currentQuery = '';
 var currentPage = 1;
 var totalPages = 1;

 function openModal() {
 modal.classList.add('active');
 // Auto-fill search from AI writer topic
 var topic = document.getElementById('aiTopic')?.value.trim();
 if (topic && !searchInput.value) {
 searchInput.value = topic;
 performSearch(topic);
 } else {
 searchInput.focus();
 }
 }

 function closeModal() {
 modal.classList.remove('active');
 selectedPhoto = null;
 insertBtn.disabled = true;
 }

 function showLoading() {
 resultsEl.innerHTML = '<div class="pexels-loading"><div class="inline-spinner text-emerald-600" role="status"></div><p class="mt-2 small">Searching...</p></div>';
 }

 function showError(msg) {
 resultsEl.innerHTML = '<div class="pexels-error"><i class="lucide lucide-alert-triangle mr-1"></i>' + escapeHtml(msg) + '</div>';
 }

 function showEmpty() {
 resultsEl.innerHTML = '<div class="pexels-empty"><i class="lucide lucide-image"></i><p class="font-semibold mb-1">No images found</p><p class="mb-0 small">Try a different search term</p></div>';
 }

 async function performSearch(query, page) {
 page = page || 1;
 if (!query) return;
 currentQuery = query;
 currentPage = page;
 showLoading();
 selectedPhoto = null;
 insertBtn.disabled = true;

 try {
 var resp = await fetch('/api/pexels/search?q=' + encodeURIComponent(query) + '&page=' + page + '&per_page=15');
 var data = await resp.json();

 if (!data.success) {
 showError(data.error || 'Search failed');
 return;
 }

 if (!data.photos || !data.photos.length) {
 showEmpty();
 if (totalResults) totalResults.textContent = '';
 return;
 }

 totalPages = Math.ceil((data.total_results || 0) / (data.per_page || 15));
 if (totalResults) {
 totalResults.textContent = data.total_results + ' results';
 }

 renderPhotos(data.photos, page, totalPages);
 } catch (err) {
 showError('Network error: ' + (err.message || 'Unknown'));
 }
 }

 function renderPhotos(photos, page, totalPages) {
 var html = '';
 photos.forEach(function(photo) {
 var src = photo.src?.medium || photo.src?.small || '';
 var alt = escapeHtml(photo.alt || 'Pexels photo');
 var photographer = escapeHtml(photo.photographer || 'Unknown');
 var width = photo.width || 0;
 var height = photo.height || 0;
 html += '<div class="pexels-photo-card" data-id="' + photo.id + '" data-url="' + escapeHtml(photo.src?.large || photo.src?.original || '') + '" data-alt="' + alt + '" data-photographer="' + photographer + '" data-width="' + width + '" data-height="' + height + '">';
 html += '<img src="' + escapeHtml(src) + '" alt="' + alt + '" loading="lazy">';
 html += '<div class="pexels-photo-info">' + photographer + '</div>';
 html += '<div class="pexels-loading-overlay"><div class="inline-spinner inline-spinner-sm text-emerald-600"></div></div>';
 html += '</div>';
 });

 // Pagination nav
 if (totalPages > 1) {
 html += '<div class="pexels-pagination" style="grid-column:1/-1;display:flex;align-items:center;justify-content:center;gap:0.75rem;padding:1rem 0;">';
 if (page > 1) {
 html += '<button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-100 pexels-page-btn" data-page="' + (page - 1) + '"><i class="lucide lucide-chevron-left"></i> Previous</button>';
 }
 html += '<small class="text-slate-500">Page ' + page + ' of ' + totalPages + '</small>';
 if (page < totalPages) {
 html += '<button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-100 pexels-page-btn" data-page="' + (page + 1) + '">Next <i class="lucide lucide-chevron-right"></i></button>';
 }
 html += '</div>';
 }

 resultsEl.innerHTML = html;

 // Click handler for photo selection
 resultsEl.querySelectorAll('.pexels-photo-card').forEach(function(card) {
 card.addEventListener('click', function() {
 resultsEl.querySelectorAll('.pexels-photo-card').forEach(function(c) { c.classList.remove('selected'); });
 card.classList.add('selected');
 selectedPhoto = {
 id: card.dataset.id,
 url: card.dataset.url,
 alt: card.dataset.alt,
 photographer: card.dataset.photographer,
 width: parseInt(card.dataset.width) || 0,
 height: parseInt(card.dataset.height) || 0
 };
 insertBtn.disabled = false;
 });
 });

 // Click handler for pagination
 resultsEl.querySelectorAll('.pexels-page-btn').forEach(function(btn) {
 btn.addEventListener('click', function() {
 performSearch(currentQuery, parseInt(this.dataset.page));
 });
 });
 }

 // Insert selected image
 insertBtn.addEventListener('click', async function() {
 if (!selectedPhoto) return;
 insertBtn.disabled = true;
 insertBtn.innerHTML = '<span class="inline-spinner inline-spinner-sm mr-1"></span>Downloading...';

 // Show loading overlay on selected photo
 var selectedCard = resultsEl.querySelector('.pexels-photo-card.selected .pexels-loading-overlay');
 if (selectedCard) selectedCard.classList.add('active');

 try {
 var resp = await fetch('/api/pexels/download-image', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
 body: JSON.stringify({
 image_url: selectedPhoto.url,
 alt_text: selectedPhoto.alt
 })
 });
 var data = await resp.json();

 if (data.success && data.url) {
 // Insert image into the RTE editor
 var editor = window.editor_content;
 var imgTag = '<img src="' + data.url + '" alt="' + escapeHtml(selectedPhoto.alt) + '" class="max-w-full h-auto">';
 if (editor && typeof editor.insertContent === 'function') {
 editor.insertContent(imgTag);
 } else if (editor && typeof editor.setContent === 'function') {
 var existing = '';
 try { existing = String(editor.getContent() || '').trim(); } catch(_) {}
 editor.setContent(existing + '\n\n' + imgTag);
 } else {
 var contentInput = document.getElementById('content-input');
 if (contentInput) {
 contentInput.value += '\n\n' + imgTag;
 }
 }

 // Show success toast briefly
 var toastText = document.getElementById('prefillToastText');
 var toast = document.getElementById('prefillToast');
 if (toast && toastText) {
 toastText.textContent = '\u2713 Image inserted into editor';
 toast.classList.add('show');
 setTimeout(function() { toast.classList.remove('show'); }, 3000);
 }

 closeModal();
 } else {
 showError(data.error || 'Download failed');
 if (selectedCard) selectedCard.classList.remove('active');
 insertBtn.disabled = false;
 insertBtn.innerHTML = '<i class="lucide lucide-download mr-1"></i> Insert Selected';
 }
 } catch (err) {
 showError('Download error: ' + (err.message || 'Unknown'));
 if (selectedCard) selectedCard.classList.remove('active');
 insertBtn.disabled = false;
 insertBtn.innerHTML = '<i class="lucide lucide-download mr-1"></i> Insert Selected';
 }
 });

 // Event listeners
 pexelsBtn.addEventListener('click', openModal);
 closeBtn.addEventListener('click', closeModal);
 searchBtn.addEventListener('click', function() {
 performSearch(searchInput.value.trim());
 });
 searchInput.addEventListener('keydown', function(e) {
 if (e.key === 'Enter') {
 e.preventDefault();
 performSearch(searchInput.value.trim());
 }
 });

 // Close on overlay click
 modal.addEventListener('click', function(e) {
 if (e.target === modal) closeModal();
 });

 // Close on Escape
 document.addEventListener('keydown', function(e) {
 if (e.key === 'Escape' && modal.classList.contains('active')) {
 closeModal();
 }
 });
 })();

