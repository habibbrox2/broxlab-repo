{% extends"admin/layout.twig" %}
{% block title %}{{ media.filename }} - Media Details{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4" data-media-detail="true">
 <!-- Page Header -->
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-image mr-2"></i>
 Media Details
 </div>
 <div>Media file information</div>
 </div>
 <!-- Header -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
 <div class="md:col-span-8">
 <h1>
 <i class="lucide lucide-image"></i> Media Details
 </h1>
 </div>
 <div class="md:col-span-4 text-right">
 <a href="/admin/media" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200">
 <i class="lucide lucide-arrow-left"></i> Back to Library
 </a>
 </div>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <!-- Media Preview -->
 <div class="lg:col-span-6">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3">
 <h5 class="mb-0">Media Preview</h5>
 </div>
 <div class="p-4 p-0">
 <div class="aspect-video bg-slate-100">
 {% if media.media_type == 'image' %}
 <img src="{{ media_url }}"
 alt="{{ media.title }}"
 class="max-w-full h-auto w-full h-full ">
 {% elseif media.media_type == 'video' %}
 <video controls class="w-full h-full ">
 <source src="{{ media_url }}" type="{{ media.mime_type }}">
 Your browser does not support the video tag.
 </video>
 {% elseif media.media_type == 'audio' %}
 <audio controls class="w-full ">
 <source src="{{ media_url }}" type="{{ media.mime_type }}">
 Your browser does not support the audio tag.
 </audio>
 {% else %}
 <div class="flex items-center justify-center h-full bg-slate-100 text-slate-500">
 <div class="text-center">
 <i class="lucide lucide-file "></i>
 <p class="mt-3 mb-0">{{ media.media_type|upper }} File</p>
 </div>
 </div>
 {% endif %}
 </div>
 </div>
 </div>
 <!-- Thumbnail Preview (if exists) -->
 {% if thumbnail_url %}
 <div class=" border border-slate-200 bg-white shadow-sm mt-3">
 <div class=" border-slate-200 px-4 py-3">
 <h5 class="mb-0">Thumbnail</h5>
 </div>
 <div class="p-4 p-2">
 <img src="{{ thumbnail_url }}"
 alt="Thumbnail"
 class="max-w-full h-auto w-full rounded">
 </div>
 </div>
 {% endif %}
 </div>
 <!-- Media Information -->
 <div class="lg:col-span-6">
 <!-- Basic Info -->
 <div class=" border border-slate-200 bg-white shadow-sm mb-3">
 <div class=" border-slate-200 px-4 py-3">
 <h5 class="mb-0">Basic Information</h5>
 </div>
 <div class="p-4">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="sm:col-span-4">
 <strong>Media Type:</strong>
 </div>
 <div class="sm:col-span-8">
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-indigo-600 text-uppercase">{{ media.media_type }}</span>
 </div>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="sm:col-span-4">
 <strong>File Size:</strong>
 </div>
 <div class="sm:col-span-8">{{ media.file_size|filesizeformat }}</div>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="sm:col-span-4">
 <strong>MIME Type:</strong>
 </div>
 <div class="sm:col-span-8">
 <code class="bg-slate-100 p-2 rounded">{{ media.mime_type }}</code>
 </div>
 </div>
 {% if media.width and media.height %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="sm:col-span-4">
 <strong>Dimensions:</strong>
 </div>
 <div class="sm:col-span-8">{{ media.width }} Ã— {{ media.height }} pixels</div>
 </div>
 {% endif %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
 <div class="sm:col-span-4">
 <strong>Original Name:</strong>
 </div>
 <div class="sm:col-span-8">
 <small>{{ media.original_name }}</small>
 </div>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="sm:col-span-4">
 <strong>Uploaded:</strong>
 </div>
 <div class="sm:col-span-8">{{ media.created_at|date("d M Y H:i") }}</div>
 </div>
 </div>
 </div>
 <!-- Edit Information Form -->
 <div class=" border border-slate-200 bg-white shadow-sm mb-3">
 <div class=" border-slate-200 px-4 py-3">
 <h5 class="mb-0">Edit Information</h5>
 </div>
 <div class="p-4">
 <form method="POST" action="/admin/media/{{ media.id }}/update">
 <div class="mb-3">
 <label for="title" class="form-label">Title</label>
 <input type="text"
 id="title"
 name="title"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 value="{{ media.title }}"
 required>
 </div>
 <div class="mb-3">
 <label for="description" class="form-label">Description</label>
 <textarea id="description" name="description" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" rows="4">{{ media.description }}</textarea>
 </div>
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 w-full">
 <i class="lucide lucide-check"></i> Save Changes
 </button>
 </form>
 </div>
 </div>
 <!-- File Path -->
 <div class=" border border-slate-200 bg-white shadow-sm mb-3">
 <div class=" border-slate-200 px-4 py-3">
 <h5 class="mb-0">File Path</h5>
 </div>
 <div class="p-4">
 <code class="bg-slate-100 p-3 rounded block text-break">{{ media_url }}</code>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs bg-indigo-600 text-white hover:bg-indigo-700-outline mt-2"
 onclick="copyToClipboard('{{ media_url }}')">
 <i class="lucide lucide-clipboard"></i> Copy URL
 </button>
 </div>
 </div>
 <!-- Danger Zone -->
 <div class=" border border-slate-200 bg-white shadow-sm border-danger mb-3">
 <div class=" border-slate-200 px-4 py-3 bg-slate-100 border-danger">
 <h5 class="mb-0 text-red-600">
 <i class="lucide lucide-alert-triangle"></i> Danger Zone
 </h5>
 </div>
 <div class="p-4">
 <p class="text-slate-500 mb-3">Delete this media file. This action can be reversed from the trash for 30 days.</p>
 <form method="POST"
 action="/admin/media/{{ media.id }}/delete"
 onsubmit="return confirm('Are you sure? This media will be moved to trash.');">
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 w-full">
 <i class="lucide lucide-trash-2"></i> Delete Media
 </button>
 </form>
 </div>
 </div>
 </div>
 </div>
 </div>
{% endblock %}






