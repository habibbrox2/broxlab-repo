{% extends "admin/layout.twig" %}
{% block content %}
<div class="px-4 sm:px-6 lg:px-8 py-5">
    <div class="relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-900 text-white shadow-xl shadow-slate-900/20">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.25),transparent_55%)]" aria-hidden="true"></div>
        <div class="relative px-6 py-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center flex-shrink-0">
                    <i class="lucide lucide-file-user w-5 h-5 text-white"></i>
                </div>
                <div>
                    <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-1">CV Info Details</p>
                    <h1 class="text-xl font-bold text-white">{{ record.full_name ?? 'Unknown' }}</h1>
                    <p class="text-sm text-white/60 mt-0.5">CV Information Record</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a href="/admin/cv-infos" class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150"><i class="lucide lucide-arrow-left w-4 h-4"></i> Back</a>
                <a href="/admin/cv-infos/edit/{{ record.id }}" class="inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 transition-all duration-150 shadow-lg shadow-indigo-500/30"><i class="lucide lucide-pencil w-4 h-4"></i> Edit</a>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-[1fr_340px] gap-6">
        <div class="space-y-5">
            {# Personal Information Card #}
            <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
                    <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
                        <i class="lucide lucide-user w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
                    </div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Personal Information</h3>
                </div>
                <div class="p-5 grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Full Name</span>
                        <span class="text-slate-900 dark:text-slate-100 font-medium">{{ record.full_name ?? 'N/A' }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Job Title</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.job_title ?? 'N/A' }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Email</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.email ?? 'N/A' }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Phone</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.phone ?? 'N/A' }}</span>
                    </div>
                    <div class="col-span-2">
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Address</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.address ?? 'N/A' }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Date of Birth</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.date_of_birth ? record.date_of_birth|date('d M Y') : 'N/A' }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Nationality</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.nationality ?? 'N/A' }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Gender</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.gender ? record.gender|capitalize : 'N/A' }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Driving License</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.driving_license ?? 'N/A' }}</span>
                    </div>
                </div>
            </div>

            {# Identity Documents Card #}
            <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
                    <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
                        <i class="lucide lucide-id-card w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
                    </div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Identity &amp; Documents</h3>
                </div>
                <div class="p-5 grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">National ID No.</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.national_id_no ?? 'N/A' }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Passport No.</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.passport_no ?? 'N/A' }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Birth Certificate No.</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.birth_certificate_no ?? 'N/A' }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Religion</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.religion ?? 'N/A' }}</span>
                    </div>
                </div>
            </div>

            {# Social & Web Profiles Card #}
            <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
                    <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
                        <i class="lucide lucide-share-2 w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
                    </div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Social &amp; Web Profiles</h3>
                </div>
                <div class="p-5 grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Website</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.website ?: 'N/A' }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Portfolio</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.portfolio ?: 'N/A' }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">LinkedIn</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.linkedin ?: 'N/A' }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">GitHub</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.github ?: 'N/A' }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Twitter / X</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.twitter ?: 'N/A' }}</span>
                    </div>
                </div>
            </div>
        </div>

        {# ── RIGHT COLUMN ── #}
        <div class="space-y-5">
            {# Record Info Card #}
            <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
                    <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
                        <i class="lucide lucide-info w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
                    </div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Record Info</h3>
                </div>
                <div class="p-5 space-y-4 text-sm">
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">ID</span>
                        <span class="text-slate-900 dark:text-slate-100 font-medium">#{{ record.id }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">CV Title</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.cv_title ?? '#' ~ record.id }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">User</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.first_name ? record.first_name ~ ' ' ~ record.last_name : (record.username ?? '#' ~ record.user_id) }}</span>
                        {% if record.user_email %}<span class="block text-xs text-slate-400 dark:text-slate-500 mt-0.5">{{ record.user_email }}</span>{% endif %}
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Created</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.created_at|date('d M Y, h:i A') }}</span>
                    </div>
                    <div>
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Updated</span>
                        <span class="text-slate-900 dark:text-slate-100">{{ record.updated_at|date('d M Y, h:i A') }}</span>
                    </div>
                </div>
            </div>

            {# Danger Zone Card #}
            <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-800">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2"><i class="lucide lucide-trash-2 w-4 h-4 text-red-500"></i> Danger Zone</h3>
                </div>
                <div class="p-5">
                    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">Delete this CV info record. This action cannot be undone.</p>
                    <form method="POST" action="/admin/cv-infos/{{ record.id }}/delete" data-action="confirm-delete-cv-info">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-red-600 hover:bg-red-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover:-translate-y-0.5 active:scale-[0.98]">
                            <i class="lucide lucide-trash-2 w-4 h-4"></i>
                            Delete Record
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
