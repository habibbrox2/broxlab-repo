{% extends "admin/layout.twig" %}
{% block content %}
<div class="px-4 sm:px-6 lg:px-8 py-5">
    <div class="relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-900 text-white shadow-xl shadow-slate-900/20">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.25),transparent_55%)]" aria-hidden="true"></div>
        <div class="relative px-6 py-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center flex-shrink-0">
                    <i class="lucide lucide-file-user w-5 h-5 text-white"></i>
                </div>
                <div>
                    <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-1">CV Templates</p>
                    <h1 class="text-xl font-bold text-white">CV Templates</h1>
                    <p class="text-sm text-white/60 mt-0.5">Manage resume and CV template designs.</p>
                </div>
            </div>
            <div class="flex gap-2">
                <a href="/admin/cv-templates/create" class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
                    <i class="lucide lucide-plus w-4 h-4"></i> New Template
                </a>
            </div>
        </div>
    </div>
    <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
            <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
                    <i class="lucide lucide-file-user w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
                </div>
                <h3 class="text-sm font-semibold text-slate-900 dark:text-white">All Templates</h3>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-400">{{ pagination.total }}</span>
            </div>
        </div>
        <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900">
            <form method="GET" action="/admin/cv-templates" class="grid grid-cols-1 md:grid-cols-3 gap-3 items-end">
                <div class="md:col-span-1">
                    <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Search</label>
                    <input type="text" name="search" value="{{ filters.search|default('')|e('html_attr') }}" placeholder="Name, slug, description..."
                           class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Status</label>
                    <select name="status" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10">
                        <option value="all" {{ filters.status == 'all' ? 'selected' : '' }}>All templates</option>
                        <option value="active" {{ filters.status == 'active' ? 'selected' : '' }}>Active only</option>
                        <option value="inactive" {{ filters.status == 'inactive' ? 'selected' : '' }}>Disabled only</option>
                        <option value="deleted" {{ filters.status == 'deleted' ? 'selected' : '' }}>Soft deleted</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Per page</label>
                    <select name="limit" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10">
                        <option value="20" {{ filters.limit == 20 ? 'selected' : '' }}>20</option>
                        <option value="50" {{ filters.limit == 50 ? 'selected' : '' }}>50</option>
                        <option value="100" {{ filters.limit == 100 ? 'selected' : '' }}>100</option>
                    </select>
                </div>
                <div class="md:col-span-3 flex flex-wrap gap-2">
                    <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-150">
                        <i class="lucide lucide-filter w-4 h-4"></i> Apply
                    </button>
                    {% if filters.search or filters.status != 'all' or filters.limit != 20 %}
                    <a href="/admin/cv-templates" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all duration-150">
                        <i class="lucide lucide-rotate-ccw w-4 h-4"></i> Clear
                    </a>
                    {% endif %}
                </div>
            </form>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-slate-100 dark:border-slate-800">
                        <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">ID</th>
                        <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Name</th>
                        <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Category</th>
                        <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Status</th>
                        <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    {% if templates is defined and templates|length > 0 %}
                        {% for tpl_slug, tpl in templates %}
                        <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors duration-100">
                            <td class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400">{{ tpl.id }}</td>
                            <td class="px-4 py-3 text-sm font-medium text-slate-900 dark:text-slate-100">{{ tpl.name }}</td>
                            <td class="px-4 py-3 text-sm text-slate-700 dark:text-slate-300">{{ tpl.category ?? 'N/A' }}</td>
                            <td class="px-4 py-3">
                                {% set is_active = (tpl.status ?? 'active') == 'active' and not tpl.deleted_at %}
                                {% if is_active %}
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400">
                                    <span class="w-1 h-1 rounded-full bg-emerald-500"></span> Active
                                </span>
                                {% else %}
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                                    <span class="w-1 h-1 rounded-full bg-slate-400"></span> {% if tpl.deleted_at %}Deleted{% else %}Inactive{% endif %}
                                </span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-1">
                                    <a href="/admin/cv-templates/preview/{{ tpl.slug ?? tpl_slug }}" target="_blank" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/30 transition-all duration-150" title="Preview">
                                        <i class="lucide lucide-eye w-3.5 h-3.5"></i>
                                    </a>
                                    <a href="/admin/cv-templates/view/{{ tpl.slug ?? tpl_slug }}" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-950/30 transition-all duration-150" title="View">
                                        <i class="lucide lucide-eye w-3.5 h-3.5"></i>
                                    </a>
                                    <a href="/admin/cv-templates/{{ tpl.slug ?? tpl_slug }}/edit" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-950/30 transition-all duration-150" title="Edit">
                                        <i class="lucide lucide-pencil w-3.5 h-3.5"></i>
                                    </a>
                                    <form method="POST" action="/admin/cv-templates/{{ tpl.slug ?? tpl_slug }}/delete" data-action="confirm-delete-template" class="inline">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                        <button type="submit" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 transition-all duration-150" title="Delete">
                                            <i class="lucide lucide-trash-2 w-3.5 h-3.5"></i>
                                        </button>
                                    </form>
                                    {% if tpl.deleted_at %}
                                    <form method="POST" action="/admin/cv-templates/{{ tpl.slug ?? tpl_slug }}/restore" data-action="confirm-restore-template" class="inline">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                        <button type="submit" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/30 transition-all duration-150" title="Restore">
                                            <i class="lucide lucide-rotate-ccw w-3.5 h-3.5"></i>
                                        </button>
                                    </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-4 py-16">
                                <div class="flex flex-col items-center justify-center text-center">
                                    <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-4">
                                        <i class="lucide lucide-file-user w-7 h-7 text-slate-400 dark:text-slate-600"></i>
                                    </div>
                                    <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-1">No templates found</h3>
                                    <p class="text-sm text-slate-400 dark:text-slate-600 mb-5 max-w-xs">Create your first CV template to get started.</p>
                                    <a href="/admin/cv-templates/create" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:-translate-y-0.5 transition-all duration-150">
                                        <i class="lucide lucide-plus w-4 h-4"></i> Create Template
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
        {% if pagination.total_pages > 1 %}
        <div class="px-5 py-4 border-t border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-slate-500 dark:text-slate-400">
                Showing {{ pagination.from }} to {{ pagination.to }} of {{ pagination.total }} templates
            </p>
            <div class="flex flex-wrap gap-2">
                {% set commonQuery = '&limit=' ~ pagination.per_page ~ '&search=' ~ (pagination.search|url_encode) ~ '&status=' ~ pagination.status %}
                <a href="/admin/cv-templates?page={{ pagination.current_page > 1 ? pagination.current_page - 1 : 1 }}{{ commonQuery }}" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 dark:border-slate-700 px-3 py-2 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 {{ pagination.current_page <= 1 ? 'pointer-events-none opacity-50' : '' }}">
                    <i class="lucide lucide-chevron-left w-4 h-4"></i> Prev
                </a>
                <span class="inline-flex items-center rounded-xl bg-slate-50 dark:bg-slate-800 px-3 py-2 text-sm font-semibold text-slate-700 dark:text-slate-300">
                    Page {{ pagination.current_page }} of {{ pagination.total_pages }}
                </span>
                <a href="/admin/cv-templates?page={{ pagination.current_page < pagination.total_pages ? pagination.current_page + 1 : pagination.total_pages }}{{ commonQuery }}" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 dark:border-slate-700 px-3 py-2 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 {{ pagination.current_page >= pagination.total_pages ? 'pointer-events-none opacity-50' : '' }}">
                    Next <i class="lucide lucide-chevron-right w-4 h-4"></i>
                </a>
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
