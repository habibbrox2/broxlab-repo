{% extends "admin/layout.twig" %}
{% block content %}
<div class="px-4 sm:px-6 lg:px-8 py-5">
    <div class="relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-900 text-white shadow-xl shadow-slate-900/20">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.25),transparent_55%)]" aria-hidden="true"></div>
        <div class="relative px-6 py-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center flex-shrink-0">
                    <i class="lucide lucide-file-text w-5 h-5 text-white"></i>
                </div>
                <div>
                    <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-1">CV Template</p>
                    <h1 class="text-xl font-bold text-white">{{ template.name ?? template_slug|capitalize }}</h1>
                    <p class="text-sm text-white/60 mt-0.5">{{ template.description ?? 'No description' }}</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a href="/admin/cv-templates" class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150"><i class="lucide lucide-arrow-left w-4 h-4"></i> Back</a>
                <a href="/admin/cv-templates/{{ template_slug }}/edit" class="inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 transition-all duration-150 shadow-lg shadow-indigo-500/30"><i class="lucide lucide-pencil w-4 h-4"></i> Edit</a>
                <a href="/admin/cv-templates/preview/{{ template_slug }}" target="_blank" class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150"><i class="lucide lucide-eye w-4 h-4"></i> Preview</a>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-[1fr_340px] gap-6">
        <div class="space-y-5">
            <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
                    <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
                        <i class="lucide lucide-info w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
                    </div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Template Details</h3>
                </div>
                <div class="p-5 grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
                    <div><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">ID</span><span class="text-slate-900 dark:text-slate-100 font-medium">#{{ template.id ?? '-' }}</span></div>
                    <div><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Slug</span><span class="text-slate-900 dark:text-slate-100 font-mono text-xs">{{ template_slug }}</span></div>
                    <div><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Category</span><span class="text-slate-900 dark:text-slate-100">{{ template.category ?? 'N/A' }}</span></div>
                    <div><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Status</span>{% set is_active = template.is_active ?? template.status == 'active' %}{% if is_active %}<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active</span>{% else %}<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Inactive</span>{% endif %}</div>
                    <div><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Version</span><span class="text-slate-900 dark:text-slate-100">{{ template.version ?? '1.0.0' }}</span></div>
                    <div><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Custom</span><span class="text-slate-900 dark:text-slate-100">{{ template.is_custom ? 'Yes' : 'No' }}</span></div>
                    <div><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Free</span><span class="text-slate-900 dark:text-slate-100">{{ template.is_free is defined ? (template.is_free ? 'Yes' : 'Premium') : 'N/A' }}</span></div>
                    <div><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Author</span><span class="text-slate-900 dark:text-slate-100">{{ template.author ?? 'System' }}</span></div>
                </div>
            </div>
            <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
                    <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0"><i class="lucide lucide-align-left w-4 h-4 text-indigo-600 dark:text-indigo-400"></i></div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Description</h3>
                </div>
                <div class="p-5"><p class="text-sm text-slate-700 dark:text-slate-300">{{ template.description ?? 'No description provided for this template.' }}</p></div>
            </div>
            {% if template.features is defined and template.features is iterable and template.features|length > 0 %}
            <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
                    <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0"><i class="lucide lucide-sparkles w-4 h-4 text-indigo-600 dark:text-indigo-400"></i></div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Features</h3>
                </div>
                <div class="p-5"><div class="flex flex-wrap gap-2">{% for feature in template.features %}<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 text-xs font-medium text-indigo-700 dark:text-indigo-300"><i class="lucide lucide-check w-3 h-3"></i> {{ feature }}</span>{% endfor %}</div></div>
            </div>
            {% endif %}
            {% if template.tags is defined and template.tags is iterable and template.tags|length > 0 %}
            <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
                    <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0"><i class="lucide lucide-tags w-4 h-4 text-indigo-600 dark:text-indigo-400"></i></div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Tags</h3>
                </div>
                <div class="p-5"><div class="flex flex-wrap gap-2">{% for tag in template.tags %}<span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-xs font-medium text-slate-600 dark:text-slate-400">{{ tag }}</span>{% endfor %}</div></div>
            </div>
            {% endif %}
            {% if template.supported_sections is defined and template.supported_sections is iterable and template.supported_sections|length > 0 %}
            <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
                    <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0"><i class="lucide lucide-layers w-4 h-4 text-indigo-600 dark:text-indigo-400"></i></div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Supported Sections</h3>
                </div>
                <div class="p-5"><div class="flex flex-wrap gap-2">{% for section in template.supported_sections %}<span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-sky-50 dark:bg-sky-900/30 text-xs font-medium text-sky-700 dark:text-sky-300">{{ section }}</span>{% endfor %}</div></div>
            </div>
            {% endif %}
        </div>
        <div class="space-y-5 xl:sticky xl:top-20">
            <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
                    <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0"><i class="lucide lucide-zap w-4 h-4 text-indigo-600 dark:text-indigo-400"></i></div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Actions</h3>
                </div>
                <div class="p-5 space-y-3">
                    <a href="/admin/cv-templates/{{ template_slug }}/edit" class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover:-translate-y-0.5 active:scale-[0.98]"><i class="lucide lucide-pencil w-4 h-4"></i> Edit Template</a>
                    <a href="/admin/cv-templates/preview/{{ template_slug }}" target="_blank" class="w-full inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all duration-150 hover:-translate-y-0.5 active:scale-[0.98]"><i class="lucide lucide-eye w-4 h-4"></i> Preview (New Tab)</a>
                    {% if template.is_custom is defined and template.is_custom %}
                    <form method="POST" action="/admin/cv-templates/{{ template_slug }}/delete" data-action="confirm-delete-template" class="block">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <button type="submit" class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 hover:bg-red-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover:-translate-y-0.5 active:scale-[0.98]"><i class="lucide lucide-trash-2 w-4 h-4"></i> Delete Template</button>
                    </form>
                    {% endif %}
                    <form method="POST" action="/admin/cv-templates/{{ template_slug }}/toggle" data-action="toggle-template-status" class="block">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <button type="submit" class="w-full inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all duration-150 hover:-translate-y-0.5 active:scale-[0.98]"><i class="lucide lucide-{{ (template.is_active ?? template.status == 'active') ? 'pause' : 'play' }} w-4 h-4"></i> {{ (template.is_active ?? template.status == 'active') ? 'Disable' : 'Enable' }} Template</button>
                    </form>
                </div>
            </div>
            {% if template.created_at or template.updated_at %}
            <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
                    <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0"><i class="lucide lucide-clock w-4 h-4 text-indigo-600 dark:text-indigo-400"></i></div>
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Timestamps</h3>
                </div>
                <div class="p-5 space-y-4 text-sm">
                    {% if template.created_at %}<div><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Created</span><span class="text-slate-900 dark:text-slate-100">{{ template.created_at|date('d M Y, h:i A') }}</span></div>{% endif %}
                    {% if template.updated_at %}<div><span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Updated</span><span class="text-slate-900 dark:text-slate-100">{{ template.updated_at|date('d M Y, h:i A') }}</span></div>{% endif %}
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
