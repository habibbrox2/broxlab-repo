{% extends "admin/layout.twig" %}

{% block title %}CV Management{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% set current_page = current_page|default('cvs') %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('/assets/css/cv-admin.css') }}">
{% endblock %}

{% block content %}
{% set filters = filters|default({}) %}
{% set selected_template = filters.template|default('modern') %}
{% set template_query = selected_template ? '?template=' ~ selected_template : '' %}

<div class="w-full px-4 sm:px-6 py-4 cv-admin-page">

<!-- Hero Section with Gradient Background -->
<div class="relative mb-8 overflow-hidden rounded-2xl bg-gradient-to-r from-indigo-600 via-indigo-500 to-purple-600 px-6 py-8 md:px-8 md:py-10 shadow-lg">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute -top-40 -right-40 h-80 w-80 rounded-full bg-white/20 blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 h-80 w-80 rounded-full bg-white/10 blur-3xl"></div>
  </div>
  <div class="relative z-10 flex flex-col justify-between gap-6 md:flex-row md:items-center">
    <div class="flex-1">
      <div class="mb-2 flex items-center gap-2">
        <span class="inline-flex items-center justify-center rounded-full bg-white/20 p-2.5 text-white">
          <i class="lucide lucide-file-text text-xl"></i>
        </span>
      </div>
      <h1 class="text-3xl font-bold text-white md:text-4xl">CV Management</h1>
      <p class="mt-2 text-base text-indigo-50">Monitor CV activity, preview templates, and manage your CV database with powerful analytics.</p>
    </div>
    <div class="flex flex-wrap gap-3 md:flex-col">
      <a href="/admin/cv-templates" class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/20 bg-white/10 px-4 py-2.5 text-sm font-semibold text-white backdrop-blur-sm transition-all duration-200 hover:bg-white/20 hover:shadow-lg focus-visible:ring-2 focus-visible:ring-white/30">
        <i class="lucide lucide-layout-grid text-base"></i> Template Library
      </a>
      <a href="/admin/cv-personal-info" class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/20 bg-white/10 px-4 py-2.5 text-sm font-semibold text-white backdrop-blur-sm transition-all duration-200 hover:bg-white/20 hover:shadow-lg focus-visible:ring-2 focus-visible:ring-white/30">
        <i class="lucide lucide-users text-base"></i> Personal Info
      </a>
    </div>
  </div>
</div>

<!-- Statistics Cards with Enhanced Design -->
<div class="mb-8 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-all duration-300 hover:border-indigo-200 hover:shadow-md">
    <div class="mb-4 flex items-center justify-between">
      <div class="rounded-lg bg-indigo-100 p-3 text-indigo-600">
        <i class="lucide lucide-files text-xl"></i>
      </div>
      <span class="text-xs font-semibold text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-full">all</span>
    </div>
    <div class="text-3xl font-bold text-slate-900">{{ stats.total|default(0) }}</div>
    <p class="mt-1 text-sm text-slate-600">Total CVs Created</p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-all duration-300 hover:border-emerald-200 hover:shadow-md">
    <div class="mb-4 flex items-center justify-between">
      <div class="rounded-lg bg-emerald-100 p-3 text-emerald-600">
        <i class="lucide lucide-check-circle text-xl"></i>
      </div>
      <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">active</span>
    </div>
    <div class="text-3xl font-bold text-slate-900">{{ stats.active|default(0) }}</div>
    <p class="mt-1 text-sm text-slate-600">Active & Published</p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-all duration-300 hover:border-amber-200 hover:shadow-md">
    <div class="mb-4 flex items-center justify-between">
      <div class="rounded-lg bg-amber-100 p-3 text-amber-600">
        <i class="lucide lucide-pause-circle text-xl"></i>
      </div>
      <span class="text-xs font-semibold text-amber-600 bg-amber-50 px-2.5 py-1 rounded-full">draft</span>
    </div>
    <div class="text-3xl font-bold text-slate-900">{{ stats.inactive|default(0) }}</div>
    <p class="mt-1 text-sm text-slate-600">Draft & Inactive</p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-all duration-300 hover:border-sky-200 hover:shadow-md">
    <div class="mb-4 flex items-center justify-between">
      <div class="rounded-lg bg-sky-100 p-3 text-sky-600">
        <i class="lucide lucide-users text-xl"></i>
      </div>
      <span class="text-xs font-semibold text-sky-600 bg-sky-50 px-2.5 py-1 rounded-full">unique</span>
    </div>
    <div class="text-3xl font-bold text-slate-900">{{ stats.users_with_cvs|default(0) }}</div>
    <p class="mt-1 text-sm text-slate-600">Users with CVs</p>
  </div>
</div>

<!-- Advanced Filters Section -->
<div class="mb-6 rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
  <div class="border-b border-slate-200 bg-gradient-to-r from-slate-50 to-transparent px-6 py-4">
    <h3 class="flex items-center gap-2 text-sm font-semibold text-slate-700">
      <i class="lucide lucide-sliders-horizontal text-base text-indigo-600"></i>
      Search & Filter
    </h3>
  </div>
  <div class="p-6">
    <form class="space-y-4" method="get" action="">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        <!-- Search Input -->
        <div class="lg:col-span-2">
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-2">Search</label>
          <div class="relative flex items-center">
            <span class="absolute left-3 text-slate-400"><i class="lucide lucide-search text-base"></i></span>
            <input type="text"
              name="search"
              value="{{ filters.search|default('') }}"
              class="w-full border border-slate-300 pl-10 pr-4 py-2.5 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition"
              placeholder="Search by title, user, or email...">
          </div>
        </div>
        <!-- Status Filter -->
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-2">Status</label>
          <select name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 appearance-none">
            <option value="all" {% if filters.status == 'all' %}selected{% endif %}>All Status</option>
            <option value="active" {% if filters.status == 'active' %}selected{% endif %}>Active Only</option>
            <option value="inactive" {% if filters.status == 'inactive' %}selected{% endif %}>Inactive Only</option>
          </select>
        </div>
        <!-- Template Filter -->
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-2">Template</label>
          <select name="template" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 appearance-none" data-template-select>
            <option value="">All Templates</option>
            {% for template in templates|default([]) %}
            <option value="{{ template }}" {% if template == selected_template %}selected{% endif %}>
              <i class="lucide lucide-check text-xs"></i> {{ template|capitalize }}
            </option>
            {% endfor %}
          </select>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        <!-- Sort By -->
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-2">Sort By</label>
          <select name="sort" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 appearance-none">
            <option value="updated" {% if filters.sort == 'updated' %}selected{% endif %}>Last Updated</option>
            <option value="created" {% if filters.sort == 'created' %}selected{% endif %}>Created Date</option>
            <option value="title" {% if filters.sort == 'title' %}selected{% endif %}>Title (A-Z)</option>
            <option value="owner" {% if filters.sort == 'owner' %}selected{% endif %}>Owner Name</option>
          </select>
        </div>
        <!-- Order -->
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-2">Order</label>
          <select name="order" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 appearance-none">
            <option value="desc" {% if filters.order == 'desc' %}selected{% endif %}>Newest First</option>
            <option value="asc" {% if filters.order == 'asc' %}selected{% endif %}>Oldest First</option>
          </select>
        </div>
        <!-- Limit -->
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-2">Per Page</label>
          <select name="limit" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 appearance-none">
            {% for size in [10, 20, 50, 100] %}
            <option value="{{ size }}" {% if filters.limit == size %}selected{% endif %}>{{ size }} Results</option>
            {% endfor %}
          </select>
        </div>
        <!-- Actions -->
        <div class="flex gap-2">
          <button type="submit" class="flex-1 inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 hover:shadow-md">
            <i class="lucide lucide-filter text-base"></i> Apply
          </button>
          <a href="/admin/cvs" class="inline-flex items-center justify-center gap-1.5 rounded-lg px-4 py-2.5 text-sm font-semibold transition border border-slate-300 bg-white text-slate-700 hover:bg-slate-50">
            <i class="lucide lucide-rotate-ccw text-base"></i> Reset
          </a>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Enhanced Bulk Actions Bar -->
<div class="mb-6 rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden" data-cv-selection>
  <div class="border-b border-slate-200 bg-gradient-to-r from-indigo-50 to-transparent px-6 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-100 text-indigo-600 font-semibold text-sm" data-selected-count>0</span>
      <span class="text-sm text-slate-600"><strong>CVs selected</strong> for bulk actions</span>
    </div>
  </div>
  <div class="px-6 py-4 flex flex-wrap items-center gap-3">
    <button type="button" class="inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed" data-bulk-export disabled>
      <i class="lucide lucide-download text-base"></i> Export as PDF
    </button>
    <span class="text-xs text-slate-500 bg-amber-50 border border-amber-200 px-3 py-1.5 rounded-lg">
      <i class="lucide lucide-alert-circle text-xs"></i> Max 50 CVs per export
    </span>
    <div class="flex-1"></div>
    <button type="button" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium transition text-slate-600 hover:bg-slate-100 rounded-lg" onclick="document.querySelector('[data-cv-selection]').parentElement.style.display='none'">
      <i class="lucide lucide-x text-base"></i> Close
    </button>
  </div>
</div>
<div class="p-4 rounded-xl bg-amber-50 text-amber-700 border border-amber-200 hidden mb-6 flex items-start gap-3" data-bulk-error>
  <i class="lucide lucide-alert-triangle text-lg flex-shrink-0"></i>
  <div></div>
</div>

{% if cvs is not empty %}
<div class="cv-admin-table-wrapper">
<table class="cv-admin-table">
<thead>
<tr>
<th class="w-12"></th>
<th>ID</th>
<th>Title</th>
<th>Owner</th>
<th>Status</th>
<th>Created</th>
<th>Updated</th>
<th class="text-center">Actions</th>
</tr>
</thead>
<tbody>
{% for cv in cvs %}
{% set owner_name = (cv.first_name ~ ' ' ~ cv.last_name)|trim %}
{% set owner_name = owner_name ? owner_name : (cv.username|default('Unknown')) %}
<tr data-id="{{ cv.id }}">
<td class="text-center">
<input type="checkbox" class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" value="{{ cv.id }}">
</td>
<td class="font-medium" data-label="ID">#{{ cv.id }}</td>
<td data-label="Title">
<div class="font-semibold text-slate-900">{{ cv.title|default('Untitled CV') }}</div>
<div class="text-slate-500 text-xs">User ID: {{ cv.user_id }}</div>
</td>
<td data-label="Owner">
<div class="font-semibold text-slate-900">{{ owner_name }}</div>
<div class="text-slate-500 text-xs">{{ cv.email|default('') }}</div>
</td>
<td data-label="Status">
{% if cv.is_active %}
<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-emerald-100 text-emerald-800">
<i class="lucide lucide-check-circle w-3 h-3 mr-1"></i> Active
</span>
{% else %}
<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-slate-100 text-slate-600">
<i class="lucide lucide-pause-circle w-3 h-3 mr-1"></i> Inactive
</span>
{% endif %}
</td>
<td class="text-slate-600" data-label="Created">{{ cv.created_at ? (cv.created_at|date('M d, Y')) : '—' }}</td>
<td class="text-slate-600" data-label="Updated">{{ cv.updated_at ? (cv.updated_at|date('M d, Y')) : '—' }}</td>
<td class="text-center" data-label="Actions">
<div class="flex items-center justify-center gap-1.5">
<a href="/admin/cvs/{{ cv.id }}/preview{{ template_query }}"
  class="inline-flex items-center justify-center gap-1 rounded-lg px-2.5 py-2 text-xs font-medium bg-sky-50 text-sky-600 hover:bg-sky-100 transition border border-sky-200 hover:border-sky-300" 
  target="_blank"
  title="Preview as HTML">
  <i class="lucide lucide-eye text-sm"></i> <span class="hidden sm:inline">Preview</span>
</a>
<a href="/admin/cvs/{{ cv.id }}/export{{ template_query }}"
  class="inline-flex items-center justify-center gap-1 rounded-lg px-2.5 py-2 text-xs font-medium bg-emerald-50 text-emerald-600 hover:bg-emerald-100 transition border border-emerald-200 hover:border-emerald-300"
  target="_blank"
  title="Download as PDF">
  <i class="lucide lucide-file-pdf text-sm"></i> <span class="hidden sm:inline">Export</span>
</a>
</div>
</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>

{% include "admin/partials/pagination.twig" %}

{% else %}
<div class=\"rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden\">\n  <div class=\"px-8 py-12 text-center\">\n    <div class=\"inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-100 mb-4\">\n      <i class=\"lucide lucide-inbox text-2xl text-slate-400\"></i>\n    </div>\n    <h3 class=\"text-lg font-bold text-slate-900 mb-2\">No CVs Found</h3>\n    <p class=\"text-slate-600 mb-6 max-w-md mx-auto\">No CVs match your current filter criteria. Try adjusting your search or clear all filters to see the complete list.</p>\n    <a href=\"/admin/cvs\" class=\"inline-flex items-center justify-center gap-2 rounded-lg px-6 py-2.5 text-sm font-semibold border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 transition\">\n      <i class=\"lucide lucide-rotate-ccw\"></i> Clear All Filters\n    </a>\n  </div>\n</div>\n{% endif %}

</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script type="module" src="{{ asset('/assets/js/dist/cv-admin.js') }}"></script>
{% endblock %}