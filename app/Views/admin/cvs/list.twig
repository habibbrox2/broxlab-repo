{% extends "admin/layout.twig" %}

{% block title %}CV Management{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% set current_page = current_page|default('cvs') %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('/assets/css/cv-admin.css') }}">
{% endblock %}

{% block content %}
  {% set filters = filters|default({}) %}
  {% set selected_template = filters.template|default('modern') %}
  {% set template_query = selected_template ? '?template=' ~ selected_template : '' %}

  <div class="container-fluid py-4 cv-admin-page">
    <div class="cv-admin-hero">
      <div>
        <div class="cv-admin-title">CV Management</div>
        <div class="cv-admin-subtitle">Monitor CV activity, preview templates, and export files.</div>
      </div>
      <div class="cv-admin-hero-actions">
        <a href="/admin/cv-templates" class="modern-btn modern-btn-outline">
          <i class="bi bi-grid-3x3-gap me-1"></i> Template Library
        </a>
      </div>
    </div>

    <div class="cv-admin-stats">
      <div class="cv-admin-stat-card">
        <div class="cv-admin-stat-icon bg-primary-subtle text-primary">
          <i class="bi bi-files"></i>
        </div>
        <div>
          <div class="cv-admin-stat-value">{{ stats.total|default(0) }}</div>
          <div class="cv-admin-stat-label">Total CVs</div>
        </div>
      </div>
      <div class="cv-admin-stat-card">
        <div class="cv-admin-stat-icon bg-success-subtle text-success">
          <i class="bi bi-check-circle"></i>
        </div>
        <div>
          <div class="cv-admin-stat-value">{{ stats.active|default(0) }}</div>
          <div class="cv-admin-stat-label">Active CVs</div>
        </div>
      </div>
      <div class="cv-admin-stat-card">
        <div class="cv-admin-stat-icon bg-warning-subtle text-warning">
          <i class="bi bi-pause-circle"></i>
        </div>
        <div>
          <div class="cv-admin-stat-value">{{ stats.inactive|default(0) }}</div>
          <div class="cv-admin-stat-label">Inactive CVs</div>
        </div>
      </div>
      <div class="cv-admin-stat-card">
        <div class="cv-admin-stat-icon bg-info-subtle text-info">
          <i class="bi bi-people"></i>
        </div>
        <div>
          <div class="cv-admin-stat-value">{{ stats.users_with_cvs|default(0) }}</div>
          <div class="cv-admin-stat-label">Users with CVs</div>
        </div>
      </div>
    </div>

    <div class="admin-panel-card mb-4 cv-admin-filters">
      <div class="admin-panel-card-body">
        <form class="row g-3 align-items-end" method="get" action="">
          <div class="col-lg-4">
            <label class="form-label small text-muted">Search</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
              <input type="text"
                     name="search"
                     value="{{ filters.search|default('') }}"
                     class="form-control"
                     placeholder="Search by title, user, or email">
            </div>
          </div>
          <div class="col-lg-2 col-md-4">
            <label class="form-label small text-muted">Status</label>
            <select name="status" class="form-select">
              <option value="all" {% if filters.status == 'all' %}selected{% endif %}>All</option>
              <option value="active" {% if filters.status == 'active' %}selected{% endif %}>Active</option>
              <option value="inactive" {% if filters.status == 'inactive' %}selected{% endif %}>Inactive</option>
            </select>
          </div>
          <div class="col-lg-2 col-md-4">
            <label class="form-label small text-muted">Sort</label>
            <select name="sort" class="form-select">
              <option value="updated" {% if filters.sort == 'updated' %}selected{% endif %}>Updated</option>
              <option value="created" {% if filters.sort == 'created' %}selected{% endif %}>Created</option>
              <option value="title" {% if filters.sort == 'title' %}selected{% endif %}>Title</option>
              <option value="owner" {% if filters.sort == 'owner' %}selected{% endif %}>Owner</option>
            </select>
          </div>
          <div class="col-lg-2 col-md-4">
            <label class="form-label small text-muted">Order</label>
            <select name="order" class="form-select">
              <option value="desc" {% if filters.order == 'desc' %}selected{% endif %}>Newest</option>
              <option value="asc" {% if filters.order == 'asc' %}selected{% endif %}>Oldest</option>
            </select>
          </div>
          <div class="col-lg-2 col-md-4">
            <label class="form-label small text-muted">Template</label>
            <select name="template" class="form-select" data-template-select>
              {% for template in templates|default([]) %}
                <option value="{{ template }}" {% if template == selected_template %}selected{% endif %}>
                  {{ template|capitalize }}
                </option>
              {% endfor %}
            </select>
          </div>
          <div class="col-lg-2 col-md-4">
            <label class="form-label small text-muted">Limit</label>
            <select name="limit" class="form-select">
              {% for size in [10, 20, 50, 100] %}
                <option value="{{ size }}" {% if filters.limit == size %}selected{% endif %}>{{ size }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-lg-2 col-md-4">
            <button type="submit" class="modern-btn modern-btn-primary w-100">
              <i class="bi bi-funnel-fill me-1"></i>Apply
            </button>
          </div>
          <div class="col-lg-2 col-md-4">
            <a href="/admin/cvs" class="modern-btn modern-btn-outline w-100">
              <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
            </a>
          </div>
        </form>
      </div>
    </div>

    <div class="cv-admin-bulk">
      <div class="cv-admin-selection" data-cv-selection>
        <span class="text-muted">Selected:</span>
        <span class="fw-semibold" data-selected-count>0</span>
      </div>
      <div class="cv-admin-bulk-actions">
        <button type="button" class="modern-btn modern-btn-primary" data-bulk-export>
          <i class="bi bi-file-earmark-arrow-down me-1"></i> Bulk Export PDF
        </button>
        <span class="text-muted small">Limit: 50 CVs per export.</span>
      </div>
    </div>
    <div class="alert alert-warning d-none mt-3" data-bulk-error></div>

    {% if cvs is not empty %}
      <div class="admin-panel-card">
        <div class="admin-panel-card-body">
          <div class="table-container">
            <table class="table table-hover align-middle cv-admin-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Title</th>
                  <th>Owner</th>
                  <th>Status</th>
                  <th>Created</th>
                  <th>Updated</th>
                  <th class="text-center">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for cv in cvs %}
                  {% set owner_name = (cv.first_name ~ ' ' ~ cv.last_name)|trim %}
                  {% set owner_name = owner_name ? owner_name : (cv.username|default('Unknown')) %}
                  <tr data-id="{{ cv.id }}">
                    <td class="fw-semibold">#{{ cv.id }}</td>
                    <td>
                      <div class="fw-semibold">{{ cv.title|default('Untitled CV') }}</div>
                      <div class="text-muted small">User ID: {{ cv.user_id }}</div>
                    </td>
                    <td>
                      <div class="fw-semibold">{{ owner_name }}</div>
                      <div class="text-muted small">{{ cv.email|default('') }}</div>
                    </td>
                    <td>
                      {% if cv.is_active %}
                        <span class="badge bg-success-subtle text-success">Active</span>
                      {% else %}
                        <span class="badge bg-secondary-subtle text-muted">Inactive</span>
                      {% endif %}
                    </td>
                    <td class="text-muted">{{ cv.created_at ? (cv.created_at|date('M d, Y')) : '—' }}</td>
                    <td class="text-muted">{{ cv.updated_at ? (cv.updated_at|date('M d, Y')) : '—' }}</td>
                    <td class="text-center">
                      <a href="/admin/cvs/{{ cv.id }}/preview{{ template_query }}"
                         class="modern-btn btn-sm btn-info me-1"
                         target="_blank"
                         title="Preview HTML">
                        <i class="bi bi-eye-fill"></i>
                      </a>
                      <a href="/admin/cvs/{{ cv.id }}/export{{ template_query }}"
                         class="modern-btn btn-sm btn-success"
                         target="_blank"
                         title="Export PDF">
                        <i class="bi bi-file-earmark-pdf"></i>
                      </a>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
      {% include "admin/partials/pagination.twig" %}
    {% else %}
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-1"></i> No CVs found matching your filters.
      </div>
    {% endif %}
  </div>
{% endblock %}

{% block scripts %}
  {{ parent() }}
  <script src="{{ asset('/assets/js/cv-admin.js') }}" defer></script>
{% endblock %}
