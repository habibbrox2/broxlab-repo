{% extends"admin/layout.twig" %}

{% block title %}Device Control Logs{% endblock %}

{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">

    <!-- Gradient Header -->
    <div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-sky-500 via-indigo-500 to-violet-500 p-6 shadow-lg">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"></div>
        <div class="relative flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/20 backdrop-blur-sm">
                <i class="lucide lucide-cpu text-2xl text-white"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-white sm:text-3xl">Device Control Logs</h1>
                <p class="mt-1 text-sm text-indigo-100">Remote device command history and delivery status.</p>
            </div>
        </div>
    </div>

    <!-- Summary Stats -->
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md">
            <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Total Devices</p>
            <p class="mt-1 text-2xl font-bold text-slate-900">{{ summary.total|default(0) }}</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md">
            <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Online</p>
            <p class="mt-1 text-2xl font-bold text-emerald-600">{{ summary.online|default(0) }}</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md">
            <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Offline</p>
            <p class="mt-1 text-2xl font-bold text-slate-600">{{ summary.offline|default(0) }}</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md">
            <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Disabled</p>
            <p class="mt-1 text-2xl font-bold text-red-600">{{ summary.disabled|default(0) }}</p>
        </div>
    </div>

    <!-- Recent Commands Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="lucide lucide-terminal text-indigo-500" style="width:1.125em;height:1.125em;"></i>
                    <h2 class="text-sm font-semibold text-slate-900">Recent Commands</h2>
                </div>
                <form method="get" class="flex items-center gap-2">
                    <select name="limit" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-700 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/10">
                        <option value="50" {% if limit == 50 %}selected{% endif %}>50</option>
                        <option value="100" {% if limit == 100 %}selected{% endif %}>100</option>
                        <option value="200" {% if limit == 200 %}selected{% endif %}>200</option>
                        <option value="500" {% if limit == 500 %}selected{% endif %}>500</option>
                    </select>
                    <button class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-indigo-700" type="submit">Apply</button>
                </form>
            </div>
        </div>
        <div>
            {% if commands is not empty %}
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 bg-slate-50/50">
                            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">#ID</th>
                            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Device</th>
                            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Command</th>
                            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Status</th>
                            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Response</th>
                            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Created</th>
                            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Delivered</th>
                            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Executed</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for cmd in commands %}
                        <tr class="border-b border-slate-50 transition hover:bg-indigo-50/30">
                            <td class="px-5 py-3 font-mono text-xs text-slate-600">{{ cmd.id }}</td>
                            <td class="px-5 py-3">{{ cmd.device_name|default('Device #' ~ cmd.device_id) }}</td>
                            <td class="px-5 py-3"><code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">{{ cmd.command }}</code></td>
                            <td class="px-5 py-3">
                                {% set status = cmd.status|default('queued') %}
                                {% if status == 'completed' %}
                                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>{{ status }}</span>
                                {% elseif status == 'failed' %}
                                <span class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-semibold text-rose-700"><span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>{{ status }}</span>
                                {% elseif status == 'delivered' %}
                                <span class="inline-flex items-center gap-1 rounded-full bg-sky-50 px-2.5 py-0.5 text-xs font-semibold text-sky-700"><span class="h-1.5 w-1.5 rounded-full bg-sky-500"></span>{{ status }}</span>
                                {% else %}
                                <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600"><span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>{{ status }}</span>
                                {% endif %}
                            </td>
                            <td class="px-5 py-3 text-xs text-slate-500">{{ cmd.response_text|default('') }}</td>
                            <td class="px-5 py-3 text-xs text-slate-600">{{ cmd.created_at|default('') }}</td>
                            <td class="px-5 py-3 text-xs text-slate-600">{{ cmd.delivered_at|default('') }}</td>
                            <td class="px-5 py-3 text-xs text-slate-600">{{ cmd.executed_at|default('') }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="py-10 text-center text-slate-500">No command history found yet.</div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
