{% extends"admin/layout.twig" %}

{% block content %}
<div class="admin-page-header flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
 <div>
 <h1 class="flex items-center gap-2 text-2xl font-bold tracking-tight text-slate-900"><i class="lucide lucide-message-square text-indigo-600"></i> SMS Gateway Logs</h1>
 <p class="mt-1 max-w-2xl text-sm text-slate-500">View SMS gateway delivery history.</p>
 </div>
</div>
<div class="px-4 sm:px-6">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="col-span-12">
 <div class="admin-panel-card mb-4">
 <div class="border-b border-slate-200 px-4 py-3">
 <h6 class="font-semibold mb-0">SMS Gateway Logs</h6>
 </div>
 <div class="p-4 px-0 pt-0 pb-2">
 <div class="overflow-x-auto p-0">
 <table class="table items-center mb-0">
 <thead>
 <tr>
 <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Date</th>
 <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Device</th>
 <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Number</th>
 <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wider text-slate-500">Message</th>
 <th class="px-4 py-3 text-center text-xs font-semibold uppercase tracking-wider text-slate-500">Type</th>
 </tr>
 </thead>
 <tbody>
 {% for log in logs %}
 <tr>
 <td>
 <p class="text-xs font-bold mb-0">{{ log.created_at }}</p>
 </td>
 <td>
 <p class="text-xs font-bold mb-0">{{ log.device_name }}</p>
 </td>
 <td>
 <p class="text-xs font-bold mb-0">{{ log.phone_number }}</p>
 </td>
 <td class="align-middle text-center">
 <span class="text-slate-600 text-xs font-bold">{{ log.message }}</span>
 </td>
 <td class="align-middle text-center">
 <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold bg-sky-100 text-sky-800">
 {{ log.type }}
 </span>
 </td>
 </tr>
 {% endfor %}
 </tbody>
 </table>
 </div>
 </div>
 </div>
 </div>
 </div>
</div>
{% endblock %}




