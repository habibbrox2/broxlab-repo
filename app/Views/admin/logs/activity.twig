{# templates/admin/activity.twig #}
{% extends"admin/layout.twig" %}
{% block title %}{{ title }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="admin-page-header flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
 <div>
 <h1 class="flex items-center gap-2 text-2xl font-bold tracking-tight text-slate-900"><i class="lucide lucide-clock text-indigo-600"></i> Live Activity Logs</h1>
 <p class="mt-1 max-w-2xl text-sm text-slate-500">Monitor real-time system activity and user actions.</p>
 </div>
</div>
<div>
 <div class="flex justify-between items-center mb-4">
 <div class="flex gap-2 items-center">
 <div class="text-slate-500 small">
 Status: <span id="liveStatus" class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-sky-500">Connecting...</span>
 <span id="logCount" class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-600 ml-2">0 logs</span>
 </div>
 {% if auth_user.role in ['superadmin','admin'] %}
 <button id="toggleActivityBtn"
 class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 ml-2"
 title="Enable/Disable activity logging">
 <i class="lucide lucide-power mr-1"></i> <span id="toggleActivityLabel">{{ activityEnabled ? 'Activity: ON' : 'Activity: OFF' }}</span>
 </button>
 {% endif %}
 <!-- Show limit selector moved to top -->
 <div class="ml-3">
 <label for="perPageSelect" class="small text-slate-500 mr-2">Show:</label>
 <select id="perPageSelect"
 class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 inline-block">
 <option value="10">10</option>
 <option value="25">25</option>
 <option value="50" selected>50</option>
 <option value="100">100</option>
 </select>
 </div>
 {% if auth_user.is_super_admin or auth_user.role == 'admin' %}
 <button id="clearLogsBtn"
 class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-3 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-indigo-700 clear-logs-btn ml-3"
 title="à¦¸à¦¬ à¦²à¦— à¦¡à§‡à¦²à¦¿à¦Ÿ à¦•à¦°à§à¦¨ (Delete all logs)">
 <i class="lucide lucide-trash-2"></i> Clear All Logs
 </button>
 {% endif %}
 </div>
 </div>
 <!-- Filters -->
 <div class="filter-section">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 <div class="md:col-span-3">
 <div class="filter-label">Search</div>
 <input type="text"
 id="searchBox"
 class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
 placeholder="Action or details..." />
 </div>
 <div class="md:col-span-2">
 <div class="filter-label">Status</div>
 <select id="filterStatus" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 focus:border-indigo-500-sm">
 <option value="">All Status</option>
 <option value="success">Success</option>
 <option value="error">Error</option>
 </select>
 </div>
 <div class="md:col-span-2">
 <div class="filter-label">User ID</div>
 <input type="number"
 id="filterUser"
 class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
 placeholder="ID" />
 </div>
 <div class="md:col-span-2">
 <div class="filter-label">Resource</div>
 <input type="text"
 id="filterResource"
 class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
 placeholder="Type" />
 </div>
 <div class="md:col-span-2 flex items-end gap-2">
 <button id="btnRefresh" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 flex-grow-1">
 <i class="lucide lucide-refresh-cw mr-1"></i>Refresh
 </button>
 <div class="dropdown">
 <button class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"
 type="button"
 id="dropdownExport"
 data-brox-toggle="dropdown">
 <i class="lucide lucide-download mr-1"></i>Export
 </button>
 <ul class="dropdown-menu" aria-labelledby="dropdownExport">
 <li>
 <a class="dropdown-item" href="#" id="exportCsv"><i class="lucide lucide-file-spreadsheet mr-2"></i>CSV</a>
 </li>
 <li>
 <a class="dropdown-item" href="#" id="exportJson"><i class="lucide lucide-file-json mr-2"></i>JSON</a>
 </li>
 </ul>
 </div>
 </div>
 </div>
 </div>
 <!-- Table -->
 <div class="table-wrapper">
 <table class="table activity-table">
 <thead>
 <tr>
 <th class="table-col-created" data-sort="created_at">
 <i class="lucide lucide-clock"></i> Time
 <span class="sort-indicator" id="sort-created_at"></span>
 </th>
 <th class="table-col-user" data-sort="user_id">
 <i class="lucide lucide-user"></i> User
 <span class="sort-indicator" id="sort-user_id"></span>
 </th>
 <th data-sort="action">
 <i class="lucide lucide-zap"></i> Action
 <span class="sort-indicator" id="sort-action"></span>
 </th>
 <th class="table-col-120">
 <i class="lucide lucide-box"></i> Resource
 </th>
 <th class="table-col-100" data-sort="status">
 <i class="lucide lucide-check-circle"></i> Status
 <span class="sort-indicator" id="sort-status"></span>
 </th>
 <th class="table-col-130">
 <i class="lucide lucide-router"></i> IP Address / Browser
 </th>
 </tr>
 </thead>
 <tbody id="log-table-body"
 data-activity-enabled="{{ activityEnabled ? 'true' : 'false' }}">
 <tr>
 <td colspan="6" class="empty-state">
 <div>
 <i class="lucide lucide-hourglass"></i>
 <p>Loading...</p>
 </div>
 </td>
 </tr>
 </tbody>
 </table>
 <div class="pagination-section">
 <div class="pagination-info">
 <span class="ml-3">Showing <span id="startRecord">0</span> - <span id="endRecord">0</span> of <span id="totalRecord">0</span> logs</span>
 </div>
 <div class="pagination-controls">
 <button id="prevPage"
 class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"
 disabled>
 <i class="lucide lucide-chevron-left"></i> Previous
 </button>
 <span id="pageIndicator" class="text-slate-500 small mx-3">Page 1</span>
 <button id="nextPage"
 class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"
 disabled>
 Next <i class="lucide lucide-chevron-right"></i>
 </button>
 <!-- bottom clear button removed (moved to top) -->
 </div>
 </div>
 </div>
 </div>
 <!-- Log Details Modal -->
 <div class="modal fade"
 id="logDetailsModal"
 tabindex="-1"
 aria-labelledby="logDetailsLabel"
 aria-hidden="true">
 <div class="modal-dialog modal-lg">
 <div class="modal-content">
 <div class="modal-header">
 <h5 class="modal-title" id="logDetailsLabel">
 <i class="lucide lucide-file-text mr-2"></i>Activity Log Details
 </h5>
 <button type="button"
 class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-600"
 data-brox-dismiss="modal"
 aria-label="Close"></button>
 </div>
 <div class="modal-body">
 <div class="log-detail-grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="log-detail-label">ID</div>
 <div class="log-detail-value">
 <strong id="modalLogId"></strong>
 </div>
 </div>
 <div class="log-detail-grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="log-detail-label">Time</div>
 <div class="log-detail-value" id="modalLogTime"></div>
 </div>
 <div class="log-detail-grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="log-detail-label">User</div>
 <div class="log-detail-value">
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-sky-500" id="modalLogUser"></span>
 </div>
 </div>
 <div class="log-detail-grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="log-detail-label">Role</div>
 <div class="log-detail-value">
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-600" id="modalLogRole"></span>
 </div>
 </div>
 <div class="log-detail-grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="log-detail-label">Action</div>
 <div class="log-detail-value">
 <strong id="modalLogAction"></strong>
 </div>
 </div>
 <div class="log-detail-grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="log-detail-label">Resource</div>
 <div class="log-detail-value">
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-100 text-surface-dark" id="modalLogResource"></span>
 </div>
 </div>
 <div class="log-detail-grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="log-detail-label">Status</div>
 <div class="log-detail-value" id="modalLogStatus"></div>
 </div>
 <div class="log-detail-grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="log-detail-label">IP Address</div>
 <div class="log-detail-value">
 <code id="modalLogIp"></code>
 </div>
 </div>
 <div class="log-detail-grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="log-detail-label">Browser</div>
 <div class="log-detail-value" id="modalLogBrowser"></div>
 </div>
 <div class="log-detail-grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="log-detail-label">User Agent</div>
 <div class="log-detail-value">
 <small id="modalLogAgent"></small>
 </div>
 </div>
 <div class="log-detail-grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="log-detail-label">Details</div>
 <div class="log-detail-value">
 <div class="details-json" id="modalLogDetails">No additional details</div>
 </div>
 </div>
 </div>
 <div class="modal-footer">
 <button type="button"
 class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"
 data-brox-dismiss="modal">Close</button>
 <button type="button"
 class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
 id="modalCopyJson">
 <i class="lucide lucide-clipboard mr-2"></i>Copy JSON
 </button>
 </div>
 </div>
 </div>
 </div>
{% endblock %}





