{% extends"admin/layout.twig" %}

{% block content %}
<div class="w-full px-4 sm:px-6 py-3">
 <div class="flex justify-between items-center mb-3">
 <h1 class="h4 mb-0">Category Details</h1>
 <div class="flex gap-2">
 <a href="/admin/categories/edit/{{ category.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 px-3 py-1.5 text-xs">Edit</a>
 <a href="/admin/categories" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100 px-3 py-1.5 text-xs">Back</a>
 </div>
 </div>

 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0">
 <div class="p-4">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 <div class="md:col-span-6">
 <div class="text-slate-500 small">Name</div>
 <div class="font-semibold">{{ category.name|default('N/A') }}</div>
 </div>
 <div class="md:col-span-6">
 <div class="text-slate-500 small">Slug</div>
 <div class="font-semibold">{{ category.slug|default('N/A') }}</div>
 </div>
 </div>
 </div>
 </div>
</div>
{% endblock %}






