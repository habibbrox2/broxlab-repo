{% extends 'admin/layout.twig' %}

{% block title %}Donations – Admin | {{ app_settings.site_name|default('BroxBhai') }}{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><a href="/admin/dashboard">Admin</a></li>
<li class="breadcrumb-item"><a href="/admin/revenue">Revenue</a></li>
<li class="breadcrumb-item active" aria-current="page">Donations</li>
{% endblock %}

{% block page_content %}
<div class="dashboard-page">
  <div class="row g-4 mb-4">
    <div class="col-md-4">
      <div class="card stat-card h-100 border-0 shadow-sm"><div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <small class="text-muted text-uppercase">Total Received</small>
            <div class="h3 mb-0 fw-bold text-success">৳{{ donations|reduce((carry,d)=>carry+(d.status=='completed'?d.amount:0),0)|number_format(0) }}</div>
          </div>
          <div class="icon-circle bg-success bg-opacity-15 rounded-circle p-3"><i class="bi bi-currency-dollar text-success"></i></div>
        </div>
      </div></div>
    </div>
    <div class="col-md-4">
      <div class="card stat-card h-100 border-0 shadow-sm"><div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <small class="text-muted text-uppercase">Contributors</small>
            <div class="h3 mb-0 fw-bold text-primary">{{ donation_count|default(0) }}</div>
          </div>
          <div class="icon-circle bg-primary bg-opacity-15 rounded-circle p-3"><i class="bi bi-people-fill text-primary"></i></div>
        </div>
      </div></div>
    </div>
    <div class="col-md-4">
      <div class="card stat-card h-100 border-0 shadow-sm"><div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <small class="text-muted text-uppercase">Current Page</small>
            <div class="h3 mb-0 fw-bold text-warning">{{ page }} / {{ total_pages }}</div>
          </div>
          <div class="icon-circle bg-warning bg-opacity-15 rounded-circle p-3"><i class="bi bi-layout-text-sidebar text-warning"></i></div>
        </div>
      </div></div>
    </div>
  </div>

  {# ── Filterbar ── #}
  <form method="GET" class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
      <div class="row g-3">
        <div class="col-md-4">
          <input type="text" name="search" class="form-control" placeholder="Search by name, email or phone…"
                 value="{{ filters.search|default('') }}">
        </div>
        <div class="col-md-3">
          <select name="status" class="form-select">
            <option value="">All statuses</option>
            {% for s in ['pending','processing','completed','failed','cancelled','refunded'] %}
            <option value="{{ s }}" {% if filters.status==s %}selected{% endif %}>{{ s|capitalize }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-2">
          <select name="limit" class="form-select">
            {% for l in [5,10,20,50] %}<option value="{{ l }}" {% if limit==l %}selected{% endif %}>{{ l }} / page</option>{% endfor %}
          </select>
        </div>
        <div class="col-md-3 d-grid">
          <button type="submit" class="btn btn-primary rounded-pill">
            <i class="bi bi-funnel me-1"></i>Filter
          </button>
        </div>
      </div>
    </div>
  </form>

  {# ── Table ── #}
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white border-0 py-3 px-4">
      <h5 class="mb-0 fw-bold"><i class="bi bi-heart-fill text-danger me-2"></i>Donation Records</h5>
    </div>
    <div class="card-body p-0 table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="px-4">ID</th>
            <th>Donor</th>
            <th>Phone</th>
            <th>Amount</th>
            <th>Method</th>
            <th>Status</th>
            <th>Tx ID</th>
            <th>Date</th>
            <th class="text-end px-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for d in donations %}
          <tr>
            <td class="px-4"><span class="badge bg-secondary">#{{ d.id }}</span></td>
            <td>
              <div class="fw-semibold">{{ d.donor_name }}</div>
              <small class="text-muted">{{ d.donor_email|default('—') }}</small>
            </td>
            <td class="font-monospace small">{{ d.donor_phone }}</td>
            <td class="fw-bold">{{ d.currency|default('BDT') }} {{ d.amount|number_format(2) }}</td>
            <td>
              <span class="badge bg-info-subtle text-info">{{ d.method|capitalize }}</span>
            </td>
            <td>
              {% set sc = d.status %}
              {% set cls = sc == 'completed' ? 'bg-success-subtle text-success'
                          : sc == 'pending' or sc == 'processing' ? 'bg-warning-subtle text-warning'
                          : 'bg-danger-subtle text-danger' %}
              <span class="badge {{ cls }}">{{ sc|capitalize }}</span>
            </td>
            <td class="font-monospace small">{{ d.bkash_trxid or d.nagad_trxid or d.stripe_charge_id or '—' }}</td>
            <td>{{ d.created_at|date('M j, Y g:i') }}</td>
            <td class="text-end px-4">
              <div class="btn-group btn-group-sm">
                {% if d.status in ['pending','processing'] %}
                <form method="POST" action="/admin/revenue/donations/{{ d.id }}/confirm"
                      style="display:inline" class="me-1"
                      onsubmit="return confirm('Mark donation #{{ d.id }} as confirmed?')">
                  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                  <button class="btn btn-success btn-sm rounded-pill">Confirm</button>
                </form>
                <form method="POST" action="/admin/revenue/donations/{{ d.id }}/reject"
                      style="display:inline"
                      onsubmit="return confirm('Cancel donation #{{ d.id }}?')">
                  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                  <button class="btn btn-outline-danger btn-sm rounded-pill">Cancel</button>
                </form>
                {% else %}
                <span class="badge bg-light text-muted">—</span>
                {% endif %}
              </div>
            </td>
          </tr>
          {% else %}
          <tr><td colspan="9" class="text-center py-5 text-muted">
            <i class="bi bi-inbox fs-4 d-block mb-2"></i>No donations found.
          </td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if total_pages > 1 %}
    <div class="card-footer bg-white py-3">
      <nav aria-label="Donations pagination">
        <ul class="pagination mb-0 justify-content-center">
          {% for p in 1..total_pages %}
            <li class="page-item {% if p == page %}active{% endif %}">
              <a class="page-link rounded-pill mx-1" href="?page={{ p }}&{% if filters.status %}status={{ filters.status }}&{% endif %}{% if filters.search %}search={{ filters.search|url_encode }}&{% endif %}limit={{ limit }}">{{ p }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
    {% endif %}
  </div>
</div>
{% endblock %}
