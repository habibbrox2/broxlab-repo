{% extends 'admin/layout.twig' %}

{% block title %}Ad Placements â€“ Admin | {{ app_settings.site_name|default('BroxBhai') }}{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><a href="/admin/dashboard">Admin</a></li>
<li class="breadcrumb-item"><a href="/admin/revenue">Revenue</a></li>
<li class="breadcrumb-item active" aria-current="page">Ad Placements</li>
{% endblock %}

{% block page_content %}
<div>

 {# â”€â”€ Stats â”€â”€ #}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3 mb-4">
 <div class="md:col-span-4">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm  h-full border-0"><div class="p-4">
 <div class="flex justify-between items-center">
 <div>
 <small class="text-slate-500 text-uppercase">Active Slots</small>
 <div class="h3 mb-0 font-bold text-emerald-600">
 {{ placements|filter(p=>p.status=='active')|length }}
 </div>
 </div>
 <div class="icon-circle bg-emerald-600 bg-opacity-15 rounded-full p-3"><i class="lucide lucide-podcast text-emerald-600"></i></div>
 </div>
 </div></div>
 </div>
 <div class="md:col-span-4">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm  h-full border-0"><div class="p-4">
 <div class="flex justify-between items-center">
 <div>
 <small class="text-slate-500 text-uppercase">Total Impressions</small>
 <div class="h3 mb-0 font-bold text-indigo-600">
 {{ placements|reduce((carry,p)=>carry+(p.impressions|default(0)),0)|number_format }}
 </div>
 </div>
 <div class="icon-circle bg-indigo-600 bg-opacity-15 rounded-full p-3"><i class="lucide lucide-eye text-indigo-600"></i></div>
 </div>
 </div></div>
 </div>
 <div class="md:col-span-4">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm  h-full border-0"><div class="p-4">
 <div class="flex justify-between items-center">
 <div>
 <small class="text-slate-500 text-uppercase">Total Clicks</small>
 <div class="h3 mb-0 font-bold text-amber-600">
 {{ placements|reduce((carry,p)=>carry+(p.clicks|default(0)),0)|number_format }}
 </div>
 </div>
 <div class="icon-circle bg-amber-500 bg-opacity-15 rounded-full p-3"><i class="lucide lucide-mouse-pointer text-amber-600"></i></div>
 </div>
 </div></div>
 </div>
 </div>

 {# â”€â”€ Add New â”€â”€ #}
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4">
 <div class="border-b border-slate-200 px-4 py-3 bg-white border-0">
 <h5 class="mb-0 font-bold"><i class="lucide lucide-plus-circle mr-2 text-indigo-600"></i>Add New Ad Placement</h5>
 </div>
 <div class="p-4">
 <form method="POST" action="/admin/revenue/ads/save" class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <div class="md:col-span-4">
 <label class="form-label">Display Name *</label>
 <input type="text" name="name" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" placeholder="e.g. Homepage Top Banner" required>
 </div>
 <div class="md:col-span-4">
 <label class="form-label">Slot Key *</label>
 <input type="text" name="slot_key" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 font-monospace"
 placeholder="e.g. home_banner" required>
 </div>
 <div class="md:col-span-4">
 <label class="form-label">Placement *</label>
 <select name="placement" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" required>
 {% for p in all_placements %}
 <option value="{{ p }}">{{ p|replace({'_':' '})|capitalize }}</option>
 {% endfor %}
 </select>
 </div>
 <div class="col-span-12">
 <label class="form-label">Ad Code (HTML / JS snippet)</label>
 <textarea name="ad_code" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 font-monospace" rows="3"
 placeholder='<script src="â€¦"></script> or <ins class="adsbygoogle">â€¦</ins>'></textarea>
 </div>
 <div class="md:col-span-4">
 <label class="form-label">Publisher Name</label>
 <input type="text" name="publisher_name" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
 </div>
 <div class="md:col-span-4">
 <label class="form-label">Publisher Email</label>
 <input type="email" name="publisher_email" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
 </div>
 <div class="md:col-span-2">
 <label class="form-label">Status</label>
 <select name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
 <option value="active">Active</option>
 <option value="paused">Paused</option>
 <option value="expired">Expired</option>
 </select>
 </div>
 <div class="md:col-span-2 grid items-end">
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 rounded-full font-bold">
 <i class="lucide lucide-check mr-1"></i>Save
 </button>
 </div>
 </form>
 </div>
 </div>

 {# â”€â”€ List â”€â”€ #}
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl overflow-hidden">
 <div class="border-b border-slate-200 px-4 py-3 bg-white border-0">
 <h5 class="mb-0 font-bold"><i class="lucide lucide-sidebar mr-2 text-sky-600"></i>Existing Slots</h5>
 </div>
 <div class="p-4 p-0 overflow-x-auto">
 <table class="table table-hover mb-0 align-middle">
 <thead class="table-light"><tr>
 <th class="px-4">ID</th>
 <th>Name</th>
 <th>Slot Key</th>
 <th>Placement</th>
 <th>Publisher</th>
 <th>Impressions</th>
 <th>Clicks</th>
 <th>Status</th>
 <th class="text-right px-4">Actions</th>
 </tr></thead>
 <tbody>
 {% for p in placements %}
 {% set s = p.status %}
 {% set sc = s == 'active' ? 'bg-emerald-600-subtle text-emerald-600'
 : s == 'paused' ? 'bg-amber-500-subtle text-amber-600'
 : 'bg-slate-600-subtle text-slate-600' %}
 <tr>
 <td class="px-4"><span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-600">#{{ p.id }}</span></td>
 <td class="font-semibold">{{ p.name }}</td>
 <td><code class="small bg-slate-100 px-2 py-1 rounded">{{ p.slot_key }}</code></td>
 <td>{{ p.placement|replace({'_':' '})|capitalize }}</td>
 <td>{{ p.publisher_name|default('â€”') }}</td>
 <td class="font-monospace small">{{ p.impressions|default(0)|number_format }}</td>
 <td class="font-monospace small">{{ p.clicks|default(0)|number_format }}</td>
 <td><span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {{ sc }}">{{ s }}</span></td>
 <td class="text-right px-4">
 <div class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition-group transition-group-sm">
 <form method="POST" action="/admin/revenue/ads/toggle/{{ p.id }}" style="display:inline">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs {% if s == 'active' %}inline-flex text-amber-600 hover:bg-amber-100{% else transition-ghost-success{% endif %} rounded-full">
 {{ s == 'active' ? 'Pause' : 'Activate' }}
 </button>
 </form>
 <form method="GET" action="/admin/revenue/ads/delete/{{ p.id }}" style="display:inline"
 onsubmit="return confirm('Delete this ad placement?')">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-red-600 hover:bg-red-100 rounded-full">Delete</button>
 </form>
 </div>
 </td>
 </tr>
 {% else %}
 <tr><td colspan="9" class="text-center py-5 text-slate-500"><i class="lucide lucide-inbox text-3xl block mb-2"></i>No ad placements yet. Create one above.</td></tr>
 {% endfor %}
 </tbody>
 </table>
 </div>
 </div>
</div>
{% endblock %}






