{% extends 'admin/layout.twig' %}

{% block title %}Revenue Settings â€“ Admin | {{ app_settings.site_name|default('BroxBhai') }}{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><a href="/admin/dashboard">Admin</a></li>
<li class="breadcrumb-item"><a href="/admin/revenue">Revenue</a></li>
<li class="breadcrumb-item active" aria-current="page">Settings</li>
{% endblock %}

{% block page_content %}
<div>
 <form method="POST" action="/admin/revenue/settings">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

 {% set cats = [  {id:'donation', icon:'lucide lucide-heart', color:'text-red-600'},
  {id:'advertisement', icon:'lucide lucide-megaphone', color:'text-indigo-600'},
  {id:'sponsorship', icon:'lucide lucide-award', color:'text-amber-600'},
  {id:'general', icon:'lucide lucide-settings', color:'text-slate-600'},
 ] %}

 {% for cat in cats %}
 {% if settings[cat.id]|default(settings|keys|column(0)) %}
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4">
 <div class="border-b border-slate-200 px-4 py-3 bg-white border-0">
 <h5 class="mb-0 font-bold"><i class="bi {{ cat.icon }} cat.color mr-2"></i>{{ cat.id|capitalize }} Settings</h5>
 </div>
 <div class="p-4">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 {% for key, grid grid-cols-1 gap-4 md:grid-cols-12 in settings[cat.id]|default({}) %}
 <div class="md:col-span-6 lg:col-span-4">
 <label class="form-label font-semibold small">{{ grid grid-cols-1 gap-4 md:grid-cols-12.label ?? key }}</label>
 <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 name="setting_key[]" value="{{ key }}" hidden>
 <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 name="setting_value[]" value="{{ grid grid-cols-1 gap-4 md:grid-cols-12.setting_value ?? '' }}">
 <input type="hidden" name="setting_type[]" value="{{ grid grid-cols-1 gap-4 md:grid-cols-12.setting_type ?? 'text' }}">
 <input type="hidden" name="category[]" value="{{ cat.id }}">
 {% if grid grid-cols-1 gap-4 md:grid-cols-12.description %}
 <small class="text-slate-500 block mt-1">{{ grid grid-cols-1 gap-4 md:grid-cols-12.description }}</small>
 {% endif %}
 </div>
 {% endfor %}
 </div>
 </div>
 </div>
 {% endif %}
 {% endfor %}

 <div class="text-right">
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 px-5 py-3 text-base rounded-full font-bold">
 <i class="lucide lucide-check mr-2"></i>Save Settings
 </button>
 </div>
 </form>
</div>
{% endblock %}






