{% extends 'admin/layout.twig' %}

{% block title %}Sponsored Posts – Admin | {{ app_settings.site_name|default('BroxBhai') }}{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><a href="/admin/dashboard">Admin</a></li>
<li class="breadcrumb-item"><a href="/admin/revenue">Revenue</a></li>
<li class="breadcrumb-item active" aria-current="page">Sponsored Posts</li>
{% endblock %}

{% block page_content %}
<div class="dashboard-page">

  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 py-3">
      <h5 class="mb-0 fw-bold">
        <i class="bi bi-award-fill text-warning me-2"></i>Sponsored / Promoted Posts
      </h5>
    </div>
    <div class="card-body p-4">
      <p class="text-muted small mb-0">
        Sponsored posts carry a visible label on both the front-end and the admin panel.
        Revenue from sponsorships is tracked per post.
      </p>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white border-0 py-3">
      <h5 class="mb-0 fw-bold">Existing Sponsorships</h5>
    </div>
    <div class="card-body p-0 table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light"><tr>
          <th class="px-4">ID</th>
          <th>Post</th>
          <th>Sponsor</th>
          <th>Label Type</th>
          <th>Paid (BDT)</th>
          <th>Payment Status</th>
          <th>From</th>
          <th>Until</th>
          <th class="px-4">Actions</th>
        </tr></thead>
        <tbody>
        {% for sp in sponsored %}
          {% set ps = sp.payment_status %}
          {% set psc = ps == 'paid' ? 'bg-success-subtle text-success'
                   : ps == 'pending' ? 'bg-warning-subtle text-warning'
                   : 'bg-secondary-subtle text-secondary' %}
          <tr>
            <td class="px-4"><span class="badge bg-secondary">#{{ sp.id }}</span></td>
            <td>
              <a href="/posts/view/{{ sp.post_slug|url_encode }}" target="_blank" class="fw-semibold text-decoration-none">
                {{ sp.post_title|default('Post #' ~ sp.post_id) }}
                <i class="bi bi-box-arrow-up-right small text-muted"></i>
              </a>
            </td>
            <td class="fw-semibold">{{ sp.sponsor_name }}</td>
            <td>
              <span class="badge" style="background:{{ sp.background_color ?? '#fffbeb' }};color:{{ sp.label_color ?? '#92400e' }};">
                {{ sp.label_text ?? 'Sponsored' }}
              </span>
            </td>
            <td class="fw-bold">৳{{ (sp.paid_amount ?? 0)|number_format(2) }}</td>
            <td><span class="badge {{ psc }}">{{ ps|capitalize }}</span></td>
            <td>{{ sp.sponsored_from ?? '—' }}</td>
            <td>{{ sp.sponsored_until ?? '—' }}</td>
            <td class="px-4 text-end">
              <button class="btn btn-sm btn-outline-danger rounded-pill">Remove</button>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="9" class="text-center py-5 text-muted">
            <i class="bi bi-award fs-3 d-block mb-2"></i>No sponsored posts yet.
          </td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</div>
{% endblock %}
