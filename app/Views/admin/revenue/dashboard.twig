{# â”€â”€ Chart.js CDN + tiny init â”€â”€ #}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
 const months = {{ chart_months|json_encode|raw }};
 const don = {{ donation_series|json_encode|raw }};
 const ads = {{ ad_series|default([])|json_encode|raw }};
 const sponsored= {{ sponsored_series|default([])|json_encode|raw }};

 const ctx = document.getElementById('revenue-chart');
 if (!ctx) return;

 const hex = (hex8) => hex8;
 new Chart(ctx, {
 type: 'bar',
 data: {
 labels: months,
 datasets: [
 {
 label: 'Donations (à§³)',
 data: don,
 backgroundColor: 'rgba(16,185,129,.65)',
 borderRadius: 6, stack: 'stack0',
 },
 {
 label: 'Ads (à§³)',
 data: ads,
 backgroundColor: 'rgba(99,102,241,.65)',
 borderRadius: 6, stack: 'stack0',
 },
 {
 label: 'Sponsored (à§³)',
 data: sponsored,
 backgroundColor: 'rgba(245,158,11,.65)',
 borderRadius: 6, stack: 'stack0',
 },
 ]
 },
 options: {
 responsive: true, maintainAspectRatio: false,
 plugins: {
 legend: { position: 'top' },
 tooltip: {
 callbacks: {
 label: ctx => ' ' + ctx.dataset.label + ': à§³' + ctx.raw.toLocaleString()
 }
 }
 },
 scales: {
 x: { stacked: true },
 y: {
 stacked: true,
 ticks: { callback: v => 'à§³' + v.toLocaleString() }
 }
 }
 }
 });
})();
</script>
