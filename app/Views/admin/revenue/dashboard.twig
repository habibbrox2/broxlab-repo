{% extends 'admin/layout.twig' %}

{% block title %}Revenue Dashboard – Admin | {{ app_settings.site_name|default('BroxBhai') }}{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><a href="/admin/dashboard">Admin</a></li>
<li class="breadcrumb-item active" aria-current="page">Revenue</li>
{% endblock %}

{% block page_content %}
<div class="dashboard-page">

  {# ── Stats Cards ── #}
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card stat-card h-100 border-0 shadow-sm">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <small class="text-muted text-uppercase fw-semibold">Donations</small>
              <div class="h3 mb-0 fw-bold text-success">৳{{ donation_total|default(0)|number_format(0) }}</div>
            </div>
            <div class="icon-circle bg-success bg-opacity-15 rounded-circle p-3">
              <i class="bi bi-heart-fill text-success"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card stat-card h-100 border-0 shadow-sm">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <small class="text-muted text-uppercase fw-semibold">Ad Revenue</small>
              <div class="h3 mb-0 fw-bold text-primary">৳{{ ad_revenue|default(0)|number_format(0) }}</div>
            </div>
            <div class="icon-circle bg-primary bg-opacity-15 rounded-circle p-3">
              <i class="bi bi-megaphone-fill text-primary"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card stat-card h-100 border-0 shadow-sm">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <small class="text-muted text-uppercase fw-semibold">Total</small>
              <div class="h3 mb-0 fw-bold text-warning">৳{{ total_revenue|default(0)|number_format(0) }}</div>
            </div>
            <div class="icon-circle bg-warning bg-opacity-15 rounded-circle p-3">
              <i class="bi bi-currency-dollar text-warning"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card stat-card h-100 border-0 shadow-sm">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <small class="text-muted text-uppercase fw-semibold">Donors</small>
              <div class="h3 mb-0 fw-bold text-info">{{ donation_count|default(0) }}</div>
            </div>
            <div class="icon-circle bg-info bg-opacity-15 rounded-circle p-3">
              <i class="bi bi-people-fill text-info"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# ── Chart ── #}
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 py-3">
      <h5 class="mb-0 fw-bold">
        <i class="bi bi-graph-up-arrow me-2 text-primary"></i>Revenue Trend (Last 12 Months)
      </h5>
    </div>
    <div class="card-body p-4">
      <div id="revenue-chart" style="height:300px;"></div>
    </div>
  </div>

  {# ── Quick Links ── #}
  <div class="row g-3">
    <div class="col-md-4">
      <a href="/admin/revenue/donations" class="card border-0 shadow-sm rounded-4 h-100 text-decoration-none hover-shadow">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-circle bg-success bg-opacity-15 rounded-circle p-3">
              <i class="bi bi-heart-fill text-success"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-0">All Donations</h6>
              <small class="text-muted">View and manage donations</small>
            </div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-4">
      <a href="/admin/revenue/ads" class="card border-0 shadow-sm rounded-4 h-100 text-decoration-none hover-shadow">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-circle bg-primary bg-opacity-15 rounded-circle p-3">
              <i class="bi bi-megaphone-fill text-primary"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-0">Ad Placements</h6>
              <small class="text-muted">Manage ad slots across the site</small>
            </div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-4">
      <a href="/admin/revenue/sponsored" class="card border-0 shadow-sm rounded-4 h-100 text-decoration-none hover-shadow">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-circle bg-warning bg-opacity-15 rounded-circle p-3">
              <i class="bi bi-award-fill text-warning"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-0">Sponsored Posts</h6>
              <small class="text-muted">Label and manage sponsorships</small>
            </div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-md-4">
      <a href="/admin/revenue/settings" class="card border-0 shadow-sm rounded-4 h-100 text-decoration-none hover-shadow">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-circle bg-info bg-opacity-15 rounded-circle p-3">
              <i class="bi bi-gear-fill text-info"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-0">Revenue Settings</h6>
              <small class="text-muted">Payments, goals &amp; defaults</small>
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>

</div>

{# ── Chart.js CDN + tiny init ── #}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
  const months   = {{ chart_months|json_encode|raw }};
  const don      = {{ donation_series|json_encode|raw }};
  const ads      = {{ ad_series|default([])|json_encode|raw }};
  const sponsored= {{ sponsored_series|default([])|json_encode|raw }};

  const ctx = document.getElementById('revenue-chart');
  if (!ctx) return;

  const hex = (hex8) => hex8;
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: months,
      datasets: [
        {
          label: 'Donations (৳)',
          data: don,
          backgroundColor: 'rgba(16,185,129,.65)',
          borderRadius: 6, stack: 'stack0',
        },
        {
          label: 'Ads (৳)',
          data: ads,
          backgroundColor: 'rgba(99,102,241,.65)',
          borderRadius: 6, stack: 'stack0',
        },
        {
          label: 'Sponsored (৳)',
          data: sponsored,
          backgroundColor: 'rgba(245,158,11,.65)',
          borderRadius: 6, stack: 'stack0',
        },
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { position: 'top' },
        tooltip: {
          callbacks: {
            label: ctx => ' ' + ctx.dataset.label + ': ৳' + ctx.raw.toLocaleString()
          }
        }
      },
      scales: {
        x: { stacked: true },
        y: {
          stacked: true,
          ticks: { callback: v => '৳' + v.toLocaleString() }
        }
      }
    }
  });
})();
</script>
{% endblock %}
