{% extends"admin/layout.twig" %}
{% block title %}{{ mobile is defined ? 'Edit Mobile' : 'Insert Mobile' }}{% endblock %}
{% block content %}
 {% set filler = old is defined and old ? old : (mobile is defined ? mobile : {}) %}
 <div class="w-full px-4 sm:px-6 py-4">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 flex items-center justify-between">
 <h4 class="mb-0">
 <i class="lucide lucide-{{ mobile is defined ? 'pencil text-indigo-600' : 'plus-circle text-emerald-600' }} mr-2"></i>{{ mobile is defined ? 'Edit Mobile' : 'Insert Mobile' }}
 </h4>
 <a href="/admin/mobiles/all" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200 px-3 py-1.5 text-xs"><i class="lucide lucide-arrow-left mr-1"></i> Back to List</a>
 </div>
 <div class="p-4">
 <form method="post" enctype="multipart/form-data" id="mobileForm">
 {% if mobile is defined %}<input type="hidden" name="id" value="{{ mobile.id }}">{% endif %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 <!-- Brand & Model -->
 <div class="md:col-span-6">
 <label class="form-label">Brand</label>
 <input type="text"
 name="brand_name"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 placeholder="Enter Brand"
 required
 value="{{ filler.brand_name|default("") }}">
 </div>
 <div class="md:col-span-6">
 <label class="form-label">Model</label>
 <input type="text"
 name="model_name"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 placeholder="Enter Model"
 required
 value="{{ filler.model_name|default("") }}">
 </div>
 <!-- Prices -->
 <div class="md:col-span-6">
 <label class="form-label">Official Price</label>
 <input type="number"
 step="0.01"
 name="official_price"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 placeholder="à§³0.00"
 value="{{ filler.official_price|default("") }}">
 </div>
 <div class="md:col-span-6">
 <label class="form-label">Unofficial Price</label>
 <input type="number"
 step="0.01"
 name="unofficial_price"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 placeholder="à§³0.00"
 value="{{ filler.unofficial_price|default("") }}">
 </div>
 <!-- Status & Release Date -->
 <div class="md:col-span-6">
 <label class="form-label">Status</label>
 <select name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" required>
 <option value="official"
 {% if filler.status=='official' %}selected{% endif %}>Official</option>
 <option value="unofficial"
 {% if filler.status=='unofficial' %}selected{% endif %}>Unofficial</option>
 <option value="both" {% if filler.status=='both' %}selected{% endif %}>Both</option>
 </select>
 </div>
 <div class="md:col-span-4">
 <label class="form-label">Release Date</label>
 <input type="text"
 name="release_date"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 datepicker"
 required
 value="{{ filler.release_date|default('') }}"
 placeholder="DD-MM-YYYY">
 </div>
 <div class="md:col-span-2 flex items-end">
 <div class="flex items-start gap-2 form-switch mb-2">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
 type="checkbox"
 id="is_official"
 name="is_official"
 value="1"
 {% if filler.is_official|default(false) %}checked{% endif %}>
 <label class="text-sm text-slate-700" for="is_official">Is Official</label>
 </div>
 </div>
 </div>
 <!-- Specifications -->
 <h5 class="mt-4">
 <i class="lucide lucide-list-checks mr-2"></i>Specifications
 </h5>
 <div id="specs-container" class="mb-3"></div>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-100 mb-3"
 onclick="addSpec()">
 <i class="lucide lucide-plus mr-1"></i> Add Spec
 </button>
 <!-- Tags -->
 <h5 class="mt-4">
 <i class="lucide lucide-tags mr-2"></i>Tags
 </h5>
 <div class="mb-3">
 <label for="tags" class="form-label">Add labels</label>
 {% set selectedTagIds = [] %}
 {% for st in (old is defined and old and old.tags is defined ? old.tags : mobile_tags|default([])) %}
 {% if st is iterable and st.id is defined %}
 {% set selectedTagIds = selectedTagIds|merge([st.id ~ '']) %}
 {% elseif (st ~ '') matches '/^[0-9]+$/' %}
 {% set selectedTagIds = selectedTagIds|merge([st ~ '']) %}
 {% endif %}
 {% endfor %}
 <select multiple class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 blogspot-tags" id="tags" name="tags[]">
 {% for tag in tags|default([]) %}
 {% set tagId = tag.id ~ '' %}
 <option value="{{ tag.id }}" {{ tagId in selectedTagIds ? 'selected' : '' }}>{{ tag.name }}
 </option>
 {% endfor %}
 </select>  <small class="text-xs text-neutral-400 mt-1">Type to search or create new tags</small>
 </div>
 <!-- Images -->
 <h5 class="mt-4">
 <i class="lucide lucide-image mr-2"></i>Images
 </h5>
 <div class="mb-3">
 <input type="file"
 name="images[]"
 id="images-input"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 multiple
 accept="image/*">
 </div>
 <div id="images-preview" class="flex flex-wrap gap-2 mb-3"></div>
 <!-- Submit -->
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-emerald-600 text-white hover:bg-emerald-700">
 <i class="lucide lucide-check-circle mr-1"></i> Save
 </button>
 </form>
 </div>
 </div>
 </div>
 <!-- Datalist for specs -->
 <datalist id="spec_keys">
 {% for spec in specifications %}<option value="{{ spec.spec_key }}"></option>{% endfor %}
 </datalist>
 <div id="mobile-insert-data"
 data-initial-tags='{{ mobile_tags|default([]) |json_encode|e("html_attr") }}'
 style="display:none"></div>
{% endblock %}







