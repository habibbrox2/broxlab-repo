{% extends "admin/layout.twig" %}
{% block title %}{{ mobile is defined ? 'Edit Mobile' : 'Insert Mobile' }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 {% set filler = old is defined and old ? old : (mobile is defined ? mobile : {}) %}
 <div class="w-full px-4 sm:px-6 py-4">

  {# ── Gradient Page Header ── #}
  <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-emerald-900 via-teal-900 to-slate-900 p-6 text-white shadow-2xl shadow-emerald-900/20 sm:p-8">
   <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
    <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
    <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-teal-300/20 blur-3xl"></div>
   </div>
   <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3">
     <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
      <i class="lucide lucide-{{ mobile is defined ? 'pencil' : 'plus-circle' }} text-xl"></i>
     </div>
     <div>
      <h1 class="text-xl font-black tracking-tight sm:text-2xl">{{ mobile is defined ? 'Edit Mobile' : 'Insert Mobile' }}</h1>
      <p class="mt-1 text-sm text-emerald-200/80">{{ mobile is defined ? 'Update device specifications and details' : 'Add a new mobile device to the inventory' }}</p>
     </div>
    </div>
    <a href="/admin/mobiles/all" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97] self-start sm:self-auto">
     <i class="lucide lucide-arrow-left" style="width:0.875em;height:0.875em;"></i> Back to List
    </a>
   </div>
  </div>

  {# ── Form Card ── #}
  <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
   <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-emerald-50/50 to-teal-50/50 px-5 py-4">
    <div class="flex h-7 w-7 items-center justify-center rounded-md bg-emerald-100 text-emerald-600">
     <i class="lucide lucide-smartphone" style="width:0.875em;height:0.875em;"></i>
    </div>
    <div>
     <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">{{ mobile is defined ? 'Edit Device' : 'New Device' }}</h2>
     <p class="text-xs text-slate-500">Basic information and pricing</p>
    </div>
   </div>
   <div class="p-5 sm:p-6">
    <form method="post" enctype="multipart/form-data" id="mobileForm" class="space-y-6">
     {% if mobile is defined %}<input type="hidden" name="id" value="{{ mobile.id }}">{% endif %}

     <!-- Basic Information Grid -->
     <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <!-- Brand -->
      <div class="space-y-1.5">
       <label class="block text-sm font-semibold text-slate-700">Brand <span class="text-red-500">*</span></label>
       <input type="text" name="brand_name" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm bg-white text-slate-900 transition-all duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 hover:border-slate-400" placeholder="e.g., Samsung" required value="{{ filler.brand_name|default('') }}">
      </div>
      <!-- Model -->
      <div class="space-y-1.5">
       <label class="block text-sm font-semibold text-slate-700">Model <span class="text-red-500">*</span></label>
       <input type="text" name="model_name" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm bg-white text-slate-900 transition-all duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 hover:border-slate-400" placeholder="e.g., Galaxy S24" required value="{{ filler.model_name|default('') }}">
      </div>
     </div>

     <!-- Prices Grid -->
     <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div class="space-y-1.5">
       <label class="block text-sm font-semibold text-slate-700">Official Price</label>
       <div class="flex items-center rounded-lg border border-slate-300 overflow-hidden focus-within:ring-2 focus-within:ring-indigo-500/20 focus-within:border-indigo-500 bg-white transition-all duration-200">
        <span class="shrink-0 flex items-center px-3 py-2.5 bg-slate-50 border-r border-slate-300 text-slate-500 text-xs font-semibold">৳</span>
        <input type="number" step="0.01" min="0" name="official_price" class="w-full border-0 px-3 py-2.5 text-sm focus:outline-none bg-white" placeholder="0.00" value="{{ filler.official_price|default('') }}">
       </div>
      </div>
      <div class="space-y-1.5">
       <label class="block text-sm font-semibold text-slate-700">Unofficial Price</label>
       <div class="flex items-center rounded-lg border border-slate-300 overflow-hidden focus-within:ring-2 focus-within:ring-indigo-500/20 focus-within:border-indigo-500 bg-white transition-all duration-200">
        <span class="shrink-0 flex items-center px-3 py-2.5 bg-slate-50 border-r border-slate-300 text-slate-500 text-xs font-semibold">৳</span>
        <input type="number" step="0.01" min="0" name="unofficial_price" class="w-full border-0 px-3 py-2.5 text-sm focus:outline-none bg-white" placeholder="0.00" value="{{ filler.unofficial_price|default('') }}">
       </div>
      </div>
     </div>

     <!-- Status & Release Date Grid -->
     <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      <div class="space-y-1.5">
       <label class="block text-sm font-semibold text-slate-700">Status <span class="text-red-500">*</span></label>
       <select name="status" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm bg-white text-slate-900 transition-all duration-200 ease-out appearance-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" required>
        <option value="official" {{ filler.status == 'official' ? 'selected' : '' }}>Official</option>
        <option value="unofficial" {{ filler.status == 'unofficial' ? 'selected' : '' }}>Unofficial</option>
        <option value="both" {{ filler.status == 'both' ? 'selected' : '' }}>Both</option>
       </select>
      </div>
      <div class="space-y-1.5">
       <label class="block text-sm font-semibold text-slate-700">Release Date <span class="text-red-500">*</span></label>
       <input type="text" name="release_date" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm bg-white text-slate-900 transition-all duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 hover:border-slate-400 datepicker" required value="{{ filler.release_date|default('') }}" placeholder="DD-MM-YYYY">
      </div>
      <div class="flex items-end pb-1">
       <label class="flex items-center gap-3 cursor-pointer group">
        <input type="checkbox" id="is_official" name="is_official" value="1" class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" {{ filler.is_official|default(false) ? 'checked' : '' }}>
        <span class="text-sm font-medium text-slate-700 group-hover:text-slate-900 transition-colors">Is Official</span>
       </label>
      </div>
     </div>

     <!-- Specifications Section -->
     <div class="rounded-xl border border-slate-200 bg-slate-50/50 overflow-hidden">
      <div class="flex items-center gap-2 border-b border-slate-200 px-5 py-3 bg-gradient-to-r from-slate-50/50 to-slate-100/50">
       <i class="lucide lucide-list-checks text-indigo-500" style="width:1.125em;height:1.125em;"></i>
       <span class="text-sm font-bold text-slate-900">Specifications</span>
      </div>
      <div class="p-5 space-y-3">
       <div id="specs-container" class="space-y-2"></div>
       <button type="button" onclick="addSpec()" class="inline-flex items-center gap-1.5 rounded-lg border border-dashed border-slate-300 px-4 py-2 text-xs font-semibold text-slate-600 hover:border-indigo-400 hover:text-indigo-600 hover:bg-indigo-50 transition-all">
        <i class="lucide lucide-plus" style="width:0.875em;height:0.875em;"></i> Add Specification
       </button>
      </div>
     </div>

     <!-- Tags Section -->
     <div class="rounded-xl border border-slate-200 bg-slate-50/50 overflow-hidden">
      <div class="flex items-center gap-2 border-b border-slate-200 px-5 py-3 bg-gradient-to-r from-slate-50/50 to-slate-100/50">
       <i class="lucide lucide-tags text-indigo-500" style="width:1.125em;height:1.125em;"></i>
       <span class="text-sm font-bold text-slate-900">Tags</span>
      </div>
      <div class="p-5 space-y-2">
       <label for="tags" class="block text-sm font-semibold text-slate-700">Add labels</label>
       {% set selectedTagIds = [] %}
       {% for st in (old is defined and old and old.tags is defined ? old.tags : mobile_tags|default([])) %}
        {% if st is iterable and st.id is defined %}
         {% set selectedTagIds = selectedTagIds|merge([st.id ~ '']) %}
        {% elseif (st ~ '') matches '/^[0-9]+$/' %}
         {% set selectedTagIds = selectedTagIds|merge([st ~ '']) %}
        {% endif %}
       {% endfor %}
       <select multiple class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 blogspot-tags" id="tags" name="tags[]">
        {% for tag in tags|default([]) %}
         {% set tagId = tag.id ~ '' %}
         <option value="{{ tag.id }}" {{ tagId in selectedTagIds ? 'selected' : '' }}>{{ tag.name }}</option>
        {% endfor %}
       </select>
       <p class="text-xs text-slate-500">Type to search or create new tags</p>
      </div>
     </div>

     <!-- Images Section -->
     <div class="rounded-xl border border-slate-200 bg-slate-50/50 overflow-hidden">
      <div class="flex items-center gap-2 border-b border-slate-200 px-5 py-3 bg-gradient-to-r from-slate-50/50 to-slate-100/50">
       <i class="lucide lucide-image text-indigo-500" style="width:1.125em;height:1.125em;"></i>
       <span class="text-sm font-bold text-slate-900">Images</span>
      </div>
      <div class="p-5 space-y-3">
       <label for="images-input" class="block text-sm font-semibold text-slate-700">Upload Images</label>
       <input type="file" name="images[]" id="images-input" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 transition-all" multiple accept="image/*">
       <p class="text-xs text-slate-500">Accepted formats: JPG, PNG, WebP, GIF</p>
       <div id="images-preview" class="flex flex-wrap gap-2"></div>
      </div>
     </div>

     <!-- Submit Button -->
     <div class="flex gap-3 pt-2">
      <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 ease-out hover:bg-emerald-700 hover:shadow-md active:scale-95">
       <i class="lucide lucide-check-circle" style="width:1em;height:1em;"></i> Save Mobile
      </button>
      <a href="/admin/mobiles/all" class="inline-flex items-center justify-center gap-2 rounded-lg bg-white border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-900 transition-all duration-200 ease-out hover:bg-slate-50 hover:border-slate-400 active:scale-95">
       <i class="lucide lucide-x" style="width:1em;height:1em;"></i> Cancel
      </a>
     </div>
    </form>
   </div>
  </div>
 </div>

 <!-- Datalist for specs -->
 <datalist id="spec_keys">
  {% for spec in specifications %}<option value="{{ spec.spec_key }}"></option>{% endfor %}
 </datalist>
 <div id="mobile-insert-data" data-initial-tags='{{ mobile_tags|default([]) |json_encode|e("html_attr") }}' style="display:none"></div>
{% endblock %}
