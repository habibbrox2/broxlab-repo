{% extends 'admin/layout.twig' %}
{% block title %}{{ mobile.brand_name }} {{ mobile.model_name }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <!-- Page Header -->
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-smartphone mr-2"></i>
 Device Details
 </div>
 <div>Mobile device information</div>
 </div>
 <!-- Mobile Header -->
 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class=" border-slate-200 px-4 py-3 flex justify-between items-center">
 <h4 class="mb-0">
 <i class="lucide lucide-smartphone mr-2"></i>{{ mobile.brand_name }} {{ mobile.model_name }}
 </h4>
 <div class="flex gap-2">
 <a href="/admin/mobiles/update?id={{ mobile.id }}"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 px-3 py-1.5 text-xs">
 <i class="lucide lucide-pencil mr-1"></i> Edit
 </a>
 <a href="/admin/mobiles/delete?id={{ mobile.id }}"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 px-3 py-1.5 text-xs">
 <i class="lucide lucide-trash-2 mr-1"></i> Delete
 </a>
 <a href="/admin/mobiles/all" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-white text-slate-900 border border-slate-300 hover:bg-slate-100 px-3 py-1.5 text-xs">
 <i class="lucide lucide-arrow-left-circle mr-1"></i> Back
 </a>
 </div>
 </div>
 <div class="p-4">
 <p>
 <strong><i class="lucide lucide-calendar mr-1"></i>Release Date:</strong> {{ mobile.release_date }}
 </p>
 <p>
 <strong><i class="lucide lucide-toggle-right mr-1"></i>Status:</strong> {{ mobile.status }}
 </p>
 <p>
 <strong><i class="lucide lucide-dollar-sign mr-1"></i>Official Price:</strong> {{ mobile.official_price | currency }}
 <br>
 <strong><i class="lucide lucide-dollar-sign mr-1"></i>Unofficial Price:</strong> {{ mobile.unofficial_price | currency }}
 </p>
 </div>
 </div>
 <!-- Specifications -->
 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class=" border-slate-200 px-4 py-3">
 <h5 class="mb-0">
 <i class="lucide lucide-list mr-2"></i>Specifications
 </h5>
 </div>
 <div class="p-4">
 <ul class="list-group list-group-flush">
 {% for spec in specifications %}
 <li class="list-group-item">
 <strong>{{ spec.spec_key }}:</strong> {{ spec.spec_value }}
 </li>
 {% else %}
 <li class="list-group-item text-slate-500 text-center">No specifications available.</li>
 {% endfor %}
 </ul>
 </div>
 </div>
 <!-- Images Gallery -->
 {% if images is defined and images|length > 0 %}
 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class=" border-slate-200 px-4 py-3">
 <h5 class="mb-0">
 <i class="lucide lucide-image mr-2"></i>Images
 </h5>
 </div>
 <div class="p-4 flex flex-wrap gap-3">
 {% for image in images %}
 <div class=" border border-slate-200 bg-white shadow-sm">
 <img src="{{ image.image_url }}"
 alt="{{ mobile.brand_name }} {{ mobile.model_name }}"
 class="max-w-full h-auto">
 </div>
 {% endfor %}
 </div>
 </div>
 {% endif %}
 </div>
{% endblock %}



