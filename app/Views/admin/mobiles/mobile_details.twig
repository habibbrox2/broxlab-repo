{% extends 'admin/layout.twig' %}
{% block title %}{{ mobile.brand_name }} {{ mobile.model_name }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4">

 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-emerald-900 via-teal-900 to-slate-900 p-6 text-white shadow-2xl shadow-emerald-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-teal-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-smartphone text-xl"></i>
    </div>
    <div>
     <h1 class="text-xl font-black tracking-tight sm:text-2xl">{{ mobile.brand_name }} {{ mobile.model_name }}</h1>
     <p class="mt-1 text-sm text-emerald-200/80">Device details and specifications</p>
    </div>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/mobiles/update?id={{ mobile.id }}" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-pencil" style="width:0.875em;height:0.875em;"></i> Edit
    </a>
    <a href="/admin/mobiles/delete?id={{ mobile.id }}" class="inline-flex items-center gap-1.5 rounded-xl bg-red-500/20 px-4 py-2 text-xs font-semibold text-red-200 shadow-sm backdrop-blur transition-all duration-200 hover:bg-red-500/30 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-trash-2" style="width:0.875em;height:0.875em;"></i> Delete
    </a>
    <a href="/admin/mobiles/all" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-arrow-left" style="width:0.875em;height:0.875em;"></i> Back
    </a>
   </div>
  </div>
 </div>

 <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  {# ── Device Info Card ── #}
  <div class="lg:col-span-2 space-y-6">
   <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-emerald-50/50 to-teal-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-emerald-100 text-emerald-600">
      <i class="lucide lucide-info" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Device Information</h2>
      <p class="text-xs text-slate-500">Basic details and pricing</p>
     </div>
    </div>
    <div class="p-5">
     <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="space-y-1">
       <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Release Date</dt>
       <dd class="text-sm font-medium text-slate-900 flex items-center gap-1.5"><i class="lucide lucide-calendar text-slate-400" style="width:0.875em;height:0.875em;"></i> {{ mobile.release_date }}</dd>
      </div>
      <div class="space-y-1">
       <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Status</dt>
       <dd>
        {% if mobile.status == 'official' %}
         <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700"><i class="lucide lucide-check-circle mr-1" style="width:0.75em;height:0.75em;"></i> Official</span>
        {% elseif mobile.status == 'unofficial' %}
         <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700"><i class="lucide lucide-alert-circle mr-1" style="width:0.75em;height:0.75em;"></i> Unofficial</span>
        {% else %}
         <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">Both</span>
        {% endif %}
       </dd>
      </div>
      <div class="space-y-1">
       <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Official Price</dt>
       <dd class="text-sm font-medium text-slate-900 flex items-center gap-1.5"><i class="lucide lucide-dollar-sign text-slate-400" style="width:0.875em;height:0.875em;"></i> {{ mobile.official_price|default('N/A') }}</dd>
      </div>
      <div class="space-y-1">
       <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Unofficial Price</dt>
       <dd class="text-sm font-medium text-slate-900 flex items-center gap-1.5"><i class="lucide lucide-dollar-sign text-slate-400" style="width:0.875em;height:0.875em;"></i> {{ mobile.unofficial_price|default('N/A') }}</dd>
      </div>
     </dl>
    </div>
   </section>

   {# ── Specifications Card ── #}
   <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
      <i class="lucide lucide-list" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Specifications</h2>
      <p class="text-xs text-slate-500">{{ specifications|length }} specification(s)</p>
     </div>
    </div>
    <div class="p-0">
     {% if specifications|length > 0 %}
     <div class="divide-y divide-slate-100">
      {% for spec in specifications %}
      <div class="flex items-center justify-between px-5 py-3 text-sm transition-colors hover:bg-slate-50">
       <span class="font-semibold text-slate-700">{{ spec.spec_key }}</span>
       <span class="text-slate-600 ml-4 text-right">{{ spec.spec_value }}</span>
      </div>
      {% endfor %}
     </div>
     {% else %}
     <div class="flex flex-col items-center justify-center py-10 text-slate-400">
      <i class="lucide lucide-list-checks mb-2" style="width:2em;height:2em;"></i>
      <p class="text-sm">No specifications available.</p>
     </div>
     {% endif %}
    </div>
   </section>
  </div>

  {# ── Sidebar Column ── #}
  <div class="space-y-6">
   {# ── Images Card ── #}
   <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-sky-50/50 to-cyan-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-sky-100 text-sky-600">
      <i class="lucide lucide-image" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Images</h2>
      <p class="text-xs text-slate-500">{{ images|default([])|length }} image(s)</p>
     </div>
    </div>
    <div class="p-5">
     {% if images is defined and images|length > 0 %}
     <div class="grid grid-cols-2 gap-3">
      {% for image in images %}
      <div class="overflow-hidden rounded-lg border border-slate-200 shadow-sm">
       <img src="{{ image.image_url }}" alt="{{ mobile.brand_name }} {{ mobile.model_name }}" class="w-full h-32 object-cover">
      </div>
      {% endfor %}
     </div>
     {% else %}
     <div class="flex flex-col items-center justify-center py-6 text-slate-400">
      <i class="lucide lucide-image mb-2" style="width:2em;height:2em;"></i>
      <p class="text-sm">No images available.</p>
     </div>
     {% endif %}
    </div>
   </section>

   {# ── Quick Actions Card ── #}
   <section class="scroll-fade-in overflow-hidden rounded-xl border border-emerald-200 bg-gradient-to-br from-emerald-50/50 to-emerald-100/50 shadow-sm">
    <div class="p-5 space-y-3">
     <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
      <i class="lucide lucide-zap text-emerald-600" style="width:1em;height:1em;"></i>
      Quick Actions
     </h3>
     <a href="/admin/mobiles/update?id={{ mobile.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 w-full px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-indigo-700 hover:shadow-md active:scale-95">
      <i class="lucide lucide-pencil" style="width:1em;height:1em;"></i> Edit Device
     </a>
     <a href="/admin/mobiles/insert" class="inline-flex items-center justify-center gap-2 rounded-lg bg-white border border-slate-300 w-full px-4 py-2.5 text-sm font-semibold text-slate-900 transition-all duration-200 hover:bg-slate-50 hover:border-slate-400 active:scale-95">
      <i class="lucide lucide-plus-circle" style="width:1em;height:1em;"></i> Add New Device
     </a>
    </div>
   </section>
  </div>
 </div>
</div>
{% endblock %}
