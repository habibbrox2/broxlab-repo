{% extends"admin/layout.twig" %}
{% block title %}{{ mobile is defined ? 'Edit Mobile' : 'Insert Mobile' }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 flex items-center justify-between">
 <h4 class="mb-0">
 <i class="lucide lucide-pencil mr-2"></i>{{ mobile is defined ? 'Edit Mobile' : 'Insert Mobile' }}
 </h4>
 <a href="/admin/mobiles/all" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200 px-3 py-1.5 text-xs"><i class="lucide lucide-arrow-left mr-1"></i> Back to List</a>
 </div>
 <div class="p-4">
 <form method="post"
 action="/admin/mobiles/update/{{ mobile.id }}"
 enctype="multipart/form-data"
 id="mobileForm">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <input type="hidden" name="mobile_id" value="{{ mobile.id }}">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 <!-- Brand & Model -->
 <div class="md:col-span-6">
 <label class="form-label">
 Brand <span class="text-red-600">*</span>
 </label>
 <input type="text"
 name="brand_name"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 required
 value="{{ mobile.brand_name|default("") }}">
 </div>
 <div class="md:col-span-6">
 <label class="form-label">
 Model <span class="text-red-600">*</span>
 </label>
 <input type="text"
 name="model_name"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 required
 value="{{ mobile.model_name|default("") }}">
 </div>
 <!-- Prices -->
 <div class="md:col-span-6">
 <label class="form-label">Official Price</label>
 <div class="input-group">
 <span class="inline-flex items-center">?</span>
 <input type="number"
 step="0.01"
 min="0"
 name="official_price"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 value="{{ mobile.official_price|default("") }}"
 placeholder="0.00">
 </div>
 </div>
 <div class="md:col-span-6">
 <label class="form-label">Unofficial Price</label>
 <div class="input-group">
 <span class="inline-flex items-center">?</span>
 <input type="number"
 step="0.01"
 min="0"
 name="unofficial_price"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 value="{{ mobile.unofficial_price|default("") }}"
 placeholder="0.00">
 </div>
 </div>
 <!-- Status & Release Date -->
 <div class="md:col-span-6">
 <label class="form-label">
 Status <span class="text-red-600">*</span>
 </label>
 <select name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" required>
 <option value="">-- Select Status --</option>
 <option value="official" {{ mobile.status == 'official' ? 'selected' : '' }}>Official
 </option>
 <option value="unofficial"
 {{ mobile.status == 'unofficial' ? 'selected' : '' }}>Unofficial
 </option>
 <option value="both" {{ mobile.status == 'both' ? 'selected' : '' }}>Both
 </option>
 </select>
 </div>
 <div class="md:col-span-4">
 <label class="form-label">
 Release Date <span class="text-red-600">*</span>
 </label>
 <input type="date"
 name="release_date"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 required
 value="{{ mobile.release_date ? mobile.release_date|date("Y-m-d") : '' }}">
 </div>
 <div class="md:col-span-2 flex items-end">
 <div class="flex items-start gap-2 form-switch mb-2">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
 type="checkbox"
 id="is_official"
 name="is_official"
 value="1"
 {{ mobile.is_official == 1 ? 'checked' : '' }}>
 <label class="text-sm text-slate-700" for="is_official">Is Official</label>
 </div>
 </div>
 </div>
 <!-- Specifications -->
 <h5 class="mt-4">
 <i class="lucide lucide-list-checks mr-2"></i>Specifications
 </h5>
 <div id="specs-container" class="mb-3">
 {% if mobile_specs|length > 0 %}
 {% for spec in mobile_specs %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-2 mb-2 spec-grid items-center">
 <div class="md:col-span-5">
 <input list="spec_keys"
 name="specifications[key][]"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 spec-input"
 placeholder="Select or type key"
 value="{{ spec.spec_key|default("") }}">
 </div>
 <div class="md:col-span-6">
 <input type="text"
 name="specifications[value][]"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 placeholder="Value"
 value="{{ spec.spec_value|default("") }}">
 </div>
 <div class="md:col-span-1">
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-red-600 text-white hover:bg-red-700 px-3 py-1.5 text-xs remove-spec"
 title="Remove">
 <i class="lucide lucide-x"></i>
 </button>
 </div>
 </div>
 {% endfor %}
 {% else %}
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-2 mb-2 spec-grid items-center">
 <div class="md:col-span-5">
 <input list="spec_keys"
 name="specifications[key][]"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 spec-input"
 placeholder="Select or type key">
 </div>
 <div class="md:col-span-6">
 <input type="text"
 name="specifications[value][]"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 placeholder="Value">
 </div>
 <div class="md:col-span-1">
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-red-600 text-white hover:bg-red-700 px-3 py-1.5 text-xs remove-spec"
 title="Remove">
 <i class="lucide lucide-x"></i>
 </button>
 </div>
 </div>
 {% endif %}
 </div>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-100 mb-3"
 id="addSpecBtn">
 <i class="lucide lucide-plus mr-1"></i> Add Specification
 </button>
 <!-- Tags -->
 <h5 class="mt-4">
 <i class="lucide lucide-tags mr-2"></i>Tags
 </h5>
 <div class="mb-3">
 <label for="tags" class="form-label">Add labels</label>
 {% set selectedTagIds = [] %}
 {% for st in mobile_tags|default([]) %}
 {% if st is iterable and st.id is defined %}
 {% set selectedTagIds = selectedTagIds|merge([st.id ~ '']) %}
 {% elseif (st ~ '') matches '/^[0-9]+$/' %}
 {% set selectedTagIds = selectedTagIds|merge([st ~ '']) %}
 {% endif %}
 {% endfor %}
 <select multiple class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 blogspot-tags" id="tags" name="tags[]">
 {% for tag in tags|default([]) %}
 {% set tagId = tag.id ~ '' %}
 <option value="{{ tag.id }}" {{ tagId in selectedTagIds ? 'selected' : '' }}>{{ tag.name }}
 </option>
 {% endfor %}
 </select>  <small class="text-xs text-neutral-400 mt-1">Type to search or create new tags</small>
 </div>
 <!-- Images -->
 <h5 class="mt-4">
 <i class="lucide lucide-image mr-2"></i>Images
 </h5>
 <div class="mb-3">
 <label for="images-input" class="form-label">Upload New Images</label>
 <input type="file"
 name="images[]"
 id="images-input"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 multiple
 accept="image/jpeg,image/png,image/webp,image/gif">  <small class="text-xs text-neutral-400">Accepted formats: JPG, PNG, WebP, GIF (Max 5MB each)</small>
 </div>
 <!-- Existing Images -->
 {% if mobile_images|length > 0 %}<h6 class="mb-2">Existing Images</h6>{% endif %}
 <div id="existing-images-container" class="flex flex-wrap gap-2 mb-3">
 {% for img in mobile_images %}
 <div class="relative image-container-100"
 data-id="{{ img.id }}"
 data-existing="true">
 <img src="{{ img.image_url }}"
 class="img-thumbnail image-thumbnail-full"
 alt="Mobile image">
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs bg-red-600 text-white hover:bg-red-700 position-absolute top-0 end-0 remove-existing-image"
 data-image-id="{{ img.id }}"
 title="Delete image">
 <i class="lucide lucide-x"></i>
 </button>
 <input type="hidden"
 name="delete_image_ids[]"
 value=""
 data-delete-input="{{ img.id }}">
 </div>
 {% endfor %}
 </div>
 <!-- New Images Preview -->
 <div id="new-images-preview" class="flex flex-wrap gap-2 mb-3"></div>
 <div class="flex gap-2">
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-emerald-600 text-white hover:bg-emerald-700">
 <i class="lucide lucide-check-circle mr-1"></i> Save Changes
 </button>
 <a href="/admin/mobiles/view?id={{ mobile.id }}"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200"><i class="lucide lucide-eye mr-1"></i> View Mobile</a>
 </div>
 </form>
 </div>
 </div>
 </div>
 <!-- Datalist for specifications autocomplete -->
 <datalist id="spec_keys">
 {% for spec in specifications %}<option value="{{ spec.spec_key }}"></option>{% endfor %}
 </datalist>
 <div id="mobile-edit-data"
 data-selected-tag-ids='{{ mobile_tags|map(t => t.id ~"") |json_encode|e("html_attr") }}'
 class="hidden"></div>
{% endblock %}
{% block scripts %}{% endblock %}







