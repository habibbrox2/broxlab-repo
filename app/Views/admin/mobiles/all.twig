{% extends 'admin/layout.twig' %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block title %}All Mobiles - Admin{% endblock %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <!-- Page Header -->
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-smartphone mr-2"></i>
 Mobile Devices
 </div>
 <div>Manage mobile devices</div>
 </div>
 <div class="flex justify-between items-center mb-4">
 <div>
 <h1 class="h3 mb-0">All Mobiles</h1>
 <small class="text-slate-500">Full list of mobiles</small>
 </div>
 <div class="flex gap-2 items-center">
 <a href="/admin/mobiles/insert" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs bg-emerald-600 text-white hover:bg-emerald-700">
 <i class="lucide lucide-plus-circle mr-1"></i> Add Mobile
 </a>
 <form method="get" class="flex gap-2 items-center">
 <input type="search"
 name="search"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 focus:border-indigo-500-sm"
 placeholder="Search by brand or model"
 value="{{ search|default("") }}">
 <select name="per_page" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 focus:border-indigo-500-sm">
 {% set cur_per = pagination.per_page|default(50) %}
 {% for opt in [10,25,50,100] %}
 <option value="{{ opt }}" {{ cur_per == opt ? 'selected' : '' }}>{{ opt }} per page
 </option>
 {% endfor %}
 </select>
 <select name="sort" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 focus:border-indigo-500-sm">
 {% set cur_sort = sort|default('brand_name') %}
 <option value="brand_name" {{ cur_sort == 'brand_name' ? 'selected' : '' }}>Brand
 </option>
 <option value="model_name" {{ cur_sort == 'model_name' ? 'selected' : '' }}>Model
 </option>
 <option value="release_date"
 {{ cur_sort == 'release_date' ? 'selected' : '' }}>Release Date
 </option>
 <option value="created_at" {{ cur_sort == 'created_at' ? 'selected' : '' }}>Created
 </option>
 </select>
 <select name="order" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 focus:border-indigo-500-sm">
 {% set cur_order = order|default('ASC') %}
 <option value="ASC" {{ cur_order == 'ASC' ? 'selected' : '' }}>Asc
 </option>
 <option value="DESC" {{ cur_order == 'DESC' ? 'selected' : '' }}>Desc
 </option>
 </select>
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs bg-indigo-600 text-white hover:bg-indigo-700">Apply</button>
 </form>
 </div>
 </div>
 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class="p-4 p-0">
 <div class="overflow-x-auto">
 <table class="table table-stacked table-hover align-middle mb-0">
 <thead class="table-light">
 <tr>
 <th>#</th>
 <th>Brand</th>
 <th>Model</th>
 <th>Status</th>
 <th>Release Date</th>
 <th class="text-center">Images</th>
 <th class="text-right">Actions</th>
 </tr>
 </thead>
 <tbody>
 {% if mobiles is not empty %}
 {% for m in mobiles %}
 <tr>
 <td data-label="#">ID</td>
 <td data-label="Brand">{{ m.brand_name }}</td>
 <td data-label="Model">{{ m.model_name }}</td>
 <td data-label="Status">
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-{% if m.status == 'official' %}primary{% elseif 'unofficial' %}warning{% else %}secondary{% endif %}">{{ m.status|capitalize }}</span>
 </td>
 <td data-label="Release Date">{{ m.release_date ? m.release_date|date("M d, Y") : 'N/A' }}</td>
 <td class="text-center" data-label="Images">{{ m.image_count|default(0) }}</td>
 <td class="text-right" data-label="Actions">
 <a href="/admin/mobiles/view/{{ m.id }}"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs inline-flex text-slate-600 hover:bg-slate-100"
 title="View"><i class="lucide lucide-eye"></i></a>
 <a href="/admin/mobiles/update/{{ m.id }}"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs inline-flex text-indigo-600 hover:bg-indigo-100"
 title="Edit"><i class="lucide lucide-pencil"></i></a>
 <a href="/admin/mobiles/delete?id={{ m.id }}"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs inline-flex text-red-600 hover:bg-red-100"
 title="Delete"><i class="lucide lucide-trash-2"></i></a>
 </td>
 </tr>
 {% endfor %}
 {% else %}
 <tr>
 <td colspan="7" class="text-center text-slate-500 py-4">No mobiles found.</td>
 </tr>
 {% endif %}
 </tbody>
 </table>
 </div>
 </div>
 </div>
 {# Pagination #}
 {% set current = pagination.current_page|default(1) %}
 {% set total = pagination.total_pages|default(1) %}
 {% if total > 1 %}
 <nav aria-label="Page navigation" class="mt-3">
 <ul class="pagination justify-center">
 <li class="page-item {{ current <= 1 ? 'disabled' }}">
 <a class="page-link"
 href="?page={{ current - 1 }}&per_page={{ pagination.per_page|default(50) }}&search={{ search|url_encode }}&sort={{ sort|default("brand_name") }}&order={{ order|default("ASC") }}"
 aria-label="Previous">
 <span aria-hidden="true">&laquo;</span>
 </a>
 </li>
 {% for p in 1..total %}
 <li class="page-item {{ current == p ? 'active' }}">
 <a class="page-link"
 href="?page={{ p }}&per_page={{ pagination.per_page|default(50) }}&search={{ search|url_encode }}&sort={{ sort|default("brand_name") }}&order={{ order|default("ASC") }}">{{ p }}</a>
 </li>
 {% endfor %}
 <li class="page-item {{ current >= total ? 'disabled' }}">
 <a class="page-link"
 href="?page={{ current + 1 }}&per_page={{ pagination.per_page|default(50) }}&search={{ search|url_encode }}&sort={{ sort|default("brand_name") }}&order={{ order|default("ASC") }}"
 aria-label="Next">
 <span aria-hidden="true">&raquo;</span>
 </a>
 </li>
 </ul>
 </nav>
 {% endif %}
 </div>
{% endblock %}






