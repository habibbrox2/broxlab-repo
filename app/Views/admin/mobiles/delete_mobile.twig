{% extends 'admin/layout.twig' %}
{% block title %}Delete Mobile{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4">

 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-red-900 via-rose-900 to-slate-900 p-6 text-white shadow-2xl shadow-red-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-red-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-trash-2 text-xl"></i>
    </div>
    <div>
     <h1 class="text-xl font-black tracking-tight sm:text-2xl">Delete Mobile</h1>
     <p class="mt-1 text-sm text-red-200/80">Permanently remove this device from the inventory</p>
    </div>
   </div>
   <a href="/admin/mobiles/all" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97] self-start sm:self-auto">
    <i class="lucide lucide-arrow-left" style="width:0.875em;height:0.875em;"></i> Cancel
   </a>
  </div>
 </div>

 {# ── Warning Alert ── #}
 <div class="scroll-fade-in mb-6 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-5 text-sm shadow-sm" role="alert">
  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600">
   <i class="lucide lucide-alert-triangle" style="width:1em;height:1em;"></i>
  </div>
  <div class="flex-1">
   <strong class="text-sm font-bold text-red-800">Warning!</strong>
   <p class="mt-1 text-sm text-red-700">This action cannot be undone. All associated data (images, specifications, tags, comments) will be permanently deleted.</p>
  </div>
 </div>

 {# ── Device Details Card ── #}
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-red-200/80 bg-white shadow-sm transition-shadow hover:shadow-md mb-6">
  <div class="flex items-center gap-2.5 border-b border-red-100 bg-gradient-to-r from-rose-50/50 to-red-50/50 px-5 py-4">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-red-100 text-red-600">
    <i class="lucide lucide-smartphone" style="width:0.875em;height:0.875em;"></i>
   </div>
   <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Device to Delete</h2>
    <p class="text-xs text-slate-500">Review the details before confirming</p>
   </div>
  </div>
  <div class="p-5">
   <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div class="space-y-1">
     <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Brand</dt>
     <dd class="text-sm font-bold text-slate-900">{{ mobile.brand_name }}</dd>
    </div>
    <div class="space-y-1">
     <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Model</dt>
     <dd class="text-sm font-bold text-slate-900">{{ mobile.model_name }}</dd>
    </div>
    <div class="space-y-1">
     <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Status</dt>
     <dd>
      {% if mobile.status == 'official' %}
       <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">Official</span>
      {% elseif mobile.status == 'unofficial' %}
       <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700">Unofficial</span>
      {% else %}
       <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">Both</span>
      {% endif %}
     </dd>
    </div>
    <div class="space-y-1">
     <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Release Date</dt>
     <dd class="text-sm font-medium text-slate-900">{{ mobile.release_date ? mobile.release_date|date("F d, Y") : 'N/A' }}</dd>
    </div>
    <div class="space-y-1 sm:col-span-2">
     <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Created</dt>
     <dd class="text-sm font-medium text-slate-900">{{ mobile.created_at ? mobile.created_at|date("F d, Y H:i") : 'N/A' }}</dd>
    </div>
   </dl>
  </div>
 </div>

 {# ── Confirmation Card ── #}
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-sky-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="flex items-center gap-2.5 border-b border-sky-100 bg-gradient-to-r from-sky-50/50 to-cyan-50/50 px-5 py-4">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-sky-100 text-sky-600">
    <i class="lucide lucide-info" style="width:0.875em;height:0.875em;"></i>
   </div>
   <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Confirm Deletion</h2>
    <p class="text-xs text-slate-500">Confirm that you want to permanently delete this device</p>
   </div>
  </div>
  <div class="p-5 space-y-4">
   <div class="flex items-start gap-3 rounded-lg bg-sky-50 p-4 border border-sky-100">
    <i class="lucide lucide-info text-sky-600 mt-0.5" style="width:1em;height:1em;"></i>
    <p class="text-sm text-sky-800"><strong>Are you absolutely sure?</strong> This will delete this mobile device and all its associated data permanently.</p>
   </div>
   <form method="post" id="deleteForm" class="space-y-4">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label class="flex items-start gap-3 cursor-pointer group">
     <input type="checkbox" id="confirmDelete" required class="mt-1 h-4 w-4 rounded border-slate-300 text-red-600 focus:ring-red-500 cursor-pointer">
     <span class="text-sm text-slate-700 group-hover:text-slate-900 transition-colors">I confirm that I want to permanently delete this mobile and all associated data</span>
    </label>
    <div class="flex flex-wrap gap-3">
     <button type="submit" id="deleteBtn" disabled class="inline-flex items-center justify-center gap-2 rounded-lg bg-red-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 ease-out hover:bg-red-700 hover:shadow-md active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-red-600 disabled:hover:shadow-none disabled:active:scale-100">
      <i class="lucide lucide-trash-2" style="width:1em;height:1em;"></i> Delete Permanently
     </button>
     <a href="/admin/mobiles/all" class="inline-flex items-center justify-center gap-2 rounded-lg bg-white border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-900 transition-all duration-200 ease-out hover:bg-slate-50 hover:border-slate-400 active:scale-95">
      <i class="lucide lucide-arrow-left" style="width:1em;height:1em;"></i> Cancel
     </a>
    </div>
   </form>
  </div>
 </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
 var confirmCheckbox = document.getElementById('confirmDelete');
 var deleteBtn = document.getElementById('deleteBtn');
 if (confirmCheckbox && deleteBtn) {
  confirmCheckbox.addEventListener('change', function () {
   deleteBtn.disabled = !this.checked;
  });
 }
});
</script>
{% endblock %}
