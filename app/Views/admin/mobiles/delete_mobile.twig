{% extends 'admin/layout.twig' %}
{% block title %}Delete Mobile{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 flex items-center justify-between">
 <h4 class="mb-0">
 <i class="lucide lucide-trash-2 text-red-600 mr-2"></i>Delete Mobile
 </h4>
 <a href="/admin/mobiles/all" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200 px-3 py-1.5 text-xs"><i class="lucide lucide-arrow-left mr-1"></i> Cancel</a>
 </div>
 <div class="p-4">
 <div class="p-4 rounded-lg bg-red-600-light text-red-600-dark border border-danger" role="alert">
 <i class="lucide lucide-alert-triangle mr-2"></i>
 <strong>Warning!</strong> This action cannot be undone. All associated data (images, specifications, tags, comments) will be permanently deleted.
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition"
 data-brox-dismiss="alert"
 aria-label="Close"></button>
 </div>
 <div class=" border border-slate-200 bg-white shadow-sm border-danger mb-4">
 <div class="p-4">
 <h5 class="rounded-xl border border-slate-200 bg-white ">Mobile Details</h5>
 <table class="table mb-0">
 <tbody>
 <tr>
 <th>Brand</th>
 <td>
 <strong>{{ mobile.brand_name }}</strong>
 </td>
 </tr>
 <tr>
 <th>Model</th>
 <td>
 <strong>{{ mobile.model_name }}</strong>
 </td>
 </tr>
 <tr>
 <th>Status</th>
 <td>
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-{% if mobile.status == 'official' %}primary{% elseif 'unofficial' %}warning{% else %}secondary{% endif %}">
 {{ mobile.status|capitalize }}
 </span>
 </td>
 </tr>
 <tr>
 <th>Release Date</th>
 <td>{{ mobile.release_date ? mobile.release_date|date("F d, Y") : 'N/A' }}</td>
 </tr>
 <tr>
 <th>Created</th>
 <td>{{ mobile.created_at ? mobile.created_at|date("F d, Y H:i") : 'N/A' }}</td>
 </tr>
 </tbody>
 </table>
 </div>
 </div>
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200">
 <i class="lucide lucide-info mr-2"></i>
 <strong>Are you absolutely sure?</strong> This will delete this mobile device and all its associated data permanently.
 </div>
 <form method="post" id="deleteForm">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <div class="flex items-start gap-2 mb-3">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" id="confirmDelete" required>
 <label class="text-sm text-slate-700" for="confirmDelete">
 I confirm that I want to permanently delete this mobile and all associated data
 </label>
 </div>
 <div class="flex gap-2">
 <button type="submit"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-red-600 text-white hover:bg-red-700"
 id="deleteBtn"
 disabled>
 <i class="lucide lucide-trash-2 mr-1"></i> Delete Permanently
 </button>
 <a href="/admin/mobiles/all" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200">
 <i class="lucide lucide-arrow-left mr-1"></i> Cancel
 </a>
 </div>
 </form>
 </div>
 </div>
 </div>
{% endblock %}




