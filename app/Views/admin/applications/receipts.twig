{% extends"admin/layout.twig" %}
{% set skip_auto_breadcrumb = true %}
{% block title %}Service Application Receipts - Admin Panel{% endblock %}
{% block content %}
<div class="space-y-6">
 <section class="admin-page-header">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-receipt"></i>
     Service Receipts
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Service Application Receipts</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600">Paid and submitted application receipts with payment details.</p>
   </div>
  </div>
 </section>

 <section class="admin-panel-card">
  <form method="GET" class="grid grid-cols-1 gap-4 md:grid-cols-12" role="search">
   <div class="lg:col-span-4 md:col-span-6">
    <label class="form-label">Search</label>
    <input type="text" name="q" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" placeholder="Transaction ID, user, email, service or app ID" value="{{ filters.q|default('') }}">
   </div>
   <div class="lg:col-span-2 md:col-span-3">
    <label class="form-label">From</label>
    <input type="date" name="date_from" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" value="{{ filters.date_from|default('') }}">
   </div>
   <div class="lg:col-span-2 md:col-span-3">
    <label class="form-label">To</label>
    <input type="date" name="date_to" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" value="{{ filters.date_to|default('') }}">
   </div>
   <div class="lg:col-span-2 md:col-span-4">
    <label class="form-label">Payment Status</label>
    <select name="payment_status" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
     <option value="">All</option>
     <option value="paid" {% if filters.payment_status|default('') == 'paid' %}selected{% endif %}>Paid</option>
     <option value="submitted" {% if filters.payment_status|default('') == 'submitted' %}selected{% endif %}>Submitted</option>
     <option value="initiated" {% if filters.payment_status|default('') == 'initiated' %}selected{% endif %}>Initiated</option>
     <option value="pending" {% if filters.payment_status|default('') == 'pending' %}selected{% endif %}>Pending</option>
     <option value="failed" {% if filters.payment_status|default('') == 'failed' %}selected{% endif %}>Failed</option>
    </select>
   </div>
   <div class="lg:col-span-2 md:col-span-8 flex gap-2">
    <button class="inline-flex flex-grow items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" type="submit">
     <i class="lucide lucide-search"></i> Search
    </button>
    <a href="/admin/applications/receipts" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Reset</a>
   </div>
  </form>
 </section>

 <div class="flex items-center justify-between gap-3">
  <small class="text-slate-500">Total: {{ total|default(0) }}</small>
  <div>
   {% set export_params = [] %}
   {% if filters.q is defined and filters.q %}{% set export_params = export_params|merge([('q=' ~ (filters.q|url_encode))]) %}{% endif %}
   {% if filters.date_from is defined and filters.date_from %}{% set export_params = export_params|merge([('date_from=' ~ (filters.date_from|url_encode))]) %}{% endif %}
   {% if filters.date_to is defined and filters.date_to %}{% set export_params = export_params|merge([('date_to=' ~ (filters.date_to|url_encode))]) %}{% endif %}
   {% if filters.payment_status is defined and filters.payment_status %}{% set export_params = export_params|merge([('payment_status=' ~ (filters.payment_status|url_encode))]) %}{% endif %}
   {% set export_query = export_params|join('&') %}
   <a href="/admin/applications/receipts/export/csv{% if export_query %}?{{ export_query }}{% endif %}" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
    <i class="lucide lucide-download"></i> Export CSV
   </a>
  </div>
 </div>

 {% set return_params = [] %}
 {% if filters.q is defined and filters.q %}{% set return_params = return_params|merge([('q=' ~ (filters.q|url_encode))]) %}{% endif %}
 {% if filters.date_from is defined and filters.date_from %}{% set return_params = return_params|merge([('date_from=' ~ (filters.date_from|url_encode))]) %}{% endif %}
 {% if filters.date_to is defined and filters.date_to %}{% set return_params = return_params|merge([('date_to=' ~ (filters.date_to|url_encode))]) %}{% endif %}
 {% if filters.payment_status is defined and filters.payment_status %}{% set return_params = return_params|merge([('payment_status=' ~ (filters.payment_status|url_encode))]) %}{% endif %}
 {% if page is defined and page > 1 %}{% set return_params = return_params|merge([('page=' ~ page)]) %}{% endif %}
 {% set return_query = return_params|join('&') %}
 {% set return_to = '/admin/applications/receipts' ~ (return_query ? '?' ~ return_query : '') %}

 <section class="admin-panel-card">
  <div class="overflow-x-auto">
   <table class="table">
    <thead>
     <tr>
      <th>ID</th>
      <th>Transaction</th>
      <th>User</th>
      <th>Service</th>
      <th>Amount</th>
      <th>Status</th>
      <th>Submitted</th>
      <th>Actions</th>
     </tr>
    </thead>
    <tbody>
     {% for app in applications %}
     <tr>
      {% set p = app.application_data._payment ?? app.application_data['_payment'] ?? app.application_data._Payment ?? app.application_data['_Payment'] ?? app.application_data.payment ?? app.application_data['payment'] ?? app.application_data.Payment ?? app.application_data['Payment'] ?? app.application_data.payment_info ?? app.application_data['payment_info'] ?? null %}
      {% set tx_id = app.payment_transaction_id ?? p.transaction_id ?? p.paymentID ?? p.payment_id ?? '' %}
      {% set gateway_name = app.payment_gateway ?? app.payment_method ?? p.gateway ?? p.method ?? '' %}
      {% set payment_mode = (app.payment_mode ?? p.mode ?? '')|lower %}
      {% set payment_amount = app.payment_amount ?? (p.amount ?? null) %}
      {% set payment_currency = app.payment_currency ?? (p.currency ?? 'BDT') %}
      {% set payment_status = (app.payment_status ?? p.status ?? app.status ?? 'unknown')|lower %}
      <td data-label="ID"><strong>#{{ app.id }}</strong></td>
      <td data-label="Transaction">
       {% if tx_id %}
       <div><strong>{{ tx_id }}</strong></div>
       <small class="text-slate-500">{{ gateway_name|default('')|upper }}</small>
       {% else %}
       <span class="text-slate-500">-</span>
       {% endif %}
      </td>
      <td data-label="User">{{ app.user_name }}<br><small class="text-slate-500">{{ app.user_email }}</small></td>
      <td data-label="Service"><strong>{{ app.service_name }}</strong></td>
      <td data-label="Amount">{% if payment_amount is not same as(null) and payment_amount is not same as('') %}{{ payment_amount }} {{ payment_currency }}{% else %}-{% endif %}</td>
      <td data-label="Status">
       {% if payment_status in ['paid', 'completed', 'success', 'succeeded'] %}
       <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700">{{ payment_status|title }}</span>
       {% elseif payment_status in ['submitted', 'pending', 'initiated', 'processing'] %}
       <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700">{{ payment_status|title }}</span>
       {% elseif payment_status in ['failed', 'cancelled', 'canceled', 'rejected'] %}
       <span class="inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-xs font-semibold text-rose-700">{{ payment_status|title }}</span>
       {% else %}
       <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">{{ payment_status|title }}</span>
       {% endif %}
      </td>
      <td data-label="Submitted"><small>{{ app.created_at|date("M d, Y H:i") }}</small></td>
      <td data-label="Actions">
       <div class="flex flex-wrap gap-1.5">
        <a href="/admin/applications/{{ app.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" title="View Application"><i class="lucide lucide-eye"></i></a>
        <a href="/admin/services/details/{{ app.service_id }}" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" title="View Service"><i class="lucide lucide-external-link"></i></a>
        <a href="/admin/applications/receipts/{{ app.id }}/download" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" title="Preview PDF Receipt" aria-label="Preview PDF Receipt"><i class="lucide lucide-file-text"></i></a>
        <a href="/admin/applications/receipts/{{ app.id }}/download?output=download" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" title="Download PDF Receipt" aria-label="Download PDF Receipt"><i class="lucide lucide-download"></i></a>
       </div>
       {% if payment_mode == 'manual' and payment_status in ['submitted', 'pending', 'pending_gateway', 'initiated', 'processing', 'unknown'] %}
       <form method="POST" action="/admin/applications/receipts/{{ app.id }}/confirm" class="mt-2">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="return_to" value="{{ return_to }}">
        <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-indigo-700">
         <i class="lucide lucide-check-circle"></i> Confirm Manual
        </button>
       </form>
       {% endif %}
       <form method="POST" action="/admin/applications/receipts/{{ app.id }}/void" class="mt-2">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="return_to" value="{{ return_to }}">
        <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50">
         <i class="lucide lucide-x-circle"></i> Mark Void
        </button>
       </form>
      </td>
     </tr>
     {% else %}
     <tr>
      <td colspan="8" class="py-8 text-center text-slate-500">No receipt records found.</td>
     </tr>
     {% endfor %}
    </tbody>
   </table>
  </div>
 </section>
</div>
{% endblock %}
