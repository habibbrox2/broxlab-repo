{% extends "admin/layout.twig" %}
{% set skip_auto_breadcrumb = true %}
{% block title %}Service Applications - Admin Panel{% endblock %}
{% block content %}
<div class="px-4 sm:px-6 lg:px-8 py-5 space-y-5">

 {# ── Page Header Banner ── #}
 <div class="relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-900 text-white shadow-xl shadow-slate-900/20">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.25),transparent_55%)]" aria-hidden="true"></div>
  <div class="relative px-6 py-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-4">
    <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center flex-shrink-0">
     <i class="lucide lucide-briefcase w-5 h-5 text-white"></i>
    </div>
    <div>
     <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-1">Service Management</p>
     <h1 class="text-xl font-bold text-white">Service Applications</h1>
     <p class="text-sm text-white/60 mt-0.5 max-w-md">Review, filter, and approve submissions from one place.</p>
    </div>
   </div>
   <div class="flex gap-2">
    <a href="/admin/applications/export/csv" class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
     <i class="lucide lucide-download w-4 h-4"></i> Export CSV
    </a>
   </div>
  </div>
 </div>

 {# ── Stat Cards ── #}
 <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm p-5 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
   <div class="flex items-start justify-between gap-3">
    <div>
     <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-600 mb-1">Total</p>
     <p class="text-2xl font-bold text-slate-900 dark:text-white tabular-nums">{{ stats.total }}</p>
    </div>
    <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
     <i class="lucide lucide-file-text w-5 h-5 text-indigo-600 dark:text-indigo-400"></i>
    </div>
   </div>
  </div>
  <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm p-5 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
   <div class="flex items-start justify-between gap-3">
    <div>
     <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-600 mb-1">Pending</p>
     <p class="text-2xl font-bold text-slate-900 dark:text-white tabular-nums">{{ stats.pending }}</p>
    </div>
    <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-900/30 flex items-center justify-center flex-shrink-0">
     <i class="lucide lucide-hourglass w-5 h-5 text-amber-600 dark:text-amber-400"></i>
    </div>
   </div>
  </div>
  <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm p-5 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
   <div class="flex items-start justify-between gap-3">
    <div>
     <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-600 mb-1">Processing</p>
     <p class="text-2xl font-bold text-slate-900 dark:text-white tabular-nums">{{ stats.processing }}</p>
    </div>
    <div class="w-10 h-10 rounded-xl bg-sky-50 dark:bg-sky-900/30 flex items-center justify-center flex-shrink-0">
     <i class="lucide lucide-settings w-5 h-5 text-sky-600 dark:text-sky-400"></i>
    </div>
   </div>
  </div>
  <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm p-5 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200">
   <div class="flex items-start justify-between gap-3">
    <div>
     <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-600 mb-1">Approved</p>
     <p class="text-2xl font-bold text-slate-900 dark:text-white tabular-nums">{{ stats.approved }}</p>
    </div>
    <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0">
     <i class="lucide lucide-check-circle w-5 h-5 text-emerald-600 dark:text-emerald-400"></i>
    </div>
   </div>
  </div>
 </section>

 {# ── Filter Card ── #}
 <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
  <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
   <div class="w-7 h-7 rounded-lg bg-amber-50 dark:bg-amber-900/30 flex items-center justify-center flex-shrink-0">
    <i class="lucide lucide-sliders-horizontal w-4 h-4 text-amber-600 dark:text-amber-400"></i>
   </div>
   <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Filters</h3>
  </div>
  <div class="p-5">
   <form method="GET" class="flex flex-wrap items-end gap-3">
    <div class="min-w-[10rem]">
     <label for="filter-status" class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Status</label>
     <select id="filter-status" name="status" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 cursor-pointer appearance-none transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600">
      <option value="">All Statuses</option>
      <option value="pending" {% if filters.status == 'pending' %}selected{% endif %}>Pending</option>
      <option value="processing" {% if filters.status == 'processing' %}selected{% endif %}>Processing</option>
      <option value="approved" {% if filters.status == 'approved' %}selected{% endif %}>Approved</option>
      <option value="rejected" {% if filters.status == 'rejected' %}selected{% endif %}>Rejected</option>
     </select>
    </div>
    <div class="min-w-[10rem]">
     <label for="filter-from" class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">From</label>
     <input type="date" id="filter-from" name="date_from" value="{{ filters.date_from ?? '' }}" data-disable-future="true" data-week-numbers="true" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600 datepicker">
    </div>
    <div class="min-w-[10rem]">
     <label for="filter-to" class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">To</label>
     <input type="date" id="filter-to" name="date_to" value="{{ filters.date_to ?? '' }}" data-disable-future="true" data-week-numbers="true" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600 datepicker">
    </div>
    <div class="flex items-center gap-2">
     <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm shadow-indigo-500/20 hover:shadow-md hover:shadow-indigo-500/25 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
      <i class="lucide lucide-filter w-4 h-4"></i> Filter
     </button>
     <a href="/admin/applications" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
      <i class="lucide lucide-refresh-cw w-4 h-4"></i> Reset
     </a>
    </div>
   </form>
  </div>
 </div>

 {# ── Table Card ── #}
 <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
  <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
   <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
    <i class="lucide lucide-list w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
   </div>
   <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Applications</h3>
   {% if applications is not empty %}
   <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-400 ml-auto">
    {{ pagination.total|default(applications|length) }}
   </span>
   {% endif %}
  </div>
  <div class="overflow-x-auto">
   <table class="w-full text-left">
    <thead>
     <tr class="border-b border-slate-100 dark:border-slate-800">
      <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap w-16">ID</th>
      <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">User</th>
      <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Service</th>
      <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Status</th>
      <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Submitted</th>
      <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Approver</th>
      <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap text-center w-20">Actions</th>
     </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
     {% for app in applications %}
     <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors duration-100" data-id="{{ app.id }}">
      <td class="px-4 py-3">
       <span class="font-mono text-xs font-semibold text-slate-900 dark:text-white">#{{ app.id }}</span>
      </td>
      <td class="px-4 py-3">
       <div class="text-sm font-semibold text-slate-900 dark:text-white">{{ app.user_name }}</div>
       <div class="text-xs text-slate-500 dark:text-slate-400">{{ app.user_email }}</div>
      </td>
      <td class="px-4 py-3">
       <span class="text-sm text-slate-700 dark:text-slate-300 font-medium">{{ app.service_name }}</span>
      </td>
      <td class="px-4 py-3">
       {% set status_class = app.status == 'pending' ? 'bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400' : (app.status == 'processing' ? 'bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-400' : (app.status == 'approved' ? 'bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400' : 'bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-400')) %}
       <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold {{ status_class }}">
        <span class="w-1 h-1 rounded-full {{ app.status == 'pending' ? 'bg-amber-500' : (app.status == 'processing' ? 'bg-sky-500' : (app.status == 'approved' ? 'bg-emerald-500' : 'bg-red-500')) }}"></span>
        {{ app.status|title }}
       </span>
      </td>
      <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">{{ app.created_at|date("M d, Y") }}</td>
      <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">{% if app.approved_by_name %}{{ app.approved_by_name }}{% else %}—{% endif %}</td>
      <td class="px-4 py-3 text-center">
       <a href="/admin/applications/{{ app.id }}" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-950/30 transition-all duration-150" title="View">
        <i class="lucide lucide-eye w-3.5 h-3.5"></i>
       </a>
      </td>
     </tr>
     {% else %}
     <tr>
      <td colspan="7" class="px-4 py-16">
       <div class="flex flex-col items-center justify-center text-center">
        <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-4">
         <i class="lucide lucide-briefcase w-7 h-7 text-slate-400 dark:text-slate-600"></i>
        </div>
        <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-1">No Applications Found</h3>
        <p class="text-sm text-slate-400 dark:text-slate-600 mb-5 max-w-xs">Applications submitted by users will appear here.</p>
        <a href="/admin/services" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
         <i class="lucide lucide-award w-4 h-4"></i> Browse Services
        </a>
       </div>
      </td>
     </tr>
     {% endfor %}
    </tbody>
   </table>
  </div>

  {# ── Pagination ── #}
  {% if total_pages > 1 %}
  <div class="flex items-center justify-between px-5 py-3.5 border-t border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
   <span class="text-xs text-slate-400 dark:text-slate-600">Page {{ page }} of {{ total_pages }}</span>
   <div class="flex items-center gap-1">
    {% if page > 1 %}
     <a href="?page={{ page - 1 }}" class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all duration-150">
      <i class="lucide lucide-chevron-left w-3.5 h-3.5"></i>
     </a>
    {% else %}
     <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-300 dark:text-slate-600 cursor-not-allowed">
      <i class="lucide lucide-chevron-left w-3.5 h-3.5"></i>
     </span>
    {% endif %}
    <span class="px-3 py-1 text-xs font-semibold text-slate-600 dark:text-slate-400">{{ page }}</span>
    {% if page < total_pages %}
     <a href="?page={{ page + 1 }}" class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all duration-150">
      <i class="lucide lucide-chevron-right w-3.5 h-3.5"></i>
     </a>
    {% else %}
     <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-300 dark:text-slate-600 cursor-not-allowed">
      <i class="lucide lucide-chevron-right w-3.5 h-3.5"></i>
     </span>
    {% endif %}
   </div>
  </div>
  {% endif %}
 </div>
</div>
{% endblock %}
