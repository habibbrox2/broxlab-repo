{% extends "admin/layout.twig" %}
{% set skip_auto_breadcrumb = true %}
{% block title %}Application Details - Admin{% endblock %}
{% block content %}
<div class="px-4 sm:px-6 lg:px-8 py-5 space-y-6">

 {# ── Page Header Banner ── #}
 <div class="relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-900 text-white shadow-xl shadow-slate-900/20">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.25),transparent_55%)]" aria-hidden="true"></div>
  <div class="relative px-6 py-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-4">
    <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center flex-shrink-0">
     <i class="lucide lucide-file-text w-5 h-5 text-white"></i>
    </div>
    <div>
     <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-1">Application Details</p>
     <div class="flex items-center gap-3">
      <h1 class="text-xl font-bold text-white">Application #{{ application.id }}</h1>
      {% set status_bg = application.status == 'pending' ? 'bg-amber-500/20 text-amber-300' : (application.status == 'processing' ? 'bg-sky-500/20 text-sky-300' : (application.status == 'approved' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-red-500/20 text-red-300')) %}
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold {{ status_bg }} border border-white/10">
       <span class="w-1 h-1 rounded-full {{ application.status == 'pending' ? 'bg-amber-400' : (application.status == 'processing' ? 'bg-sky-400' : (application.status == 'approved' ? 'bg-emerald-400' : 'bg-red-400')) }}"></span>
       {{ application.status|upper }}
      </span>
     </div>
     <p class="text-sm text-white/60 mt-0.5 max-w-md">View application information and audit details.</p>
    </div>
   </div>
   <div class="flex gap-2">
    <a href="/admin/applications" class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
     <i class="lucide lucide-arrow-left w-4 h-4"></i> Back to Applications
    </a>
   </div>
  </div>
 </div>

 {# ── Content Grid ── #}
 <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1.25fr)_340px]">
  {# ── Main Content ── #}
  <div class="space-y-6">

   {# Application Details Card #}
   <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
    <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
     <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
      <i class="lucide lucide-info w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
     </div>
     <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Application Details</h3>
    </div>
    <div class="p-5 space-y-6">

     {# Applicant Information #}
     <div>
      <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-3">Applicant Information</h4>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
       <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 p-3.5">
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Name</p>
        <p class="text-sm font-semibold text-slate-900 dark:text-white">{{ applicant.username }}</p>
       </div>
       <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 p-3.5">
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Email</p>
        <p class="text-sm font-semibold text-slate-900 dark:text-white">{{ applicant.email }}</p>
       </div>
      </div>
     </div>

     {# Service Information #}
     <div>
      <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-3">Service Information</h4>
      <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 p-3.5">
       <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Service Name</p>
       <p class="text-sm font-semibold text-slate-900 dark:text-white">{{ application.service_name }}</p>
      </div>
     </div>

     {# Submitted Data #}
     <div>
      <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-3">Submitted Data</h4>
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
       {% for field, value in application.application_data %}
       <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 p-4">
        {% set normalized_field = field|lower %}
        {% set mapped_label = form_field_labels[field]|default(form_field_labels[normalized_field]|default('')) %}
        {% if mapped_label != '' %}
         {% set field_label = mapped_label %}
        {% else %}
         {% set field_label = normalized_field == '_documents' ? 'Documents' : (normalized_field == '_payment' ? 'Payment' : (field|replace({'_': ' ', '-': ' '})|title)) %}
        {% endif %}
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1.5">{{ field_label }}</p>
        {% if value is iterable %}
         {% if normalized_field == '_payment' %}
          {% set pay = value %}
          <div class="space-y-1 text-sm text-slate-700 dark:text-slate-300">
           <div><span class="font-semibold">Transaction:</span> {{ pay.transaction_id|default(pay.paymentID|default('N/A')) }}</div>
           <div><span class="font-semibold">Gateway:</span> {{ pay.gateway|default(pay.method|default('N/A')) }}</div>
           <div><span class="font-semibold">Status:</span> {{ pay.status|default("N/A")|title }}</div>
           <div><span class="font-semibold">Amount:</span> {% if pay.amount is defined and pay.amount is not same as('') %}{{ pay.amount }} {{ pay.currency|default("BDT") }}{% else %}N/A{% endif %}</div>
          </div>
         {% elseif normalized_field == '_documents' %}
          {% if value|length > 0 %}
           <ul class="space-y-2">
            {% for doc in value %}
             {% set doc_name = doc.name|default('Document ' ~ loop.index) %}
             <li class="flex flex-wrap items-center gap-2">
              {% if doc.url|default('') %}
               <a href="{{ doc.url }}" target="_blank" rel="noopener noreferrer" class="text-indigo-600 dark:text-indigo-400 hover:underline text-sm">{{ doc_name }}</a>
               <button type="button" class="js-doc-preview inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-2.5 py-1.5 text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150" data-doc-url="{{ doc.url|e("html_attr") }}" data-doc-name="{{ doc_name|e("html_attr") }}" data-doc-mime="{{ doc.mime_type|default("")|e('html_attr') }}">
                <i class="lucide lucide-eye w-3 h-3"></i> Preview
               </button>
              {% else %}
               {{ doc_name }}
              {% endif %}
             </li>
            {% endfor %}
           </ul>
          {% else %}
           <code class="text-xs text-slate-400">N/A</code>
          {% endif %}
         {% else %}
          <pre class="overflow-x-auto rounded-xl bg-slate-100 dark:bg-slate-800 p-2 text-xs text-slate-700 dark:text-slate-300">{{ value|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}</pre>
         {% endif %}
        {% else %}
         <code class="text-sm text-slate-700 dark:text-slate-300">{% if value is same as(null) or value is same as('') %}N/A{% elseif value is same as(true) %}Yes{% elseif value is same as(false) %}No{% else %}{{ value }}{% endif %}</code>
        {% endif %}
       </div>
       {% endfor %}
      </div>
     </div>

     {# Submission Details #}
     <div>
      <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-3">Submission Details</h4>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
       <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 p-3.5">
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Submitted</p>
        <p class="text-sm text-slate-900 dark:text-white">{{ application.created_at|date("M d, Y H:i") }}</p>
       </div>
       <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 p-3.5">
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">IP Address</p>
        <code class="text-xs text-slate-700 dark:text-slate-300">{{ application.ip_address }}</code>
       </div>
      </div>
     </div>

     {# Admin Notes #}
     {% if application.admin_notes %}
     <div class="rounded-xl border border-amber-200 dark:border-amber-800/40 bg-amber-50 dark:bg-amber-950/30 p-4">
      <div class="flex items-center gap-2 mb-2">
       <i class="lucide lucide-sticky-note w-4 h-4 text-amber-600 dark:text-amber-400"></i>
       <h4 class="text-xs font-semibold uppercase tracking-[0.14em] text-amber-800 dark:text-amber-400">Previous Admin Notes</h4>
      </div>
      <pre class="text-sm text-amber-900 dark:text-amber-200">{{ application.admin_notes }}</pre>
     </div>
     {% endif %}
    </div>
   </div>

   {# Audit Log Card #}
   {% if audit_log %}
   <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
    <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
     <div class="w-7 h-7 rounded-lg bg-amber-50 dark:bg-amber-900/30 flex items-center justify-center flex-shrink-0">
      <i class="lucide lucide-activity w-4 h-4 text-amber-600 dark:text-amber-400"></i>
     </div>
     <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Audit Log</h3>
    </div>
    <div class="overflow-x-auto">
     <table class="w-full text-left">
      <thead>
       <tr class="border-b border-slate-100 dark:border-slate-800">
        <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Date</th>
        <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Action</th>
        <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">User</th>
        <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Description</th>
       </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
       {% for log in audit_log %}
       <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors duration-100">
        <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">{{ log.created_at|date("M d, H:i") }}</td>
        <td class="px-4 py-3">
         <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">{{ log.action_type }}</span>
        </td>
        <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">{{ log.username ?? 'System' }}</td>
        <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">{{ log.description }}</td>
       </tr>
       {% endfor %}
      </tbody>
     </table>
    </div>
   </div>
   {% endif %}
  </div>

  {# ── Sidebar ── #}
  <div class="space-y-4">
   <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm xl:sticky xl:top-20">
    <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
     <div class="w-7 h-7 rounded-lg bg-sky-50 dark:bg-sky-900/30 flex items-center justify-center flex-shrink-0">
      <i class="lucide lucide-zap w-4 h-4 text-sky-600 dark:text-sky-400"></i>
     </div>
     <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Actions</h3>
    </div>
    <div class="p-5 space-y-2.5">
     {% if application.status == 'pending' or application.status == 'processing' %}
      <button onclick="approveApplication({{ application.id }})" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm shadow-indigo-500/20 hover:shadow-md hover:shadow-indigo-500/25 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
       <i class="lucide lucide-check w-4 h-4"></i> Approve
      </button>
      <button onclick="markProcessing({{ application.id }})" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
       <i class="lucide lucide-settings w-4 h-4"></i> Mark Processing
      </button>
      <button onclick="rejectApplication({{ application.id }})" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-800/40 px-4 py-2.5 text-sm font-semibold text-red-600 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-950/50 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
       <i class="lucide lucide-x w-4 h-4"></i> Reject
      </button>
     {% elseif application.status == 'approved' %}
      {% if not application.service_activated %}
       <button onclick="activateService({{ application.id }})" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm shadow-indigo-500/20 hover:shadow-md hover:shadow-indigo-500/25 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
        <i class="lucide lucide-power w-4 h-4"></i> Activate Service
       </button>
      {% else %}
       <div class="rounded-xl border border-emerald-200 dark:border-emerald-800/40 bg-emerald-50 dark:bg-emerald-950/30 px-4 py-3 text-sm text-emerald-800 dark:text-emerald-200 flex items-center gap-2">
        <i class="lucide lucide-check-circle w-4 h-4 text-emerald-600"></i> Service Activated
       </div>
      {% endif %}
     {% elseif application.status == 'rejected' %}
      <button onclick="revertStatus({{ application.id }})" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
       <i class="lucide lucide-rotate-ccw w-4 h-4"></i> Revert to Pending
      </button>
     {% endif %}
    </div>
   </div>
  </div>
 </div>
</div>
<div id="application-data" data-application-id="{{ application.id }}"></div>
{% endblock %}
