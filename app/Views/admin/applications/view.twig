{# templates/admin/applications/view.twig #}
{% extends"admin/layout.twig" %}
{% set skip_auto_breadcrumb = true %}
{% block title %}Application Details - Admin{% endblock %}
{% block content %}
<div class="space-y-6">
 <section class="admin-page-header">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-file"></i>
     Applications
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Application #{{ application.id }}</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600">View application information and audit details.</p>
   </div>
   <a href="/admin/applications" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
    <i class="lucide lucide-arrow-left"></i> Back to Applications
   </a>
  </div>
 </section>

 <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
  <div class="lg:col-span-8 space-y-4">
   <section class="admin-panel-card">
    <div class="flex items-center justify-between gap-3 border-b border-slate-200/80 pb-4">
     <h2 class="text-lg font-semibold text-slate-950">Application Details</h2>
     {% set status_colors = {"pending":"bg-amber-100 text-amber-700","processing":"bg-sky-100 text-sky-700","approved":"bg-emerald-100 text-emerald-700","rejected":"bg-rose-100 text-rose-700"} %}
     <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {{ status_colors[application.status]|default('bg-slate-100 text-slate-700') }}">{{ application.status|upper }}</span>
    </div>
    <div class="mt-4 space-y-4">
     <section>
      <h3 class="text-base font-semibold text-slate-950">Applicant Information</h3>
      <div class="mt-3 grid grid-cols-1 gap-4 md:grid-cols-2">
       <div><label class="block text-sm text-slate-500">Name</label><p class="mt-1"><strong>{{ applicant.username }}</strong></p></div>
       <div><label class="block text-sm text-slate-500">Email</label><p class="mt-1"><strong>{{ applicant.email }}</strong></p></div>
      </div>
     </section>

     <section>
      <h3 class="text-base font-semibold text-slate-950">Service Information</h3>
      <div class="mt-3"><label class="block text-sm text-slate-500">Service Name</label><p class="mt-1"><strong>{{ application.service_name }}</strong></p></div>
     </section>

     <section>
      <h3 class="text-base font-semibold text-slate-950">Submitted Data</h3>
      <div class="mt-3 grid grid-cols-1 gap-4 md:grid-cols-2">
       {% for field, value in application.application_data %}
       <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
        {% set normalized_field = field|lower %}
        {% set mapped_label = form_field_labels[field]|default(form_field_labels[normalized_field]|default('')) %}
        {% if mapped_label != '' %}
         {% set field_label = mapped_label %}
        {% else %}
         {% set field_label = normalized_field == '_documents' ? 'Documents' : (normalized_field == '_payment' ? 'Payment' : (field|replace({'_': ' ', '-': ' '})|title)) %}
        {% endif %}
        <label class="block text-sm text-slate-500">{{ field_label }}</label>
        {% if value is iterable %}
         {% if normalized_field == '_payment' %}
          {% set pay = value %}
          <div class="mt-2 space-y-1 text-sm text-slate-700">
           <div><strong>Transaction:</strong> {{ pay.transaction_id|default(pay.paymentID|default('N/A')) }}</div>
           <div><strong>Gateway:</strong> {{ pay.gateway|default(pay.method|default('N/A')) }}</div>
           <div><strong>Status:</strong> {{ pay.status|default("N/A")|title }}</div>
           <div><strong>Amount:</strong> {% if pay.amount is defined and pay.amount is not same as('') %}{{ pay.amount }} {{ pay.currency|default("BDT") }}{% else %}N/A{% endif %}</div>
          </div>
         {% elseif normalized_field == '_documents' %}
          {% if value|length > 0 %}
           <ul class="mt-2 space-y-2">
            {% for doc in value %}
             {% set doc_name = doc.name|default('Document ' ~ loop.index) %}
             <li>
              {% if doc.url|default('') %}
               <div class="flex flex-wrap items-center gap-2">
                <a href="{{ doc.url }}" target="_blank" rel="noopener noreferrer" class="text-indigo-600 hover:underline">{{ doc_name }}</a>
                <button type="button" class="js-doc-preview inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" data-doc-url="{{ doc.url|e("html_attr") }}" data-doc-name="{{ doc_name|e("html_attr") }}" data-doc-mime="{{ doc.mime_type|default("")|e('html_attr') }}">
                 <i class="lucide lucide-eye"></i> Preview
                </button>
               </div>
              {% else %}
               {{ doc_name }}
              {% endif %}
             </li>
            {% endfor %}
           </ul>
          {% else %}
           <code>N/A</code>
          {% endif %}
         {% else %}
          <pre class="mt-2 overflow-x-auto rounded-lg bg-slate-100 p-3 text-sm text-slate-700">{{ value|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}</pre>
         {% endif %}
        {% else %}
         <p class="mt-2"><code>{% if value is same as(null) or value is same as('') %}N/A{% elseif value is same as(true) %}Yes{% elseif value is same as(false) %}No{% else %}{{ value }}{% endif %}</code></p>
        {% endif %}
       </div>
       {% endfor %}
      </div>
     </section>

     <section>
      <h3 class="text-base font-semibold text-slate-950">Submission Details</h3>
      <div class="mt-3 grid grid-cols-1 gap-4 md:grid-cols-2">
       <div><label class="block text-sm text-slate-500">Submitted</label><p class="mt-1">{{ application.created_at|date("M d, Y H:i") }}</p></div>
       <div><label class="block text-sm text-slate-500">IP Address</label><p class="mt-1"><code>{{ application.ip_address }}</code></p></div>
      </div>
     </section>

     {% if application.admin_notes %}
     <section class="rounded-lg border border-slate-200 bg-slate-50 p-4">
      <h3 class="mb-2 text-base font-semibold text-slate-950">Previous Admin Notes</h3>
      <pre class="mb-0 overflow-x-auto text-sm text-slate-700">{{ application.admin_notes }}</pre>
     </section>
     {% endif %}
    </div>
   </section>

   {% if audit_log %}
   <section class="admin-panel-card">
    <h2 class="mb-4 text-lg font-semibold text-slate-950">Audit Log</h2>
    <div class="overflow-x-auto">
     <table class="table">
      <thead><tr><th>Date</th><th>Action</th><th>User</th><th>Description</th></tr></thead>
      <tbody>
       {% for log in audit_log %}
       <tr>
        <td><small>{{ log.created_at|date("M d, H:i") }}</small></td>
        <td><span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">{{ log.action_type }}</span></td>
        <td><small>{{ log.username ?? 'System' }}</small></td>
        <td><small>{{ log.description }}</small></td>
       </tr>
       {% endfor %}
      </tbody>
     </table>
    </div>
   </section>
   {% endif %}
  </div>

  <div class="lg:col-span-4">
   <section class="admin-panel-card">
    <h2 class="mb-4 text-lg font-semibold text-slate-950">Actions</h2>
    <div class="space-y-2">
     {% if application.status == 'pending' or application.status == 'processing' %}
     <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" onclick="approveApplication({{ application.id }})"><i class="lucide lucide-check"></i> Approve</button>
     <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" onclick="markProcessing({{ application.id }})"><i class="lucide lucide-settings"></i> Mark Processing</button>
     <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-700" onclick="rejectApplication({{ application.id }})"><i class="lucide lucide-x"></i> Reject</button>
     {% elseif application.status == 'approved' %}
      {% if not application.service_activated %}
      <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" onclick="activateService({{ application.id }})"><i class="lucide lucide-power"></i> Activate Service</button>
      {% else %}
      <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><i class="lucide lucide-check-circle mr-2"></i>Service Activated</div>
      {% endif %}
     {% elseif application.status == 'rejected' %}
     <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" onclick="revertStatus({{ application.id }})"><i class="lucide lucide-rotate-ccw"></i> Revert to Pending</button>
     {% endif %}
    </div>
   </section>
  </div>
 </div>
</div>
<div id="application-data" data-application-id="{{ application.id }}"></div>
{% endblock %}
