{% extends"admin/layout.twig" %}
{% set skip_auto_breadcrumb = true %}
{% block title %}Application Details - Admin{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-6">
    <!-- Gradient Header -->
    <div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-sky-500 via-indigo-500 to-violet-500 p-6 shadow-lg">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"></div>
        <div class="relative flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/20 backdrop-blur-sm">
                    <i class="lucide lucide-file text-2xl text-white"></i>
                </div>
                <div>
                    <div class="flex items-center gap-3">
                        <h1 class="text-2xl font-bold text-white sm:text-3xl">Application #{{ application.id }}</h1>
                        {% set status_colors = {"pending":"bg-amber-500","processing":"bg-sky-500","approved":"bg-emerald-500","rejected":"bg-rose-500"} %}
                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold text-white {{ status_colors[application.status]|default('bg-slate-500') }}">{{ application.status|upper }}</span>
                    </div>
                    <p class="mt-1 text-sm text-indigo-100">View application information and audit details.</p>
                </div>
            </div>
            <a href="/admin/applications" class="inline-flex items-center justify-center gap-2 rounded-lg bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/20">
                <i class="lucide lucide-arrow-left"></i> Back to Applications
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
        <!-- Main Content -->
        <div class="lg:col-span-8 space-y-6">
            <!-- Application Details Card -->
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
                    <div class="flex items-center gap-2">
                        <i class="lucide lucide-info text-indigo-500" style="width:1.125em;height:1.125em;"></i>
                        <h2 class="text-sm font-semibold text-slate-900">Application Details</h2>
                    </div>
                </div>
                <div class="p-5 space-y-6">
                    <!-- Applicant Information -->
                    <div>
                        <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Applicant Information</h3>
                        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            <div class="rounded-lg bg-slate-50 border border-slate-100 p-3">
                                <span class="block text-xs font-medium text-slate-500">Name</span>
                                <span class="mt-1 block font-semibold text-slate-900">{{ applicant.username }}</span>
                            </div>
                            <div class="rounded-lg bg-slate-50 border border-slate-100 p-3">
                                <span class="block text-xs font-medium text-slate-500">Email</span>
                                <span class="mt-1 block font-semibold text-slate-900">{{ applicant.email }}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Service Information -->
                    <div>
                        <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Service Information</h3>
                        <div class="rounded-lg bg-slate-50 border border-slate-100 p-3">
                            <span class="block text-xs font-medium text-slate-500">Service Name</span>
                            <span class="mt-1 block font-semibold text-slate-900">{{ application.service_name }}</span>
                        </div>
                    </div>

                    <!-- Submitted Data -->
                    <div>
                        <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Submitted Data</h3>
                        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                            {% for field, value in application.application_data %}
                            <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                                {% set normalized_field = field|lower %}
                                {% set mapped_label = form_field_labels[field]|default(form_field_labels[normalized_field]|default('')) %}
                                {% if mapped_label != '' %}
                                    {% set field_label = mapped_label %}
                                {% else %}
                                    {% set field_label = normalized_field == '_documents' ? 'Documents' : (normalized_field == '_payment' ? 'Payment' : (field|replace({'_': ' ', '-': ' '})|title)) %}
                                {% endif %}
                                <span class="block text-xs font-medium text-slate-500 mb-1">{{ field_label }}</span>
                                {% if value is iterable %}
                                    {% if normalized_field == '_payment' %}
                                        {% set pay = value %}
                                        <div class="space-y-1 text-sm text-slate-700">
                                            <div><strong>Transaction:</strong> {{ pay.transaction_id|default(pay.paymentID|default('N/A')) }}</div>
                                            <div><strong>Gateway:</strong> {{ pay.gateway|default(pay.method|default('N/A')) }}</div>
                                            <div><strong>Status:</strong> {{ pay.status|default("N/A")|title }}</div>
                                            <div><strong>Amount:</strong> {% if pay.amount is defined and pay.amount is not same as('') %}{{ pay.amount }} {{ pay.currency|default("BDT") }}{% else %}N/A{% endif %}</div>
                                        </div>
                                    {% elseif normalized_field == '_documents' %}
                                        {% if value|length > 0 %}
                                            <ul class="space-y-2">
                                                {% for doc in value %}
                                                    {% set doc_name = doc.name|default('Document ' ~ loop.index) %}
                                                    <li class="flex flex-wrap items-center gap-2">
                                                        {% if doc.url|default('') %}
                                                            <a href="{{ doc.url }}" target="_blank" rel="noopener noreferrer" class="text-indigo-600 hover:underline">{{ doc_name }}</a>
                                                            <button type="button" class="js-doc-preview inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" data-doc-url="{{ doc.url|e("html_attr") }}" data-doc-name="{{ doc_name|e("html_attr") }}" data-doc-mime="{{ doc.mime_type|default("")|e('html_attr') }}">
                                                                <i class="lucide lucide-eye"></i> Preview
                                                            </button>
                                                        {% else %}
                                                            {{ doc_name }}
                                                        {% endif %}
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {% else %}
                                            <code class="text-xs">N/A</code>
                                        {% endif %}
                                    {% else %}
                                        <pre class="overflow-x-auto rounded bg-slate-100 p-2 text-xs text-slate-700">{{ value|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                                    {% endif %}
                                {% else %}
                                    <code class="text-sm">{% if value is same as(null) or value is same as('') %}N/A{% elseif value is same as(true) %}Yes{% elseif value is same as(false) %}No{% else %}{{ value }}{% endif %}</code>
                                {% endif %}
                            </div>
                            {% endfor %}
                        </div>
                    </div>

                    <!-- Submission Details -->
                    <div>
                        <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Submission Details</h3>
                        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            <div class="rounded-lg bg-slate-50 border border-slate-100 p-3">
                                <span class="block text-xs font-medium text-slate-500">Submitted</span>
                                <span class="mt-1 block text-slate-900">{{ application.created_at|date("M d, Y H:i") }}</span>
                            </div>
                            <div class="rounded-lg bg-slate-50 border border-slate-100 p-3">
                                <span class="block text-xs font-medium text-slate-500">IP Address</span>
                                <code class="mt-1 block text-xs">{{ application.ip_address }}</code>
                            </div>
                        </div>
                    </div>

                    {% if application.admin_notes %}
                    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
                        <div class="flex items-center gap-2 mb-2">
                            <i class="lucide lucide-sticky-note text-amber-600" style="width:1em;height:1em;"></i>
                            <h3 class="text-xs font-semibold uppercase tracking-wider text-amber-800">Previous Admin Notes</h3>
                        </div>
                        <pre class="text-sm text-amber-900">{{ application.admin_notes }}</pre>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Audit Log Card -->
            {% if audit_log %}
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="border-b border-slate-100 bg-gradient-to-r from-amber-50/50 to-orange-50/50 px-5 py-4">
                    <div class="flex items-center gap-2">
                        <i class="lucide lucide-history text-amber-500" style="width:1.125em;height:1.125em;"></i>
                        <h2 class="text-sm font-semibold text-slate-900">Audit Log</h2>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead>
                            <tr class="border-b border-slate-100 bg-slate-50/50">
                                <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Date</th>
                                <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Action</th>
                                <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">User</th>
                                <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-slate-600">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for log in audit_log %}
                            <tr class="border-b border-slate-50 transition hover:bg-indigo-50/30">
                                <td class="px-5 py-3 text-sm text-slate-500">{{ log.created_at|date("M d, H:i") }}</td>
                                <td class="px-5 py-3"><span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">{{ log.action_type }}</span></td>
                                <td class="px-5 py-3 text-sm text-slate-600">{{ log.username ?? 'System' }}</td>
                                <td class="px-5 py-3 text-sm text-slate-600">{{ log.description }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-4 space-y-4">
            <!-- Actions Card -->
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="border-b border-slate-100 bg-gradient-to-r from-sky-50/50 to-indigo-50/50 px-5 py-4">
                    <div class="flex items-center gap-2">
                        <i class="lucide lucide-zap text-sky-500" style="width:1.125em;height:1.125em;"></i>
                        <h2 class="text-sm font-semibold text-slate-900">Actions</h2>
                    </div>
                </div>
                <div class="p-5 space-y-2">
                    {% if application.status == 'pending' or application.status == 'processing' %}
                    <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 active:scale-95" onclick="approveApplication({{ application.id }})"><i class="lucide lucide-check"></i> Approve</button>
                    <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 active:scale-95" onclick="markProcessing({{ application.id }})"><i class="lucide lucide-settings"></i> Mark Processing</button>
                    <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-rose-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-rose-700 active:scale-95" onclick="rejectApplication({{ application.id }})"><i class="lucide lucide-x"></i> Reject</button>
                    {% elseif application.status == 'approved' %}
                        {% if not application.service_activated %}
                        <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 active:scale-95" onclick="activateService({{ application.id }})"><i class="lucide lucide-power"></i> Activate Service</button>
                        {% else %}
                        <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><i class="lucide lucide-check-circle mr-2"></i>Service Activated</div>
                        {% endif %}
                    {% elseif application.status == 'rejected' %}
                    <button class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 active:scale-95" onclick="revertStatus({{ application.id }})"><i class="lucide lucide-rotate-ccw"></i> Revert to Pending</button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
<div id="application-data" data-application-id="{{ application.id }}"></div>
{% endblock %}
