{% extends"admin/layout.twig" %}

{% block title %}Failed Pipeline Logs - {{ parent() }}{% endblock %}

{% block content %}
<style>
 .failed-logs-shell {
 --failed-ink: #0f172a;
 --failed-muted: #64748b;
 --failed-line: #e2e8f0;
 --failed-soft: #f8fafc;
 --failed-accent: #dc2626;
 --failed-accent-soft: #fee2e2;
 }
 .failed-logs-shell .logs-hero {
 border: 1px solid var(--failed-line);
 border-radius: 1rem;
 background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
 padding: 1.25rem 1.35rem;
 margin-bottom: 1rem;
 }
 .failed-logs-shell .logs-hero h1 {
 font-size: 1.55rem;
 font-weight: 700;
 color: var(--failed-ink);
 margin-bottom: 0.35rem;
 }
 .failed-logs-shell .logs-hero p {
 color: var(--failed-muted);
 margin: 0;
 }
 .failed-logs-shell .card-panel {
 border: 1px solid var(--failed-line);
 border-radius: 0.9rem;
 background: #fff;
 }
 .failed-logs-shell .stat-icon {
 width: 2.6rem;
 height: 2.6rem;
 border-radius: 0.7rem;
 background: var(--failed-accent-soft);
 color: var(--failed-accent);
 display: inline-flex;
 align-items: center;
 justify-content: center;
 flex: 0 0 auto;
 }
 .failed-logs-shell .stat-value {
 font-size: 1.25rem;
 font-weight: 700;
 color: var(--failed-ink);
 line-height: 1.1;
 }
 .failed-logs-shell .stat-label {
 color: var(--failed-muted);
 font-size: 0.8rem;
 }
 .failed-logs-shell .filter-panel {
 border: 1px solid var(--failed-line);
 border-radius: 0.95rem;
 }
 .failed-logs-shell .filter-title {
 font-size: 1rem;
 font-weight: 700;
 color: var(--failed-ink);
 }
 .failed-logs-shell .log-card {
 border: 1px solid var(--failed-line);
 border-radius: 0.95rem;
 padding: 1rem;
 margin-bottom: 0.75rem;
 background: #fff;
 }
 .failed-logs-shell .log-card.selected {
 background: #fee2e2;
 border: 2px solid var(--failed-accent);
 }
 .failed-logs-shell .log-status-failed {
 color: #dc2626;
 font-weight: 700;
 }
 .failed-logs-shell .bulk-actions {
 background: #fee2e2;
 border: 1px solid var(--failed-accent);
 border-radius: 0.95rem;
 padding: 1rem;
 margin-bottom: 1rem;
 display: none;
 }
 .failed-logs-shell .bulk-actions.show {
 display: block;
 }
 .failed-logs-shell .checkbox {
 width: 20px;
 height: 20px;
 cursor: pointer;
 }
</style>

<div class="failed-logs-shell">
 <div class="logs-hero">
 <div class="flex flex-wrap justify-between items-start gap-3">
 <div>
 <h1>Failed Pipeline Logs</h1>
 <p>View and manage scraper pipeline runs that encountered errors.</p>
 </div>
 <a class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100" href="/admin/scrap-control-center">Back to Control Center</a>
 </div>
 </div>

 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3 mb-4">
 <div class="lg:col-span-3 col-span-6">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm ">
 <div class="p-4">
 <div class="flex items-center gap-2">
 <span class="stat-icon"><i class="lucide lucide-alert-triangle"></i></span>
 <div>
 <div class="stat-value">{{ total_failed_items|default(0) }}</div>
 <div class="stat-label">Failed Items</div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <div class="lg:col-span-3 col-span-6">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm card-panel">
 <div class="p-4">
 <div class="flex items-center gap-2">
 <span class="stat-icon"><i class="lucide lucide-hourglass"></i></span>
 <div>
 <div class="stat-value">{{ total_runs|default(0) }}</div>
 <div class="stat-label">Total Runs</div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <div class="lg:col-span-3 col-span-6">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm card-panel">
 <div class="p-4">
 <div class="flex items-center gap-2">
 <span class="stat-icon"><i class="lucide lucide-library"></i></span>
 <div>
 <div class="stat-value">{{ failed_runs|length|default(0) }}</div>
 <div class="stat-label">Failed Runs</div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div> <div class="rounded-xl border border-slate-200 bg-white shadow-sm card-panel mb-4">
 <div class="p-4">
 <div style="font-weight: 700; color: #0f172a; margin-bottom: 0.75rem;">Quick Navigation</div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-2">
 <div class="md:col-span-3">
 <a href="/admin/scrap-control-center/all-pipeline-logs" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-sky-600 hover:bg-sky-100 px-3 py-1.5 text-xs w-full">
 <i class="lucide lucide-file-text"></i> All Logs
 </a>
 </div>
 <div class="md:col-span-3">
 <a href="/admin/scrap-control-center/pipeline-runs" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-indigo-600 hover:bg-indigo-100 px-3 py-1.5 text-xs w-full">
 <i class="lucide lucide-play-circle"></i> Pipeline Runs
 </a>
 </div>
 <div class="md:col-span-3">
 <a href="/admin/scrap-control-center/failed-pipeline-logs" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-red-600 text-white hover:bg-red-700 px-3 py-1.5 text-xs w-full" style="pointer-events: none;">
 <i class="lucide lucide-alert-circle"></i> Failed Logs
 </a>
 </div>
 <div class="md:col-span-3">
 <a href="/admin/scrap-control-center/incoming" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition transition-ghost-success px-3 py-1.5 text-xs w-full">
 <i class="lucide lucide-inbox"></i> Incoming Items
 </a>
 </div>
 </div>
 </div>
 </div>

 <div class="rounded-xl border border-slate-200 bg-white shadow-sm filter-panel mb-4">
 <div class="p-4">
 <div class="filter-title mb-3">Filters</div>
 <form method="get" class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3 items-end">
 <div class="md:col-span-3">
 <label class="block text-sm font-medium text-slate-700 mb-1">Action</label>
 <select name="action" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
 <option value="">All Actions</option>
 <option value="run-pipeline" {{ action_filter == 'run-pipeline' ? 'selected' }}>Run Pipeline</option>
 <option value="auto-run-pipeline" {{ action_filter == 'auto-run-pipeline' ? 'selected' }}>Auto Run Pipeline</option>
 <option value="cron-run-pipeline" {{ action_filter == 'cron-run-pipeline' ? 'selected' }}>Cron Run Pipeline</option>
 <option value="publish-pending" {{ action_filter == 'publish-pending' ? 'selected' }}>Publish Pending</option>
 <option value="retry-failed" {{ action_filter == 'retry-failed' ? 'selected' }}>Retry Failed</option>
 </select>
 </div>
 <div class="md:col-span-3">
 <label class="block text-sm font-medium text-slate-700 mb-1">Date Range</label>
 <select name="range" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
 <option value="">All Time</option>
 <option value="today" {{ range_filter == 'today' ? 'selected' }}>Today</option>
 <option value="yesterday" {{ range_filter == 'yesterday' ? 'selected' }}>Yesterday</option>
 <option value="week" {{ range_filter == 'week' ? 'selected' }}>This Week</option>
 <option value="month" {{ range_filter == 'month' ? 'selected' }}>This Month</option>
 </select>
 </div>
 <div class="md:col-span-2">
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 w-full" type="submit">Apply Filters</button>
 </div>
 <div class="md:col-span-2">
 <a class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100 w-full" href="/admin/scrap-control-center/failed-pipeline-logs">Reset</a>
 </div>
 </form>
 </div>
 </div>

 {% if failed_runs|length > 0 %}
 <div class="bulk-actions" id="bulkActionsBar">
 <div class="flex flex-wrap justify-between items-center gap-3">
 <div>
 <label class="text-sm text-slate-700">
 <input type="checkbox" id="selectAllCheckbox" class="checkbox mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
 <span><span id="selectedCount">0</span> runs selected</span>
 </label>
 </div>
 <div class="flex gap-2">
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-red-600 hover:bg-red-100" id="bulkRetryBtn" disabled>
 <i class="lucide lucide-refresh-cw"></i> Retry Selected
 </button>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-red-600 hover:bg-red-100" id="bulkDeleteBtn" disabled>
 <i class="lucide lucide-trash-2"></i> Delete Selected
 </button>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-100" id="cancelBulkBtn">
 Cancel
 </button>
 </div>
 </div>
 </div>

 {% for run in failed_runs %}
 <div class="log-card" data-run-id="{{ run.id }}">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 items-start">
 <div class="md:col-span-1 flex items-center">
 <input type="checkbox" class="checkbox mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 run-checkbox" data-run-id="{{ run.id }}">
 </div>
 <div class="md:col-span-11">
 <div class="flex justify-between items-start mb-2">
 <div>
 <div class="font-bold">
 Run #{{ run.id }} - {{ run.action_name|default('Unknown Action') }}
 <span class="log-status-failed ml-2"><i class="lucide lucide-x-circle"></i> Failed</span>
 </div>
 <div class="text-slate-500 small">
 Started: {{ run.started_at|default('N/A')|date('M d, Y H:i:s') }}
 • Duration: {{ run.duration_ms|default(0) }}ms
 • Trigger: {{ run.trigger_source|default('manual') }}
 </div>
 </div>
 <a class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-indigo-600 hover:bg-indigo-100" href="/admin/scrap-control-center/pipeline-runs/{{ run.id }}">
 View Details <i class="lucide lucide-arrow-right"></i>
 </a>
 </div>
 
 {% if run.error_message %}
 <div class="p-4 rounded-lg bg-red-600-light text-red-600-dark border border-danger mb-2" style="font-size: 0.85rem;">
 <strong>Error:</strong> {{ run.error_message|slice(0, 200) }}{% if run.error_message|length > 200 %}...{% endif %}
 </div>
 {% endif %}

 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3" style="font-size: 0.85rem;">
 <div class="sm:col-span-2">
 <div class="text-slate-500">Fetched</div>
 <div class="font-bold">{{ run.fetched_count|default(0) }}</div>
 </div>
 <div class="sm:col-span-2">
 <div class="text-slate-500">Published</div>
 <div class="font-bold">{{ run.published_count|default(0) }}</div>
 </div>
 <div class="sm:col-span-2">
 <div class="text-slate-500">Failed</div>
 <div class="font-bold text-red-600">{{ run.failed_count|default(0) }}</div>
 </div>
 <div class="sm:col-span-2">
 <div class="text-slate-500">Skipped</div>
 <div class="font-bold">{{ run.skipped_duplicates|default(0) }}</div>
 </div>
 <div class="sm:col-span-4">
 <div class="text-slate-500">Scope</div>
 <div class="font-bold">{{ run.scope_type|default('all') }}</div>
 </div>
 </div>
 </div>
 </div>
 </div>
 {% endfor %}

 {% if total_pages > 1 %}
 <nav aria-label="pagination" class="mt-4">
 <ul class="pagination justify-center">
 {% if current_page_number > 1 %}
 <li class="page-item">
 <a class="page-link" href="?page={{ current_page_number - 1 }}&action={{ action_filter }}&range={{ range_filter }}">&laquo;</a>
 </li>
 {% endif %}
 {% for p in 1..total_pages %}
 {% if p == current_page_number or p == 1 or p == total_pages or (p >= current_page_number - 2 and p <= current_page_number + 2) %}
 <li class="page-item {{ p == current_page_number ? 'active' }}">
 <a class="page-link" href="?page={{ p }}&action={{ action_filter }}&range={{ range_filter }}">{{ p }}</a>
 </li>
 {% endif %}
 {% endfor %}
 {% if current_page_number < total_pages %}
 <li class="page-item">
 <a class="page-link" href="?page={{ current_page_number + 1 }}&action={{ action_filter }}&range={{ range_filter }}">&raquo;</a>
 </li>
 {% endif %}
 </ul>
 </nav>
 {% endif %}
 {% else %}
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0">
 <div class="p-4 py-5 text-center">
 <div class="text-slate-500">No failed pipeline runs found.</div>
 </div>
 </div>
 {% endif %}
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
 const bulkActionsBar = document.getElementById("bulkActionsBar");
 const selectAllCheckbox = document.getElementById("selectAllCheckbox");
 const bulkRetryBtn = document.getElementById("bulkRetryBtn");
 const bulkDeleteBtn = document.getElementById("bulkDeleteBtn");
 const cancelBulkBtn = document.getElementById("cancelBulkBtn");
 const selectedCountSpan = document.getElementById("selectedCount");
 const runCheckboxes = document.querySelectorAll(".run-checkbox");
 const logRows = document.querySelectorAll(".log-card");
 
 function updateBulkActionsBar() {
 const selectedRuns = Array.from(runCheckboxes).filter(cb => cb.checked);
 const selectedCount = selectedRuns.length;
 
 if (selectedCount > 0) {
 bulkActionsBar.classList.add("show");
 selectedCountSpan.textContent = selectedCount;
 bulkRetryBtn.disabled = false;
 bulkDeleteBtn.disabled = false;
 } else {
 bulkActionsBar.classList.remove("show");
 selectedCountSpan.textContent ="0";
 bulkRetryBtn.disabled = true;
 bulkDeleteBtn.disabled = true;
 selectAllCheckbox.checked = false;
 selectAllCheckbox.indeterminate = false;
 } logRows.forEach(row => {
  const checkbox = row.querySelector(".run-checkbox");
  if (checkbox && checkbox.checked) {
   row.classList.add("selected");
  } else {
   row.classList.remove("selected");
  }
 });
 }
 
 runCheckboxes.forEach(checkbox => {
 checkbox.addEventListener("change", function() {
 updateBulkActionsBar();
 updateSelectAllCheckbox();
 });
 });
 
 function updateSelectAllCheckbox() {
 const totalCheckboxes = runCheckboxes.length;
 const checkedCheckboxes = Array.from(runCheckboxes).filter(cb => cb.checked).length;
 
 if (checkedCheckboxes === 0) {
 selectAllCheckbox.checked = false;
 selectAllCheckbox.indeterminate = false;
 } else if (checkedCheckboxes === totalCheckboxes) {
 selectAllCheckbox.checked = true;
 selectAllCheckbox.indeterminate = false;
 } else {
 selectAllCheckbox.indeterminate = true;
 }
 }
 
 selectAllCheckbox.addEventListener("change", function() {
 runCheckboxes.forEach(checkbox => {
 checkbox.checked = this.checked;
 });
 updateBulkActionsBar();
 });
 
 bulkRetryBtn.addEventListener("click", function() {
 const selectedRuns = Array.from(runCheckboxes)
 .filter(cb => cb.checked)
 .map(cb => cb.getAttribute("data-run-id"));
 
 if (selectedRuns.length === 0) return;
 
 const runText = selectedRuns.length === 1 ?"1 run" : selectedRuns.length +" runs";
 if (!confirm(`Retry ${runText}? This will attempt to re-process the failed items.`)) {
 return;
 }
 
 bulkRetryBtn.disabled = true;
 bulkRetryBtn.innerHTML = '<i class="lucide lucide-hourglass"></i> Retrying...';
 
 Promise.all(selectedRuns.map(runId =>
 fetch(`/admin/api/scrap-control-center/pipeline-runs/${runId}/retry`, {
 method:"POST",
 headers: {"Content-Type":"application/json","X-Requested-With":"XMLHttpRequest"
 },
 body: JSON.stringify({
 _csrf: document.querySelector("meta[name=\"csrf-token\"]")?.getAttribute("content") ||""
 })
 }).then(r => r.json())
 ))
 .then(results => {
 const successCount = results.filter(r => r.ok).length;
 bulkRetryBtn.disabled = false;
 bulkRetryBtn.innerHTML = '<i class="lucide lucide-refresh-cw"></i> Retry Selected';
 showAlert(`${successCount} run(s) queued for retry`,"success");
 updateBulkActionsBar();
 })
 .catch(error => {
 bulkRetryBtn.disabled = false;
 bulkRetryBtn.innerHTML = '<i class="lucide lucide-refresh-cw"></i> Retry Selected';
 showAlert("Failed to retry runs","danger");
 console.error("Retry error:", error);
 });
 });
 
 bulkDeleteBtn.addEventListener("click", function() {
 const selectedRuns = Array.from(runCheckboxes)
 .filter(cb => cb.checked)
 .map(cb => cb.getAttribute("data-run-id"));
 
 if (selectedRuns.length === 0) return;
 
 const runText = selectedRuns.length === 1 ?"1 run" : selectedRuns.length +" runs";
 if (!confirm(`Delete ${runText}? This action cannot be undone.`)) {
 return;
 }
 
 bulkDeleteBtn.disabled = true;
 bulkDeleteBtn.innerHTML = '<i class="lucide lucide-hourglass"></i> Deleting...';
 
 let completed = 0;
 selectedRuns.forEach(runId => {
 fetch(`/admin/api/scrap-control-center/pipeline-runs/${runId}/delete`, {
 method:"POST",
 headers: {"Content-Type":"application/json","X-Requested-With":"XMLHttpRequest"
 },
 body: JSON.stringify({
 _csrf: document.querySelector("meta[name=\"csrf-token\"]")?.getAttribute("content") ||""
 })
 })
 .then(response => response.json())
 .then(data => {
 completed++;
 if (data.ok) {
 const grid = document.querySelector(`.log-card[data-run-id="${runId}"]`); if (grid) {
   grid.remove();
 }
 }
 
 if (completed === selectedRuns.length) {
 bulkDeleteBtn.disabled = false;
 bulkDeleteBtn.innerHTML = '<i class="lucide lucide-trash-2"></i> Delete Selected';
 updateBulkActionsBar();
 showAlert(`${completed} run(s) deleted`,"success");
 }
 })
 .catch(error => {
 completed++;
 if (completed === selectedRuns.length) {
 bulkDeleteBtn.disabled = false;
 bulkDeleteBtn.innerHTML = '<i class="lucide lucide-trash-2"></i> Delete Selected';
 showAlert("Failed to delete some runs","danger");
 }
 });
 });
 });
 
 cancelBulkBtn.addEventListener("click", function() {
 runCheckboxes.forEach(checkbox => {
 checkbox.checked = false;
 });
 updateBulkActionsBar();
 });
 
 function showAlert(message, type) {
 const alertDiv = document.createElement("div");
 const typeClasses = {
  success: "bg-emerald-50 border border-emerald-200 text-emerald-800",
  danger: "bg-red-50 border border-red-200 text-red-800"
 };
 alertDiv.className = `${typeClasses[type] || typeClasses.success} brox-alert-enter fixed top-5 right-5 z-[9999] min-w-[300px] rounded-xl p-4 shadow-lg flex items-center justify-between gap-3`;
 alertDiv.setAttribute("role", "alert");
 alertDiv.innerHTML = `
  <span>${message}</span>
  <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition opacity-70 hover:opacity-100" data-brox-dismiss="alert">
   <i class="lucide lucide-x" style="width:1em;height:1em;"></i>
  </button>
 `;
 document.body.appendChild(alertDiv);
 setTimeout(() => {
  if (alertDiv.parentNode) {
   alertDiv.remove();
  }
 }, 5000);
 }
});
</script>
{% endblock %}






