{% extends"admin/layout.twig" %}

{% block title %}{{ page_title }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% set current_page = current_page|default('cv-templates') %}

{% block stylesheets %}
 <style>
 .template-editor {
 min-height: 500px;
 font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
 font-size: 14px;
 line-height: 1.4;
 }
 </style>
{% endblock %}

{% block content %}
 <div class="container-app py-4 cv-admin-page">
 <div class="cv-admin-hero">
 <div>
 <div class="cv-admin-title">{{ page_title }}</div>
 <div class="cv-admin-subtitle">
 {% if mode == 'create' %}
 Create a new CV template by cloning an existing one.
 {% else %}
 Edit the template content and metadata.
 {% endif %}
 </div>
 </div>
 <div class="cv-admin-hero-actions">
 <a href="/admin/cv-templates" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition transition-outline">
 <i class="lucide lucide-arrow-left mr-1"></i> Back to Templates
 </a>
 </div>
 </div>

 {% if errors is defined and errors is not empty %}
 <div class="p-4 rounded-lg bg-red-600-light text-red-600-dark border border-danger">
 <i class="lucide lucide-alert-triangle mr-1"></i>
 <strong>Please fix the following errors:</strong>
 <ul class="mb-0 mt-2">
 {% for error in errors %}
 <li>{{ error }}</li>
 {% endfor %}
 </ul>
 </div>
 {% endif %}

 <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
 <div class="lg:col-span-8">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
 <div class="border-b border-slate-200 px-4 py-3">
 <h5 class="mb-0">Template Details</h5>
 </div>
 <div class="p-4">
 <form method="post" action="{% if mode == 'edit' %}/admin/cv-templates/{{ template_slug }}{% else %}/admin/cv-templates{% endif %}">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

 <div class="grid grid-cols-1 gap-4 md:grid-cols-2 mb-3">
 <div>
 <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Name <span class="text-red-600">*</span></label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="name"
 name="name"
 value="{{ form_data.name|default(template.name|default('')) }}"
 required>  <div class="text-xs text-neutral-400 mt-1">Display name for the template</div>
 </div>
 {% if mode == 'create' %}
 <div>
 <label for="slug" class="block text-sm font-medium text-slate-700 mb-1">Slug <span class="text-red-600">*</span></label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="slug"
 name="slug"
 value="{{ form_data.slug|default('') }}"
 pattern="[a-z0-9][a-z0-9-]*"
 maxlength="50"
 required>  <div class="text-xs text-neutral-400 mt-1">URL-friendly identifier (lowercase, alphanumeric, hyphens only)</div>
 </div>
 {% else %}
 <div>
 <label class="block text-sm font-medium text-slate-700 mb-1">Slug</label>
 <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" value="{{ template_slug }}" readonly>  <div class="text-xs text-neutral-400 mt-1">Slug cannot be changed after creation</div>
 </div>
 {% endif %}
 </div>

 <div class="mb-3">
 <label for="description" class="block text-sm font-medium text-slate-700 mb-1">Description</label>
 <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="description"
 name="description"
 rows="2"
 placeholder="Optional description of the template">{{ form_data.description|default(template.description|default('')) }}</textarea>
 </div>

 {% if mode == 'create' %}
 <div class="mb-3">
 <label for="base_template" class="block text-sm font-medium text-slate-700 mb-1">Base Template <span class="text-red-600">*</span></label>
 <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="base_template" name="base_template" required>
 <option value="">Select a template to clone...</option>
 {% for slug, baseTemplate in base_templates %}
 <option value="{{ slug }}" {% if form_data.base_template == slug %}selected{% endif %}>
 {{ baseTemplate.name }} ({{ slug }})
 </option>
 {% endfor %}
 </select>  <div class="text-xs text-neutral-400 mt-1">Choose an existing template as the starting point</div>
 </div>
 {% endif %}

 {% if mode == 'edit' %}
 <div class="mb-3">
 <label for="profession" class="block text-sm font-medium text-slate-700 mb-1">Default Profession</label>
 <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="profession" name="profession">
 <option value="">Select a profession...</option>
 <option value="software-engineer" {% if template.profession == 'software-engineer' %}selected{% endif %}>Software Engineer</option>
 <option value="product-manager" {% if template.profession == 'product-manager' %}selected{% endif %}>Product Manager</option>
 <option value="data-scientist" {% if template.profession == 'data-scientist' %}selected{% endif %}>Data Scientist</option>
 <option value="marketing-manager" {% if template.profession == 'marketing-manager' %}selected{% endif %}>Marketing Manager</option>
 <option value="sales-executive" {% if template.profession == 'sales-executive' %}selected{% endif %}>Sales Executive</option>
 <option value="hr-manager" {% if template.profession == 'hr-manager' %}selected{% endif %}>HR Manager</option>
 <option value="accountant" {% if template.profession == 'accountant' %}selected{% endif %}>Accountant</option>
 <option value="teacher" {% if template.profession == 'teacher' %}selected{% endif %}>Teacher</option>
 <option value="doctor" {% if template.profession == 'doctor' %}selected{% endif %}>Doctor</option>
 <option value="lawyer" {% if template.profession == 'lawyer' %}selected{% endif %}>Lawyer</option>
 </select>  <div class="text-xs text-neutral-400 mt-1">Optional: Set a default profession for this template's professional summary</div>
 </div>

 <div class="mb-3">
 <label for="content" class="block text-sm font-medium text-slate-700 mb-1">Template Content <span class="text-red-600">*</span></label>
 {% include 'partials/editor.twig' with {
 'editorId': 'content',
 'editorName': 'content',
 'editorClass': 'template-editor',
 'initialContent': template_content,
 'darkMode': false,
 'rtl': false,
 'minHeight': '400px',
 'autoGrow': true
 } %}  <div class="text-xs text-neutral-400 text-amber-600 mt-1">
 <i class="lucide lucide-alert-triangle"></i>
 This editor contains HTML/Twig template code. Be careful with syntax - invalid Twig code will break the template.
 </div>
 </div>
 {% endif %}

 <div class="flex gap-2">
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
 <i class="lucide lucide-check-circle mr-1"></i>
 {% if mode == 'create' %}Create Template{% else %}Save Changes{% endif %}
 </button>
 <a href="/admin/cv-templates" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition transition-outline">Cancel</a>
 </div>
 </form>
 </div>
 </div>
 </div>

 <div class="lg:col-span-4">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
 <div class="border-b border-slate-200 px-4 py-3">
 <h5 class="mb-0">Help & Tips</h5>
 </div>
 <div class="p-4">
 <h6>Template Structure</h6>
 <p class="small text-slate-500 mb-3">
 Templates use Twig syntax and receive <code>cv</code> and <code>sections</code> variables.
 See existing templates for examples.
 </p>

 <h6>Available Variables</h6>
 <ul class="small mb-3">
 <li><code>cv</code> - CV metadata (id, title, dates)</li>
 <li><code>sections</code> - Array of CV sections with items</li>
 <li><code>section.items</code> - Content items for each section</li>
 </ul>

 <h6>Best Practices</h6>
 <ul class="small mb-0">
 <li>Use semantic HTML</li>
 <li>Include proper ARIA labels</li>
 <li>Test with sample data</li>
 <li>Keep responsive design in mind</li>
 </ul>
 </div>
 </div>
 </div>
 </div>
 </div>
{% endblock %}

{% block scripts %}
 {{ parent() }}
 <script type="module" src="{{ asset('/assets/js/dist/cv-admin.js') }}"></script>
{% endblock %}






