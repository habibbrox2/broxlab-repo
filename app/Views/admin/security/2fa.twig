{% extends"admin/layout.twig" %}
{% block title %}Two-Factor Authentication - Security Settings{% endblock %}
{% block content %}
 <input type="hidden" id="global-csrf-token" value="{{ csrf_token }}">
 <div class="w-full px-4 sm:px-6 py-4">
 <!-- Page Header -->
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-shield"></i>
 Two-Factor Authentication
 </div>
 <div>Secure your account with an authenticator app</div>
 </div>
 <div id="alert-container"></div>
 {% if twofa_enabled %}
 <!-- 2FA is Enabled -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="lg:col-span-8">
 <!-- Status Card -->
 <div class=" border border-slate-200 bg-white shadow-sm bordered-success mb-4">
 <div class=" border-slate-200 px-4 py-3">
 <h6 class=" mb-0">
 <i class="lucide lucide-check-circle"></i>
 2FA Status
 </h6>
 </div>
 <div class="p-4">
 <div class="p-4 rounded-lg bg-emerald-600-light text-emerald-600-dark border border-success mb-0">
 <i class="lucide lucide-check-circle mr-2"></i>
 <strong>Two-Factor Authentication is Active</strong>
 <p class="mb-0 mt-2">Your account is protected. Every login requires a code from your authenticator app.</p>
 </div>
 </div>
 </div>
 <!-- Actions Grid -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3 mb-4">
 <!-- View Backup Codes -->
 <div class="md:col-span-6">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class="p-4 text-center p-4">
 <div>
 <i class="lucide lucide-download"></i>
 </div>
 <h6 class="mb-2">Backup Codes</h6>
 <p class="text-slate-500 small mb-3">Recovery codes for emergency access if you lose your device</p>
 <a href="/admin/security/2fa/backup-codes"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-sky-500 text-white hover:bg-sky-600 px-3 py-1.5 text-xs">
 <i class="lucide lucide-arrow-right mr-1"></i> View Codes
 </a>
 </div>
 </div>
 </div>
 <!-- Disable 2FA -->
 <div class="md:col-span-6">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class="p-4 text-center p-4">
 <div>
 <i class="lucide lucide-x-circle"></i>
 </div>
 <h6 class="mb-2">Disable 2FA</h6>
 <p class="text-slate-500 small mb-3">Remove two-factor authentication from your account</p>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-red-600 text-white hover:bg-red-700 px-3 py-1.5 text-xs"
 data-brox-toggle="modal"
 data-brox-target="#disableTwoFAModal">
 <i class="lucide lucide-trash-2 mr-1"></i> Disable
 </button>
 </div>
 </div>
 </div>
 </div>
 <!-- Information Card -->
 <div class=" border border-slate-200 bg-white shadow-sm bordered-info">
 <div class=" border-slate-200 px-4 py-3">
 <h6 class=" mb-0">
 <i class="lucide lucide-info"></i>
 About 2FA
 </h6>
 </div>
 <div class="p-4">
 <p class="mb-3">
 Two-factor authentication adds an extra layer of security by requiring a second form of verification beyond your password.
 </p>
 <h6 class="mt-4 mb-2">How it works:</h6>
 <ol class="small text-slate-500">
 <li class="mb-2">You enter your email and password</li>
 <li class="mb-2">Your authenticator app generates a 6-digit code</li>
 <li class="mb-2">You enter this code to complete login</li>
 <li>Without the code, no one can access your account</li>
 </ol>
 <h6 class="mt-4 mb-2">Supported Authenticator Apps:</h6>
 <ul class="small text-slate-500 list-none pl-0">
 <li class="mb-2">
 <i class="lucide lucide-globe mr-2 text-red-600"></i> Google Authenticator
 </li>
 <li class="mb-2">
 <i class="lucide lucide-smartphone mr-2 text-sky-600"></i> Microsoft Authenticator
 </li>
 <li class="mb-2">
 <i class="lucide lucide-key mr-2 text-emerald-600"></i> Authy
 </li>
 <li class="mb-2">
 <i class="lucide lucide-shield-check mr-2 text-amber-600"></i> 1Password
 </li>
 </ul>
 </div>
 </div>
 </div>
 <!-- Sidebar -->
 <div class="lg:col-span-4">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 ">
 <h6 class=" mb-0">
 <i class="lucide lucide-shield-check"></i>
 Security Tips
 </h6>
 </div>
 <div class="p-4">
 <div class="mb-3">
 <h6 class="mb-2 text-sm font-weight-bold">?? Keep Your Device Safe</h6>
 <p class="text-slate-500 small">Only you should have access to your authenticator app</p>
 </div>
 <hr>
 <div class="mb-3">
 <h6 class="mb-2 text-sm font-weight-bold">?? Save Backup Codes</h6>
 <p class="text-slate-500 small">Store your backup codes in a secure location</p>
 </div>
 <hr>
 <div class="mb-3">
 <h6 class="mb-2 text-sm font-weight-bold">? Check Clock Sync</h6>
 <p class="text-slate-500 small">Ensure your device time is accurate</p>
 </div>
 <hr>
 <div>
 <h6 class="mb-2 text-sm font-weight-bold">? Never Share Codes</h6>
 <p class="text-slate-500 small mb-0">Never give your 6-digit codes to anyone</p>
 </div>
 </div>
 </div>
 </div>
 </div>
 {% else %}
 <!-- 2FA is Disabled -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="lg:col-span-8">
 <!-- Setup Card -->
 <div class=" border border-slate-200 bg-white shadow-sm bordered-warning mb-4">
 <div class=" border-slate-200 px-4 py-3">
 <h6 class=" mb-0">
 <i class="lucide lucide-alert-circle"></i>
 2FA Not Enabled
 </h6>
 </div>
 <div class="p-4">
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 mb-0">
 <i class="lucide lucide-alert-triangle mr-2"></i>
 <strong>Enhance Your Security</strong>
 <p class="mb-0 mt-2">Enable two-factor authentication to add an extra layer of security to your account.</p>
 </div>
 </div>
 </div>
 <!-- Setup Steps -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3 mb-4">
 <div class="md:col-span-4">
 <div class=" border border-slate-200 bg-white shadow-sm text-center">
 <div class="p-4 p-4">
 <div class=" border border-slate-200 bg-white shadow-sm success ">
 <div>
 <i class="lucide lucide-circle"></i>
 </div>
 <h6>Download App</h6>
 <p class="text-slate-500 small">Get an authenticator app from your phone store</p>
 </div>
 </div>
 </div>
 </div>
 <div class="md:col-span-4">
 <div class=" border border-slate-200 bg-white shadow-sm text-center">
 <div class="p-4 p-4">
 <div class=" border border-slate-200 bg-white shadow-sm info ">
 <div>
 <i class="lucide lucide-circle"></i>
 </div>
 <h6>Scan QR Code</h6>
 <p class="text-slate-500 small">Scan the QR code from setup wizard</p>
 </div>
 </div>
 </div>
 </div>
 <div class="md:col-span-4">
 <div class=" border border-slate-200 bg-white shadow-sm text-center">
 <div class="p-4 p-4">
 <div class=" border border-slate-200 bg-white shadow-sm success ">
 <div>
 <i class="lucide lucide-circle"></i>
 </div>
 <h6>Verify Code</h6>
 <p class="text-slate-500 small">Enter the 6-digit code to confirm</p>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Setup Button -->
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class="p-4 text-center p-4">
 <h5 class="mb-3">Ready to Secure Your Account?</h5>
 <p class="text-slate-500 mb-4">
 The setup process only takes a few minutes. You'll scan a QR code with your authenticator app and verify with a code.
 </p>
 <a href="/admin/security/2fa/setup"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 px-5 py-3 text-base">
 <i class="lucide lucide-arrow-right mr-2"></i> Setup 2FA Now
 </a>
 </div>
 </div>
 </div>
 <!-- Sidebar -->
 <div class="lg:col-span-4">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 ">
 <h6 class=" mb-0">
 <i class="lucide lucide-help-circle"></i>
 Why Use 2FA?
 </h6>
 </div>
 <div class="p-4">
 <ul class="list-none pl-0 text-sm">
 <li class="mb-3 flex items-start gap-2">
 <span class="text-emerald-600 font-bold">?</span>
 <span class="text-slate-500">Protects against password breaches</span>
 </li>
 <li class="mb-3 flex items-start gap-2">
 <span class="text-emerald-600 font-bold">?</span>
 <span class="text-slate-500">Prevents unauthorized access</span>
 </li>
 <li class="mb-3 flex items-start gap-2">
 <span class="text-emerald-600 font-bold">?</span>
 <span class="text-slate-500">Industry standard security</span>
 </li>
 <li class="mb-3 flex items-start gap-2">
 <span class="text-emerald-600 font-bold">?</span>
 <span class="text-slate-500">Easy backup code recovery</span>
 </li>
 <li class="flex items-start gap-2">
 <span class="text-emerald-600 font-bold">?</span>
 <span class="text-slate-500">Works offline with most apps</span>
 </li>
 </ul>
 </div>
 </div>
 <div class=" border border-slate-200 bg-white shadow-sm mt-3">
 <div class=" border-slate-200 px-4 py-3">
 <h6 class=" mb-0">
 <i class="lucide lucide-alert-triangle"></i>
 Important
 </h6>
 </div>
 <div class="p-4">
 <p class="text-slate-500 small mb-0">
 After setup, you'll receive 10 backup codes. Save these in a safe location - they're your recovery option if you lose access to your authenticator app.
 </p>
 </div>
 </div>
 </div>
 </div>
 {% endif %}
 </div>
 <!-- Disable 2FA Modal -->
 <div class="modal fade"
 id="disableTwoFAModal"
 tabindex="-1"
 aria-hidden="true">
 <div class="modal-dialog">
 <div class="modal-content">
 <div class="modal-header bg-red-600">
 <h6 class="modal-title text-white">
 <i class="lucide lucide-alert-triangle mr-2"></i> Disable 2FA
 </h6>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition transition-white"
 data-brox-dismiss="modal"></button>
 </div>
 <div class="modal-body">
 <div id="disableAlert"></div>
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200">
 <i class="lucide lucide-alert-circle mr-2"></i>
 <strong>Warning:</strong> Disabling 2FA will reduce your account security. You'll only need your password to log in.
 </div>
 <form id="disableTwoFAForm">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">            <div class="mb-5">
 <label for="disablePassword" class="form-label">Confirm Your Password</label>
 <input type="password"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="disablePassword"
 name="password"
 required
 placeholder="Enter your password">
 <small class="form-text">We need your password to confirm this action</small>
 </div>
 </form>
 </div>
 <div class="modal-footer">
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200"
 data-brox-dismiss="modal">Cancel</button>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-red-600 text-white hover:bg-red-700"
 id="confirmDisableTwoFABtn">
 <i class="lucide lucide-trash-2 mr-1"></i> Disable 2FA
 </button>
 </div>
 </div>
 </div>
 </div>
{% endblock %}







