{% extends"admin/layout.twig" %}
{% block title %}Two-Factor Authentication - Security Settings{% endblock %}
{% block content %}
<input type="hidden" id="global-csrf-token" value="{{ csrf_token }}">
<div class="space-y-6">
 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 text-white shadow-2xl shadow-indigo-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-violet-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex items-center gap-3">
   <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
    <i class="lucide lucide-shield" style="width:1.5em;height:1.5em;"></i>
   </div>
   <div>
    <h1 class="text-xl font-black tracking-tight sm:text-2xl">Two-Factor Authentication</h1>
    <p class="mt-1 text-sm text-indigo-200/80">Secure your account with an authenticator app</p>
   </div>
  </div>
 </div>

 <div id="alert-container"></div>

 {% if twofa_enabled %}
  {# 2FA Active View #}
  <div class="grid grid-cols-1 gap-5 lg:grid-cols-12">
   <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md lg:col-span-8">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-emerald-50/50 to-teal-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-emerald-100 text-emerald-600">
      <i class="lucide lucide-check-circle" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">2FA Status</h2>
     </div>
    </div>
    <div class="p-5">
     <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-4 text-sm text-emerald-900">
      <div class="flex items-start gap-3">
       <i class="lucide lucide-shield-check mt-0.5" style="width:1.25em;height:1.25em;"></i>
       <div>
        <strong>Two-Factor Authentication is Active</strong>
        <p class="m-0 mt-1">Your account is protected. Every login requires a code from your authenticator app.</p>
       </div>
      </div>
     </div>
    </div>
   </div>

   <div class="space-y-5 lg:col-span-4">
    <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-sky-50/50 to-cyan-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-sky-100 text-sky-600">
      <i class="lucide lucide-download" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Backup Codes</h2>
      <p class="text-xs text-slate-500 m-0">Recovery codes for emergency access</p>
     </div>
    </div>
     <div class="p-5 text-center">
      <a href="/admin/security/2fa/backup-codes" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-indigo-700 hover:shadow-md active:scale-[0.97]">
       <i class="lucide lucide-arrow-right" style="width:1em;height:1em;"></i> View Codes
      </a>
     </div>
    </div>
    <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-rose-50/50 to-red-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-rose-100 text-rose-600">
      <i class="lucide lucide-x-circle" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Disable 2FA</h2>
      <p class="text-xs text-slate-500 m-0">Remove two-factor authentication</p>
     </div>
    </div>
     <div class="p-5 text-center">
      <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-rose-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-rose-700 hover:shadow-md active:scale-[0.97]" data-brox-toggle="modal" data-brox-target="#disableTwoFAModal">
       <i class="lucide lucide-trash-2" style="width:1em;height:1em;"></i> Disable
      </button>
     </div>
    </div>
    <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
      <i class="lucide lucide-shield-check" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Security Tips</h2>
     </div>
    </div>
     <div class="p-5 space-y-3 text-sm text-slate-600">
      <div><strong class="text-slate-900">🔒 Keep Your Device Safe</strong><br>Only you should have access to your authenticator app</div>
      <div><strong class="text-slate-900">💾 Save Backup Codes</strong><br>Store your backup codes in a secure location</div>
      <div><strong class="text-slate-900">⏰ Check Clock Sync</strong><br>Ensure your device time is accurate</div>
      <div><strong class="text-slate-900">🚫 Never Share Codes</strong><br>Never give your 6-digit codes to anyone</div>
     </div>
    </div>
   </div>
  </div>

 {% else %}
  {# 2FA Disabled - Setup View #}
  <div class="grid grid-cols-1 gap-5 lg:grid-cols-12">
   <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md lg:col-span-8">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-amber-50/50 to-orange-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-amber-100 text-amber-600">
      <i class="lucide lucide-alert-circle" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">2FA Not Enabled</h2>
     </div>
    </div>
    <div class="p-5">
     <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-4 text-sm text-amber-900">
      <div class="flex items-start gap-3">
       <i class="lucide lucide-alert-triangle mt-0.5" style="width:1.25em;height:1.25em;"></i>
       <div>
        <strong>Enhance Your Security</strong>
        <p class="m-0 mt-1">Enable two-factor authentication to add an extra layer of security to your account.</p>
       </div>
      </div>
     </div>
    </div>
   </div>
   <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md lg:col-span-8">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
      <i class="lucide lucide-help-circle" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Why Use 2FA?</h2>
     </div>
    </div>
    <div class="p-5 space-y-3 text-sm text-slate-600">
     <div class="flex items-start gap-2"><span class="text-emerald-600 font-bold">✅</span> Protects against password breaches</div>
     <div class="flex items-start gap-2"><span class="text-emerald-600 font-bold">✅</span> Prevents unauthorized access</div>
     <div class="flex items-start gap-2"><span class="text-emerald-600 font-bold">✅</span> Industry standard security</div>
     <div class="flex items-start gap-2"><span class="text-emerald-600 font-bold">✅</span> Easy backup code recovery</div>
     <div class="flex items-start gap-2"><span class="text-emerald-600 font-bold">✅</span> Works offline with most apps</div>
    </div>
   </div>
   <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md lg:col-span-8">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-emerald-50/50 to-teal-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-emerald-100 text-emerald-600">
      <i class="lucide lucide-arrow-right" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Ready to Secure Your Account?</h2>
     </div>
    </div>
    <div class="p-5 text-center">
     <p class="text-sm text-slate-500 mb-4">The setup process only takes a few minutes. You'll scan a QR code with your authenticator app and verify with a code.</p>
     <a href="/admin/security/2fa/setup" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-md transition-all duration-200 hover:bg-indigo-700 hover:shadow-lg active:scale-[0.97]">
      <i class="lucide lucide-shield-check" style="width:1.125em;height:1.125em;"></i> Setup 2FA Now
     </a>
    </div>
   </div>
  </div>
 {% endif %}
</div>

{# Disable 2FA Modal #}
<div class="modal" id="disableTwoFAModal" tabindex="-1" aria-hidden="true">
 <div class="modal-dialog">
  <div class="modal-content">
   <div class="modal-header bg-gradient-to-r from-rose-600 to-rose-500 text-white">
    <h6 class="modal-title flex items-center gap-2"><i class="lucide lucide-alert-triangle"></i> Disable 2FA</h6>
    <button type="button" class="text-white/80 hover:text-white" data-brox-dismiss="modal" aria-label="Close"><i class="lucide lucide-x"></i></button>
   </div>
   <div class="modal-body">
    <div id="disableAlert"></div>
    <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-4 text-sm text-amber-900 mb-4">
     <i class="lucide lucide-alert-circle mr-2"></i>
     <strong>Warning:</strong> Disabling 2FA will reduce your account security. You'll only need your password to log in.
    </div>
    <form id="disableTwoFAForm">
     <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
     <label for="disablePassword" class="block text-sm font-semibold text-slate-700 mb-1">Confirm Your Password</label>
     <input type="password" id="disablePassword" name="password" required placeholder="Enter your password"
      class="block w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10">
     <small class="block mt-1 text-xs text-slate-500">We need your password to confirm this action</small>
    </form>
   </div>
   <div class="modal-footer flex justify-end gap-2">
    <button type="button" class="btn-secondary" data-brox-dismiss="modal">Cancel</button>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-rose-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-rose-700" id="confirmDisableTwoFABtn">
     <i class="lucide lucide-trash-2"></i> Disable 2FA
    </button>
   </div>
  </div>
 </div>
</div>
{% endblock %}
