{% extends"admin/layout.twig" %}
{% block content %}
 <input type="hidden" id="global-csrf-token" value="{{ csrf_token }}">
 <div class="w-full px-4 sm:px-6 py-4 space-y-6">

 <!-- Gradient Page Header -->
 <div class="scroll-fade-in relative overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-600 via-indigo-700 to-violet-800 p-6 text-white shadow-2xl shadow-indigo-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-violet-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex items-center gap-3">
   <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
    <i class="lucide lucide-qr-code" style="width:1.5em;height:1.5em;"></i>
   </div>
   <div>
    <h1 class="text-xl font-black tracking-tight sm:text-2xl">Setup Two-Factor Authentication</h1>
    <p class="mt-1 text-sm text-indigo-200/80">Follow these steps to enable 2FA on your admin account</p>
   </div>
  </div>
 </div>

 <!-- Step 1 + Step 2 Row -->
 <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
  <!-- Step 1: Download App -->
  <div class="rounded-xl border border-slate-200/80 bg-white shadow-sm overflow-hidden transition-shadow hover:shadow-md">
   <div class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
    <div class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-600 text-white text-sm font-bold shadow-sm">1</div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Download Authenticator App</h2>
   </div>
   <div class="p-5">
    <div class="flex items-start gap-3 mb-3">
     <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-red-100 text-red-600">
      <i class="lucide lucide-globe" style="width:1.125em;height:1.125em;"></i>
     </div>
     <div>
      <p class="text-sm text-slate-600 mb-2">Download one of these free authenticator apps to your phone:</p>
      <ul class="space-y-1 text-sm text-slate-600">
       <li class="flex items-center gap-2"><span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold">1</span>Google Authenticator</li>
       <li class="flex items-center gap-2"><span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold">2</span>Microsoft Authenticator</li>
       <li class="flex items-center gap-2"><span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold">3</span>Authy</li>
      </ul>
     </div>
    </div>
   </div>
  </div>

  <!-- Step 2: Scan QR Code -->
  <div class="rounded-xl border border-slate-200/80 bg-white shadow-sm overflow-hidden transition-shadow hover:shadow-md">
   <div class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
    <div class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-600 text-white text-sm font-bold shadow-sm">2</div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Scan QR Code</h2>
   </div>
   <div class="p-5">
    <p class="text-sm text-slate-600 mb-4">Open your authenticator app and scan this QR code:</p>
    <div class="flex justify-center">
     {% if qr_image %}
     <div class="inline-block rounded-xl border-2 border-slate-200 bg-white p-3 shadow-sm">
      <img src="{{ qr_image }}" alt="QR Code" class="mx-auto" style="max-width:200px;height:auto;">
     </div>
     {% else %}
     <div class="rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-700">Could not generate QR code</div>
     {% endif %}
    </div>
   </div>
  </div>
 </div>

 <!-- Manual Entry Option -->
 <div class="rounded-xl border border-slate-200/80 bg-white shadow-sm overflow-hidden transition-shadow hover:shadow-md">
  <div class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-r from-sky-50/50 to-cyan-50/50 px-5 py-4">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-sky-100 text-sky-600">
    <i class="lucide lucide-keyboard" style="width:0.875em;height:0.875em;"></i>
   </div>
   <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Can't scan? Enter manually</h2>
  </div>
  <div class="p-5">
   <p class="text-sm text-slate-500 mb-3">Enter this secret key in your authenticator app:</p>
   <div class="flex items-center rounded-lg border border-slate-300 overflow-hidden focus-within:ring-2 focus-within:ring-indigo-500/20 focus-within:border-indigo-500 bg-white max-w-md">
    <input type="text"
     class="w-full border-0 px-3 py-2.5 text-sm focus:outline-none bg-white font-mono tracking-wider"
     value="{{ secret }}"
     readonly
     id="secretKey">
    <button class="shrink-0 inline-flex items-center justify-center h-10 px-4 text-sm font-semibold text-indigo-600 hover:bg-indigo-50 border-l border-slate-300 transition" onclick="copySecret(this)">
     <i class="lucide lucide-copy mr-1" style="width:1em;height:1em;"></i>
     Copy
    </button>
   </div>
  </div>
 </div>

 <!-- Step 3: Verify Code -->
 <div class="rounded-xl border border-slate-200/80 bg-white shadow-sm overflow-hidden transition-shadow hover:shadow-md max-w-lg mx-auto">
  <div class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-r from-emerald-50/50 to-teal-50/50 px-5 py-4">
   <div class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-600 text-white text-sm font-bold shadow-sm">3</div>
   <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Verify Code</h2>
  </div>
  <div class="p-5">
   <p class="text-sm text-slate-600 mb-4">Enter the 6-digit code from your authenticator app to confirm:</p>
   <form id="verifyTwoFAForm" class="space-y-4">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div>
     <input type="text"
      class="w-full rounded-lg border border-slate-300 px-4 py-3 text-lg font-mono tracking-[0.25em] text-center focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition"
      name="code"
      id="authCode"
      maxlength="6"
      placeholder="000000"
      inputmode="numeric"
      required>
     <small class="text-xs text-slate-400 block mt-2 text-center">Enter the 6-digit code (numbers only)</small>
    </div>
    <div id="verifyAlert"></div>
    <button type="button"
     class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-sm transition-all w-full hover:bg-indigo-700 hover:shadow-md active:scale-[0.97]"
     id="verifyBtn">
     <i class="lucide lucide-check mr-2" style="width:1.125em;height:1.125em;"></i>
     Verify & Enable 2FA
    </button>
    <button type="button" class="inline-flex items-center justify-center gap-2 text-sm font-medium text-slate-400 hover:text-slate-600 transition w-full" onclick="goBack()">
     <i class="lucide lucide-arrow-left" style="width:1em;height:1em;"></i>
     Cancel
    </button>
   </form>
  </div>
 </div>

 <!-- Important Notes -->
 <div class="rounded-xl border border-amber-200/60 bg-gradient-to-br from-amber-50/50 to-amber-100/50 p-5 shadow-sm">
  <div class="flex items-start gap-3">
   <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-amber-600">
    <i class="lucide lucide-alert-circle" style="width:1.125em;height:1.125em;"></i>
   </div>
   <div>
    <h6 class="text-sm font-bold text-amber-800 mb-2">Important</h6>
    <ul class="space-y-1 text-sm text-amber-700">
     <li class="flex items-start gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-400"></span>Save your backup codes in a safe place</li>
     <li class="flex items-start gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-400"></span>You'll need a code every time you log in</li>
     <li class="flex items-start gap-2"><span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-400"></span>Keep your authenticator app updated</li>
    </ul>
   </div>
  </div>
 </div>

</div>
{% endblock %}




