{% extends"admin/layout.twig" %}
{% block content %}
 <input type="hidden" id="global-csrf-token" value="{{ csrf_token }}">
 <div class="w-full px-4 sm:px-6 py-4">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="lg:col-span-8 offset-lg-2">
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3 border-primary">
 <h4 class="mb-0">
 <i class="lucide lucide-qr-code mr-2"></i> Setup Two-Factor Authentication
 </h4>
 </div>
 <div class="p-4">
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200">
 <i class="lucide lucide-info mr-2"></i>
 Follow these steps to enable two-factor authentication on your admin account
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mt-5">
 <!-- Step 1: Download App -->
 <div class="md:col-span-6 mb-5">
 <div class="step-rounded-xl border border-slate-200 bg-white shadow-sm">
 <div class="step-number">1</div>
 <h5 class="mt-4 mb-3">
 <i class="lucide lucide-globe text-red-600 mr-2"></i> Download Authenticator App
 </h5>
 <p class="text-slate-500 small">Download one of these free authenticator apps to your phone:</p>
 <ul class="small">
 <li>Google Authenticator</li>
 <li>Microsoft Authenticator</li>
 <li>Authy</li>
 </ul>
 </div>
 </div>
 <!-- Step 2: Scan QR Code -->
 <div class="md:col-span-6 mb-5">
 <div class="step-rounded-xl border border-slate-200 bg-white shadow-sm">
 <div class="step-number">2</div>
 <h5 class="mt-4 mb-3">
 <i class="lucide lucide-qr-code text-indigo-600 mr-2"></i> Scan QR Code
 </h5>
 <p class="text-slate-500 small mb-3">Open your authenticator app and scan this QR code:</p>
 <div class="text-center">
 {% if qr_image %}
 <img src="{{ qr_image }}" alt="QR Code" class="max-w-full h-auto ">
 {% else %}
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200">Could not generate QR code</div>
 {% endif %}
 </div>
 </div>
 </div>
 </div>
 <!-- Manual Entry Option -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mt-5">
 <div class="md:col-span-12 mb-5">
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200">
 <h6 class="mb-3">
 <i class="lucide lucide-keyboard mr-2"></i> Can't scan? Enter manually
 </h6>
 <p class="small mb-2">Enter this secret key in your authenticator app:</p>
 <div class="input-group">
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 value="{{ secret }}"
 readonly
 id="secretKey">
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200" onclick="copySecret(this)">
 <i class="lucide lucide-copy mr-1"></i> Copy
 </button>
 </div>
 </div>
 </div>
 </div>
 <!-- Verify Code -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mt-5">
 <div class="md:col-span-6 offset-md-3">
 <div class="step-rounded-xl border border-slate-200 bg-white shadow-sm">
 <div class="step-number">3</div>
 <h5 class="mt-4 mb-3">
 <i class="lucide lucide-check-circle text-emerald-600 mr-2"></i> Verify Code
 </h5>
 <p class="text-slate-500 small mb-4">Enter the 6-digit code from your authenticator app to confirm:</p>
 <form id="verifyTwoFAForm">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <div class="mb-3">
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 focus:border-indigo-500-lg text-center "
 name="code"
 id="authCode"
 maxlength="6"
 placeholder="000000"
 inputmode="numeric"
 required>  <small class="text-xs text-neutral-400 block mt-2">Enter the 6-digit code (numbers only)</small>
 </div>
 <div id="verifyAlert"></div>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 px-5 py-3 text-base w-full"
 id="verifyBtn">
 <i class="lucide lucide-check mr-2"></i> Verify & Enable 2FA
 </button>
 </form>
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition modern-text-indigo-600 underline hover:text-indigo-700 text-slate-500 mt-3 w-full"
 onclick="goBack()">Cancel</button>
 </div>
 </div>
 </div>
 <!-- Important Notes -->
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 mt-5">
 <h6 class="mb-3">
 <i class="lucide lucide-alert-circle mr-2"></i> Important
 </h6>
 <ul class="small mb-0">
 <li>Save your backup codes in a safe place</li>
 <li>You'll need a code every time you log in</li>
 <li>Keep your authenticator app updated</li>
 </ul>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
{% endblock %}




