{% extends"admin/layout.twig" %}
{% block title %}Backup Codes - Two-Factor Authentication{% endblock %}
{% block content %}
<div class="space-y-6">
 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-amber-600 via-amber-700 to-yellow-800 p-6 text-white shadow-2xl shadow-amber-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-yellow-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex items-center gap-3">
   <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
    <i class="lucide lucide-shield" style="width:1.5em;height:1.5em;"></i>
   </div>
   <div>
    <h1 class="text-xl font-black tracking-tight sm:text-2xl">Backup Codes</h1>
    <p class="mt-1 text-sm text-amber-200/80">Save your recovery codes for emergency access</p>
   </div>
  </div>
 </div>

 {# Warning Alert #}
 <div class="scroll-fade-in rounded-lg border border-rose-200 bg-rose-50 px-5 py-4 text-sm text-rose-900 shadow-sm" role="alert">
  <div class="flex items-start gap-3">
   <i class="lucide lucide-alert-triangle mt-0.5" style="width:1.25em;height:1.25em;"></i>
   <div>
    <strong class="block mb-1">Important!</strong>
    <p class="m-0">These codes will only be displayed once. Save them in a secure location immediately. You'll need these codes if you lose access to your authenticator app.</p>
   </div>
  </div>
 </div>

 {# Backup Codes Card #}
 <div class="scroll-fade-in overflow-hidden rounded-xl border-2 border-amber-200/60 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="flex items-center gap-2.5 border-b border-amber-100 bg-gradient-to-r from-amber-50/50 to-orange-50/50 px-5 py-4">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-amber-100 text-amber-600">
    <i class="lucide lucide-file-text" style="width:0.875em;height:0.875em;"></i>
   </div>
   <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Your Backup Codes</h2>
    <p class="text-xs text-slate-500 m-0">Each code can be used only once for authentication</p>
   </div>
  </div>
  <div class="p-5">
   <div class="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
    {% for code in backup_codes %}
    <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-center">
     <code class="font-mono text-sm font-bold tracking-wider text-slate-900">{{ code }}</code>
    </div>
    {% endfor %}
   </div>
   <div class="flex flex-wrap gap-2">
    <button type="button" onclick="copyAllBackupCodes(this)" class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2.5 text-xs font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 hover:-translate-y-0.5">
     <i class="lucide lucide-files" style="width:0.875em;height:0.875em;"></i> Copy All Codes
    </button>
    <button type="button" onclick="window.print()" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-slate-600 shadow-sm transition-all hover:bg-slate-50 hover:-translate-y-0.5">
     <i class="lucide lucide-printer" style="width:0.875em;height:0.875em;"></i> Print Codes
    </button>
   </div>
  </div>
 </div>

 {# Storage Tips #}
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-sky-50/50 to-cyan-50/50 px-5 py-4">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-sky-100 text-sky-600">
    <i class="lucide lucide-lock" style="width:0.875em;height:0.875em;"></i>
   </div>
   <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Safe Storage Recommendations</h2>
   </div>
  </div>
  <div class="p-5">
   <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm">
     <strong class="text-emerald-700">✓ Good</strong>
     <ul class="m-0 mt-1 space-y-0.5 text-xs text-slate-600 ps-3">
      <li>Password-protected encrypted file</li>
      <li>Printed and stored securely</li>
      <li>Password manager</li>
     </ul>
    </div>
    <div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm">
     <strong class="text-rose-700">✗ Avoid</strong>
     <ul class="m-0 mt-1 space-y-0.5 text-xs text-slate-600 ps-3">
      <li>Plain text files</li>
      <li>Cloud storage (unencrypted)</li>
      <li>Sharing via email</li>
     </ul>
    </div>
   </div>
  </div>
 </div>

 {# How to Use #}
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-emerald-50/50 to-teal-50/50 px-5 py-4">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-emerald-100 text-emerald-600">
    <i class="lucide lucide-help-circle" style="width:0.875em;height:0.875em;"></i>
   </div>
   <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">How to Use These Codes</h2>
   </div>
  </div>
  <div class="p-5">
   <p class="text-sm text-slate-600 mb-3">If you lose access to your authenticator app:</p>
   <ol class="text-sm text-slate-600 space-y-1.5">
    <li>Go to the login page</li>
    <li>Enter your email and password</li>
    <li>When asked for a 2FA code, use one of your backup codes instead</li>
    <li>After logging in, set up a new authenticator</li>
    <li>Generate new backup codes</li>
   </ol>
   <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
    <strong><i class="lucide lucide-alert-circle"></i> Remember:</strong> Each backup code can only be used once!
   </div>
  </div>
 </div>

 {# Back Button #}
 <div class="flex items-center justify-between gap-3">
  <a href="/admin/security/2fa" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-slate-600 shadow-sm transition-all hover:bg-slate-50 hover:-translate-y-0.5">
   <i class="lucide lucide-arrow-left" style="width:0.875em;height:0.875em;"></i> Back to 2FA Settings
  </a>
  <button type="button" data-brox-toggle="modal" data-brox-target="#regenerateModal" class="inline-flex items-center gap-1.5 rounded-lg bg-amber-500 px-4 py-2.5 text-xs font-semibold text-black shadow-sm transition-all hover:bg-amber-600 hover:-translate-y-0.5">
   <i class="lucide lucide-repeat" style="width:0.875em;height:0.875em;"></i> Generate New Codes
  </button>
 </div>
</div>

{# Regenerate Modal #}
<div class="modal" id="regenerateModal" tabindex="-1" aria-hidden="true">
 <div class="modal-dialog">
  <div class="modal-content">
   <div class="modal-header bg-gradient-to-r from-amber-500 to-amber-400">
    <h5 class="modal-title flex items-center gap-2 text-slate-900"><i class="lucide lucide-repeat"></i> Generate New Backup Codes</h5>
    <button type="button" class="text-slate-700 hover:text-slate-900" data-brox-dismiss="modal" aria-label="Close"><i class="lucide lucide-x"></i></button>
   </div>
   <div class="modal-body">
    <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-4 text-sm text-amber-900 mb-4" role="alert">
     <strong>Warning:</strong> Your current backup codes will be invalidated. Make sure to save the new codes before closing this page.
    </div>
    <form id="regenerateForm">
     <label for="password" class="block text-sm font-semibold text-slate-700 mb-1">Confirm Your Password</label>
     <input type="password" id="password" name="password" required placeholder="Enter your password"
      class="block w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10">
     <small class="text-xs text-slate-500 block mt-1">We need your password to confirm this important action</small>
    </form>
   </div>
   <div class="modal-footer flex justify-end gap-2">
    <button type="button" class="btn-secondary" data-brox-dismiss="modal">Cancel</button>
    <button type="button" onclick="regenerateBackupCodes(this)" class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-4 py-2.5 text-sm font-semibold text-black shadow-sm transition-all hover:bg-amber-600">
     <i class="lucide lucide-repeat"></i> Generate New Codes
    </button>
   </div>
  </div>
 </div>
</div>
{% endblock %}
