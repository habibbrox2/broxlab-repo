{% extends"admin/layout.twig" %}
{% block title %}Backup Codes - Two-Factor Authentication{% endblock %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 justify-center">
 <div class="lg:col-span-8">
 <!-- Header -->
 <div class=" border border-slate-200 bg-white shadow-sm border-0 mb-4">
 <div class="p-4 bg- ">
 <h1 class="text-white mb-2">
 <i class="lucide lucide-shield"></i> Backup Codes
 </h1>
 <p class="text-white/70 mb-0">Save your recovery codes for emergency access</p>
 </div>
 </div>
 <!-- Warning Alert -->
 <div class="p-4 rounded-lg bg-red-600-light text-red-600-dark border border-danger fade show" role="alert">
 <div class="flex items-start">
 <i class="lucide lucide-alert-triangle mt-1 mr-3 text-lg"></i>
 <div>
 <strong class="block mb-2">Important!</strong>
 <p class="mb-0">
 These codes will only be displayed once. Save them in a secure location immediately.
 You'll need these codes if you lose access to your authenticator app.
 </p>
 </div>
 </div>
 </div>
 <!-- Codes Display Card -->
 <div class=" border border-slate-200 bg-white shadow-sm border-2 border-amber-200 mb-4">
 <div class="border-b border-slate-200 px-4 py-3 bg-slate-100 border-amber-200">
 <h5 class="mb-0">
 <i class="lucide lucide-file-text"></i> Your Backup Codes
 </h5>
 </div>
 <div class="p-4">
 <p class="text-slate-500 small mb-3">
 <i class="lucide lucide-info"></i> Each code can be used only once for authentication
 </p>
 <!-- Codes Container -->
 <div class="backup-codes-container mb-4 ">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 {% for code in backup_codes %}
 <div class="md:col-span-6">
 <div class="code-box p-3 bg-white border rounded ">
 <code class="block font-bold ">
 {{ code }}
 </code>
 </div>
 </div>
 {% endfor %}
 </div>
 </div>
 <!-- Action Buttons -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-2 mb-4">
 <div class="md:col-span-6">
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-sky-500 text-white hover:bg-sky-600 w-full"
 onclick="copyAllBackupCodes(this)">
 <i class="lucide lucide-files"></i> Copy All Codes
 </button>
 </div>
 <div class="md:col-span-6">
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200 w-full"
 onclick="window.print()">
 <i class="lucide lucide-printer"></i> Print Codes
 </button>
 </div>
 </div>
 <hr>
 <!-- Storage Tips -->
 <div class=" border border-slate-200 bg-white shadow-sm bg-slate-100 border-0 mb-4">
 <div class="border-b border-slate-200 px-4 py-3 bg-sky-500 text-white">
 <h6 class="mb-0">
 <i class="lucide lucide-lock"></i> Safe Storage Recommendations
 </h6>
 </div>
 <div class="p-4">
 <p class="small mb-3">Recommended ways to save these codes:</p>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-2">
 <div class="md:col-span-6">
 <div class="p-2 bg-white rounded border border-success">
 <p class="mb-1">
 <strong class="text-emerald-600">âœ“ Good</strong>
 </p>
 <small>
 <ul class="mb-0 ps-3">
 <li>Password-protected encrypted file</li>
 <li>Printed and stored securely</li>
 <li>Password manager</li>
 </ul>
 </small>
 </div>
 </div>
 <div class="md:col-span-6">
 <div class="p-2 bg-white rounded border border-danger">
 <p class="mb-1">
 <strong class="text-red-600">âœ— Avoid</strong>
 </p>
 <small>
 <ul class="mb-0 ps-3">
 <li>Plain text files</li>
 <li>Cloud storage (unencrypted)</li>
 <li>Sharing via email</li>
 </ul>
 </small>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- How to Use -->
 <div class=" border border-slate-200 bg-white shadow-sm bg-slate-100 border-0 mb-4">
 <div class="border-b border-slate-200 px-4 py-3 bg-emerald-600 text-white">
 <h6 class="mb-0">
 <i class="lucide lucide-help-circle"></i> How to Use These Codes
 </h6>
 </div>
 <div class="p-4">
 <p class="small mb-3">If you lose access to your authenticator app:</p>
 <ol class="small">
 <li class="mb-2">Go to the login page</li>
 <li class="mb-2">Enter your email and password</li>
 <li class="mb-2">When asked for a 2FA code, use one of your backup codes instead</li>
 <li class="mb-2">After logging in, set up a new authenticator</li>
 <li>Generate new backup codes</li>
 </ol>
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 small mb-0 mt-3">
 <strong><i class="lucide lucide-alert-circle"></i> Remember:</strong> Each backup code can only be used once!
 </div>
 </div>
 </div>
 <!-- Regenerate Modal Trigger -->
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200" role="alert">
 <strong><i class="lucide lucide-lightbulb"></i> Tip:</strong>
 If you've used some codes or want to regenerate them for security, you can create new ones below.
 </div>
 </div>
 </div>
 <!-- Regenerate Button -->
 <div class=" border border-slate-200 bg-white shadow-sm border-0">
 <div class="p-4">
 <h6 class="rounded-xl mb-3">
 <i class="lucide lucide-repeat"></i> Regenerate Backup Codes
 </h6>
 <p class="text-slate-500 small mb-3">Generate a new set of backup codes. Your old codes will no longer be valid.</p>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-amber-500 text-black hover:bg-amber-600"
 data-brox-toggle="modal"
 data-brox-target="#regenerateModal">
 <i class="lucide lucide-repeat"></i> Generate New Codes
 </button>
 </div>
 </div>
 <!-- Back Button -->
 <div class="mt-4">
 <a href="/admin/security/2fa" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200">
 <i class="lucide lucide-arrow-left"></i> Back to 2FA Settings
 </a>
 </div>
 </div>
 </div>
 </div>
 <!-- Regenerate Modal -->
 <div class="modal fade"
 id="regenerateModal"
 tabindex="-1"
 aria-hidden="true">
 <div class="modal-dialog">
 <div class="modal-content">
 <div class="modal-header bg-amber-500">
 <h5 class="modal-title text-slate-900">
 <i class="lucide lucide-repeat"></i> Generate New Backup Codes
 </h5>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition"
 data-brox-dismiss="modal"
 aria-label="Close"></button>
 </div>
 <div class="modal-body">
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200" role="alert">
 <strong>Warning:</strong> Your current backup codes will be invalidated. Make sure to save the new codes before closing this page.
 </div>
 <form id="regenerateForm">
 <div class="mb-3">
 <label for="password" class="form-label">Confirm Your Password</label>
 <input type="password"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 id="password"
 name="password"
 required
 placeholder="Enter your password">
 <small class="text-slate-500 block mt-1">We need your password to confirm this important action</small>
 </div>
 </form>
 </div>
 <div class="modal-footer">
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200"
 data-brox-dismiss="modal">Cancel</button>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-amber-500 text-black hover:bg-amber-600"
 onclick="regenerateBackupCodes(this)">
 <i class="lucide lucide-repeat"></i> Generate New Codes
 </button>
 </div>
 </div>
 </div>
 </div>
{% endblock %}







