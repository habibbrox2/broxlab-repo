{% extends"admin/layout.twig" %}
{% block title %}Role Details{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-6">

 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-amber-900 to-orange-900 p-6 text-white shadow-2xl shadow-amber-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-orange-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-shield-check" style="width:1.5em;height:1.5em;"></i>
    </div>
    <div>
     <h1 class="text-xl font-black tracking-tight sm:text-2xl">{{ role.name|upper }}</h1>
     <p class="mt-1 text-sm text-amber-200/80">View the role metadata and assigned permissions.</p>
    </div>
   </div>
   <div class="flex flex-wrap gap-2">
    {% if not role.is_super_admin %}
    <a href="/admin/roles/{{ role.id }}/edit" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-pencil" style="width:0.875em;height:0.875em;"></i> Edit
    </a>
    <form method="POST" action="/admin/roles/{{ role.id }}/delete" class="inline" onsubmit="return window.confirmAction(event, this, 'Delete this role?')">
     <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-rose-500/20 px-4 py-2 text-xs font-semibold text-rose-200 shadow-sm backdrop-blur transition-all duration-200 hover:bg-rose-500/30 hover:-translate-y-0.5 active:scale-[0.97]">
      <i class="lucide lucide-trash-2" style="width:0.875em;height:0.875em;"></i> Delete
     </button>
    </form>
    {% endif %}
    <a href="/admin/roles" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-arrow-left" style="width:0.875em;height:0.875em;"></i> Back
    </a>
   </div>
  </div>
 </div>

 {# ── Two-Column Layout ── #}
 <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">

  {# ── Left Column: Role Info ── #}
  <div class="lg:col-span-4 space-y-6">
   <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-amber-50/50 to-orange-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-amber-100 text-amber-600">
      <i class="lucide lucide-info" style="width:0.875em;height:0.875em;"></i>
     </div>
     <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Role Information</h2>
    </div>
    <div class="p-5 space-y-4">
     <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Role Name</p>
      <p class="mt-1 text-lg font-bold text-slate-900">{{ role.name|upper }}</p>
     </div>
     <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Description</p>
      <p class="mt-1 text-sm text-slate-600">{{ role.description|default('N/A') }}</p>
     </div>
     <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Type</p>
      <div class="mt-1">
       {% if role.is_super_admin %}
       <span class="inline-flex items-center rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-semibold text-rose-700">Super Admin</span>
       {% else %}
       <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">Standard</span>
       {% endif %}
      </div>
     </div>
     <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Created</p>
      <p class="mt-1 text-sm text-slate-600">{{ role.created_at|date('M d, Y H:i') }}</p>
     </div>
     <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Updated</p>
      <p class="mt-1 text-sm text-slate-600">
       {% if role.updated_at %}{{ role.updated_at|date('M d, Y H:i') }}{% else %}Never{% endif %}
      </p>
     </div>
    </div>
   </section>
  </div>

  {# ── Right Column: Permissions ── #}
  <div class="lg:col-span-8">
   <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-violet-50/50 to-fuchsia-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-violet-100 text-violet-600">
      <i class="lucide lucide-key" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Permissions ({{ role.permissions|length }})</h2>
      <p class="text-xs text-slate-500">All permissions assigned to this role</p>
     </div>
    </div>
    <div class="p-5">
     {% if role.permissions|length > 0 %}
     <div class="space-y-5">
      {% set current_module = null %}
      {% for perm in role.permissions %}
       {% if perm.module != current_module %}
        {% if current_module != null %}</div></div>{% endif %}
        {% set current_module = perm.module %}
        <div>
         <h3 class="mb-3 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-indigo-600">
          <i class="lucide lucide-folder" style="width:0.875em;height:0.875em;"></i>
          {{ perm.module }}
         </h3>
         <div class="space-y-2">
       {% endif %}
       <div class="rounded-lg border border-slate-100 bg-slate-50 p-3 transition-colors hover:bg-indigo-50/40">
        <strong class="block text-sm text-slate-900">{{ perm.name }}</strong>
        <small class="text-slate-500">{{ perm.description }}</small>
       </div>
      {% endfor %}
      </div></div>
     </div>
     {% else %}
     <div class="flex items-center gap-2 rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-700">
      <i class="lucide lucide-info" style="width:1.125em;height:1.125em;"></i>
      <span>No permissions assigned to this role.</span>
     </div>
     {% endif %}
    </div>
   </section>
  </div>

 </div>
</div>
{% endblock %}
