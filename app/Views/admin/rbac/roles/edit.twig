{% extends"admin/layout.twig" %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
 <section class="admin-page-header">
  <div class="flex items-end justify-between gap-3">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-shield"></i>
     Roles
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Edit: {{ role.name|upper }}</h1>
    <p class="mt-2 text-sm text-slate-600">Manage role details and permissions.</p>
   </div>
   <a href="/admin/roles" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
    <i class="lucide lucide-arrow-left"></i> Back to Roles
   </a>
  </div>
 </section>

 <section class="admin-panel-card max-w-3xl">
  <form method="POST" action="/admin/roles/{{ role.id }}/update">
   <div class="mb-3">
    <label for="name" class="form-label">Role Name *</label>
    <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="name" name="name" value="{{ role.name }}" placeholder="e.g., moderator" required>
   </div>
   <div class="mb-3">
    <label for="description" class="form-label">Description</label>
    <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="description" name="description" rows="3" placeholder="Brief description of this role">{{ role.description }}</textarea>
   </div>
   <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50">
    <div class="border-b border-slate-200 px-4 py-3">
     <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-base font-semibold text-slate-950">Assign Permissions</h2>
      <div class="flex gap-2">
       <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-indigo-700" onclick="selectAll()">Select All</button>
       <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" onclick="deselectAll()">Clear</button>
      </div>
     </div>
    </div>
    <div class="p-4">
     {% for module, perms in permissions %}
     <div class="mb-4 last:mb-0">
      <h3 class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-indigo-600">{{ module }}</h3>
      <div class="space-y-3">
       {% for perm in perms %}
       <label class="flex items-start gap-3 rounded-lg border border-slate-200 bg-white p-3">
        <input class="permission-checkbox mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" name="permissions[]" value="{{ perm.id }}" id="perm_{{ perm.id }}" {% if perm.id in rolePermissionIds %}checked{% endif %}>
        <span>
         <strong class="block text-sm text-slate-900">{{ perm.name }}</strong>
         <small class="text-slate-500">{{ perm.description }}</small>
        </span>
       </label>
       {% endfor %}
      </div>
     </div>
     {% endfor %}
    </div>
   </div>
   <div class="mt-4 flex gap-2">
    <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
     <i class="lucide lucide-check-circle"></i> Update Role
    </button>
    <a href="/admin/roles" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
     <i class="lucide lucide-x-circle"></i> Cancel
    </a>
   </div>
  </form>
 </section>
</div>
{% endblock %}
