{% extends"admin/layout.twig" %}
{% block title %}Create New Permission{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-6">

 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-cyan-900 to-teal-900 p-6 text-white shadow-2xl shadow-cyan-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-teal-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-key-plus" style="width:1.5em;height:1.5em;"></i>
    </div>
    <div>
     <h1 class="text-xl font-black tracking-tight sm:text-2xl">Create New Permission</h1>
     <p class="mt-1 text-sm text-cyan-200/80">Add a permission that can be assigned to roles.</p>
    </div>
   </div>
   <a href="/admin/permissions" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
    <i class="lucide lucide-arrow-left" style="width:0.875em;height:0.875em;"></i> Back to Permissions
   </a>
  </div>
 </div>

 {# ── Create Permission Form Card ── #}
 <section class="scroll-fade-in max-w-3xl overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-cyan-50/50 to-teal-50/50 px-5 py-4">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-cyan-100 text-cyan-600">
    <i class="lucide lucide-key" style="width:0.875em;height:0.875em;"></i>
   </div>
   <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Permission Details</h2>
    <p class="text-xs text-slate-500">Define a new permission for the RBAC system</p>
   </div>
  </div>
  <div class="p-5">
   <form method="POST" action="/admin/permissions/store">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    <div class="mb-4">
     <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Permission Name <span class="text-rose-500">*</span></label>
     <div class="relative">
      <i class="lucide lucide-code absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" style="width:1em;height:1em;"></i>
      <input type="text" class="w-full rounded-lg border border-slate-300 pl-10 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500" id="name" name="name" placeholder="e.g., post.create" required>
     </div>
     <p class="mt-1 text-xs text-slate-400">Use format: module.action (e.g., post.create, user.delete)</p>
    </div>

    <div class="mb-4">
     <label for="module" class="block text-sm font-medium text-slate-700 mb-1">Module <span class="text-rose-500">*</span></label>
     <div class="relative">
      <i class="lucide lucide-folder absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" style="width:1em;height:1em;"></i>
      <input type="text" class="w-full rounded-lg border border-slate-300 pl-10 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500" id="module" name="module" placeholder="e.g., post" required>
     </div>
     <p class="mt-1 text-xs text-slate-400">The main category/module for this permission</p>
    </div>

    <div class="mb-4">
     <label for="description" class="block text-sm font-medium text-slate-700 mb-1">Description</label>
     <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500" id="description" name="description" rows="3" placeholder="What does this permission allow?"></textarea>
    </div>

    {# ── Actions ── #}
    <div class="flex flex-wrap gap-2 pt-2">
     <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-cyan-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-cyan-700 hover:shadow-md active:scale-[0.97]">
      <i class="lucide lucide-check-circle" style="width:1em;height:1em;"></i> Create Permission
     </button>
     <a href="/admin/permissions" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-all hover:bg-slate-50 hover:-translate-y-0.5 active:scale-[0.97]">
      <i class="lucide lucide-x-circle" style="width:1em;height:1em;"></i> Cancel
     </a>
    </div>
   </form>
  </div>
 </section>
</div>
{% endblock %}
