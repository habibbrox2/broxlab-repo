{% extends"admin/layout.twig" %}
{% block title %}Manage Permissions{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-6">

 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-cyan-900 to-teal-900 p-6 text-white shadow-2xl shadow-cyan-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-teal-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-key" style="width:1.5em;height:1.5em;"></i>
    </div>
    <div>
     <h1 class="text-xl font-black tracking-tight sm:text-2xl">Manage Permissions</h1>
     <p class="mt-1 text-sm text-cyan-200/80">Search and maintain permission records.</p>
    </div>
   </div>
   <a href="/admin/permissions/create" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
    <i class="lucide lucide-plus-circle" style="width:0.875em;height:0.875em;"></i> Create New Permission
   </a>
  </div>
 </div>

 {# ── Permissions Table Card ── #}
 <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="flex flex-col gap-4 border-b border-slate-100 bg-gradient-to-r from-cyan-50/50 to-teal-50/50 px-5 py-4 lg:flex-row lg:items-center lg:justify-between">
   <div class="flex items-center gap-2.5">
    <div class="flex h-7 w-7 items-center justify-center rounded-md bg-cyan-100 text-cyan-600">
     <i class="lucide lucide-key" style="width:0.875em;height:0.875em;"></i>
    </div>
    <div>
     <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">All Permissions ({{ total }})</h2>
     <p class="text-xs text-slate-500">Permission name, module, description, and actions</p>
    </div>
   </div>
   <div class="w-full lg:max-w-xs">
    <label class="sr-only" for="searchBox">Search permissions</label>
    <div class="relative">
     <i class="lucide lucide-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" style="width:0.875em;height:0.875em;"></i>
     <input type="text" id="searchBox" placeholder="Search permissions…" class="w-full rounded-lg border border-slate-300 pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500">
    </div>
   </div>
  </div>

  {% if permissions|length > 0 %}
  <div class="overflow-x-auto">
   <table class="w-full text-left text-sm" id="permissionsTable">
    <thead>
     <tr class="border-b border-slate-100 bg-slate-50/50">
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Permission Name</th>
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Module</th>
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Description</th>
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Created</th>
      <th class="px-5 py-3 text-center text-xs font-semibold uppercase tracking-wider text-slate-500">Actions</th>
     </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
     {% for perm in permissions %}
     <tr class="transition-colors duration-150 hover:bg-cyan-50/30">
      <td class="px-5 py-3.5"><code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs font-semibold text-indigo-600">{{ perm.name }}</code></td>
      <td class="px-5 py-3.5">
       <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">{{ perm.module }}</span>
      </td>
      <td class="px-5 py-3.5 text-sm text-slate-500">{{ perm.description|default('N/A') }}</td>
      <td class="px-5 py-3.5 text-sm text-slate-500">{{ perm.created_at|date('M d, Y') }}</td>
      <td class="px-5 py-3.5 text-center">
       <div class="inline-flex items-center justify-center gap-1.5">
        <a href="/admin/permissions/{{ perm.id }}" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-600 shadow-sm transition-all hover:bg-slate-50 hover:-translate-y-0.5" title="View">
         <i class="lucide lucide-eye" style="width:0.75em;height:0.75em;"></i>
        </a>
        <a href="/admin/permissions/{{ perm.id }}/edit" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-600 shadow-sm transition-all hover:bg-slate-50 hover:-translate-y-0.5" title="Edit">
         <i class="lucide lucide-pencil" style="width:0.75em;height:0.75em;"></i>
        </a>
        <form method="POST" action="/admin/permissions/{{ perm.id }}/delete" class="inline" onsubmit="return window.confirmAction(event, this, 'Delete this permission?')">
         <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-rose-600 px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm transition-all hover:bg-rose-700 hover:-translate-y-0.5" title="Delete">
          <i class="lucide lucide-trash-2" style="width:0.75em;height:0.75em;"></i>
         </button>
        </form>
       </div>
      </td>
     </tr>
     {% endfor %}
    </tbody>
   </table>
  </div>
  {% else %}
  <div class="px-5 py-8 text-center text-slate-500">
   <i class="lucide lucide-inbox mx-auto text-slate-300" style="width:2em;height:2em;"></i>
   <p class="mt-2 text-sm">No permissions found. <a href="/admin/permissions/create" class="font-semibold text-indigo-600 underline">Create one now</a></p>
  </div>
  {% endif %}
 </section>
</div>
{% endblock %}
