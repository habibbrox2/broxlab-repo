{% extends"admin/layout.twig" %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
 <section class="admin-page-header">
  <div class="flex flex-wrap items-end justify-between gap-3">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-key"></i>
     Permission Details
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><code>{{ permission.name }}</code></h1>
    <p class="mt-2 text-sm text-slate-600">Inspect the permission module, description, and timestamps.</p>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/permissions/{{ permission.id }}/edit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
     <i class="lucide lucide-pencil"></i> Edit
    </a>
    <form method="POST" action="/admin/permissions/{{ permission.id }}/delete" onsubmit="return confirm('Delete this permission?')">
     <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700 transition hover:bg-rose-100">
      <i class="lucide lucide-trash-2"></i> Delete
     </button>
    </form>
    <a href="/admin/permissions" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
     <i class="lucide lucide-arrow-left"></i> Back
    </a>
   </div>
  </div>
 </section>

 <section class="admin-panel-card">
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
   <div class="lg:col-span-6 space-y-4">
    <div>
     <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Permission Name</p>
     <p class="mt-1 text-lg font-semibold text-slate-950"><code>{{ permission.name }}</code></p>
    </div>
    <div>
     <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Module</p>
     <span class="mt-1 inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">{{ permission.module }}</span>
    </div>
   </div>
   <div class="lg:col-span-6 space-y-4">
    <div>
     <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Created</p>
     <p class="mt-1 text-sm text-slate-700">{{ permission.created_at|date("M d, Y H:i") }}</p>
    </div>
    <div>
     <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Updated</p>
     <p class="mt-1 text-sm text-slate-700">
      {% if permission.updated_at %}
       {{ permission.updated_at|date("M d, Y H:i") }}
      {% else %}
       Never
      {% endif %}
     </p>
    </div>
   </div>
  </div>
  <div class="mt-6">
   <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Description</p>
   <p class="mt-1 text-sm text-slate-700">{{ permission.description|default('No description provided') }}</p>
  </div>
 </section>
</div>
{% endblock %}
