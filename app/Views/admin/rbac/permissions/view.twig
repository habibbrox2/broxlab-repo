{% extends"admin/layout.twig" %}
{% block title %}Permission Details{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-6">

 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-cyan-900 to-teal-900 p-6 text-white shadow-2xl shadow-cyan-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-teal-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-key" style="width:1.5em;height:1.5em;"></i>
    </div>
    <div>
     <h1 class="text-xl font-black tracking-tight sm:text-2xl"><code class="rounded bg-white/10 px-2 py-0.5 text-base">{{ permission.name }}</code></h1>
     <p class="mt-1 text-sm text-cyan-200/80">Inspect the permission module, description, and timestamps.</p>
    </div>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/permissions/{{ permission.id }}/edit" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-pencil" style="width:0.875em;height:0.875em;"></i> Edit
    </a>
    <form method="POST" action="/admin/permissions/{{ permission.id }}/delete" class="inline" onsubmit="return window.confirmAction(event, this, 'Delete this permission?')">
     <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-rose-500/20 px-4 py-2 text-xs font-semibold text-rose-200 shadow-sm backdrop-blur transition-all duration-200 hover:bg-rose-500/30 hover:-translate-y-0.5 active:scale-[0.97]">
      <i class="lucide lucide-trash-2" style="width:0.875em;height:0.875em;"></i> Delete
     </button>
    </form>
    <a href="/admin/permissions" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-arrow-left" style="width:0.875em;height:0.875em;"></i> Back
    </a>
   </div>
  </div>
 </div>

 {# ── Permission Details Card ── #}
 <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-cyan-50/50 to-teal-50/50 px-5 py-4">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-cyan-100 text-cyan-600">
    <i class="lucide lucide-info" style="width:0.875em;height:0.875em;"></i>
   </div>
   <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Permission Information</h2>
  </div>
  <div class="p-6">
   <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
    <div class="lg:col-span-6 space-y-5">
     <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Permission Name</p>
      <p class="mt-1"><code class="rounded-lg bg-slate-100 px-2.5 py-1 text-sm font-semibold text-indigo-600">{{ permission.name }}</code></p>
     </div>
     <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Module</p>
      <p class="mt-1">
       <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">{{ permission.module }}</span>
      </p>
     </div>
    </div>
    <div class="lg:col-span-6 space-y-5">
     <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Created</p>
      <p class="mt-1 text-sm text-slate-700">{{ permission.created_at|date('M d, Y H:i') }}</p>
     </div>
     <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Updated</p>
      <p class="mt-1 text-sm text-slate-700">
       {% if permission.updated_at %}{{ permission.updated_at|date('M d, Y H:i') }}{% else %}Never{% endif %}
      </p>
     </div>
    </div>
   </div>
   <div class="mt-6 border-t border-slate-100 pt-5">
    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Description</p>
    <p class="mt-1 text-sm text-slate-700">{{ permission.description|default('No description provided') }}</p>
   </div>
  </div>
 </section>
</div>
{% endblock %}
