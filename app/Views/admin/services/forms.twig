 async function performSearch(query, page) {
 page = page || 1;
 if (!query) return;
 currentQuery = query;
 currentPage = page;
 showLoading();
 selectedPhoto = null;
 insertBtn.disabled = true;

 try {
 var resp = await fetch('/api/pexels/search?q=' + encodeURIComponent(query) + '&page=' + page + '&per_page=15');
 var data = await resp.json();

 if (!data.success) {
 showError(data.error || 'Search failed');
 return;
 }

 if (!data.photos || !data.photos.length) {
 showEmpty();
 if (totalResults) totalResults.textContent = '';
 return;
 }

 totalPages = Math.ceil((data.total_results || 0) / (data.per_page || 15));
 if (totalResults) {
 totalResults.textContent = data.total_results + ' results';
 }

 renderPhotos(data.photos, page, totalPages);
 } catch (err) {
 showError('Network error: ' + (err.message || 'Unknown'));
 }
 }

 function renderPhotos(photos, page, totalPages) {
 var html = '';
 photos.forEach(function(photo) {
 var src = photo.src?.medium || photo.src?.small || '';
 var alt = escapeHtml(photo.alt || 'Pexels photo');
 var photographer = escapeHtml(photo.photographer || 'Unknown');
 var width = photo.width || 0;
 var height = photo.height || 0;
 html += '<div class="pexels-photo-card" data-id="' + photo.id + '" data-url="' + escapeHtml(photo.src?.large || photo.src?.original || '') + '" data-alt="' + alt + '" data-photographer="' + photographer + '" data-width="' + width + '" data-height="' + height + '">';
 html += '<img src="' + escapeHtml(src) + '" alt="' + alt + '" loading="lazy">';
 html += '<div class="pexels-photo-info">' + photographer + '</div>';
 html += '<div class="pexels-loading-overlay"><div class="inline-spinner inline-spinner-sm text-emerald-600"></div></div>';
 html += '</div>';
 });

 // Pagination nav
 if (totalPages > 1) {
