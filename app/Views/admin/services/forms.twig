{% block scripts %}
 {% set rte_version = getRTEVersion() %}
 <script src="/rtceditor/editor.bundle.js?v={{ rte_version }}" defer></script>
 <script>
 (function () {
 const premiumToggle = document.getElementById('isPremium');
 const premiumPriceGroup = document.getElementById('premiumPriceGroup');
 const premiumPriceInput = document.getElementById('premiumPriceInput');

 if (!premiumToggle || !premiumPriceGroup || !premiumPriceInput) {
 return;
 }

 const syncPremiumPriceVisibility = () => {
 const enabled = premiumToggle.checked;
 premiumPriceGroup.style.display = enabled ? '' : 'none';
 premiumPriceInput.required = enabled;
 if (!enabled) {
 premiumPriceInput.value = '';
 }
 };

 premiumToggle.addEventListener('change', syncPremiumPriceVisibility);
 syncPremiumPriceVisibility();
 })();
 </script>

 <!-- AI Writer FAB + Generation Script -->
 <script>
 // Global helper: escape HTML special characters (used by multiple IIFE blocks)
 function escapeHtml(str) {
 var d = document.createElement('div');
 d.textContent = str;
 return d.innerHTML;
 }

 (function() {
 'use strict';

 const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
 const fabBtn = document.getElementById('aiFabServiceBtn');
 const descCard = document.querySelector('. border border-slate-200 bg-white shadow-sm:has(.modern-rich-editor)');

 // Prefill flash indicator helpers
 function flashField(el, label) {
 if (!el) return;
 el.classList.add('prefill-flash');
 el.style.position = 'relative';
 setTimeout(function() { el.classList.remove('prefill-flash'); }, 2200);
 }

 function showPrefillToast(fieldNames) {
 if (!fieldNames.length) return;
 var toast = document.getElementById('prefillToast');
 var text = document.getElementById('prefillToastText');
 if (!toast || !text) return;
 text.textContent = '\u2713 Auto-filled: ' + fieldNames.join(', ');
 toast.classList.add('show');
 var timer = setTimeout(function() { toast.classList.remove('show'); }, 5000);
 var closeBtn = document.getElementById('prefillToastClose');
 if (closeBtn) {
 closeBtn.onclick = function() {
 clearTimeout(timer);
 toast.classList.remove('show');
 };
 }
 toast.onclick = function(e) {
 if (e.target === closeBtn) return;
 clearTimeout(timer);
 toast.classList.remove('show');
 };
 }

 // URL param prefill for service AI writer
 var urlTopic = '';
 var urlTone = '';
 var urlKeywords = '';
 try {
 function safeDecodeUrlValue(val) {
 if (!val) return '';
 var s = String(val);
 try { s = decodeURIComponent(s); } catch (_) {}
 return s;
 }

 function sanitizePrefillHtml(html) {
 if (!html) return '';
 var raw = String(html);
 try {
 var doc = new DOMParser().parseFromString('<div>' + raw + '</div>', 'text/html');
 var root = doc.body && doc.body.firstChild;
 if (!root) return '';

 var allowed = {
 'P': true, 'H1': true, 'H2': true, 'H3': true,
 'UL': true, 'OL': true, 'LI': true,
 'STRONG': true, 'EM': true, 'B': true, 'I': true,
 'BR': true, 'BLOCKQUOTE': true,
 'A': true,
 'DIV': true, 'SPAN': true
 };

 function isSafeUrl(url) {
 var u = String(url || '').trim();
 if (!u) return true;
 if (/^javascript:/i.test(u)) return false;
 return /^(https?:|mailto:|tel:|\/|#)/i.test(u);
 }

 function cleanNode(node) {
 if (!node) return;
 if (node.nodeType === Node.COMMENT_NODE) {
 node.remove();
 return;
 }
 if (node.nodeType === Node.ELEMENT_NODE) {
 var tag = (node.tagName || '').toUpperCase();
 if (!allowed[tag]) {
 var parent = node.parentNode;
 if (parent) {
 while (node.firstChild) parent.insertBefore(node.firstChild, node);
 parent.removeChild(node);
 } else {
 node.remove();
 }
 return;
 }

 Array.from(node.attributes || []).forEach(function (attr) {
 var name = (attr.name || '').toLowerCase();
 var value = attr.value || '';
 if (name.startsWith('on') || name === 'style') {
 node.removeAttribute(attr.name);
 return;
 }
 if ((name === 'href' || name === 'src') && !isSafeUrl(value)) {
 node.removeAttribute(attr.name);
 }
 });
 }
 Array.from(node.childNodes || []).forEach(cleanNode);
 }

 cleanNode(root);
 return root.innerHTML || '';
 } catch (_) {
 return '';
 }
 }

 var sp = new URLSearchParams(window.location.search);
 urlTopic = safeDecodeUrlValue(sp.get('topic') || sp.get('q') || '');
 urlTone = sp.get('tone') || '';
 urlKeywords = safeDecodeUrlValue(sp.get('keywords') || '');

 // Direct form field prefill from URL params
 var urlSlug = sp.get('slug') || '';
 var urlContent = sp.get('content') || '';
 var safeHtmlContent = sanitizePrefillHtml(safeDecodeUrlValue(urlContent));

 var prefilledFields = [];

 if (urlTopic) {
 var nameInput = document.querySelector('input[name="name"]');
 if (nameInput && !nameInput.value.trim()) {
 nameInput.value = urlTopic;
 flashField(nameInput, 'Service Name');
 prefilledFields.push('Service Name');
 }
 }
 if (urlSlug) {
 var slugInput = document.querySelector('input[name="slug"]');
 if (slugInput && !slugInput.value.trim()) {
 slugInput.value = urlSlug;
 flashField(slugInput, 'Slug');
 prefilledFields.push('Slug');
 }
 }
 if (safeHtmlContent) {
 try {
 var editor = window.editor_content;
 var contentFilled = false;
 if (editor && typeof editor.setContent === 'function') {
 var existing = '';
 try { existing = String(editor.getContent() || '').trim(); } catch(_) {}
 if (!existing) {
 editor.setContent(safeHtmlContent);
 contentFilled = true;
 }
 } else {
 var ta = document.querySelector('textarea[name="description"]');
 if (ta && !ta.value.trim()) {
 ta.value = safeHtmlContent;
 contentFilled = true;
 }
 }
 if (contentFilled) {
 var editorEl = document.querySelector('.modern-rich-editor');
 if (editorEl) flashField(editorEl, 'Description');
 prefilledFields.push('Description');
 }
 } catch(_) {}
 }

 // Show toast if any fields were prefilled
 if (prefilledFields.length) {
 showPrefillToast(prefilledFields);
 }
 } catch(_) {}

 // Overlay elements
 const overlay = document.getElementById('aiGenOverlayService');
 const spinner = document.getElementById('aiGenSpinnerService');
 const checkIcon = document.getElementById('aiGenCheckService');
 const overlayTitle = document.getElementById('aiGenTitleService');
 const overlayText = document.getElementById('aiGenTextService');
 const progressBar = document.getElementById('aiGenProgressBarService');
 const charsDisplay = document.getElementById('aiGenCharsService');

 if (!fabBtn || !overlay) return;

 // --- FAB visibility ---
 function checkFabVisibility() {
 if (!descCard) return;
 var rect = descCard.getBoundingClientRect();
 var isVisible = rect.top < window.innerHeight && rect.bottom > 0;
 fabBtn.classList.toggle('visible', !isVisible);
 }

 var scrollTimer = null;
 window.addEventListener('scroll', function() {
 if (scrollTimer) return;
 scrollTimer = setTimeout(function() {
 checkFabVisibility();
 scrollTimer = null;
 }, 150);
 }, { passive: true });

 window.addEventListener('load', checkFabVisibility);
 window.addEventListener('resize', checkFabVisibility);
 checkFabVisibility();

 // --- Overlay helpers ---
 function showProgress(pct, text, title) {
 progressBar.style.width = pct + '%';
 if (text) overlayText.textContent = text;
 if (title) overlayTitle.textContent = title;
 }

 function showOverlay() {
 spinner.className = 'ai-gen-spinner';
 checkIcon.classList.remove('show');
 progressBar.className = 'ai-gen-progress-bar';
 overlayTitle.textContent = 'Generating Description';
 overlayText.textContent = 'Starting up...';
 progressBar.style.width = '5%';
 if (charsDisplay) charsDisplay.textContent = '';
 overlay.classList.add('active');
 }

 function hideOverlay() {
 overlay.classList.remove('active');
 }

 function showCompletion(success, message) {
 if (success) {
 spinner.className = 'ai-gen-spinner done';
 checkIcon.classList.add('show');
 progressBar.className = 'ai-gen-progress-bar done';
 progressBar.style.width = '100%';
 overlayTitle.textContent = 'Complete!';
 overlayText.textContent = message || 'Description generated successfully';
 setTimeout(function() { hideOverlay(); }, 1200);
 } else {
 spinner.className = 'ai-gen-spinner error';
 progressBar.className = 'ai-gen-progress-bar error';
 overlayTitle.textContent = 'Generation Failed';
 overlayText.textContent = message || 'An error occurred';
 setTimeout(function() { hideOverlay(); }, 3000);
 }
 }

 function convertToHtml(title, content) {
 var html = '';
 if (title) html += '<h2>' + escapeHtml(title) + '</h2>\n';
 var paragraphs = (content || '').split(/\n{2,}/);
 var inList = false;
 paragraphs.forEach(function(p) {
 var t = p.trim();
 if (!t) return;
 if (t.startsWith('### ')) {
 if (inList) { html += '</ul>\n'; inList = false; }
 html += '<h3>' + escapeHtml(t.slice(4)) + '</h3>\n';
 } else if (t.startsWith('## ')) {
 if (inList) { html += '</ul>\n'; inList = false; }
 html += '<h2>' + escapeHtml(t.slice(3)) + '</h2>\n';
 } else if (t.startsWith('# ')) {
 if (inList) { html += '</ul>\n'; inList = false; }
 html += '<h1>' + escapeHtml(t.slice(2)) + '</h1>\n';
 } else if (t.startsWith('> ')) {
 if (inList) { html += '</ul>\n'; inList = false; }
 html += '<blockquote>' + escapeHtml(t.slice(2)) + '</blockquote>\n';
 } else if (t.startsWith('- ') || t.startsWith('* ')) {
 if (!inList) { html += '<ul>\n'; inList = true; }
 html += '<li>' + escapeHtml(t.slice(2)) + '</li>\n';
 } else {
 if (inList) { html += '</ul>\n'; inList = false; }
 html += '<p>' + escapeHtml(t) + '</p>\n';
 }
 });
 if (inList) html += '</ul>\n';
 return html;
 }

 function setEditorContent(html) {
 var editor = window.editor_content;
 if (editor && typeof editor.setContent === 'function') {
 // Get current content and append if it exists
 var existingHtml = '';
 try { existingHtml = String(editor.getContent() || '').trim(); } catch(_) {}
 if (existingHtml) {
 editor.setContent(existingHtml + '\n\n' + html);
 } else {
 editor.setContent(html);
 }
 } else {
 var textarea = document.querySelector('textarea[name="description"]');
 if (textarea) {
 var existing = textarea.value || '';
 textarea.value = existing ? existing + '\n\n' + html : html;
 }
 }
 }

 // --- Prompt + Generation ---
 function buildPrompt(options) {
 var prompt = 'Write a detailed service description';
 if (options.tone && options.tone !== 'informative') {
 prompt += ' in a ' + options.tone + ' tone';
 }
 if (options.length && options.length !== 'medium') {
 prompt += '. Make it ' + options.length + ' in length';
 }
 prompt += ' for the following service: ' + options.topic + '.';
 if (options.keywords) {
 prompt += ' Include these keywords: ' + options.keywords + '.';
 }
 prompt += ' Describe what the service offers, its key features, and benefits. Use markdown formatting with headings and paragraphs. Do NOT include metadata blocks or TITLE: labels. Just write the description directly.';
 return prompt;
 }

 // --- Streaming support ---
 async function streamGeneration(options) {
 showOverlay();
 showProgress(10, 'Starting stream...', 'Live Stream');

 var messages = [
 {
 role: 'system',
 content: 'You are a professional service description writer. Generate a well-structured description with proper headings and paragraphs using markdown formatting. Focus on benefits, features, and value proposition. Write the description directly without any title labels or metadata blocks.'
 },
 {
 role: 'user',
 content: buildPrompt(options)
 }
 ];

 try {
 var resp = await fetch('/api/admin/ai/chat', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
 body: JSON.stringify({
 messages: messages,
 stream: true,
 tools: []
 })
 });

 if (!resp.ok) {
 var errData = await resp.json().catch(function() { return {}; });
 throw new Error(errData.error || 'HTTP ' + resp.status);
 }

 var reader = resp.body.getReader();
 var decoder = new TextDecoder();
 var buffer = '';
 var fullHtml = '';
 var charCount = 0;

 showProgress(25, 'Receiving content...', 'Live Stream');

 while (true) {
 var result = await reader.read();
 if (result.done) break;

 buffer += decoder.decode(result.value, { stream: true });
 var lines = buffer.split('\n');
 buffer = lines.pop() || '';

 for (var si = 0; si < lines.length; si++) {
 var line = lines[si].trim();
 if (!line || line === 'data: [DONE]') continue;
 if (line.startsWith('data: ')) {
 try {
 var parsed = JSON.parse(line.slice(6));
 var content = parsed.content || parsed.choices?.[0]?.delta?.content || '';
 if (content) {
 fullHtml += content;
 charCount = fullHtml.length;
 showProgress(Math.min(85, 25 + (charCount / 100)), charCount + ' chars received', 'Live Stream');

 // Live-update overlay text with partial content
 overlayText.innerHTML = '<small class="text-slate-500 block text-left" style="max-height:80px;overflow-y:auto;font-size:0.82rem;">'
 + escapeHtml(fullHtml.slice(-300))
 + '</small>';
 if (charsDisplay) charsDisplay.textContent = charCount + ' characters received';
 }
 } catch (_) { /* skip malformed SSE line */ }
 }
 }
 }

 // Process remaining buffer
 if (buffer.trim() && buffer.startsWith('data: ')) {
 try {
 var parsed = JSON.parse(buffer.slice(6));
 var content = parsed.content || parsed.choices?.[0]?.delta?.content || '';
 if (content) fullHtml += content;
 } catch (_) {}
 }

 showProgress(85, 'Converting ' + fullHtml.length + ' chars to HTML...', 'Finalizing');

 // Convert the raw streamed text to HTML
 var rawLines = fullHtml.split('\n');
 var title = '';
 var bodyLines = [];
 if (rawLines.length > 0 && /^#{1,2}\s/.test(rawLines[0])) {
 title = rawLines[0].replace(/^#+\s*/, '').trim();
 rawLines = rawLines.slice(1);
 }
 bodyLines = rawLines.join('\n').trim();
 var html = convertToHtml(title, bodyLines);

 if (html) {
 showProgress(95, 'Inserting into editor...', 'Finalizing');
 setEditorContent(html);
 // Scroll to description editor
 var editorEl = document.querySelector('.modern-rich-editor');
 if (editorEl) editorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
 }

 showCompletion(true, 'Description streamed into editor!');

 } catch (err) {
 showCompletion(false, err.message || 'Stream error');
 }
 }

 // --- Non-streaming generation (existing) ---
 function nonStreamGeneration(options) {
 showOverlay();
 showProgress(10, 'Sending request...', 'Generating Description');

 var messages = [
 {
 role: 'system',
 content: 'You are a professional service description writer. Generate a well-structured description with proper headings and paragraphs using markdown formatting. Focus on benefits, features, and value proposition.'
 },
 {
 role: 'user',
 content: buildPrompt(options)
 }
 ];

 fetch('/api/admin/ai/chat', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
 body: JSON.stringify({
 messages: messages,
 stream: false,
 tools: []
 })
 })
 .then(function(resp) { return resp.json(); })
 .then(function(data) {
 if (data.success && data.content) {
 showProgress(70, 'Processing response...', 'Generating Description');
 var rawText = typeof data.content === 'string' ? data.content : JSON.stringify(data.content);
 // Strip any metadata blocks
 rawText = rawText.replace(/```[\s\S]*?```/g, '').replace(/TITLE:|SLUG:|META_TITLE:|META_DESCRIPTION:|TAGS:|CATEGORIES:/gi, '').trim();
 // Check if first line looks like a title, extract it
 var lines = rawText.split('\n');
 var title = '';
 var content = '';
 if (lines.length > 0 && /^#{1,2}\s/.test(lines[0])) {
 title = lines[0].replace(/^#+\s*/, '').trim();
 lines = lines.slice(1);
 }
 content = lines.join('\n').trim();
 var html = convertToHtml(title, content);
 showProgress(90, 'Inserting into editor...', 'Finalizing');
 setEditorContent(html);
 // Scroll to description editor
 var editorEl = document.querySelector('.modern-rich-editor');
 if (editorEl) editorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
 showCompletion(true, 'Description inserted into editor!');
 } else {
 showCompletion(false, data.error || data.message || 'Empty response');
 }
 })
 .catch(function(err) {
 showCompletion(false, err.message || 'Network error');
 });
 }

