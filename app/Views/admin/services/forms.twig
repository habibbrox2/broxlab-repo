 if (page > 1) {
 html += '<button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-100 pexels-page-inline-flex" data-page="' + (page - 1) + '"><i class="lucide lucide-chevron-left"></i> Previous</button>';
 }
 html += '<small class="text-slate-500">Page ' + page + ' of ' + totalPages + '</small>';
 if (page < totalPages) {
