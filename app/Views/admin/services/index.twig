{% extends "admin/layout.twig" %}
{% block title %}Manage Services{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="px-4 sm:px-6 lg:px-8 py-5">

 {# ── Page Header Banner ── #}
 <div class="relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-900 text-white shadow-xl shadow-slate-900/20">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.25),transparent_55%)]" aria-hidden="true"></div>
  <div class="relative px-6 py-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-4">
    <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center flex-shrink-0">
     <i class="lucide lucide-award w-5 h-5 text-white"></i>
    </div>
    <div>
     <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-1">Service Catalog</p>
     <h1 class="text-xl font-bold text-white">Services Management</h1>
     <p class="text-sm text-white/60 mt-0.5 max-w-md">Manage your service catalog and configurations.</p>
    </div>
   </div>
   <div class="flex gap-2">
    <a href="/admin/services/create" class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
     <i class="lucide lucide-plus w-4 h-4"></i> Create Service
    </a>
   </div>
  </div>
 </div>

 {# ── Table Card ── #}
 {% if services is not empty %}
 <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
  {# Table toolbar #}
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
   <div class="flex items-center gap-2">
    <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
     <i class="lucide lucide-award w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
    </div>
    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">All Services</h3>
    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-400">
     {{ pagination.total|default(services|length) }}
    </span>
   </div>
   <div class="flex items-center gap-2">
    <div class="relative">
     <i class="lucide lucide-search w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
     <input type="text" placeholder="Search services..." class="w-48 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 pl-9 pr-3 py-2 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 transition-all duration-150 focus:border-indigo-400 dark:focus:border-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600">
    </div>
   </div>
  </div>
  {# Table #}
  <div class="overflow-x-auto">
   <table class="w-full text-left">
    <thead>
     <tr class="border-b border-slate-100 dark:border-slate-800">
      <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap w-10">
       <input type="checkbox" id="selectAll" class="rounded border-slate-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500/20 transition cursor-pointer">
      </th>
      <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Name</th>
      <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Status</th>
      <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap text-center">Applications</th>
      <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Created</th>
      <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap text-right">Actions</th>
     </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
     {% for service in services %}
     <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors duration-100">
      <td class="px-4 py-3">
       <input type="checkbox" class="service-checkbox rounded border-slate-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500/20 transition cursor-pointer" value="{{ service.id }}">
      </td>
      <td class="px-4 py-3">
       <div class="flex items-center gap-3">
        <div class="relative w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center overflow-hidden flex-shrink-0">
         {% if service.images is defined and service.images is not empty %}
          {% set firstImage = service.images|first %}
          {% set imgSrc = (firstImage.thumbnail_path ?? firstImage.image_path)|absolute_url %}
          <img src="{{ imgSrc }}"
               alt="{{ service.name }}"
               class="w-full h-full object-cover"
               loading="lazy"
               onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
          <div class="absolute inset-0 flex items-center justify-center" style="display:none;">
           <i class="lucide lucide-image text-lg text-slate-400"></i>
          </div>
         {% elseif service.icon %}
          <i class="{{ service.icon }} text-lg text-slate-500 dark:text-slate-400"></i>
         {% else %}
          <i class="lucide lucide-image text-lg text-slate-400"></i>
         {% endif %}
        </div>
        <div class="min-w-0">
         <div class="flex items-center gap-2">
          <span class="text-sm font-semibold text-slate-900 dark:text-white truncate">{{ service.name }}</span>
          {% if service.is_premium is defined and service.is_premium == 1 %}
           <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400">
            <i class="lucide lucide-crown w-3 h-3"></i> Premium
           </span>
          {% endif %}
         </div>
         <p class="text-xs text-slate-500 dark:text-slate-400 truncate mt-0.5">{{ service.slug }}</p>
        </div>
       </div>
      </td>
      <td class="px-4 py-3">
       {% if service.status == 'active' %}
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400">
         <span class="w-1 h-1 rounded-full bg-emerald-500"></span> Active
        </span>
       {% elseif service.status == 'inactive' %}
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400">
         <span class="w-1 h-1 rounded-full bg-amber-500"></span> Inactive
        </span>
       {% elseif service.status == 'archived' %}
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
         <span class="w-1 h-1 rounded-full bg-slate-400"></span> Archived
        </span>
       {% else %}
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
         {{ service.status|capitalize }}
        </span>
       {% endif %}
      </td>
      <td class="px-4 py-3 text-center">
       <span class="inline-flex items-center justify-center min-w-[2rem] px-2 py-0.5 rounded-full text-[11px] font-semibold bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-400">{{ service.total_applications|default(0) }}</span>
      </td>
      <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">{{ service.created_at|date("d M Y") }}</td>
      <td class="px-4 py-3 text-right">
       <div class="flex items-center justify-end gap-1">
        <a href="/admin/services/details/{{ service.id }}" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-950/30 transition-all duration-150" title="View">
         <i class="lucide lucide-eye w-3.5 h-3.5"></i>
        </a>
        <a href="/admin/services/{{ service.id }}/edit" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-950/30 transition-all duration-150" title="Edit">
         <i class="lucide lucide-pencil w-3.5 h-3.5"></i>
        </a>
        <button type="button" class="delete-service inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 transition-all duration-150" data-id="{{ service.id }}" title="Delete">
         <i class="lucide lucide-trash-2 w-3.5 h-3.5"></i>
        </button>
       </div>
      </td>
     </tr>
     {% endfor %}
    </tbody>
   </table>
  </div>

  {# ── Mobile Card View ── #}
  <div class="block lg:hidden border-t border-slate-100 dark:border-slate-800">
   {% for service in services %}
   <div class="p-4 border-b border-slate-100 dark:border-slate-800 last:border-b-0">
    <div class="flex items-start gap-3 mb-3">
     <div class="relative w-14 h-14 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center overflow-hidden flex-shrink-0">
      {% if service.images is defined and service.images is not empty %}
       {% set firstImage = service.images|first %}
       {% set imgSrc = (firstImage.thumbnail_path ?? firstImage.image_path)|absolute_url %}
       <img src="{{ imgSrc }}"
            alt="{{ service.name }}"
            class="w-full h-full object-cover"
            loading="lazy"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
       <div class="absolute inset-0 flex items-center justify-center" style="display:none;">
        <i class="lucide lucide-image text-xl text-slate-400"></i>
       </div>
      {% elseif service.icon %}
       <i class="{{ service.icon }} text-xl text-slate-500 dark:text-slate-400"></i>
      {% else %}
       <i class="lucide lucide-image text-xl text-slate-400"></i>
      {% endif %}
     </div>
     <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 mb-1">
       <span class="text-xs font-medium text-slate-500 dark:text-slate-400">#{{ service.id }}</span>
       {% if service.status == 'active' %}
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400">
         <span class="w-1 h-1 rounded-full bg-emerald-500"></span> Active
        </span>
       {% elseif service.status == 'inactive' %}
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400">
         <span class="w-1 h-1 rounded-full bg-amber-500"></span> Inactive
        </span>
       {% elseif service.status == 'archived' %}
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
         <span class="w-1 h-1 rounded-full bg-slate-400"></span> Archived
        </span>
       {% endif %}
      </div>
      <p class="text-sm font-semibold text-slate-900 dark:text-white truncate">{{ service.name }}</p>
      <p class="text-xs text-slate-500 dark:text-slate-400 truncate">{{ service.slug }}</p>
      {% if service.is_premium is defined and service.is_premium == 1 %}
       <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 mt-1">
        <i class="lucide lucide-crown w-3 h-3"></i> Premium
       </span>
      {% endif %}
     </div>
    </div>
    <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 mb-3">
     <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-400">
      <i class="lucide lucide-users w-3 h-3"></i> Apps: {{ service.total_applications|default(0) }}
     </span>
     <span><i class="lucide lucide-calendar w-3 h-3 mr-1"></i>{{ service.created_at|date("d M Y") }}</span>
    </div>
    <div class="flex gap-2">
     <a href="/admin/services/details/{{ service.id }}" class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
      <i class="lucide lucide-eye w-3 h-3"></i> View
     </a>
     <a href="/admin/services/{{ service.id }}/edit" class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-xl bg-indigo-600 px-3 py-2 text-xs font-semibold text-white shadow-sm hover:bg-indigo-700 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
      <i class="lucide lucide-pencil w-3 h-3"></i> Edit
     </a>
     <button type="button" class="delete-service flex-1 inline-flex items-center justify-center gap-1.5 rounded-xl bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-800/40 px-3 py-2 text-xs font-semibold text-red-600 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-950/50 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150" data-id="{{ service.id }}">
      <i class="lucide lucide-trash-2 w-3 h-3"></i> Delete
     </button>
    </div>
   </div>
   {% endfor %}
  </div>

  {# ── Pagination ── #}
  {% if pagination.total_pages > 1 %}
  <div class="flex items-center justify-between px-5 py-3.5 border-t border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
   <span class="text-xs text-slate-400 dark:text-slate-600">
    Showing {{ (pagination.current_page - 1) * pagination.limit + 1 }}–{{ min(pagination.current_page * pagination.limit, pagination.total) }} of {{ pagination.total }}
   </span>
   <div class="flex items-center gap-1">
    {% if pagination.has_previous %}
     <a href="/admin/services?page=1" class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all duration-150 text-xs font-semibold">
      <i class="lucide lucide-chevrons-left w-3 h-3"></i>
     </a>
     <a href="/admin/services?page={{ pagination.previous_page }}" class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all duration-150">
      <i class="lucide lucide-chevron-left w-3 h-3"></i>
     </a>
    {% endif %}
    {% for page in range(max(1, pagination.current_page - 2), min(pagination.total_pages, pagination.current_page + 2)) %}
     <a href="/admin/services?page={{ page }}" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-xs font-semibold transition-all duration-150
      {{ page == pagination.current_page ? 'bg-indigo-600 text-white border border-indigo-600' : 'border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400' }}">
      {{ page }}
     </a>
    {% endfor %}
    {% if pagination.has_next %}
     <a href="/admin/services?page={{ pagination.next_page }}" class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all duration-150">
      <i class="lucide lucide-chevron-right w-3 h-3"></i>
     </a>
     <a href="/admin/services?page={{ pagination.total_pages }}" class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all duration-150 text-xs font-semibold">
      <i class="lucide lucide-chevrons-right w-3 h-3"></i>
     </a>
    {% endif %}
   </div>
  </div>
  {% endif %}
 </div>
 {% else %}
 {# ── Empty State ── #}
 <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
  <div class="flex flex-col items-center justify-center py-16 text-center">
   <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-4">
    <i class="lucide lucide-award w-7 h-7 text-slate-400 dark:text-slate-600"></i>
   </div>
   <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-1">No services yet</h3>
   <p class="text-sm text-slate-400 dark:text-slate-600 mb-5 max-w-xs">Create your first service to get started.</p>
   <a href="/admin/services/create" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
    <i class="lucide lucide-plus w-4 h-4"></i> Create Service
   </a>
  </div>
 </div>
 {% endif %}

 {# ── Delete Modal ── #}
 <div class="modal fixed inset-0 z-50 flex items-center justify-center hidden" id="deleteModal" tabindex="-1" role="dialog" aria-modal="true">
  <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" data-brox-dismiss="modal"></div>
  <div class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-2xl shadow-black/20 max-w-md w-full mx-4 overflow-hidden">
   <div class="flex items-center justify-between gap-3 px-5 py-4 border-b border-slate-100 dark:border-slate-800">
    <h3 class="text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2">
     <i class="lucide lucide-trash-2 w-4 h-4 text-red-600"></i>
     Delete Service
    </h3>
    <button type="button" class="inline-flex items-center justify-center w-7 h-7 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all" data-brox-dismiss="modal">
     <i class="lucide lucide-x w-4 h-4"></i>
    </button>
   </div>
   <div class="p-5">
    <p class="text-sm text-slate-600 dark:text-slate-400">Are you sure you want to delete this service? This action cannot be undone.</p>
   </div>
   <div class="flex items-center justify-end gap-3 px-5 py-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150" data-brox-dismiss="modal">Cancel</button>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 hover:bg-red-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150" id="confirmDelete">Delete</button>
   </div>
  </div>
 </div>
</div>
{% endblock %}
