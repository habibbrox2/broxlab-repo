{% extends "admin/layout.twig" %}
{% block title %}Manage Services{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4">

 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-sky-900 via-blue-900 to-slate-900 p-6 text-white shadow-2xl shadow-sky-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-sky-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-award text-xl"></i>
    </div>
    <div>
     <h1 class="text-xl font-black tracking-tight sm:text-2xl">Services Management</h1>
     <p class="mt-1 text-sm text-sky-200/80">Manage your service catalog and configurations</p>
    </div>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/services/create" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-plus-circle" style="width:0.875em;height:0.875em;"></i> Create Service
    </a>
   </div>
  </div>
 </div>

 {# ── Desktop Table View ── #}
 {% if services is not empty %}
 <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-sky-50/50 to-cyan-50/50 px-5 py-4">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-sky-100 text-sky-600">
    <i class="lucide lucide-award" style="width:0.875em;height:0.875em;"></i>
   </div>
   <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">All Services</h2>
    <p class="text-xs text-slate-500">{{ pagination.total|default(services|length) }} service(s) in catalog</p>
   </div>
  </div>
  <div class="overflow-x-auto">
   <table class="w-full text-left text-sm">
    <thead>
     <tr class="border-b border-slate-100 bg-slate-50/50">
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500" style="width:40px">
       <input type="checkbox" id="selectAll" class="w-4 h-4 border border-slate-300 rounded bg-white checked:bg-indigo-600 focus:ring-2 focus:ring-indigo-500 transition-colors cursor-pointer">
      </th>
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Name</th>
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Status</th>
      <th class="px-5 py-3 text-center text-xs font-semibold uppercase tracking-wider text-slate-500">Applications</th>
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Created</th>
      <th class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Actions</th>
     </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
     {% for service in services %}
     <tr class="transition-colors duration-150 hover:bg-sky-50/30">
      <td class="px-5 py-3.5 text-center">
       <input type="checkbox" class="w-4 h-4 border border-slate-300 rounded bg-white checked:bg-indigo-600 focus:ring-2 focus:ring-indigo-500 transition-colors cursor-pointer service-checkbox" value="{{ service.id }}">
      </td>
      <td class="px-5 py-3.5">
       <div class="flex items-center gap-3">
        <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center overflow-hidden">
         {% if service.images is defined and service.images is not empty %}
          {% set firstImage = service.images|first %}
          <img src="{{ firstImage.thumbnail_path|default(firstImage.image_path)|default('/assets/img/no-image.png') }}" class="w-full h-full object-cover" alt="{{ service.name }}">
         {% elseif service.icon %}
          <i class="{{ service.icon }} text-lg text-slate-500"></i>
         {% else %}
          <i class="lucide lucide-image text-lg text-slate-400"></i>
         {% endif %}
        </div>
        <div class="flex-1 min-w-0">
         <div class="flex items-center gap-2">
          <span class="font-semibold text-slate-900 truncate">{{ service.name }}</span>
          {% if service.is_premium is defined and service.is_premium == 1 %}
           <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700"><i class="lucide lucide-star mr-1" style="width:0.625em;height:0.625em;"></i> Premium</span>
          {% endif %}
         </div>
         <div class="text-xs text-slate-500 truncate">{{ service.slug }}</div>
        </div>
       </div>
      </td>
      <td class="px-5 py-3.5">
       {% if service.status == 'active' %}
        <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700"><i class="lucide lucide-check-circle mr-1" style="width:0.625em;height:0.625em;"></i> Active</span>
       {% elseif service.status == 'inactive' %}
        <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700"><i class="lucide lucide-pause-circle mr-1" style="width:0.625em;height:0.625em;"></i> Inactive</span>
       {% elseif service.status == 'archived' %}
        <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600"><i class="lucide lucide-archive mr-1" style="width:0.625em;height:0.625em;"></i> Archived</span>
       {% else %}
        <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">{{ service.status|capitalize }}</span>
       {% endif %}
      </td>
      <td class="px-5 py-3.5 text-center">
       <span class="inline-flex items-center justify-center rounded-full bg-sky-50 px-2.5 py-0.5 text-xs font-semibold text-sky-700">{{ service.total_applications|default(0) }}</span>
      </td>
      <td class="px-5 py-3.5 text-slate-600 text-sm">{{ service.created_at|date("d M Y") }}</td>
      <td class="px-5 py-3.5 text-right">
       <div class="inline-flex items-center gap-1.5">
        <a href="/admin/services/details/{{ service.id }}" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-600 shadow-sm transition-all hover:bg-slate-50 hover:-translate-y-0.5" title="View">
         <i class="lucide lucide-eye" style="width:0.75em;height:0.75em;"></i>
        </a>
        <a href="/admin/services/{{ service.id }}/edit" class="inline-flex items-center justify-center rounded-lg bg-amber-500 px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm transition-all hover:bg-amber-600 hover:-translate-y-0.5" title="Edit">
         <i class="lucide lucide-pencil" style="width:0.75em;height:0.75em;"></i>
        </a>
        <button type="button" class="inline-flex items-center justify-center rounded-lg bg-rose-600 px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm transition-all hover:bg-rose-700 hover:-translate-y-0.5 delete-service" data-id="{{ service.id }}" title="Delete">
         <i class="lucide lucide-trash-2" style="width:0.75em;height:0.75em;"></i>
        </button>
       </div>
      </td>
     </tr>
     {% endfor %}
    </tbody>
   </table>
  </div>

  {# ── Mobile Card View (hidden on desktop) ── #}
  <div class="block lg:hidden border-t border-slate-100">
   {% for service in services %}
   <article class="p-4 border-b border-slate-100 last:border-b-0">
    <div class="flex items-start gap-3 mb-3">
     <div class="flex-shrink-0 w-14 h-14 rounded-lg bg-slate-100 flex items-center justify-center overflow-hidden">
      {% if service.images is defined and service.images is not empty %}
       {% set firstImage = service.images|first %}
       <img src="{{ firstImage.thumbnail_path|default(firstImage.image_path)|default('/assets/img/no-image.png') }}" class="w-full h-full object-cover" alt="{{ service.name }}">
      {% elseif service.icon %}
       <i class="{{ service.icon }} text-xl text-slate-500"></i>
      {% else %}
       <i class="lucide lucide-image text-xl text-slate-400"></i>
      {% endif %}
     </div>
     <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-1">
       <span class="text-xs font-medium text-slate-500">#{{ service.id }}</span>
       {% if service.status == 'active' %}
        <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700">Active</span>
       {% elseif service.status == 'inactive' %}
        <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700">Inactive</span>
       {% elseif service.status == 'archived' %}
        <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600">Archived</span>
       {% endif %}
      </div>
      <h6 class="font-semibold text-slate-900 mb-0.5 truncate">{{ service.name }}</h6>
      <p class="text-xs text-slate-500 truncate">{{ service.slug }}</p>
      {% if service.is_premium is defined and service.is_premium == 1 %}
       <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700"><i class="lucide lucide-star mr-1" style="width:0.625em;height:0.625em;"></i> Premium</span>
      {% endif %}
     </div>
    </div>
    <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
     <span class="inline-flex items-center gap-1 rounded-full bg-sky-50 px-2 py-0.5 text-xs font-semibold text-sky-700"><i class="lucide lucide-users" style="width:0.75em;height:0.75em;"></i> Apps: {{ service.total_applications|default(0) }}</span>
     <span><i class="lucide lucide-calendar mr-1" style="width:0.75em;height:0.75em;"></i>{{ service.created_at|date("d M Y") }}</span>
    </div>
    <div class="flex gap-2">
     <a href="/admin/services/details/{{ service.id }}" class="inline-flex items-center justify-center gap-1 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 shadow-sm transition-all hover:bg-slate-50 flex-1"><i class="lucide lucide-eye" style="width:0.75em;height:0.75em;"></i> View</a>
     <a href="/admin/services/{{ service.id }}/edit" class="inline-flex items-center justify-center gap-1 rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition-all hover:bg-amber-600 flex-1"><i class="lucide lucide-pencil" style="width:0.75em;height:0.75em;"></i> Edit</a>
     <button type="button" class="inline-flex items-center justify-center gap-1 rounded-lg bg-rose-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition-all hover:bg-rose-700 flex-1 delete-service" data-id="{{ service.id }}"><i class="lucide lucide-trash-2" style="width:0.75em;height:0.75em;"></i> Delete</button>
    </div>
   </article>
   {% endfor %}
  </div>

  {# ── Pagination ── #}
  {% if pagination.total_pages > 1 %}
  <div class="border-t border-slate-100 px-5 py-4">
   <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
    <small class="text-xs text-slate-500">
     Showing {{ (pagination.current_page - 1) * pagination.limit + 1 }} to {{ min(pagination.current_page * pagination.limit, pagination.total) }} of {{ pagination.total }}
    </small>
    <nav class="inline-flex items-center gap-1" aria-label="Pagination">
     {% if pagination.has_previous %}
      <a href="/admin/services?page=1" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-600 shadow-sm transition-all hover:bg-slate-50">First</a>
      <a href="/admin/services?page={{ pagination.previous_page }}" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-600 shadow-sm transition-all hover:bg-slate-50">
       <i class="lucide lucide-chevron-left" style="width:0.75em;height:0.75em;"></i>
      </a>
     {% endif %}
     {% for page in range(max(1, pagination.current_page - 2), min(pagination.total_pages, pagination.current_page + 2)) %}
      <a href="/admin/services?page={{ page }}" class="inline-flex items-center justify-center rounded-lg px-3 py-1.5 text-xs font-semibold shadow-sm transition-all {{ page == pagination.current_page ? 'bg-indigo-600 text-white' : 'border border-slate-200 bg-white text-slate-600 hover:bg-slate-50' }}">{{ page }}</a>
     {% endfor %}
     {% if pagination.has_next %}
      <a href="/admin/services?page={{ pagination.next_page }}" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-600 shadow-sm transition-all hover:bg-slate-50">
       <i class="lucide lucide-chevron-right" style="width:0.75em;height:0.75em;"></i>
      </a>
      <a href="/admin/services?page={{ pagination.total_pages }}" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-600 shadow-sm transition-all hover:bg-slate-50">Last</a>
     {% endif %}
    </nav>
   </div>
  </div>
  {% endif %}
 </section>
 {% else %}
 <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white p-8 shadow-sm">
  <div class="text-center">
   <i class="lucide lucide-inbox text-slate-300 mx-auto" style="width:3em;height:3em;"></i>
   <h3 class="mt-4 text-lg font-bold text-slate-900">No services yet</h3>
   <p class="mt-1 text-sm text-slate-500">Create your first service to get started.</p>
   <a href="/admin/services/create" class="mt-4 inline-flex items-center gap-2 rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:bg-sky-700 hover:shadow-md">
    <i class="lucide lucide-plus-circle" style="width:1em;height:1em;"></i> Create Service
   </a>
  </div>
 </section>
 {% endif %}

 {# ── Delete Modal ── #}
 <div class="modal fixed inset-0 z-50 flex items-center justify-center hidden" id="deleteModal" tabindex="-1" role="dialog" aria-modal="true">
  <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" data-brox-dismiss="modal"></div>
  <div class="relative bg-white rounded-2xl shadow-2xl max-w-md w-full mx-4 overflow-hidden transform transition-all">
   <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
    <h6 class="font-semibold text-slate-900 flex items-center gap-2">
     <i class="lucide lucide-trash-2 text-red-600" style="width:1.125em;height:1.125em;"></i>
     Delete Service
    </h6>
    <button type="button" class="inline-flex items-center justify-center w-7 h-7 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-all" data-brox-dismiss="modal">
     <i class="lucide lucide-x" style="width:1em;height:1em;"></i>
    </button>
   </div>
   <div class="p-5">
    <p class="text-sm text-slate-600">Are you sure you want to delete this service? This action cannot be undone.</p>
   </div>
   <div class="flex items-center justify-end gap-3 border-t border-slate-200 px-5 py-4 bg-slate-50">
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition-all hover:bg-slate-50" data-brox-dismiss="modal">Cancel</button>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:bg-red-700" id="confirmDelete">Delete</button>
   </div>
  </div>
 </div>
</div>
{% endblock %}
