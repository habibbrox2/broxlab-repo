{% extends"admin/layout.twig" %}
{% block title %}Manage Services{% endblock %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-list"></i>
 Services Management
 </div>
 <div>
 <small>Manage your service catalog</small>
 </div>
 </div>

 <div class="flex justify-end mb-4">
 <a href="/admin/services/create" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
 <i class="lucide lucide-plus mr-2"></i>Create Service
 </a>
 </div>

 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class="p-4 p-0">
 {% if services is not empty %}
 <div class=" overflow-x-auto">
 <table class="table table-stacked table-hover align-middle mb-0">
 <thead class="table-light">
 <tr>
 <th><input type="checkbox" id="selectAll" class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"></th>
 <th>Name</th>
 <th>Status</th>
 <th>Applications</th>
 <th>Created</th>
 <th class="text-right">Actions</th>
 </tr>
 </thead>
 <tbody>
 {% for service in services %}
 <tr>
 <td data-label="Select">
 <input type="checkbox" class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 service-checkbox" value="{{ service.id }}">
 </td>
 <td data-label="Name">
 <div class="flex items-center gap-3">
 <div>
 {% if service.images is defined and service.images is not empty %}
 <div id="svcCarousel-{{ service.id }}" class="carousel slide  overflow-hidden" data-brox-ride="carousel">
 <div class="carousel-inner">
 {% for img in service.images %}
 <div class="carousel-item {{ loop.first ? 'active' : '' }}">
 <img src="{{ img.thumbnail_path|default(img.image_path)|default('/assets/img/no-image.png') }}" class="block w-full " alt="{{ service.name }}">
 </div>
 {% endfor %}
 </div>
 </div>
 {% elseif service.icon %}
 <div class="bg-slate-100 flex items-center justify-center  ">
 <i class="{{ service.icon }} text-2xl text-slate-500"></i>
 </div>
 {% else %}
 <div class="bg-slate-100 flex items-center justify-center  ">
 <i class="lucide lucide-image text-2xl text-slate-500"></i>
 </div>
 {% endif %}
 </div>
 <div class="flex-grow-1">
 <div class="flex items-center gap-2">
 <strong>{{ service.name }}</strong>
 {% if service.is_premium is defined and service.is_premium == 1 %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-amber-500 text-surface-dark"><i class="lucide lucide-star mr-1"></i> Premium</span>
 {% endif %}
 </div>
 <div><small class="text-slate-500">{{ service.slug }}</small></div>
 </div>
 </div>
 </td>
 <td data-label="Status">
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {% if service.status == 'active' %}bg-emerald-600 elseif 'inactive' %}bg-amber-500 'archived' %}bg-sky-500 else %}bg-slate-100 text-surface-dark{% endif %}">
 {{ service.status|capitalize }}
 </span>
 </td>
 <td data-label="Applications">
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-sky-500">{{ service.total_applications|default(0) }}</span>
 </td>
 <td data-label="Created" class="text-slate-500 small">{{ service.created_at|date("d M Y") }}</td>
 <td class="text-right" data-label="Actions">
 <a href="/admin/services/details/{{ service.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs bg-sky-500 text-white hover:bg-sky-600"><i class="lucide lucide-eye"></i></a>
 <a href="/admin/services/{{ service.id }}/edit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs bg-amber-500 text-black hover:bg-amber-600"><i class="lucide lucide-pencil"></i></a>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs bg-red-600 text-white hover:bg-red-700 delete-service" data-id="{{ service.id }}"><i class="lucide lucide-trash-2"></i></button>
 </td>
 </tr>
 {% endfor %}
 </tbody>
 </table>
 </div>

 <div class=" border border-slate-200 bg-white ">
 {% for service in services %}
 <article class=" border border-slate-200 bg-white shadow-sm">
 <div class="flex items-start gap-3 mb-2">
 <div class=" flex-shrink-0">
 {% if service.images is defined and service.images is not empty %}
 {% set firstImage = service.images|first %}
 <img src="{{ firstImage.thumbnail_path|default(firstImage.image_path)|default('/assets/img/no-image.png') }}" class="block w-full  " alt="{{ service.name }}">
 {% elseif service.icon %}
 <div class="bg-slate-100 flex items-center justify-center  ">
 <i class="{{ service.icon }} text-2xl text-slate-500"></i>
 </div>
 {% else %}
 <div class="bg-slate-100 flex items-center justify-center  ">
 <i class="lucide lucide-image text-2xl text-slate-500"></i>
 </div>
 {% endif %}
 </div>

 <div class="flex-grow-1">
 <div class=" mb-1">
 <span class=" border border-slate-200 bg-white ">#{{ service.id }}</span>
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {% if service.status == 'active' %}bg-emerald-600{% elseif 'inactive' %}bg-amber-500 text-surface-dark{% 'archived' %}bg-sky-500{% else %}bg-slate-100 endif %}">
 {{ service.status|capitalize }}
 </span>
 </div>
 <h6 class=" mb-1">{{ service.name }}</h6>
 <p class="text-slate-500 small mb-1">{{ service.slug }}</p>
 {% if service.is_premium is defined and service.is_premium == 1 %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-amber-500 text-surface-dark"><i class="lucide lucide-star mr-1"></i>Premium</span>
 {% endif %}
 </div>
 </div>

 <div class=" border border-slate-200 bg-white ">
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-sky-500">Apps: {{ service.total_applications|default(0) }}</span>
 <span class="text-slate-500 small"><i class="lucide lucide-calendar mr-1"></i>{{ service.created_at|date("d M Y") }}</span>
 </div>

 <div class=" border border-slate-200 bg-white ">
 <a href="/admin/services/details/{{ service.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs bg-sky-500 text-white hover:bg-sky-600"><i class="lucide lucide-eye mr-1"></i>View</a>
 <a href="/admin/services/{{ service.id }}/edit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs bg-amber-500 text-black hover:bg-amber-600"><i class="lucide lucide-pencil mr-1"></i>Edit</a>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs bg-red-600 text-white hover:bg-red-700 delete-service" data-id="{{ service.id }}"><i class="lucide lucide-trash-2 mr-1"></i>Delete</button>
 </div>
 </article>
 {% endfor %}
 </div>

 {% if pagination.total_pages > 1 %}
 <nav class="flex justify-between items-center p-3 border-top">
 <small class="text-slate-500">Showing {{ (pagination.current_page - 1) * pagination.limit + 1 }} to {{ min(pagination.current_page * pagination.limit, pagination.total) }} of {{ pagination.total }}</small>
 <ul class="pagination mb-0">
 {% if pagination.has_previous %}
 <li class="page-item"><a class="page-link" href="/admin/services?page=1">First</a></li>
 <li class="page-item"><a class="page-link" href="/admin/services?page={{ pagination.previous_page }}">Previous</a></li>
 {% endif %}
 {% for page in range(max(1, pagination.current_page - 2), min(pagination.total_pages, pagination.current_page + 2)) %}
 <li class="page-item {{ page == pagination.current_page ? 'active' }}"><a class="page-link" href="/admin/services?page={{ page }}">{{ page }}</a></li>
 {% endfor %}
 {% if pagination.has_next %}
 <li class="page-item"><a class="page-link" href="/admin/services?page={{ pagination.next_page }}">Next</a></li>
 <li class="page-item"><a class="page-link" href="/admin/services?page={{ pagination.total_pages }}">Last</a></li>
 {% endif %}
 </ul>
 </nav>
 {% endif %}
 {% else %}
 <div class="p-5 text-center">
 <i class="lucide lucide-inbox text-4xl text-slate-500 mb-3 block"></i>
 <p class="text-slate-500 mb-0">No services yet. <a href="/admin/services/create">Create the first one</a></p>
 </div>
 {% endif %}
 </div>
 </div>

 <div class="modal fade" id="deleteModal" tabindex="-1">
 <div class="modal-dialog">
 <div class="modal-content border-0 rounded-2xl shadow-lg">
 <div class="modal-header border-bottom fw-600">
 <h6 class="modal-title"><i class="lucide lucide-trash mr-2 text-red-600"></i>Delete Service</h6>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition" data-brox-dismiss="modal"></button>
 </div>
 <div class="modal-body">
 <p>Are you sure you want to delete this service? This action cannot be undone.</p>
 </div>
 <div class="modal-footer border-top">
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200 px-3 py-1.5 text-xs" data-brox-dismiss="modal">Cancel</button>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 px-3 py-1.5 text-xs" id="confirmDelete">Delete</button>
 </div>
 </div>
 </div>
 </div>
 </div>
{% endblock %}





