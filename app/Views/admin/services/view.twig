{% extends"admin/layout.twig" %}
{% block title %}{{ service.name }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-columns mr-2"></i>
 Service Details
 </div>
 <div>View service information</div>
 </div>

 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="lg:col-span-8">
 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class=" border-slate-200 px-4 py-3">
 <h4 class="mb-0">{{ service.name }}</h4>
 </div>
 <div class="p-4">
 <p class="text-slate-500 mb-2">{{ service.slug }}</p>
 <div class="mb-3">{{ service.description|raw }}</div>
 <div class="flex flex-wrap gap-2">
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {% if service.status == 'active' %}bg-emerald-600 elseif 'inactive' %}bg-amber-500 text-surface-dark 'archived' %}bg-sky-500 else %}bg-slate-100 text-surface-dark{% endif %}">
 {{ service.status|capitalize }}
 </span>
 {% if service.is_premium is defined and service.is_premium == 1 %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-amber-500 text-surface-dark">Premium</span>
 {% endif %}
 {% if service.requires_documents %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-600">Documents Required</span>
 {% endif %}
 </div>
 </div>
 </div>

 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class=" border-slate-200 px-4 py-3">
 <h6 class=" mb-0">Form Fields</h6>
 </div>
 <div class="p-4">
 {% if form_fields is not empty %}
 <div class="overflow-x-auto">
 <table class="table">
 <thead>
 <tr>
 <th>Label</th>
 <th>Type</th>
 <th>Required</th>
 <th>Order</th>
 </tr>
 </thead>
 <tbody>
 {% for field in form_fields %}
 <tr>
 <td>{{ field.label }}</td>
 <td>{{ field.field_type }}</td>
 <td>{{ field.required ? 'Yes' : 'No' }}</td>
 <td>{{ field.field_order }}</td>
 </tr>
 {% endfor %}
 </tbody>
 </table>
 </div>
 {% else %}
 <p class="text-slate-500 mb-0">No form fields configured for this service.</p>
 {% endif %}
 </div>
 </div>
 </div>

 <div class="lg:col-span-4">
 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class=" border-slate-200 px-4 py-3">
 <h6 class=" mb-0"><i class="lucide lucide-bar-chart-3"></i>Statistics</h6>
 </div>
 <div class="p-4">
 <div class=" border border-slate-200 bg-white shadow-sm text-center py-4 mb-3">
 <small class="stat-label block mb-2">Total Applications</small>
 <strong class="stat-value text-4xl text-indigo-600">{{ service.total_applications|default(0) }}</strong>
 </div>
 <a href="/admin/applications?service_id={{ service.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 w-full px-3 py-1.5 text-xs">
 <i class="lucide lucide-list mr-1"></i>View All
 </a>
 </div>
 </div>

 <div class=" border border-slate-200 bg-white shadow-sm mb-4">
 <div class=" border-slate-200 px-4 py-3">
 <h6 class=" mb-0"><i class="lucide lucide-clock"></i>Metadata</h6>
 </div>
 <div class="p-4 small">
 <div class="flex justify-between py-2 border-b border-slate-200">
 <span class="text-slate-500">Service ID</span>
 <code>{{ service.id }}</code>
 </div>
 <div class="flex justify-between py-2 border-b border-slate-200">
 <span class="text-slate-500">Created</span>
 <span>{{ service.created_at|date("d M Y H:i") }}</span>
 </div>
 <div class="flex justify-between py-2">
 <span class="text-slate-500">Updated</span>
 <span>{{ service.updated_at|date("d M Y H:i") }}</span>
 </div>
 </div>
 </div>

 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class=" border-slate-200 px-4 py-3">
 <h6 class=" mb-0"><i class="lucide lucide-zap"></i>Quick Actions</h6>
 </div>
 <div class="p-4 flex flex-column gap-2">
 <a href="/admin/services/{{ service.id }}/edit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 px-3 py-1.5 text-xs"><i class="lucide lucide-pencil mr-1"></i>Edit</a>
 <a href="/admin/services" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200 px-3 py-1.5 text-xs"><i class="lucide lucide-arrow-left mr-1"></i>Back to Services</a>
 </div>
 </div>
 </div>
 </div>
 </div>
{% endblock %}





