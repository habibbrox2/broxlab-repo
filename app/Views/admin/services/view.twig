{% extends "admin/layout.twig" %}
{% block title %}{{ service.name }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
  <div class="container-fluid py-4">
    <div class="admin-page-header mb-4">
      <div class="admin-page-title">
        <i class="bi bi-grid-1x2-fill me-2"></i>
        Service Details
      </div>
      <div class="admin-page-subtitle">View service information</div>
    </div>

    <div class="row g-4">
      <div class="col-lg-8">
        <div class="admin-panel-card mb-4">
          <div class="admin-panel-card-header">
            <h4 class="mb-0">{{ service.name }}</h4>
          </div>
          <div class="admin-panel-card-body">
            <p class="text-muted mb-2">{{ service.slug }}</p>
            <div class="mb-3">{{ service.description|raw }}</div>
            <div class="d-flex flex-wrap gap-2">
              <span class="badge {% if service.status == 'active' %}bg-success {% elseif service.status == 'inactive' %}bg-warning text-surface-dark {% elseif service.status == 'archived' %}bg-info {% else %}bg-light text-surface-dark{% endif %}">
                {{ service.status|capitalize }}
              </span>
              {% if service.is_premium is defined and service.is_premium == 1 %}
                <span class="badge bg-warning text-surface-dark">Premium</span>
              {% endif %}
              {% if service.requires_documents %}
                <span class="badge bg-secondary">Documents Required</span>
              {% endif %}
            </div>
          </div>
        </div>

        <div class="admin-panel-card mb-4">
          <div class="admin-panel-card-header">
            <h6 class="admin-panel-card-title mb-0">Form Fields</h6>
          </div>
          <div class="admin-panel-card-body">
            {% if form_fields is not empty %}
              <div class="table-responsive">
                <table class="table table-sm">
                  <thead>
                    <tr>
                      <th>Label</th>
                      <th>Type</th>
                      <th>Required</th>
                      <th>Order</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for field in form_fields %}
                      <tr>
                        <td>{{ field.label }}</td>
                        <td>{{ field.field_type }}</td>
                        <td>{{ field.required ? 'Yes' : 'No' }}</td>
                        <td>{{ field.field_order }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            {% else %}
              <p class="text-muted mb-0">No form fields configured for this service.</p>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="admin-panel-card mb-4">
          <div class="admin-panel-card-header">
            <h6 class="admin-panel-card-title mb-0"><i class="bi bi-bar-chart-fill"></i>Statistics</h6>
          </div>
          <div class="admin-panel-card-body">
            <div class="stat-card text-center py-4 mb-3">
              <small class="stat-label d-block mb-2">Total Applications</small>
              <strong class="stat-value fs-1 text-primary">{{ service.total_applications|default(0) }}</strong>
            </div>
            <a href="/admin/applications?service_id={{ service.id }}" class="modern-btn modern-btn-primary w-100 btn-sm">
              <i class="bi bi-list me-1"></i>View All
            </a>
          </div>
        </div>

        <div class="admin-panel-card mb-4">
          <div class="admin-panel-card-header">
            <h6 class="admin-panel-card-title mb-0"><i class="bi bi-clock-history"></i>Metadata</h6>
          </div>
          <div class="admin-panel-card-body small">
            <div class="d-flex justify-content-between py-2 border-bottom">
              <span class="text-muted">Service ID</span>
              <code>{{ service.id }}</code>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom">
              <span class="text-muted">Created</span>
              <span>{{ service.created_at|date("d M Y H:i") }}</span>
            </div>
            <div class="d-flex justify-content-between py-2">
              <span class="text-muted">Updated</span>
              <span>{{ service.updated_at|date("d M Y H:i") }}</span>
            </div>
          </div>
        </div>

        <div class="admin-panel-card">
          <div class="admin-panel-card-header">
            <h6 class="admin-panel-card-title mb-0"><i class="bi bi-lightning-fill"></i>Quick Actions</h6>
          </div>
          <div class="admin-panel-card-body d-flex flex-column gap-2">
            <a href="/admin/services/{{ service.id }}/edit" class="modern-btn modern-btn-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a href="/admin/services" class="modern-btn modern-btn-white btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Services</a>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
