{% extends "admin/layout.twig" %}
{% block title %}{{ service.name }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4">

 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-sky-900 via-blue-900 to-slate-900 p-6 text-white shadow-2xl shadow-sky-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-sky-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3 min-w-0">
    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-award text-xl"></i>
    </div>
    <div class="min-w-0">
     <h1 class="text-xl font-black tracking-tight sm:text-2xl truncate">{{ service.name }}</h1>
     <p class="mt-1 text-sm text-sky-200/80">Service details and configuration</p>
    </div>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/services/{{ service.id }}/edit" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-pencil" style="width:0.875em;height:0.875em;"></i> Edit
    </a>
    <a href="/admin/services" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-arrow-left" style="width:0.875em;height:0.875em;"></i> Back to Services
    </a>
   </div>
  </div>
 </div>

 <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  {# ── Main Content Column ── #}
  <div class="lg:col-span-2 space-y-6">
   {# ── Service Info Card ── #}
   <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
      <i class="lucide lucide-info" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Service Information</h2>
      <p class="text-xs text-slate-500">Basic details and description</p>
     </div>
    </div>
    <div class="p-5 space-y-4">
     <div class="flex flex-wrap items-center gap-2">
      <code class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-600">{{ service.slug }}</code>
      {% if service.status == 'active' %}
       <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700"><i class="lucide lucide-check-circle mr-1" style="width:0.75em;height:0.75em;"></i> Active</span>
      {% elseif service.status == 'inactive' %}
       <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700"><i class="lucide lucide-pause-circle mr-1" style="width:0.75em;height:0.75em;"></i> Inactive</span>
      {% elseif service.status == 'archived' %}
       <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600"><i class="lucide lucide-archive mr-1" style="width:0.75em;height:0.75em;"></i> Archived</span>
      {% endif %}
      {% if service.is_premium is defined and service.is_premium == 1 %}
       <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700"><i class="lucide lucide-crown mr-1" style="width:0.75em;height:0.75em;"></i> Premium</span>
      {% endif %}
      {% if service.requires_documents %}
       <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-semibold text-indigo-700"><i class="lucide lucide-file-text mr-1" style="width:0.75em;height:0.75em;"></i> Documents Required</span>
      {% endif %}
     </div>
     <div class="prose prose-sm max-w-none prose-headings:text-slate-900 prose-a:text-indigo-600">
      {{ service.description|raw }}
     </div>
    </div>
   </section>

   {# ── Form Fields Card ── #}
   <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-emerald-50/50 to-teal-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-emerald-100 text-emerald-600">
      <i class="lucide lucide-file-text" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Form Fields</h2>
      <p class="text-xs text-slate-500">Application form configuration</p>
     </div>
    </div>
    <div class="p-0">
     {% if form_fields is not empty %}
     <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
       <thead>
        <tr class="border-b border-slate-100 bg-slate-50/50">
         <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Label</th>
         <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Type</th>
         <th class="px-5 py-3 text-center text-xs font-semibold uppercase tracking-wider text-slate-500">Required</th>
         <th class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Order</th>
        </tr>
       </thead>
       <tbody class="divide-y divide-slate-100">
        {% for field in form_fields %}
        <tr class="transition-colors hover:bg-slate-50/30">
         <td class="px-5 py-3 font-medium text-slate-900">{{ field.label }}</td>
         <td class="px-5 py-3">
          <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600">{{ field.field_type }}</span>
         </td>
         <td class="px-5 py-3 text-center">
          {% if field.required %}
           <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700">Yes</span>
          {% else %}
           <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-500">No</span>
          {% endif %}
         </td>
         <td class="px-5 py-3 text-right text-slate-600">{{ field.field_order }}</td>
        </tr>
        {% endfor %}
       </tbody>
      </table>
     </div>
     {% else %}
     <div class="flex flex-col items-center justify-center py-8 text-slate-400">
      <i class="lucide lucide-file-text mb-2" style="width:2em;height:2em;"></i>
      <p class="text-sm">No form fields configured for this service.</p>
     </div>
     {% endif %}
    </div>
   </section>
  </div>

  {# ── Sidebar Column ── #}
  <div class="space-y-6">
   {# ── Statistics Card ── #}
   <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
      <i class="lucide lucide-bar-chart-3" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Statistics</h2>
      <p class="text-xs text-slate-500">Application metrics</p>
     </div>
    </div>
    <div class="p-5 space-y-4">
     <div class="rounded-xl bg-indigo-50 border border-indigo-100 p-5 text-center">
      <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600 mb-1">Total Applications</p>
      <p class="text-4xl font-black text-indigo-700">{{ service.total_applications|default(0) }}</p>
     </div>
     <a href="/admin/applications?service_id={{ service.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 w-full px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-indigo-700 hover:shadow-md active:scale-95">
      <i class="lucide lucide-list" style="width:1em;height:1em;"></i> View All Applications
     </a>
    </div>
   </section>

   {# ── Metadata Card ── #}
   <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
    <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-100/50 to-slate-200/50 px-5 py-4">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-slate-200 text-slate-600">
      <i class="lucide lucide-clock" style="width:0.875em;height:0.875em;"></i>
     </div>
     <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Metadata</h2>
      <p class="text-xs text-slate-500">Timestamps and system info</p>
     </div>
    </div>
    <div class="p-5 space-y-3 text-sm">
     <div class="flex items-center justify-between">
      <span class="text-slate-500">Service ID</span>
      <code class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600">{{ service.id }}</code>
     </div>
     <div class="flex items-center justify-between border-t border-slate-100 pt-3">
      <span class="text-slate-500">Created</span>
      <span class="font-medium text-slate-900">{{ service.created_at|date("d M Y H:i") }}</span>
     </div>
     <div class="flex items-center justify-between border-t border-slate-100 pt-3">
      <span class="text-slate-500">Updated</span>
      <span class="font-medium text-slate-900">{{ service.updated_at|date("d M Y H:i") }}</span>
     </div>
    </div>
   </section>

   {# ── Quick Actions Card ── #}
   <section class="scroll-fade-in overflow-hidden rounded-xl border border-sky-200 bg-gradient-to-br from-sky-50/50 to-sky-100/50 shadow-sm">
    <div class="p-5 space-y-3">
     <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
      <i class="lucide lucide-zap text-sky-600" style="width:1em;height:1em;"></i>
      Quick Actions
     </h3>
     <a href="/admin/services/{{ service.id }}/edit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 w-full px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:bg-indigo-700 hover:shadow-md active:scale-95">
      <i class="lucide lucide-pencil" style="width:1em;height:1em;"></i> Edit Service
     </a>
     <a href="/admin/services/create" class="inline-flex items-center justify-center gap-2 rounded-lg bg-white border border-slate-300 w-full px-4 py-2.5 text-sm font-semibold text-slate-900 transition-all duration-200 hover:bg-slate-50 hover:border-slate-400 active:scale-95">
      <i class="lucide lucide-plus-circle" style="width:1em;height:1em;"></i> Create New Service
     </a>
    </div>
   </section>
  </div>
 </div>
</div>
{% endblock %}
