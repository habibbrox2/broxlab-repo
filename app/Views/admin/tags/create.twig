{% extends"admin/layout.twig" %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block title %}Create New Tag{% endblock %}
{% block content %}
<div class="space-y-6">
 <section class="admin-page-header">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-tag"></i>
     Tags
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Create New Tag</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600">Add a tag for labeling content.</p>
   </div>
   <a href="/admin/tags" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
    <i class="lucide lucide-arrow-left"></i> Back to Tags
   </a>
  </div>
 </section>

 <section class="admin-panel-card max-w-3xl">
  <form method="post" action="/admin/tags/create" id="tagForm" class="space-y-4">
   <div>
    <label class="form-label">Tag Name <span class="text-rose-600">*</span></label>
    <input type="text" name="name" id="tagName" placeholder="e.g., JavaScript, PHP, Web Development" required class="modern-input w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
    <div class="mt-1 text-sm text-slate-500"><i class="lucide lucide-info mr-1"></i> Enter a descriptive tag name.</div>
   </div>
   <div>
    <label class="form-label">URL Slug <span class="text-rose-600">*</span></label>
    <div class="flex overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
     <span class="inline-flex items-center border-r border-slate-200 bg-slate-50 px-3 text-slate-400"><i class="lucide lucide-link"></i></span>
     <input type="text" name="slug" id="tagSlug" placeholder="auto-generated-slug" class="modern-input w-full border-0 px-4 py-3 text-sm shadow-none focus:ring-0">
    </div>
    <div id="slug-feedback" class="mt-1 text-sm text-slate-500"></div>
   </div>
   <div class="flex flex-wrap justify-end gap-2">
    <a href="/admin/tags" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">Cancel</a>
    <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
     <i class="lucide lucide-check"></i> Create Tag
    </button>
   </div>
  </form>
 </section>
</div>
{% endblock %}
{% block scripts %}{% endblock %}
