{% extends"admin/layout.twig" %}
{% block title %}{{ title }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="space-y-6">
 <section class="admin-page-header">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
   <div>
    <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
     <i class="lucide lucide-tag"></i>
     Tags
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Manage tags</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-600">Keep post metadata organized and searchable.</p>
   </div>
   <a href="/admin/tags/create" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
    <i class="lucide lucide-plus-circle"></i>
    Add New Tag
   </a>
  </div>
 </section>

 <section class="admin-panel-card">
  <form method="get" class="grid gap-4 lg:grid-cols-12">
   <div class="lg:col-span-4">
    <label class="form-label" for="tag-search">Search</label>
    <div class="flex overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
     <span class="inline-flex items-center border-r border-slate-200 bg-slate-50 px-3 text-slate-400"><i class="lucide lucide-search"></i></span>
     <input id="tag-search" type="text" name="search" value="{{ pagination.search|default('') }}" class="w-full border-0 px-4 py-3 text-sm shadow-none focus:ring-0" placeholder="Search by name...">
    </div>
   </div>
   <div class="lg:col-span-2">
    <label class="form-label" for="tag-sort">Sort By</label>
    <select id="tag-sort" name="sort">
     <option value="name" {% if pagination.sort == 'name' %}selected{% endif %}>Name</option>
     <option value="id" {% if pagination.sort == 'id' %}selected{% endif %}>ID</option>
    </select>
   </div>
   <div class="lg:col-span-2">
    <label class="form-label" for="tag-order">Order</label>
    <select id="tag-order" name="order">
     <option value="ASC" {% if pagination.order == 'ASC' %}selected{% endif %}>A-Z</option>
     <option value="DESC" {% if pagination.order == 'DESC' %}selected{% endif %}>Z-A</option>
    </select>
   </div>
   <div class="lg:col-span-2">
    <label class="form-label" for="tag-limit">Limit</label>
    <select id="tag-limit" name="limit">
     <option value="10" {% if pagination.limit == 10 %}selected{% endif %}>10</option>
     <option value="20" {% if pagination.limit == 20 %}selected{% endif %}>20</option>
     <option value="50" {% if pagination.limit == 50 %}selected{% endif %}>50</option>
     <option value="100" {% if pagination.limit == 100 %}selected{% endif %}>100</option>
    </select>
   </div>
   <div class="lg:col-span-2 flex items-end">
    <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
     <i class="lucide lucide-filter"></i>
     Apply
    </button>
   </div>
  </form>
 </section>

 {% if tags is not empty %}
 <section class="admin-panel-card">
  <div class="flex items-center justify-between border-b border-slate-200/80 pb-4">
   <div>
    <h2 class="text-lg font-semibold text-slate-950">All Tags</h2>
    <p class="mt-1 text-sm text-slate-500">Name, slug, and management actions.</p>
   </div>
  </div>
  <div class="table-responsive mt-5">
   <table class="table">
    <thead>
     <tr>
      <th>ID</th>
      <th>Name</th>
      <th>URL Slug</th>
      <th class="text-center">Actions</th>
     </tr>
    </thead>
    <tbody>
     {% for tag in tags %}
     <tr>
      <td data-label="ID"><span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">{{ tag.id }}</span></td>
      <td data-label="Name">
       <div class="flex items-center gap-2">
        <i class="lucide lucide-bookmark text-indigo-500"></i>
        <strong class="text-slate-900">{{ tag.name }}</strong>
       </div>
      </td>
      <td data-label="URL Slug"><code class="rounded-lg bg-slate-100 px-3 py-1 text-xs text-slate-600">{{ tag.slug }}</code></td>
      <td data-label="Actions" class="text-center">
       <div class="inline-flex flex-wrap justify-center gap-2">
        <a href="/admin/tags/edit/{{ tag.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" title="Edit Tag"><i class="lucide lucide-pencil"></i>Edit</a>
        <a href="/admin/tags/delete/{{ tag.id }}" class="inline-flex items-center justify-center gap-2 rounded-lg bg-rose-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-rose-700" title="Delete Tag" onclick="return confirm('Are you sure you want to delete this tag? This action cannot be undone.')"><i class="lucide lucide-trash-2"></i>Delete</a>
       </div>
      </td>
     </tr>
     {% endfor %}
    </tbody>
   </table>
  </div>

  <div class="mt-6">{% include"admin/partials/pagination.twig" %}</div>
 </section>
 {% else %}
 <section class="admin-panel-card text-center">
  <i class="lucide lucide-inbox text-3xl text-slate-300"></i>
  <p class="mt-3 text-slate-500"><strong>No tags found.</strong> Start by creating your first tag!</p>
  <a href="/admin/tags/create" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700 mt-4">
   <i class="lucide lucide-plus-circle"></i>
   Create First Tag
  </a>
 </section>
 {% endif %}
</div>
{% endblock %}
