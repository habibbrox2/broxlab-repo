{% extends "admin/layout.twig" %}
{% block title %}{{ title }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4">

 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-violet-900 via-purple-900 to-slate-900 p-6 text-white shadow-2xl shadow-violet-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-purple-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-tag text-xl"></i>
    </div>
    <div>
     <h1 class="text-xl font-black tracking-tight sm:text-2xl">Manage Tags</h1>
     <p class="mt-1 text-sm text-violet-200/80">Keep post metadata organized and searchable.</p>
    </div>
   </div>
   <div class="flex flex-wrap gap-2">
    <a href="/admin/tags/create" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
     <i class="lucide lucide-plus-circle" style="width:0.875em;height:0.875em;"></i> Add New Tag
    </a>
   </div>
  </div>
 </div>

 {# ── Filter Section ── #}
 <section class="scroll-fade-in mb-6 overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-amber-50/50 to-orange-50/50 px-5 py-4">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-amber-100 text-amber-600">
    <i class="lucide lucide-filter" style="width:1em;height:1em;"></i>
   </div>
   <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Filter Tags</h2>
    <p class="text-xs text-slate-500">Search by name, sort, and adjust page size</p>
   </div>
  </div>
  <form class="p-5" method="get" action="">
   <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-5">
    <div>
     <label for="tag-search" class="block text-xs font-medium text-slate-500 mb-1">Search</label>
     <div class="relative">
      <i class="lucide lucide-search absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400" style="width:0.875em;height:0.875em;"></i>
      <input id="tag-search" type="text" name="search" value="{{ pagination.search|default('') }}" class="w-full rounded-lg border border-slate-300 pl-8 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" placeholder="Search by name...">
     </div>
    </div>
    <div>
     <label for="tag-sort" class="block text-xs font-medium text-slate-500 mb-1">Sort By</label>
     <select id="tag-sort" name="sort" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      <option value="name" {{ pagination.sort == 'name' ? 'selected' : '' }}>Name</option>
      <option value="id" {{ pagination.sort == 'id' ? 'selected' : '' }}>ID</option>
     </select>
    </div>
    <div>
     <label for="tag-order" class="block text-xs font-medium text-slate-500 mb-1">Order</label>
     <select id="tag-order" name="order" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      <option value="ASC" {{ pagination.order == 'ASC' ? 'selected' : '' }}>A-Z</option>
      <option value="DESC" {{ pagination.order == 'DESC' ? 'selected' : '' }}>Z-A</option>
     </select>
    </div>
    <div>
     <label for="tag-limit" class="block text-xs font-medium text-slate-500 mb-1">Per Page</label>
     <select id="tag-limit" name="limit" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
      <option value="10" {{ pagination.limit == 10 ? 'selected' : '' }}>10</option>
      <option value="20" {{ pagination.limit == 20 ? 'selected' : '' }}>20</option>
      <option value="50" {{ pagination.limit == 50 ? 'selected' : '' }}>50</option>
      <option value="100" {{ pagination.limit == 100 ? 'selected' : '' }}>100</option>
     </select>
    </div>
    <div class="flex items-end">
     <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 hover:shadow-md active:scale-[0.97] w-full">
      <i class="lucide lucide-filter" style="width:1em;height:1em;"></i> Apply
     </button>
    </div>
   </div>
  </form>
 </section>

 {# ── Tags List Table ── #}
 {% if tags is not empty %}
 <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
  <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-violet-50/50 to-fuchsia-50/50 px-5 py-4">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-violet-100 text-violet-600">
    <i class="lucide lucide-tag" style="width:1em;height:1em;"></i>
   </div>
   <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">All Tags</h2>
    <p class="text-xs text-slate-500">Name, slug, and management actions</p>
   </div>
  </div>
  <div class="overflow-x-auto">
   <table class="w-full text-left text-sm">
    <thead>
     <tr class="border-b border-slate-100 bg-slate-50/50">
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">#</th>
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Name</th>
      <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">URL Slug</th>
      <th class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Actions</th>
     </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
     {% for tag in tags %}
     <tr class="transition-colors duration-150 hover:bg-violet-50/30">
      <td class="px-5 py-3.5"><span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">{{ tag.id }}</span></td>
      <td class="px-5 py-3.5">
       <div class="flex items-center gap-2">
        <i class="lucide lucide-bookmark text-violet-500" style="width:1em;height:1em;"></i>
        <span class="font-semibold text-slate-900">{{ tag.name }}</span>
       </div>
      </td>
      <td class="px-5 py-3.5"><code class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-600">{{ tag.slug }}</code></td>
      <td class="px-5 py-3.5 text-right">
       <div class="inline-flex items-center gap-1.5">
        <a href="/admin/tags/edit/{{ tag.id }}" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-600 shadow-sm transition-all hover:bg-slate-50 hover:-translate-y-0.5" title="Edit">
         <i class="lucide lucide-pencil" style="width:0.75em;height:0.75em;"></i>
        </a>
        <a href="/admin/tags/delete/{{ tag.id }}" class="inline-flex items-center justify-center rounded-lg bg-rose-600 px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm transition-all hover:bg-rose-700 hover:-translate-y-0.5" title="Delete" onclick="return confirm('Are you sure you want to delete this tag? This action cannot be undone.')">
         <i class="lucide lucide-trash-2" style="width:0.75em;height:0.75em;"></i>
        </a>
       </div>
      </td>
     </tr>
     {% endfor %}
    </tbody>
   </table>
  </div>
  <div class="border-t border-slate-100 px-5 py-4">
   {% include "admin/partials/pagination.twig" %}
  </div>
 </section>
 {% else %}
 <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white p-8 shadow-sm">
  <div class="text-center">
   <i class="lucide lucide-tag text-slate-300 mx-auto" style="width:3em;height:3em;"></i>
   <h3 class="mt-4 text-lg font-bold text-slate-900">No tags found</h3>
   <p class="mt-1 text-sm text-slate-500">Start by creating your first tag!</p>
   <a href="/admin/tags/create" class="mt-4 inline-flex items-center gap-2 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:bg-violet-700 hover:shadow-md">
    <i class="lucide lucide-plus-circle" style="width:1em;height:1em;"></i> Create First Tag
   </a>
  </div>
 </section>
 {% endif %}
</div>
{% endblock %}
