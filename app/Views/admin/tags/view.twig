{% extends"admin/layout.twig" %}

{% block content %}
<div class="w-full px-4 sm:px-6 py-3">
 <div class="flex justify-between items-center mb-3">
 <h1 class="h4 mb-0">Tag Details</h1>
 <div class="flex gap-2">
 <a href="/admin/tags/edit/{{ tag.id }}" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-lg bg-indigo-600-600 text-white hover:bg-indigo-600-700 transition-colors">Edit</a>
 <a href="/admin/tags" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-lg text-neutral-600 hover:bg-neutral-100 transition-colors border border-neutral-300">Back</a>
 </div>
 </div>

 <div class="bg-rounded-xl border border-slate-200 bg-white shadow-sm border-rounded-xl shadow-sm-border rounded-xl p-5">
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
 <div>
 <div class="text-neutral-500 text-sm">Name</div>
 <div class="font-semibold">{{ tag.name|default('N/A') }}</div>
 </div>
 <div>
 <div class="text-neutral-500 text-sm">Slug</div>
 <div class="font-semibold">{{ tag.slug|default('N/A') }}</div>
 </div>
 </div>
 </div>
</div>
{% endblock %}





