{% extends "admin/layout.twig" %}

{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">

  {# Flash Messages #}
  {% if flash is defined and flash %}
  {% set flash_styles = {'success':'bg-emerald-50 border-emerald-200 text-emerald-800','danger':'bg-red-50 border-red-200 text-red-800','warning':'bg-amber-50 border-amber-200 text-amber-800','info':'bg-sky-50 border-sky-200 text-sky-800'} %}
  <div class="{{ flash_styles[flash.type]|default('bg-sky-50 border-sky-200 text-sky-800') }} rounded-xl border p-4 flex items-center justify-between gap-3 shadow-sm" role="alert">
   <div class="flex items-start gap-2">
    <i class="lucide lucide-info mt-0.5" style="width:1em;height:1em;flex-shrink:0;"></i>
    <span class="text-sm">{{ flash.message }}</span>
   </div>
   <button type="button" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-current opacity-70 hover:opacity-100 shrink-0 transition-opacity" data-brox-dismiss="alert" aria-label="Close">
    <i class="lucide lucide-x" style="width:1em;height:1em;"></i>
   </button>
  </div>
  {% endif %}

  <!-- Gradient Header -->
  <div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 sm:p-8 shadow-lg">
   <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/5 blur-3xl"></div>
   <div class="pointer-events-none absolute -bottom-8 left-1/3 h-28 w-28 rounded-full bg-indigo-400/10 blur-2xl"></div>
   <div class="relative flex flex-wrap items-end justify-between gap-4">
    <div class="flex items-start gap-4">
     <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur-sm">
      <i class="lucide lucide-radio text-2xl text-white"></i>
     </div>
     <div>
      <h1 class="text-2xl font-bold text-white sm:text-3xl">SIM Routing Rules</h1>
      <p class="mt-1 text-sm text-indigo-200/80">Configure automated SMS routing and forwarding rules.</p>
     </div>
    </div>
   </div>
  </div>

  <!-- Rules Card -->
  <div class="rounded-xl border border-slate-200/80 bg-white shadow-sm overflow-hidden">
   <div class="flex items-center justify-between border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-3">
    <div class="flex items-center gap-3">
     <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
      <i class="lucide lucide-shuffle" style="width:0.875em;height:0.875em;"></i>
     </div>
     <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">Routing Rules</h2>
    </div>
    <button class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3 py-2 text-xs font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 active:scale-[0.97]"
     data-brox-toggle="modal"
     data-brox-target="#routeModal"
     id="addRouteBtn"
     onclick="resetRouteForm()">
     <i class="lucide lucide-plus" style="width:0.875em;height:0.875em;"></i> Add Rule
    </button>
   </div>

   <div class="p-5">
    <div class="overflow-x-auto">
     <table class="w-full text-left text-sm">
      <thead>
       <tr class="border-b border-slate-200">
        <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Label</th>
        <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Match</th>
        <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Action</th>
        <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Status</th>
        <th class="px-3 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Actions</th>
       </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
       {% if routes is empty %}
       <tr>
        <td colspan="5" class="px-3 py-8 text-center text-slate-500">
         <div class="flex flex-col items-center justify-center">
          <i class="lucide lucide-route text-2xl text-slate-300 mb-2"></i>
          <p class="m-0 text-sm">No routes configured yet. Add your first rule.</p>
         </div>
        </td>
       </tr>
       {% else %}
       {% for route in routes %}
       <tr class="hover:bg-slate-50/50 transition-colors">
        <td class="px-3 py-3">
         <span class="text-sm font-semibold text-slate-800">{{ route.label }}</span>
        </td>
        <td class="px-3 py-3">
         <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-slate-100 text-slate-700">{{ route.match_type }}</span>
         {% if route.match_value %}<span class="text-xs text-slate-500 ml-1">{{ route.match_value }}</span>{% endif %}
        </td>
        <td class="px-3 py-3">
         <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-sky-100 text-sky-700">{{ route.action|replace({'_': ' '}) }}</span>
        </td>
        <td class="px-3 py-3">
         {% if route.enabled %}
         <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-emerald-100 text-emerald-700">Enabled</span>
         {% else %}
         <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-slate-100 text-slate-700">Disabled</span>
         {% endif %}
        </td>
        <td class="px-3 py-3 text-right">
         <div class="inline-flex gap-1">
          <button class="inline-flex items-center justify-center w-7 h-7 rounded-lg text-indigo-600 hover:bg-indigo-50 transition-all"
           onclick="editRoute({{ route|json_encode }})"
           title="Edit">
           <i class="lucide lucide-pencil text-sm"></i>
          </button>
          <form action="/admin/sim-routing/delete" method="POST" class="inline"
           onsubmit="return confirm('Delete this route?')">
           <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
           <input type="hidden" name="id" value="{{ route.id }}">
           <button type="submit" class="inline-flex items-center justify-center w-7 h-7 rounded-lg text-red-500 hover:bg-red-50 transition-all" title="Delete">
            <i class="lucide lucide-trash-2 text-sm"></i>
           </button>
          </form>
         </div>
        </td>
       </tr>
       {% endfor %}
       {% endif %}
      </tbody>
     </table>
    </div>
   </div>
  </div>
</div>

{# Add/Edit Route Modal #}
<div class="fixed inset-0 z-50 hidden" id="routeModal" tabindex="-1" aria-labelledby="routeModalLabel">
 <div class="fixed inset-0 bg-black/50 backdrop-blur-sm transition-opacity" data-brox-dismiss="modal"></div>
 <div class="fixed inset-0 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg overflow-hidden">
   <form action="/admin/sim-routing/save" method="POST">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="id" id="route_id" value="0">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200 bg-gradient-to-r from-indigo-50/50 to-violet-50/50">
     <h5 class="text-lg font-semibold text-slate-900 m-0 flex items-center gap-2">
      <i class="lucide lucide-radio text-indigo-600" style="width:1.125em;height:1.125em;"></i>
      <span id="routeModalLabel">Add SIM Routing Rule</span>
     </h5>
     <button type="button" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-all duration-150"
      data-brox-dismiss="modal" aria-label="Close">
      <i class="lucide lucide-x text-lg"></i>
     </button>
    </div>
    <div class="p-6 space-y-4">
     <div>
      <label class="block text-sm font-medium text-slate-700 mb-1.5">Label</label>
      <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="label" id="route_label" required placeholder="e.g. Forward Bank OTPs">
     </div>
     <div>
      <label class="block text-sm font-medium text-slate-700 mb-1.5">Match Type</label>
      <select class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="match_type" id="route_match_type" onchange="toggleMatchValue(this.value)">
       <option value="any">Any SMS</option>
       <option value="sender">Sender Number</option>
       <option value="keyword">Keyword in Message</option>
      </select>
     </div>
     <div id="match_value_group" style="display:none">
      <label class="block text-sm font-medium text-slate-700 mb-1.5" id="match_value_label">Match Value</label>
      <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="match_value" id="route_match_value"
       placeholder="Sender number or keyword">
     </div>
     <div>
      <label class="block text-sm font-medium text-slate-700 mb-1.5">Action</label>
      <select class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="action" id="route_action" onchange="toggleActionFields(this.value)">
       <option value="reply_sms">Auto-Reply SMS</option>
       <option value="both">Both</option>
      </select>
     </div>
     <div id="reply_fields" style="display:none" class="space-y-4">
      <div>
       <label class="block text-sm font-medium text-slate-700 mb-1.5">Reply Device</label>
       <select class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="device_id" id="route_device_id">
        <option value="">Same device</option>
        {% for device in devices %}
        <option value="{{ device.id }}">{{ device.device_name }}</option>
        {% endfor %}
       </select>
      </div>
      <div>
       <label class="block text-sm font-medium text-slate-700 mb-1.5">SIM Slot</label>
       <select class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="sim_slot" id="route_sim_slot">
        <option value="1">SIM 1</option>
        <option value="2">SIM 2</option>
       </select>
      </div>
      <div>
       <label class="block text-sm font-medium text-slate-700 mb-1.5">Auto-Reply Message</label>
       <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="reply_message" id="route_reply_message" rows="3"
        placeholder="Message to send back..."></textarea>
      </div>
     </div>
     <div class="flex items-start gap-2">
      <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" name="enabled" id="route_enabled" value="1" checked>
      <label class="text-sm text-slate-700" for="route_enabled">Enabled</label>
     </div>
    </div>
    <div class="flex items-center justify-end gap-2 px-6 py-4 border-t border-slate-200 bg-slate-50 rounded-b-xl">
     <button type="button" class="inline-flex items-center px-4 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-700 text-sm font-semibold hover:bg-slate-100 transition-all" data-brox-dismiss="modal">Cancel</button>
     <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 transition-all shadow-sm active:scale-[0.97]">
      <i class="lucide lucide-save" style="width:1em;height:1em;"></i> Save Rule
     </button>
    </div>
   </form>
  </div>
 </div>
</div>

<script>
function resetRouteForm() {
 document.getElementById('route_id').value = '0';
 document.getElementById('route_label').value = '';
 document.getElementById('route_match_type').value = 'any';
 document.getElementById('route_match_value').value = '';
 document.getElementById('route_action').value = 'reply_sms';
 document.getElementById('route_device_id').value = '';
 document.getElementById('route_sim_slot').value = '1';
 document.getElementById('route_reply_message').value = '';
 document.getElementById('route_enabled').checked = true;
 toggleMatchValue('any');
 toggleActionFields('reply_sms');
 document.getElementById('routeModalLabel').textContent = 'Add SIM Routing Rule';
}

function editRoute(route) {
 document.getElementById('routeModalLabel').textContent = 'Edit SIM Routing Rule';
 document.getElementById('route_id').value = route.id;
 document.getElementById('route_label').value = route.label;
 document.getElementById('route_match_type').value = route.match_type;
 document.getElementById('route_match_value').value = route.match_value || '';
 document.getElementById('route_action').value = route.action;
 document.getElementById('route_device_id').value = route.device_id || '';
 document.getElementById('route_sim_slot').value = route.sim_slot || '1';
 document.getElementById('route_reply_message').value = route.reply_message || '';
 document.getElementById('route_enabled').checked = parseInt(route.enabled) === 1;
 toggleMatchValue(route.match_type);
 toggleActionFields(route.action);

 var modal = new broxUI.Modal(document.getElementById('routeModal'));
 modal.show();
}

function toggleMatchValue(type) {
 var group = document.getElementById('match_value_group');
 var label = document.getElementById('match_value_label');
 group.style.display = (type === 'any') ? 'none' : 'block';
 label.textContent = type === 'sender' ? 'Sender Number (partial match)' : 'Keyword (partial match)';
}

function toggleActionFields(action) {
 var fields = document.getElementById('reply_fields');
 fields.style.display = (action === 'reply_sms' || action === 'both') ? 'block' : 'none';
}
</script>
{% endblock %}
