{% extends"admin/layout.twig" %}

{% block content %}
<div class="w-full px-4 sm:px-6 py-4">

 {# Flash Messages #}
 {% if flash is defined and flash %}
 <div class="alert alert-{{ flash.type }} fade show" role="alert">
 {{ flash.message }}
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition" data-brox-dismiss="alert"></button>
 </div>
 {% endif %}

 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
 <div class="col-span-12">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
 <div class="border-b border-slate-200 px-4 py-3 pb-0 flex justify-between items-center">
 <h6 class="mb-0">📡 SIM Routing Rules</h6>
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs bg-indigo-600 text-white hover:bg-indigo-700" data-brox-toggle="modal" data-brox-target="#routeModal" id="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition-add-route"
 onclick="resetRouteForm()">
 + Add Rule
 </button>
 </div>
 <div class="p-4 px-0 pb-0">
 <div class="overflow-x-auto">
 <table class="table items-center mb-0">
 <thead>
 <tr>
 <th class="text-uppercase text-slate-600 text-xxs font-weight-bolder">Label</th>
 <th class="text-uppercase text-slate-600 text-xxs font-weight-bolder">Match</th>
 <th class="text-uppercase text-slate-600 text-xxs font-weight-bolder">Action</th>
 <th class="text-uppercase text-slate-600 text-xxs font-weight-bolder">Status</th>
 <th class="text-uppercase text-slate-600 text-xxs font-weight-bolder">Actions</th>
 </tr>
 </thead>
 <tbody>
 {% if routes is empty %}
 <tr>
 <td colspan="5" class="text-center text-slate-500 py-4">No routes configured yet. Add your first rule.</td>
 </tr>
 {% else %}
 {% for route in routes %}
 <tr>
 <td><span class="text-sm font-weight-bold">{{ route.label }}</span></td>
 <td>
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-600">{{ route.match_type }}</span>
 {% if route.match_value %}<small class="text-slate-500 ml-1">{{ route.match_value }}</small>{% endif %}
 </td>
 <td><span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-sky-500">{{ route.action | replace({'_': ' '}) }}</span></td>
 <td>
 {% if route.enabled %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold  bg-emerald-600">Enabled</span>
 {% else %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold  bg-slate-600">Disabled</span>
 {% endif %}
 </td>
 <td>
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-indigo-600 hover:bg-indigo-100 py-1 px-2"
 onclick="editRoute({{ route | json_encode }})">
 Edit
 </button>
 <form action="/admin/sim-routing/delete" method="POST" class="inline"
 onsubmit="return confirm('Delete this route?')">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <input type="hidden" name="id" value="{{ route.id }}">
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition px-3 py-1.5 text-xs text-red-600 hover:bg-red-100 py-1 px-2">Delete</button>
 </form>
 </td>
 </tr>
 {% endfor %}
 {% endif %}
 </tbody>
 </table>
 </div>
 </div>
 </div>
 </div>
 </div>

</div>

{# Add/Edit Route Modal #}
<div class="modal fade" id="routeModal" tabindex="-1" aria-labelledby="routeModalLabel" aria-hidden="true">
 <div class="modal-dialog">
 <div class="modal-content">
 <form action="/admin/sim-routing/save" method="POST">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <input type="hidden" name="id" id="route_id" value="0">
 <div class="modal-header">
 <h5 class="modal-title" id="routeModalLabel">SIM Routing Rule</h5>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition" data-brox-dismiss="modal"></button>
 </div>
 <div class="modal-body">
 <div class="mb-3">
 <label class="form-label">Label</label>
 <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="label" id="route_label" required placeholder="e.g. Forward Bank OTPs">
 </div>
 <div class="mb-3">
 <label class="form-label">Match Type</label>
 <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="match_type" id="route_match_type" onchange="toggleMatchValue(this.value)">
 <option value="any">Any SMS</option>
 <option value="sender">Sender Number</option>
 <option value="keyword">Keyword in Message</option>
 </select>
 </div>
 <div class="mb-3" id="match_value_group" style="display:none">
 <label class="form-label" id="match_value_label">Match Value</label>
 <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="match_value" id="route_match_value"
 placeholder="Sender number or keyword">
 </div>
 <div class="mb-3">
 <label class="form-label">Action</label>
 <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="action" id="route_action" onchange="toggleActionFields(this.value)">
 <option value="reply_sms">Auto-Reply SMS</option>
 <option value="both">Both</option>
 </select>
 </div>
 <div id="reply_fields" style="display:none">
 <div class="mb-3">
 <label class="form-label">Reply Device</label>
 <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="device_id" id="route_device_id">
 <option value="">Same device</option>
 {% for device in devices %}
 <option value="{{ device.id }}">{{ device.device_name }}</option>
 {% endfor %}
 </select>
 </div>
 <div class="mb-3">
 <label class="form-label">SIM Slot</label>
 <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="sim_slot" id="route_sim_slot">
 <option value="1">SIM 1</option>
 <option value="2">SIM 2</option>
 </select>
 </div>
 <div class="mb-3">
 <label class="form-label">Auto-Reply Message</label>
 <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="reply_message" id="route_reply_message" rows="3"
 placeholder="Message to send back..."></textarea>
 </div>
 </div>
 <div class="flex items-start gap-2">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" name="enabled" id="route_enabled" value="1" checked>
 <label class="text-sm text-slate-700" for="route_enabled">Enabled</label>
 </div>
 </div>
 <div class="modal-footer">
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200" data-brox-dismiss="modal">Cancel</button>
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">Save Rule</button>
 </div>
 </form>
 </div>
 </div>
</div>

<script>
function resetRouteForm() {
 document.getElementById('route_id').value = '0';
 document.getElementById('route_label').value = '';
 document.getElementById('route_match_type').value = 'any';
 document.getElementById('route_match_value').value = '';
 document.getElementById('route_action').value = 'reply_sms';
 document.getElementById('route_device_id').value = '';
 document.getElementById('route_sim_slot').value = '1';
 document.getElementById('route_reply_message').value = '';
 document.getElementById('route_enabled').checked = true;
 toggleMatchValue('any');
 toggleActionFields('reply_sms');
 document.getElementById('routeModalLabel').textContent = 'Add SIM Routing Rule';
}

function editRoute(route) {
 document.getElementById('routeModalLabel').textContent = 'Edit SIM Routing Rule';
 document.getElementById('route_id').value = route.id;
 document.getElementById('route_label').value = route.label;
 document.getElementById('route_match_type').value = route.match_type;
 document.getElementById('route_match_value').value = route.match_value || '';
 document.getElementById('route_action').value = route.action;
 document.getElementById('route_device_id').value = route.device_id || '';
 document.getElementById('route_sim_slot').value = route.sim_slot || '1';
 document.getElementById('route_reply_message').value = route.reply_message || '';
 document.getElementById('route_enabled').checked = parseInt(route.enabled) === 1;
 toggleMatchValue(route.match_type);
 toggleActionFields(route.action);

 var modal = new broxUI.Modal(document.getElementById('routeModal'));
 modal.show();
}

function toggleMatchValue(type) {
 var group = document.getElementById('match_value_group');
 var label = document.getElementById('match_value_label');
 group.style.display = (type === 'any') ? 'none' : 'block';
 label.textContent = type === 'sender' ? 'Sender Number (partial match)' : 'Keyword (partial match)';
}

function toggleActionFields(action) {
 var fields = document.getElementById('reply_fields');
 fields.style.display = (action === 'reply_sms' || action === 'both') ? 'block' : 'none';
}
</script>
{% endblock %}
