{% extends "admin/layout.twig" %}

{% block content %}
<div class="px-4 sm:px-6 lg:px-8 py-5 space-y-5">

 {# Flash Messages #}
 {% if flash is defined and flash %}
 {% set flash_styles = {'success':'bg-emerald-50 dark:bg-emerald-950/30 border-emerald-200 dark:border-emerald-800/40 text-emerald-800 dark:text-emerald-200','danger':'bg-red-50 dark:bg-red-950/30 border-red-200 dark:border-red-800/40 text-red-800 dark:text-red-200','warning':'bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-800/40 text-amber-800 dark:text-amber-200','info':'bg-sky-50 dark:bg-sky-950/30 border-sky-200 dark:border-sky-800/40 text-sky-800 dark:text-sky-200'} %}
 <div class="{{ flash_styles[flash.type]|default('bg-sky-50 dark:bg-sky-950/30 border-sky-200 dark:border-sky-800/40 text-sky-800 dark:text-sky-200') }} rounded-2xl border p-4 flex items-center justify-between gap-3 shadow-sm" role="alert">
  <div class="flex items-start gap-2">
   <i class="lucide lucide-info w-4 h-4 mt-0.5 flex-shrink-0"></i>
   <span class="text-sm">{{ flash.message }}</span>
  </div>
  <button type="button" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-current opacity-70 hover:opacity-100 shrink-0 transition-opacity" data-brox-dismiss="alert" aria-label="Close">
   <i class="lucide lucide-x w-4 h-4"></i>
  </button>
 </div>
 {% endif %}

 {# ── Page Header Banner ── #}
 <div class="relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-900 text-white shadow-xl shadow-slate-900/20">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.25),transparent_55%)]" aria-hidden="true"></div>
  <div class="relative px-6 py-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-4">
    <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center flex-shrink-0">
     <i class="lucide lucide-radio w-5 h-5 text-white"></i>
    </div>
    <div>
     <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-1">SMS Routing</p>
     <h1 class="text-xl font-bold text-white">SIM Routing Rules</h1>
     <p class="text-sm text-white/60 mt-0.5 max-w-md">Configure automated SMS routing and forwarding rules.</p>
    </div>
   </div>
  </div>
 </div>

 {# ── Rules Card ── #}
 <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
  <div class="flex items-center justify-between gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
   <div class="flex items-center gap-3">
    <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
     <i class="lucide lucide-shuffle w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
    </div>
    <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Routing Rules</h3>
   </div>
   <button class="inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-3 py-2 text-xs font-semibold text-white shadow-sm hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150"
    data-brox-toggle="modal"
    data-brox-target="#routeModal"
    id="addRouteBtn"
    data-action="reset-route-form">
    <i class="lucide lucide-plus w-3.5 h-3.5"></i> Add Rule
   </button>
  </div>

  <div class="p-5">
   <div class="overflow-x-auto">
    <table class="w-full text-left">
     <thead>
      <tr class="border-b border-slate-100 dark:border-slate-800">
       <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Label</th>
       <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Match</th>
       <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Action</th>
       <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Status</th>
       <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap text-right">Actions</th>
      </tr>
     </thead>
     <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
      {% if routes is empty %}
      <tr>
       <td colspan="5" class="px-4 py-16">
        <div class="flex flex-col items-center justify-center text-center">
         <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-4">
          <i class="lucide lucide-route w-7 h-7 text-slate-400 dark:text-slate-600"></i>
         </div>
         <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-1">No routes configured</h3>
         <p class="text-sm text-slate-400 dark:text-slate-600 mb-5 max-w-xs">Add your first routing rule to get started.</p>
         <button class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150"
          data-brox-toggle="modal" data-brox-target="#routeModal" data-action="reset-route-form">
          <i class="lucide lucide-plus w-4 h-4"></i> Add Rule
         </button>
        </div>
       </td>
      </tr>
      {% else %}
      {% for route in routes %}
      <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors duration-100">
       <td class="px-4 py-3">
        <span class="text-sm font-semibold text-slate-900 dark:text-white">{{ route.label }}</span>
       </td>
       <td class="px-4 py-3">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">{{ route.match_type }}</span>
        {% if route.match_value %}<span class="text-xs text-slate-500 dark:text-slate-400 ml-1">{{ route.match_value }}</span>{% endif %}
       </td>
       <td class="px-4 py-3">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-400">{{ route.action|replace({'_': ' '}) }}</span>
       </td>
       <td class="px-4 py-3">
        {% if route.enabled %}
         <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400">
          <span class="w-1 h-1 rounded-full bg-emerald-500"></span> Enabled
         </span>
        {% else %}
         <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
          <span class="w-1 h-1 rounded-full bg-slate-400"></span> Disabled
         </span>
        {% endif %}
       </td>
       <td class="px-4 py-3 text-right">
        <div class="flex items-center justify-end gap-1">
         <button class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-950/30 transition-all duration-150"
          data-action="edit-route" data-route="{{ route|json_encode }}" title="Edit">
          <i class="lucide lucide-pencil w-3.5 h-3.5"></i>
         </button>
         <form action="/admin/sim-routing/delete" method="POST" class="inline"
          data-action="confirm-delete-route">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="id" value="{{ route.id }}">
          <button type="submit" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 transition-all duration-150" title="Delete">
           <i class="lucide lucide-trash-2 w-3.5 h-3.5"></i>
          </button>
         </form>
        </div>
       </td>
      </tr>
      {% endfor %}
      {% endif %}
     </tbody>
    </table>
   </div>
  </div>
 </div>
</div>

{# Add/Edit Route Modal #}
<div class="fixed inset-0 z-50 hidden" id="routeModal" tabindex="-1" aria-labelledby="routeModalLabel">
 <div class="fixed inset-0 bg-black/50 backdrop-blur-sm transition-opacity" data-brox-dismiss="modal"></div>
 <div class="fixed inset-0 flex items-center justify-center p-4">
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-2xl shadow-black/20 w-full max-w-lg overflow-hidden">
   <form action="/admin/sim-routing/save" method="POST">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="id" id="route_id" value="0">
    <div class="flex items-center justify-between gap-3 px-6 py-4 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
     <h3 class="text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2">
      <i class="lucide lucide-radio w-4 h-4 text-indigo-600"></i>
      <span id="routeModalLabel">Add SIM Routing Rule</span>
     </h3>
     <button type="button" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all duration-150"
      data-brox-dismiss="modal" aria-label="Close">
      <i class="lucide lucide-x w-4 h-4"></i>
     </button>
    </div>
    <div class="p-6 space-y-4">
     <div>
      <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Label</label>
      <input type="text"
       class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600"
       name="label" id="route_label" required placeholder="e.g. Forward Bank OTPs">
     </div>
     <div>
      <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Match Type</label>
      <select class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 cursor-pointer appearance-none transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600" name="match_type" id="route_match_type" data-action="toggle-match-value">
       <option value="any">Any SMS</option>
       <option value="sender">Sender Number</option>
       <option value="keyword">Keyword in Message</option>
      </select>
     </div>
     <div id="match_value_group" style="display:none">
      <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5" id="match_value_label">Match Value</label>
      <input type="text"
       class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600"
       name="match_value" id="route_match_value" placeholder="Sender number or keyword">
     </div>
     <div>
      <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Action</label>
      <select class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 cursor-pointer appearance-none transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600" name="action" id="route_action" data-action="toggle-action-fields">
       <option value="reply_sms">Auto-Reply SMS</option>
       <option value="both">Both</option>
      </select>
     </div>
     <div id="reply_fields" style="display:none" class="space-y-4">
      <div>
       <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Reply Device</label>
       <select class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 cursor-pointer appearance-none transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600" name="device_id" id="route_device_id">
        <option value="">Same device</option>
        {% for device in devices %}
        <option value="{{ device.id }}">{{ device.device_name }}</option>
        {% endfor %}
       </select>
      </div>
      <div>
       <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">SIM Slot</label>
       <select class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 cursor-pointer appearance-none transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600" name="sim_slot" id="route_sim_slot">
        <option value="1">SIM 1</option>
        <option value="2">SIM 2</option>
       </select>
      </div>
      <div>
       <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Auto-Reply Message</label>
       <textarea
        class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600 resize-y min-h-[80px]"
        name="reply_message" id="route_reply_message" rows="3" placeholder="Message to send back..."></textarea>
      </div>
     </div>
     <div class="flex items-start gap-2">
      <input class="mt-1 h-4 w-4 rounded border-slate-300 dark:border-slate-600 text-indigo-600 focus:ring-indigo-500/20" type="checkbox" name="enabled" id="route_enabled" value="1" checked>
      <label class="text-sm text-slate-700 dark:text-slate-300" for="route_enabled">Enabled</label>
     </div>
    </div>
    <div class="flex items-center justify-end gap-2 px-6 py-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30 rounded-b-2xl">
     <button type="button" class="inline-flex items-center px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-sm font-semibold hover:bg-slate-100 dark:hover:bg-slate-700 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150" data-brox-dismiss="modal">Cancel</button>
     <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
      <i class="lucide lucide-save w-4 h-4"></i> Save Rule
     </button>
    </div>
   </form>
  </div>
 </div>
</div>

<script>
function resetRouteForm() {
 document.getElementById('route_id').value = '0';
 document.getElementById('route_label').value = '';
 document.getElementById('route_match_type').value = 'any';
 document.getElementById('route_match_value').value = '';
 document.getElementById('route_action').value = 'reply_sms';
 document.getElementById('route_device_id').value = '';
 document.getElementById('route_sim_slot').value = '1';
 document.getElementById('route_reply_message').value = '';
 document.getElementById('route_enabled').checked = true;
 toggleMatchValue('any');
 toggleActionFields('reply_sms');
 document.getElementById('routeModalLabel').textContent = 'Add SIM Routing Rule';
}

function editRoute(route) {
 document.getElementById('routeModalLabel').textContent = 'Edit SIM Routing Rule';
 document.getElementById('route_id').value = route.id;
 document.getElementById('route_label').value = route.label;
 document.getElementById('route_match_type').value = route.match_type;
 document.getElementById('route_match_value').value = route.match_value || '';
 document.getElementById('route_action').value = route.action;
 document.getElementById('route_device_id').value = route.device_id || '';
 document.getElementById('route_sim_slot').value = route.sim_slot || '1';
 document.getElementById('route_reply_message').value = route.reply_message || '';
 document.getElementById('route_enabled').checked = parseInt(route.enabled) === 1;
 toggleMatchValue(route.match_type);
 toggleActionFields(route.action);

 var modal = new broxUI.Modal(document.getElementById('routeModal'));
 modal.show();
}

function toggleMatchValue(type) {
 var group = document.getElementById('match_value_group');
 var label = document.getElementById('match_value_label');
 group.style.display = (type === 'any') ? 'none' : 'block';
 label.textContent = type === 'sender' ? 'Sender Number (partial match)' : 'Keyword (partial match)';
}

function toggleActionFields(action) {
 var fields = document.getElementById('reply_fields');
 fields.style.display = (action === 'reply_sms' || action === 'both') ? 'block' : 'none';
}


<script>
document.addEventListener("click", function(e) {
  var t = e.target.closest("[data-action]");
  if (!t) return;
  var a = t.getAttribute("data-action");
  if (a === "reset-route-form") resetRouteForm();
  if (a === "edit-route") editRoute(JSON.parse(t.getAttribute("data-route")));
});
document.addEventListener("change", function(e) {
  var t = e.target.closest("[data-action]");
  if (!t) return;
  var a = t.getAttribute("data-action");
  if (a === "toggle-match-value") toggleMatchValue(t.value);
  if (a === "toggle-action-fields") toggleActionFields(t.value);
});
document.addEventListener("submit", function(e) {
  var t = e.target.closest("[data-action]");
  if (!t) return;
  if (t.getAttribute("data-action") === "confirm-delete-route") {
    if (!confirm("Delete this route?")) e.preventDefault();
  }
});
</script>
</script>
{% endblock %}
