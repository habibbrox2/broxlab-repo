{% extends "admin/layout.twig" %}

{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">

  <!-- Gradient Header -->
  <div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 sm:p-8 shadow-lg">
   <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/5 blur-3xl"></div>
   <div class="pointer-events-none absolute -bottom-8 left-1/3 h-28 w-28 rounded-full bg-indigo-400/10 blur-2xl"></div>
   <div class="relative flex flex-wrap items-end justify-between gap-4">
    <div class="flex items-start gap-4">
     <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur-sm">
      <i class="lucide lucide-flag text-2xl text-white"></i>
     </div>
     <div>
      <h1 class="text-2xl font-bold text-white sm:text-3xl">Super Admin Flags</h1>
      <p class="mt-1 text-sm text-indigo-200/80">Toggle platform-wide features without changing code.</p>
     </div>
    </div>
   </div>
  </div>

  <!-- Flags Table Card -->
  <div class="rounded-xl border border-slate-200/80 bg-white shadow-sm overflow-hidden">
   <div class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-3">
    <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
     <i class="lucide lucide-toggle-left" style="width:0.875em;height:0.875em;"></i>
    </div>
    <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">Feature Flags</h2>
   </div>
   <div class="p-5">
    <div class="overflow-x-auto">
     <table class="w-full text-left text-sm">
      <thead>
       <tr class="border-b border-slate-200">
        <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Feature</th>
        <th class="px-3 py-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Status</th>
        <th class="px-3 py-3 text-center text-xs font-semibold uppercase tracking-wider text-slate-500">Super Admin Only</th>
        <th class="px-3 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Actions</th>
       </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
       {% for feature in features %}
       <tr class="hover:bg-slate-50/50 transition-colors">
        <td class="px-3 py-3 font-medium text-sm text-slate-900">{{ feature.feature_key }}</td>
        <td class="px-3 py-3">
         <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold
          {{ feature.enabled ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-700' }}">
          {{ feature.enabled ? 'Enabled' : 'Disabled' }}
         </span>
        </td>
        <td class="px-3 py-3 text-center text-sm text-slate-600">{{ feature.super_admin_only ? 'Yes' : 'No' }}</td>
        <td class="px-3 py-3 text-right">
         <form method="POST" action="/admin/feature-flags/toggle" class="inline">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <input type="hidden" name="id" value="{{ feature.id }}">
          <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-2 text-xs font-semibold text-indigo-700 transition hover:bg-indigo-100 hover:-translate-y-0.5 shadow-sm">
           <i class="lucide lucide-toggle-right" style="width:0.875em;height:0.875em;"></i> Toggle
          </button>
         </form>
        </td>
       </tr>
       {% else %}
       <tr>
        <td colspan="4" class="px-3 py-8 text-center text-slate-500">
         <div class="flex flex-col items-center justify-center">
          <i class="lucide lucide-inbox text-2xl text-slate-300 mb-2"></i>
          <p class="m-0 text-sm">No feature flags configured.</p>
         </div>
        </td>
       </tr>
       {% endfor %}
      </tbody>
     </table>
    </div>
   </div>
  </div>
</div>
{% endblock %}
