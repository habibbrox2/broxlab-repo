<div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden">
 <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
  <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
   <i class="lucide lucide-server w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
  </div>
  <h3 class="text-sm font-semibold text-slate-900 dark:text-white">MCP Server Configuration</h3>
 </div>
 <div class="p-5">
  <div class="grid grid-cols-1 gap-5">
   <div>
    <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">MCP Server URL</label>
    <input type="text"
     class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600"
     name="mcp_server_url"
     id="mcp_server_url"
     value="{{ settings.mcp_server_url|default('') }}"
     placeholder="http://localhost:3000">
    <p class="mt-1 text-xs text-slate-400 dark:text-slate-600">The URL of your MCP (Model Context Protocol) server.</p>
   </div>
   <div>
    <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">MCP API Key</label>
    <input type="password"
     class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600"
     name="mcp_api_key"
     id="mcp_api_key"
     value="{{ settings.mcp_api_key|default('') }}"
     placeholder="Enter MCP API key"
     autocomplete="off">
    <p class="mt-1 text-xs text-slate-400 dark:text-slate-600">Authentication key for accessing the MCP server.</p>
   </div>
  </div>
 </div>
</div>
