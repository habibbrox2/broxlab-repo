<div class="rounded-xl border border-slate-200/80 bg-white shadow-sm overflow-hidden">
 <div class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-3">
  <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
   <i class="lucide lucide-server" style="width:0.875em;height:0.875em;"></i>
  </div>
  <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">MCP Server Configuration</h2>
 </div>
 <div class="p-5">
  <div class="grid grid-cols-1 gap-5">
   <div>
    <label class="block text-sm font-semibold text-slate-700 mb-1.5">MCP Server URL</label>
    <input type="text"
     class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all"
     name="mcp_server_url"
     id="mcp_server_url"
     value="{{ settings.mcp_server_url|default('') }}"
     placeholder="http://localhost:3000">
    <p class="mt-1 text-xs text-slate-500">The URL of your MCP (Model Context Protocol) server.</p>
   </div>
   <div>
    <label class="block text-sm font-semibold text-slate-700 mb-1.5">MCP API Key</label>
    <input type="password"
     class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all"
     name="mcp_api_key"
     id="mcp_api_key"
     value="{{ settings.mcp_api_key|default('') }}"
     placeholder="Enter MCP API key"
     autocomplete="off">
    <p class="mt-1 text-xs text-slate-500">Authentication key for accessing the MCP server.</p>
   </div>
  </div>
 </div>
</div>
