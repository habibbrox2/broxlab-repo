{% extends 'admin/layout.twig' %}

{% block title %}Deploy Tools - BroxBhai Admin{% endblock %}

{% block content %}
<div class="w-full px-4 sm:px-6 py-4">
 <section class="admin-panel-card mx-auto max-w-3xl text-center">
  <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-100 text-amber-600">
   <i class="lucide lucide-wrench text-3xl"></i>
  </div>
  <h1 class="text-2xl font-bold text-slate-950">Deploy Tools Currently Unavailable</h1>
  <p class="mt-3 text-sm leading-6 text-slate-600">
   The deployment tools feature is currently under maintenance or not yet implemented.
   We’ll keep the shell consistent here so the page still feels part of the admin experience.
  </p>

  <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-left">
   <h2 class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Coming Soon</h2>
   <ul class="space-y-2 text-sm text-slate-600">
    <li class="flex items-center gap-2"><i class="lucide lucide-check-circle text-emerald-600"></i> One-click application deployment</li>
    <li class="flex items-center gap-2"><i class="lucide lucide-check-circle text-emerald-600"></i> Automated build and test workflows</li>
    <li class="flex items-center gap-2"><i class="lucide lucide-check-circle text-emerald-600"></i> Environment configuration management</li>
    <li class="flex items-center gap-2"><i class="lucide lucide-check-circle text-emerald-600"></i> Deployment history and rollback</li>
    <li class="flex items-center gap-2"><i class="lucide lucide-check-circle text-emerald-600"></i> Server health monitoring</li>
   </ul>
  </div>

  <div class="mt-6 flex flex-wrap justify-center gap-3">
   <a href="/admin/dashboard" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
    <i class="lucide lucide-house"></i> Back to Dashboard
   </a>
   <a href="/admin/settings" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
    <i class="lucide lucide-settings"></i> Settings
   </a>
  </div>
 </section>
</div>
{% endblock %}
