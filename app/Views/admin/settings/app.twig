{% extends"admin/layout.twig" %}
{% block title %}App Settings{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="space-y-6">
 <section class="admin-page-header">
  <div>
   <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
    <i class="lucide lucide-settings"></i>
    Settings
   </p>
   <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">App Settings</h1>
   <p class="mt-2 max-w-2xl text-sm text-slate-600">Configure application preferences, integrations, and security controls.</p>
  </div>
 </section>

 <section class="admin-panel-card">
  <form method="post" action="{{ admin_dir|default('/admin') }}/app-settings" class="needs-validation" enctype="multipart/form-data">
   <ul class="mb-3 flex flex-wrap gap-1 border-b border-slate-200 pb-0" id="appSettingsTabs" role="tablist">
    {% set tabs = {
     "general":"General",
     "contact":"Contact",
     "seo":"SEO",
     "social":"Social Media",
     "email":"Email / SMTP",
     "security":"Security",
     "payments":"Payments",
     "api":"API / Integrations",
     "ai":"AI Settings",
     "mcp":"MCP Server",
     "cache":"Cache",
     "security_controls":"Security Controls"
    } %}
    {% for key, label in tabs %}
    <li>
     <button class="inline-flex items-center gap-1 rounded-t-xl border-b-2 px-4 py-2.5 text-sm font-medium transition {% if loop.first %}border-indigo-600 text-indigo-700 font-semibold{% else %}border-transparent text-slate-600 hover:border-slate-300 hover:text-slate-900{% endif %}" data-brox-toggle="tab" data-brox-target="#{{ key }}" type="button">{{ label }}</button>
    </li>
    {% endfor %}
   </ul>
   <div class="tab-content" id="appSettingsTabsContent">
    <div class="tab-pane block" id="general">
     <div class="mb-3">
      <label class="form-label">Site Name</label>
      <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="site_name" placeholder="Enter your site name" value="{{ settings.site_name|default('') }}" required>
     </div>
     <div class="mb-3">
      <label class="form-label">Site Logo</label>
      <div class="mb-2 flex items-center gap-3">
       {% if settings.site_logo|default('') %}
       <img id="logoPreview" src="{{ settings.site_logo|default('') }}" alt="Logo" class="image-preview">
       <button type="button" id="removeLogoBtn" class="inline-flex items-center justify-center gap-2 rounded-lg bg-red-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-red-700" aria-label="Remove site logo">
        <i class="lucide lucide-trash-2"></i> Remove
        <span class="sr-only">Remove site logo</span>
       </button>
       {% else %}
       <img id="logoPreview" src="" alt="Logo Preview" class="image-preview hidden">
       {% endif %}
      </div>
      <input type="hidden" name="remove_site_logo" id="remove_site_logo" value="0">
      <input type="text" class="mb-2 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="site_logo" placeholder="/assets/logo/logo.png" value="{{ settings.site_logo|default('') }}">
      <input type="file" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="siteLogoUpload" name="site_logo_file" accept="image/*">
     </div>
     <div class="mb-3">
      <label class="form-label">Favicon</label>
      <div class="mb-2">
       {% set favicon_url = settings.favicon|default('/assets/logo/favicon.ico') %}
       <img id="faviconPreview" src="{{ favicon_url }}" alt="Favicon" class="favicon-preview">
      </div>
      <input type="text" class="mb-2 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="favicon" placeholder="/assets/logo/favicon.ico" value="{{ settings.favicon|default('/assets/logo/favicon.ico') }}">
      <input type="file" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="faviconUpload" name="favicon_file" accept="image/*">
     </div>
     <div class="mb-3">
      <label class="form-label">Default Language</label>
      <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="default_language" placeholder="e.g., en, fr, es" value="{{ settings.default_language|default('en') }}">
     </div>
     <div class="mb-3">
      <label class="form-label">Timezone</label>
      <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="timezone">
       {% for tz, label in timezones|default([]) %}
       <option value="{{ tz }}" {% if settings.timezone|default('UTC') == tz %}selected{% endif %}>{{ label }}</option>
       {% endfor %}
      </select>
     </div>
    </div>
    <div class="tab-pane hidden" id="contact">
     <div class="mb-3">
      <label class="form-label">Contact Email</label>
      <input type="email" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="contact_email" placeholder="contact@example.com" value="{{ settings.contact_email|default('') }}">
     </div>
     <div class="mb-3">
      <label class="form-label">Phone</label>
      <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="contact_phone" placeholder="+1 234 567 890" value="{{ settings.contact_phone|default('') }}">
     </div>
     <div class="mb-3">
      <label class="form-label">Address</label>
      <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="contact_address" placeholder="123 Main St, City, Country">{{ settings.contact_address|default('') }}</textarea>
     </div>
    </div>
    <div class="tab-pane hidden" id="seo">
     <div class="mb-3">
      <label class="form-label">Meta Title</label>
      <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="meta_title" placeholder="Enter meta title" value="{{ settings.meta_title|default('') }}">
     </div>
     <div class="mb-3">
      <label class="form-label">Meta Description</label>
      <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="meta_description" placeholder="Enter meta description">{{ settings.meta_description|default('') }}</textarea>
     </div>
     <div class="mb-3">
      <label class="form-label">Meta Keywords</label>
      <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="meta_keywords" placeholder="keyword1, keyword2, keyword3">{{ settings.meta_keywords|default('') }}</textarea>
     </div>
    </div>
    <div class="tab-pane hidden" id="mcp">
     {% include 'admin/settings/mcp.twig' %}
    </div>
    <div class="tab-pane hidden" id="ai">
     {% include 'admin/settings/ai.twig' %}
    </div>
   </div>
  </form>
 </section>
</div>
{% endblock %}
