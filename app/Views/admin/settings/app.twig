{% extends "admin/layout.twig" %}
{% block title %}App Settings{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="px-4 sm:px-6 lg:px-8 py-5 space-y-5 settings-page">

 {# ── Page Header Banner ── #}
 <div class="relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-900 text-white shadow-xl shadow-slate-900/20">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.25),transparent_55%)]" aria-hidden="true"></div>
  <div class="relative px-6 py-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-4">
    <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center flex-shrink-0">
     <i class="lucide lucide-settings w-5 h-5 text-white"></i>
    </div>
    <div>
     <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-1">Configuration</p>
     <h1 class="text-xl font-bold text-white">App Settings</h1>
     <p class="text-sm text-white/60 mt-0.5 max-w-md">Configure application preferences, integrations, and security controls.</p>
    </div>
   </div>
  </div>
 </div>

 {# ── Settings Card ── #}
 <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
  <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
   <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0">
    <i class="lucide lucide-sliders w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
   </div>
   <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Application Settings</h3>
  </div>

  <div class="p-5 sm:p-6">
   <form method="post" action="{{ admin_dir|default('/admin') }}/app-settings" class="needs-validation" enctype="multipart/form-data">
    {# ── Pill-style Tab Navigation ── #}
    <div class="mb-6 overflow-x-auto">
     <ul class="inline-flex min-w-max gap-1 rounded-xl bg-slate-100 dark:bg-slate-800 p-1" id="appSettingsTabs" role="tablist">
      {% set tabs = {
       "general":{"label":"General","icon":"lucide lucide-sliders"},
       "contact":{"label":"Contact","icon":"lucide lucide-mail"},
       "seo":{"label":"SEO","icon":"lucide lucide-search"},
       "social":{"label":"Social","icon":"lucide lucide-share-2"},
       "email":{"label":"Email","icon":"lucide lucide-mail-check"},
       "security":{"label":"Security","icon":"lucide lucide-shield"},
       "payments":{"label":"Payments","icon":"lucide lucide-credit-card"},
       "api":{"label":"API","icon":"lucide lucide-cpu"},
       "ai":{"label":"AI","icon":"lucide lucide-bot"},
       "mcp":{"label":"MCP","icon":"lucide lucide-server"},
       "cache":{"label":"Cache","icon":"lucide lucide-database"},
       "security_controls":{"label":"Controls","icon":"lucide lucide-shield-check"}
      } %}
      {% for key, tab in tabs %}
      <li>
       <button id="{{ key }}-tab" class="inline-flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-sm font-medium transition-all duration-200 whitespace-nowrap {% if loop.first %}active bg-white dark:bg-slate-700 text-indigo-700 dark:text-indigo-300 shadow-sm{% else %}text-slate-600 dark:text-slate-400 hover:bg-white/70 dark:hover:bg-slate-700/70 hover:text-slate-900 dark:hover:text-slate-200{% endif %}" data-brox-toggle="tab" data-brox-target="#{{ key }}" type="button" role="tab" aria-selected="{{ loop.first ? 'true' : 'false' }}" aria-controls="{{ key }}">
        <i class="{{ tab.icon }} w-4 h-4"></i>
        {{ tab.label }}
       </button>
      </li>
      {% endfor %}
     </ul>
    </div>

    {# ── Tab-pane CSS ── #}
    <style>
      .tab-pane:not(.active) { display: none; }
      .tab-pane.active { display: block; }
    </style>

    {# ── Tab Content ── #}
    <div class="tab-content space-y-5" id="appSettingsTabsContent">
     {# ─── General Tab ─── #}
     <div class="tab-pane active" id="general" role="tabpanel" aria-labelledby="general-tab" aria-hidden="false">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
       <div>
        <div class="mb-4">
         <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Site Name <span class="text-rose-500 ml-0.5">*</span></label>
         <input type="text"
          class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600"
          name="site_name" placeholder="Enter your site name" value="{{ settings.site_name|default('') }}" required>
        </div>
        <div class="mb-4">
         <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Default Language</label>
         <input type="text"
          class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600"
          name="default_language" placeholder="e.g., en, fr, es" value="{{ settings.default_language|default('en') }}">
        </div>
        <div class="mb-4">
         <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Timezone</label>
         <select class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 cursor-pointer appearance-none transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600" name="timezone">
          {% for tz, label in timezones|default([]) %}
          <option value="{{ tz }}" {% if settings.timezone|default('UTC') == tz %}selected{% endif %}>{{ label }}</option>
          {% endfor %}
         </select>
        </div>
       </div>
       <div>
        <div class="mb-4">
         <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Site Logo</label>
         <div class="mb-2 flex items-center gap-3">
          {% if settings.site_logo|default('') %}
          <div class="flex h-14 w-14 items-center justify-center rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60">
           <img id="logoPreview" src="{{ settings.site_logo|default('') }}" alt="Logo" class="max-h-10 max-w-10 object-contain">
          </div>
          <button type="button" id="removeLogoBtn" class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-800/40 px-3 py-2 text-xs font-semibold text-red-600 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-950/50 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
           <i class="lucide lucide-trash-2 w-3 h-3"></i> Remove
          </button>
          {% else %}
          <div class="flex h-14 w-14 items-center justify-center rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800/60 text-slate-400">
           <i class="lucide lucide-image w-5 h-5"></i>
          </div>
          <img id="logoPreview" src="" alt="Logo Preview" class="hidden max-h-10 max-w-10 object-contain">
          {% endif %}
         </div>
         <input type="hidden" name="remove_site_logo" id="remove_site_logo" value="0">
         <input type="text"
          class="mb-2 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600"
          name="site_logo" placeholder="/assets/logo/logo.png" value="{{ settings.site_logo|default('') }}">
         <input type="file"
          class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm file:mr-3 file:rounded-xl file:border-0 file:bg-indigo-50 dark:file:bg-indigo-900/30 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-indigo-700 dark:file:text-indigo-400 hover:file:bg-indigo-100 dark:hover:file:bg-indigo-900/50 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 focus:border-indigo-400 transition-all"
          id="siteLogoUpload" name="site_logo_file" accept="image/*">
        </div>
        <div class="mb-4">
         <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Favicon</label>
         <div class="mb-2 flex items-center gap-3">
          {% set favicon_url = settings.favicon|default('/assets/logo/favicon.ico') %}
          <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60">
           <img id="faviconPreview" src="{{ favicon_url }}" alt="Favicon" class="max-h-6 max-w-6 object-contain">
          </div>
         </div>
         <input type="text"
          class="mb-2 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600"
          name="favicon" placeholder="/assets/logo/favicon.ico" value="{{ settings.favicon|default('/assets/logo/favicon.ico') }}">
         <input type="file"
          class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm file:mr-3 file:rounded-xl file:border-0 file:bg-indigo-50 dark:file:bg-indigo-900/30 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-indigo-700 dark:file:text-indigo-400 hover:file:bg-indigo-100 dark:hover:file:bg-indigo-900/50 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 focus:border-indigo-400 transition-all"
          id="faviconUpload" name="favicon_file" accept="image/*">
        </div>
       </div>
      </div>
     </div>

     {# ─── Contact Tab ─── #}
     <div class="tab-pane" id="contact" role="tabpanel" aria-labelledby="contact-tab" aria-hidden="true">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
       <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Contact Email</label>
        <input type="email"
         class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600"
         name="contact_email" placeholder="contact@example.com" value="{{ settings.contact_email|default('') }}">
       </div>
       <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Phone</label>
        <input type="text"
         class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600"
         name="contact_phone" placeholder="+1 234 567 890" value="{{ settings.contact_phone|default('') }}">
       </div>
      </div>
      <div class="mb-4">
       <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Address</label>
       <textarea
        class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600 resize-y min-h-[80px]"
        name="contact_address" placeholder="123 Main St, City, Country" rows="3">{{ settings.contact_address|default('') }}</textarea>
      </div>
      <div class="rounded-xl border border-indigo-100 dark:border-indigo-900/30 bg-indigo-50 dark:bg-indigo-950/30 p-4">
       <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center flex-shrink-0 text-indigo-600 dark:text-indigo-400">
         <i class="lucide lucide-info w-4 h-4"></i>
        </div>
        <div>
         <p class="text-sm font-semibold text-indigo-800 dark:text-indigo-300">Contact Information</p>
         <p class="mt-0.5 text-xs text-indigo-600/70 dark:text-indigo-400/70">These details will be shown on the public contact page and in email footers.</p>
        </div>
       </div>
      </div>
     </div>

     {# ─── SEO Tab ─── #}
     <div class="tab-pane" id="seo" role="tabpanel" aria-labelledby="seo-tab" aria-hidden="true">
      <div class="space-y-4">
       <div>
        <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Meta Title</label>
        <input type="text"
         class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600"
         name="meta_title" placeholder="Enter meta title" value="{{ settings.meta_title|default('') }}">
        <p class="mt-1 text-xs text-slate-400 dark:text-slate-600">Recommended: 50-60 characters for optimal search result display.</p>
       </div>
       <div>
        <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Meta Description</label>
        <textarea
         class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600 resize-y min-h-[80px]"
         name="meta_description" placeholder="Enter meta description" rows="3">{{ settings.meta_description|default('') }}</textarea>
        <p class="mt-1 text-xs text-slate-400 dark:text-slate-600">Recommended: 150-160 characters. This appears in search engine results.</p>
       </div>
       <div>
        <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1.5">Meta Keywords</label>
        <textarea
         class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 transition-all duration-150 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/10 hover:border-slate-300 dark:hover:border-slate-600 resize-y min-h-[60px]"
         name="meta_keywords" placeholder="keyword1, keyword2, keyword3" rows="2">{{ settings.meta_keywords|default('') }}</textarea>
        <p class="mt-1 text-xs text-slate-400 dark:text-slate-600">Separate keywords with commas.</p>
       </div>
       <div class="rounded-xl border border-amber-100 dark:border-amber-900/30 bg-amber-50 dark:bg-amber-950/30 p-4">
        <div class="flex items-start gap-3">
         <div class="w-8 h-8 rounded-lg bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center flex-shrink-0 text-amber-600 dark:text-amber-400">
          <i class="lucide lucide-search w-4 h-4"></i>
         </div>
         <div>
          <p class="text-sm font-semibold text-amber-800 dark:text-amber-300">SEO Tip</p>
          <p class="mt-0.5 text-xs text-amber-600/70 dark:text-amber-400/70">Good meta descriptions can improve click-through rates from search results. Make each description unique and relevant.</p>
         </div>
        </div>
       </div>
      </div>
     </div>

     {# ─── Included tabs ─── #}
     <div class="tab-pane" id="mcp" role="tabpanel" aria-labelledby="mcp-tab" aria-hidden="true">{% include 'admin/settings/mcp.twig' %}</div>
     <div class="tab-pane" id="ai" role="tabpanel" aria-labelledby="ai-tab" aria-hidden="true">{% include 'admin/settings/ai.twig' %}</div>

     {# ─── Placeholder tabs ─── #}
     {% set placeholders = {
      "social":{"icon":"lucide lucide-share-2","title":"Social Media Settings","desc":"Configure social media links and sharing preferences."},
      "email":{"icon":"lucide lucide-mail-check","title":"Email / SMTP Settings","desc":"Configure mail server, SMTP credentials, and email templates."},
      "security":{"icon":"lucide lucide-shield","title":"Security Settings","desc":"Manage firewall rules, IP blocking, and security policies."},
      "payments":{"icon":"lucide lucide-credit-card","title":"Payment Settings","desc":"Configure payment gateways, currency, and billing options."},
      "api":{"icon":"lucide lucide-cpu","title":"API / Integrations","desc":"Manage API keys, webhooks, and third-party integrations."},
      "cache":{"icon":"lucide lucide-database","title":"Cache Settings","desc":"Manage caching strategy, TTL, and cache invalidation."},
      "security_controls":{"icon":"lucide lucide-shield-check","title":"Security Controls","desc":"Fine-grained security controls and audit logging."}
     } %}
     {% for key, ph in placeholders %}
     <div class="tab-pane" id="{{ key }}" role="tabpanel" aria-labelledby="{{ key }}-tab" aria-hidden="true">
      <div class="relative overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-gradient-to-br from-slate-50/50 dark:from-slate-800/30 to-indigo-50/50 dark:to-indigo-950/20 p-8 text-center">
       <div class="relative">
        <div class="mx-auto w-16 h-16 rounded-2xl bg-indigo-50 dark:bg-indigo-900/30 flex items-center justify-center text-indigo-500 dark:text-indigo-400 mb-4">
         <i class="{{ ph.icon }} w-8 h-8"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1.5">{{ ph.title }}</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto">{{ ph.desc }}</p>
        <div class="mt-6 inline-flex items-center gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2 text-xs font-semibold text-slate-400 dark:text-slate-600 shadow-sm">
         <i class="lucide lucide-clock w-3.5 h-3.5"></i>
         Coming Soon
        </div>
       </div>
      </div>
     </div>
     {% endfor %}
    </div>

    {# ── Save Footer ── #}
    <div class="mt-8 flex items-center justify-end gap-3 rounded-2xl border border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30 px-5 py-4">
     <div class="hidden sm:flex items-center gap-2 text-xs text-slate-400 dark:text-slate-600 mr-auto">
      <i class="lucide lucide-check-circle w-3.5 h-3.5"></i>
      Changes are saved across all tabs
     </div>
     <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm shadow-indigo-500/20 hover:shadow-md hover:shadow-indigo-500/25 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
      <i class="lucide lucide-save w-4 h-4"></i>
      Save Settings
     </button>
    </div>
   </form>
  </div>
 </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  var tablist = document.getElementById('appSettingsTabs');
  if (!tablist) return;

  var tabs = Array.from(tablist.querySelectorAll('[data-brox-toggle="tab"]'));
  if (!tabs.length) return;

  function activateTab(targetId) {
    if (!targetId) return;
    var tab = tablist.querySelector('[data-brox-target="#' + CSS.escape(targetId) + '"]');
    if (tab && !tab.classList.contains('active')) {
      broxUI.Tab.getOrCreateInstance(tab).show();
    }
  }

  function getHashTarget() {
    return window.location.hash.replace(/^#/, '');
  }

  var initialHash = getHashTarget();
  if (initialHash) {
    activateTab(initialHash);
  }

  tabs.forEach(function (tab) {
    tab.addEventListener('brox:shown', function () {
      var target = tab.getAttribute('data-brox-target');
      if (target && target.charAt(0) === '#') {
        var tabHash = target.slice(1);
        if (window.location.hash !== '#' + tabHash) {
          history.replaceState(null, '', '#' + tabHash);
        }
      }
    });
  });

  window.addEventListener('hashchange', function () {
    var hashTarget = getHashTarget();
    if (hashTarget) {
      activateTab(hashTarget);
    }
  });
});
</script>
{% endblock %}
