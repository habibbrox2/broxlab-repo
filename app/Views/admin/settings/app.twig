{% extends "admin/layout.twig" %}
{% block title %}App Settings{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-6 settings-page">
 {# ── Gradient Page Header ── #}
 <section class="scroll-fade-in relative overflow-hidden rounded-xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 sm:p-8">
  <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/5 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-8 left-1/3 h-28 w-28 rounded-full bg-indigo-400/10 blur-2xl"></div>
  <div class="relative flex flex-wrap items-end justify-between gap-4">
   <div class="flex items-start gap-4">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur-sm">
     <i class="lucide lucide-settings text-2xl text-white"></i>
    </div>
    <div>
     <h1 class="text-2xl font-bold text-white sm:text-3xl">App Settings</h1>
     <p class="mt-1 text-sm text-indigo-200/80">Configure application preferences, integrations, and security controls.</p>
    </div>
   </div>
  </div>
 </section>

 {# ── Settings Card ── #}
 <section class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm">
  {# Card header with icon and title #}
  <div class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-3.5">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-indigo-100 text-indigo-600">
    <i class="lucide lucide-sliders text-sm"></i>
   </div>
   <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-700">Application Settings</h2>
  </div>

  <div class="p-5 sm:p-6">
   <form method="post" action="{{ admin_dir|default('/admin') }}/app-settings" class="needs-validation" enctype="multipart/form-data">
    {# ── Pill-style Tab Navigation ── #}
    <div class="mb-6 overflow-x-auto">
     <ul class="inline-flex min-w-max gap-1 rounded-lg bg-slate-100 p-1" id="appSettingsTabs" role="tablist">
      {% set tabs = {
       "general":{"label":"General","icon":"lucide lucide-sliders"},
       "contact":{"label":"Contact","icon":"lucide lucide-mail"},
       "seo":{"label":"SEO","icon":"lucide lucide-search"},
       "social":{"label":"Social","icon":"lucide lucide-share-2"},
       "email":{"label":"Email","icon":"lucide lucide-mail-check"},
       "security":{"label":"Security","icon":"lucide lucide-shield"},
       "payments":{"label":"Payments","icon":"lucide lucide-credit-card"},
       "api":{"label":"API","icon":"lucide lucide-cpu"},
       "ai":{"label":"AI","icon":"lucide lucide-bot"},
       "mcp":{"label":"MCP","icon":"lucide lucide-server"},
       "cache":{"label":"Cache","icon":"lucide lucide-database"},
       "security_controls":{"label":"Controls","icon":"lucide lucide-shield-check"}
      } %}
      {% for key, tab in tabs %}
      <li>
       <button id="{{ key }}-tab" class="inline-flex items-center gap-1.5 rounded-md px-3.5 py-2 text-sm font-medium transition-all duration-200 whitespace-nowrap {% if loop.first %}active bg-white text-indigo-700 shadow-sm{% else %}text-slate-600 hover:bg-white/70 hover:text-slate-900{% endif %}" data-brox-toggle="tab" data-brox-target="#{{ key }}" type="button" role="tab" aria-selected="{{ loop.first ? 'true' : 'false' }}" aria-controls="{{ key }}">
        <i class="{{ tab.icon }}" style="width:1em;height:1em;"></i>
        {{ tab.label }}
      </button>
     </li>
     {% endfor %}
    </ul>
   </div>

    {# ── Tab-pane CSS (broxUI Tab manages visibility via .active class) ── #}
    <style>
      .tab-pane:not(.active) { display: none; }
      .tab-pane.active { display: block; }
    </style>

    {# ── Tab Content ── #}
    <div class="tab-content space-y-5" id="appSettingsTabsContent">
     {# ─── General Tab ─── #}
     <div class="tab-pane active" id="general" role="tabpanel" aria-labelledby="general-tab" aria-hidden="false">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
       <div>
        <div class="mb-4">
         <label class="block text-sm font-semibold text-slate-700 mb-1.5">Site Name <span class="text-rose-500">*</span></label>
         <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="site_name" placeholder="Enter your site name" value="{{ settings.site_name|default('') }}" required>
        </div>
        <div class="mb-4">
         <label class="block text-sm font-semibold text-slate-700 mb-1.5">Default Language</label>
         <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="default_language" placeholder="e.g., en, fr, es" value="{{ settings.default_language|default('en') }}">
        </div>
        <div class="mb-4">
         <label class="block text-sm font-semibold text-slate-700 mb-1.5">Timezone</label>
         <select class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="timezone">
          {% for tz, label in timezones|default([]) %}
          <option value="{{ tz }}" {% if settings.timezone|default('UTC') == tz %}selected{% endif %}>{{ label }}</option>
          {% endfor %}
         </select>
        </div>
       </div>
       <div>
        <div class="mb-4">
         <label class="block text-sm font-semibold text-slate-700 mb-1.5">Site Logo</label>
         <div class="mb-2 flex items-center gap-3">
          {% if settings.site_logo|default('') %}
          <div class="flex h-14 w-14 items-center justify-center rounded-lg border border-slate-200 bg-slate-50">
           <img id="logoPreview" src="{{ settings.site_logo|default('') }}" alt="Logo" class="max-h-10 max-w-10 object-contain">
          </div>
          <button type="button" id="removeLogoBtn" class="inline-flex items-center justify-center gap-2 rounded-lg bg-rose-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-rose-700" aria-label="Remove site logo">
           <i class="lucide lucide-trash-2"></i> Remove
          </button>
          {% else %}
          <div class="flex h-14 w-14 items-center justify-center rounded-lg border border-dashed border-slate-300 bg-slate-50 text-slate-400">
           <i class="lucide lucide-image" style="width:1.25em;height:1.25em;"></i>
          </div>
          <img id="logoPreview" src="" alt="Logo Preview" class="hidden max-h-10 max-w-10 object-contain">
          {% endif %}
         </div>
         <input type="hidden" name="remove_site_logo" id="remove_site_logo" value="0">
         <input type="text" class="mb-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="site_logo" placeholder="/assets/logo/logo.png" value="{{ settings.site_logo|default('') }}">
         <input type="file" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" id="siteLogoUpload" name="site_logo_file" accept="image/*">
        </div>
        <div class="mb-4">
         <label class="block text-sm font-semibold text-slate-700 mb-1.5">Favicon</label>
         <div class="mb-2 flex items-center gap-3">
          {% set favicon_url = settings.favicon|default('/assets/logo/favicon.ico') %}
          <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 bg-slate-50">
           <img id="faviconPreview" src="{{ favicon_url }}" alt="Favicon" class="max-h-6 max-w-6 object-contain">
          </div>
         </div>
         <input type="text" class="mb-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="favicon" placeholder="/assets/logo/favicon.ico" value="{{ settings.favicon|default('/assets/logo/favicon.ico') }}">
         <input type="file" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" id="faviconUpload" name="favicon_file" accept="image/*">
        </div>
       </div>
      </div>
     </div>

     {# ─── Contact Tab ─── #}
     <div class="tab-pane" id="contact" role="tabpanel" aria-labelledby="contact-tab" aria-hidden="true">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
       <div class="mb-4">
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Contact Email</label>
        <input type="email" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="contact_email" placeholder="contact@example.com" value="{{ settings.contact_email|default('') }}">
       </div>
       <div class="mb-4">
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Phone</label>
        <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="contact_phone" placeholder="+1 234 567 890" value="{{ settings.contact_phone|default('') }}">
       </div>
      </div>
      <div class="mb-4">
       <label class="block text-sm font-semibold text-slate-700 mb-1.5">Address</label>
       <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="contact_address" placeholder="123 Main St, City, Country" rows="3">{{ settings.contact_address|default('') }}</textarea>
      </div>
      <div class="rounded-lg border border-indigo-100 bg-indigo-50/50 p-4">
       <div class="flex items-start gap-3">
        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-indigo-100 text-indigo-600">
         <i class="lucide lucide-info" style="width:1em;height:1em;"></i>
        </div>
        <div>
         <p class="text-sm font-semibold text-indigo-800">Contact Information</p>
         <p class="mt-0.5 text-xs text-indigo-600/70">These details will be shown on the public contact page and in email footers.</p>
        </div>
       </div>
      </div>
     </div>

     {# ─── SEO Tab ─── #}
     <div class="tab-pane" id="seo" role="tabpanel" aria-labelledby="seo-tab" aria-hidden="true">
      <div class="space-y-4">
       <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Meta Title</label>
        <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="meta_title" placeholder="Enter meta title" value="{{ settings.meta_title|default('') }}">
        <p class="mt-1 text-xs text-slate-400">Recommended: 50-60 characters for optimal search result display.</p>
       </div>
       <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Meta Description</label>
        <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="meta_description" placeholder="Enter meta description" rows="3">{{ settings.meta_description|default('') }}</textarea>
        <p class="mt-1 text-xs text-slate-400">Recommended: 150-160 characters. This appears in search engine results.</p>
       </div>
       <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Meta Keywords</label>
        <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all" name="meta_keywords" placeholder="keyword1, keyword2, keyword3" rows="2">{{ settings.meta_keywords|default('') }}</textarea>
        <p class="mt-1 text-xs text-slate-400">Separate keywords with commas.</p>
       </div>
       <div class="rounded-lg border border-amber-100 bg-amber-50/50 p-4">
        <div class="flex items-start gap-3">
         <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-amber-600">
          <i class="lucide lucide-search" style="width:1em;height:1em;"></i>
         </div>
         <div>
          <p class="text-sm font-semibold text-amber-800">SEO Tip</p>
          <p class="mt-0.5 text-xs text-amber-600/70">Good meta descriptions can improve click-through rates from search results. Make each description unique and relevant.</p>
         </div>
        </div>
       </div>
      </div>
     </div>

     {# ─── Included tabs ─── #}
     <div class="tab-pane" id="mcp" role="tabpanel" aria-labelledby="mcp-tab" aria-hidden="true">{% include 'admin/settings/mcp.twig' %}</div>
     <div class="tab-pane" id="ai" role="tabpanel" aria-labelledby="ai-tab" aria-hidden="true">{% include 'admin/settings/ai.twig' %}</div>

     {# ─── Placeholder tabs (coming soon) ─── #}
     {% set placeholders = {
      "social":{"icon":"lucide lucide-share-2","color":"sky","title":"Social Media Settings","desc":"Configure social media links and sharing preferences."},
      "email":{"icon":"lucide lucide-mail-check","color":"violet","title":"Email / SMTP Settings","desc":"Configure mail server, SMTP credentials, and email templates."},
      "security":{"icon":"lucide lucide-shield","color":"rose","title":"Security Settings","desc":"Manage firewall rules, IP blocking, and security policies."},
      "payments":{"icon":"lucide lucide-credit-card","color":"emerald","title":"Payment Settings","desc":"Configure payment gateways, currency, and billing options."},
      "api":{"icon":"lucide lucide-cpu","color":"indigo","title":"API / Integrations","desc":"Manage API keys, webhooks, and third-party integrations."},
      "cache":{"icon":"lucide lucide-database","color":"teal","title":"Cache Settings","desc":"Manage caching strategy, TTL, and cache invalidation."},
      "security_controls":{"icon":"lucide lucide-shield-check","color":"amber","title":"Security Controls","desc":"Fine-grained security controls and audit logging."}
     } %}
     {% for key, ph in placeholders %}
     <div class="tab-pane" id="{{ key }}" role="tabpanel" aria-labelledby="{{ key }}-tab" aria-hidden="true">
      <div class="relative overflow-hidden rounded-xl border border-slate-200 bg-gradient-to-br from-indigo-50/50 to-violet-50/50 p-8 text-center">
       <div class="pointer-events-none absolute -right-6 -top-6 h-24 w-24 rounded-full bg-{{ ph.color }}-50/50 blur-2xl"></div>
       <div class="relative">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-{{ ph.color }}-50 text-{{ ph.color }}-500">
         <i class="{{ ph.icon }}" style="width:2em;height:2em;"></i>
        </div>
        <h3 class="mt-4 text-lg font-bold text-slate-900">{{ ph.title }}</h3>
        <p class="mt-1.5 text-sm text-slate-500 max-w-md mx-auto">{{ ph.desc }}</p>
        <div class="mt-6 inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-400 shadow-sm">
         <i class="lucide lucide-clock" style="width:0.875em;height:0.875em;"></i>
         Coming Soon
        </div>
       </div>
      </div>
     </div>
     {% endfor %}
    </div>

    {# ── Save Footer ── #}
    <div class="mt-8 flex items-center justify-end gap-3 rounded-xl border border-slate-100 bg-slate-50/50 px-5 py-4">
     <div class="hidden sm:flex items-center gap-2 text-xs text-slate-400 mr-auto">
      <i class="lucide lucide-check-circle" style="width:0.875em;height:0.875em;"></i>
      Changes are saved across all tabs
     </div>
     <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 hover:shadow-md active:scale-[0.97]">
      <i class="lucide lucide-save" style="width:1.125em;height:1.125em;"></i>
      Save Settings
     </button>
    </div>
   </form>
  </div>
 </section>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  var tablist = document.getElementById('appSettingsTabs');
  if (!tablist) return;

  var tabs = Array.from(tablist.querySelectorAll('[data-brox-toggle="tab"]'));
  if (!tabs.length) return;

  /** Activate tab by its target id (e.g. "contact", "seo") */
  function activateTab(targetId) {
    if (!targetId) return;
    var tab = tablist.querySelector('[data-brox-target="#' + CSS.escape(targetId) + '"]');
    if (tab && !tab.classList.contains('active')) {
      broxUI.Tab.getOrCreateInstance(tab).show();
    }
  }

  /** Extract target id from current hash */
  function getHashTarget() {
    return window.location.hash.replace(/^#/, '');
  }

  // ── On initial load, restore tab from URL hash ──
  var initialHash = getHashTarget();
  if (initialHash) {
    activateTab(initialHash);
  }

  // ── On tab switch, update URL hash silently ──
  tabs.forEach(function (tab) {
    tab.addEventListener('brox:shown', function () {
      var target = tab.getAttribute('data-brox-target');
      if (target && target.charAt(0) === '#') {
        var tabHash = target.slice(1);
        if (window.location.hash !== '#' + tabHash) {
          history.replaceState(null, '', '#' + tabHash);
        }
      }
    });
  });

  // ── On browser back/forward, sync active tab ──
  window.addEventListener('hashchange', function () {
    var hashTarget = getHashTarget();
    if (hashTarget) {
      activateTab(hashTarget);
    }
  });
});
</script>
{% endblock %}
