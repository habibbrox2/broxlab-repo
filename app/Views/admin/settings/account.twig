{% extends"admin/layout.twig" %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <input type="hidden" id="global-csrf-token" value="{{ csrf_token }}">
 <div class="w-full px-4 sm:px-6 py-4 ">
 <!-- Page Header -->
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-shield"></i>
 Account Settings
 </div>
 <div>Manage your account security and preferences</div>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 <!-- Sidebar Navigation -->
 <div class="lg:col-span-3 mb-4">
 <div class=" border border-slate-200 bg-white shadow-sm ">
 <div class=" border-slate-200 px-4 py-3  ">
 <h6 class=" mb-0">
 <i class="lucide lucide-list-checks"></i>
 Settings Menu
 </h6>
 </div>
 <div class="flex flex-col">
 <a href="/admin/profile"
 class="flex items-center gap-2 rounded-xl px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 hover:text-slate-900">
 <i class="lucide lucide-user-circle text-indigo-600"></i>
 <span>Profile</span>
 <i class="lucide lucide-chevron-right ml-auto text-slate-400"></i>
 </a>
 <a href="/admin/account-settings"
 class="flex items-center gap-2 rounded-xl bg-indigo-50 px-4 py-3 text-sm font-semibold text-indigo-700">
 <i class="lucide lucide-lock text-indigo-600"></i>
 <span>Account Security</span>
 </a>
 <a href="/admin/security/2fa"
 class="flex items-center gap-2 rounded-xl px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 hover:text-slate-900">
 <i class="lucide lucide-shield-check text-indigo-600"></i>
 <span>Two-Factor Auth</span>
 <i class="lucide lucide-chevron-right ml-auto text-slate-400"></i>
 </a>
 {% if auth_user.is_super_admin %}
 <a href="/admin/app-settings"
 class="flex items-center gap-2 rounded-xl px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 hover:text-slate-900">
 <i class="lucide lucide-sliders text-indigo-600"></i>
 <span>App Settings</span>
 <i class="lucide lucide-chevron-right ml-auto text-slate-400"></i>
 </a>
 {% endif %}
 </div>
 </div>
 </div>
 <!-- Main Content -->
 <div class="lg:col-span-9">
 <!-- Alert Container -->
 <div id="alert-container"></div>
 <!-- Password Management Section -->
 <div class=" border border-slate-200 bg-white shadow-sm  mb-4 ">
 <div class=" border-slate-200 px-4 py-3">
 <h6 class=" mb-0">
 <i class="lucide lucide-key"></i>
 Password Management
 </h6>
 </div>
 <div class="p-4">
 <p class="text-slate-500">Update and manage your account password</p>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3 ">
 {% if user_has_password %}
 <!-- Change Password -->
 <div class="md:col-span-6">
 <div class="p-3 border rounded text-center password-action-tile">
 <i class="lucide lucide-repeat text-indigo-600 password-action-icon"></i>
 <h6 class="mt-2 mb-1">Change Password</h6>
 <p class="text-slate-500 small mb-3">Update your current password</p>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 modern-px-3 py-1.5 text-xs"
 data-brox-toggle="modal"
 data-brox-target="#changePasswordModal">
 <i class="lucide lucide-pencil mr-1"></i> Change
 </button>
 </div>
 </div>
 {% else %}
 <!-- Set Password -->
 <div class="md:col-span-6">
 <div class="p-3 border rounded text-center password-action-tile">
 <i class="lucide lucide-plus-circle text-emerald-600 password-action-icon"></i>
 <h6 class="mt-2 mb-1">Set Password</h6>
 <p class="text-slate-500 small mb-3">Create a password for your account</p>
 <button type="button"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 modern-px-3 py-1.5 text-xs"
 data-brox-toggle="modal"
 data-brox-target="#setPasswordModal">
 <i class="lucide lucide-plus mr-1"></i> Set Password
 </button>
 </div>
 </div>
 {% endif %}
 </div>
 </div>
 </div>
 <!-- OAuth Account Linking Section -->
 <div class=" border border-slate-200 bg-white shadow-sm bordered-info mb-4 ">
 <div class=" border-slate-200 px-4 py-3">
 <h6 class=" mb-0">
 <i class="lucide lucide-link"></i>
 Connected Accounts
 </h6>
 </div>
 <div class="p-4 ">
 <p class="text-slate-500 mb-4">Link or unlink your social media accounts for easier login</p>
 <div id="oauth-accounts-container" class="oauth-accounts-wrapper">
 <div class="text-center py-4">
 <div class="inline-spinner inline-spinner-sm text-indigo-600" role="status">
 <span class="sr-only">Loading...</span>
 </div>
 <p class="text-slate-500 small mt-2">Loading your linked accounts...</p>
 </div>
 </div>
 <hr class="my-4">
 <!-- Link New Account Section -->
 <div>
 <h6 class="mb-3 text-slate-500 text-uppercase font-bold">
 <i class="lucide lucide-plus-circle mr-2"></i> Link New Account
 </h6>
 <p class="small text-slate-500 mb-3">
 Connect your social accounts to your admin profile for convenient login and enhanced security.
 </p>
 <div id="oauth-providers-container"
 class="flex flex-wrap gap-2 oauth-provider-grid">
 <div class="inline-spinner inline-spinner-sm text-indigo-600" role="status">
 <span class="sr-only">Loading...</span>
 </div>
 </div>
 <!-- Security Info -->
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200 small mt-3 mb-0 oauth-security-note">
 <i class="lucide lucide-shield mr-2"></i>
 <strong>Security:</strong> Your passwords are never shared with social providers. We only store authorization tokens.
 </div>
 </div>
 <!-- Notification Channels for Admin -->
 <hr class="my-4">
 <div class=" border border-slate-200 bg-white shadow-sm bordered-secondary mb-4 ">
 <div class=" border-slate-200 px-4 py-3">
 <h6 class=" mb-0">
 <i class="lucide lucide-bell"></i>
 Notification Channels
 </h6>
 </div>
 <div class="p-4">
 <p class="text-slate-500 mb-3">Choose how you want to receive system notifications.</p>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="md:col-span-6 mb-3">
 <div class="flex items-start gap-2 form-switch">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 notification-channel"
 type="checkbox"
 id="email-notifications"
 data-channel="email">
 <label class="text-sm text-slate-700" for="email-notifications">
 <strong>Email Notifications</strong>
 <small class="block text-slate-500">Receive updates via email</small>
 </label>
 </div>
 </div>
 <div class="md:col-span-6 mb-3">
 <div class="flex items-start gap-2 form-switch">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 notification-channel"
 type="checkbox"
 id="push-notifications"
 data-channel="push">
 <label class="text-sm text-slate-700" for="push-notifications">
 <strong>Push Notifications</strong>
 <small class="block text-slate-500">Browser push notifications</small>
 </label>
 </div>
 </div>
 <div class="md:col-span-6 mb-3">
 <div class="flex items-start gap-2 form-switch">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 notification-channel"
 type="checkbox"
 id="sms-notifications"
 data-channel="sms">
 <label class="text-sm text-slate-700" for="sms-notifications">
 <strong>SMS Notifications</strong>
 <small class="block text-slate-500">Text message alerts if supported</small>
 </label>
 </div>
 </div>
 <div class="md:col-span-6 mb-3">
 <div class="flex items-start gap-2 form-switch">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 notification-channel"
 type="checkbox"
 id="in-app-notifications"
 data-channel="in-app">
 <label class="text-sm text-slate-700" for="in-app-notifications">
 <strong>In-App Notifications</strong>
 <small class="block text-slate-500">Receive alerts within dashboard</small>
 </label>
 </div>
 </div>
 </div>
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700" id="save-notifications-btn">
 <i class="lucide lucide-save mr-1"></i>Save Preferences
 </button>
 </div>
 </div>
 </div>
 </div>
 <!-- Two-Factor Authentication Quick Access -->
 <div class=" border border-slate-200 bg-white shadow-sm bordered-warning ">
 <div class=" border-slate-200 px-4 py-3">
 <h6 class=" mb-0">
 <i class="lucide lucide-shield-check"></i>
 Two-Factor Authentication
 </h6>
 </div>
 <div class="p-4">
 <p class="text-slate-500 mb-3">Add an extra layer of security to your account by enabling two-factor authentication.</p>
 <div class="flex items-center justify-between gap-3 flex-wrap">
 <div class="twofa-status-wrap">
 {% if twofa_enabled %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-emerald-600 mb-2 block twofa-status-chip">
 <i class="lucide lucide-check-circle mr-1"></i> 2FA is Active
 </span>
 <p class="text-slate-500 small mb-0">Your account is protected with two-factor authentication</p>
 {% else %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-amber-500 mb-2 block twofa-status-chip">
 <i class="lucide lucide-alert-circle mr-1"></i> 2FA Not Enabled
 </span>
 <p class="text-slate-500 small mb-0">Enable 2FA to secure your account with an authenticator app</p>
 {% endif %}
 </div>
 <a href="/admin/security/2fa" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
 <i class="lucide lucide-arrow-right mr-1"></i> Manage 2FA
 </a>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Modals -->
 {% include"admin/partials/password-modals.twig" %}
{% endblock %}







