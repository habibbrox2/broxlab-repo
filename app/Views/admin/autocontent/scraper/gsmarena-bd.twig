{% extends 'admin/layout.twig' %}

{% block title %}GSMArena Bangladesh Devices{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="admin-panel-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="m-0">
                        <i class="bi bi-phone me-2"></i>
                        GSMArena Bangladesh Devices
                    </h4>
                    <div class="d-flex gap-2">
                        <a href="{{ base_url('admin/scraper/gsmarena-bd/list') }}" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-list me-1"></i> View All Devices
                        </a>
                        <a href="{{ base_url('admin/scraper/gsmarena-bd/scrape') }}" class="btn btn-primary btn-sm" onclick="return confirmScrape();">
                            <i class="bi bi-download me-1"></i> Scrape Now
                        </a>
                    </div>
                </div>
                
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="info-box">
                                <h5 class="info-box-title">
                                    <i class="bi bi-info-circle me-2"></i>
                                    About GSMArena Bangladesh Scraper
                                </h5>
                                <p class="info-box-text">
                                    This scraper extracts mobile device information from 
                                    <a href="https://www.gsmarena.com.bd" target="_blank" class="text-decoration-none">
                                        <strong>gsmarena.com.bd</strong>
                                    </a>
                                    including device names, prices, specifications, and images.
                                </p>
                                <ul class="info-box-list">
                                    <li><i class="bi bi-check-circle me-1"></i> Multi-page scraping with pagination</li>
                                    <li><i class="bi bi-check-circle me-1"></i> Price parsing for Bangladeshi Taka (৳)</li>
                                    <li><i class="bi bi-check-circle me-1"></i> HTML caching for debugging</li>
                                    <li><i class="bi bi-check-circle me-1"></i> Error handling and retry logic</li>
                                </ul>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="info-box">
                                <h5 class="info-box-title">
                                    <i class="bi bi-lightning-charge me-2"></i>
                                    Quick Actions
                                </h5>
                                <div class="d-flex flex-column gap-2">
                                    <a href="{{ base_url('admin/scraper/gsmarena-bd/list') }}" class="btn btn-outline-primary w-100">
                                        <i class="bi bi-list me-1"></i> View All Devices
                                    </a>
                                    <a href="{{ base_url('admin/scraper/gsmarena-bd/scrape') }}" class="btn btn-primary w-100" onclick="return confirmScrape();">
                                        <i class="bi bi-download me-1"></i> Scrape New Devices
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function confirmScrape() {
    return confirm('Are you sure you want to start scraping GSMArena Bangladesh devices?\n\nThis will:\n- Fetch multiple pages from gsmarena.com.bd\n- Extract device information\n- Save to database\n\nThe process may take several minutes.');
}
</script>
{% endblock %}