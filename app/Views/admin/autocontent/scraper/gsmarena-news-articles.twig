{% extends 'admin/layout.twig' %}

{% block title %}GSMArena News Articles - Admin{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">GSMArena News Articles</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="{{ base_url('admin/scraper/gsmarena-news') }}">Dashboard</a></li>
                    <li class="breadcrumb-item active">Articles</li>
                </ol>
            </nav>
        </div>
        <div>
            <a href="{{ base_url('admin/scraper/gsmarena-news/export/csv') }}" class="btn btn-outline-success me-2">
                <i class="fas fa-file-csv me-1"></i> Export CSV
            </a>
            <a href="{{ base_url('admin/scraper/gsmarena-news/export/json') }}" class="btn btn-outline-primary me-2">
                <i class="fas fa-file-code me-1"></i> Export JSON
            </a>
            <a href="{{ base_url('admin/scraper/gsmarena-news') }}" class="btn btn-primary">
                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="GET" action="{{ base_url('admin/scraper/gsmarena-news/articles') }}" class="row g-3">
                <div class="col-md-6">
                    <label for="search" class="form-label">Search</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" id="search" name="search" placeholder="Search by title..." value="{{ search|default('') }}">
                    </div>
                </div>
                <div class="col-md-3">
                    <label for="perPage" class="form-label">Per Page</label>
                    <select class="form-select" id="perPage" name="per_page">
                        <option value="20" {{ per_page == 20 ? 'selected' : '' }}>20</option>
                        <option value="50" {{ per_page == 50 ? 'selected' : '' }}>50</option>
                        <option value="100" {{ per_page == 100 ? 'selected' : '' }}>100</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-1"></i> Apply Filters
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Articles Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            {% if articles|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th style="width: 80px;">Image</th>
                                <th>Title</th>
                                <th>Published</th>
                                <th>Scraped</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for article in articles %}
                                <tr>
                                    <td>
                                        {% if article.image_url %}
                                            <img src="{{ article.image_url }}" alt="{{ article.title }}" class="rounded" style="width: 60px; height: 60px; object-fit: cover;">
                                        {% else %}
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                <i class="fas fa-newspaper text-muted"></i>
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ base_url('admin/scraper/gsmarena-news/articles/' ~ article.id) }}" class="text-decoration-none fw-bold">
                                            {{ article.title }}
                                        </a>
                                        <div class="text-muted small">
                                            <a href="{{ article.url }}" target="_blank" class="text-decoration-none">
                                                <i class="fas fa-external-link-alt me-1"></i>View Original
                                            </a>
                                        </div>
                                        {% if article.summary %}
                                            <div class="text-muted small mt-1" style="max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                {{ article.summary }}
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if article.published_at %}
                                            <span class="badge bg-light text-dark">
                                                {{ article.published_at|date('M d, Y') }}
                                            </span>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">
                                            {{ article.scraped_at|date('M d, Y H:i') }}
                                        </span>
                                        {% if article.updated_at != article.scraped_at %}
                                            <div class="text-muted small">
                                                Updated: {{ article.updated_at|date('M d, Y H:i') }}
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ base_url('admin/scraper/gsmarena-news/articles/' ~ article.id) }}" class="btn btn-sm btn-outline-primary me-1" title="View">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ article.url }}" target="_blank" class="btn btn-sm btn-outline-secondary me-1" title="Open Original">
                                            <i class="fas fa-external-link-alt"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ article.id }}" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                {% if total_pages > 1 %}
                    <nav aria-label="Page navigation" class="mt-4">
                        <ul class="pagination justify-content-center">
                            {% if current_page > 1 %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ base_url('admin/scraper/gsmarena-news/articles?page=' ~ (current_page - 1) ~ '&search=' ~ (search|default('')) ~ '&per_page=' ~ per_page) }}">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>
                            {% endif %}

                            {% for page in 1..total_pages %}
                                {% if page == current_page %}
                                    <li class="page-item active">
                                        <span class="page-link">{{ page }}</span>
                                    </li>
                                {% elseif page == 1 or page == total_pages or (page >= current_page - 2 and page <= current_page + 2) %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ base_url('admin/scraper/gsmarena-news/articles?page=' ~ page ~ '&search=' ~ (search|default('')) ~ '&per_page=' ~ per_page) }}">{{ page }}</a>
                                    </li>
                                {% elseif page == current_page - 3 or page == current_page + 3 %}
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                {% endif %}
                            {% endfor %}

                            {% if current_page < total_pages %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ base_url('admin/scraper/gsmarena-news/articles?page=' ~ (current_page + 1) ~ '&search=' ~ (search|default('')) ~ '&per_page=' ~ per_page) }}">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </nav>
                {% endif %}

                <!-- Results Info -->
                <div class="text-center text-muted mt-3">
                    Showing {{ (current_page - 1) * per_page + 1 }} to {{ min(current_page * per_page, total_count) }} of {{ total_count }} articles
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-newspaper text-muted fa-3x mb-3"></i>
                    <p class="text-muted mb-0">No articles found matching your criteria.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<!-- Delete Modals -->
{% for article in articles %}
<div class="modal fade" id="deleteModal{{ article.id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ article.id }}" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel{{ article.id }}">Delete Article</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this article?</p>
                <div class="card bg-light">
                    <div class="card-body">
                        <h6 class="card-title">{{ article.title }}</h6>
                        <p class="card-text text-muted small mb-0">{{ article.url }}</p>
                    </div>
                </div>
                <p class="text-danger small mt-3">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="POST" action="{{ base_url('admin/scraper/gsmarena-news/articles/' ~ article.id ~ '/delete') }}">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endfor %}
{% endblock %}
