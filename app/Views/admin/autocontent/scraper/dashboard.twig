{% extends 'admin/layout.twig' %}

{% block title %}Scraper Dashboard - Auto Content{% endblock %}

{% block stylesheets %}
<style>
  .scraper-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }
  .scraper-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
  }
  .stat-badge {
    font-size: 0.875rem;
    padding: 0.25rem 0.5rem;
  }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h2 class="mb-0">
            <i class="bi bi-gear-wide-connected me-2"></i>
            Scraper Dashboard
          </h2>
          <p class="text-muted mb-0 mt-1">Manage and monitor all web scrapers</p>
        </div>
        <div>
          <a href="/admin/autocontent" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Auto Content
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Scraper Cards -->
  <div class="row g-4">
    <!-- Teletalk Scraper -->
    <div class="col-md-6 col-lg-4">
      <div class="scraper-card card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-start mb-3">
            <div class="bg-primary bg-opacity-10 rounded p-3 me-3">
              <i class="bi bi-briefcase-fill text-primary fs-3"></i>
            </div>
            <div class="flex-grow-1">
              <h5 class="card-title mb-1">Teletalk Jobs</h5>
              <p class="text-muted small mb-0">Government job listings</p>
            </div>
          </div>
          
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <small class="text-muted">Total Jobs</small>
              <div class="h4 mb-0">{{ stats.teletalk.total|default(0) }}</div>
            </div>
            {% if stats.teletalk.last_scrape %}
            <div class="text-end">
              <small class="text-muted">Last Scrape</small>
              <div class="small">{{ stats.teletalk.last_scrape.timestamp|date('M d, H:i') }}</div>
            </div>
            {% endif %}
          </div>
          
          <a href="/admin/autocontent/scraper/teletalk" class="btn btn-primary w-100">
            <i class="bi bi-arrow-right-circle me-1"></i> Manage Scraper
          </a>
        </div>
      </div>
    </div>

    <!-- BDNews24 Scraper -->
    <div class="col-md-6 col-lg-4">
      <div class="scraper-card card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-start mb-3">
            <div class="bg-success bg-opacity-10 rounded p-3 me-3">
              <i class="bi bi-newspaper text-success fs-3"></i>
            </div>
            <div class="flex-grow-1">
              <h5 class="card-title mb-1">BDNews24</h5>
              <p class="text-muted small mb-0">Bangla news articles</p>
            </div>
          </div>
          
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <small class="text-muted">Total Articles</small>
              <div class="h4 mb-0">{{ stats.bdnews24.total|default(0) }}</div>
            </div>
            {% if stats.bdnews24.last_scrape %}
            <div class="text-end">
              <small class="text-muted">Last Scrape</small>
              <div class="small">{{ stats.bdnews24.last_scrape.timestamp|date('M d, H:i') }}</div>
            </div>
            {% endif %}
          </div>
          
          <a href="/admin/autocontent/scraper/bdnews24" class="btn btn-success w-100">
            <i class="bi bi-arrow-right-circle me-1"></i> Manage Scraper
          </a>
        </div>
      </div>
    </div>

    <!-- MobileDokan Scraper -->
    <div class="col-md-6 col-lg-4">
      <div class="scraper-card card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-start mb-3">
            <div class="bg-info bg-opacity-10 rounded p-3 me-3">
              <i class="bi bi-phone text-info fs-3"></i>
            </div>
            <div class="flex-grow-1">
              <h5 class="card-title mb-1">MobileDokan</h5>
              <p class="text-muted small mb-0">Mobile phone prices</p>
            </div>
          </div>
          
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <small class="text-muted">Total Phones</small>
              <div class="h4 mb-0">{{ stats.mobiledokan.total|default(0) }}</div>
            </div>
            {% if stats.mobiledokan.last_scrape %}
            <div class="text-end">
              <small class="text-muted">Last Scrape</small>
              <div class="small">{{ stats.mobiledokan.last_scrape.timestamp|date('M d, H:i') }}</div>
            </div>
            {% endif %}
          </div>
          
          <a href="/admin/autocontent/scraper/mobiledokan" class="btn btn-info w-100">
            <i class="bi bi-arrow-right-circle me-1"></i> Manage Scraper
          </a>
        </div>
      </div>
    </div>

    <!-- GSMArena BD Devices -->
    <div class="col-md-6 col-lg-4">
      <div class="scraper-card card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-start mb-3">
            <div class="bg-warning bg-opacity-10 rounded p-3 me-3">
              <i class="bi bi-device-hdd text-warning fs-3"></i>
            </div>
            <div class="flex-grow-1">
              <h5 class="card-title mb-1">GSMArena BD</h5>
              <p class="text-muted small mb-0">Mobile device specs</p>
            </div>
          </div>
          
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <small class="text-muted">Total Devices</small>
              <div class="h4 mb-0">{{ stats.gsmarena_devices.total|default(0) }}</div>
            </div>
          </div>
          
          <a href="/admin/autocontent/scraper/gsmarena-bd" class="btn btn-warning w-100">
            <i class="bi bi-arrow-right-circle me-1"></i> Manage Scraper
          </a>
        </div>
      </div>
    </div>

    <!-- GSMArena News -->
    <div class="col-md-6 col-lg-4">
      <div class="scraper-card card h-100 border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-start mb-3">
            <div class="bg-danger bg-opacity-10 rounded p-3 me-3">
              <i class="bi bi-rss text-danger fs-3"></i>
            </div>
            <div class="flex-grow-1">
              <h5 class="card-title mb-1">GSMArena News</h5>
              <p class="text-muted small mb-0">Mobile tech news</p>
            </div>
          </div>
          
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <small class="text-muted">Total Articles</small>
              <div class="h4 mb-0">{{ stats.gsmarena_news.total|default(0) }}</div>
            </div>
          </div>
          
          <a href="/admin/autocontent/scraper/gsmarena-news" class="btn btn-danger w-100">
            <i class="bi bi-arrow-right-circle me-1"></i> Manage Scraper
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Stats Summary -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">
            <i class="bi bi-bar-chart me-2"></i>
            Overall Statistics
          </h5>
        </div>
        <div class="card-body">
          <div class="row text-center">
            <div class="col-md-2 mb-3">
              <div class="p-3 border rounded">
                <h4 class="mb-1 text-primary">{{ stats.teletalk.total|default(0) }}</h4>
                <small class="text-muted">Teletalk Jobs</small>
              </div>
            </div>
            <div class="col-md-2 mb-3">
              <div class="p-3 border rounded">
                <h4 class="mb-1 text-success">{{ stats.bdnews24.total|default(0) }}</h4>
                <small class="text-muted">BDNews24 Articles</small>
              </div>
            </div>
            <div class="col-md-2 mb-3">
              <div class="p-3 border rounded">
                <h4 class="mb-1 text-info">{{ stats.mobiledokan.total|default(0) }}</h4>
                <small class="text-muted">MobileDokan Phones</small>
              </div>
            </div>
            <div class="col-md-2 mb-3">
              <div class="p-3 border rounded">
                <h4 class="mb-1 text-warning">{{ stats.gsmarena_devices.total|default(0) }}</h4>
                <small class="text-muted">GSMArena Devices</small>
              </div>
            </div>
            <div class="col-md-2 mb-3">
              <div class="p-3 border rounded">
                <h4 class="mb-1 text-danger">{{ stats.gsmarena_news.total|default(0) }}</h4>
                <small class="text-muted">GSMArena News</small>
              </div>
            </div>
            <div class="col-md-2 mb-3">
              <div class="p-3 border rounded bg-light">
                <h4 class="mb-1">{{ stats.teletalk.total|default(0) + stats.bdnews24.total|default(0) + stats.mobiledokan.total|default(0) + stats.gsmarena_devices.total|default(0) + stats.gsmarena_news.total|default(0) }}</h4>
                <small class="text-muted">Total Items</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
