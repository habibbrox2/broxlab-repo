{% extends 'admin/layout.twig' %}

{% block title %}{{ device.name }} - GSMArena Device - Admin{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Device Detail</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="{{ base_url('admin/scraper/gsmarena-devices') }}">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="{{ base_url('admin/scraper/gsmarena-devices/list') }}">Devices</a></li>
                    <li class="breadcrumb-item active">Detail</li>
                </ol>
            </nav>
        </div>
        <div>
            <a href="{{ device.url }}" target="_blank" class="btn btn-outline-primary me-2">
                <i class="fas fa-external-link-alt me-1"></i> View Original
            </a>
            <a href="{{ base_url('admin/scraper/gsmarena-devices/list') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to Devices
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Device Image -->
            {% if device.image_url %}
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-0">
                        <img src="{{ device.image_url }}" alt="{{ device.name }}" class="w-100 rounded-top" style="max-height: 400px; object-fit: contain; background: #f8f9fa;">
                    </div>
                </div>
            {% endif %}

            <!-- Device Information -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <h2 class="card-title mb-0 me-3">{{ device.name }}</h2>
                        <span class="badge bg-primary fs-6">{{ device.brand }}</span>
                    </div>
                    <hr>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <strong>Device ID:</strong>
                            <span class="badge bg-light text-dark">{{ device.id }}</span>
                        </div>
                        <div class="col-md-6">
                            <strong>Slug:</strong>
                            <code class="bg-light">{{ device.slug }}</code>
                        </div>
                        <div class="col-md-6">
                            <strong>Released:</strong>
                            {% if device.released %}
                                <span class="badge bg-light text-dark">{{ device.released }}</span>
                            {% else %}
                                <span class="text-muted">Not available</span>
                            {% endif %}
                        </div>
                        <div class="col-md-6">
                            <strong>Scraped:</strong>
                            <span class="badge bg-light text-dark">{{ device.scraped_at|date('F d, Y H:i') }}</span>
                        </div>
                        <div class="col-md-6">
                            <strong>Last Updated:</strong>
                            <span class="badge bg-light text-dark">{{ device.updated_at|date('F d, Y H:i') }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Key Specifications -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">Key Specifications</h5>
                    <div class="row g-3">
                        {% if device.display_size %}
                            <div class="col-md-4">
                                <div class="card bg-light border-0">
                                    <div class="card-body text-center">
                                        <i class="fas fa-mobile-alt text-primary fa-2x mb-2"></i>
                                        <h6 class="card-title mb-1">Display</h6>
                                        <p class="card-text small text-muted mb-0">{{ device.display_size }}</p>
                                        {% if device.display_resolution %}
                                            <p class="card-text small text-muted">{{ device.display_resolution }}</p>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% if device.ram %}
                            <div class="col-md-4">
                                <div class="card bg-light border-0">
                                    <div class="card-body text-center">
                                        <i class="fas fa-memory text-success fa-2x mb-2"></i>
                                        <h6 class="card-title mb-1">RAM</h6>
                                        <p class="card-text small text-muted mb-0">{{ device.ram }}</p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% if device.storage %}
                            <div class="col-md-4">
                                <div class="card bg-light border-0">
                                    <div class="card-body text-center">
                                        <i class="fas fa-hdd text-info fa-2x mb-2"></i>
                                        <h6 class="card-title mb-1">Storage</h6>
                                        <p class="card-text small text-muted mb-0">{{ device.storage }}</p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% if device.cpu %}
                            <div class="col-md-4">
                                <div class="card bg-light border-0">
                                    <div class="card-body text-center">
                                        <i class="fas fa-microchip text-warning fa-2x mb-2"></i>
                                        <h6 class="card-title mb-1">Processor</h6>
                                        <p class="card-text small text-muted mb-0">{{ device.cpu }}</p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% if device.main_camera %}
                            <div class="col-md-4">
                                <div class="card bg-light border-0">
                                    <div class="card-body text-center">
                                        <i class="fas fa-camera text-secondary fa-2x mb-2"></i>
                                        <h6 class="card-title mb-1">Camera</h6>
                                        <p class="card-text small text-muted mb-0">{{ device.main_camera }}</p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        {% if device.battery_capacity %}
                            <div class="col-md-4">
                                <div class="card bg-light border-0">
                                    <div class="card-body text-center">
                                        <i class="fas fa-battery-full text-danger fa-2x mb-2"></i>
                                        <h6 class="card-title mb-1">Battery</h6>
                                        <p class="card-text small text-muted mb-0">{{ device.battery_capacity }}</p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Full Specifications -->
            {% if device.specs %}
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Full Specifications</h5>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <tbody>
                                    {% for key, value in device.specs %}
                                        <tr>
                                            <th class="text-muted" style="width: 40%;">{{ key }}</th>
                                            <td>{{ value }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}

            <!-- Device URL -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">Source URL</h5>
                    <div class="input-group">
                        <input type="text" class="form-control" value="{{ device.url }}" readonly>
                        <a href="{{ device.url }}" target="_blank" class="btn btn-outline-primary">
                            <i class="fas fa-external-link-alt"></i> Open
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Quick Actions -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">Quick Actions</h5>
                    <div class="d-grid gap-2">
                        <a href="{{ device.url }}" target="_blank" class="btn btn-primary">
                            <i class="fas fa-external-link-alt me-1"></i> View Original Page
                        </a>
                        <a href="{{ base_url('admin/scraper/gsmarena-devices/list') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-list me-1"></i> View All Devices
                        </a>
                        <a href="{{ base_url('admin/scraper/gsmarena-devices') }}" class="btn btn-outline-info">
                            <i class="fas fa-tachometer-alt me-1"></i> Back to Dashboard
                        </a>
                    </div>
                </div>
            </div>

            <!-- Device Info -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">Device Information</h5>
                    <table class="table table-sm">
                        <tr>
                            <th class="text-muted" style="width: 40%;">ID</th>
                            <td>{{ device.id }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Slug</th>
                            <td><code>{{ device.slug }}</code></td>
                        </tr>
                        <tr>
                            <th class="text-muted">Name</th>
                            <td>{{ device.name }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Brand</th>
                            <td>{{ device.brand }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Image URL</th>
                            <td>
                                {% if device.image_url %}
                                    <a href="{{ device.image_url }}" target="_blank" class="text-decoration-none">
                                        <i class="fas fa-image me-1"></i> View
                                    </a>
                                {% else %}
                                    <span class="text-muted">No image</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Released</th>
                            <td>
                                {% if device.released %}
                                    {{ device.released }}
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Body</th>
                            <td>
                                {% if device.body %}
                                    {{ device.body }}
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">SIM</th>
                            <td>
                                {% if device.sim %}
                                    {{ device.sim }}
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">OS</th>
                            <td>
                                {% if device.os %}
                                    {{ device.os }}
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Scraped At</th>
                            <td>{{ device.scraped_at|date('Y-m-d H:i:s') }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Updated At</th>
                            <td>{{ device.updated_at|date('Y-m-d H:i:s') }}</td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Delete Device -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3 text-danger">Danger Zone</h5>
                    <p class="text-muted small">Once you delete a device, there is no going back. Please be certain.</p>
                    <button type="button" class="btn btn-danger w-100" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        <i class="fas fa-trash me-1"></i> Delete This Device
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Device</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this device?</p>
                <div class="card bg-light">
                    <div class="card-body">
                        <h6 class="card-title">{{ device.name }}</h6>
                        <p class="card-text text-muted small mb-0">{{ device.url }}</p>
                    </div>
                </div>
                <p class="text-danger small mt-3">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="POST" action="{{ base_url('admin/scraper/gsmarena-devices/' ~ device.id ~ '/delete') }}">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
