{% extends 'admin/layout.twig' %}

{% block title %}BDNews24 Articles - Admin{% endblock %}

{% block stylesheets %}
<style>
  .article-card {
    transition: all 0.2s ease;
  }
  .article-card:hover {
    background-color: var(--bs-tertiary-bg);
  }
  .article-image {
    width: 80px;
    height: 60px;
    object-fit: cover;
  }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
              <li class="breadcrumb-item"><a href="/admin/scraper/bdnews24">Scraper</a></li>
              <li class="breadcrumb-item active">Articles</li>
            </ol>
          </nav>
          <h2 class="mb-0">
            <i class="bi bi-newspaper me-2"></i>
            BDNews24 Articles
          </h2>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/admin/scraper/bdnews24/export/json" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-code me-1"></i> Export JSON
          </a>
          <a href="/admin/scraper/bdnews24/export/csv" class="btn btn-outline-primary">
            <i class="bi bi-file-earmark-excel me-1"></i> Export CSV
          </a>
          <a href="/admin/scraper/bdnews24" class="btn btn-primary">
            <i class="bi bi-download me-1"></i> Scrape New Articles
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <form method="GET" class="row g-3">
            <div class="col-md-4">
              <label for="search" class="form-label">Search</label>
              <input type="text" class="form-control" id="search" name="search" value="{{ search }}" placeholder="Search by title or headline...">
            </div>
            <div class="col-md-3">
              <label for="category" class="form-label">Category</label>
              <select class="form-select" id="category" name="category">
                <option value="">All Categories</option>
                {% for cat in categories %}
                <option value="{{ cat }}" {% if cat == selected_category %}selected{% endif %}>{{ cat }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
              <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search me-1"></i> Search
              </button>
            </div>
            <div class="col-md-2 d-flex align-items-end">
              {% if search or selected_category %}
              <a href="/admin/scraper/bdnews24/articles" class="btn btn-outline-secondary w-100">
                <i class="bi bi-x-circle me-1"></i> Clear
              </a>
              {% endif %}
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Results Info -->
  <div class="row mb-3">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted">Showing {{ ((current_page - 1) * limit) + 1 }} to {{ min(current_page * limit, total) }} of {{ total }} articles</span>
        </div>
        <div>
          <select class="form-select form-select-sm d-inline-block w-auto" onchange="changeLimit(this.value)">
            <option value="20" {% if limit == 20 %}selected{% endif %}>20 per page</option>
            <option value="50" {% if limit == 50 %}selected{% endif %}>50 per page</option>
            <option value="100" {% if limit == 100 %}selected{% endif %}>100 per page</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Articles Table -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-body p-0">
          {% if articles is empty %}
          <div class="text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <p class="text-muted mt-3">No articles found matching your criteria.</p>
          </div>
          {% else %}
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th style="width: 50px;">ID</th>
                  <th>Image</th>
                  <th>Title</th>
                  <th>Headline</th>
                  <th>Category</th>
                  <th>Published At</th>
                  <th>Scraped At</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for article in articles %}
                <tr class="article-card">
                  <td><span class="badge bg-secondary">{{ article.id }}</span></td>
                  <td>
                    {% if article.image_url %}
                    <img src="{{ article.image_url }}" alt="{{ article.title }}" class="article-image rounded">
                    {% else %}
                    <div class="bg-secondary rounded d-flex align-items-center justify-content-center article-image">
                      <i class="bi bi-newspaper text-white"></i>
                    </div>
                    {% endif %}
                  </td>
                  <td>
                    <div class="fw-bold">{{ article.title }}</div>
                    <small class="text-muted">ID: {{ article.article_id }}</small>
                  </td>
                  <td>{{ article.headline }}</td>
                  <td>
                    {% if article.category %}
                    <span class="badge bg-secondary">{{ article.category }}</span>
                    {% else %}
                    <span class="text-muted">-</span>
                    {% endif %}
                  </td>
                  <td>
                    {% if article.published_at %}
                    <small>{{ article.published_at|date('M d, Y H:i') }}</small>
                    {% else %}
                    <span class="text-muted">-</span>
                    {% endif %}
                  </td>
                  <td>
                    <small>{{ article.scraped_at|date('M d, Y H:i') }}</small>
                  </td>
                  <td class="text-end">
                    <a href="{{ article.url }}" target="_blank" class="btn btn-sm btn-outline-primary me-1" title="View on BDNews24">
                      <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                    <a href="/admin/scraper/bdnews24/articles/{{ article.id }}" class="btn btn-sm btn-outline-secondary me-1" title="View Details">
                      <i class="bi bi-eye"></i>
                    </a>
                    <button onclick="deleteArticle({{ article.id }})" class="btn btn-sm btn-outline-danger" title="Delete">
                      <i class="bi bi-trash"></i>
                    </button>
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- Pagination -->
  {% if total_pages > 1 %}
  <div class="row mt-4">
    <div class="col-12">
      <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
          {% if current_page > 1 %}
          <li class="page-item">
            <a class="page-link" href="?page={{ current_page - 1 }}&limit={{ limit }}&search={{ search }}&category={{ selected_category }}">
              <i class="bi bi-chevron-left"></i>
            </a>
          </li>
          {% endif %}

          {% for page in 1..total_pages %}
            {% if page == 1 or page == total_pages or (page >= current_page - 2 and page <= current_page + 2) %}
              <li class="page-item {% if page == current_page %}active{% endif %}">
                <a class="page-link" href="?page={{ page }}&limit={{ limit }}&search={{ search }}&category={{ selected_category }}">
                  {{ page }}
                </a>
              </li>
            {% elseif page == current_page - 3 or page == current_page + 3 %}
              <li class="page-item disabled"><span class="page-link">...</span></li>
            {% endif %}
          {% endfor %}

          {% if current_page < total_pages %}
          <li class="page-item">
            <a class="page-link" href="?page={{ current_page + 1 }}&limit={{ limit }}&search={{ search }}&category={{ selected_category }}">
              <i class="bi bi-chevron-right"></i>
            </a>
          </li>
          {% endif %}
        </ul>
      </nav>
    </div>
  </div>
  {% endif %}
</div>
{% endblock %}

{% block scripts %}
<script>
  function changeLimit(limit) {
    const url = new URL(window.location);
    url.searchParams.set('limit', limit);
    url.searchParams.set('page', '1');
    window.location.href = url.toString();
  }

  function deleteArticle(articleId) {
    Swal.fire({
      title: 'Are you sure?',
      text: 'This action cannot be undone!',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#dc3545',
      cancelButtonColor: '#6c757d',
      confirmButtonText: 'Yes, delete it!',
      cancelButtonText: 'Cancel'
    }).then((result) => {
      if (result.isConfirmed) {
        fetch(`/admin/scraper/bdnews24/articles/${articleId}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          }
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            Swal.fire({
              icon: 'success',
              title: 'Deleted!',
              text: 'Article has been deleted.',
              timer: 1500,
              timerProgressBar: true
            }).then(() => {
              location.reload();
            });
          } else {
            throw new Error(data.error || 'Failed to delete article');
          }
        })
        .catch(error => {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: error.message || 'Failed to delete article'
          });
        });
      }
    });
  }
</script>
{% endblock %}
