{% extends 'admin/layout.twig' %}

{% block title %}BDNews24 Article Detail - Admin{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/admin/scraper/bdnews24">BDNews24 Scraper</a></li>
            <li class="breadcrumb-item"><a href="/admin/scraper/bdnews24/articles">Articles</a></li>
            <li class="breadcrumb-item active" aria-current="page">Article Detail</li>
        </ol>
    </nav>

    <!-- Article Detail Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-newspaper me-2"></i>
                Article Detail
            </h5>
            <div>
                <a href="{{ article.url }}" target="_blank" class="btn btn-sm btn-light me-2">
                    <i class="fas fa-external-link-alt me-1"></i> View Original
                </a>
                <button onclick="deleteArticle({{ article.id }})" class="btn btn-sm btn-danger">
                    <i class="fas fa-trash me-1"></i> Delete
                </button>
            </div>
        </div>
        <div class="card-body">
            <!-- Article Image -->
            {% if article.image_url %}
            <div class="text-center mb-4">
                <img src="{{ article.image_url }}" alt="{{ article.title }}" class="img-fluid rounded" style="max-height: 400px;">
            </div>
            {% endif %}

            <!-- Article Title -->
            <h3 class="mb-3">{{ article.title }}</h3>

            <!-- Article Headline -->
            {% if article.headline %}
            <p class="lead text-muted mb-4">{{ article.headline }}</p>
            {% endif %}

            <!-- Article Info Table -->
            <div class="table-responsive mb-4">
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th style="width: 200px;">Article ID</th>
                            <td><code>{{ article.article_id }}</code></td>
                        </tr>
                        <tr>
                            <th>URL</th>
                            <td><a href="{{ article.url }}" target="_blank">{{ article.url }}</a></td>
                        </tr>
                        <tr>
                            <th>Category</th>
                            <td>
                                {% if article.category %}
                                <span class="badge bg-info">{{ article.category }}</span>
                                {% else %}
                                <span class="text-muted">N/A</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>Published Date</th>
                            <td>
                                {% if article.published_at %}
                                <i class="far fa-calendar-alt me-1"></i> {{ article.published_at }}
                                {% else %}
                                <span class="text-muted">N/A</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>Scraped At</th>
                            <td>
                                <i class="fas fa-clock me-1"></i> {{ article.scraped_at }}
                            </td>
                        </tr>
                        <tr>
                            <th>Last Updated</th>
                            <td>
                                <i class="fas fa-sync me-1"></i> {{ article.updated_at }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Back Button -->
            <a href="/admin/scraper/bdnews24/articles" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to Articles
            </a>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this article?</p>
                <p class="mb-0"><strong>Title:</strong> {{ article.title }}</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger">
                    <i class="fas fa-trash me-1"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function deleteArticle(id) {
    const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
    const confirmBtn = document.getElementById('confirmDeleteBtn');
    
    confirmBtn.onclick = function() {
        fetch(`/admin/scraper/bdnews24/articles/${id}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Deleted!',
                    text: 'Article has been deleted successfully.',
                    timer: 2000,
                    showConfirmButton: false
                }).then(() => {
                    window.location.href = '/admin/scraper/bdnews24/articles';
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message || 'Failed to delete article.'
                });
            }
        })
        .catch(error => {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'An error occurred while deleting the article.'
            });
        });
    };
    
    modal.show();
}
</script>
{% endblock %}
