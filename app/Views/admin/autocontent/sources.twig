{% extends 'admin/layout.twig' %}

{% block title %}AI Article Sources{% endblock %}

{% block content %}
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4">
  <h4 class="fw-bold mb-0"><i class="bi bi-rss me-2"></i>Content Sources</h4>
  <a href="/admin/autocontent/sources/create" class="btn btn-primary btn-sm">
    <i class="bi bi-plus-lg me-1"></i>Add Source
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 sources-table">
        <thead class="table-light">
          <tr>
            <th width="40" class="text-center">
              <input type="checkbox" id="select-all-checkbox" class="form-check-input table-select-checkbox">
            </th>
            <th>#</th>
            <th>Name</th>
            <th>URL</th>
            <th>Type</th>
            <th>Category</th>
            <th>Interval</th>
            <th>Status</th>
            <th>Last Fetched</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for source in sources %}
          <tr>
            <td class="text-center" data-label="Select">
              <input type="checkbox" class="form-check-input table-select-checkbox item-checkbox" value="{{ source.id }}">
            </td>
            <td data-label="#">{{ source.id }}</td>
            <td class="fw-semibold" data-label="Name">{{ source.name }}</td>
            <td class="text-truncate small source-url" title="{{ source.url }}" data-label="URL">
              <a href="{{ source.url }}" target="_blank" rel="noopener">{{ source.url }}</a>
            </td>
            <td data-label="Type"><span class="badge bg-info text-uppercase">{{ source.type }}</span></td>
            <td data-label="Category">{{ source.category_name ?? '-' }}</td>
            <td data-label="Interval">{{ (source.fetch_interval / 60)|round }}m</td>
            <td data-label="Status">
              <a href="/admin/autocontent/sources/toggle?id={{ source.id }}" class="text-decoration-none"
                 title="Click to toggle">
                {% if source.is_active %}
                  <span class="badge bg-success">Active</span>
                {% else %}
                  <span class="badge bg-secondary">Inactive</span>
                {% endif %}
              </a>
            </td>
            <td class="small" data-label="Last Fetched">
              {% if source.last_fetched_at %}
                {{ source.last_fetched_at|date('M d, H:i') }}
              {% else %}
                <span class="text-muted">Never</span>
              {% endif %}
            </td>
            <td data-label="Actions">
              <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-success" title="Collect Now"
                        onclick="collectFromSource({{ source.id }}, '{{ source.name|escape('js') }}')">
                  <i class="bi bi-cloud-download"></i>
                </button>
                <button type="button" class="btn btn-outline-dark" title="Multi-Layer Scrape"
                        onclick="multiLayerScrape({{ source.id }}, '{{ source.name|escape('js') }}')">
                  <i class="bi bi-layers"></i>
                </button>
                <a href="/admin/autocontent/sources/edit?id={{ source.id }}" class="btn btn-outline-primary" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
                <a href="/admin/autocontent/sources/delete?id={{ source.id }}" class="btn btn-outline-danger"
                   title="Delete" onclick="deleteSource({{ source.id }}, '{{ source.name|escape('js') }}'); return false;">
                  <i class="bi bi-trash"></i>
                </a>
              </div>
            </td>
          </tr>
          {% else %}
          <tr>
            <td colspan="10" class="text-center text-muted py-4">
              <i class="bi bi-rss fs-3 d-block mb-2"></i>
              No sources configured yet. Click "Add Source" to get started.
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

{# Bulk Action Bar #}
<div id="sources-bulk-bar" class="sources-bulk-bar" aria-hidden="true">
  <div class="sources-bulk-count" id="sources-selected-count">0</div>
  <div class="d-flex gap-2">
    <button type="button" class="btn btn-success btn-sm rounded-pill px-3" data-action="activate">
      <i class="bi bi-toggle-on me-1"></i>Activate
    </button>
    <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3" data-action="deactivate">
      <i class="bi bi-toggle-off me-1"></i>Deactivate
    </button>
    <button type="button" class="btn btn-danger btn-sm rounded-pill px-3" data-action="delete">
      <i class="bi bi-trash me-1"></i>Delete
    </button>
  </div>
</div>
{% endblock %}

{% block stylesheets %}
<style>
  .sources-bulk-bar {
    position: fixed;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%) translateY(120%);
    background: rgba(0,0,0,0.92);
    color: #fff;
    padding: 10px 14px;
    border-radius: 999px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.22);
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 1060;
    transition: transform 0.2s ease;
  }
  .sources-bulk-bar.active {
    transform: translateX(-50%) translateY(0);
  }
  .sources-bulk-count {
    font-weight: 700;
    background: var(--bs-primary);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .sources-table thead {
      display: none;
    }

    .sources-table tbody tr {
      display: block;
      padding: 0.85rem 0.85rem;
      border-bottom: 1px solid rgba(226, 232, 240, 0.9);
    }

    .sources-table tbody td {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      padding: 0.4rem 0;
      border: 0;
    }

    .sources-table tbody td::before {
      content: attr(data-label);
      font-weight: 600;
      color: #64748b;
      flex: 0 0 auto;
    }

    .sources-table tbody td.text-center {
      justify-content: space-between;
    }

    .sources-table .btn-group {
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .sources-table .source-url a {
      word-break: break-all;
    }

    .sources-table .badge {
      white-space: nowrap;
    }
  }
</style>
{% endblock %}

{% block scripts %}
<script>
function getCsrfToken() {
  var meta = document.querySelector('meta[name="csrf-token"]');
  return meta ? (meta.getAttribute('content') || '') : '';
}

function getSelectedSourceIds() {
  return Array.from(document.querySelectorAll('.item-checkbox:checked'))
    .map(cb => parseInt(cb.value, 10))
    .filter(n => Number.isFinite(n) && n > 0);
}

function updateSourcesBulkBar() {
  const bar = document.getElementById('sources-bulk-bar');
  const countEl = document.getElementById('sources-selected-count');
  if (!bar || !countEl) return;

  const count = document.querySelectorAll('.item-checkbox:checked').length;
  countEl.textContent = String(count);
  bar.classList.toggle('active', count > 0);
  bar.setAttribute('aria-hidden', count > 0 ? 'false' : 'true');
}

async function doSourcesBulkAction(action) {
  const ids = getSelectedSourceIds();
  if (ids.length === 0) {
    if (typeof window.showAlert === 'function') {
      await window.showAlert('Please select at least one source.', 'Nothing selected', 'warning');
    }
    return;
  }

  const actionLabel = action.charAt(0).toUpperCase() + action.slice(1);
  const confirmText = action === 'delete'
    ? 'This will delete the selected sources and all their queued articles. This cannot be undone.'
    : 'Apply "' + actionLabel + '" to selected sources?';

  const confirmed = typeof window.showConfirm === 'function'
    ? await window.showConfirm(confirmText, actionLabel + ' sources?', action === 'delete' ? 'danger' : 'info', {
        confirmButtonText: actionLabel,
        cancelButtonText: 'Cancel'
      })
    : true;

  if (!confirmed) return;

  try {
    const csrfToken = getCsrfToken();
    const body = new URLSearchParams();
    body.set('csrf_token', csrfToken);
    body.set('action', action);
    ids.forEach(id => body.append('ids[]', String(id)));

    const res = await fetch('/admin/autocontent/sources/bulk-action?ajax=1', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-Token': csrfToken
      },
      body: body.toString()
    });

    const data = await res.json();
    if (data.success) {
      if (typeof window.showAlert === 'function') {
        await window.showAlert(data.message || 'Done', 'Success', 'success');
      }
      window.location.reload();
      return;
    }

    if (typeof window.showAlert === 'function') {
      await window.showAlert(data.message || 'Bulk action failed', 'Error', 'danger');
    }
  } catch (e) {
    if (typeof window.showAlert === 'function') {
      await window.showAlert('Connection failed', 'Network Error', 'danger');
    }
  }
}

document.addEventListener('DOMContentLoaded', function() {
  const selectAll = document.getElementById('select-all-checkbox');
  if (selectAll) {
    selectAll.addEventListener('change', updateSourcesBulkBar);
  }

  document.querySelectorAll('.item-checkbox').forEach(function(cb) {
    cb.addEventListener('change', updateSourcesBulkBar);
  });
  updateSourcesBulkBar();

  document.querySelectorAll('#sources-bulk-bar [data-action]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const action = btn.getAttribute('data-action') || '';
      doSourcesBulkAction(action);
    });
  });
});

async function collectFromSource(sourceId, sourceName) {
  var confirmed = typeof window.showConfirm === 'function'
    ? await window.showConfirm(
        'This will collect articles from "' + sourceName + '". Continue?',
        'Collect Articles?',
        'info',
        {
          confirmButtonText: 'Collect',
          cancelButtonText: 'Cancel'
        }
      )
    : true;

  if (!confirmed) {
    return;
  }

  try {
    if (window.MessageHandler && typeof window.MessageHandler.showLoading === 'function') {
      await window.MessageHandler.showLoading('Fetching articles from ' + sourceName, 'Collecting...');
    }

    const csrfToken = document.querySelector('meta[name=\"csrf-token\"]')?.getAttribute('content') || '';
    const response = await fetch('/admin/autocontent/api/collect-single?ajax=1', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-Token': csrfToken
      },
      body: `csrf_token=${encodeURIComponent(csrfToken)}&source_id=${encodeURIComponent(sourceId)}`
    });
    const data = await response.json();

    if (window.MessageHandler && typeof window.MessageHandler.hideLoading === 'function') {
      window.MessageHandler.hideLoading();
    }

    if (data.success) {
      if (typeof window.showAlert === 'function') {
        await window.showAlert(data.message || 'Articles collected successfully', 'Success', 'success');
      }
      if (data.warning && typeof window.showAlert === 'function') {
        await window.showAlert(String(data.warning), 'Warning', 'warning');
      }
      window.location.reload();
      return;
    }

    if (typeof window.showAlert === 'function') {
      await window.showAlert(data.message || 'Failed to collect articles', 'Error', 'danger');
    }
  } catch (error) {
    console.error('Error:', error);
    if (window.MessageHandler && typeof window.MessageHandler.hideLoading === 'function') {
      window.MessageHandler.hideLoading();
    }
    if (typeof window.showAlert === 'function') {
      await window.showAlert('An error occurred while collecting articles', 'Error', 'danger');
    }
  }
}

async function multiLayerScrape(sourceId, sourceName) {
  var confirmed = typeof window.showConfirm === 'function'
    ? await window.showConfirm(
        'This will run the 5-step scraping pipeline on "' + sourceName + '". Steps: Fetch List -> Extract Links -> Loop Articles -> Fetch Page -> Extract Content.',
        'Multi-Layer Scrape?',
        'info',
        {
          confirmButtonText: 'Start Scraping',
          cancelButtonText: 'Cancel'
        }
      )
    : true;

  if (!confirmed) {
    return;
  }

  try {
    if (window.MessageHandler && typeof window.MessageHandler.showLoading === 'function') {
      await window.MessageHandler.showLoading('Running 5-step pipeline on ' + sourceName, 'Scraping in Progress...');
    }

    const csrfToken = document.querySelector('meta[name=\"csrf-token\"]')?.getAttribute('content') || '';
    const response = await fetch('/admin/autocontent/api/collect-multi?ajax=1', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-Token': csrfToken
      },
      body: `csrf_token=${encodeURIComponent(csrfToken)}&source_id=${encodeURIComponent(sourceId)}`
    });
    const data = await response.json();

    if (window.MessageHandler && typeof window.MessageHandler.hideLoading === 'function') {
      window.MessageHandler.hideLoading();
    }

    if (data.success) {
      var message = data.message || 'Articles scraped successfully!';
      if (data.pipeline) {
        message += '\n\nResults:';
        message += '\n- Links Found: ' + (data.pipeline.total_links_found || 0);
        message += '\n- Articles Collected: ' + (data.pipeline.articles_collected || 0);
        message += '\n- Steps Completed: ' + (data.pipeline.steps_completed || 0) + '/5';
      }
      if (data.errors && data.errors.length > 0) {
        message += '\n- Errors: ' + data.errors.length;
      }
      if (data.warnings && data.warnings.length > 0) {
        message += '\n- Warnings: ' + data.warnings.length;
      }

      if (typeof window.showAlert === 'function') {
        await window.showAlert(message, 'Success', 'success');
      }
      if (data.warnings && data.warnings.length > 0 && typeof window.showAlert === 'function') {
        await window.showAlert('• ' + data.warnings.slice(0, 5).join('\n• '), 'Warnings', 'warning');
      }
      window.location.reload();
      return;
    }

    if (typeof window.showAlert === 'function') {
      await window.showAlert(data.message || 'Failed to scrape articles', 'Error', 'danger');
    }
  } catch (error) {
    console.error('Error:', error);
    if (window.MessageHandler && typeof window.MessageHandler.hideLoading === 'function') {
      window.MessageHandler.hideLoading();
    }
    if (typeof window.showAlert === 'function') {
      await window.showAlert('An error occurred while scraping articles', 'Error', 'danger');
    }
  }
}

async function deleteSource(sourceId, sourceName) {
  const result = typeof window.showConfirm === 'function'
    ? await window.showConfirm(
        'This will permanently delete "' + sourceName + '" and all its queued articles. This cannot be undone.',
        'Delete Source?',
        'danger',
        {
          confirmButtonText: 'Delete',
          cancelButtonText: 'Cancel'
        }
      )
    : true;

  if (result) {
    window.location.href = '/admin/autocontent/sources/delete?id=' + sourceId;
  }
}
</script>
{% endblock %}
