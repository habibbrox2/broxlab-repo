{% extends 'admin/layout.twig' %}

{% block title %}Queue Item #{{ item.id }}{% endblock %}

{% block content %}
<div class="autocontent-queue-view">
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <a href="/admin/autocontent/queue" class="btn btn-sm btn-outline-secondary mb-2"><i class="bi bi-arrow-left me-1"></i>Back to Queue</a>
    <h4 class="fw-bold mb-0">{{ item.display_title ?? 'Queue Item #' ~ item.id }}</h4>
  </div>
  <div class="d-flex gap-2">
    {% if item.status in ['processed', 'failed'] %}
      <form method="POST" action="/admin/autocontent/queue/approve">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="id" value="{{ item.id }}">
        <button class="btn btn-success btn-sm"><i class="bi bi-check-lg me-1"></i>Approve</button>
      </form>
      <form method="POST" action="/admin/autocontent/queue/reject">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="id" value="{{ item.id }}">
        <button class="btn btn-outline-dark btn-sm"><i class="bi bi-x-lg me-1"></i>Reject</button>
      </form>
    {% endif %}
    {% if item.status in ['processed', 'approved'] %}
      <form method="POST" action="/admin/autocontent/queue/publish">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="id" value="{{ item.id }}">
        <button class="btn btn-primary btn-sm"><i class="bi bi-send me-1"></i>Publish Now</button>
      </form>
    {% endif %}
  </div>
</div>

{# Metadata Section #}
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <div class="row g-3 small">
      <div class="col-md-3"><strong>ID:</strong> #{{ item.id }}</div>
      <div class="col-md-3"><strong>Status:</strong> {{ item.status|default('-') }}</div>
      <div class="col-md-3"><strong>Content Type:</strong> {{ item.content_type ? item.content_type|capitalize : '-' }}</div>
      <div class="col-md-3"><strong>Source:</strong> {{ item.source_name|default('-') }}</div>
      <div class="col-md-6"><strong>Article URL:</strong> {{ item.url|default('-') }}</div>
      <div class="col-md-6"><strong>Source URL:</strong> {{ item.source_url|default('-') }}</div>
      <div class="col-md-4"><strong>Author:</strong> {{ item.display_author|default('—') }}</div>
      <div class="col-md-4"><strong>Created:</strong> {{ item.created_at ? item.created_at|date('M d, H:i') : '-' }}</div>
      <div class="col-md-4"><strong>Updated:</strong> {{ item.updated_at ? item.updated_at|date('M d, H:i') : '-' }}</div>
      <div class="col-md-6"><strong>Image:</strong> {{ item.image_url|default('-') }}</div>
      <div class="col-md-6"><strong>Hashes:</strong> {{ item.content_hash|default('-') }} {{ item.simhash ? ' / ' ~ item.simhash : '' }}</div>
    </div>
  </div>
</div>

<div class="compare-container mb-4">
  {# LEFT: Original Content #}
  <div class="card editor-glass-card shadow-sm">
    <div class="panel-header d-flex justify-content-between align-items-center">
      <h6 class="fw-bold mb-0 text-secondary"><i class="bi bi-file-earmark-text me-2"></i>Original Source</h6>
      {% if item.source_url %}
        <a href="{{ item.source_url }}" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill"><i class="bi bi-link-45deg me-1"></i>View</a>
      {% endif %}
    </div>
    <div class="scroll-pane">
       <h5 class="fw-bold mb-3 text-dark">{{ item.original_title ?? item.title ?? '—' }}</h5>
       <div class="content-preview-raw">
         {% if item.display_original_content_clean %}
           {{ item.display_original_content_clean|raw }}
         {% else %}
           <span class="text-muted">—</span>
         {% endif %}
       </div>
    </div>
  </div>

  {# RIGHT: AI Enhanced Content #}
  <div class="card editor-glass-card shadow-sm position-relative">
    <div class="panel-header d-flex justify-content-between align-items-center">
      <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-stars me-2"></i>AI Enhanced Content</h6>
      <span class="badge-seo bg-primary bg-opacity-10 text-primary"><i class="bi bi-text-paragraph me-1"></i>{{ item.word_count|default('-') }} Words</span>
    </div>

    {# SEO Badge #}
    <div class="seo-floating-badge {% if item.seo_score >= 70 %}bg-success{% elseif item.seo_score >= 40 %}bg-warning{% else %}bg-danger{% endif %} text-white">
      <i class="bi bi-graph-up"></i>
    </div>

    <form method="POST" action="/admin/autocontent/queue/edit" class="scroll-pane h-100">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <input type="hidden" name="id" value="{{ item.id }}">
      
      <div class="mb-4">
        <label class="small fw-bold text-muted text-uppercase mb-2">Refined Title</label>
        <input type="text" name="ai_title" class="form-control form-control-lg border-0 bg-light-subtle" value="{{ item.prefill_ai_title }}" placeholder="AI Generated Title">
        <div class="progress mt-2" style="height: 3px;">
          <div class="progress-bar {% if item.prefill_ai_title|length > 60 %}bg-danger{% else %}bg-success{% endif %}" style="width: {{ (item.prefill_ai_title|length / 60 * 100)|min(100) }}%"></div>
        </div>
      </div>

      <div class="mb-4">
        <label class="small fw-bold text-muted text-uppercase mb-2">Meta Description</label>
        <textarea name="ai_meta_description" class="form-control border-0 bg-light-subtle" rows="3">{{ item.prefill_ai_meta_description }}</textarea>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <label class="small fw-bold text-muted text-uppercase mb-2">Slug</label>
          <input type="text" name="ai_slug" class="form-control border-0 bg-light-subtle" value="{{ item.ai_slug|default('') }}">
        </div>
        <div class="col-md-6">
          <label class="small fw-bold text-muted text-uppercase mb-2">Category</label>
          <input type="text" name="ai_category" class="form-control border-0 bg-light-subtle" value="{{ item.ai_category|default('') }}">
        </div>
      </div>

      <div class="mb-5">
        <label class="small fw-bold text-muted text-uppercase mb-2">Full Content (Markdown/HTML Support)</label>
        <textarea name="ai_content" id="ai_content_editor" class="form-control border-0 bg-light-subtle" rows="20">{{ item.prefill_ai_content }}</textarea>
      </div>

      {# Tags & Summary (Display Only in side-by-side) #}
      <div class="mb-4 border-top pt-4">
        <h6 class="small fw-bold text-muted text-uppercase mb-3">AI Suggestions</h6>
        <div class="mb-3">
          {% set tags = item.ai_tags|default('[]') %}
          {% for tag in tags|json_decode %}
            <span class="badge bg-secondary bg-opacity-10 text-secondary me-1 mb-1">{{ tag }}</span>
          {% endfor %}
        </div>
        <p class="x-small text-muted font-italic">{{ item.ai_summary }}</p>
      </div>

      {# Sticky Action Bar #}
      <div class="sticky-actions d-flex justify-content-between align-items-center">
        <div class="d-flex gap-2">
           <button type="submit" class="btn btn-primary"><i class="bi bi-save me-2"></i>Save Progress</button>
           {% if item.status == 'processed' %}
           <button type="button" class="btn btn-success" onclick="approveItem({{ item.id }})"><i class="bi bi-check-lg me-2"></i>Approve Now</button>
           {% endif %}
        </div>
        <button type="button" class="btn btn-outline-danger btn-sm" onclick="confirmDelete({{ item.id }})"><i class="bi bi-trash"></i></button>
      </div>
    </form>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function getCsrfToken() {
    var meta = document.querySelector('meta[name="csrf-token"]');
    return meta ? (meta.getAttribute('content') || '') : '';
}

async function approveItem(id) {
    const result = typeof window.showConfirm === 'function'
        ? await window.showConfirm(
            'This will mark the article as approved and ready for publishing.',
            'Approve Article?',
            'success',
            {
                confirmButtonText: 'Approve',
                cancelButtonText: 'Cancel'
            }
        )
        : true;

    if (!result) {
        return;
    }

    try {
        const response = await fetch('/admin/autocontent/queue/approve?ajax=1', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-Token': getCsrfToken() },
            body: `id=${id}&csrf_token=${getCsrfToken()}`
        });
        const res = await response.json();
        if (res.success) {
            if (typeof window.showAlert === 'function') {
                await window.showAlert(res.message, 'Approved', 'success');
            }
            window.location.reload();
        } else if (typeof window.showAlert === 'function') {
            await window.showAlert(res.message, 'Error', 'danger');
        }
    } catch (e) {
        if (typeof window.showAlert === 'function') {
            await window.showAlert('Connection failed', 'Error', 'danger');
        }
    }
}

async function confirmDelete(id) {
    const result = typeof window.showConfirm === 'function'
        ? await window.showConfirm(
            'This action cannot be undone. The article will be permanently removed.',
            'Delete Article?',
            'danger',
            {
                confirmButtonText: 'Delete',
                cancelButtonText: 'Cancel'
            }
        )
        : true;

    if (!result) {
        return;
    }

    try {
        const response = await fetch('/admin/autocontent/queue/delete?ajax=1', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-Token': getCsrfToken() },
            body: `id=${id}&csrf_token=${getCsrfToken()}`
        });
        const res = await response.json();
        if (res.success) {
            if (typeof window.showAlert === 'function') {
                await window.showAlert('Article has been removed.', 'Deleted', 'success');
            }
            window.location.href = '/admin/autocontent/queue';
        } else if (typeof window.showAlert === 'function') {
            await window.showAlert(res.message, 'Error', 'danger');
        }
    } catch (e) {
        if (typeof window.showAlert === 'function') {
            await window.showAlert('Connection failed', 'Error', 'danger');
        }
    }
}
</script>
{% endblock %}
