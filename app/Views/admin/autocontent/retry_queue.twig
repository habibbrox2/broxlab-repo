{% extends 'admin/layout.twig' %}

{% block title %}Retry Queue{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <h4 class="fw-bold mb-1"><i class="bi bi-arrow-repeat me-2"></i>Retry Queue</h4>
    <div class="text-muted small">Failed or pending scrape retries with immediate actions.</div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <a href="/admin/autocontent" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
    <a href="/admin/autocontent/logs" class="btn btn-outline-dark btn-sm"><i class="bi bi-journal-text me-1"></i>Scrape Logs</a>
  </div>
</div>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body">
    <form method="GET" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small text-muted fw-semibold">Source</label>
        <select class="form-select" name="source_id">
          <option value="">All</option>
          {% for s in sources %}
            <option value="{{ s.id }}" {% if filters.source_id and filters.source_id == s.id %}selected{% endif %}>{{ s.name }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small text-muted fw-semibold">Status</label>
        <select class="form-select" name="status">
          <option value="">All</option>
          {% for st in ['pending','processing','completed','failed'] %}
            <option value="{{ st }}" {% if filters.status and filters.status == st %}selected{% endif %}>{{ st }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label small text-muted fw-semibold">Search</label>
        <input class="form-control" name="q" value="{{ filters.q ?? '' }}" placeholder="URL or error text">
      </div>
      <div class="col-md-2">
        <label class="form-label small text-muted fw-semibold">Limit</label>
        <input type="number" class="form-control" name="limit" min="10" max="200" value="{{ limit }}">
      </div>
      <div class="col-md-1 d-grid">
        <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
      </div>
    </form>
  </div>
</div>

<form method="POST" id="retryQueueForm" action="/admin/autocontent/retry-queue/retry">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

  <div class="d-flex gap-2 mb-2 flex-wrap">
    <button type="submit" class="btn btn-outline-primary btn-sm" formaction="/admin/autocontent/retry-queue/retry">
      <i class="bi bi-play-circle me-1"></i>Retry Now
    </button>
    <button type="submit" class="btn btn-outline-warning btn-sm" formaction="/admin/autocontent/retry-queue/mark-failed">
      <i class="bi bi-x-circle me-1"></i>Mark Failed
    </button>
    <button type="submit" class="btn btn-outline-danger btn-sm" formaction="/admin/autocontent/retry-queue/clear">
      <i class="bi bi-trash me-1"></i>Clear
    </button>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th class="text-muted small"><input type="checkbox" id="checkAll"></th>
              <th class="text-muted small">ID</th>
              <th class="text-muted small">Source</th>
              <th class="text-muted small">Status</th>
              <th class="text-muted small">Attempts</th>
              <th class="text-muted small">Next Attempt</th>
              <th class="text-muted small">Last Attempt</th>
              <th class="text-muted small">URL</th>
              <th class="text-muted small">Error</th>
              <th class="text-muted small">Created</th>
              <th class="text-muted small">Updated</th>
            </tr>
          </thead>
          <tbody>
            {% for row in items %}
              <tr>
                <td class="small text-nowrap"><input type="checkbox" name="ids[]" value="{{ row.id }}"></td>
                <td class="small text-nowrap">{{ row.id }}</td>
                <td class="small text-nowrap">{{ row.source_name ?? ('#' ~ row.source_id) }}</td>
                <td class="small text-nowrap"><code>{{ row.status }}</code></td>
                <td class="small text-nowrap">{{ row.attempts ?? 0 }}/{{ row.max_attempts ?? 3 }}</td>
                <td class="small text-nowrap">{{ row.next_attempt ?? '—' }}</td>
                <td class="small text-nowrap">{{ row.last_attempt ?? '—' }}</td>
                <td class="small text-break"><a href="{{ row.url }}" target="_blank" rel="noopener">{{ row.url }}</a></td>
                <td class="small text-break text-muted">{{ row.error_message ?? '' }}</td>
                <td class="small text-nowrap">{{ row.created_at }}</td>
                <td class="small text-nowrap">{{ row.updated_at ?? '' }}</td>
              </tr>
            {% else %}
              <tr>
                <td colspan="11" class="p-4 text-center text-muted">No retry queue entries found.</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</form>

{% set totalPages = (total / limit)|round(0, 'ceil') %}
{% if totalPages > 1 %}
  <nav class="mt-3">
    <ul class="pagination pagination-sm mb-0">
      {% for p in 1..totalPages %}
        <li class="page-item {{ p == page ? 'active' : '' }}">
          <a class="page-link" href="/admin/autocontent/retry-queue?page={{ p }}&limit={{ limit }}&source_id={{ (filters.source_id ?? '')|url_encode }}&status={{ (filters.status ?? '')|url_encode }}&q={{ (filters.q ?? '')|url_encode }}">{{ p }}</a>
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endif %}

{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
  const checkAll = document.getElementById('checkAll');
  if (!checkAll) return;
  checkAll.addEventListener('change', function() {
    document.querySelectorAll('input[name="ids[]"]').forEach(cb => {
      cb.checked = checkAll.checked;
    });
  });
});
</script>
{% endblock %}
