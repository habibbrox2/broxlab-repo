{# Partial: Category selector and prefill
 Expects: categories (array of {id,name}), selectedCategories (array of ids or objects)
#}
{% set selectedIds = [] %}
{% for sc in selectedCategories|default([]) %}
 {% if sc is iterable %}
 {% if sc.id is defined and (sc.id ~ '') is not empty %}
 {% set selectedIds = selectedIds|merge([sc.id ~ '']) %}
 {% endif %}
 {% else %}
 {% set raw = sc ~ '' %}
 {% if raw matches '/^[0-9]+$/' %}
 {% set selectedIds = selectedIds|merge([raw]) %}
 {% endif %}
 {% endif %}
{% endfor %}

<select multiple name="category_ids[]" id="category_ids_select" class="block w-full min-h-44 rounded-2xl border border-slate-300 bg-white/95 px-4 py-3 text-sm text-slate-900 shadow-sm transition-all duration-200 ease-out focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/10 hover:border-slate-400">
 {% for cat in categories %}
 {% set catId = cat.id ~ '' %}
 <option value="{{ cat.id }}" {{ catId in selectedIds ? 'selected' : '' }}>{{ cat.name }}</option>
 {% endfor %}
</select>
<p class="text-[11px] leading-relaxed text-slate-500">Search or create labels, then press Enter.</p>


