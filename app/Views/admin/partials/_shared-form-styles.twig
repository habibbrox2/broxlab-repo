}
[data-theme="dark"] .form-input:hover,
[data-theme="dark"] .form-textarea:hover,
[data-theme="dark"] .form-select:hover {
 @apply border-slate-500;
}
[data-theme="dark"] .form-input:focus,
[data-theme="dark"] .form-select:focus,
[data-theme="dark"] .form-textarea:focus {
 @apply border-indigo-500 bg-slate-800/95 shadow-lg shadow-indigo-500/10;
}
[data-theme="dark"] .form-input.has-error,
[data-theme="dark"] .form-input:user-invalid,
[data-theme="dark"] .form-textarea.has-error,
[data-theme="dark"] .form-textarea:user-invalid {
 @apply border-red-500 bg-red-950/20 ring-red-500/20;
}
[data-theme="dark"] .form-label {
 @apply text-slate-300;
}
[data-theme="dark"] .form-label .required {
 @apply text-rose-400;
}
[data-theme="dark"] .form-hint {
 @apply text-slate-500;
}
[data-theme="dark"] .btn-outline {
 @apply border-slate-600 bg-slate-800/90 text-slate-200 hover:border-slate-500 hover:bg-slate-700;
}
[data-theme="dark"] .btn-secondary {
 @apply bg-slate-700 text-slate-200 hover:bg-slate-600;
}
[data-theme="dark"] .pill-option {
 @apply border-slate-700 bg-slate-800/90 text-slate-300;
}
[data-theme="dark"] .pill-option:hover {
 @apply border-indigo-700 bg-indigo-950/30 text-indigo-300;
}
[data-theme="dark"] .pill-option.active {
 @apply border-indigo-500 bg-indigo-600 text-white;
}
[data-theme="dark"] .char-progress-track {
 @apply bg-slate-700;
}
[data-theme="dark"] .form-action-panel {
 @apply border-slate-700 bg-gradient-to-br from-indigo-950/30 via-slate-900 to-slate-950;
}
[data-theme="dark"] .form-helper-card {
 @apply border-slate-700 bg-slate-900/90;
}
</style>
