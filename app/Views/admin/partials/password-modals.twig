<!-- Set Password Modal -->
<div class="fixed inset-0 z-50 hidden items-center justify-center p-4" id="setPasswordModal" data-brox-modal="true">
 <div class="fixed inset-0 bg-black/50 backdrop-blur-sm transition-opacity" data-brox-dismiss="modal" aria-hidden="true"></div>
 <div class="relative w-full max-w-lg overflow-hidden rounded-xl bg-white shadow-2xl">
  <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-600 to-indigo-700 px-6 py-4">
   <div class="flex items-center justify-between">
    <h3 class="text-base font-semibold text-white flex items-center gap-2">
     <i class="lucide lucide-lock-open w-4 h-4"></i> Set Password
    </h3>
    <button type="button" class="flex h-8 w-8 items-center justify-center rounded-lg text-white/70 transition hover:bg-white/10 hover:text-white" data-brox-dismiss="modal">
     <i class="lucide lucide-x w-4 h-4"></i>
    </button>
   </div>
  </div>
  <div class="p-6">
   <div id="setPasswordAlert"></div>
   <form id="setPasswordForm">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div class="mb-4">
     <label class="block text-sm font-medium text-slate-700 mb-1">New Password</label>
     <input type="password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="password" id="newPassword" placeholder="Enter new password" required>
     <small class="text-xs text-slate-500 block mt-2">
      <i class="lucide lucide-info w-3 h-3 mr-1"></i>
      Password must contain:
      <ul class="mt-1 space-y-0.5">
       <li id="pwdLength">At least 8 characters</li>
       <li id="pwdUpper">An uppercase letter (A-Z)</li>
       <li id="pwdLower">A lowercase letter (a-z)</li>
       <li id="pwdNumber">A number (0-9)</li>
       <li id="pwdSpecial">A special character (!@#$%^&*)</li>
      </ul>
     </small>
    </div>
    <div class="mb-4">
     <label class="block text-sm font-medium text-slate-700 mb-1">Confirm Password</label>
     <input type="password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="password_confirm" id="confirmNewPassword" placeholder="Confirm password" required>
    </div>
   </form>
  </div>
  <div class="border-t border-slate-100 bg-slate-50/50 px-6 py-3 flex items-center justify-end gap-2">
   <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 active:scale-95" data-brox-dismiss="modal">Cancel</button>
   <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 active:scale-95" id="setPasswordBtn">
    <i class="lucide lucide-check w-4 h-4"></i> Set Password
   </button>
  </div>
 </div>
</div>

<!-- Change Password Modal -->
<div class="fixed inset-0 z-50 hidden items-center justify-center p-4" id="changePasswordModal" data-brox-modal="true">
 <div class="fixed inset-0 bg-black/50 backdrop-blur-sm transition-opacity" data-brox-dismiss="modal" aria-hidden="true"></div>
 <div class="relative w-full max-w-lg overflow-hidden rounded-xl bg-white shadow-2xl">
  <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-600 to-indigo-700 px-6 py-4">
   <div class="flex items-center justify-between">
    <h3 class="text-base font-semibold text-white flex items-center gap-2">
     <i class="lucide lucide-refresh-cw w-4 h-4"></i> Change Password
    </h3>
    <button type="button" class="flex h-8 w-8 items-center justify-center rounded-lg text-white/70 transition hover:bg-white/10 hover:text-white" data-brox-dismiss="modal">
     <i class="lucide lucide-x w-4 h-4"></i>
    </button>
   </div>
  </div>
  <div class="p-6">
   <div id="changePasswordAlert"></div>
   <form id="changePasswordForm">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div class="mb-4">
     <label class="block text-sm font-medium text-slate-700 mb-1">Current Password</label>
     <input type="password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="current_password" id="currentPassword" placeholder="Enter current password" required>
    </div>
    <div class="mb-4">
     <label class="block text-sm font-medium text-slate-700 mb-1">New Password</label>
     <input type="password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="password" id="changeNewPassword" placeholder="Enter new password" required>
     <small class="text-xs text-slate-500 block mt-2">
      <i class="lucide lucide-info w-3 h-3 mr-1"></i>
      Password must contain:
      <ul class="mt-1 space-y-0.5">
       <li id="changePwdLength">At least 8 characters</li>
       <li id="changePwdUpper">An uppercase letter (A-Z)</li>
       <li id="changePwdLower">A lowercase letter (a-z)</li>
       <li id="changePwdNumber">A number (0-9)</li>
       <li id="changePwdSpecial">A special character (!@#$%^&*)</li>
      </ul>
     </small>
    </div>
    <div class="mb-4">
     <label class="block text-sm font-medium text-slate-700 mb-1">Confirm New Password</label>
     <input type="password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="password_confirm" id="changeConfirmPassword" placeholder="Confirm new password" required>
    </div>
   </form>
  </div>
  <div class="border-t border-slate-100 bg-slate-50/50 px-6 py-3 flex items-center justify-end gap-2">
   <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 active:scale-95" data-brox-dismiss="modal">Cancel</button>
   <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 active:scale-95" id="changePasswordBtn">
    <i class="lucide lucide-check w-4 h-4"></i> Change Password
   </button>
  </div>
 </div>
</div>









