<!-- Set Password Modal -->
<div class="modal" id="setPasswordModal" tabindex="-1">
 <div class="modal-dialog">
 <div class="modal-content">
 <div class="modal-header bg-indigo-600 text-white">
 <h5 class="modal-title">
 <i class="lucide lucide-lock-open mr-2"></i> Set Password
 </h5>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition transition-white" data-brox-dismiss="modal"></button>
 </div>
 <div class="modal-body">
 <div id="setPasswordAlert"></div>
 <form id="setPasswordForm">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 
 <div class="mb-3">
 <label class="block text-sm font-medium text-slate-700 mb-1">New Password</label>
 <input type="password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="password" id="newPassword" 
 placeholder="Enter new password" required>  <small class="text-xs text-neutral-400 block mt-2">
 <i class="lucide lucide-info mr-1"></i>
 Password must contain:
 <ul class="mb-0 mt-1">
 <li id="pwdLength">At least 8 characters</li>
 <li id="pwdUpper">An uppercase letter (A-Z)</li>
 <li id="pwdLower">A lowercase letter (a-z)</li>
 <li id="pwdNumber">A number (0-9)</li>
 <li id="pwdSpecial">A special character (!@#$%^&*)</li>
 </ul>
 </small>
 </div>
 
 <div class="mb-3">
 <label class="block text-sm font-medium text-slate-700 mb-1">Confirm Password</label>
 <input type="password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="password_confirm" id="confirmNewPassword" 
 placeholder="Confirm password" required>
 </div>
 </form>
 </div>
 <div class="modal-footer">
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200" data-brox-dismiss="modal">Cancel</button>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700" id="setPasswordBtn">
 <i class="lucide lucide-check mr-1"></i> Set Password
 </button>
 </div>
 </div>
 </div>
</div>

<!-- Change Password Modal -->
<div class="modal" id="changePasswordModal" tabindex="-1">
 <div class="modal-dialog">
 <div class="modal-content">
 <div class="modal-header bg-indigo-600 text-white">
 <h5 class="modal-title">
 <i class="lucide lucide-refresh-cw mr-2"></i> Change Password
 </h5>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition transition-white" data-brox-dismiss="modal"></button>
 </div>
 <div class="modal-body">
 <div id="changePasswordAlert"></div>
 <form id="changePasswordForm">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 
 <div class="mb-3">
 <label class="block text-sm font-medium text-slate-700 mb-1">Current Password</label>
 <input type="password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="current_password" id="currentPassword" 
 placeholder="Enter current password" required>
 </div>
 
 <div class="mb-3">
 <label class="block text-sm font-medium text-slate-700 mb-1">New Password</label>
 <input type="password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="password" id="changeNewPassword" 
 placeholder="Enter new password" required>  <small class="text-xs text-neutral-400 block mt-2">
 <i class="lucide lucide-info mr-1"></i>
 Password must contain:
 <ul class="mb-0 mt-1">
 <li id="changePwdLength">At least 8 characters</li>
 <li id="changePwdUpper">An uppercase letter (A-Z)</li>
 <li id="changePwdLower">A lowercase letter (a-z)</li>
 <li id="changePwdNumber">A number (0-9)</li>
 <li id="changePwdSpecial">A special character (!@#$%^&*)</li>
 </ul>
 </small>
 </div>
 
 <div class="mb-3">
 <label class="block text-sm font-medium text-slate-700 mb-1">Confirm New Password</label>
 <input type="password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="password_confirm" id="changeConfirmPassword" 
 placeholder="Confirm new password" required>
 </div>
 </form>
 </div>
 <div class="modal-footer">
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200" data-brox-dismiss="modal">Cancel</button>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700" id="changePasswordBtn">
 <i class="lucide lucide-check mr-1"></i> Change Password
 </button>
 </div>
 </div>
 </div>
</div>









