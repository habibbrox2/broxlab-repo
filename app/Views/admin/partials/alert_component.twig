<div class="p-4 rounded-lg bg-{{ type }}-light text-{{ }}-dark border border-{{ }} flex items-start gap-3" role="alert">
 <i class="lucide lucide-{{ icon }} mt-0.5 flex-shrink-0"></i>
 <span class="flex-1">
 {% if allow_html|default(false) %}
 {{ message|raw }}
 {% else %}
 {{ message }}
 {% endif %}
 </span>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition w-6 h-6 flex border-0 bg-transparent text-neutral-500 hover:text-neutral-800 hover:bg-neutral-100 transition-all duration-150 cursor-pointer flex-shrink-0" data-brox-dismiss="alert" aria-label="Close">&times;</button>
</div>



