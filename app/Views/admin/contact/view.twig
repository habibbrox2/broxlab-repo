{% extends"admin/layout.twig" %}
{% block title %}{{ title }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <!-- Page Header -->
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-mail-open mr-2"></i>
 Message Details
 </div>
 <div>View and manage customer message</div>
 </div>
 <div class=" border border-slate-200 bg-white shadow-sm border-0 rounded-2xl">
 <div class=" border-slate-200 px-4 py-3 bg-sky-500 text-white rounded-top-4">
 <h4 class="mb-0">
 <i class="lucide lucide-mail-open"></i> {{ header_title }}
 </h4>
 </div>
 <div class="p-4 p-4">
 <dl class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <dt class="sm:col-span-3">Name:</dt>
 <dd class="sm:col-span-9">
 {{ message.name }}
 </dd>
 <dt class="sm:col-span-3">Email / Contact:</dt>
 <dd class="sm:col-span-9">
 {{ message.email }}
 </dd>
 <dt class="sm:col-span-3">Subject:</dt>
 <dd class="sm:col-span-9">
 {{ message.subject }}
 </dd>
 <dt class="sm:col-span-3">Message:</dt>
 <dd class="sm:col-span-9">
 {{ message.message }}
 </dd>
 <dt class="sm:col-span-3">Submitted At:</dt>
 <dd class="sm:col-span-9">
 {{ message.created_at|date("Y-m-d H:i") }}
 </dd>
 </dl>
 </div>
 {% if replies is defined and replies|length > 0 %}
 <div class="p-4 p-4 border-top">
 <h5>Replies</h5>
 <ul class="list-group">
 {% for r in replies %}
 <li class="list-group-item">
 <strong>{{ r.username }} ({{ r.replied_at|date("Y-m-d H:i") }}):</strong><br>
 {{ r.reply_message }}
 </li>
 {% endfor %}
 </ul>
 </div>
 {% endif %}

 <div class="p-4 p-4 border-top">
 <form method="post" action="/admin/contact/reply/{{ message.id }}">
 <div class="mb-3">
 <label for="reply" class="form-label">Send Reply</label>
 <textarea name="reply" id="reply" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" rows="4" placeholder="Type your reply here"></textarea>
 </div>
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">Send Reply</button>
 </form>
 </div>

 <div class=" border border-slate-200 bg-white shadow-sm-footer flex justify-between">
 <a href="/admin/contact" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200"><i class="lucide lucide-arrow-left"></i> Back</a>
 <a href="/admin/contact/delete/{{ message.id }}"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700"
 onclick="return confirm('Delete this message?')"><i class="lucide lucide-trash-2"></i> Delete</a>
 </div>
 </div>
 </div>
{% endblock %}





