{% extends 'admin/layout.twig' %}

{% block title %}Autonomous Article Writer{% endblock %}

{% block stylesheets %}
<style>
  .article-writer { max-width: 1200px; }
  .writer-card {
    background: var(--bs-card-bg, #fff);
    border: 1px solid var(--bs-border-color, #dee2e6);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .writer-card h5 {
    font-weight: 600;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .topic-input { font-size: 1.1rem; padding: 0.75rem 1rem; }
  .option-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .option-grid .form-label {
    font-weight: 500;
    font-size: 0.875rem;
    margin-bottom: 0.375rem;
  }
  .btn-generate { padding: 0.75rem 2rem; font-weight: 600; font-size: 1rem; }
  .article-preview {
    min-height: 300px;
    border: 1px solid var(--bs-border-color, #dee2e6);
    border-radius: 8px;
    padding: 1.5rem;
    background: var(--bs-card-bg, #fff);
    line-height: 1.8;
    overflow-y: auto;
    max-height: 600px;
  }
  .article-preview h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: 1rem; }
  .article-preview h2 { font-size: 1.35rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.75rem; }
  .article-preview h3 { font-size: 1.15rem; font-weight: 600; margin-top: 1rem; margin-bottom: 0.5rem; }
  .article-preview p { margin-bottom: 0.75rem; }
  .article-preview ul, .article-preview ol { margin-bottom: 0.75rem; padding-left: 1.5rem; }
  .article-preview blockquote {
    border-left: 3px solid var(--bs-primary, #0d6efd);
    padding-left: 1rem;
    margin: 1rem 0;
    color: var(--bs-secondary-color, #6c757d);
    font-style: italic;
  }
  .article-meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .article-meta-item {
    background: var(--bs-gray-100, #f8f9fa);
    border-radius: 6px;
    padding: 0.75rem;
    text-align: center;
  }
  .article-meta-item .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--bs-secondary-color, #6c757d);
  }
  .article-meta-item .value { font-size: 1.1rem; font-weight: 700; margin-top: 0.25rem; }
  .tag-badge {
    display: inline-block;
    background: var(--bs-primary-bg-subtle, #cfe2ff);
    color: var(--bs-primary-text, #084298);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 500;
    margin: 0.25rem;
  }
  .seo-info {
    background: var(--bs-gray-100, #f8f9fa);
    border-radius: 6px;
    padding: 1rem;
    margin-top: 1rem;
    font-size: 0.875rem;
  }
  .seo-info strong { font-weight: 600; }
  .seo-info .seo-char-count { font-size: 0.75rem; color: var(--bs-secondary-color, #6c757d); }
  .loading-spinner {
    display: inline-block;
    width: 1.5rem; height: 1.5rem;
    border: 2px solid var(--bs-border-color, #dee2e6);
    border-top-color: var(--bs-primary, #0d6efd);
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
    vertical-align: middle;
    margin-right: 0.5rem;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .status-message { padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1rem; display: none; }
  .status-message.error {
    display: block;
    background: var(--bs-danger-bg-subtle, #f8d7da);
    color: var(--bs-danger-text, #842029);
    border: 1px solid var(--bs-danger-border-subtle, #f5c2c7);
  }
  .status-message.success {
    display: block;
    background: var(--bs-success-bg-subtle, #d1e7dd);
    color: var(--bs-success-text, #0f5132);
    border: 1px solid var(--bs-success-border-subtle, #badbcc);
  }
  .action-bar { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; }
  .empty-state { text-align: center; padding: 3rem 1rem; color: var(--bs-secondary-color, #6c757d); }
  .empty-state i { font-size: 3rem; display: block; margin-bottom: 1rem; }
  .empty-state p { font-size: 1rem; margin-bottom: 0.25rem; }
  .empty-state .sub { font-size: 0.875rem; opacity: 0.8; }
  .key-points-list { list-style: none; padding: 0; margin: 1rem 0; }
  .key-points-list li {
    padding: 0.5rem 0.75rem;
    margin-bottom: 0.375rem;
    background: var(--bs-gray-100, #f8f9fa);
    border-radius: 6px;
    border-left: 3px solid var(--bs-primary, #0d6efd);
  }
  .key-points-list li::before {
    content: "\f26a";
    font-family: "bootstrap-icons";
    margin-right: 0.5rem;
    color: var(--bs-primary, #0d6efd);
  }
  @media (max-width: 768px) {
    .option-grid { grid-template-columns: 1fr; }
    .action-bar { flex-direction: column; }
    .action-bar .btn { width: 100%; }
  }
</style>
{% endblock %}

{% block content %}
<div class="article-writer">
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div>
      <h4 class="fw-bold mb-1"><i class="bi bi-pencil-square me-2"></i>Autonomous Article Writer</h4>
      <p class="text-muted mb-0">Generate publication-ready articles with AI and publish directly to your site.</p>
    </div>
    <div class="d-none d-sm-flex gap-2">
      <a href="/admin/ai-knowledge" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-book me-1"></i> Knowledge Base
      </a>
      <a href="/admin/ai-system" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-gear me-1"></i> AI Settings
      </a>
    </div>
  </div>

  <div id="articleWriterStatus" class="status-message"></div>

  <div class="writer-card">
    <h5><i class="bi bi-pencil"></i> Article Details</h5>
    <form id="articleWriterForm" action="javascript:void(0)" autocomplete="off" onsubmit="return false;">
      <div class="mb-3">
        <label for="articleTopic" class="form-label fw-semibold">Topic / Subject</label>
        <input type="text" id="articleTopic" name="topic" class="form-control topic-input" placeholder="e.g., 'The Benefits of Renewable Energy in Bangladesh'" required autofocus>
        <div class="form-text">Be specific for best results. A clear topic yields higher quality articles.</div>
      </div>
      <div class="option-grid mb-3">
        <div>
          <label for="articleTone" class="form-label">Tone</label>
          <select id="articleTone" name="tone" class="form-select">
            <option value="informative" selected>Informative & Educational</option>
            <option value="professional">Professional & Formal</option>
            <option value="casual">Casual & Conversational</option>
            <option value="persuasive">Persuasive & Compelling</option>
            <option value="storytelling">Storytelling & Narrative</option>
          </select>
        </div>
        <div>
          <label for="articleLength" class="form-label">Length</label>
          <select id="articleLength" name="length" class="form-select">
            <option value="short">Short (~300 words)</option>
            <option value="medium" selected>Medium (~800 words)</option>
            <option value="long">Long (~1500 words)</option>
            <option value="extended">Extended (~2500 words)</option>
          </select>
        </div>
        <div>
          <label for="articleLanguage" class="form-label">Language</label>
          <select id="articleLanguage" name="language" class="form-select">
            <option value="en">English</option>
            <option value="bn">বাংলা (Bengali)</option>
            <option value="both">Both (Bilingual)</option>
          </select>
        </div>
      </div>
      <div class="mb-3">
        <label for="articleKeywords" class="form-label">SEO Keywords <span class="text-muted fw-normal">(optional)</span></label>
        <input type="text" id="articleKeywords" name="keywords" class="form-control" placeholder="e.g., renewable energy, solar power">
        <div class="form-text">Comma-separated keywords to naturally include in the article.</div>
      </div>
      <div class="mb-3">
        <label for="articleStyle" class="form-label">Style Guidance <span class="text-muted fw-normal">(optional)</span></label>
        <textarea id="articleStyle" name="style" class="form-control" rows="2" placeholder="e.g., 'Include statistics from 2024, write for beginners'"></textarea>
      </div>
      <div class="action-bar">
        <button type="button" id="generateBtn" class="btn btn-primary btn-generate">
          <i class="bi bi-magic me-1"></i>
          <span id="generateBtnText">Generate Article</span>
        </button>
        <button type="button" id="clearBtn" class="btn btn-outline-secondary">
          <i class="bi bi-x-circle me-1"></i> Clear
        </button>
      </div>
    </form>
  </div>

  <div class="writer-card" id="articlePreviewSection" style="display:none;">
    <div class="d-flex justify-content-between align-items-start mb-3">
      <h5 class="mb-0"><i class="bi bi-file-text"></i> Generated Article</h5>
      <button type="button" id="regenerateBtn" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-arrow-repeat me-1"></i> Regenerate
      </button>
    </div>
    <div id="articleMetaBar" class="article-meta-grid"></div>
    <div id="articleSEOInfo" class="seo-info"></div>
    <div id="articleKeyPoints" style="display:none;"></div>
    <div id="articleTags" class="mb-3"></div>
    <h6 class="text-muted text-uppercase small fw-semibold mb-2">Content Preview</h6>
    <div id="articleContent" class="article-preview"></div>
    <div class="action-bar mt-3 pt-3 border-top">
      <button type="button" id="publishBtn" class="btn btn-success">
        <i class="bi bi-globe me-1"></i> Publish Now
      </button>
      <button type="button" id="saveDraftBtn" class="btn btn-outline-primary">
        <i class="bi bi-save me-1"></i> Save as Draft
      </button>
      <button type="button" id="editInPostsBtn" class="btn btn-outline-secondary" style="display:none;">
        <i class="bi bi-box-arrow-up-right me-1"></i> Open in Editor
      </button>
    </div>
  </div>

  <div class="writer-card" id="emptyState">
    <div class="empty-state">
      <i class="bi bi-pencil-square text-primary opacity-50"></i>
      <p class="fw-semibold">Ready to write</p>
      <p class="sub">Enter a topic above and click <strong>Generate Article</strong> to get started.</p>
    </div>
  </div>

  <div class="writer-card" id="recentArticlesSection" style="display:none;">
    <h5><i class="bi bi-clock-history"></i> Recently Generated</h5>
    <div id="recentArticlesList" class="list-group list-group-flush"></div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/admin-article-writer.js') }}" defer></script>
{% endblock %}
