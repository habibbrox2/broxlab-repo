{% extends 'admin/layout.twig' %}

{% block title %}Autonomous Article Writer{% endblock %}

{% block stylesheets %}
<style>
 .article-writer { max-width: 1200px; }
 .topic-input { font-size: 1.1rem; padding: 0.75rem 1rem; }
 .option-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
 }

 .article-preview {
  min-height: 300px;
  border: 1px solid #e2e8f0;
  border-radius: 0.75rem;
  padding: 1.5rem;
  background: #fff;
  line-height: 1.8;
  overflow-y: auto;
  max-height: 600px;
 }
 .article-preview h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: 1rem; }
 .article-preview h2 { font-size: 1.35rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.75rem; }
 .article-preview h3 { font-size: 1.15rem; font-weight: 600; margin-top: 1rem; margin-bottom: 0.5rem; }
 .article-preview p { margin-bottom: 0.75rem; }
 .article-preview ul, .article-preview ol { margin-bottom: 0.75rem; padding-left: 1.5rem; }
 .article-preview blockquote {
  border-left: 3px solid #6366f1;
  padding-left: 1rem;
  margin: 1rem 0;
  color: #64748b;
  font-style: italic;
 }

 .article-meta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 0.75rem;
  margin-bottom: 1rem;
 }
 .article-meta-item {
  background: #f1f5f9;
  border-radius: 0.5rem;
  padding: 0.75rem;
  text-align: center;
 }
 .article-meta-item .label {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #64748b;
 }
 .article-meta-item .value { font-size: 1.1rem; font-weight: 700; margin-top: 0.25rem; }

 .tag-badge {
  display: inline-block;
  background: #eef2ff;
  color: #4338ca;
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: 500;
  margin: 0.25rem;
 }

 .seo-info {
  background: #f1f5f9;
  border-radius: 0.5rem;
  padding: 1rem;
  margin-top: 1rem;
  font-size: 0.875rem;
 }
 .seo-info strong { font-weight: 600; }
 .seo-info .seo-char-count { font-size: 0.75rem; color: #64748b; }

 .loading-spinner {
  display: inline-block;
  width: 1.5rem; height: 1.5rem;
  border: 2px solid #e2e8f0;
  border-top-color: #6366f1;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
  vertical-align: middle;
  margin-right: 0.5rem;
 }
 @keyframes spin { to { transform: rotate(360deg); } }

 .status-message { padding: 0.75rem 1rem; border-radius: 0.5rem; margin-bottom: 1rem; display: none; }
 .status-message.error {
  display: block;
  background: #fef2f2;
  color: #991b1b;
  border: 1px solid #fecaca;
 }
 .status-message.success {
  display: block;
  background: #f0fdf4;
  color: #166534;
  border: 1px solid #bbf7d0;
 }

 .empty-state { text-align: center; padding: 3rem 1rem; color: #64748b; }
 .empty-state i { font-size: 3rem; display: block; margin-bottom: 1rem; }
 .empty-state p { font-size: 1rem; margin-bottom: 0.25rem; }
 .empty-state .sub { font-size: 0.875rem; opacity: 0.8; }

 .key-points-list { list-style: none; padding: 0; margin: 1rem 0; }
 .key-points-list li {
  padding: 0.5rem 0.75rem;
  margin-bottom: 0.375rem;
  background: #f1f5f9;
  border-radius: 0.5rem;
  border-left: 3px solid #6366f1;
 }

 @media (max-width: 768px) {
  .option-grid { grid-template-columns: 1fr; }
 }
</style>
{% endblock %}

{% block content %}
<div class="article-writer w-full px-4 sm:px-6 py-4 space-y-4">
    {# ── Gradient Page Header ── #}
    <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 text-white shadow-2xl shadow-indigo-900/20 sm:p-8">
     <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
      <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
      <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-violet-300/20 blur-3xl"></div>
     </div>
     <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
       <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
        <i class="lucide lucide-pencil w-6 h-6"></i>
       </div>
       <div>
        <h1 class="text-xl font-black tracking-tight sm:text-2xl">Autonomous Article Writer</h1>
        <p class="mt-1 text-sm text-indigo-200/80">Generate publication-ready articles with AI and publish directly to your site.</p>
       </div>
      </div>
      <div class="hidden sm:flex gap-2">
       <a href="/admin/ai-knowledge" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
        <i class="lucide lucide-book w-3.5 h-3.5"></i> Knowledge Base
       </a>
       <a href="/admin/ai-system" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
        <i class="lucide lucide-settings w-3.5 h-3.5"></i> AI Settings
       </a>
      </div>
     </div>
    </div>

    <div id="articleWriterStatus" class="status-message"></div>

    <!-- Article Details Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
            <div class="flex items-center gap-2">
                <i class="lucide lucide-pencil text-indigo-500" style="width:1.125em;height:1.125em;"></i>
                <h2 class="text-sm font-semibold text-slate-900">Article Details</h2>
            </div>
        </div>
        <div class="p-5">
            <form id="articleWriterForm" action="javascript:void(0)" autocomplete="off" data-action="generic">
                <div class="mb-4">
                    <label for="articleTopic" class="mb-1.5 block text-sm font-semibold text-slate-700">Topic / Subject</label>
                    <input type="text" id="articleTopic" name="topic" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 topic-input" placeholder="e.g., 'The Benefits of Renewable Energy in Bangladesh'" required autofocus>
                    <div class="mt-1 text-xs text-slate-400">Be specific for best results. A clear topic yields higher quality articles.</div>
                </div>
                <div class="option-grid mb-4">
                    <div>
                        <label for="articleTone" class="mb-1.5 block text-sm font-semibold text-slate-700">Tone</label>
                        <select id="articleTone" name="tone" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10">
                            <option value="informative" selected>Informative &amp; Educational</option>
                            <option value="professional">Professional &amp; Formal</option>
                            <option value="casual">Casual &amp; Conversational</option>
                            <option value="persuasive">Persuasive &amp; Compelling</option>
                            <option value="storytelling">Storytelling &amp; Narrative</option>
                        </select>
                    </div>
                    <div>
                        <label for="articleLength" class="mb-1.5 block text-sm font-semibold text-slate-700">Length</label>
                        <select id="articleLength" name="length" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10">
                            <option value="short">Short (~300 words)</option>
                            <option value="medium" selected>Medium (~800 words)</option>
                            <option value="long">Long (~1500 words)</option>
                            <option value="extended">Extended (~2500 words)</option>
                        </select>
                    </div>
                    <div>
                        <label for="articleLanguage" class="mb-1.5 block text-sm font-semibold text-slate-700">Language</label>
                        <select id="articleLanguage" name="language" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10">
                            <option value="en">English</option>
                            <option value="bn">বাংলা (Bengali)</option>
                            <option value="both">Both (Bilingual)</option>
                        </select>
                    </div>
                </div>
                <div class="mb-4">
                    <label for="articleKeywords" class="mb-1.5 block text-sm font-semibold text-slate-700">SEO Keywords <span class="text-slate-400 font-normal">(optional)</span></label>
                    <input type="text" id="articleKeywords" name="keywords" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" placeholder="e.g., renewable energy, solar power">
                    <div class="mt-1 text-xs text-slate-400">Comma-separated keywords to naturally include in the article.</div>
                </div>
                <div class="mb-4">
                    <label for="articleStyle" class="mb-1.5 block text-sm font-semibold text-slate-700">Style Guidance <span class="text-slate-400 font-normal">(optional)</span></label>
                    <textarea id="articleStyle" name="style" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" rows="2" placeholder="e.g., 'Include statistics from 2024, write for beginners'"></textarea>
                </div>
                <div class="mb-4">
                    <label for="articleCategory" class="mb-1.5 block text-sm font-semibold text-slate-700">Category <span class="text-slate-400 font-normal">(optional)</span></label>
                    <select id="articleCategory" name="category" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10">
                        <option value="">— No category —</option>
                        {% for cat in categories|default([]) %}
                            <option value="{{ cat.id }}">{{ cat.name }}</option>
                        {% endfor %}
                    </select>
                    <div class="mt-1 text-xs text-slate-400">Select a category for the article.</div>
                </div>
                <div class="flex flex-wrap gap-3 items-center">
                    <button type="button" id="generateBtn" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md focus-visible:ring-2 focus-visible:ring-indigo-500/40 active:scale-[0.97]">
                        <i class="lucide lucide-wand-sparkles"></i>
                        <span id="generateBtnText">Generate Article</span>
                    </button>
                    <button type="button" id="clearBtn" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50">
                        <i class="lucide lucide-x-circle"></i> Clear
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Article Preview Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden" id="articlePreviewSection" style="display:none;">
        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="lucide lucide-file-text text-indigo-500" style="width:1.125em;height:1.125em;"></i>
                    <h2 class="text-sm font-semibold text-slate-900">Generated Article</h2>
                </div>
                <button type="button" id="regenerateBtn" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-indigo-600 shadow-sm transition hover:bg-indigo-50">
                    <i class="lucide lucide-repeat"></i> Regenerate
                </button>
            </div>
        </div>
        <div class="p-5">
            <div id="articleMetaBar" class="article-meta-grid"></div>
            <div id="articleSEOInfo" class="seo-info"></div>
            <div class="mb-3" id="articleMetaEditFields" style="display:none;">
                <h6 class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">Editable SEO Fields</h6>
                <div class="mb-2">
                    <label class="mb-1 block text-xs font-medium text-slate-600">Meta Title</label>
                    <input type="text" id="editMetaTitle" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" placeholder="SEO title (max 60 chars)">
                </div>
                <div class="mb-2">
                    <label class="mb-1 block text-xs font-medium text-slate-600">Meta Description</label>
                    <textarea id="editMetaDescription" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" rows="2" placeholder="SEO description (max 160 chars)"></textarea>
                </div>
                <div class="mb-2">
                    <label class="mb-1 block text-xs font-medium text-slate-600">Tags <span class="text-slate-400 font-normal">(comma-separated)</span></label>
                    <input type="text" id="editTags" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" placeholder="tag1, tag2, tag3">
                </div>
                <div class="mb-2">
                    <label class="mb-1 block text-xs font-medium text-slate-600">Category</label>
                    <select id="editCategory" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10">
                        <option value="">— No category —</option>
                        {% for cat in categories|default([]) %}
                            <option value="{{ cat.id }}">{{ cat.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div id="articleKeyPoints" style="display:none;"></div>
            <div id="articleTags" class="mb-3"></div>
            <h6 class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">Content Preview</h6>
            <div id="articleContent" class="article-preview"></div>
            <div class="mt-4 flex flex-wrap gap-3 items-center border-t border-slate-200 pt-4">
                <button type="button" id="publishBtn" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 hover:shadow-md">
                    <i class="lucide lucide-globe"></i> Publish Now
                </button>
                <button type="button" id="saveDraftBtn" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-indigo-600 shadow-sm transition hover:bg-indigo-50">
                    <i class="lucide lucide-save"></i> Save as Draft
                </button>
                <button type="button" id="editInPostsBtn" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" style="display:none;">
                    <i class="lucide lucide-external-link"></i> Continue in Editor
                </button>
            </div>
        </div>
    </div>

    <!-- Empty State Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden" id="emptyState">
        <div class="empty-state">
            <i class="lucide lucide-pencil text-indigo-600 opacity-50"></i>
            <p class="font-semibold">Ready to write</p>
            <p class="sub">Enter a topic above and click <strong>Generate Article</strong> to get started.</p>
        </div>
    </div>

    <!-- Recent Articles Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden" id="recentArticlesSection" style="display:none;">
        <div class="border-b border-slate-100 bg-gradient-to-r from-amber-50/50 to-orange-50/50 px-5 py-4">
            <div class="flex items-center gap-2">
                <i class="lucide lucide-clock text-amber-500" style="width:1.125em;height:1.125em;"></i>
                <h2 class="text-sm font-semibold text-slate-900">Recently Generated</h2>
            </div>
        </div>
        <div class="p-5">
            <div id="recentArticlesList" class="list-group"></div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
 window.__ARTICLE_WRITER_CATEGORIES = {{ categories|default([])|map(c => { id: c.id, name: c.name })|json_encode|raw }};
</script>
<script type="module" src="{{ asset('/assets/js/dist/admin-article-writer.js') }}"></script>
{% endblock %}
