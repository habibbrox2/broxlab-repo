{% extends 'admin/layout.twig' %}

{% block title %}AI Conversations | BroxBhai{% endblock %}

{% block stylesheets %}
{# CSS is auto-loaded by ai-chat-manager.js #}
{% endblock %}

{% block content %}
<div class="admin-page-header flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
 <div>
 <h1 class="flex items-center gap-2 text-2xl font-bold tracking-tight text-slate-900"><i class="lucide lucide-message-square text-indigo-600"></i> AI Conversations</h1>
 <p class="mt-1 max-w-2xl text-sm text-slate-500">Manage and monitor visitor interactions with BroxBhai AI.</p>
 </div>
 <div class="flex gap-2">
 <button id="refreshList" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50">
 <i class="lucide lucide-refresh-cw"></i> Refresh
 </button>
 </div>
</div>

 <div class="chat-manager-root">
 <!-- Left Pane: Conversations -->
 <div class="chat-list-pane">
 <div class="chat-list-header">
 <div class="input-group input-group-sm">
 <span class="inline-flex items-center bg-white border-end-0"><i class="lucide lucide-search"></i></span>
 <input type="text" id="chatSearch" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 border-start-0" placeholder="Search conversations...">
 </div>
 </div>
 <div class="chat-list-scroll" id="convList">
 <!-- Items loaded via JS -->
 <div class="p-4 text-center text-slate-500">Loading conversations...</div>
 </div>
 </div>

 <!-- Center Pane: Chat Transcript -->
 <div class="chat-main-pane">
 <div class="chat-main-header hidden" id="chatHeader">
 <div class="flex items-center gap-3">
 <button class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 lg:hidden" id="btnBackToList">
 <i class="lucide lucide-arrow-left"></i>
 </button>
 <div class="chat-item-avatar" id="activeAvatar">U</div>
 <div>
 <div class="font-bold" id="activeTitle">Visitor #123</div>
 <div class="small" id="activeStatus"><i class="lucide lucide-circle" style="font-size: 6px;"></i> <span id="statusText">Active</span></div>
 </div>
 </div>
 <div class="flex gap-2">
 <button id="btnExportConversation" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-indigo-600 shadow-sm transition hover:bg-indigo-50">Export</button>
 <button id="btnEndSession" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-red-600 shadow-sm transition hover:bg-red-50">End Session</button>
 </div>
 </div>
 
 <div class="chat-main-body" id="chatTranscript">
 <div class="empty-state">
 <i class="lucide lucide-message-square"></i>
 <h5>Select a conversation</h5>
 <p>Click on a conversation from the left to view the transcript and AI suggestions.</p>
 </div>
 </div>

 <div class="p-3 border-t border-slate-200 hidden" id="chatInputArea">
 <div class="input-group">
 <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="replyField" placeholder="Type a reply or use AI suggestion..." style="height: 60px;"></textarea>
 <button class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700" id="btnSend">Send</button>
 </div>
 </div>
 </div>

 <!-- Right Pane: User Info & AI suggestions -->
 <div class="chat-side-pane">
 <div class="side-panel-section border-b border-slate-200">
 <h6 class="font-bold mb-3">Visitor Details</h6>
 <div class="small mb-2"><strong>ID:</strong> <span id="sideUserId" class="text-slate-500">---</span></div>
 <div class="small mb-2"><strong>Status:</strong> <span id="sideStatus" class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-emerald-600">Active</span></div>
 <div class="small mb-2"><strong>Messages:</strong> <span id="sideMsgCount" class="text-slate-500">0</span></div>
 <div class="small"><strong>Last Activity:</strong> <span id="sideLastActivity" class="text-slate-500">---</span></div>
 </div>

 <div class="side-panel-section">
 <div class="flex justify-between items-center mb-3">
 <h6 class="font-bold m-0">AI Drafter (Beta)</h6>
 <button class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-indigo-600 shadow-sm transition hover:bg-indigo-50" id="btnDraft">
 <i class="lucide lucide-wand"></i> Draft
 </button>
 </div>
 
 <div id="suggestionContainer">
 <div class="text-slate-500 small text-center py-4">
 Select a chat to generate AI-powered reply suggestions.
 </div>
 </div>
 </div>
 </div>
 </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('/ai/dist/ai-chat-manager.js') }}"></script>
{% endblock %}





