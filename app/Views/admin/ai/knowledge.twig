{% extends"admin/layout.twig" %}
{% block title %}AI Knowledge Base{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
    {# ── Gradient Page Header ── #}
    <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 text-white shadow-2xl shadow-indigo-900/20 sm:p-8">
     <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
      <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
      <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-violet-300/20 blur-3xl"></div>
     </div>
     <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
       <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
        <i class="lucide lucide-book w-6 h-6"></i>
       </div>
       <div>
        <h1 class="text-xl font-black tracking-tight sm:text-2xl">AI Knowledge Base</h1>
        <p class="mt-1 text-sm text-indigo-200/80">Upload and manage knowledge slices used to ground AI responses.</p>
       </div>
      </div>
      <div class="flex items-center gap-2">
       <button class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-3 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]" id="btnRefresh" title="Refresh">
        <i class="lucide lucide-refresh-cw w-3.5 h-3.5"></i> Refresh
       </button>
       <button class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-3 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]" id="btnAddSlice">
        <i class="lucide lucide-plus w-3.5 h-3.5"></i> Add Slice
       </button>
      </div>
     </div>
    </div>

    <div id="alertContainer"></div>

    <!-- Filter Bar -->
    <div class="flex flex-wrap items-center gap-3">
        <div class="flex-1 min-w-[200px]">
            <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="kbSearch" placeholder="Search knowledge base...">
        </div>
        <div class="w-40">
            <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="kbFilterCategory">
                <option value="">All Categories</option>
                <option value="general">General</option>
                <option value="admin">Admin</option>
                <option value="api">API</option>
                <option value="features">Features</option>
                <option value="security">Security</option>
                <option value="deployment">Deployment</option>
            </select>
        </div>
        <div class="w-40">
            <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="kbFilterType">
                <option value="">All Types</option>
                <option value="text">Text</option>
                <option value="pdf">PDF</option>
                <option value="url">URL</option>
                <option value="document">Document</option>
            </select>
        </div>
        <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700" id="kbCount">0 items</span>
    </div>

    <!-- Knowledge Slices Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-5 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="lucide lucide-layers text-indigo-500" style="width:1.125em;height:1.125em;"></i>
                    <h2 class="text-sm font-semibold text-slate-900">Knowledge Slices</h2>
                </div>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" type="checkbox" id="kbShowInactive">
                    <span class="text-sm text-slate-600">Show Inactive</span>
                </label>
            </div>
        </div>
        <div class="p-5">
            <div id="kbList"></div>
        </div>
    </div>

    <!-- Modal -->
    <div class="fixed inset-0 z-50 hidden items-center justify-center p-4" id="kbModal" data-brox-modal="true">
        <div class="fixed inset-0 bg-black/50 backdrop-blur-sm transition-opacity" data-brox-dismiss="modal" aria-hidden="true"></div>
        <div class="relative w-full max-w-3xl overflow-hidden rounded-xl bg-white shadow-2xl">
            <div class="border-b border-slate-100 bg-gradient-to-r from-indigo-50/50 to-violet-50/50 px-6 py-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <i class="lucide lucide-book text-indigo-500" style="width:1.125em;height:1.125em;"></i>
                        <h3 class="text-base font-semibold text-slate-900">Knowledge Slice</h3>
                    </div>
                    <button type="button" class="flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-600" data-brox-dismiss="modal">
                        <i class="lucide lucide-x"></i>
                    </button>
                </div>
            </div>
            <div class="p-6">
                <form id="kbForm">
                    <input type="hidden" name="id" id="kb_id" value="0">
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
                        <div class="md:col-span-8">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Title <span class="text-red-600">*</span></label>
                            <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="title" id="kb_title" required placeholder="e.g., Company Policies">
                        </div>
                        <div class="md:col-span-4">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Priority</label>
                            <input type="number" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="priority" id="kb_priority" value="0" min="0" max="100">
                            <p class="mt-0.5 text-xs text-slate-400">Higher = more important</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-4">
                        <div class="md:col-span-6">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Category</label>
                            <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="category" id="kb_category">
                                <option value="">No Category</option>
                                <option value="general">General</option>
                                <option value="admin">Admin</option>
                                <option value="api">API</option>
                                <option value="features">Features</option>
                                <option value="security">Security</option>
                                <option value="deployment">Deployment</option>
                                <option value="content">Content</option>
                                <option value="notification">Notification</option>
                            </select>
                        </div>
                        <div class="md:col-span-6">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Source Type</label>
                            <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="source_type" id="kb_source_type">
                                <option value="text">Text</option>
                                <option value="pdf">PDF Document</option>
                                <option value="url">Web URL</option>
                                <option value="document">Other Document</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-slate-700 mb-1">Content <span class="text-red-600">*</span></label>
                        <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" name="content" id="kb_content" rows="10" required placeholder="Enter the knowledge content here..."></textarea>
                        <p class="mt-0.5 text-xs text-slate-400">For PDFs/URLs, you may paste extracted text content for AI context.</p>
                    </div>
                    <div class="mb-4 flex items-start gap-2">
                        <input type="checkbox" class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" id="kb_is_active" checked>
                        <label class="text-sm text-slate-700" for="kb_is_active">Active</label>
                    </div>
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                </form>
            </div>
            <div class="border-t border-slate-100 bg-slate-50/50 px-6 py-3 flex items-center justify-end gap-2">
                <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 active:scale-95" data-brox-dismiss="modal">Close</button>
                <button type="button" class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 active:scale-95" id="kbSaveBtn">Save</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}{% endblock %}
