{% extends 'admin/layout.twig' %}

{% block title %}Live Streaming Article Writer{% endblock %}

{% block stylesheets %}
<style>
.stream-writer { max-width: 1100px; margin: 0 auto; }
.writer-card { background: var(--bs-card-bg,#fff); border: 1px solid var(--bs-border-color,#dee2e6); border-radius: 16px; padding: 1.75rem; margin-bottom: 1.5rem; }
.writer-card-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 2px solid var(--bs-border-color,#e9ecef); }
.writer-card-header h5 { margin: 0; font-weight: 600; }
.icon-circle { width: 36px; height: 36px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg,#667eea,#764ba2); }
.topic-input { font-size: 1.1rem; padding: 1rem 1.25rem; border-radius: 10px; border: 2px solid var(--bs-border-color,#dee2e6); }
.topic-input:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,0.15); }
.btn-gen { padding: 0.8rem 2rem; font-weight: 600; border-radius: 10px; }
.status-bar { display: flex; align-items: center; gap: 1rem; padding: 0.75rem 1rem; background: var(--bs-light,#f8f9fa); border-radius: 10px; }
.status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
.status-dot.idle { background: #6c757d; }
.status-dot.generating { background: #0d6efd; animation: pulse 1.5s infinite; }
.status-dot.done { background: #198754; }
.status-dot.error { background: #dc3545; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
.content-preview { min-height: 400px; border: 1px solid var(--bs-border-color,#dee2e6); border-radius: 12px; }
.preview-body { padding: 1.25rem; min-height: 350px; max-height: 800px; overflow-y: auto; line-height: 1.8; }
.preview-body h1 { font-size: 1.5rem; font-weight: 700; }
.preview-body h2 { font-size: 1.25rem; font-weight: 600; margin-top: 1.5rem; }
.preview-body p { margin-bottom: 0.75rem; }
.typing-cursor { display: inline-block; width: 2px; height: 1.2em; background: #667eea; animation: blink 0.8s infinite; vertical-align: text-bottom; }
@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }
.save-toast { position: fixed; bottom: 20px; right: 20px; z-index: 1050; }
</style>
{% endblock %}

{% block content %}
<div class="stream-writer">
  <h4 class="fw-bold mb-4"><i class="bi bi-sync me-2"></i>Live Streaming Article Writer</h4>

  <div class="writer-card">
    <div class="writer-card-header">
      <div class="icon-circle"><i class="bi bi-pencil"></i></div>
      <h5>Article Topic</h5>
    </div>
    <div class="mb-3">
      <input type="text" class="form-control topic-input" id="topicInput" placeholder="Enter article topic..." autofocus>
    </div>
    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <label class="form-label small fw-semibold">Tone</label>
        <select class="form-select" id="toneSelect">
          <option value="informative" selected>Informative</option>
          <option value="professional">Professional</option>
          <option value="conversational">Conversational</option>
          <option value="persuasive">Persuasive</option>
          <option value="technical">Technical</option>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-semibold">Length</label>
        <select class="form-select" id="lengthSelect">
          <option value="short">Short</option>
          <option value="medium" selected>Medium</option>
          <option value="long">Long</option>
          <option value="detailed">Detailed</option>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-semibold">Language</label>
        <select class="form-select" id="languageSelect">
          <option value="en" selected>English</option>
          <option value="bn">Bengali</option>
          <option value="hi">Hindi</option>
          <option value="ar">Arabic</option>
        </select>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label small fw-semibold">Keywords (optional)</label>
      <input type="text" class="form-control" id="keywordsInput" placeholder="e.g., statistics, recent research">
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-primary btn-gen" id="generateBtn">
        <span id="generateBtnText"><i class="bi bi-lightning-fill me-1"></i>Generate Article</span>
        <span id="generateBtnSpinner" class="spinner-border spinner-border-sm d-none"></span>
      </button>
      <button class="btn btn-outline-secondary btn-gen" id="stopBtn" disabled>
        <i class="bi bi-stop-fill me-1"></i>Stop
      </button>
      <button class="btn btn-outline-info btn-gen" id="newTopicBtn">
        <i class="bi bi-arrow-counterclockwise me-1"></i>New Topic
      </button>
    </div>
  </div>

  <div class="d-flex align-items-center gap-3 mb-3 p-3 bg-light rounded-3">
    <span class="status-dot idle" id="statusDot"></span>
    <span id="statusText">Ready</span>
    <span class="ms-auto text-muted small" id="statusElapsed"></span>
  </div>

  <div class="progress mb-3" style="height:4px;">
    <div class="progress-bar" id="progressFill" style="width:0%;background:linear-gradient(90deg,#667eea,#764ba2);"></div>
  </div>

  <div class="writer-card">
    <div class="writer-card-header">
      <div class="icon-circle" style="background:linear-gradient(135deg,#f093fb,#f5576c);"><i class="bi bi-eye-fill"></i></div>
      <h5 id="liveTitle">Live Preview</h5>
      <span class="badge bg-light text-dark ms-auto" id="wordCount">0 words</span>
      <span class="badge bg-light text-dark ms-1" id="charCount">0 chars</span>
    </div>
    <div class="content-preview">
      <div class="p-3 preview-body" id="contentEditor">
        <p class="text-muted"><i class="bi bi-arrow-right-circle me-2"></i>Click <strong>Generate</strong> to start streaming.</p>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2 flex-wrap">
    <button class="btn btn-success" id="saveBtn" disabled>
      <i class="bi bi-check2-circle me-1"></i>Save as Draft
    </button>
    <button class="btn btn-primary" id="publishBtn" disabled>
      <i class="bi bi-megaphone me-1"></i>Publish Now
    </button>
    <button class="btn btn-outline-secondary" id="copyBtn" disabled>
      <i class="bi bi-clipboard me-1"></i>Copy
    </button>
  </div>

  <div class="save-toast" id="saveToast" style="display:none;">
    <div class="toast align-items-center text-bg-success border-0" role="alert">
      <div class="d-flex">
        <div class="toast-body" id="toastMessage">Saved!</div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/admin-article-writer-stream.js') }}"></script>
{% endblock %}
