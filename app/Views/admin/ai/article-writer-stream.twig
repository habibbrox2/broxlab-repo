{% extends 'admin/layout.twig' %}

{% block title %}Live Streaming Article Writer{% endblock %}

{% block stylesheets %}
<style>
 .stream-writer { max-width: 1100px; margin: 0 auto; }
 .topic-input { font-size: 1.1rem; padding: 1rem 1.25rem; border-radius: 0.75rem; }
 .status-bar { display: flex; align-items: center; gap: 1rem; padding: 0.75rem 1rem; background: #f1f5f9; border-radius: 0.75rem; }
 .status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
 .status-dot.idle { background: #6c757d; }
 .status-dot.generating { background: #6366f1; animation: pulse 1.5s infinite; }
 .status-dot.done { background: #059669; }
 .status-dot.error { background: #dc3545; }
 @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
 .content-preview { min-height: 400px; border: 1px solid #e2e8f0; border-radius: 0.75rem; }
 .preview-body { padding: 1.25rem; min-height: 350px; max-height: 800px; overflow-y: auto; line-height: 1.8; }
 .preview-body h1 { font-size: 1.5rem; font-weight: 700; }
 .preview-body h2 { font-size: 1.25rem; font-weight: 600; margin-top: 1.5rem; }
 .preview-body p { margin-bottom: 0.75rem; }
 .typing-cursor { display: inline-block; width: 2px; height: 1.2em; background: #6366f1; animation: blink 0.8s infinite; vertical-align: text-bottom; }
 @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }
 .save-toast { position: fixed; bottom: 20px; right: 20px; z-index: 1050; }
 .section-divider { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 2px solid #e2e8f0; }
 .section-divider h5 { margin: 0; font-weight: 600; }
 .icon-circle { width: 36px; height: 36px; border-radius: 0.625rem; display: inline-flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg, #6366f1, #8b5cf6); flex-shrink: 0; }
</style>
{% endblock %}

{% block content %}
<div class="stream-writer">
 <div class="admin-page-header flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div>
   <h1 class="flex items-center gap-2 text-2xl font-bold tracking-tight text-slate-900">
    <i class="lucide lucide-refresh-cw text-indigo-600"></i> Live Streaming Article Writer
   </h1>
   <p class="mt-1 max-w-2xl text-sm text-slate-500">Watch articles generate in real-time with live streaming preview.</p>
  </div>
 </div>

 <div class="admin-panel-card mb-6">
  <div class="section-divider">
   <div class="icon-circle"><i class="lucide lucide-pencil"></i></div>
   <h5>Article Topic</h5>
  </div>
  <div class="mb-4">
   <input type="text" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 topic-input" id="topicInput" placeholder="Enter article topic..." autofocus>
  </div>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-3 mb-4">
   <div>
    <label class="mb-1.5 block text-sm font-semibold text-slate-700">Tone</label>
    <select class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" id="toneSelect">
     <option value="informative" selected>Informative</option>
     <option value="professional">Professional</option>
     <option value="conversational">Conversational</option>
     <option value="persuasive">Persuasive</option>
     <option value="technical">Technical</option>
    </select>
   </div>
   <div>
    <label class="mb-1.5 block text-sm font-semibold text-slate-700">Length</label>
    <select class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" id="lengthSelect">
     <option value="short">Short</option>
     <option value="medium" selected>Medium</option>
     <option value="long">Long</option>
     <option value="detailed">Detailed</option>
    </select>
   </div>
   <div>
    <label class="mb-1.5 block text-sm font-semibold text-slate-700">Language</label>
    <select class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" id="languageSelect">
     <option value="en" selected>English</option>
     <option value="bn">Bengali</option>
     <option value="hi">Hindi</option>
     <option value="ar">Arabic</option>
    </select>
   </div>
  </div>
  <div class="mb-4">
   <label class="mb-1.5 block text-sm font-semibold text-slate-700">Keywords <span class="text-slate-400 font-normal">(optional)</span></label>
   <input type="text" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" id="keywordsInput" placeholder="e.g., statistics, recent research">
  </div>
  <div class="flex flex-wrap gap-3">
   <button class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 hover:shadow-md active:scale-[0.97]" id="generateBtn">
    <span id="generateBtnText"><i class="lucide lucide-zap"></i> Generate Article</span>
    <span id="generateBtnSpinner" class="inline-spinner inline-spinner-sm hidden"></span>
   </button>
   <button class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 disabled:opacity-50" id="stopBtn" disabled>
    <i class="lucide lucide-stop-circle"></i> Stop
   </button>
   <button class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-sky-600 shadow-sm transition hover:bg-sky-50" id="newTopicBtn">
    <i class="lucide lucide-rotate-ccw"></i> New Topic
   </button>
  </div>
 </div>

 <div class="status-bar mb-4">
  <span class="status-dot idle" id="statusDot"></span>
  <span id="statusText" class="text-sm font-medium text-slate-700">Ready</span>
  <span class="ml-auto text-sm text-slate-500" id="statusElapsed"></span>
 </div>

 <div class="mb-4" style="height:4px;">
  <div class="rounded-full transition-all duration-300" id="progressFill" style="width:0%;height:100%;background:linear-gradient(90deg,#6366f1,#8b5cf6);"></div>
 </div>

 <div class="admin-panel-card mb-6">
  <div class="section-divider">
   <div class="icon-circle" style="background:linear-gradient(135deg,#ec4899,#f43f5e);"><i class="lucide lucide-eye"></i></div>
   <h5 id="liveTitle">Live Preview</h5>
   <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 ms-auto" id="wordCount">0 words</span>
   <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 ml-1" id="charCount">0 chars</span>
  </div>
  <div class="content-preview">
   <div class="p-3 preview-body" id="contentEditor">
    <p class="text-slate-500"><i class="lucide lucide-arrow-right-circle mr-2"></i>Click <strong>Generate</strong> to start streaming.</p>
   </div>
  </div>
 </div>

 <div class="flex flex-wrap gap-3">
  <button class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 disabled:opacity-50" id="saveBtn" disabled>
   <i class="lucide lucide-check-circle"></i> Save as Draft
  </button>
  <button class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 disabled:opacity-50" id="publishBtn" disabled>
   <i class="lucide lucide-megaphone"></i> Publish Now
  </button>
  <button class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 disabled:opacity-50" id="copyBtn" disabled>
   <i class="lucide lucide-clipboard"></i> Copy
  </button>
 </div>

 <div class="save-toast" id="saveToast" style="display:none;">
  <div class="rounded-xl bg-emerald-600 px-4 py-3 text-sm font-medium text-white shadow-lg flex items-center gap-2">
   <i class="lucide lucide-check-circle"></i>
   <span id="toastMessage">Saved!</span>
  </div>
 </div>
</div>
{% endblock %}

{% block scripts %}
<script type="module" src="{{ asset('/assets/js/dist/admin-article-writer-stream.js') }}"></script>
{% endblock %}
