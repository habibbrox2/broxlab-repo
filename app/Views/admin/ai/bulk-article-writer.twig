{% extends 'admin/layout.twig' %}

{% block title %}Bulk Article Generator{% endblock %}

{% block stylesheets %}
<style>
 .bulk-writer { max-width: 1400px; }
 .csv-dropzone {
  border: 2px dashed #cbd5e1;
  border-radius: 0.75rem;
  padding: 2.5rem 1.5rem;
  text-align: center;
  cursor: pointer;
  transition: all 0.25s ease;
  background: #f8fafc;
 }
 .csv-dropzone:hover, .csv-dropzone.dragover {
  border-color: #6366f1;
  background: rgba(99,102,241,0.04);
  transform: scale(1.01);
 }
 .csv-dropzone-icon { font-size: 2.5rem; color: #6366f1; margin-bottom: 0.75rem; }
 .csv-dropzone-text { font-size: 0.95rem; color: #64748b; margin-bottom: 0.5rem; }
 .csv-dropzone-hint { font-size: 0.8rem; color: #94a3b8; }
 .csv-preview-table { font-size: 0.875rem; }
 .csv-preview-table th {
  white-space: nowrap;
  background: #f1f5f9;
  position: sticky;
  top: 0;
 }
 .csv-preview-wrap {
  max-height: 400px;
  overflow-y: auto;
  border: 1px solid #e2e8f0;
  border-radius: 0.5rem;
 }
 .step-indicator { display: flex; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
 .step-badge {
  display: flex; align-items: center; gap: 0.5rem;
  padding: 0.4rem 0.9rem; border-radius: 999px; font-size: 0.8rem; font-weight: 500;
  background: #e2e8f0; color: #64748b; transition: all 0.25s ease;
 }
 .step-badge.active { background: #6366f1; color: #fff; }
 .step-badge.done { background: #059669; color: #fff; }
 .step-badge .step-num {
  display: inline-flex; align-items: center; justify-content: center;
  width: 20px; height: 20px; border-radius: 50%; font-size: 0.7rem; font-weight: 700;
  background: rgba(255,255,255,0.25);
 }
 .progress-wrapper { padding: 1rem 0; }
 .progress-status { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; font-size: 0.875rem; }
 .progress-current {
  background: #f1f5f9; border-radius: 0.5rem; padding: 0.75rem 1rem; margin-top: 0.5rem;
  display: flex; align-items: center; gap: 0.75rem; font-size: 0.875rem;
 }
 .article-result-card {
  border: 1px solid #e2e8f0; border-radius: 0.5rem;
  margin-bottom: 0.75rem; transition: all 0.2s ease; overflow: hidden;
 }
 .article-result-card:hover { border-color: #6366f1; }
 .article-result-card.success { border-left: 3px solid #059669; }
 .article-result-card.failed { border-left: 3px solid #dc2626; }
 .article-result-header {
  padding: 0.75rem 1rem; display: flex; align-items: center;
  justify-content: space-between; gap: 0.75rem; cursor: pointer; user-select: none;
 }
 .article-result-header:hover { background: #f8fafc; }
 .article-result-title { font-weight: 500; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
 .article-result-meta { font-size: 0.75rem; color: #64748b; white-space: nowrap; }
 .article-result-body { padding: 0.75rem 1rem 1rem; border-top: 1px solid #f1f5f9; display: none; }
 .article-result-body.open { display: block; }
 .article-result-body .article-preview-content {
  max-height: 300px; overflow-y: auto; font-size: 0.85rem; line-height: 1.6;
  background: #f8fafc; border-radius: 0.25rem; padding: 0.75rem;
 }
 .summary-stats {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 1rem; margin-bottom: 1rem;
 }
 .stat-card {
  text-align: center; padding: 1rem 0.75rem; border-radius: 0.5rem;
  background: #f8fafc; border: 1px solid #e2e8f0;
 }
 .stat-card .stat-value { font-size: 1.5rem; font-weight: 700; line-height: 1.2; }
 .stat-card .stat-label { font-size: 0.75rem; color: #64748b; margin-top: 0.25rem; }
 .stat-card.success .stat-value { color: #059669; }
 .stat-card.failed .stat-value { color: #dc2626; }
 .stat-card.total .stat-value { color: #6366f1; }
 .stat-card.time .stat-value { color: #f59e0b; font-size: 1.2rem; }
</style>
{% endblock %}

{% block content %}
<div class="bulk-writer">
 <div class="admin-page-header flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div>
   <h1 class="flex items-center gap-2 text-2xl font-bold tracking-tight text-slate-900">
    <i class="lucide lucide-boxes text-indigo-600"></i> Bulk Article Generator
   </h1>
   <p class="mt-1 max-w-2xl text-sm text-slate-500">Upload a CSV of topics to generate articles in batches.</p>
  </div>
  <div>
   <a href="/admin/ai/article-writer" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50">
    <i class="lucide lucide-pencil"></i> Single Article Writer
   </a>
  </div>
 </div>

 <div class="step-indicator">
  <span class="step-badge active" data-step="1">
   <span class="step-num">1</span> Upload CSV
  </span>
  <span class="step-badge" data-step="2">
   <span class="step-num">2</span> Review Topics
  </span>
  <span class="step-badge" data-step="3">
   <span class="step-num">3</span> Generate
  </span>
  <span class="step-badge" data-step="4">
   <span class="step-num">4</span> Publish
  </span>
 </div>

 {# Step 1 #}
 <div class="admin-panel-card mb-6" id="step1">
  <h5 class="flex items-center gap-2 font-semibold mb-4">
   <i class="lucide lucide-upload text-indigo-600"></i> Step 1: Upload Your Topics
  </h5>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-12 mb-3">
   <div class="md:col-span-8">
    <div class="csv-dropzone" id="csvDropzone">
     <div class="csv-dropzone-icon"><i class="lucide lucide-file-spreadsheet"></i></div>
     <div class="csv-dropzone-text">Drop a CSV file here, or click to browse</div>
     <div class="csv-dropzone-hint">CSV must have a <strong>topic</strong> column (first column). Optional: tone, length, language, keywords, style</div>
     <input type="file" id="csvFileInput" accept=".csv,.tsv,.txt" class="hidden">
    </div>
   </div>
   <div class="md:col-span-4">
    <div class="admin-panel-card h-full" style="margin-bottom:0;">
     <h6 class="font-semibold mb-2 flex items-center gap-2">
      <i class="lucide lucide-info text-indigo-600"></i> CSV Format
     </h6>
     <p class="text-xs text-slate-500 mb-2">Required: <code>topic</code>. Optional columns let you override settings per article.</p>
     <button type="button" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-indigo-600 shadow-sm transition hover:bg-indigo-50" id="downloadSampleCsv">
      <i class="lucide lucide-download"></i> Download Sample CSV
     </button>
    </div>
   </div>
  </div>
  <div id="csvUploadStatus" class="hidden"></div>
  <div id="csvPreviewSection" class="hidden">
   <hr class="my-4 border-slate-200">
   <div class="flex justify-between items-center mb-2">
    <h6 class="font-semibold mb-0"><span id="csvTopicCount">0</span> topics found</h6>
    <div class="flex gap-2">
     <button type="button" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-red-600 shadow-sm transition hover:bg-red-50" id="clearCsvBtn">
      <i class="lucide lucide-trash-2"></i> Clear
     </button>
     <button type="button" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-3 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-indigo-700" id="generateAllBtn">
      <i class="lucide lucide-wand"></i> Generate All Articles
     </button>
    </div>
   </div>
   <div class="csv-preview-wrap">
    <table class="w-full text-sm csv-preview-table mb-0">
     <thead>
      <tr class="border-b border-slate-200">
       <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">#</th>
       <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Topic</th>
       <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Tone</th>
       <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Length</th>
       <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Language</th>
       <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Keywords</th>
       <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Style</th>
      </tr>
     </thead>
     <tbody id="csvPreviewBody"></tbody>
    </table>
   </div>
  </div>
  <div id="csvEmptyState" class="text-center py-4 text-slate-500">
   <i class="lucide lucide-inbox" style="font-size:2rem;display:block;margin-bottom:0.5rem;"></i>
   <span>Upload a CSV to get started</span>
  </div>
 </div>

 {# Step 3 - Progress #}
 <div class="admin-panel-card mb-6 hidden" id="step3Card">
  <h5 class="flex items-center gap-2 font-semibold mb-4">
   <i class="lucide lucide-wand text-indigo-600"></i> Generation Progress
  </h5>
  <div class="progress-wrapper">
   <div class="progress-status">
    <span id="progressLabel">Starting...</span>
    <span id="progressCount">0 / 0</span>
   </div>
   <div class="h-2 w-full overflow-hidden rounded-full bg-slate-200">
    <div class="h-full rounded-full bg-indigo-600 transition-all duration-300" id="progressBar" style="width:0%"></div>
   </div>
   <div class="progress-current hidden" id="progressCurrentArticle">
    <div class="inline-spinner inline-spinner-sm text-indigo-600" role="status"></div>
    <span id="progressCurrentText">Generating article...</span>
   </div>
  </div>
 </div>

 {# Step 4 - Results #}
 <div class="admin-panel-card mb-6 hidden" id="step4Card">
  <h5 class="flex items-center gap-2 font-semibold mb-4">
   <i class="lucide lucide-clipboard-check text-indigo-600"></i> Generation Results
  </h5>
  <div id="resultsSummary" class="hidden">
   <div class="summary-stats" id="resultsStats"></div>
  </div>
  <div id="resultsActions" class="flex gap-2 flex-wrap mb-3 hidden">
   <button type="button" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700" id="publishSelectedBtn">
    <i class="lucide lucide-check-circle"></i> Publish Selected
   </button>
   <button type="button" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-indigo-600 shadow-sm transition hover:bg-indigo-50" id="selectAllResultsBtn">
    <i class="lucide lucide-check-check"></i> Select All
   </button>
   <button type="button" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" id="deselectAllResultsBtn">
    <i class="lucide lucide-x"></i> Deselect All
   </button>
   <button type="button" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" id="backToUploadBtn">
    <i class="lucide lucide-arrow-left"></i> New Batch
   </button>
  </div>
  <div id="articlesList"></div>
  <div id="publishProgress" class="hidden mt-3">
   <hr class="my-4 border-slate-200">
   <h6 class="font-semibold mb-2 flex items-center gap-2">
    <i class="lucide lucide-send text-indigo-600"></i> Publishing...
   </h6>
   <div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-200">
    <div class="h-full rounded-full bg-emerald-600 transition-all duration-300" id="publishProgressBar" style="width:0%"></div>
   </div>
  </div>
  <div id="publishStatus" class="hidden mt-3"></div>
 </div>

 <div id="bulkWriterStatus" class="hidden"></div>
</div>
{% endblock %}

{% block scripts %}
<script type="module" src="{{ asset('/assets/js/dist/admin-bulk-article-writer.js') }}"></script>
{% endblock %}
