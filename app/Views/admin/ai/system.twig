{% extends "admin/layout.twig" %}
{% block title %}AI SYSTEM{% endblock %}
{% set breadcrumbs = [
    { 'label': 'Dashboard', 'url': '/admin' },
    { 'label': 'AI SYSTEM', 'url': '/admin/ai-system' }
] %}
{% block stylesheets %}
<style>
.ai-system-shell {
    position: relative;
}

.ai-system-shell::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background:
        radial-gradient(circle at top left, rgba(13, 110, 253, 0.08), transparent 28%),
        radial-gradient(circle at top right, rgba(32, 201, 151, 0.08), transparent 22%);
    z-index: 0;
}

.ai-system-shell > * {
    position: relative;
    z-index: 1;
}

.ai-command-hero {
    overflow: hidden;
    border: 1px solid rgba(13, 110, 253, 0.12);
    background: linear-gradient(135deg, #0b1020 0%, #111827 55%, #1d4ed8 100%);
    color: #fff;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.16);
}

.ai-command-hero::after {
    content: '';
    position: absolute;
    inset: auto -80px -120px auto;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0));
    pointer-events: none;
}

.ai-hero-copy {
    max-width: 900px;
}

.ai-hero-copy .text-secondary,
.ai-hero-copy .lead,
.ai-hero-copy .small {
    color: rgba(255, 255, 255, 0.78) !important;
}

.ai-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
}

.ai-hero-actions .btn {
    min-width: 150px;
    border-radius: 999px;
    padding-inline: 1rem;
}

.ai-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
}

.ai-kpi-card {
    padding: 1rem 1.1rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
}

.ai-kpi-label {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.64);
}

.ai-kpi-value {
    display: block;
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.1;
}

.ai-kpi-note {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.68);
}

.ai-panel {
    border: 0;
    border-radius: 1.35rem;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
}

.ai-panel .card-header {
    background: linear-gradient(180deg, #ffffff 0%, #f8faff 100%);
    border-bottom: 1px solid #e9edf5;
}

.ai-panel .card-body {
    background: #fff;
}

.section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.2rem;
    color: #0d6efd;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.section-eyebrow::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0d6efd, #20c997);
}

.ai-filter-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
}

.ai-filter-toolbar .input-group {
    min-width: 260px;
    flex: 1 1 320px;
}

.ai-filter-toolbar .form-select {
    min-width: 170px;
    flex: 0 1 190px;
}

.ai-system-table {
    margin-bottom: 0;
}

.ai-system-table thead th {
    border-bottom-width: 1px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.74rem;
    color: #6c757d;
}

.provider-icon-wrapper,
.provider-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    flex-shrink: 0;
}

.provider-icon-wrapper:hover,
.provider-icon:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.08);
}

.provider-icon-wrapper.openrouter,
.provider-icon.openrouter { background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%); }
.provider-icon-wrapper.openai,
.provider-icon.openai { background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%); }
.provider-icon-wrapper.ollama,
.provider-icon.ollama { background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%); }
.provider-icon-wrapper.anthropic,
.provider-icon.anthropic { background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%); }
.provider-icon-wrapper.fireworks,
.provider-icon.fireworks { background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%); }
.provider-icon-wrapper.huggingface,
.provider-icon.huggingface { background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%); }
.provider-icon-wrapper.kilo,
.provider-icon.kilo { background: linear-gradient(135deg, #e0f7fa 0%, #b2ebf2 100%); }

.status-badge {
    padding: 0.24rem 0.6rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.provider-health-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    padding: 0.26rem 0.7rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.provider-health-pill::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.85;
}

.provider-health-pill.success {
    background: rgba(25, 135, 84, 0.12);
    color: #198754;
}

.provider-health-pill.error {
    background: rgba(220, 53, 69, 0.12);
    color: #dc3545;
}

.provider-health-pill.unknown {
    background: rgba(108, 117, 125, 0.12);
    color: #6c757d;
}

.provider-health-timestamp {
    font-size: 0.78rem;
    color: #6c757d;
}

.ai-section-block {
    border: 1px solid #e9edf5;
    border-radius: 1rem;
    background: linear-gradient(180deg, #ffffff 0%, #fbfcff 100%);
    padding: 1.25rem;
}

.ai-section-block + .ai-section-block {
    margin-top: 1rem;
}

.ai-section-title {
    margin-bottom: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid #eef2f7;
}

.ai-status-strip .badge {
    border-radius: 999px;
    padding: 0.5rem 0.85rem;
}

.api-key-card {
    border: 1px solid #edf1f7;
    border-radius: 1rem;
    background: #fff;
    padding: 1rem;
    height: 100%;
}

.api-key-card .form-label {
    margin-bottom: 0.5rem;
}

.ai-sidebar-stack {
    position: sticky;
    top: 1rem;
    display: grid;
    gap: 1rem;
}

.snapshot-list .list-group-item {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1rem;
    padding-block: 0.85rem;
}

.snapshot-list .snapshot-label {
    color: #6c757d;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.snapshot-list .snapshot-value {
    text-align: right;
    font-weight: 700;
    word-break: break-word;
}

.quick-actions-grid {
    display: grid;
    gap: 0.65rem;
}

.quick-action {
    justify-content: flex-start;
    border-radius: 0.9rem;
    padding: 0.82rem 1rem;
}

.accordion-button:not(.collapsed) {
    background: linear-gradient(135deg, #f8f9fa 0%, #eef3ff 100%);
    color: #0d6efd;
}

.accordion-button:focus {
    box-shadow: none;
    border-color: rgba(13, 110, 253, 0.25);
}

.ai-status-note {
    color: #6c757d;
}

.form-control:focus,
.form-select:focus,
.form-range:focus {
    border-color: #86b7fe;
    box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
}

#aiSettingsForm textarea {
    min-height: 140px;
}

#aiSettingsForm .form-check {
    padding-left: 1.9rem;
}

#aiSettingsForm .form-check-input {
    margin-top: 0.2rem;
}

.model-refresh-btn {
    transition: transform 0.2s ease;
}

.model-refresh-btn:hover {
    transform: rotate(180deg);
}

.ollama-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
}

.ollama-status::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #6c757d;
}

.ollama-status.online::before {
    background: #198754;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

@media (max-width: 1199.98px) {
    .ai-kpi-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 991.98px) {
    .ai-sidebar-stack {
        position: static;
    }

    .ai-filter-toolbar .input-group,
    .ai-filter-toolbar .form-select {
        flex: 1 1 100%;
        min-width: 0;
    }

    .ai-system-table thead {
        display: none;
    }

    .ai-system-table tbody,
    .ai-system-table tr,
    .ai-system-table td {
        display: block;
        width: 100%;
    }

    .ai-system-table tr {
        margin-bottom: 1rem;
        border: 1px solid #e6e8ef;
        border-radius: 1rem;
        padding: 0.9rem;
        background: #fff;
    }

    .ai-system-table td {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        padding: 0.55rem 0 !important;
        border: 0 !important;
        text-align: left;
    }

    .ai-system-table td::before {
        content: attr(data-label);
        flex: 0 0 42%;
        font-size: 0.74rem;
        font-weight: 700;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
}

@media (max-width: 767.98px) {
    .ai-command-hero .d-flex {
        width: 100%;
    }

    .ai-hero-actions .btn {
        min-width: 0;
        flex: 1 1 100%;
    }

    .ai-kpi-grid {
        grid-template-columns: 1fr;
    }

    .ai-filter-toolbar {
        flex-direction: column;
        align-items: stretch;
    }
}

@media (max-width: 575.98px) {
    .ai-command-hero .card-body,
    .ai-section-block,
    .ai-panel .card-body,
    .ai-panel .card-header {
        padding: 1rem !important;
    }

    .ai-system-table td {
        gap: 0.7rem;
    }

    .ai-system-table td::before {
        flex-basis: 48%;
    }

    #aiSettingsForm .btn,
    #aiSettingsForm .form-control,
    #aiSettingsForm .form-select,
    #aiSettingsForm .form-range {
        min-height: 44px;
    }
}
</style>
{% endblock %}
{% block content %}
<div class="container-fluid py-4 ai-system-shell">
    <div class="card ai-command-hero mb-4 border-0 position-relative">
        <div class="card-body p-4 p-xl-5">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-4">
                <div class="ai-hero-copy flex-grow-1">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="ai-hero-badge">
                            <i class="bi bi-robot"></i>
                            AI Command Center
                        </span>
                        <span class="badge rounded-pill text-bg-light">Provider routing</span>
                        <span class="badge rounded-pill text-bg-light">Model fallback</span>
                        <span class="badge rounded-pill text-bg-light">Prompt control</span>
                    </div>
                    <h1 class="display-6 fw-bold mb-2">AI System Settings</h1>
                    <p class="lead mb-0">
                        Manage providers, keys, models, prompts, and fallback behavior from one focused workspace.
                    </p>
                    <p class="small mb-0 mt-3">
                        Public assistant uses the selected frontend provider and model first, then falls back automatically if needed.
                    </p>
                </div>
                <div class="ai-hero-actions d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-light" data-bs-toggle="modal" data-bs-target="#addProviderModal">
                        <i class="bi bi-plus-lg me-1"></i>Add provider
                    </button>
                    <a href="#aiSettingsForm" class="btn btn-outline-light">
                        <i class="bi bi-sliders me-1"></i>Configure settings
                    </a>
                    <button type="submit" form="aiSettingsForm" class="btn btn-primary">
                        <i class="bi bi-save-fill me-1"></i>Save now
                    </button>
                </div>
            </div>

            <div class="ai-kpi-grid mt-4">
                <div class="ai-kpi-card">
                    <span class="ai-kpi-label">Active providers</span>
                    <span class="ai-kpi-value" id="providerSummaryActiveCount">0</span>
                    <span class="ai-kpi-note">Currently enabled in the system</span>
                </div>
                <div class="ai-kpi-card">
                    <span class="ai-kpi-label">Providers needing keys</span>
                    <span class="ai-kpi-value" id="providerSummaryNeedsKeyCount">0</span>
                    <span class="ai-kpi-note">Still missing API credentials</span>
                </div>
                <div class="ai-kpi-card">
                    <span class="ai-kpi-label">Tested providers</span>
                    <span class="ai-kpi-value" id="providerSummaryTestedCount">0</span>
                    <span class="ai-kpi-note">Recently verified connections</span>
                </div>
                <div class="ai-kpi-card">
                    <span class="ai-kpi-label">Last test</span>
                    <span class="ai-kpi-value" id="providerSummaryLastTestedTime">Not run</span>
                    <span class="ai-kpi-note">Health check recency</span>
                </div>
            </div>
        </div>
    </div>

    <div id="alertContainer"></div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <div class="card ai-panel mb-4">
                <div class="card-header py-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <div class="section-eyebrow">Provider inventory</div>
                            <h2 class="h5 mb-1">Connected providers</h2>
                            <p class="text-muted small mb-0">Search, filter, test, and toggle providers without leaving the page.</p>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addProviderModal">
                            <i class="bi bi-plus-lg me-1"></i>Add Custom Provider
                        </button>
                    </div>
                </div>
                <div class="card-body border-bottom">
                    <div class="ai-filter-toolbar">
                        <div class="input-group input-group-sm flex-fill">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="search" class="form-control" id="providerSearchInput" placeholder="Search providers...">
                        </div>
                        <select class="form-select form-select-sm" id="providerStatusFilter">
                            <option value="all">Status: All</option>
                            <option value="active">Status: Active</option>
                            <option value="inactive">Status: Inactive</option>
                        </select>
                        <select class="form-select form-select-sm" id="providerApiKeyFilter">
                            <option value="all">API Key: All</option>
                            <option value="keyed">Configured</option>
                            <option value="missing">Missing</option>
                        </select>
                        <select class="form-select form-select-sm" id="providerMultimodalFilter">
                            <option value="all">Multimodal: All</option>
                            <option value="yes">Multimodal</option>
                            <option value="no">No Multimodal</option>
                        </select>
                        <select class="form-select form-select-sm" id="providerHealthFilter">
                            <option value="all">Health: All</option>
                            <option value="success">Last success</option>
                            <option value="error">Last failure</option>
                            <option value="unknown">Not tested</option>
                        </select>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle ai-system-table" id="providersTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Provider</th>
                                    <th>Endpoint</th>
                                    <th>Status</th>
                                    <th>Health</th>
                                    <th>Multimodal</th>
                                    <th>Default</th>
                                    <th>API Key</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for provider in providers %}
                                <tr data-provider-id="{{ provider.id }}"
                                    data-provider-name="{{ provider.provider_name }}"
                                    data-display-name="{{ provider.display_name|e('html_attr') }}"
                                    data-has-key="{{ provider.has_api_key ? '1' : '0' }}"
                                    data-supports-multimodal="{{ provider.supports_multimodal ? '1' : '0' }}"
                                    data-is-active="{{ provider.is_active ? '1' : '0' }}">
                                    <td data-label="Provider">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="provider-icon {{ provider.provider_name }}">
                                                {% if provider.provider_name == 'openrouter' %}
                                                    <i class="bi bi-globe fs-4 text-primary"></i>
                                                {% elseif provider.provider_name == 'openai' %}
                                                    <i class="bi bi-cpu fs-4 text-success"></i>
                                                {% elseif provider.provider_name == 'anthropic' %}
                                                    <i class="bi bi-person-badge fs-4 text-warning"></i>
                                                {% elseif provider.provider_name == 'fireworks' %}
                                                    <i class="bi bi-fire fs-4 text-danger"></i>
                                                {% elseif provider.provider_name == 'kilo' %}
                                                    <i class="bi bi-cpu fs-4 text-info"></i>
                                                {% elseif provider.provider_name == 'ollama' %}
                                                    <i class="bi bi-house fs-4 text-secondary"></i>
                                                {% elseif provider.provider_name == 'huggingface' %}
                                                    <i class="bi bi-robot fs-4" style="color: #FF9D00;"></i>
                                                {% else %}
                                                    <i class="bi bi-gear fs-4 text-secondary"></i>
                                                {% endif %}
                                            </div>
                                            <div>
                                                <strong>{{ provider.display_name }}</strong>
                                                {% if provider.provider_name == 'ollama' %}
                                                    <span class="badge bg-secondary ms-2" id="ollamaLiveStatus">Checking...</span>
                                                {% endif %}
                                                {% if provider.provider_name == 'openrouter' %}
                                                    {% if settings.openrouter_key_source == 'db' %}
                                                        <span class="badge bg-success ms-1 openrouter-key-fix" data-provider-id="{{ provider.id }}" title="Click to edit OpenRouter key. Expiry: unknown">Key (DB)</span>
                                                    {% elseif settings.openrouter_key_source == 'env' %}
                                                        <span class="badge bg-info text-dark ms-1 openrouter-key-fix" data-provider-id="{{ provider.id }}" title="Click to edit OpenRouter key. Expiry: unknown">Key (env)</span>
                                                    {% else %}
                                                        <span class="badge bg-warning text-dark ms-1 openrouter-key-fix" data-provider-id="{{ provider.id }}" title="Click to edit OpenRouter key. Expiry: unknown">No key</span>
                                                    {% endif %}
                                                    <button type="button" class="btn btn-outline-secondary btn-sm ms-1 openrouter-key-test-btn" data-provider-id="{{ provider.id }}" title="Test OpenRouter key">Test key</button>
                                                    <span class="openrouter-key-test-result ms-2"></span>
                                                {% endif %}
                                                <div class="mt-1">
                                                    <small class="text-muted">{{ provider.provider_name }}</small>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="Endpoint">
                                        {% set endpoint = provider.api_endpoint|default(provider.config.endpoint)|default('') %}
                                        <small class="text-muted font-monospace" style="font-size: 11px;">{{ endpoint ?: 'N/A' }}</small>
                                        {% if provider.provider_name == 'ollama' and endpoint in ['http://127.0.0.1:11434', 'http://localhost:11434'] %}
                                            <span class="badge bg-info text-dark ms-1">Auto-detected</span>
                                        {% endif %}
                                    </td>
                                    <td data-label="Status">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input toggle-provider"
                                                   type="checkbox"
                                                   data-provider-id="{{ provider.id }}"
                                                   {% if provider.is_active %}checked{% endif %}>
                                            <label class="form-check-label">
                                                <span class="badge bg-{{ provider.is_active ? 'success' : 'secondary' }}">
                                                    {{ provider.is_active ? 'Active' : 'Inactive' }}
                                                </span>
                                            </label>
                                        </div>
                                    </td>
                                    <td data-label="Health">
                                        <div class="d-flex flex-column gap-1 align-items-start">
                                            <span class="provider-health-pill unknown" data-provider-name="{{ provider.provider_name }}" title="Not tested yet">
                                                Not tested
                                            </span>
                                            <small class="provider-health-timestamp" data-provider-name="{{ provider.provider_name }}">Not tested</small>
                                        </div>
                                    </td>
                                    <td data-label="Multimodal">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input toggle-multimodal"
                                                   type="checkbox"
                                                   data-provider-id="{{ provider.id }}"
                                                   {% if provider.supports_multimodal %}checked{% endif %}>
                                            <label class="form-check-label">
                                                <span class="badge bg-{{ provider.supports_multimodal ? 'success' : 'secondary' }}">
                                                    {{ provider.supports_multimodal ? 'Yes' : 'No' }}
                                                </span>
                                            </label>
                                        </div>
                                    </td>
                                    <td data-label="Default">
                                        {% if provider.is_default %}
                                            <span class="badge bg-primary">
                                                <i class="bi bi-check-circle me-1"></i>Default
                                            </span>
                                        {% else %}
                                            <button class="btn btn-outline-primary btn-sm set-default-btn"
                                                    data-provider-id="{{ provider.id }}"
                                                    {% if not provider.is_active %}disabled{% endif %}>
                                                Set as Default
                                            </button>
                                        {% endif %}
                                    </td>
                                    <td data-label="API Key">
                                        {% if provider.has_api_key %}
                                            <span class="text-success">
                                                <i class="bi bi-key-fill me-1"></i>Configured
                                            </span>
                                        {% else %}
                                            <span class="text-warning">
                                                <i class="bi bi-exclamation-triangle me-1"></i>Not Set
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td data-label="Actions">
                                        <div class="btn-group btn-group-sm flex-wrap">
                                            <button type="button" class="btn btn-outline-info"
                                                    data-bs-toggle="tooltip"
                                                    title="Test Connection"
                                                    data-action="test-connection"
                                                    data-provider-id="{{ provider.id }}">
                                                <i class="bi bi-plug"></i>
                                            </button>
                                            {% if provider.provider_name == 'huggingface' %}
                                            <button class="btn btn-outline-secondary"
                                                    data-bs-toggle="tooltip"
                                                    title="Edit Hugging Face Config"
                                                    data-action="edit-provider"
                                                    data-provider-id="{{ provider.id }}">
                                                <i class="bi bi-sliders"></i>
                                            </button>
                                            {% endif %}
                                            {% if provider.provider_name == 'custom' and provider.sort_order >= 90 %}
                                            <button class="btn btn-outline-danger"
                                                    data-bs-toggle="tooltip"
                                                    title="Delete"
                                                    data-action="delete-provider"
                                                    data-provider-id="{{ provider.id }}">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <form action="/admin/ai-system/save" method="POST" id="aiSettingsForm" class="card ai-panel">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <div class="card-header py-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <div class="section-eyebrow">Routing workspace</div>
                            <h2 class="h5 mb-1">General settings</h2>
                            <p class="text-muted small mb-0">Set the frontend assistant, backend content pipeline, prompts, and failover controls.</p>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-outline-secondary" onclick="location.reload()">
                                <i class="bi bi-arrow-clockwise me-1"></i>Reset
                            </button>
                            <button type="submit" class="btn btn-primary px-4" id="aiSettingsSaveBtn">
                                <i class="bi bi-save-fill me-1"></i>Save Settings
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <div class="ai-section-block ai-status-strip">
                                <div class="d-flex flex-wrap gap-2 align-items-center mb-2" id="aiSettingsStatusPills">
                                    <span class="badge bg-secondary" id="aiStatusApiKey">API Key: Checking...</span>
                                    <span class="badge bg-secondary" id="aiStatusActive">Provider: Checking...</span>
                                    <span class="badge bg-secondary" id="aiStatusTested">Last tested: Not tested</span>
                                </div>
                                <small class="ai-status-note">
                                    Status reflects the selected frontend provider. Public chat uses this provider and model first, then active providers fall back by sort order.
                                    Puter.js is only used if all providers fail.
                                </small>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-12 col-xxl-6">
                            <div class="ai-section-block">
                                <div class="ai-section-title">
                                    <div class="section-eyebrow">Routing</div>
                                    <h3 class="h6 mb-0">Provider and model selection</h3>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Frontend AI (Assistant)</label>
                                        <select name="frontend_provider" class="form-select" id="frontendProviderSelect">
                                            <option value="openrouter" {% if settings.frontend_provider == 'openrouter' or not settings.frontend_provider %}selected{% endif %}>OpenRouter (Default)</option>
                                            <option value="fireworks" {% if settings.frontend_provider == 'fireworks' %}selected{% endif %}>Fireworks AI</option>
                                            {% for provider in providers %}
                                                {% if provider.is_active and provider.provider_name not in ['puter', 'openrouter', 'fireworks'] %}
                                                <option value="{{ provider.provider_name }}"
                                                        {% if settings.frontend_provider == provider.provider_name %}selected{% endif %}>
                                                    {{ provider.display_name }}
                                                </option>
                                                {% endif %}
                                            {% endfor %}
                                        </select>
                                        <small class="text-muted">AI for website assistant chat</small>
                                        <small class="text-muted d-none" id="hfTipsFrontend">
                                            Hugging Face tips: add <span class="font-monospace">:fastest</span>, <span class="font-monospace">:cheapest</span>, or <span class="font-monospace">:preferred</span> to auto-pick.
                                        </small>
                                        {% if settings.frontend_provider == 'openrouter' %}
                                        <div class="mt-1" id="openrouterKeyStatus">
                                            {% if settings.openrouter_key_source == 'db' %}
                                                <span class="badge bg-success">OpenRouter key configured (DB)</span>
                                            {% elseif settings.openrouter_key_source == 'env' %}
                                                <span class="badge bg-info text-dark">OpenRouter key configured (env)</span>
                                            {% else %}
                                                <span class="badge bg-warning text-dark">OpenRouter key missing</span>
                                            {% endif %}
                                        </div>
                                        {% endif %}
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Backend AI Provider (AutoContent)</label>
                                        <select name="backend_provider" class="form-select" id="backendProviderSelect">
                                            {% for provider in providers %}
                                                {% if provider.is_active and provider.provider_name != 'puter' %}
                                                <option value="{{ provider.provider_name }}"
                                                        {% if settings.backend_provider == provider.provider_name %}selected{% endif %}>
                                                    {{ provider.display_name }}
                                                </option>
                                                {% endif %}
                                            {% endfor %}
                                        </select>
                                        <small class="text-muted">AI for content scraping</small>
                                        <small class="text-muted d-none" id="hfTipsBackend">
                                            Hugging Face tips: add <span class="font-monospace">:fastest</span>, <span class="font-monospace">:cheapest</span>, or <span class="font-monospace">:preferred</span> to auto-pick.
                                        </small>
                                    </div>

                                    <div class="col-lg-6">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <label class="form-label fw-semibold mb-1">Frontend Model (Assistant)</label>
                                            <button type="button" class="btn btn-link btn-sm p-0 model-refresh-btn" id="frontendModelRefresh">
                                                <i class="bi bi-arrow-clockwise"></i> Refresh
                                            </button>
                                        </div>
                                        <select name="frontend_model" class="form-select" id="frontendModelSelect"></select>
                                        <div class="form-check form-switch mt-2">
                                            <input class="form-check-input" type="checkbox" id="frontendModelMultimodal">
                                            <label class="form-check-label" for="frontendModelMultimodal">Multimodal (images & rich content)</label>
                                        </div>
                                        <small class="text-muted">Model used for website assistant</small>
                                        <div class="text-danger small d-none" id="frontendModelWarning">No models available for this provider.</div>
                                    </div>

                                    <div class="col-lg-6">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <label class="form-label fw-semibold mb-1">Backend Model (AutoContent)</label>
                                            <button type="button" class="btn btn-link btn-sm p-0 model-refresh-btn" id="backendModelRefresh">
                                                <i class="bi bi-arrow-clockwise"></i> Refresh
                                            </button>
                                        </div>
                                        <select name="backend_model" class="form-select" id="backendModelSelect"></select>
                                        <div class="form-check form-switch mt-2">
                                            <input class="form-check-input" type="checkbox" id="backendModelMultimodal">
                                            <label class="form-check-label" for="backendModelMultimodal">Multimodal (images & rich content)</label>
                                        </div>
                                        <small class="text-muted">Model used for AutoContent</small>
                                        <div class="text-danger small d-none" id="backendModelWarning">No models available for this provider.</div>
                                    </div>

                                    <div class="col-12">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" id="resetModelDefaults">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset models to defaults
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="ai-section-block mt-4">
                                <div class="ai-section-title">
                                    <div class="section-eyebrow">Behavior</div>
                                    <h3 class="h6 mb-0">Performance and fallback controls</h3>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Max Tokens</label>
                                        <input type="number" name="max_tokens" class="form-control"
                                               value="{{ settings.max_tokens|default(4000) }}"
                                               min="100" max="128000">
                                        <small class="text-muted">Maximum tokens in AI response</small>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Temperature</label>
                                        <input type="range" class="form-range" name="temperature"
                                               min="0" max="2" step="0.1"
                                               value="{{ settings.temperature|default(0.7) }}"
                                               id="temperatureRange">
                                        <div class="d-flex justify-content-between">
                                            <small class="text-muted">Precise (0)</small>
                                            <small class="text-muted" id="temperatureValue">{{ settings.temperature|default(0.7) }}</small>
                                            <small class="text-muted">Creative (2)</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" name="enable_fallback"
                                                   id="enableFallback"
                                                   {% if settings.enable_fallback|default(true) %}checked{% endif %}>
                                            <label class="form-check-label fw-semibold" for="enableFallback">
                                                Enable Fallback
                                            </label>
                                            <small class="d-block text-muted">Use other providers if the default fails</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-xxl-6">
                            <div class="ai-section-block h-100">
                                <div class="ai-section-title">
                                    <div class="section-eyebrow">Prompts</div>
                                    <h3 class="h6 mb-0">Assistant instructions and custom skills</h3>
                                </div>
                                <p class="text-muted small mb-4">
                                    Configure separate system prompts for Admin and Public AI assistants. These settings are stored locally in the database.
                                </p>

                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label fw-semibold">
                                            <i class="bi bi-shield-lock me-1 text-primary"></i>Admin Assistant System Prompt
                                        </label>
                                        <textarea name="admin_system_prompt" class="form-control" rows="5"
                                                  placeholder="You are a helpful AI assistant for the admin panel...">{{ settings.admin_system_prompt|default('You are a helpful AI assistant for BroxBhai admin panel that can help with content management, user management, analytics, and website administration tasks.') }}</textarea>
                                        <small class="text-muted">Instructions for the Admin AI Assistant (used in admin panel)</small>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold">
                                            <i class="bi bi-globe me-1 text-success"></i>Public Assistant System Prompt
                                        </label>
                                        <textarea name="public_system_prompt" class="form-control" rows="5"
                                                  placeholder="You are a helpful AI assistant for website visitors...">{{ settings.public_system_prompt|default('You are a helpful AI assistant for BroxBhai website visitors. You can answer questions about the website content, services, and provide general information.') }}</textarea>
                                        <small class="text-muted">Instructions for the Public AI Assistant (used on website)</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="ai-section-block mt-4">
                        <div class="ai-section-title">
                            <div class="section-eyebrow">API Vault</div>
                            <h3 class="h6 mb-0">Provider keys and configuration notes</h3>
                        </div>
                        <div class="row g-3">
                            {% for provider in providers %}
                            <div class="col-md-6 col-xxl-4">
                                <div class="api-key-card">
                                    <label class="form-label fw-semibold">{{ provider.display_name }} API Key</label>
                                    <div class="input-group">
                                        <input type="password" class="form-control api-key-input"
                                               name="api_keys[{{ provider.provider_name }}]"
                                               {% if provider.provider_name == 'openrouter' %}id="apiKeyOpenRouter"{% endif %}
                                               placeholder="{% if provider.has_api_key %}{{ provider.api_key_preview }} (click to update){% else %}Enter API key{% endif %}"
                                               autocomplete="new-password">
                                        <button class="btn btn-outline-secondary toggle-password" type="button">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <small class="text-muted d-block mt-2">
                                        {% if provider.has_api_key %}
                                        <span class="text-success">Configured</span>
                                        {% else %}
                                        <span class="text-warning">Not configured</span>
                                        {% endif %}
                                    </small>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-lg-4">
            <div class="ai-sidebar-stack">
                <div class="card ai-panel">
                    <div class="card-header py-3">
                        <div class="section-eyebrow">Snapshot</div>
                        <h2 class="h6 mb-0">Current configuration</h2>
                    </div>
                    <div class="card-body">
                        {% if default_provider %}
                            <ul class="list-group list-group-flush snapshot-list">
                                <li class="list-group-item">
                                    <span>
                                        <span class="snapshot-label">Frontend AI</span>
                                        <span class="d-block small text-muted">Assistant routing</span>
                                    </span>
                                    <span class="snapshot-value">
                                        {% if settings.frontend_provider == 'openrouter' %}OpenRouter{% elseif settings.frontend_provider == 'fireworks' %}Fireworks AI{% else %}{{ settings.frontend_provider|default('OpenRouter')|upper }}{% endif %}
                                    </span>
                                </li>
                                <li class="list-group-item">
                                    <span>
                                        <span class="snapshot-label">Backend AI</span>
                                        <span class="d-block small text-muted">AutoContent routing</span>
                                    </span>
                                    <span class="snapshot-value">{{ settings.backend_provider|default(default_provider.provider_name)|upper }}</span>
                                </li>
                                <li class="list-group-item">
                                    <span>
                                        <span class="snapshot-label">Frontend model</span>
                                        <span class="d-block small text-muted">Assistant default</span>
                                    </span>
                                    <span class="snapshot-value">{{ settings.frontend_model|default(settings.default_model|default('openrouter/auto')) }}</span>
                                </li>
                                <li class="list-group-item">
                                    <span>
                                        <span class="snapshot-label">Backend model</span>
                                        <span class="d-block small text-muted">AutoContent default</span>
                                    </span>
                                    <span class="snapshot-value">{{ settings.backend_model|default(settings.default_model|default('openrouter/auto')) }}</span>
                                </li>
                                <li class="list-group-item">
                                    <span>
                                        <span class="snapshot-label">Max tokens</span>
                                        <span class="d-block small text-muted">Response cap</span>
                                    </span>
                                    <span class="snapshot-value">{{ settings.max_tokens|default(4000) }}</span>
                                </li>
                                <li class="list-group-item">
                                    <span>
                                        <span class="snapshot-label">Temperature</span>
                                        <span class="d-block small text-muted">Creativity setting</span>
                                    </span>
                                    <span class="snapshot-value">{{ settings.temperature|default(0.7) }}</span>
                                </li>
                            </ul>
                        {% else %}
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                No provider configured
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="card ai-panel">
                    <div class="card-header py-3">
                        <div class="section-eyebrow">Quick actions</div>
                        <h2 class="h6 mb-0">Fast controls</h2>
                    </div>
                    <div class="card-body">
                        <div class="quick-actions-grid">
                            <button type="button" class="btn btn-primary quick-action" data-bs-toggle="modal" data-bs-target="#addProviderModal">
                                <i class="bi bi-plus-circle me-2"></i>Add provider
                            </button>
                            <button type="button" class="btn btn-outline-secondary quick-action" onclick="document.getElementById('resetModelDefaults')?.click();">
                                <i class="bi bi-arrow-counterclockwise me-2"></i>Reset model defaults
                            </button>
                            <a href="#aiSettingsForm" class="btn btn-outline-primary quick-action">
                                <i class="bi bi-sliders me-2"></i>Jump to settings
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card ai-panel">
                    <div class="card-header py-3">
                        <div class="section-eyebrow">Provider health</div>
                        <h2 class="h6 mb-0">Status overview</h2>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            {% for provider in providers %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-{{ provider.is_active ? 'check-circle-fill text-success' : 'circle text-secondary' }}"></i>
                                    <span>{{ provider.display_name }}</span>
                                </div>
                                <span class="badge bg-{{ provider.has_api_key ? 'success' : 'warning' }}">
                                    {{ provider.has_api_key ? 'Ready' : 'Needs Key' }}
                                </span>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                <div class="card ai-panel">
                    <div class="card-header py-3">
                        <div class="section-eyebrow">Help</div>
                        <h2 class="h6 mb-0">Guides and references</h2>
                    </div>
                    <div class="card-body">
                        <div class="accordion" id="helpAccordion">
                            <div class="accordion-item border-0">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#help1">
                                        How do I get an API key?
                                    </button>
                                </h2>
                                <div id="help1" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                    <div class="accordion-body small text-muted p-3">
                                        <p>Visit the provider's website to sign up and get an API key:</p>
                                        <ul class="mb-0">
                                            <li><a href="https://openrouter.ai/keys" target="_blank" rel="noreferrer">OpenRouter</a></li>
                                            <li><a href="https://platform.openai.com/api-keys" target="_blank" rel="noreferrer">OpenAI</a></li>
                                            <li><a href="https://console.anthropic.com/" target="_blank" rel="noreferrer">Anthropic</a></li>
                                            <li><a href="https://fireworks.ai/" target="_blank" rel="noreferrer">Fireworks AI</a></li>
                                            <li><a href="https://huggingface.co/settings/inference-tokens" target="_blank" rel="noreferrer">Hugging Face</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#helpOllama">
                                        Ollama Cloud Quick Start
                                    </button>
                                </h2>
                                <div id="helpOllama" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                    <div class="accordion-body small text-muted p-3">
                                        <p class="mb-2">Ollama Cloud provides API access to various models. Get your API key from <a href="https://ollama.ai" target="_blank" rel="noreferrer">ollama.ai</a> and use the cloud endpoint:</p>
                                        <pre class="mb-0"><code>curl -X POST https://api.ollama.ai/v1/chat/completions \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_API_KEY" \
  -d '{"model":"llama2","messages":[{"role":"user","content":"Hello"}]}'</code></pre>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#help2">
                                        What is Temperature?
                                    </button>
                                </h2>
                                <div id="help2" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                    <div class="accordion-body small text-muted p-3">
                                        Temperature controls randomness. Lower values (0-0.3) produce more focused, deterministic responses. Higher values (0.7-1.0) produce more creative but less predictable outputs.
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item border-0">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#help3">
                                        API Keys Storage
                                    </button>
                                </h2>
                                <div id="help3" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                    <div class="accordion-body small text-muted p-3">
                                        API keys are stored in the database and should be configured via the form above.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Provider Modal -->
<div class="modal fade" id="addProviderModal" tabindex="-1" aria-labelledby="addProviderModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/admin/ai-system/add-provider" method="POST">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <div class="modal-header">
                    <h5 class="modal-title" id="addProviderModalLabel">
                        <i class="bi bi-plus-circle me-2"></i>Add Custom Provider
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Provider Name</label>
                        <input type="text" name="display_name" class="form-control" required
                               placeholder="e.g., My Custom AI">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description (optional)</label>
                        <input type="text" name="description" class="form-control"
                               placeholder="Brief description">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">API Endpoint</label>
                        <input type="url" name="api_endpoint" class="form-control" required
                               placeholder="https://api.example.com/v1/chat/completions">
                        <small class="text-muted">OpenAI-compatible endpoint</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">API Key (optional)</label>
                        <input type="password" name="api_key" class="form-control"
                               placeholder="Enter API key if needed">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Provider</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Provider Modal (Hugging Face Manual Config) -->
<div class="modal fade" id="editProviderModal" tabindex="-1" aria-labelledby="editProviderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editProviderModalLabel">
                    <i class="bi bi-sliders me-2"></i>Hugging Face Manual Config
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editProviderId" value="">
                <div class="mb-3">
                    <label class="form-label fw-semibold">API Endpoint</label>
                    <input type="url" class="form-control" id="editProviderEndpoint"
                           placeholder="https://router.huggingface.co/v1/chat/completions">
                    <small class="text-muted">OpenAI-compatible endpoint for Hugging Face.</small>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Supported Models (JSON map)</label>
                    <textarea class="form-control font-monospace" id="editProviderModels" rows="8"
                              placeholder='{"model/id":"Label"}'></textarea>
                    <small class="text-muted">Format: JSON object of model_id to label.</small>
                    <div class="text-danger small d-none" id="editProviderError">Invalid JSON.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveProviderConfig">
                    <i class="bi bi-save me-1"></i>Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Test Connection Modal -->
<div class="modal fade" id="testConnectionModal" tabindex="-1" aria-labelledby="testConnectionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="testConnectionModalLabel">
                    <i class="bi bi-plug me-2"></i>Test Connection
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning d-none small mb-2" id="testConnectionWarning"></div>
                <div class="mb-3">
                    <label class="form-label">Select Provider</label>
                    <select class="form-select" id="testProviderSelect"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Select Model</label>
                    <select class="form-select" id="testModelSelect">
                        <option value="">Loading models...</option>
                    </select>
                </div>
                <div id="testConnectionResult">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Testing...</span>
                        </div>
                        <p class="mt-2">Testing connection...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" data-action="run-test">
                    <i class="bi bi-plug me-1"></i>Run Test
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<div id="aiSystemData"
     class="d-none"
     data-providers='{{ providers|json_encode|e("html_attr") }}'
     data-settings='{{ {
        "frontend_model": settings.frontend_model|default(""),
        "backend_model": settings.backend_model|default(""),
        "default_model": settings.default_model|default(""),
        "csrf_token": csrf_token
     }|json_encode|e("html_attr") }}'></div>
<script src="{{ base_url }}/assets/js/ai-system-admin.js"></script>
{% endblock %}
