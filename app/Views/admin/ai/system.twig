 <i class="lucide lucide-sliders"></i>
 </button>
 {% endif %}
 {% if provider.provider_name == 'custom' and provider.sort_order >= 90 %}
 <button class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-red-600 transition hover:bg-red-100"
 data-brox-toggle="tooltip"
 title="Delete"
 data-action="delete-provider"
 data-provider-id="{{ provider.id }}">
 <i class="lucide lucide-trash-2"></i>
 </button>
 {% endif %}
 </div>
 </td>
 </tr>
 {% endfor %}
