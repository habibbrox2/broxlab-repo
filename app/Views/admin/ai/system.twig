 <div class="mb-3">
 <label class="form-label font-semibold">API Endpoint</label>
 <input type="url" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="editProviderEndpoint"
 placeholder="https://router.huggingface.co/v1/chat/completions">
 <small class="text-slate-500">OpenAI-compatible endpoint for Hugging Face.</small>
 </div>
 <div class="mb-3">
 <label class="form-label font-semibold">Supported Models (JSON map)</label>
 <textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 font-monospace" id="editProviderModels" rows="8"
 placeholder='{"model/id":"Label"}'></textarea>
 <small class="text-slate-500">Format: JSON object of model_id to label.</small>
 <div class="text-red-600 small hidden" id="editProviderError">Invalid JSON.</div>
 </div>
 </div>
 <div class="modal-footer">
 <button type="button" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" data-brox-dismiss="modal">Cancel</button>
 <button type="button" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700" id="saveProviderConfig">
 <i class="lucide lucide-save mr-1"></i>Save Changes
 </button>
 </div>
 </div>
 </div>
</div>

<!-- Test Connection Modal -->
<div class="modal fade" id="testConnectionModal" tabindex="-1" aria-labelledby="testConnectionModalLabel" aria-hidden="true">
 <div class="modal-dialog">
 <div class="modal-content">
 <div class="modal-header">
 <h5 class="modal-title" id="testConnectionModalLabel">
 <i class="lucide lucide-plug mr-2"></i>Test Connection
 </h5>
 <button type="button" class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-600" data-brox-dismiss="modal"><i class="lucide lucide-x"></i></button>
 </div>
 <div class="modal-body">
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 hidden small mb-2" id="testConnectionWarning"></div>
 <div class="mb-3">
 <label class="form-label">Select Provider</label>
 <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="testProviderSelect"></select>
 </div>
 <div class="mb-3">
 <label class="form-label">Select Model</label>
 <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="testModelSelect">
 <option value="">Loading models...</option>
 </select>
 </div>
 <div id="testConnectionResult">
 <div class="text-center py-4">
 <div class="inline-spinner text-indigo-600" role="status">
 <span class="sr-only">Testing...</span>
 </div>
 <p class="mt-2">Testing connection...</p>
 </div>
 </div>
 </div>
 <div class="modal-footer">
 <button type="button" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" data-brox-dismiss="modal">Close</button>
 <button type="button" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700" data-action="run-test">
 <i class="lucide lucide-plug mr-1"></i>Run Test
 </button>
 </div>
 </div>
 </div>
</div>
{% endblock %}

{% block scripts %}
<div id="aiSystemData"
 class="hidden"
 data-providers='{{ providers|json_encode|e("html_attr") }}'
 data-settings='{{ {"frontend_model": settings.frontend_model|default(""),"backend_model": settings.backend_model|default(""),"default_model": settings.default_model|default("")
 }|json_encode|e("html_attr") }}'></div>
<script type="module" src="{{ base_url }}/assets/js/dist/ai-system-admin.js"></script>
{% endblock %}





