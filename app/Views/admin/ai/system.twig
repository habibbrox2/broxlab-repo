{% extends"admin/layout.twig" %}
{% block title %}AI SYSTEM{% endblock %}
{% set breadcrumbs = [
 { 'label': 'Dashboard', 'url': '/admin' },
 { 'label': 'AI SYSTEM', 'url': '/admin/ai-system' }
] %}
{% block stylesheets %}
<style>
.ai-system-shell {
 position: relative;
}

.ai-system-shell::before {
 content: '';
 position: fixed;
 inset: 0;
 pointer-events: none;
 background:
 radial-gradient(circle at top left, rgba(13, 110, 253, 0.08), transparent 28%),
 radial-gradient(circle at top right, rgba(32, 201, 151, 0.08), transparent 22%);
 z-index: 0;
}

.ai-system-shell > * {
 position: relative;
 z-index: 1;
}

.ai-command-hero {
 overflow: hidden;
 border: 1px solid rgba(13, 110, 253, 0.12);
 background: linear-gradient(135deg, #0b1020 0%, #111827 55%, #1d4ed8 100%);
 color: #fff;
 box-shadow: 0 20px 50px rgba(15, 23, 42, 0.16);
}

.ai-command-hero::after {
 content: '';
 position: absolute;
 inset: auto -80px -120px auto;
 width: 260px;
 height: 260px;
 border-radius: 50%;
 background: radial-gradient(circle, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0));
 pointer-events: none;
}

.ai-hero-copy {
 max-width: 900px;
}

.ai-hero-copy .text-slate-600,
.ai-hero-copy .lead,
.ai-hero-copy .small {
 color: rgba(255, 255, 255, 0.78) !important;
}

.ai-hero-badge {
 display: inline-flex;
 align-items: center;
 gap: 0.55rem;
 padding: 0.55rem 0.9rem;
 border-radius: 999px;
 background: rgba(255, 255, 255, 0.14);
 color: #fff;
 font-size: 0.8rem;
 font-weight: 700;
 letter-spacing: 0.08em;
 text-transform: uppercase;
 backdrop-filter: blur(10px);
}

.ai-hero-actions .hero-btn {
 min-width: 150px;
 border-radius: 999px;
 padding-inline: 1rem;
}

.ai-kpi-grid {
 display: grid;
 grid-template-columns: repeat(4, minmax(0, 1fr));
 gap: 0.85rem;
}

.ai-kpi-card {
 padding: 1rem 1.1rem;
 border-radius: 1rem;
 border: 1px solid rgba(255, 255, 255, 0.16);
 background: rgba(255, 255, 255, 0.08);
 backdrop-filter: blur(10px);
}

.ai-kpi-label {
 display: block;
 margin-bottom: 0.3rem;
 font-size: 0.74rem;
 font-weight: 700;
 letter-spacing: 0.08em;
 text-transform: uppercase;
 color: rgba(255, 255, 255, 0.64);
}

.ai-kpi-value {
 display: block;
 font-size: 1.4rem;
 font-weight: 800;
 line-height: 1.1;
}

.ai-kpi-note {
 display: block;
 margin-top: 0.25rem;
 font-size: 0.84rem;
 color: rgba(255, 255, 255, 0.68);
}

.ai-panel {
 border: 0;
 border-radius: 1.35rem;
 overflow: hidden;
 box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
}

.ai-panel .panel-header {
 background: linear-gradient(180deg, #ffffff 0%, #f8faff 100%);
 border-bottom: 1px solid #e9edf5;
}

.ai-panel .panel-body {
 background: #fff;
}

.section-eyebrow {
 display: inline-flex;
 align-items: center;
 gap: 0.45rem;
 margin-bottom: 0.2rem;
 color: #0d6efd;
 font-size: 0.78rem;
 font-weight: 700;
 letter-spacing: 0.08em;
 text-transform: uppercase;
}

.section-eyebrow::before {
 content: '';
 width: 10px;
 height: 10px;
 border-radius: 50%;
 background: linear-gradient(135deg, #0d6efd, #20c997);
}

.ai-filter-toolbar {
 display: flex;
 flex-wrap: wrap;
 gap: 0.75rem;
 align-items: center;
}

.ai-filter-toolbar .input-group {
 min-width: 260px;
 flex: 1 1 320px;
 border-radius: 0.75rem;
 border: 1px solid #e2e8f0;
 background: #fff;
 overflow: hidden;
}

.ai-filter-toolbar .ai-filter-select {
 min-width: 170px;
 flex: 0 1 190px;
}

.ai-system-table {
 margin-bottom: 0;
}

.ai-system-table thead th {
 border-bottom-width: 1px;
 text-transform: uppercase;
 letter-spacing: 0.06em;
 font-size: 0.74rem;
 color: #6c757d;
}

.provider-icon-wrapper,
.provider-icon {
 width: 48px;
 height: 48px;
 border-radius: 14px;
 display: inline-flex;
 align-items: center;
 justify-content: center;
 background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
 transition: transform 0.2s ease, box-shadow 0.2s ease;
 flex-shrink: 0;
}

.provider-icon-wrapper:hover,
.provider-icon:hover {
 transform: translateY(-1px);
 box-shadow: 0 8px 18px rgba(15, 23, 42, 0.08);
}

.provider-icon-wrapper.openrouter,
.provider-icon.openrouter { background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%); }
.provider-icon-wrapper.openai,
.provider-icon.openai { background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%); }
.provider-icon-wrapper.ollama,
.provider-icon.ollama { background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%); }
.provider-icon-wrapper.anthropic,
.provider-icon.anthropic { background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%); }
.provider-icon-wrapper.fireworks,
.provider-icon.fireworks { background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%); }
.provider-icon-wrapper.huggingface,
.provider-icon.huggingface { background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%); }
.provider-icon-wrapper.kilo,
.provider-icon.kilo { background: linear-gradient(135deg, #e0f7fa 0%, #b2ebf2 100%); }

.status-badge {
 padding: 0.24rem 0.6rem;
 border-radius: 999px;
 font-size: 0.7rem;
 font-weight: 700;
 letter-spacing: 0.05em;
 text-transform: uppercase;
}

.provider-health-pill {
 display: inline-flex;
 align-items: center;
 gap: 0.35rem;
 border-radius: 999px;
 padding: 0.26rem 0.7rem;
 font-size: 0.72rem;
 font-weight: 700;
 letter-spacing: 0.05em;
 text-transform: uppercase;
}

.provider-health-pill::before {
 content: '';
 width: 7px;
 height: 7px;
 border-radius: 50%;
 background: currentColor;
 opacity: 0.85;
}

.provider-health-pill.success {
 background: rgba(25, 135, 84, 0.12);
 color: #198754;
}

.provider-health-pill.error {
 background: rgba(220, 53, 69, 0.12);
 color: #dc3545;
}

.provider-health-pill.unknown {
 background: rgba(108, 117, 125, 0.12);
 color: #6c757d;
}

.provider-health-timestamp {
 font-size: 0.78rem;
 color: #6c757d;
}

.ai-section-block {
 border: 1px solid #e9edf5;
 border-radius: 1rem;
 background: linear-gradient(180deg, #ffffff 0%, #fbfcff 100%);
 padding: 1.25rem;
}

.ai-section-block + .ai-section-block {
 margin-top: 1rem;
}

.ai-section-title {
 margin-bottom: 1rem;
 padding-bottom: 0.85rem;
 border-bottom: 1px solid #eef2f7;
}

.ai-status-strip .status-pill {
 border-radius: 999px;
 padding: 0.5rem 0.85rem;
}

.api-key-card {
 border: 1px solid #edf1f7;
 border-radius: 1rem;
 background: #fff;
 padding: 1rem;
 height: 100%;
}

.api-key-card .form-label {
 margin-bottom: 0.5rem;
}

.ai-sidebar-stack {
 position: sticky;
 top: 1rem;
 display: grid;
 gap: 1rem;
}

.snapshot-list .list-group-item {
 display: flex;
 justify-content: space-between;
 align-items: start;
 gap: 1rem;
 padding-block: 0.85rem;
}

.snapshot-list .snapshot-label {
 color: #6c757d;
 font-size: 0.78rem;
 font-weight: 700;
 letter-spacing: 0.08em;
 text-transform: uppercase;
}

.snapshot-list .snapshot-value {
 text-align: right;
 font-weight: 700;
 word-break: break-word;
}

.quick-actions-grid {
 display: grid;
 gap: 0.65rem;
}

.quick-action {
 justify-content: flex-start;
 border-radius: 0.9rem;
 padding: 0.82rem 1rem;
}

.ai-status-note {
 color: #6c757d;
}

.ai-form-input:focus,
.ai-form-select:focus,
.form-range:focus {
 border-color: #86b7fe;
 box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
}

#aiSettingsForm textarea {
 min-height: 140px;
}

#aiSettingsForm .form-switch {
 padding-left: 1.9rem;
}

#aiSettingsForm .form-switch input {
 margin-top: 0.2rem;
} .ollama-status {
 display: inline-flex;
 align-items: center;
 gap: 0.35rem;
}

.ollama-status::before {
 content: '';
 display: inline-block;
 width: 8px;
 height: 8px;
 border-radius: 50%;
 background: #6c757d;
}

.ollama-status.online::before {
 background: #198754;
 animation: pulse 2s infinite;
}

@keyframes pulse {
 0%, 100% { opacity: 1; }
 50% { opacity: 0.5; }
}

@media (max-width: 1199.98px) {
 .ai-kpi-grid {
 grid-template-columns: repeat(2, minmax(0, 1fr));
 }
}

@media (max-width: 991.98px) {
 .ai-sidebar-stack {
 position: static;
 }

 .ai-filter-toolbar .input-group,
 .ai-filter-toolbar .ai-filter-select {
 flex: 1 1 100%;
 min-width: 0;
 }

 .ai-system-table thead {
 display: none;
 }

 .ai-system-table tbody,
 .ai-system-table tr,
 .ai-system-table td {
 display: block;
 width: 100%;
 }

 .ai-system-table tr {
 margin-bottom: 1rem;
 border: 1px solid #e6e8ef;
 border-radius: 1rem;
 padding: 0.9rem;
 background: #fff;
 }

 .ai-system-table td {
 display: flex;
 justify-content: space-between;
 gap: 1rem;
 align-items: center;
 padding: 0.55rem 0 !important;
 border: 0 !important;
 text-align: left;
 }

 .ai-system-table td::before {
 content: attr(data-label);
 flex: 0 0 42%;
 font-size: 0.74rem;
 font-weight: 700;
 color: #6c757d;
 text-transform: uppercase;
 letter-spacing: 0.05em;
 }
}

@media (max-width: 767.98px) {
 .ai-command-hero .flex {
 width: 100%;
 }

 .ai-hero-actions .hero-btn {
 min-width: 0;
 flex: 1 1 100%;
 }

 .ai-kpi-grid {
 grid-template-columns: 1fr;
 }

 .ai-filter-toolbar {
 flex-direction: column;
 align-items: stretch;
 }
}

@media (max-width: 575.98px) {
 .ai-command-hero .p-4,
 .ai-section-block,.ai-panel .panel-body,
 .ai-panel .panel-header {
  padding: 1rem !important;
 }

 .ai-system-table td {
 gap: 0.7rem;
 }

 .ai-system-table td::before {
 flex-basis: 48%;
 }

 #aiSettingsForm .btn,
 #aiSettingsForm .form-input,
 #aiSettingsForm .form-select,
 #aiSettingsForm .form-range {
 min-height: 44px;
 }
}
</style>
{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 ai-system-shell">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm ai-command-hero mb-4 border-0 relative">
 <div class="p-4 xl:p-5">
 <div class="flex flex-wrap items-start justify-between gap-4">
 <div class="ai-hero-copy flex-grow-1">
 <div class="flex flex-wrap gap-2 mb-3">
 <span class="ai-hero-badge">
 <i class="lucide lucide-bot"></i>
 AI Command Center
 </span>
 <span class="inline-flex items-center rounded-full bg-white/14 px-2 py-0.5 text-xs font-semibold text-white backdrop-blur-sm">Provider routing</span>
 <span class="inline-flex items-center rounded-full bg-white/14 px-2 py-0.5 text-xs font-semibold text-white backdrop-blur-sm">Model fallback</span>
 <span class="inline-flex items-center rounded-full bg-white/14 px-2 py-0.5 text-xs font-semibold text-white backdrop-blur-sm">Prompt control</span>
 </div>
 <h1 class="text-4xl font-bold mb-2">AI System Settings</h1>
 <p class="lead mb-0">
 Manage providers, keys, models, prompts, and fallback behavior from one focused workspace.
 </p>
 <p class="small mb-0 mt-3">
 Public assistant uses the selected frontend provider and model first, then falls back automatically if needed.
 </p>
 </div>
 <div class="ai-hero-actions flex flex-wrap gap-2">
 <button type="button" class="hero-btn inline-flex items-center gap-2 rounded-full border border-white/20 bg-white px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-white/90" data-brox-toggle="modal" data-brox-target="#addProviderModal">
 <i class="lucide lucide-plus"></i>Add provider
 </button>
 <a href="#aiSettingsForm" class="hero-btn inline-flex items-center gap-2 rounded-full border border-white/20 bg-transparent px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10">
 <i class="lucide lucide-sliders"></i>Configure settings
 </a>
 <button type="submit" form="aiSettingsForm" class="hero-btn inline-flex items-center gap-2 rounded-full bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700">
 <i class="lucide lucide-save"></i>Save now
 </button>
 </div>
 </div>

 <div class="ai-kpi-grid mt-4">
 <div class="ai-kpi-card">
 <span class="ai-kpi-label">Active providers</span>
 <span class="ai-kpi-value" id="providerSummaryActiveCount">0</span>
 <span class="ai-kpi-note">Currently enabled in the system</span>
 </div>
 <div class="ai-kpi-card">
 <span class="ai-kpi-label">Providers needing keys</span>
 <span class="ai-kpi-value" id="providerSummaryNeedsKeyCount">0</span>
 <span class="ai-kpi-note">Still missing API credentials</span>
 </div>
 <div class="ai-kpi-card">
 <span class="ai-kpi-label">Tested providers</span>
 <span class="ai-kpi-value" id="providerSummaryTestedCount">0</span>
 <span class="ai-kpi-note">Recently verified connections</span>
 </div>
 <div class="ai-kpi-card">
 <span class="ai-kpi-label">Last test</span>
 <span class="ai-kpi-value" id="providerSummaryLastTestedTime">Not run</span>
 <span class="ai-kpi-note">Health check recency</span>
 </div>
 </div>
 </div>
 </div>

 <div id="alertContainer"></div>

 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 items-start">
 <div class="lg:col-span-8">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm ai-panel mb-4">
 <div class="panel-header border-b border-slate-200 px-4 py-3">
 <div class="flex flex-wrap items-center justify-between gap-3">
 <div>
 <div class="section-eyebrow">Provider inventory</div>
 <h2 class="h5 mb-1">Connected providers</h2>
 <p class="text-slate-500 small mb-0">Search, filter, test, and toggle providers without leaving the page.</p>
 </div>
 <button type="button" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-3 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-indigo-700" data-brox-toggle="modal" data-brox-target="#addProviderModal">
 <i class="lucide lucide-plus mr-1"></i>Add Custom Provider
 </button>
 </div>
 </div>
 <div class="p-4 border-b border-slate-200">
 <div class="ai-filter-toolbar">
 <div class="input-group input-group-sm flex-fill">
 <span class="inline-flex items-center"><i class="lucide lucide-search"></i></span>
 <input type="search" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" id="providerSearchInput" placeholder="Search providers...">
 </div>
 <select class="ai-filter-select w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" id="providerStatusFilter">
 <option value="all">Status: All</option>
 <option value="active">Status: Active</option>
 <option value="inactive">Status: Inactive</option>
 </select>
 <select class="ai-filter-select w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" id="providerApiKeyFilter">
 <option value="all">API Key: All</option>
 <option value="keyed">Configured</option>
 <option value="missing">Missing</option>
 </select>
 <select class="ai-filter-select w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" id="providerMultimodalFilter">
 <option value="all">Multimodal: All</option>
 <option value="yes">Multimodal</option>
 <option value="no">No Multimodal</option>
 </select>
 <select class="ai-filter-select w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" id="providerHealthFilter">
 <option value="all">Health: All</option>
 <option value="success">Last success</option>
 <option value="error">Last failure</option>
 <option value="unknown">Not tested</option>
 </select>
 </div>
 </div>
 <div class="p-4">
 <div class="overflow-x-auto">
 <table class="w-full text-left text-sm [&_th]:px-4 [&_th]:py-3 [&_th]:font-semibold [&_th]:text-slate-600 [&_td]:px-4 [&_td]:py-3 [&_td]:border-t [&_td]:border-slate-100 hover:[&_tr]:bg-slate-50 ai-system-table" id="providersTable">
 <thead class="bg-slate-50">
 <tr>
 <th>Provider</th>
 <th>Endpoint</th>
 <th>Status</th>
 <th>Health</th>
 <th>Multimodal</th>
 <th>Default</th>
 <th>API Key</th>
 <th>Actions</th>
 </tr>
 </thead>
 <tbody>
 {% for provider in providers %}
 <tr data-provider-id="{{ provider.id }}"
 data-provider-name="{{ provider.provider_name }}"
 data-display-name="{{ provider.display_name|e('html_attr') }}"
 data-has-key="{{ provider.has_api_key ? '1' : '0' }}"
 data-supports-multimodal="{{ provider.supports_multimodal ? '1' : '0' }}"
 data-is-active="{{ provider.is_active ? '1' : '0' }}">
 <td data-label="Provider">
 <div class="flex items-center gap-3">
 <div class="provider-icon {{ provider.provider_name }}">
 {% if provider.provider_name == 'openrouter' %}
 <i class="lucide lucide-globe text-xl text-indigo-600"></i>
 {% elseif provider.provider_name == 'openai' %}
 <i class="lucide lucide-cpu text-xl text-emerald-600"></i>
 {% elseif provider.provider_name == 'anthropic' %}
 <i class="lucide lucide-user-check text-xl text-amber-600"></i>
 {% elseif provider.provider_name == 'fireworks' %}
 <i class="lucide lucide-flame text-xl text-red-600"></i>
 {% elseif provider.provider_name == 'kilo' %}
 <i class="lucide lucide-cpu text-xl text-sky-600"></i>
 {% elseif provider.provider_name == 'ollama' %}
 <i class="lucide lucide-house text-xl text-slate-600"></i>
 {% elseif provider.provider_name == 'huggingface' %}
 <i class="lucide lucide-bot text-lg" style="color: #FF9D00;"></i>
 {% else %}
 <i class="lucide lucide-settings text-xl text-slate-600"></i>
 {% endif %}
 </div>
 <div>
 <strong>{{ provider.display_name }}</strong>
 {% if provider.provider_name == 'ollama' %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-600 ml-2" id="ollamaLiveStatus">Checking...</span>
 {% endif %}
 {% if provider.provider_name == 'openrouter' %}
 {% if settings.openrouter_key_source == 'db' %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-emerald-600 ml-1 openrouter-key-fix" data-provider-id="{{ provider.id }}" title="Click to edit OpenRouter key. Expiry: unknown">Key (DB)</span>
 {% elseif settings.openrouter_key_source == 'env' %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-sky-500 text-slate-900 ml-1 openrouter-key-fix" data-provider-id="{{ provider.id }}" title="Click to edit OpenRouter key. Expiry: unknown">Key (env)</span>
 {% else %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-amber-500 text-slate-900 ml-1 openrouter-key-fix" data-provider-id="{{ provider.id }}" title="Click to edit OpenRouter key. Expiry: unknown">No key</span>
 {% endif %}
 <button type="button" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 ml-1 openrouter-key-test-inline-flex" data-provider-id="{{ provider.id }}" title="Test OpenRouter key">Test key</button>
 <span class="openrouter-key-test-result ml-2"></span>
 {% endif %}
 <div class="mt-1">
 <small class="text-slate-500">{{ provider.provider_name }}</small>
 </div>
 </div>
 </div>
 </td>
 <td data-label="Endpoint">
 {% set endpoint = provider.api_endpoint|default(provider.config.endpoint)|default('') %}
 <small class="text-slate-500 font-monospace" style="font-size: 11px;">{{ endpoint ?: 'N/A' }}</small>
 </td>
 <td data-label="Status">
 <div class="flex items-start gap-2 form-switch">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 toggle-provider"
 type="checkbox"
 data-provider-id="{{ provider.id }}"
 {% if provider.is_active %}checked{% endif %}>
 <label class="text-sm text-slate-700">
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-{{ provider.is_active ? 'success' : 'secondary' }}">
 {{ provider.is_active ? 'Active' : 'Inactive' }}
 </span>
 </label>
 </div>
 </td>
 <td data-label="Health">
 <div class="flex flex-column gap-1 items-start">
 <span class="provider-health-pill unknown" data-provider-name="{{ provider.provider_name }}" title="Not tested yet">
 Not tested
 </span>
 <small class="provider-health-timestamp" data-provider-name="{{ provider.provider_name }}">Not tested</small>
 </div>
 </td>
 <td data-label="Multimodal">
 <div class="flex items-start gap-2 form-switch">
 <input class="mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 toggle-multimodal"
 type="checkbox"
 data-provider-id="{{ provider.id }}"
 {% if provider.supports_multimodal %}checked{% endif %}>
 <label class="text-sm text-slate-700">
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-{{ provider.supports_multimodal ? 'success' : 'secondary' }}">
 {{ provider.supports_multimodal ? 'Yes' : 'No' }}
 </span>
 </label>
 </div>
 </td>
 <td data-label="Default">
 {% if provider.is_default %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-indigo-600">
 <i class="lucide lucide-check-circle mr-1"></i>Default
 </span>
 {% else %}
 <button class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-indigo-600 shadow-sm transition hover:bg-indigo-50 set-default-inline-flex"
