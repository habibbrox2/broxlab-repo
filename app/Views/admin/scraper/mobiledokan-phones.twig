{% extends 'admin/layout.twig' %}

{% block title %}MobileDokan Phones - Admin{% endblock %}

{% block stylesheets %}
<style>
  .phone-card {
    transition: all 0.2s ease;
  }
  .phone-card:hover {
    background-color: var(--bs-tertiary-bg);
  }
  .phone-image {
    width: 60px;
    height: 60px;
    object-fit: contain;
  }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
              <li class="breadcrumb-item"><a href="/admin/scraper/mobiledokan">Scraper</a></li>
              <li class="breadcrumb-item active">Phones</li>
            </ol>
          </nav>
          <h2 class="mb-0">
            <i class="bi bi-phone-fill me-2"></i>
            MobileDokan Phones
          </h2>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/admin/scraper/mobiledokan/export/json" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-code me-1"></i> Export JSON
          </a>
          <a href="/admin/scraper/mobiledokan/export/csv" class="btn btn-outline-primary">
            <i class="bi bi-file-earmark-excel me-1"></i> Export CSV
          </a>
          <a href="/admin/scraper/mobiledokan" class="btn btn-primary">
            <i class="bi bi-download me-1"></i> Scrape New Phones
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <form method="GET" class="row g-3">
            <div class="col-md-3">
              <label for="search" class="form-label">Search</label>
              <input type="text" class="form-control" id="search" name="search" value="{{ search }}" placeholder="Search by name or brand...">
            </div>
            <div class="col-md-2">
              <label for="brand" class="form-label">Brand</label>
              <select class="form-select" id="brand" name="brand">
                <option value="">All Brands</option>
                {% for brand in brands %}
                <option value="{{ brand }}" {% if brand == selected_brand %}selected{% endif %}>{{ brand }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-2">
              <label for="min_price" class="form-label">Min Price (৳)</label>
              <input type="number" class="form-control" id="min_price" name="min_price" value="{{ min_price }}" placeholder="0">
            </div>
            <div class="col-md-2">
              <label for="max_price" class="form-label">Max Price (৳)</label>
              <input type="number" class="form-control" id="max_price" name="max_price" value="{{ max_price }}" placeholder="Any">
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search me-1"></i> Search
              </button>
            </div>
            <div class="col-md-1 d-flex align-items-end">
              {% if search or selected_brand or min_price or max_price %}
              <a href="/admin/scraper/mobiledokan/phones" class="btn btn-outline-secondary w-100">
                <i class="bi bi-x-circle"></i>
              </a>
              {% endif %}
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Results Info -->
  <div class="row mb-3">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted">Showing {{ ((current_page - 1) * limit) + 1 }} to {{ min(current_page * limit, total) }} of {{ total }} phones</span>
        </div>
        <div>
          <select class="form-select form-select-sm d-inline-block w-auto" onchange="changeLimit(this.value)">
            <option value="20" {% if limit == 20 %}selected{% endif %}>20 per page</option>
            <option value="50" {% if limit == 50 %}selected{% endif %}>50 per page</option>
            <option value="100" {% if limit == 100 %}selected{% endif %}>100 per page</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Phones Table -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-body p-0">
          {% if phones is empty %}
          <div class="text-center py-5">
            <i class="bi bi-phone fs-1 text-muted"></i>
            <p class="text-muted mt-3">No phones found matching your criteria.</p>
          </div>
          {% else %}
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th style="width: 50px;">ID</th>
                  <th>Phone</th>
                  <th>Brand</th>
                  <th>Price</th>
                  <th>Specs</th>
                  <th>Scraped At</th>
                  <th>Updated At</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for phone in phones %}
                <tr class="phone-card">
                  <td><span class="badge bg-secondary">{{ phone.id }}</span></td>
                  <td>
                    <div class="d-flex align-items-center">
                      {% if phone.image_url %}
                      <img src="{{ phone.image_url }}" alt="{{ phone.name }}" class="phone-image rounded me-2">
                      {% else %}
                      <div class="bg-secondary rounded me-2 d-flex align-items-center justify-content-center phone-image">
                        <i class="bi bi-phone text-white"></i>
                      </div>
                      {% endif %}
                      <div>
                        <div class="fw-bold">{{ phone.name }}</div>
                        <small class="text-muted">{{ phone.slug }}</small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="badge bg-secondary">{{ phone.brand|default('Unknown') }}</span>
                  </td>
                  <td>
                    <span class="badge bg-success">{{ phone.price }}</span>
                  </td>
                  <td>
                    <small class="text-muted">
                      {% if phone.ram %}{{ phone.ram }}{% endif %}
                      {% if phone.storage %} / {{ phone.storage }}{% endif %}
                      {% if phone.processor %}<br>{{ phone.processor }}{% endif %}
                    </small>
                  </td>
                  <td>
                    <small>{{ phone.scraped_at|date('M d, Y H:i') }}</small>
                  </td>
                  <td>
                    <small>{{ phone.updated_at|date('M d, Y H:i') }}</small>
                  </td>
                  <td class="text-end">
                    <a href="{{ phone.url }}" target="_blank" class="btn btn-sm btn-outline-primary me-1" title="View on MobileDokan">
                      <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                    <a href="/admin/scraper/mobiledokan/phones/{{ phone.id }}" class="btn btn-sm btn-outline-secondary me-1" title="View Details">
                      <i class="bi bi-eye"></i>
                    </a>
                    <button onclick="deletePhone({{ phone.id }})" class="btn btn-sm btn-outline-danger" title="Delete">
                      <i class="bi bi-trash"></i>
                    </button>
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- Pagination -->
  {% if total_pages > 1 %}
  <div class="row mt-4">
    <div class="col-12">
      <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
          {% if current_page > 1 %}
          <li class="page-item">
            <a class="page-link" href="?page={{ current_page - 1 }}&limit={{ limit }}&search={{ search }}&brand={{ selected_brand }}&min_price={{ min_price }}&max_price={{ max_price }}">
              <i class="bi bi-chevron-left"></i>
            </a>
          </li>
          {% endif %}

          {% for page in 1..total_pages %}
            {% if page == 1 or page == total_pages or (page >= current_page - 2 and page <= current_page + 2) %}
              <li class="page-item {% if page == current_page %}active{% endif %}">
                <a class="page-link" href="?page={{ page }}&limit={{ limit }}&search={{ search }}&brand={{ selected_brand }}&min_price={{ min_price }}&max_price={{ max_price }}">
                  {{ page }}
                </a>
              </li>
            {% elseif page == current_page - 3 or page == current_page + 3 %}
              <li class="page-item disabled"><span class="page-link">...</span></li>
            {% endif %}
          {% endfor %}

          {% if current_page < total_pages %}
          <li class="page-item">
            <a class="page-link" href="?page={{ current_page + 1 }}&limit={{ limit }}&search={{ search }}&brand={{ selected_brand }}&min_price={{ min_price }}&max_price={{ max_price }}">
              <i class="bi bi-chevron-right"></i>
            </a>
          </li>
          {% endif %}
        </ul>
      </nav>
    </div>
  </div>
  {% endif %}
</div>
{% endblock %}

{% block scripts %}
<script>
  function changeLimit(limit) {
    const url = new URL(window.location);
    url.searchParams.set('limit', limit);
    url.searchParams.set('page', '1');
    window.location.href = url.toString();
  }

  function deletePhone(phoneId) {
    Swal.fire({
      title: 'Are you sure?',
      text: 'This action cannot be undone!',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#dc3545',
      cancelButtonColor: '#6c757d',
      confirmButtonText: 'Yes, delete it!',
      cancelButtonText: 'Cancel'
    }).then((result) => {
      if (result.isConfirmed) {
        fetch(`/admin/scraper/mobiledokan/phones/${phoneId}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          }
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            Swal.fire({
              icon: 'success',
              title: 'Deleted!',
              text: 'Phone has been deleted.',
              timer: 1500,
              timerProgressBar: true
            }).then(() => {
              location.reload();
            });
          } else {
            throw new Error(data.error || 'Failed to delete phone');
          }
        })
        .catch(error => {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: error.message || 'Failed to delete phone'
          });
        });
      }
    });
  }
</script>
{% endblock %}
