{% extends 'admin/layout.twig' %}

{% block title %}API Reverse Engineering | Scraper Tools{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap gap-2 align-items-center mb-4">
                <span class="text-muted small me-2">Related pages:</span>
                <a class="btn btn-sm btn-outline-primary" href="/admin/scraper">Dashboard</a>
                <a class="btn btn-sm btn-outline-primary" href="/admin/scraper/diagnostics">Diagnostics</a>
                <a class="btn btn-sm btn-outline-primary" href="/admin/scraper/selector-tester">Selector Tester</a>
                <a class="btn btn-sm btn-outline-primary" href="/admin/scraper/api-outbound">API Outbound</a>
            </div>
            <h1 class="h3 mb-3">API Reverse Engineering</h1>
            <p class="text-muted mb-4">
                Use the API analysis endpoints to inspect response formats, discover likely routes, and test HTTP methods.
            </p>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="p-3 border rounded h-100">
                        <strong>Analyze endpoint</strong>
                        <div class="text-muted small">`POST /api/v1/scraper/api-reverse-engineering/analyze-endpoint`</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 border rounded h-100">
                        <strong>Discover endpoints</strong>
                        <div class="text-muted small">`POST /api/v1/scraper/api-reverse-engineering/discover-endpoints`</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 border rounded h-100">
                        <strong>Test methods</strong>
                        <div class="text-muted small">`POST /api/v1/scraper/api-reverse-engineering/test-methods`</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
