{% extends 'admin/layout.twig' %}

{% block title %}Scraper Settings | Admin Panel{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">
                        <i class="bi bi-gear me-2"></i>Scraper Settings
                    </h4>
                </div>
                <div class="card-body">
                    <!-- Flash Messages -->
                    {% if flash.success is defined %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>{{ flash.success }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endif %}
                    {% if flash.error is defined %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>{{ flash.error }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endif %}

                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body py-3">
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <span class="text-muted small me-2">Related pages:</span>
                                <a class="btn btn-sm btn-outline-primary" href="/admin/scraper">Dashboard</a>
                                <a class="btn btn-sm btn-outline-primary" href="/admin/scraper/sources">Sources</a>
                                <a class="btn btn-sm btn-outline-primary" href="/admin/scraper/presets">Presets</a>
                                <a class="btn btn-sm btn-outline-primary" href="/admin/scraper/diagnostics">Diagnostics</a>
                                <a class="btn btn-sm btn-outline-primary" href="/admin/scraper/selector-tester">Selector Tester</a>
                            </div>
                        </div>
                    </div>

                    <!-- Create New Setting Form -->
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-plus-circle me-2"></i>Create New Setting
                            </h5>
                        </div>
                        <div class="card-body">
                            <form method="POST" action="/admin/scraper/settings/create">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label for="setting_key" class="form-label">Setting Key <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="setting_key" name="setting_key" required placeholder="e.g., max_concurrent_requests">
                                        <div class="form-text">Unique identifier for the setting</div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label for="setting_value" class="form-label">Setting Value <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="setting_value" name="setting_value" required placeholder="e.g., 5">
                                        <div class="form-text">Value for the setting</div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label for="description" class="form-label">Description</label>
                                        <input type="text" class="form-control" id="description" name="description" placeholder="e.g., Maximum concurrent scraping requests">
                                        <div class="form-text">Optional description of the setting</div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-plus-circle me-2"></i>Create Setting
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Settings List -->
                    <div class="card">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-list-ul me-2"></i>All Settings
                            </h5>
                        </div>
                        <div class="card-body">
                            {% if settings is defined and settings|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Setting Key</th>
                                                <th>Setting Value</th>
                                                <th>Description</th>
                                                <th>Created At</th>
                                                <th>Updated At</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for setting in settings %}
                                                <tr>
                                                    <td>
                                                        <code>{{ setting.setting_key }}</code>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-info">{{ setting.setting_value }}</span>
                                                    </td>
                                                    <td>{{ setting.description|default('N/A') }}</td>
                                                    <td>{{ setting.created_at|date('Y-m-d H:i:s') }}</td>
                                                    <td>{{ setting.updated_at|date('Y-m-d H:i:s') }}</td>
                                                    <td>
                                                        <div class="btn-group" role="group">
                                                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal{{ loop.index }}">
                                                                <i class="bi bi-pencil"></i> Edit
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ loop.index }}">
                                                                <i class="bi bi-trash"></i> Delete
                                                            </button>
                                                        </div>

                                                        <!-- Edit Modal -->
                                                        <div class="modal fade" id="editModal{{ loop.index }}" tabindex="-1" aria-labelledby="editModalLabel{{ loop.index }}" aria-hidden="true">
                                                            <div class="modal-dialog">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title" id="editModalLabel{{ loop.index }}">Edit Setting: {{ setting.setting_key }}</h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <form method="POST" action="/admin/scraper/settings/update">
                                                                        <div class="modal-body">
                                                                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                                                            <input type="hidden" name="id" value="{{ setting.setting_key }}">
                                                                            <div class="mb-3">
                                                                                <label for="edit_setting_key_{{ loop.index }}" class="form-label">Setting Key</label>
                                                                                <input type="text" class="form-control" id="edit_setting_key_{{ loop.index }}" name="setting_key" value="{{ setting.setting_key }}" required>
                                                                            </div>
                                                                            <div class="mb-3">
                                                                                <label for="edit_setting_value_{{ loop.index }}" class="form-label">Setting Value</label>
                                                                                <input type="text" class="form-control" id="edit_setting_value_{{ loop.index }}" name="setting_value" value="{{ setting.setting_value }}" required>
                                                                            </div>
                                                                            <div class="mb-3">
                                                                                <label for="edit_description_{{ loop.index }}" class="form-label">Description</label>
                                                                                <input type="text" class="form-control" id="edit_description_{{ loop.index }}" name="description" value="{{ setting.description|default('') }}">
                                                                            </div>
                                                                        </div>
                                                                        <div class="modal-footer">
                                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                            <button type="submit" class="btn btn-primary">Save Changes</button>
                                                                        </div>
                                                                    </form>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Delete Modal -->
                                                        <div class="modal fade" id="deleteModal{{ loop.index }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ loop.index }}" aria-hidden="true">
                                                            <div class="modal-dialog">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title" id="deleteModalLabel{{ loop.index }}">Confirm Delete</h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <p>Are you sure you want to delete the setting <strong>{{ setting.setting_key }}</strong>?</p>
                                                                        <p class="text-danger"><small>This action cannot be undone.</small></p>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                        <form method="POST" action="/admin/scraper/settings/delete" class="d-inline">
                                                                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                                                            <input type="hidden" name="id" value="{{ setting.setting_key }}">
                                                                            <button type="submit" class="btn btn-danger">Delete</button>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="text-center py-5">
                                    <i class="bi bi-inbox display-1 text-muted"></i>
                                    <h5 class="mt-3 text-muted">No Settings Found</h5>
                                    <p class="text-muted">Create your first scraper setting using the form above.</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Quick Settings Guide -->
                    <div class="card mt-4">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-info-circle me-2"></i>Quick Settings Guide
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h6><i class="bi bi-lightning me-2"></i>Performance Settings</h6>
                                    <ul class="list-unstyled">
                                        <li><code>max_concurrent_requests</code> - Maximum number of simultaneous scraping requests</li>
                                        <li><code>request_delay_ms</code> - Delay between requests in milliseconds</li>
                                        <li><code>timeout_seconds</code> - Request timeout in seconds</li>
                                        <li><code>retry_attempts</code> - Number of retry attempts on failure</li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <h6><i class="bi bi-shield-check me-2"></i>Security Settings</h6>
                                    <ul class="list-unstyled">
                                        <li><code>user_agent</code> - Custom user agent string</li>
                                        <li><code>respect_robots_txt</code> - Whether to respect robots.txt (true/false)</li>
                                        <li><code>max_depth</code> - Maximum crawling depth</li>
                                        <li><code>max_pages_per_domain</code> - Maximum pages to scrape per domain</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <h6><i class="bi bi-database me-2"></i>Storage Settings</h6>
                                    <ul class="list-unstyled">
                                        <li><code>storage_path</code> - Path to store scraped data</li>
                                        <li><code>max_storage_gb</code> - Maximum storage limit in GB</li>
                                        <li><code>auto_cleanup_days</code> - Auto-delete data older than X days</li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <h6><i class="bi bi-gear me-2"></i>Advanced Settings</h6>
                                    <ul class="list-unstyled">
                                        <li><code>enable_javascript</code> - Enable JavaScript rendering (true/false)</li>
                                        <li><code>proxy_rotation</code> - Enable proxy rotation (true/false)</li>
                                        <li><code>cache_enabled</code> - Enable response caching (true/false)</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Custom Styles -->
<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: 1px solid rgba(0, 0, 0, 0.125);
    }
    
    .card-header {
        border-bottom: 1px solid rgba(0, 0, 0, 0.125);
    }
    
    .table th {
        white-space: nowrap;
    }
    
    .btn-group .btn {
        margin-right: 0.25rem;
    }
    
    .btn-group .btn:last-child {
        margin-right: 0;
    }
    
    code {
        background-color: #f8f9fa;
        padding: 0.2rem 0.4rem;
        border-radius: 0.25rem;
        font-size: 0.875em;
    }
    
    .badge {
        font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    }
    
    .form-text {
        font-size: 0.875em;
        color: #6c757d;
    }
    
    .display-1 {
        font-size: 3rem;
    }
    
    @media (max-width: 768px) {
        .table-responsive {
            font-size: 0.875rem;
        }
        
        .btn-group .btn {
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
        }
    }
    
    .copy-key {
        cursor: pointer;
        transition: all 0.2s;
    }
    
    .copy-key:hover {
        background-color: #e9ecef;
    }
    
    .is-invalid {
        border-color: #dc3545 !important;
    }
    
    .is-valid {
        border-color: #198754 !important;
    }
</style>

<!-- Client-side JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Auto-dismiss alerts after 5 seconds
    const alerts = document.querySelectorAll('.alert-dismissible');
    alerts.forEach(function(alert) {
        setTimeout(function() {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        }, 5000);
    });
    
    // Form validation for create form
    const createForm = document.querySelector('form[action="/admin/scraper/settings/create"]');
    if (createForm) {
        const keyInput = createForm.querySelector('input[name="setting_key"]');
        const valueInput = createForm.querySelector('input[name="setting_value"]');
        
        // Validate setting_key: alphanumeric and underscores only
        keyInput.addEventListener('input', function() {
            const isValid = /^[a-zA-Z0-9_]+$/.test(this.value);
            this.classList.toggle('is-invalid', this.value && !isValid);
            this.classList.toggle('is-valid', this.value && isValid);
        });
        
        // Validate setting_value: not empty
        valueInput.addEventListener('input', function() {
            const isValid = this.value.trim().length > 0;
            this.classList.toggle('is-invalid', !isValid);
            this.classList.toggle('is-valid', isValid);
        });
        
        // Form submission with loading state
        createForm.addEventListener('submit', function(e) {
            const keyValid = /^[a-zA-Z0-9_]+$/.test(keyInput.value);
            const valueValid = valueInput.value.trim().length > 0;
            
            if (!keyValid || !valueValid) {
                e.preventDefault();
                if (!keyValid) {
                    keyInput.classList.add('is-invalid');
                }
                if (!valueValid) {
                    valueInput.classList.add('is-invalid');
                }
                return false;
            }
            
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creating...';
        });
    }
    
    // Form validation for edit forms
    const editForms = document.querySelectorAll('form[action="/admin/scraper/settings/update"]');
    editForms.forEach(function(form) {
        const keyInput = form.querySelector('input[name="setting_key"]');
        const valueInput = form.querySelector('input[name="setting_value"]');
        
        keyInput.addEventListener('input', function() {
            const isValid = /^[a-zA-Z0-9_]+$/.test(this.value);
            this.classList.toggle('is-invalid', this.value && !isValid);
            this.classList.toggle('is-valid', this.value && isValid);
        });
        
        valueInput.addEventListener('input', function() {
            const isValid = this.value.trim().length > 0;
            this.classList.toggle('is-invalid', !isValid);
            this.classList.toggle('is-valid', isValid);
        });
        
        form.addEventListener('submit', function(e) {
            const keyValid = /^[a-zA-Z0-9_]+$/.test(keyInput.value);
            const valueValid = valueInput.value.trim().length > 0;
            
            if (!keyValid || !valueValid) {
                e.preventDefault();
                if (!keyValid) {
                    keyInput.classList.add('is-invalid');
                }
                if (!valueValid) {
                    valueInput.classList.add('is-invalid');
                }
                return false;
            }
            
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';
        });
    });
    
    // Confirmation for delete forms
    const deleteForms = document.querySelectorAll('form[action="/admin/scraper/settings/delete"]');
    deleteForms.forEach(function(form) {
        form.addEventListener('submit', function(e) {
            if (!confirm('Are you sure you want to delete this setting? This action cannot be undone.')) {
                e.preventDefault();
                return false;
            }
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Deleting...';
        });
    });
    
    // Copy setting key to clipboard
    const settingKeys = document.querySelectorAll('code');
    settingKeys.forEach(function(code) {
        code.classList.add('copy-key');
        code.title = 'Click to copy';
        code.addEventListener('click', function() {
            const text = this.textContent;
            navigator.clipboard.writeText(text).then(function() {
                const originalText = code.textContent;
                code.textContent = 'Copied!';
                code.style.color = '#198754';
                setTimeout(function() {
                    code.textContent = originalText;
                    code.style.color = '';
                }, 1000);
            });
        });
    });
});
</script>
{% endblock %}
