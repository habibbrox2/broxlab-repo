{% extends 'admin/layout.twig' %}

{% block title %}{{ title }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}

{# ── Gradient Page Header ── #}
<div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-emerald-900 text-white shadow-xl shadow-slate-900/20">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(16,185,129,0.25),transparent_55%)]" aria-hidden="true"></div>
  <div class="relative px-6 py-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-4">
      <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center flex-shrink-0">
        <i class="lucide lucide-file-text w-5 h-5 text-white"></i>
      </div>
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-white/60 mb-1">Land Records</p>
        <h1 class="text-xl font-bold text-white">Kharij Records</h1>
        <p class="text-sm text-white/60 mt-0.5 max-w-md">Bangladesh Government land transfer (খারিজ) document records.</p>
      </div>
    </div>
    <div class="flex gap-2">
      <a href="/admin/kharij/create" class="inline-flex items-center gap-1.5 rounded-xl border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
        <i class="lucide lucide-plus w-4 h-4"></i> New Kharij
      </a>
    </div>
  </div>
</div>

{# ── Filter Section ── #}
<section class="scroll-fade-in mb-6 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
  <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
    <div class="w-7 h-7 rounded-lg bg-amber-50 dark:bg-amber-900/30 flex items-center justify-center flex-shrink-0">
      <i class="lucide lucide-filter w-4 h-4 text-amber-600 dark:text-amber-400"></i>
    </div>
    <div>
      <h3 class="text-sm font-semibold text-slate-900 dark:text-white">Filter Records</h3>
      <p class="text-xs text-slate-400 dark:text-slate-600">Search by owner name, district, or khata number</p>
    </div>
  </div>
  <form class="p-5" method="get" action="">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <div class="space-y-1.5">
        <label for="kharij-search" class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1">Search</label>
        <div class="relative">
          <i class="lucide lucide-search absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 dark:text-slate-600"></i>
          <input id="kharij-search" type="text" name="search" value="{{ pagination.search|default('') }}" placeholder="Owner name, district, khata…"
            class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 pl-9 pr-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 transition-all duration-150 ease-out focus:border-emerald-400 dark:focus:border-emerald-600 focus:bg-white dark:focus:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500/10 hover:border-slate-300 dark:hover:border-slate-600">
        </div>
      </div>
      <div class="space-y-1.5">
        <label for="kharij-limit" class="block text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 mb-1">Per Page</label>
        <select id="kharij-limit" name="limit"
          class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 px-3.5 py-2.5 text-sm text-slate-900 dark:text-slate-100 cursor-pointer appearance-none focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/10 transition-all duration-150">
          <option value="10" {{ pagination.limit == 10 ? 'selected' : '' }}>10</option>
          <option value="20" {{ pagination.limit == 20 ? 'selected' : '' }}>20</option>
          <option value="50" {{ pagination.limit == 50 ? 'selected' : '' }}>50</option>
          <option value="100" {{ pagination.limit == 100 ? 'selected' : '' }}>100</option>
        </select>
      </div>
      <div class="flex items-end">
        <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm shadow-emerald-500/20 hover:shadow-md hover:shadow-emerald-500/25 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150 ease-out w-full">
          <i class="lucide lucide-filter w-4 h-4"></i> Apply
        </button>
      </div>
    </div>
  </form>
</section>

{# ── Bulk Actions Toolbar ── #}
<div id="kharijBulkToolbar" class="mb-4 hidden items-center justify-between rounded-xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/30 px-4 py-3 shadow-sm transition-all duration-200">
  <div class="flex items-center gap-3">
    <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center">
      <i class="lucide lucide-check-square w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
    </div>
    <div>
      <span class="text-sm font-semibold text-emerald-800 dark:text-emerald-200"><span id="kharijSelectedCount">0</span> রেকর্ড নির্বাচিত</span>
      <p class="text-xs text-emerald-600 dark:text-emerald-400">বাল্ক অপারেশনের জন্য রেকর্ড নির্বাচন করুন</p>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <button type="button" id="kharijBulkDeleteBtn" class="inline-flex items-center gap-1.5 rounded-lg border border-red-200 dark:border-red-800 bg-white dark:bg-slate-800 px-3.5 py-2 text-xs font-semibold text-red-600 dark:text-red-400 shadow-sm transition-all duration-150 hover:bg-red-50 dark:hover:bg-red-950/40 hover:border-red-300 dark:hover:border-red-700 active:scale-[0.97]">
      <i class="lucide lucide-trash-2 w-3.5 h-3.5"></i>
      নির্বাচিত মুছুন
    </button>
    <button type="button" id="kharijBulkClearBtn" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-2 text-xs font-semibold text-slate-600 dark:text-slate-400 shadow-sm transition-all duration-150 hover:bg-slate-50 dark:hover:bg-slate-700/60 active:scale-[0.97]">
      <i class="lucide lucide-x w-3.5 h-3.5"></i>
      বাতিল
    </button>
  </div>
</div>

{# ── Records Table ── #}
{% if records is not empty %}
<section class="scroll-fade-in overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
  <div class="flex items-center gap-3 px-5 py-3.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
    <label class="flex items-center gap-2 cursor-pointer">
      <input type="checkbox" id="kharijSelectAll" class="w-4 h-4 rounded border-slate-300 dark:border-slate-600 text-emerald-600 focus:ring-emerald-500/30 cursor-pointer">
      <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 select-none">সব নির্বাচন</span>
    </label>
    <div class="w-px h-5 bg-slate-200 dark:bg-slate-700"></div>
    <div class="w-7 h-7 rounded-lg bg-emerald-50 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0">
      <i class="lucide lucide-list w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
    </div>
    <div>
      <h3 class="text-sm font-semibold text-slate-900 dark:text-white">All Records</h3>
      <p class="text-xs text-slate-400 dark:text-slate-600">Kharij document records with verification links</p>
    </div>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="border-b border-slate-100 dark:border-slate-800">
          <th class="px-3 py-3 w-10">
            <input type="checkbox" id="kharijSelectAllHead" class="kharij-select-all w-4 h-4 rounded border-slate-300 dark:border-slate-600 text-emerald-600 focus:ring-emerald-500/30 cursor-pointer">
          </th>
          <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Landowner</th>
          <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Address</th>
          <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Mouza</th>
          <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Dag</th>
          <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap">Khatian No.</th>
          <th class="px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-600 whitespace-nowrap text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        {% for record in records %}
        <tr class="kharij-row hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors duration-100">
          <td class="px-3 py-3">
            <input type="checkbox" class="kharij-row-checkbox w-4 h-4 rounded border-slate-300 dark:border-slate-600 text-emerald-600 focus:ring-emerald-500/30 cursor-pointer" value="{{ record.id }}">
          </td>
          <td class="px-4 py-3 text-sm text-slate-700 dark:text-slate-300">
            {% if record.data.owners is defined and record.data.owners|length > 0 %}
              {{ record.data.owners[0].name|default('—') }}
            {% else %}
              {{ record.data.owner_name|default('—') }}
            {% endif %}
          </td>
          <td class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400 max-w-[200px] truncate" title="{% if record.data.owners is defined and record.data.owners|length > 0 %}{{ record.data.owners[0].address|default('—') }}{% else %}{{ record.data.owner_address|default('—') }}{% endif %}">
            {% if record.data.owners is defined and record.data.owners|length > 0 %}
              {{ record.data.owners[0].address|default('—') }}
            {% else %}
              {{ record.data.owner_address|default('—') }}
            {% endif %}
          </td>
          <td class="px-4 py-3 text-sm text-slate-700 dark:text-slate-300">{{ record.data.mouza|default('—') }}</td>
          <td class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400">{{ record.data.dag_number|default('—') }}</td>
          <td class="px-4 py-3">
            <div class="flex items-center gap-2">
              <i class="lucide lucide-file-text w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
              <span class="text-sm font-semibold text-slate-900 dark:text-white">{{ record.data.khata_number|default('—') }}</span>
            </div>
          </td>
<td class="px-4 py-3 text-right">
             <div class="kharij-actions-dropdown relative inline-block text-left" data-record-hash="{{ record.hash }}">
               <button type="button"
                  class="kharij-actions-trigger inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2 text-xs font-semibold text-slate-600 dark:text-slate-300 shadow-sm transition-all duration-150 hover:bg-slate-50 dark:hover:bg-slate-700/60 hover:border-slate-300 dark:hover:border-slate-600 active:scale-[0.97]">
                 <i class="lucide lucide-more-horizontal w-3.5 h-3.5"></i>
                 <span>Actions</span>
                 <i class="lucide lucide-chevron-down w-3 h-3 transition-transform duration-200 dropdown-arrow"></i>
               </button>

               <div class="kharij-actions-menu absolute right-0 z-50 mt-1.5 w-52 origin-top-right scale-95 transform rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-xl shadow-slate-900/10 dark:shadow-black/30 opacity-0 invisible pointer-events-none transition-all duration-150 ease-out">
                 <!-- Edit -->
                 <a href="/admin/kharij/edit/{{ record.id }}"
                    class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-950/30 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-100 first:rounded-t-xl" title="Edit kharij record">
                   <i class="lucide lucide-pencil w-4 h-4 text-indigo-400"></i>
                   <span class="flex-1">Edit</span>
                 </a>

                 <div class="border-t border-slate-100 dark:border-slate-700/50 my-1"></div>

                 <!-- Document actions group -->
                 <div class="px-3 pt-1 pb-0.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-600">Document</div>
                 <a href="/mutation-land-gov-bd/QrScanner/KhatianDownload/{{ record.hash }}" target="_blank" rel="noopener"
                    class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-blue-50 dark:hover:bg-blue-950/30 hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-100" title="Preview kharij PDF">
                   <i class="lucide lucide-eye w-4 h-4 text-blue-400"></i>
                   <span class="flex-1">Preview PDF</span>
                 </a>
                 <a href="/mutation-land-gov-bd/QrScanner/KhatianDownload/{{ record.hash }}?download=1"
                    class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-emerald-50 dark:hover:bg-emerald-950/30 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors duration-100" title="Download kharij PDF">
                   <i class="lucide lucide-file-down w-4 h-4 text-emerald-400"></i>
                   <span class="flex-1">Download PDF</span>
                 </a>
                 <a href="/admin/kharij/image-download/{{ record.id }}"
                    class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-purple-50 dark:hover:bg-purple-950/30 hover:text-purple-600 dark:hover:text-purple-400 transition-colors duration-100" title="Download as PNG image">
                   <i class="lucide lucide-image w-4 h-4 text-purple-400"></i>
                   <span class="flex-1">Download Image</span>
                 </a>

                 <div class="border-t border-slate-100 dark:border-slate-700/50 my-1"></div>

                 <!-- DCR actions group -->
                 <div class="px-3 pt-1 pb-0.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-600">DCR Receipt</div>
                 <a href="/mutation-land-gov-bd/online-dcr/{{ record.hash }}" target="_blank" rel="noopener"
                    class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-sky-50 dark:hover:bg-sky-950/30 hover:text-sky-600 dark:hover:text-sky-400 transition-colors duration-100" title="Preview DCR receipt">
                   <i class="lucide lucide-receipt w-4 h-4 text-sky-400"></i>
                   <span class="flex-1">Preview DCR</span>
                 </a>
                 <a href="/admin/kharij/dcr-receipt/{{ record.id }}" target="_blank" rel="noopener"
                    class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-emerald-50 dark:hover:bg-emerald-950/30 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors duration-100" title="Download DCR receipt PDF">
                   <i class="lucide lucide-download w-4 h-4 text-emerald-400"></i>
                   <span class="flex-1">Download DCR</span>
                 </a>

                 <div class="border-t border-slate-100 dark:border-slate-700/50 my-1"></div>

                 <!-- Verification group -->
                 <div class="px-3 pt-1 pb-0.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-600">Verification</div>
                 <a href="/mutation-land-gov-bd/qr-vk/{{ record.hash }}" target="_blank" rel="noopener"
                    class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-emerald-50 dark:hover:bg-emerald-950/30 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors duration-100" title="Verify kharij online">
                   <i class="lucide lucide-check-circle w-4 h-4 text-emerald-400"></i>
                   <span class="flex-1">Verify</span>
                 </a>
                 <button type="button"
                    class="kharij-copy-btn flex items-center gap-3 w-full px-4 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-amber-50 dark:hover:bg-amber-950/30 hover:text-amber-600 dark:hover:text-amber-400 transition-colors duration-100 text-left"
                    title="Copy verification link">
                   <i class="lucide lucide-link w-4 h-4 text-amber-400"></i>
                   <span class="flex-1">Copy Link</span>
                   <span class="kharij-copy-feedback text-[10px] text-emerald-500 font-semibold opacity-0 transition-opacity duration-150">Copied!</span>
                 </button>

                 <div class="border-t border-slate-100 dark:border-slate-700/50 my-1"></div>

                 <!-- Delete -->
                 <form method="POST" action="/admin/kharij/delete/{{ record.id }}" onsubmit="return confirm('Are you sure you want to delete this Kharij record? This action cannot be undone.');">
                   <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                   <button type="submit"
                      class="flex items-center gap-3 w-full px-4 py-2.5 text-sm font-medium text-red-500 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 hover:text-red-600 dark:hover:text-red-300 transition-colors duration-100 last:rounded-b-xl" title="Delete kharij record">
                     <i class="lucide lucide-trash-2 w-4 h-4 text-red-400"></i>
                     <span class="flex-1">Delete</span>
                   </button>
                 </form>
               </div>
             </div>
           </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="flex items-center justify-between px-5 py-3.5 border-t border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30">
    {% include "admin/partials/pagination.twig" %}
  </div>
</section>

{% else %}
{# ── Empty State ── #}
<section class="scroll-fade-in overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
  <div class="flex flex-col items-center justify-center py-16 text-center">
    <div class="w-14 h-14 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-4">
      <i class="lucide lucide-file-text w-7 h-7 text-slate-400 dark:text-slate-600"></i>
    </div>
    <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-1">No records found</h3>
    <p class="text-sm text-slate-400 dark:text-slate-600 mb-5 max-w-xs">
      {% if pagination.search is defined and pagination.search %}
        No kharij records match "<strong>{{ pagination.search }}</strong>". Try a different search.
      {% else %}
        Start by creating your first kharij document!
      {% endif %}
    </p>
    <a href="/admin/kharij/create" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:-translate-y-0.5 transition-all duration-150">
      <i class="lucide lucide-plus w-4 h-4"></i> Create First Kharij
    </a>
  </div>
</section>
{% endif %}

{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', () => {

  'use strict';

  /* ── Dropdown logic ── */

  function initDropdown(container) {
    var trigger = container.querySelector('.kharij-actions-trigger');
    var menu = container.querySelector('.kharij-actions-menu');
    if (!trigger || !menu) return;

    trigger.addEventListener('click', function(e) {
      e.stopPropagation();
      document.querySelectorAll('.kharij-actions-menu.opacity-100').forEach(function(m) {
        if (m !== menu) {
          var p = m.closest('.kharij-actions-dropdown');
          if (p) {
            var t = p.querySelector('.kharij-actions-trigger');
            closeDropdown(m, t);
          }
        }
      });
      toggleDropdown(menu, trigger);
    });

    var copyBtn = container.querySelector('.kharij-copy-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var hash = container.getAttribute('data-record-hash');
        var url = window.location.origin + '/mutation-land-gov-bd/qr-vk/' + hash;
        var feedback = this.querySelector('.kharij-copy-feedback');
        var doCopy = function(text) {
          if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(function() {
              showCopied(feedback);
            }).catch(function() {
              fallbackCopy(text, feedback);
            });
          } else {
            fallbackCopy(text, feedback);
          }
        };
        doCopy(url);
      });
    }
  }

  function toggleDropdown(menu, trigger) {
    var isOpen = !menu.classList.contains('invisible');
    if (isOpen) { closeDropdown(menu, trigger); } else { openDropdown(menu, trigger); }
  }

  function openDropdown(menu, trigger) {
    menu.classList.remove('opacity-0', 'invisible', 'pointer-events-none', 'scale-95');
    menu.classList.add('opacity-100', 'visible', 'pointer-events-auto', 'scale-100');
    var arrow = trigger.querySelector('.dropdown-arrow');
    if (arrow) arrow.style.transform = 'rotate(180deg)';
  }

  function closeDropdown(menu, trigger) {
    menu.classList.add('opacity-0', 'invisible', 'pointer-events-none', 'scale-95');
    menu.classList.remove('opacity-100', 'visible', 'pointer-events-auto', 'scale-100');
    var arrow = trigger.querySelector('.dropdown-arrow');
    if (arrow) arrow.style.transform = 'rotate(0deg)';
  }

  function showCopied(feedback) {
    if (feedback) { feedback.style.opacity = '1'; setTimeout(function() { feedback.style.opacity = '0'; }, 1200); }
  }

  function fallbackCopy(text, feedback) {
    try {
      var textarea = document.createElement('textarea');
      textarea.value = text;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
      showCopied(feedback);
    } catch(e) {}
  }

  // Delegated click handler for dropdowns
  document.addEventListener('click', function(e) {
    document.querySelectorAll('.kharij-actions-dropdown').forEach(function(container) {
      var menu = container.querySelector('.kharij-actions-menu');
      var trigger = container.querySelector('.kharij-actions-trigger');
      if (menu && trigger && !container.contains(e.target)) {
        closeDropdown(menu, trigger);
      }
    });
  });

  // Escape closes any open dropdown
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      var openMenu = document.querySelector('.kharij-actions-menu.opacity-100');
      if (openMenu) {
        var container = openMenu.closest('.kharij-actions-dropdown');
        if (container) {
          var trigger = container.querySelector('.kharij-actions-trigger');
          closeDropdown(openMenu, trigger);
          if (trigger) trigger.focus();
        }
      }
    }
  });

  document.querySelectorAll('.kharij-actions-dropdown').forEach(initDropdown);

  /* ── Bulk Actions ── */

  var toolbar = document.getElementById('kharijBulkToolbar');
  var selectAllHead = document.getElementById('kharijSelectAllHead');
  var selectedCount = document.getElementById('kharijSelectedCount');
  var bulkDeleteBtn = document.getElementById('kharijBulkDeleteBtn');
  var bulkClearBtn = document.getElementById('kharijBulkClearBtn');

  function updateBulkUI() {
    var checkboxes = document.querySelectorAll('.kharij-row-checkbox');
    var checked = document.querySelectorAll('.kharij-row-checkbox:checked');
    var count = checked.length;

    if (count > 0) {
      toolbar.classList.remove('hidden');
      toolbar.classList.add('flex');
      selectedCount.textContent = count;
    } else {
      toolbar.classList.add('hidden');
      toolbar.classList.remove('flex');
    }

    // Update select-all state
    if (selectAllHead) {
      selectAllHead.checked = (count === checkboxes.length && count > 0);
      selectAllHead.indeterminate = (count > 0 && count < checkboxes.length);
    }
  }

  // Select all toggle
  if (selectAllHead) {
    selectAllHead.addEventListener('change', function() {
      document.querySelectorAll('.kharij-row-checkbox').forEach(function(cb) {
        cb.checked = selectAllHead.checked;
      });
      updateBulkUI();
    });
  }

  // Individual checkbox changes
  document.addEventListener('change', function(e) {
    if (e.target.classList.contains('kharij-row-checkbox')) {
      updateBulkUI();
    }
  });

  // Bulk delete
  if (bulkDeleteBtn) {
    bulkDeleteBtn.addEventListener('click', function() {
      var checked = document.querySelectorAll('.kharij-row-checkbox:checked');
      var ids = [];
      checked.forEach(function(cb) { ids.push(cb.value); });

      if (ids.length === 0) return;

      if (!confirm('আপনি কি ' + ids.length + ' টি রেকর্ড মুছে ফেলতে চান? এই কাজটি undo করা যাবে না।')) {
        return;
      }

      // Build and submit a POST form
      var form = document.createElement('form');
      form.method = 'POST';
      form.action = '/admin/kharij/bulk-delete';

      var csrf = document.createElement('input');
      csrf.type = 'hidden';
      csrf.name = 'csrf_token';
      csrf.value = '{{ csrf_token }}';
      form.appendChild(csrf);

      ids.forEach(function(id) {
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'ids[]';
        input.value = id;
        form.appendChild(input);
      });

      document.body.appendChild(form);
      form.submit();
    });
  }

  // Bulk clear selection
  if (bulkClearBtn) {
    bulkClearBtn.addEventListener('click', function() {
      document.querySelectorAll('.kharij-row-checkbox').forEach(function(cb) {
        cb.checked = false;
      });
      if (selectAllHead) selectAllHead.checked = false;
      updateBulkUI();
    });
  }  // Row click to toggle checkbox (exclude interactive elements)
  document.addEventListener('click', function(e) {
    var row = e.target.closest('.kharij-row');
    if (row && !e.target.closest('a') && !e.target.closest('button') && !e.target.closest('input') && !e.target.closest('form') && !e.target.closest('.kharij-actions-menu')) {
      var cb = row.querySelector('.kharij-row-checkbox');
      if (cb) {
        cb.checked = !cb.checked;
        updateBulkUI();
      }
    }
  });
});
</script>
{% endblock %}
