{% block scripts %}
{{ parent() }}
<script>
/**
 * Dynamic Kharij Owner Manager
 * Handles add/remove of multiple land owners in the form.
 */
(function() {
  'use strict';

  var OWNER_TEMPLATE = '\
    <div class="owner-entry rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden" data-owner-index="__INDEX__">\
      <div class="flex items-center justify-between px-5 py-3 bg-slate-50 border-b border-slate-100">\
        <span class="text-sm font-semibold text-slate-700 owner-number-badge">\u09AE\u09BE\u09B2\u09BF\u0995 #__DISPLAY__</span>\
        <button type="button" class="remove-owner-btn inline-flex items-center gap-1.5 rounded-lg border border-red-200 bg-white px-3 py-1.5 text-xs font-semibold text-red-600 transition-all duration-200 hover:bg-red-50 hover:border-red-300 active:scale-[0.97]">\
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>\
          \u09B8\u09B0\u09BE\u09A8\
        </button>\
      </div>\
      <div class="p-5">\
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">\
          <div class="kharij-field-group">\
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">\u09AE\u09BE\u09B2\u09BF\u0995\u09C7\u09B0 \u09A8\u09BE\u09AE <span class="text-rose-500">*</span></label>\
            <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="owners[__INDEX__][name]" required placeholder="\u099C\u09AE\u09BF\u09B0 \u09AA\u09CD\u09B0\u0995\u09C3\u09A4 \u09AE\u09BE\u09B2\u09BF\u0995\u09C7\u09B0 \u09A8\u09BE\u09AE" data-owner-field="name">\
            <span class="field-icon" style="top: 36px;">\uD83D\uDC64</span>\
          </div>\
          <div class="kharij-field-group">\
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">\u09AA\u09BF\u09A4\u09BE/\u09B8\u09CD\u09AC\u09BE\u09AE\u09C0\u09B0 \u09A8\u09BE\u09AE</label>\
            <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="owners[__INDEX__][father_or_husband_name]" placeholder="\u09AE\u09BE\u09B2\u09BF\u0995\u09C7\u09B0 \u09AA\u09BF\u09A4\u09BE \u09AC\u09BE \u09B8\u09CD\u09AC\u09BE\u09AE\u09C0\u09B0 \u09A8\u09BE\u09AE" data-owner-field="father_or_husband_name">\
            <span class="field-icon" style="top: 36px;">\uD83D\uDC68\u200D\uD83D\uDC69\u200D\uD83D\uDC67</span>\
          </div>\
          <div class="kharij-field-group">\
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">\u09AE\u09BE\u09A4\u09BE\u09B0 \u09A8\u09BE\u09AE</label>\
            <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="owners[__INDEX__][mothers_name]" placeholder="\u09AE\u09BE\u09B2\u09BF\u0995\u09C7\u09B0 \u09AE\u09BE\u09A4\u09BE\u09B0 \u09A8\u09BE\u09AE" data-owner-field="mothers_name">\
            <span class="field-icon" style="top: 36px;">\uD83D\uDC69</span>\
          </div>\
          <div class="kharij-field-group">\
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">\u099C\u09BE\u09A4\u09C0\u09AF\u09BC \u09AA\u09B0\u09BF\u099A\u09AF\u09BC\u09AA\u09A4\u09CD\u09B0 \u09A8\u0982</label>\
            <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="owners[__INDEX__][nid_number]" placeholder="\u098F\u09A8\u0986\u0987\u09A1\u09BF \u09A8\u09AE\u09CD\u09AC\u09B0 (\u0990\u099B\u09BF\u0995\u09CD\u09AF)" data-owner-field="nid_number">\
            <span class="field-icon" style="top: 36px;">\uD83E\uDEAA</span>\
          </div>\
          <div class="kharij-field-group sm:col-span-2">\
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">\u09A0\u09BF\u0995\u09BE\u09A8\u09BE <span class="text-rose-500">*</span></label>\
            <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="owners[__INDEX__][address]" required placeholder="\u09AE\u09BE\u09B2\u09BF\u0995\u09C7\u09B0 \u09B8\u09AE\u09CD\u09AA\u09C2\u09B0\u09CD\u09A3 \u09A0\u09BF\u0995\u09BE\u09A8\u09BE" data-owner-field="address">\
            <span class="field-icon" style="top: 36px;">\uD83D\uDCCD</span>\
          </div>\
          <div class="kharij-field-group">\
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">\u0985\u0982\u09B6 <span class="text-rose-500">*</span></label>\
            <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="owners[__INDEX__][share]" required placeholder="\u09AF\u09C7\u09AE\u09A8: \u09E7/\u09EA \u09AC\u09BE \u09EA \u0986\u09A8\u09BE" data-owner-field="share">\
            <span class="field-icon" style="top: 36px;">\uD83E\uDDEE</span>\
          </div>\
        </div>\
      </div>\
    </div>\
  ';

  function updateBadge(count) {
    var badge = document.getElementById('owner-count-badge');
    if (badge) badge.textContent = count + " \u099C\u09A8 \u09AE\u09BE\u09B2\u09BF\u0995";
  }

  function reindexOwners() {
    var entries = document.querySelectorAll('#owners-container .owner-entry');
    entries.forEach(function(entry, idx) {
      var displayNum = idx + 1;
      entry.dataset.ownerIndex = idx;
      var badge = entry.querySelector('.owner-number-badge');
      if (badge) badge.textContent = "\u09AE\u09BE\u09B2\u09BF\u0995 #" + displayNum;
      var inputs = entry.querySelectorAll('[name^="owners["]');
      inputs.forEach(function(input) {
        var fieldName = input.dataset.ownerField;
        if (fieldName) {
          input.name = 'owners[' + idx + '][' + fieldName + ']';
          input.id = 'owner_' + idx + '_' + fieldName;
        }
      });
    });
    updateBadge(entries.length);
  }

  function createOwnerEntry(data) {
    var container = document.getElementById('owners-container');
    var entryCount = container.querySelectorAll('.owner-entry').length;
    var html = OWNER_TEMPLATE
      .replace(/__INDEX__/g, entryCount)
      .replace(/__DISPLAY__/g, entryCount + 1);

    var temp = document.createElement('div');
    temp.innerHTML = html.trim();
    var entry = temp.firstChild;

    if (data) {
      var fields = ['name', 'father_or_husband_name', 'mothers_name', 'nid_number', 'address', 'share'];
      fields.forEach(function(f) {
        if (data[f]) {
          var input = entry.querySelector('[data-owner-field="' + f + '"]');
          if (input) input.value = data[f];
        }
      });
    }

    container.appendChild(entry);
    reindexOwners();
  }

  function init() {
    var container = document.getElementById('owners-container');
    if (!container) return;

    // Build initial owner from server-provided data
    var initialOwner = {};
    var nameInput = document.querySelector('[name="owner_name"]');
    if (nameInput && nameInput.value) initialOwner.name = nameInput.value;
    var fatherInput = document.querySelector('[name="father_or_husband_name"]');
    if (fatherInput && fatherInput.value) initialOwner.father_or_husband_name = fatherInput.value;
    var motherInput = document.querySelector('[name="mothers_name"]');
    if (motherInput && motherInput.value) initialOwner.mothers_name = motherInput.value;
    var addressInput = document.querySelector('[name="owner_address"]');
    if (addressInput && addressInput.value) initialOwner.address = addressInput.value;
    var shareInput = document.querySelector('[name="share"]');
    if (shareInput && shareInput.value) initialOwner.share = shareInput.value;
    var nidInput = document.querySelector('[name="nid_number"]');
    if (nidInput && nidInput.value) initialOwner.nid_number = nidInput.value;

    // Remove old single fields
    var oldFields = ['owner_name', 'father_or_husband_name', 'mothers_name', 'owner_address', 'share', 'nid_number'];
    oldFields.forEach(function(f) {
      var el = document.querySelector('[name="' + f + '"]');
      if (el && el.parentNode) el.parentNode.removeChild(el);
    });

    // If no data from old fields, use Twig data
    if (!initialOwner.name) {
      initialOwner.name = '{{ data.owner_name|default("")|e("js") }}';
      initialOwner.father_or_husband_name = '{{ data.father_or_husband_name|default("")|e("js") }}';
      initialOwner.mothers_name = '{{ data.mothers_name|default("")|e("js") }}';
      initialOwner.address = '{{ data.owner_address|default("")|e("js") }}';
      initialOwner.share = '{{ data.share|default("")|e("js") }}';
      initialOwner.nid_number = '{{ data.nid_number|default("")|e("js") }}';
    }

    createOwnerEntry(initialOwner);

    var addBtn = document.getElementById('add-owner-btn');
    if (addBtn) {
      addBtn.addEventListener('click', function() { createOwnerEntry(null); });
    }

    container.addEventListener('click', function(e) {
      var removeBtn = e.target.closest('.remove-owner-btn');
      if (!removeBtn) return;
      var entry = removeBtn.closest('.owner-entry');
      if (entry) {
        var count = container.querySelectorAll('.owner-entry').length;
        if (count <= 1) {
          alert('\u0985\u09A8\u09CD\u09A4\u09A4 \u098F\u0995\u099C\u09A8 \u09AE\u09BE\u09B2\u09BF\u0995 \u09A5\u09BE\u0995\u09A4\u09C7 \u09B9\u09AC\u09C7\u0964');
          return;
        }
        if (confirm('\u098F\u0987 \u09AE\u09BE\u09B2\u09BF\u0995\u0995\u09C7 \u09B8\u09B0\u09BE\u09A4\u09C7 \u099A\u09BE\u09A8?')) {
          entry.remove();
          reindexOwners();
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<script>
/**
 * Kharij Land Calculator — automatic unit conversion & field calculation
 */
(function() {
  'use strict';

  // Bangladeshi land unit constants
  var SHOTTANGSHO_PER_ACRE = 100;
  var SQFT_PER_SHOTTANGSHO = 435.6;
  var SQFT_PER_ACRE = 43560;

  // Convert Bengali digits (০-৯) to English digits (0-9)
  function bnToEn(str) {
    if (!str) return str;
    // Unicode: ০=U+09E6, ১=U+09E7, ..., ৯=U+09EF
    return str.replace(/[\u09E6-\u09EF]/g, function(m) {
      return String.fromCharCode(m.charCodeAt(0) - 0x09E6 + 48);
    });
  }

  // Parse a numeric value from an input field (handles Bengali & English digits)
  function parseNum(val) {
    if (!val || val === '') return NaN;
    var cleaned = bnToEn(val).replace(/[^\d.]/g, '');
    return parseFloat(cleaned);
  }

  // Format a number for display (remove trailing zeros after decimal)
  function fmt(n) {
    if (isNaN(n) || n === 0) return '0';
    return n.toFixed(4).replace(/\.?0+$/, '');
  }

  // Auto-calculate dag_area_shottangsho from total_land_area
  function calcLandArea() {
    var tla = document.getElementById('total_land_area');
    var das = document.getElementById('dag_area_shottangsho');
    if (!tla || !das) return;
    var acres = parseNum(tla.value);
    if (!isNaN(acres) && acres > 0) {
      das.value = fmt(acres * SHOTTANGSHO_PER_ACRE);
    }
  }

  // Auto-calculate total_dag_area from agriculture + non_agriculture
  function calcTotalDag() {
    var agri = document.getElementById('agriculture_area');
    var nonAgri = document.getElementById('non_agriculture_area');
    var total = document.getElementById('total_dag_area');
    if (!agri || !nonAgri || !total) return;
    var a = parseNum(agri.value);
    var na = parseNum(nonAgri.value);
    if (!isNaN(a) && !isNaN(na)) {
      total.value = fmt(a + na);
    }
  }

  // Auto-calculate single_area from total_dag_area and total_share
  function calcSingle() {
    var dag = document.getElementById('total_dag_area');
    var share = document.getElementById('total_share');
    var single = document.getElementById('single_area');
    if (!dag || !share || !single) return;
    var d = parseNum(dag.value);
    var s = parseNum(share.value);
    if (!isNaN(d) && !isNaN(s) && s > 0) {
      single.value = fmt(d / s);
    }
  }

  // Auto-calculate khash_area and khash_area_shottangsho from single_area
  function calcKhash() {
    var single = document.getElementById('single_area');
    var khash = document.getElementById('khash_area');
    var khashStg = document.getElementById('khash_area_shottangsho');
    if (!single || !khash || !khashStg) return;
    var s = parseNum(single.value);
    if (!isNaN(s) && s > 0) {
      khash.value = fmt(s);
      khashStg.value = fmt(s * SHOTTANGSHO_PER_ACRE);
    }
  }

  // Auto-calculate summary fields
  function calcSummary() {
    var dagAcr = document.getElementById('total_dag_area_summary_acre');
    var dagStg = document.getElementById('total_dag_area_summary_shottangsho');
    var dag = document.getElementById('total_dag_area');
    if (!dagAcr || !dagStg || !dag) return;
    var d = parseNum(dag.value);
    if (!isNaN(d) && d > 0) {
      dagAcr.value = fmt(d);
      dagStg.value = fmt(d * SHOTTANGSHO_PER_ACRE);
    }
  }

  // Run all auto-calculations
  function runAll() {
    calcLandArea();
    calcTotalDag();
    calcSingle();
    calcKhash();
    calcSummary();
  }

  // Unit converter
  function doConvert() {
    var input = document.getElementById('calc-input-value');
    var unit = document.getElementById('calc-input-unit');
    var results = document.getElementById('calc-results');
    if (!input || !unit || !results) return;

    var val = parseFloat(input.value);
    if (isNaN(val) || val <= 0) {
      results.innerHTML = '<div class="calc-result-item" style="grid-column:1/-1;color:#94a3b8;">একটি বৈধ সংখ্যা লিখুন</div>';
      return;
    }

    var acres, stg, sqft;
    switch (unit.value) {
      case 'acre': acres = val; stg = val * SHOTTANGSHO_PER_ACRE; sqft = val * SQFT_PER_ACRE; break;
      case 'shottangsho': stg = val; acres = val / SHOTTANGSHO_PER_ACRE; sqft = val * SQFT_PER_SHOTTANGSHO; break;
      case 'sqft': sqft = val; acres = val / SQFT_PER_ACRE; stg = val / SQFT_PER_SHOTTANGSHO; break;
    }

    results.innerHTML =
      '<div class="calc-result-item"><span>একর:</span><strong>' + fmt(acres) + '</strong></div>' +
      '<div class="calc-result-item"><span>শতাংশ:</span><strong>' + fmt(stg) + '</strong></div>' +
      '<div class="calc-result-item"><span>বর্গফুট:</span><strong>' + Math.round(sqft).toLocaleString() + '</strong></div>' +
      '<div class="calc-result-item"><span>কাঠা (৭২০ বর্গফুট):</span><strong>' + fmt(sqft / 720) + '</strong></div>' +
      '<div class="calc-result-item"><span>বিঘা (৩৩ শতাংশ):</span><strong>' + fmt(stg / 33) + '</strong></div>' +
      '<div class="calc-result-item"><span>হেক্টর:</span><strong>' + fmt(acres / 2.471) + '</strong></div>';
  }

  function init() {
    var toggle = document.getElementById('toggle-land-calc');
    var panel = document.getElementById('land-calc-panel');
    if (toggle && panel) {
      toggle.addEventListener('click', function() {
        panel.classList.toggle('open');
        toggle.classList.toggle('bg-amber-200');
      });
    }

    // Auto-calc on input change
    var fieldIds = ['total_land_area', 'dag_area_shottangsho', 'agriculture_area', 'non_agriculture_area', 'total_dag_area', 'total_share', 'single_area'];
    fieldIds.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', runAll);
        el.addEventListener('change', runAll);
      }
    });

    // Convert button
    var convertBtn = document.getElementById('calc-convert-btn');
    if (convertBtn) {
      convertBtn.addEventListener('click', doConvert);
      var cvInput = document.getElementById('calc-input-value');
      var cvUnit = document.getElementById('calc-input-unit');
      if (cvInput) cvInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') doConvert(); });
    }

    // Auto-fill button
    var autoBtn = document.getElementById('calc-auto-fill');
    if (autoBtn) {
      autoBtn.addEventListener('click', runAll);
    }

    // Run initial calculation after a brief delay
    setTimeout(runAll, 200);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
