    reindexOwners();
  }

  function init() {
    var container = document.getElementById('owners-container');
    if (!container) return;

    // Build initial owner from server-provided data
    var initialOwner = {};
    var nameInput = document.querySelector('[name="owner_name"]');
    if (nameInput && nameInput.value) initialOwner.name = nameInput.value;
    var fatherInput = document.querySelector('[name="father_or_husband_name"]');
    if (fatherInput && fatherInput.value) initialOwner.father_or_husband_name = fatherInput.value;
    var motherInput = document.querySelector('[name="mothers_name"]');
    if (motherInput && motherInput.value) initialOwner.mothers_name = motherInput.value;
    var addressInput = document.querySelector('[name="owner_address"]');
    if (addressInput && addressInput.value) initialOwner.address = addressInput.value;
    var shareInput = document.querySelector('[name="share"]');
    if (shareInput && shareInput.value) initialOwner.share = shareInput.value;
    var nidInput = document.querySelector('[name="nid_number"]');
    if (nidInput && nidInput.value) initialOwner.nid_number = nidInput.value;

    // Remove old single fields
    var oldFields = ['owner_name', 'father_or_husband_name', 'mothers_name', 'owner_address', 'share', 'nid_number'];
    oldFields.forEach(function(f) {
      var el = document.querySelector('[name="' + f + '"]');
      if (el && el.parentNode) el.parentNode.removeChild(el);
    });

    // If no data from old fields, use Twig data
    if (!initialOwner.name) {
      initialOwner.name = '{{ data.owner_name|default("")|e("js") }}';
      initialOwner.father_or_husband_name = '{{ data.father_or_husband_name|default("")|e("js") }}';
      initialOwner.mothers_name = '{{ data.mothers_name|default("")|e("js") }}';
      initialOwner.address = '{{ data.owner_address|default("বাসা/হোল্ডিং:, গ্রাম/রাস্তা:খড়ারচর, , ডাকঘর:রোয়াইল-1822, উপজেলা: ধামরাই, জেলা: ঢাকা")|e("js") }}';
      initialOwner.share = '{{ data.share|default("")|e("js") }}';
      initialOwner.nid_number = '{{ data.nid_number|default("")|e("js") }}';
    }

    createOwnerEntry(initialOwner);

    // Add button listener
    var addBtn = document.getElementById('add-owner-btn');
    if (addBtn) addBtn.addEventListener('click', function() { createOwnerEntry(null); });

    // Remove button listener (event delegation)
    container.addEventListener('click', function(e) {
      var removeBtn = e.target.closest('.remove-owner-btn');
      if (!removeBtn) return;
      var entry = removeBtn.closest('.owner-entry');
      if (entry) {
        var count = container.querySelectorAll('.owner-entry').length;
        if (count <= 1) {
          alert('অন্তত একজন মালিক থাকতে হবে।');
          return;
        }
        if (confirm('এই মালিককে সরাতে চান?')) {
          entry.remove();
          reindexOwners();
        }
      }
    });
  }

  init();
  setTimeout(fillRandomData, 0);
});
</script>

<script>
/**
 * Kharij Land Calculator — automatic unit conversion & field calculation
 */
document.addEventListener('DOMContentLoaded', () => {
  'use strict';

// Bangladeshi land unit constants
  var SHOTTANGSHO_PER_ACRE = 100;
  var SQFT_PER_SHOTTANGSHO = 435.6;
  var SQFT_PER_ACRE = 43560;

  // Convert Bengali digits (0-9) to English digits (0-9)
  function bnToEn(str) {
    if (!str) return str;
    // Unicode: 0=U+09E6, 1=U+09E7, ..., 9=U+09EF
    return str.replace(/[০-৯]/g, function(m) {
      return String.fromCharCode(m.charCodeAt(0) - 0x09E6 + 48);
    });
  }

  // Parse a numeric value from an input field (handles Bengali & English digits)
  function parseNum(val) {
    if (!val || val === '') return NaN;
    var cleaned = bnToEn(val).replace(/[^\\d.]/g, '');
    return parseFloat(cleaned);
  }

  // Format a number for display (remove trailing zeros after decimal)
  function fmt(n) {
    if (isNaN(n) || n === 0) return '0';
    return n.toFixed(4).replace(/\\.?0+$/, '');
  }

  // ──────────────────────────────────────────────
  // Per-Dag Auto-Calculation Functions
  // ──────────────────────────────────────────────

  // Get the first owner's share value
  function getFirstOwnerShare() {
    var el = document.querySelector('[data-owner-field="share"]');
    return el ? parseNum(el.value) : NaN;
  }

  // Calculate dag_area_shottangsho from total_dag_area within a dag entry
  function calcDagTotalArea(dagEntry) {
    var totalDagInput = dagEntry.querySelector('[data-dag-field="total_dag_area"]');
    var dagAreaStgInput = dagEntry.querySelector('[data-dag-field="dag_area_shottangsho"]');
    if (!totalDagInput || !dagAreaStgInput) return;
    var acres = parseNum(totalDagInput.value);
    if (!isNaN(acres) && acres > 0) {
      dagAreaStgInput.value = fmt(acres * SHOTTANGSHO_PER_ACRE);
    }
  }

  // Calculate khash_area and khash_area_shottangsho from single_area × owner share
  function calcDagKhash(dagEntry) {
    var singleInput = dagEntry.querySelector('[data-dag-field="single_area"]');
    var khashInput = dagEntry.querySelector('[data-dag-field="khash_area"]');
    var khashStgInput = dagEntry.querySelector('[data-dag-field="khash_area_shottangsho"]');
    var shareVal = getFirstOwnerShare();
    if (!singleInput || !khashInput || !khashStgInput) return;
    var single = parseNum(singleInput.value);
    if (!isNaN(single) && single > 0 && !isNaN(shareVal) && shareVal > 0) {
      var khashAcres = single * shareVal;
      khashInput.value = fmt(khashAcres);
      khashStgInput.value = fmt(khashAcres * SHOTTANGSHO_PER_ACRE);
    }
  }

  // Recalculate all dags and update summary
  function recalcAllDags() {
    document.querySelectorAll('#dag-entries-container .dag-entry').forEach(function(entry) {
      calcDagTotalArea(entry);
      calcDagKhash(entry);
    });
    updateDagSummary();
  }

  // Update summary fields by summing all dags
  function updateDagSummary() {
    var totalDagAcres = 0, totalDagStg = 0;
    document.querySelectorAll('#dag-entries-container .dag-entry').forEach(function(entry) {
      totalDagAcres += parseNum(entry.querySelector('[data-dag-field="total_dag_area"]').value) || 0;
      totalDagStg += parseNum(entry.querySelector('[data-dag-field="dag_area_shottangsho"]').value) || 0;
    });
    var summaryAcr = document.getElementById('total_dag_area_summary_acre');
    var summaryStg = document.getElementById('total_dag_area_summary_shottangsho');
    if (summaryAcr) summaryAcr.value = fmt(totalDagAcres);
    if (summaryStg) summaryStg.value = fmt(totalDagStg);
  }

  // Auto-calculate total_land_words from total_land_area
  function calcLandWords() {
    var tla = document.getElementById('total_land_area');
    var tlw = document.getElementById('total_land_words');
    if (!tla || !tlw) return;
    var acres = parseNum(tla.value);
    if (isNaN(acres) || acres <= 0) return;
    var acrePart = Math.floor(acres);
    var totalSh = acres * 100;
    var bighaPart = Math.floor(totalSh / 33);
    var sotangshoPart = Math.floor(totalSh % 33);
    tlw.value = toBnNum(acrePart) + ' একর ' + toBnNum(bighaPart) + ' শতক ' + toBnNum(sotangshoPart) + ' অযুতাংশ ০০ লক্ষাংশ';
  }

  // Run all auto-calculations
  function runAll() {
    recalcAllDags();
    calcLandWords();
  }

  // Unit converter
  function doConvert() {
    var input = document.getElementById('calc-input-value');
    var unit = document.getElementById('calc-input-unit');
    var results = document.getElementById('calc-results');
    if (!input || !unit || !results) return;

    var val = parseFloat(input.value);
    if (isNaN(val) || val <= 0) {
      results.innerHTML = '<div class="calc-result-item" style="grid-column:1/-1;color:#94a3b8;">একটি বৈধ সংখ্যা লিখুন</div>';
      return;
    }

    var acres, stg, sqft;
    switch (unit.value) {
      case 'acre': acres = val; stg = val * SHOTTANGSHO_PER_ACRE; sqft = val * SQFT_PER_ACRE; break;
      case 'shottangsho': stg = val; acres = val / SHOTTANGSHO_PER_ACRE; sqft = val * SQFT_PER_SHOTTANGSHO; break;
      case 'sqft': sqft = val; acres = val / SQFT_PER_ACRE; stg = val / SQFT_PER_SHOTTANGSHO; break;
    }

    results.innerHTML =
      '<div class="calc-result-item"><span>একর:</span><strong>' + fmt(acres) + '</strong></div>' +
      '<div class="calc-result-item"><span>শতাংশ:</span><strong>' + fmt(stg) + '</strong></div>' +
      '<div class="calc-result-item"><span>বর্গফুট:</span><strong>' + Math.round(sqft).toLocaleString() + '</strong></div>' +
      '<div class="calc-result-item"><span>কাঠা (৭২০ বর্গফুট):</span><strong>' + fmt(sqft / 720) + '</strong></div>' +
      '<div class="calc-result-item"><span>বিঘা (৩৩ শতাংশ):</span><strong>' + fmt(stg / 33) + '</strong></div>' +
      '<div class="calc-result-item"><span>হেক্টর:</span><strong>' + fmt(acres / 2.471) + '</strong></div>';
  }

  function init() {
    var toggle = document.getElementById('toggle-land-calc');
    var panel = document.getElementById('land-calc-panel');
    if (toggle && panel) {
      toggle.addEventListener('click', function() {
        panel.classList.toggle('open');
        toggle.classList.toggle('bg-amber-200');
      });
    }

    // Auto-calc for total_land_area changes
    var tla = document.getElementById('total_land_area');
    if (tla) {
      tla.addEventListener('input', function() { calcLandWords(); recalcAllDags(); });
      tla.addEventListener('change', function() { calcLandWords(); recalcAllDags(); });
    }

    // Per-dag auto-calc via event delegation
    var dagContainer = document.getElementById('dag-entries-container');
    if (dagContainer) {
      dagContainer.addEventListener('input', function(e) {
        var dagEntry = e.target.closest('.dag-entry');
        if (!dagEntry) return;
        var field = e.target.dataset.dagField;
        if (field === 'total_dag_area') {
          calcDagTotalArea(dagEntry);
          updateDagSummary();
        } else if (field === 'single_area') {
          calcDagKhash(dagEntry);
        }
      });
      dagContainer.addEventListener('change', function(e) {
        var dagEntry = e.target.closest('.dag-entry');
        if (!dagEntry) return;
        var field = e.target.dataset.dagField;
        if (field === 'total_dag_area') {
          calcDagTotalArea(dagEntry);
          updateDagSummary();
        } else if (field === 'single_area') {
          calcDagKhash(dagEntry);
        }
      });
    }

    // Listen for owner share changes (affects all dag khash calculations)
    var ownerContainer = document.getElementById('owners-container');
    if (ownerContainer) {
      ownerContainer.addEventListener('input', function(e) {
        var shareInput = e.target.closest('[data-owner-field="share"]');
        if (shareInput) {
          recalcAllDags();
          calcLandWords();
        }
      });
      ownerContainer.addEventListener('change', function(e) {
        var shareInput = e.target.closest('[data-owner-field="share"]');
        if (shareInput) {
          recalcAllDags();
          calcLandWords();
        }
      });
    }

    // Convert button
    var convertBtn = document.getElementById('calc-convert-btn');
    if (convertBtn) {
      convertBtn.addEventListener('click', doConvert);
      var cvInput = document.getElementById('calc-input-value');
      var cvUnit = document.getElementById('calc-input-unit');
      if (cvInput) cvInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') doConvert(); });
    }

    // Auto-fill button
    var autoBtn = document.getElementById('calc-auto-fill');
    if (autoBtn) {
      autoBtn.addEventListener('click', runAll);
    }

    // Run initial calculation after a brief delay
    setTimeout(runAll, 200);
  }

  init();
});
</script>

