                  <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="tax_arrears_last_3_years" id="tax_arrears_last_3_years" value="{{ data.tax_arrears_last_3_years|default('65') }}" placeholder="০">
