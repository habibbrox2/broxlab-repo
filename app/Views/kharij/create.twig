/**
 * Form validation before PDF generation
 * Checks all required fields and highlights invalid ones.
 */
document.addEventListener('DOMContentLoaded', () => {
  'use strict';

var form = document.getElementById('kharijForm');
  if (!form) return;

  // Required field IDs for validation
  var requiredFields = [
    { id: 'khata_number', label: 'খতিয়ান নম্বর' },
    { id: 'mouza', label: 'মৌজা' },
    { id: 'upazila', label: 'উপজেলা/থানা' },
    { id: 'district', label: 'জেলা' }
  ];

  // Dag required field names (within each dag entry)
  var dagRequiredFields = ['dag_number'];
  var dagFieldLabels = {
    dag_number: 'দাগ/প্লট নম্বর'
  };

  // Owner required field names (within each owner entry)
  var ownerRequiredFields = ['name', 'address', 'share'];
  var ownerFieldLabels = {
    name: 'মালিকের নাম',
    address: 'ঠিকানা',
    share: 'অংশ'
  };

  // Clear all validation errors
  function clearErrors() {
    document.querySelectorAll('.kharij-field-group.invalid').forEach(function(el) {
      el.classList.remove('invalid');
    });
    document.querySelectorAll('.owner-entry.invalid').forEach(function(el) {
      el.classList.remove('invalid');
    });
    var summary = document.getElementById('validationSummary');
    if (summary) {
      summary.classList.remove('visible');
      summary.querySelector('span').textContent = '';
    }
  }

  // Show validation summary error
  function showSummary(message) {
    var summary = document.getElementById('validationSummary');
    if (!summary) {
      var submitArea = document.querySelector('.scroll-fade-in:last-of-type .flex');
      if (submitArea) {
        summary = document.createElement('div');
        summary.id = 'validationSummary';
        summary.className = 'validation-summary';
        summary.innerHTML = '<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg><span></span>';
        submitArea.parentNode.insertBefore(summary, submitArea);
      }
    }
    if (summary) {
      summary.querySelector('span').textContent = message;
      summary.classList.add('visible');
      summary.classList.add('shake');
      setTimeout(function() { summary.classList.remove('shake'); }, 500);
    }
  }

  // Validate a single field group
  function validateField(id, label) {
    var el = document.getElementById(id);
    if (!el) return true;
    var group = el.closest('.kharij-field-group');
    if (!group) return true;
    var val = el.value.trim();
    if (!val) {
      group.classList.add('invalid');
      var errorEl = group.querySelector('.validation-error');
      if (!errorEl) {
        errorEl = document.createElement('div');
        errorEl.className = 'validation-error';
        group.appendChild(errorEl);
      }
      errorEl.textContent = 'দয়া করে ' + label + ' পূরণ করুন';
      return false;
    }
    return true;
  }

  // Validate dag entries (at least first dag must have required fields)
  function validateDags() {
    var entries = document.querySelectorAll('#dag-entries-container .dag-entry');
    var valid = true;
    entries.forEach(function(entry) {
      dagRequiredFields.forEach(function(field) {
        var input = entry.querySelector('[data-dag-field="' + field + '"]');
        if (!input) return;
        var group = input.closest('.kharij-field-group');
        if (!group) return;
        var val = input.value.trim();
        if (!val) {
          group.classList.add('invalid');
          var errorEl = group.querySelector('.validation-error');
          if (!errorEl) {
            errorEl = document.createElement('div');
            errorEl.className = 'validation-error';
            group.appendChild(errorEl);
          }
          errorEl.textContent = 'দয়া করে ' + dagFieldLabels[field] + ' পূরণ করুন';
          valid = false;
        }
      });
    });
    return valid;
  }

  // Validate all owners
  function validateOwners() {
    var entries = document.querySelectorAll('#owners-container .owner-entry');
    var valid = true;
    entries.forEach(function(entry) {
      var entryValid = true;
      ownerRequiredFields.forEach(function(field) {
        var input = entry.querySelector('[data-owner-field="' + field + '"]');
        if (!input) return;
        var group = input.closest('.kharij-field-group');
        if (!group) return;
        var val = input.value.trim();
        if (!val) {
          group.classList.add('invalid');
          var errorEl = group.querySelector('.validation-error');
          if (!errorEl) {
            errorEl = document.createElement('div');
            errorEl.className = 'validation-error';
            group.appendChild(errorEl);
          }
          errorEl.textContent = 'দয়া করে ' + ownerFieldLabels[field] + ' পূরণ করুন';
          entry.classList.add('invalid');
          entryValid = false;
          valid = false;
        }
      });
    });
    return valid;
  }

  // Validate the entire form
  function validateForm() {
    clearErrors();
    var allValid = true;
    var firstInvalid = null;

    // Check main required fields
    requiredFields.forEach(function(f) {
      if (!validateField(f.id, f.label)) {
        allValid = false;
        if (!firstInvalid) firstInvalid = document.getElementById(f.id);
      }
    });

    // Validate dag entries (at least first dag must have dag_number)
    if (!validateDags()) {
      allValid = false;
      if (!firstInvalid) {
        var firstDagInput = document.querySelector('#dag-entries-container [data-dag-field="dag_number"]');
        if (firstDagInput) firstInvalid = firstDagInput;
      }
    }

    // Check owners
    if (!validateOwners()) {
      allValid = false;
      if (!firstInvalid) {
        var firstOwnerInput = document.querySelector('#owners-container [data-owner-field="name"]');
        if (firstOwnerInput) firstInvalid = firstOwnerInput;
      }
    }

    if (!allValid) {
      showSummary('দয়া করে সকল বাধ্যতামূলক ক্ষেত্রের মান পূরণ করুন');
      // Scroll to first invalid field
      if (firstInvalid) {
        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(function() { firstInvalid.focus(); }, 400);
      }
      return false;
    }
    return true;
  }

  // Hook into form submit
  form.addEventListener('submit', function(e) {
    if (!validateForm()) {
      e.preventDefault();
      return false;
    }
  });

  // Clear errors on input change (real-time feedback)
  form.addEventListener('input', function(e) {
    var group = e.target.closest('.kharij-field-group');
    if (group && group.classList.contains('invalid')) {
      group.classList.remove('invalid');
    }
    var ownerEntry = e.target.closest('.owner-entry');
    if (ownerEntry && ownerEntry.classList.contains('invalid')) {
      // Check if this owner entry's required fields are all filled now
      var allFilled = true;
      ownerRequiredFields.forEach(function(f) {
        var input = ownerEntry.querySelector('[data-owner-field="' + f + '"]');
        if (!input || !input.value.trim()) allFilled = false;
      });
      if (allFilled) ownerEntry.classList.remove('invalid');
    }
  });
});
</script>

