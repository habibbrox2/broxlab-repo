      entry.dataset.dagIndex = idx;
      var badge = entry.querySelector('.dag-number-badge');
      if (badge) badge.textContent = '\u09A6\u09BE\u0997/\u09AA\u09CD\u09B2\u099F #' + (idx + 1);
      var inputs = entry.querySelectorAll('[name^="dags["]');
      inputs.forEach(function(input) {
        var field = input.dataset.dagField;
        if (field) {
          input.name = 'dags[' + idx + '][' + field + ']';
          input.id = 'dag_' + idx + '_' + field;
        }
      });
    });
    updateDagBadge(entries.length);
  }

  function createDagEntry(data) {
    var container = document.getElementById('dag-entries-container');
    var entryCount = container.querySelectorAll('.dag-entry').length;
    var html = DAG_TEMPLATE
      .replace(/__INDEX__/g, entryCount)
      .replace(/__DISPLAY__/g, entryCount + 1);

    var temp = document.createElement('div');
    temp.innerHTML = html.trim();
    var entry = temp.firstChild;

    if (data) {
      var fields = ['dag_number', 'land_type', 'total_dag_area', 'dag_area_shottangsho', 'single_area', 'khash_area', 'khash_area_shottangsho'];
      fields.forEach(function(f) {
        if (data[f]) {
          var input = entry.querySelector('[data-dag-field="' + f + '"]');
          if (input) input.value = data[f];
        }
      });
    }

    container.appendChild(entry);
    reindexDags();

    // Auto-calc this new dag
    calcDagTotalArea(entry);
    calcDagKhash(entry);
    updateDagSummary();

    return entry;
  }

  function initDagManager() {
    var container = document.getElementById('dag-entries-container');
    if (!container) return;

    // Create initial dag entry from existing flat fields or Twig data
    var initialDag = {};
    var dagNumInput = document.querySelector('[name="dag_number"]');
    if (dagNumInput && dagNumInput.value) initialDag.dag_number = dagNumInput.value;
    var landTypeInput = document.querySelector('[name="land_type"]');
    if (landTypeInput && landTypeInput.value) initialDag.land_type = landTypeInput.value;

    // Remove old single fields
    var oldFields = ['dag_number', 'land_type'];
    oldFields.forEach(function(f) {
      var el = document.querySelector('[name="' + f + '"]');
      if (el && el.parentNode) {
        var group = el.closest('.kharij-field-group') || el.parentNode;
        if (group && group.parentNode) group.parentNode.removeChild(group);
      }
    });

    // Fallback to Twig data if no form fields found
    if (!initialDag.dag_number) {
      initialDag = {
        dag_number: '{{ data.dag_number|default("")|e("js") }}',
        land_type: '{{ data.land_type|default("")|e("js") }}',
        total_dag_area: '{{ data.total_dag_area|default("0")|e("js") }}',
        dag_area_shottangsho: '{{ data.dag_area_shottangsho|default("0")|e("js") }}',
        single_area: '{{ data.single_area|default("0")|e("js") }}',
        khash_area: '{{ data.khash_area|default("0")|e("js") }}',
        khash_area_shottangsho: '{{ data.khash_area_shottangsho|default("0")|e("js") }}'
      };
    }

    createDagEntry(initialDag);

    // Add button listener
    var addBtn = document.getElementById('add-dag-btn');
    if (addBtn) addBtn.addEventListener('click', function() { createDagEntry(null); });

    // Remove button listener (event delegation)
    container.addEventListener('click', function(e) {
      var removeBtn = e.target.closest('.remove-dag-btn');
      if (!removeBtn) return;
      var entry = removeBtn.closest('.dag-entry');
      if (entry) {
        var count = container.querySelectorAll('.dag-entry').length;
        if (count <= 1) {
          alert('\u0985\u09A8\u09CD\u09A4\u09A4 \u098F\u0995\u099F\u09BF \u09A6\u09BE\u0997/\u09AA\u09CD\u09B2\u099F \u09A5\u09BE\u0995\u09A4\u09C7 \u09B9\u09AC\u09C7\u0964');
          return;
        }
        if (confirm('\u098F\u0987 \u09A6\u09BE\u0997\u099F\u09BF \u09B8\u09B0\u09BE\u09A4\u09C7 \u099A\u09BE\u09A8?')) {
          entry.remove();
          reindexDags();
          updateDagSummary();
        }
      }
    });

    // Toggle collapsible dag body
    container.addEventListener('click', function(e) {
      var toggleBtn = e.target.closest('.dag-toggle-btn');
      if (!toggleBtn) return;
      var entry = toggleBtn.closest('.dag-entry');
      if (!entry) return;
      var body = entry.querySelector('.dag-body');
      if (body) {
        body.classList.toggle('collapsed');
        toggleBtn.classList.toggle('collapsed');
      }
    });
  }

  // Initialize dag entries on page load
  initDagManager();
});
</script>

<script>
/**
 * Tax Collection Auto-Calculator
 * Calculates total demand, arrears, and converts to Bengali words.
 */
document.addEventListener('DOMContentLoaded', () => {
  'use strict';

  var taxFields = ['tax_arrears_over_3_years','tax_arrears_last_3_years','tax_penalty','tax_current_demand','tax_total_demand','tax_total_collected','tax_total_arrears'];

  // Convert Bengali digits (০-৯) to English digits (0-9)
  function bnToEn(str) {
    if (!str) return str;
    return str.replace(/[০-৯]/g, function(m) {
      return String.fromCharCode(m.charCodeAt(0) - 0x09E6 + 48);
    });
  }

  function parseTaxVal(id) {
    var el = document.getElementById(id);
    if (!el) return 0;
    return parseFloat(bnToEn(el.value).replace(/[^0-9.]/g,'')) || 0;
  }

  /**
   * Convert a number (0-999) to Bengali words, e.g. 337 → তিন শত সাঁইত্রিশ টাকা মাত্র
   */
  function bnNumToWords(n) {
    n = parseInt(n, 10) || 0;
    if (n === 0) return 'শূন্য টাকা মাত্র';

    var ones = ['', 'এক', 'দুই', 'তিন', 'চার', 'পাঁচ', 'ছয়', 'সাত', 'আট', 'নয়'];
    var teens = ['দশ', 'এগারো', 'বারো', 'তেরো', 'চৌদ্দ', 'পনেরো', 'ষোল', 'সতেরো', 'আঠারো', 'উনিশ'];
    var compounds = {
      21: 'একুশ', 22: 'বাইশ', 23: 'তেইশ', 24: 'চব্বিশ', 25: 'পঁচিশ',
      26: 'ছাব্বিশ', 27: 'সাতাশ', 28: 'আটাশ', 29: 'উনত্রিশ',
      31: 'একত্রিশ', 32: 'বত্রিশ', 33: 'তেত্রিশ', 34: 'চৌত্রিশ', 35: 'পঁয়ত্রিশ',
      36: 'ছত্রিশ', 37: 'সাঁইত্রিশ', 38: 'আটত্রিশ', 39: 'উনচল্লিশ',
      41: 'একচল্লিশ', 42: 'বেয়াল্লিশ', 43: 'তেতাল্লিশ', 44: 'চুয়াল্লিশ', 45: 'পঁয়তাল্লিশ',
      46: 'ছেচাল্লিশ', 47: 'সাতচল্লিশ', 48: 'আটচল্লিশ', 49: 'উনপঞ্চাশ',
      51: 'একান্ন', 52: 'বাহান্ন', 53: 'তিপ্পান্ন', 54: 'চুয়ান্ন', 55: 'পঞ্চান্ন',
      56: 'ছাপ্পান্ন', 57: 'সাতান্ন', 58: 'আটান্ন', 59: 'উনষাট',
      61: 'একষট্টি', 62: 'বাষট্টি', 63: 'তেষট্টি', 64: 'চৌষট্টি', 65: 'পঁয়ষট্টি',
      66: 'ছেষট্টি', 67: 'সাতষট্টি', 68: 'আটষট্টি', 69: 'উনসত্তর',
      71: 'একাত্তর', 72: 'বাহাত্তর', 73: 'তিয়াত্তর', 74: 'চুয়াত্তর', 75: 'পঁচাত্তর',
      76: 'ছিয়াত্তর', 77: 'সাতাত্তর', 78: 'আটাত্তর', 79: 'উনআশি',
      81: 'একাশি', 82: 'বিরাশি', 83: 'তিরাশি', 84: 'চুরাশি', 85: 'পঁচাশি',
      86: 'ছিয়াশি', 87: 'সাতাশি', 88: 'আটাশি', 89: 'উননব্বই',
      91: 'একানব্বই', 92: 'বিরানব্বই', 93: 'তিরানব্বই', 94: 'চুরানব্বই', 95: 'পঁচানব্বই',
      96: 'ছিয়ানব্বই', 97: 'সাতানব্বই', 98: 'আটানব্বই', 99: 'নিরানব্বই'
    };

    var result = '';
    if (n >= 100) {
      result += ones[Math.floor(n / 100)] + ' শত ';
      n = n % 100;
    }
    if (n > 0) {
      if (n < 10) result += ones[n];
      else if (n < 20) result += teens[n - 10];
      else result += compounds[n] || '';
    }
    return (result.trim() || 'শূন্য') + ' টাকা মাত্র';
  }

  function calcTaxTotals() {
    var d = parseTaxVal('tax_arrears_over_3_years') + parseTaxVal('tax_arrears_last_3_years') + parseTaxVal('tax_penalty') + parseTaxVal('tax_current_demand');
    var c = parseTaxVal('tax_total_collected');
    var a = d - c;

    var tdEl = document.getElementById('tax_total_demand');
    var taEl = document.getElementById('tax_total_arrears');
    var twEl = document.getElementById('total_amount_words');

    if (tdEl) tdEl.value = d > 0 ? d.toString() : '';
    if (taEl) taEl.value = a >= 0 ? a.toString() : a.toString();
    if (twEl && d > 0) {
      var words = bnNumToWords(d);
      if (twEl.value.indexOf('টাকা') === -1 || !twEl.value.trim()) {
        twEl.value = words;
      }
    }
  }

  taxFields.forEach(function(id) {
    var el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', calcTaxTotals);
      el.addEventListener('change', calcTaxTotals);
    }
  });

  // Also watch total_amount_words changes to recalculate words if total demand changes
  var twEl = document.getElementById('total_amount_words');

  setTimeout(calcTaxTotals, 300);
  var calcBtn = document.getElementById('calcTaxTotals');
  if (calcBtn) calcBtn.addEventListener('click', calcTaxTotals);
});
</script>
{% endblock %}
