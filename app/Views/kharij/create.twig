{% block scripts %}
{{ parent() }}

<!-- Shared Kharij Modules -->
<script src="{{ asset('/assets/js/kharij/kharij-utils.js') }}"></script>
<script src="{{ asset('/assets/js/kharij/amount-to-bangla-words.js') }}"></script>
<script src="{{ asset('/assets/js/kharij/bangla-calendar.js') }}"></script>
<script src="{{ asset('/assets/js/kharij/kharij-owner-manager.js') }}"></script>
<script src="{{ asset('/assets/js/kharij/kharij-land-calculator.js') }}"></script>
<script src="{{ asset('/assets/js/kharij/kharij-tax-calculator.js') }}"></script>
<script src="{{ asset('/assets/js/kharij/kharij-form-validation.js') }}"></script>

<!-- Page-Specific: Random Data & Init Scripts -->
<script>
/**
 * Generate a random date between 2022-2025 in dd-mm-yyyy format.
 */
function randomDate2022to2025() {
    var start = new Date(2022, 0, 1).getTime();
    var end = new Date(2025, 11, 31).getTime();
    var rand = new Date(start + Math.random() * (end - start));
    var d = ('0' + rand.getDate()).slice(-2);
    var m = ('0' + (rand.getMonth() + 1)).slice(-2);
    var y = rand.getFullYear();
    return { date: d, month: m, year: y, full: d + '-' + m + '-' + y };
}

/**
 * Auto-incrementing counter for generating sequential application numbers.
 */
var kharijSeqCounter = 1;

/**
 * Generate application numbers (frontend-only) for the kharij form.
 */
function generateAppNumbers() {
    var appDate = randomDate2022to2025();
    var yy = appDate.year.toString().slice(-2);
    var mm = appDate.month;
    var dd = appDate.date;

    var seq = kharijSeqCounter;
    kharijSeqCounter++;

    var appSeq = ('34352323' + seq).slice(-6);
    var appNo = appDate.year + appDate.month + appDate.date + appSeq;

    var dcrSeq = ('5416544' + seq).slice(-7);
    var dcrNo = 'DCR' + yy + mm + dd + dcrSeq;

    var mutGroup = Math.floor(seq / 1000);
    var mutRem = seq % 1000;
    var mutSub = seq % 100 || 1;
    var mutationCase = mutGroup + ',' + ('000' + mutRem).slice(-3) + '(IX-I)/' + yy + '-' + ('00' + mutSub).slice(-2);

    document.getElementById('application_no').value = appNo;
    document.getElementById('application_date').value = appDate.full;
    document.getElementById('mutation_case_no').value = mutationCase;
    document.getElementById('online_dcr_no').value = dcrNo;
}

/**
 * Fill form with random data
 */
function fillRandomData() {
    var khataNumbers = ['1743', '882', '205', '125', '1383'];
    var landTypes = ['নাল', 'ভিটা', 'দালান', 'ধানি'];

    var randomKhata = khataNumbers[Math.floor(Math.random() * khataNumbers.length)];
    var randomLandType = landTypes[Math.floor(Math.random() * landTypes.length)];
    var randomArea = (Math.random() * 0.99 + 0.01).toFixed(4);
    var randomDag = Math.floor(Math.random() * 1899 + 100);
    var randomJl = Math.floor(Math.random() * 6) + 200;

    document.getElementById('khata_number').value = randomKhata;

    var firstDagEntry = document.querySelector('#dag-entries-container .dag-entry');
    if (firstDagEntry) {
      var dagNumInput = firstDagEntry.querySelector('[data-dag-field="dag_number"]');
      var landTypeInput = firstDagEntry.querySelector('[data-dag-field="land_type"]');
      if (dagNumInput) dagNumInput.value = randomDag;
      if (landTypeInput) landTypeInput.value = randomLandType;
    }
    document.getElementById('total_land_area').value = randomArea;
    document.getElementById('jl_number').value = randomJl;

    generateAppNumbers();

    var acre = parseFloat(randomArea);
    var totalSh = acre * 100;
    var bigha = Math.floor(totalSh / 33);
    var sotangsho = Math.floor(totalSh % 33);
    var landWords = '0 একর ' + bigha + ' শতক ' + sotangsho + ' অযুতাংশ 00 লক্ষাংশ';
    document.getElementById('total_land_words').value = landWords;      // ── Tax receipt random data ──
    // receipt_date and last_payment_year are NOT filled here —
    // they are derived from receipt_date_en by initBanglaDateAndPaymentYear()
    // (runs at 100ms via tax-calculator init) and autoFillTaxReceiptFromDate().
    var holdingNums = ['২০২৬-১০০০২০', '২০২৬-১০০০২১', '২০২৬-১০০০২২', '২০২৬-১০০০২৩'];
    var dakhilaSerials = ['২৬১৪২৬১২৬৬০১', '২৬১৪২৬১২৬৬০২', '২৬১৪২৬১২৬৬০৩', '২৬১৪২৬১২৬৬০৪'];
    var challanNums = ['২৫২৬-০০৫৭১১০৩৩২', '২৫২৬-০০৫৭১১০৩৩৩', '২৫২৬-০০৫৭১১০৩৩৪'];
    var amountWords = ['তিন শত সাঁইত্রিশ টাকা মাত্র', 'পাঁচ শত বাষট্টি টাকা মাত্র', 'দুই শত পনের টাকা মাত্র', 'চার শত তিরাশি টাকা মাত্র'];

    var idx = Math.floor(Math.random() * 4);
    var arrearsOver3 = (Math.floor(Math.random() * 200) + 50).toString();
    var arrearsLast3 = (Math.floor(Math.random() * 100) + 20).toString();
    var penalty = (Math.floor(Math.random() * 150) + 10).toString();
    var currentDemand = (Math.floor(Math.random() * 80) + 5).toString();
    var totalDemand = (parseInt(arrearsOver3) + parseInt(arrearsLast3) + parseInt(penalty) + parseInt(currentDemand)).toString();
    var totalCollected = totalDemand;
    var totalArrears = (parseInt(totalDemand) - parseInt(totalCollected)).toString();

    function setField(id, val) { var el = document.getElementById(id); if (el) el.value = val; }

    setField('holding_number', holdingNums[idx]);
    setField('dakhila_serial', dakhilaSerials[idx]);
    setField('challan_number', challanNums[idx % 3]);
    setField('total_amount_words', amountWords[idx]);
    setField('tax_arrears_over_3_years', arrearsOver3);
    setField('tax_arrears_last_3_years', arrearsLast3);
    setField('tax_penalty', penalty);
    setField('tax_current_demand', currentDemand);
    setField('tax_total_demand', totalDemand);
    setField('tax_total_collected', totalCollected);
    setField('tax_total_arrears', totalArrears);
    setField('tax_remarks', '');

    if (typeof runAll === 'function') runAll();
    if (typeof calcTaxTotals === 'function') setTimeout(calcTaxTotals, 50);
}

document.addEventListener('DOMContentLoaded', function () {
    // Initialize owner manager
    if (typeof initOwnerManager === 'function') {
      initOwnerManager();
    }

    // Dag toggle collapsible
    var dagContainer = document.getElementById('dag-entries-container');
    if (dagContainer) {
      dagContainer.addEventListener('click', function (e) {
        var toggleBtn = e.target.closest('.dag-toggle-btn');
        if (!toggleBtn) return;
        var entry = toggleBtn.closest('.dag-entry');
        if (!entry) return;
        var body = entry.querySelector('.dag-body');
        if (body) {
          body.classList.toggle('collapsed');
          toggleBtn.classList.toggle('collapsed');
        }
      });
    }

    // Auto-fill random data on page load
    fillRandomData();
});

// Refresh button handler
document.getElementById('refreshRandomBtn').addEventListener('click', fillRandomData);
</script>
{% endblock %}
