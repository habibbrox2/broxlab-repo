    var bnDates = ['৭ জ্যৈষ্ঠ ১৪৩৩', '১৫ আষাঢ় ১৪৩২', '২৩ বৈশাখ ১৪৩৩', '১০ শ্রাবণ ১৪৩২'];
    var enDates = ['২১ মে, ২০২৬', '২৯ জুন, ২০২৫', '৬ মে, ২০২৬', '২৬ জুলাই, ২০২৫'];
    var amountWords = ['তিন শত সাঁইত্রিশ টাকা মাত্র', 'পাঁচ শত বাষট্টি টাকা মাত্র', 'দুই শত পনের টাকা মাত্র', 'চার শত তিরাশি টাকা মাত্র'];
