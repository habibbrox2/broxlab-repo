 * Generate random Bengali numerals
 */
function toBnNum(num) {
    if (num === '' || num === null) return '';
    var bn = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
    return String(num).split('').map(function(c) {
        return c === '.' ? '.' : (c === '-' ? '-' : (bn[parseInt(c)] || c));
    }).join('');
}

/**
 * Generate a random date between 2022-2025 in dd-mm-yyyy format.
 */
function randomDate2022to2025() {
    var start = new Date(2022, 0, 1).getTime();
    var end = new Date(2025, 11, 31).getTime();
    var rand = new Date(start + Math.random() * (end - start));
    var d = ('0' + rand.getDate()).slice(-2);
    var m = ('0' + (rand.getMonth() + 1)).slice(-2);
    var y = rand.getFullYear();
    return { date: d, month: m, year: y, full: d + '-' + m + '-' + y };
}

/**
 * Auto-incrementing counter for generating sequential application numbers.
 * Resets to 1 on page load and increments with each call.
 */
var kharijSeqCounter = 1;

/**
 * Generate application numbers (frontend-only) for the kharij form.
 * Uses auto-incrementing counters for realistic DCR and mutation numbers.
 * Handles: application_no (numbers only), application_date (2022-2025),
 * mutation_case_no, and online_dcr_no.
 */
function generateAppNumbers() {
    var appDate = randomDate2022to2025();
    var yy = appDate.year.toString().slice(-2);
    var mm = appDate.month;
    var dd = appDate.date;

    // Use the shared counter for all sequence numbers
    var seq = kharijSeqCounter;
    kharijSeqCounter++;

    // Application number: numbers only — YYYYMMDD + 6-digit sequential
    var appSeq = ('34352323' + seq).slice(-6);
    var appNo = appDate.year + appDate.month + appDate.date + appSeq;

    // Online DCR number: DCRYYMMDD + 7-digit sequential
    var dcrSeq = ('5416544' + seq).slice(-7);
    var dcrNo = 'DCR' + yy + mm + dd + dcrSeq;

    // Mutation case number: group,NNN(IX-I)/YY-XX (derived from same counter)
    var mutGroup = Math.floor(seq / 1000);
    var mutRem = seq % 1000;
    var mutSub = seq % 100 || 1;
    var mutationCase = mutGroup + ',' + ('000' + mutRem).slice(-3) + '(IX-I)/' + yy + '-' + ('00' + mutSub).slice(-2);

    document.getElementById('application_no').value = appNo;
    document.getElementById('application_date').value = appDate.full;
    document.getElementById('mutation_case_no').value = mutationCase;
    document.getElementById('online_dcr_no').value = dcrNo;
}

