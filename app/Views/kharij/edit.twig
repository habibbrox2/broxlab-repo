{% extends 'admin/layout.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<style>
  .kharij-section-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 0.5rem;
    font-size: 0.875rem;
  }
  .kharij-field-group { position: relative; }
  .kharij-field-group .field-icon {
    position: absolute;
    left: 12px;
    top: 38px;
    color: #94a3b8;
    pointer-events: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }
  .kharij-field-group input:focus ~ .field-icon,
  .kharij-field-group textarea:focus ~ .field-icon,
  .kharij-field-group select:focus ~ .field-icon { color: #6366f1; }
  .kharij-field-group input,
  .kharij-field-group textarea,
  .kharij-field-group select { padding-left: 2.5rem; }
  .kharij-card { transition: box-shadow 0.2s, transform 0.2s; }
  .kharij-card:hover { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06); }
  .scroll-fade-in.visible { opacity: 1; transform: translateY(0); }
  .scroll-fade-in {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Land Calculator Panel */
  .land-calc-panel {
    display: none;
    margin-top: 12px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    background: #f8fafc;
  }
  .land-calc-panel.open {
    display: block;
  }
  .land-calc-panel .calc-header {
    background: #f1f5f9;
    padding: 10px 16px;
    font-weight: 600;
    font-size: 13px;
    border-bottom: 1px solid #e2e8f0;
    color: #334155;
  }
  .land-calc-panel .calc-body {
    padding: 14px 16px;
  }
  .calc-row {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .calc-row label {
    font-size: 12px;
    font-weight: 600;
    color: #475569;
    min-width: 60px;
  }
  .calc-input {
    flex: 1;
    min-width: 100px;
    padding: 8px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    font-size: 13px;
    outline: none;
    transition: border-color 0.2s;
  }
  .calc-input:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99,102,241,0.1);
  }
  .calc-select {
    padding: 8px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    font-size: 13px;
    background: white;
    outline: none;
    cursor: pointer;
  }
  .calc-btn {
    padding: 8px 16px;
    border: none;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .calc-btn-primary {
    background: #6366f1;
    color: white;
  }
  .calc-btn-primary:hover {
    background: #4f46e5;
  }
  .calc-btn-success {
    background: #10b981;
    color: white;
  }
  .calc-btn-success:hover {
    background: #059669;
  }
  .calc-result-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 16px;
    margin-top: 8px;
    padding: 10px;
    background: white;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
  }
  .calc-result-item {
    display: flex;
    justify-content: space-between;
    padding: 3px 0;
    font-size: 12px;
  }
  .calc-result-item span:first-child {
    color: #64748b;
  }
  .calc-result-item strong {
    color: #0f172a;
    font-weight: 700;
  }
  .calc-result-item.highlight {
    background: #ecfdf5;
    border-radius: 6px;
    padding: 3px 8px;
    margin: 0 -8px;
  }
  .calc-divider {
    border: 0;
    border-top: 1px dashed #d1d5db;
    margin: 10px 0;
  }

  /* Form Validation */
  .kharij-field-group .validation-error {
    display: none;
    font-size: 11px;
    color: #e11d48;
    margin-top: 4px;
    padding-left: 4px;
  }
  .kharij-field-group.invalid input,
  .kharij-field-group.invalid textarea,
  .kharij-field-group.invalid select {
    border-color: #e11d48;
    background-color: #fff1f2;
    box-shadow: 0 0 0 3px rgba(225,29,72,0.08);
  }
  .kharij-field-group.invalid .field-icon {
    color: #e11d48;
  }
  .kharij-field-group.invalid .validation-error {
    display: block;
  }
  .owner-entry.invalid {
    border-color: #e11d48 !important;
    box-shadow: 0 0 0 1px rgba(225,29,72,0.15);
  }
  .validation-summary {
    display: none;
    background: #fff1f2;
    border: 1px solid #fecdd3;
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: 12px;
    font-size: 13px;
    color: #be123c;
    font-weight: 600;
  }
  .validation-summary.visible {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .validation-summary svg {
    flex-shrink: 0;
  }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-4px); }
    40% { transform: translateX(4px); }
    60% { transform: translateX(-3px); }
    80% { transform: translateX(2px); }
  }
  .shake {
    animation: shake 0.4s ease-in-out;
  }
</style>
<div class="admin-page" data-admin-dir>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- Page Header -->
    <div class="scroll-fade-in" style="transition-delay: 0s;">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold tracking-tight text-slate-900">{{ title }}</h1>
          <p class="mt-1 text-sm text-slate-500">খতিয়ান নং: <strong>{{ data.khata_number|default('') }}</strong> — মালিক:
            {% if data.owners is defined and data.owners|length > 0 %}
              {{ data.owners[0].name|default('') }}{% if data.owners|length > 1 %} (+{{ (data.owners|length - 1) }} জন){% endif %}
            {% else %}
              {{ data.owner_name|default('') }}
            {% endif %}
          </p>
        </div>
        <span class="inline-flex items-center gap-2 rounded-full border border-indigo-100 bg-indigo-50 px-4 py-2 text-xs font-semibold text-indigo-700">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          রেকর্ড #{{ record.id }}
        </span>
      </div>
    </div>

    <form action="/admin/kharij/update/{{ record.id }}" method="POST" id="kharijForm" novalidate>
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="space-y-5">

        <!-- ১. মূল পরিচিতি ও অবস্থান -->
        <div class="scroll-fade-in kharij-card rounded-[1.5rem] border border-slate-200/80 bg-white shadow-sm overflow-hidden" style="transition-delay: 0.05s;">
          <div class="px-6 py-4 border-b border-slate-100 bg-gradient-to-r from-indigo-50/80 to-transparent">
            <div class="flex items-center gap-3">
              <div class="kharij-section-icon bg-indigo-100 text-indigo-600">📍</div>
              <div>
                <h5 class="text-base font-bold text-slate-900">মূল পরিচিতি ও অবস্থান</h5>
                <p class="text-xs text-slate-500 mt-0.5">জমির অবস্থান ও আনুষঙ্গিক তথ্য</p>
              </div>
            </div>
          </div>
          <div class="p-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
              <div class="kharij-field-group">
                <label for="khata_number" class="block text-sm font-semibold text-slate-700 mb-1.5">খতিয়ান নম্বর <span class="text-rose-500">*</span></label>
                <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="khata_number" id="khata_number" value="{{ data.khata_number|default('') }}" required placeholder="যেমন: ৮৮২">
                <span class="field-icon">#</span>
              </div>
              <div class="kharij-field-group">
                <label for="mouza" class="block text-sm font-semibold text-slate-700 mb-1.5">মৌজা <span class="text-rose-500">*</span></label>
                <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="mouza" id="mouza" value="{{ data.mouza|default('') }}" required placeholder="জমিটি যে মৌজায় অবস্থিত">
                <span class="field-icon">🏘</span>
              </div>
              <div class="kharij-field-group">
                <label for="jl_number" class="block text-sm font-semibold text-slate-700 mb-1.5">জে.এল. নম্বর</label>
                <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="jl_number" id="jl_number" value="{{ data.jl_number|default('') }}" placeholder="Jurisdiction List নম্বর">
                <span class="field-icon">📋</span>
              </div>
              <div class="kharij-field-group">
                <label for="upazila" class="block text-sm font-semibold text-slate-700 mb-1.5">উপজেলা/থানা <span class="text-rose-500">*</span></label>
                <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="upazila" id="upazila" value="{{ data.upazila|default('ধামরাই') }}" required placeholder="প্রশাসনিক উপজেলা">
                <span class="field-icon">🏛</span>
              </div>
              <div class="kharij-field-group">
                <label for="district" class="block text-sm font-semibold text-slate-700 mb-1.5">জেলা <span class="text-rose-500">*</span></label>
                <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="district" id="district" value="{{ data.district|default('ঢাকা') }}" required placeholder="জমির প্রশাসনিক জেলা">
                <span class="field-icon">🗺</span>
              </div>
            </div>
          </div>
        </div>

        <!-- ২. মালিক ও অংশীদারদের বিবরণ (ডায়নামিক মালিক ব্যবস্থা) -->
        <div class="scroll-fade-in kharij-card rounded-[1.5rem] border border-slate-200/80 bg-white shadow-sm overflow-hidden" style="transition-delay: 0.1s;">
          <div class="px-6 py-4 border-b border-slate-100 bg-gradient-to-r from-emerald-50/80 to-transparent">
            <div class="flex items-center gap-3">
              <div class="kharij-section-icon bg-emerald-100 text-emerald-600">👥</div>
              <div class="flex-1">
                <h5 class="text-base font-bold text-slate-900">মালিক ও অংশীদারদের বিবরণ</h5>
                <p class="text-xs text-slate-500 mt-0.5">একাধিক মালিক যোগ করতে "+ আরও মালিক" বাটন ব্যবহার করুন</p>
              </div>
              <span class="text-xs text-emerald-600 font-semibold bg-emerald-50 px-3 py-1 rounded-full" id="owner-count-badge">{% if data.owners is defined and data.owners|length > 0 %}{{ data.owners|length }} জন মালিক{% else %}১ জন মালিক{% endif %}</span>
            </div>
          </div>
          <div class="p-6" id="owners-container"
            {% if data.owners is defined and data.owners|length > 0 %}
            data-owners='{{ data.owners|json_encode|e("html_attr") }}'
            {% endif %}
          >
            <!-- Owners are injected here by JavaScript -->
          </div>
          <div class="px-6 pb-6 flex items-center gap-3">
            <button type="button" id="add-owner-btn" class="inline-flex items-center gap-2 rounded-xl border-2 border-dashed border-emerald-300 bg-emerald-50/50 px-5 py-3 text-sm font-semibold text-emerald-700 transition-all duration-200 hover:border-emerald-400 hover:bg-emerald-100/50 hover:text-emerald-800 active:scale-[0.97]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              আরও মালিক যোগ করুন
            </button>
          </div>
        </div>

        <!-- ৩. জমির সুনির্দিষ্ট বিবরণ -->
        <div class="scroll-fade-in kharij-card rounded-[1.5rem] border border-slate-200/80 bg-white shadow-sm overflow-hidden" style="transition-delay: 0.15s;">
          <div class="px-6 py-4 border-b border-slate-100 bg-gradient-to-r from-amber-50/80 to-transparent">
            <div class="flex items-center gap-3">
              <div class="kharij-section-icon bg-amber-100 text-amber-600">🌾</div>
              <div>
                <h5 class="text-base font-bold text-slate-900">জমির সুনির্দিষ্ট বিবরণ</h5>
                <p class="text-xs text-slate-500 mt-0.5">প্লট নম্বর, শ্রেণী ও জমির পরিমাণ সংক্রান্ত তথ্য</p>
              </div>
              <button type="button" id="toggle-land-calc" class="inline-flex items-center gap-1.5 rounded-lg border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-700 transition-all duration-200 hover:bg-amber-100 hover:border-amber-300 active:scale-[0.97]">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                ক্যালকুলেটর
              </button>
            </div>
          </div>
          <div class="p-6">

            <!-- Land Calculator Panel (hidden by default) -->
            <div class="land-calc-panel" id="land-calc-panel">
              <div class="calc-header">🧮 জমির ক্যালকুলেটর</div>
              <div class="calc-body">
                <div class="calc-row">
                  <label>রূপান্তর:</label>
                  <input type="number" step="any" class="calc-input" id="calc-input-value" placeholder="মান লিখুন">
                  <select class="calc-select" id="calc-input-unit">
                    <option value="acre">একর</option>
                    <option value="shottangsho" selected>শতাংশ</option>
                    <option value="sqft">বর্গফুট</option>
                  </select>
                  <button type="button" class="calc-btn calc-btn-primary" id="calc-convert-btn">→ রূপান্তর</button>
                </div>
                <div id="calc-results" class="calc-result-grid">
                  <div class="calc-result-item"><span>একর:</span><strong>—</strong></div>
                  <div class="calc-result-item"><span>শতাংশ:</span><strong>—</strong></div>
                  <div class="calc-result-item"><span>বর্গফুট:</span><strong>—</strong></div>
                  <div class="calc-result-item"><span>কাঠা (৭২০ বর্গফুট):</span><strong>—</strong></div>
                  <div class="calc-result-item"><span>বিঘা (৩৩ শতাংশ):</span><strong>—</strong></div>
                  <div class="calc-result-item"><span>হেক্টর:</span><strong>—</strong></div>
                </div>
                <hr class="calc-divider">
                <div class="calc-row">
                  <label>দ্রুত গণনা:</label>
                  <button type="button" class="calc-btn calc-btn-success" id="calc-auto-fill">স্বয়ংক্রিয় পূরণ</button>
                  <span style="font-size:11px;color:#94a3b8;">ফর্মের তথ্য অনুযায়ী জমির পরিমাণ স্বয়ংক্রিয়ভাবে গণনা করে</span>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
              <div class="kharij-field-group">
                <label for="dag_number" class="block text-sm font-semibold text-slate-700 mb-1.5">দাগ/প্লট নম্বর <span class="text-rose-500">*</span></label>
                <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="dag_number" id="dag_number" value="{{ data.dag_number|default('0') }}" required placeholder="মৌজা ম্যাপ অনুযায়ী প্লট নম্বর">
                <span class="field-icon">📍</span>
              </div>
              <div>
                <label for="land_type" class="block text-sm font-semibold text-slate-700 mb-1.5">জমির শ্রেণী</label>
                <div class="relative">
                  <select class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 appearance-none" name="land_type" id="land_type">
                    <option value="">-- নির্বাচন করুন --</option>
                    <option value="নাল" {{ data.land_type == 'নাল' ? 'selected' : '' }}>নাল</option>
                    <option value="ভিটা" {{ data.land_type == 'ভিটা' ? 'selected' : '' }}>ভিটা</option>
                    <option value="দালান" {{ data.land_type == 'দালান' ? 'selected' : '' }}>দালান</option>
                    <option value="ডোবা" {{ data.land_type == 'ডোবা' ? 'selected' : '' }}>ডোবা</option>
                    <option value="বাগান" {{ data.land_type == 'বাগান' ? 'selected' : '' }}>বাগান</option>
                    <option value="ধানি" {{ data.land_type == 'ধানি' ? 'selected' : '' }}>ধানি</option>
                    <option value="পুকুর" {{ data.land_type == 'পুকুর' ? 'selected' : '' }}>পুকুর</option>
                    <option value="অন্যান্য" {{ data.land_type == 'অন্যান্য' ? 'selected' : '' }}>অন্যান্য</option>
                  </select>
                  <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                  </span>
                </div>
              </div>
              <div class="kharij-field-group">
                <label for="total_land_area" class="block text-sm font-semibold text-slate-700 mb-1.5">মোট জমির পরিমাণ (একর) <span class="text-rose-500">*</span></label>
                <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="total_land_area" id="total_land_area" value="{{ data.total_land_area|default('0') }}" required placeholder="একর/শতক/হেক্টরে">
                <span class="field-icon">📐</span>
              </div>
              <div class="kharij-field-group">
                <label for="dag_area_shottangsho" class="block text-sm font-semibold text-slate-700 mb-1.5">মোট জমির পরিমাণ (শতাংশ)</label>
                <input type="text" class="block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition-all duration-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10" name="dag_area_shottangsho" id="dag_area_shottangsho" value="{{ data.dag_area_shottangsho|default('0') }}" placeholder="শতাংশে জমির পরিমাণ">
                <span class="field-icon">📏</span>
              </div>
              <div class="kharij-field-group">
