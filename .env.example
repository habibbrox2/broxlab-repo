# .env.example
# ============================================================================
# BroxLab Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# Do NOT commit .env to version control.
# ============================================================================

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=BroxLab
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
NODE_ENV=development
APP_DOMAIN=localhost
APP_TIMEZONE=Asia/Dhaka
MAINTENANCE_MODE=0

# ============================================================================
# DATABASE
# ============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=bb_

# ============================================================================
# REDIS / CACHE
# ============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_ENCRYPTION_KEY=
ENABLE_CACHE=1
CACHE_DRIVER=file
CACHE_LIFETIME=86400

# ============================================================================
# STORAGE / UPLOADS
# ============================================================================
STORAGE_CLEANUP_INTERVAL_SECONDS=21600
STORAGE_CACHE_RETENTION_DAYS=7
STORAGE_LOG_RETENTION_DAYS=30
STORAGE_TEMP_RETENTION_DAYS=1
STORAGE_TMP_RETENTION_DAYS=1
MAX_FILE_SIZE=52428800
MAX_IMAGE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,zip

# ============================================================================
# FIREBASE (Auth, Cloud Messaging, Firestore)
# ============================================================================
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN_LOCAL=your-project.firebaseapp.com
FIREBASE_AUTH_DOMAIN_LIVE=your-domain.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id
FIREBASE_SERVER_API_KEY=
FIREBASE_VAPID_KEY=your_vapid_key_here
FIREBASE_DATABASE_ENABLED=false
FIREBASE_DATABASE_URL=
FIREBASE_FIRESTORE_ENABLED=false
FIREBASE_FIRESTORE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=Config/broxlab-firebase.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PRIVATE_KEY=
FIREBASE_ID_TOKEN_LEEWAY=300

# ============================================================================
# MAIL (SMTP)
# ============================================================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=BroxLab

# ============================================================================
# SCRAPER / CRON (MedEx data collection pipeline)
# ============================================================================
SCRAPER_ENABLED=true
SCRAPER_SERVER_BASE_URL=https://your-scraper-domain.com
SCRAPER_PUSH_REQUIRE_AUTH=1
SCRAPER_PUSH_BEARER_TOKEN=
SCRAPER_PUSH_ALLOW_LEGACY_FALLBACK=0
SCRAPER_PUSH_LEGACY_FALLBACK_TOKEN=
SCRAPER_PUSH_MAX_JSON_BYTES=524288
SCRAPER_PIPELINE_CRON_TOKEN=your_cron_token_here
SCRAPER_PIPELINE_CRON_REQUIRE_AUTH=1
SCRAPER_PIPELINE_CRON_TIMEOUT=300

# ============================================================================
# AI SYSTEM
# ============================================================================
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FIREWORKS_API_KEY=
HUGGINGFACE_API_KEY=
KILO_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
AI_DEBUG_PAYLOAD=0
KB_AUTO_IMPROVE=true
ENABLE_RAG=true
ENABLE_STREAMING=false
ENABLE_CACHING=true
ENABLE_RETRY=true
ENABLE_FALLBACK=true
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=openrouter/auto
FRONTEND_MODEL=openrouter/gpt-4o
BACKEND_MODEL=openrouter/gpt-4o
MAX_TOKENS=4000
TEMPERATURE=0.7
OPENROUTER_PROXY_RATE_LIMIT=30
OPENROUTER_PROXY_RATE_WINDOW_SECONDS=60
OPENROUTER_PROXY_CACHE_TTL=30
FALLBACK_LOGGING=0
FALLBACK_MAX_RETRIES=3
FALLBACK_BASE_DELAY=1
FALLBACK_MAX_DELAY=10
FREE_API_ONLY=false
AGGRESSIVE_CACHING=false
FREE_MAX_TOKENS=500
FREE_TEMPERATURE=0.3
STREAM_LOGGING=0
MODEL_ROUTING_CONFIG=

# ============================================================================
# OCR SERVICE
# ============================================================================
OCR_SPACE_API_KEY=your_ocr_space_api_key_here
OCR_SERVICE_URL=http://localhost:3000
OCR_API_URL=http://localhost:3000

# ============================================================================
# WEATHER (OpenWeatherMap)
# ============================================================================
WEATHER_PROVIDER=mock
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_DEFAULT_CITY=Dhaka
WEATHER_DEFAULT_LAT=23.8103
WEATHER_DEFAULT_LON=90.4125

# ============================================================================
# THIRD-PARTY APIS (Media)
# ============================================================================
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# ============================================================================
# PAYMENT (bKash)
# ============================================================================
BKASH_MODE=
BKASH_APP_KEY=
BKASH_AUTH_TOKEN=

# ============================================================================
# SECURITY
# ============================================================================
JWT_SECRET=your_jwt_secret_here
CSRF_SECRET=your_csrf_secret_here
RATE_LIMIT_ENABLED=1
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
RATELIMIT_BYPASS_IPS=
API_ALLOW_ORIGIN=*

# ============================================================================
# PDF (mPDF)
# ============================================================================
MPDF_OUTPUT_MODE=inline
MPDF_TEMP_DIR=/path/to/your/storage/tmp

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=debug
LOG_CHANNEL=single
LOG_PATH=storage/logs/

# ============================================================================
# TWIG / HTMLPURIFIER
# ============================================================================
TWIG_CACHE_ENABLED=1
HTMLPURIFIER_CACHE_ENABLED=0

# ============================================================================
# SERVICE URLS
# ============================================================================
PHP_API_URL=http://localhost:80
ADMIN_API_URL=http://localhost:3000
WEBSOCKET_SERVER_URL=http://localhost:3000

# ============================================================================
# APP SETTINGS
# ============================================================================
AI_ENABLED=true
USE_DIRECT_SDK=true
LOAD_PROMPTS_FROM_FILES=true
USE_PHP_SETTINGS=true
CV_ENHANCEMENT_ENABLED=true
CV_AI_PROVIDER=auto
KB_QUALITY_THRESHOLD=50
KB_LOOKBACK_DAYS=30
