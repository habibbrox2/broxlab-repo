APP_NAME="BroxLab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local dev host. This repo's XAMPP vhost serves broxlab.local -> public/
# (and `php artisan serve` uses http://127.0.0.1:8000).
APP_URL=http://broxlab.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The app runs on MySQL (XAMPP locally, the shared cPanel host in production).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
# DB_CHARSET / DB_COLLATION / DB_PREFIX are optional; leave unset unless the
# shared host requires them.

# Session (Phase 7 review). database stores sessions in the shared `sessions` table.
# SESSION_SAME_SITE=lax by default.
#
# SESSION_SECURE_COOKIE MUST be false for plain-HTTP local dev
# (http://broxlab.local). With it true the browser silently drops the
# `broxlab-session` and `XSRF-TOKEN` cookies over HTTP, so no session survives
# and every POST -- the login form included -- fails with "419 Page Expired".
# Set it to true only on an HTTPS deployment.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax


BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Queue worker: for production, run `php artisan queue:work` as a persistent
# process and switch to redis/beanstalkd when the shared DB is no longer the
# queue backend. `database` requires the `jobs` table (queued jobs table).

# File cache works without requiring Laravel's optional `cache` table.
# Switch to redis when the shared host adds it.
CACHE_STORE=file
# CACHE_PREFIX — set to a unique value when multiple apps share the same DB/cache.

# Failed-job differentiation (Phase 7 queues).
QUEUE_FAILED_DRIVER=database-uuids

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Scraper cron pipeline — set a strong secret token and pass it via
# --token when invoking scripts/cron/scraper-runpipeline.php.
SCRAPER_PIPELINE_CRON_TOKEN=
