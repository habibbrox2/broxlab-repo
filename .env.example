# BroxLab environment template

# Application
APP_NAME=BroxLab
APP_ENV=development
NODE_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DOMAIN=localhost
APP_TIMEZONE=Asia/Dhaka
MAINTENANCE_MODE=0
HOST=0.0.0.0
PORT=3000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=broxlab
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=bb_

# Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
CACHE_DRIVER=file
CACHE_LIFETIME=86400
ENABLE_CACHE=1

# Single Node server
NODE_SERVICE_URL=http://localhost:3000
NODE_API_URL=http://localhost:3000
NODEJS_SERVER_URL=http://localhost:3000
NODEJS_AI_SERVER_URL=http://localhost:3000
OCR_SERVICE_URL=http://localhost:3000
OCR_API_URL=http://localhost:3000
ADMIN_API_URL=http://localhost:3000
WEBSOCKET_SERVER_URL=http://localhost:3000

# Security
JWT_SECRET=change-me
CSRF_SECRET=change-me
NODE_SERVICE_API_KEY=

# AI providers
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=https://api.ollama.ai/v1
FIREWORKS_API_KEY=
HUGGINGFACE_API_KEY=
KILO_API_KEY=
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=openrouter/auto
FRONTEND_MODEL=openrouter/gpt-4o
BACKEND_MODEL=openrouter/gpt-4o
MAX_TOKENS=4000
TEMPERATURE=0.7

# Rate limiting and logging
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
LOG_PRETTY=true
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# Feature flags
AI_ENABLED=true
USE_DIRECT_SDK=true
ENABLE_RAG=true
ENABLE_STREAMING=true
ENABLE_CACHING=true
ENABLE_RETRY=true
ENABLE_FALLBACK=true
KB_USE_NODEJS=true
KB_AUTO_IMPROVE=true
CV_ENHANCEMENT_ENABLED=true
CV_AI_PROVIDER=auto
SCRAPER_ENABLED=true
KB_QUALITY_THRESHOLD=50
KB_LOOKBACK_DAYS=30

# File / upload
MAX_FILE_SIZE=52428800
MAX_IMAGE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,zip

# OCR
OCR_SPACE_API_KEY=

# Optional app settings
PHP_API_URL=http://localhost:80
LOAD_PROMPTS_FROM_FILES=true
USE_PHP_SETTINGS=true
MPDF_OUTPUT_MODE=inline
LOG_PATH=storage/logs/
