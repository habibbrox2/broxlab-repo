# ============================================
# BroxLab Performance Optimization
# ============================================

# Enable RewriteEngine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
</IfModule>

# Default document
DirectoryIndex index.php index.html

# ============================================
# Browser Caching - Static Assets
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    
    # CSS files - cache for 1 year (immutable with versioned URLs)
    ExpiresByType text/css "access plus 1 year"
    
    # JavaScript files - cache for 1 year (immutable with versioned URLs)
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    
    # Images - cache for 1 year
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fonts - cache for 1 year
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # Audio/Video - cache for 1 year
    ExpiresByType audio/mpeg "access plus 1 year"
    ExpiresByType audio/ogg "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    
    # HTML - cache for 0 seconds (always check for updates)
    ExpiresByType text/html "access plus 0 seconds"
    
    # Default - cache for 1 month for unknown static assets
    ExpiresDefault "access plus 1 month"
</IfModule>

# ============================================
# Cache-Control Headers (Immutable for Versioned Assets)
# ============================================
<IfModule mod_headers.c>
    # Versioned assets (CSS, JS, images with ?v= in URL) can be cached immutably
    <FilesMatch "\.(css|js|mjs)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Images and fonts - also immutable with versioning
    <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML - no cache, must revalidate every time
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ============================================
# GZIP Compression
# ============================================
<IfModule mod_deflate.c>
    # Enable GZIP compression
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    
    # Exclude certain browsers
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# ============================================
# Security Headers
# ============================================
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # XSS Protection
    Header set X-XSS-Protection "1; mode=block"
    
    # MIME sniffing protection
    Header set X-Content-Type-Options "nosniff"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # Cross-Origin-Opener-Policy for Firebase Auth popups
    Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>

# ============================================
# Favicon Cache
# ============================================
<IfModule mod_alias.c>
    # Cache favicon for 1 year
    <FilesMatch "favicon\.ico$">
        <IfModule mod_expires.c>
            ExpiresActive On
            ExpiresByType image/x-icon "access plus 1 year"
        </IfModule>
    </FilesMatch>
</IfModule>

# ============================================
# Disable ETags (use Cache-Control instead)
# ============================================
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# ============================================
# Force IE to use latest rendering engine
# ============================================
<IfModule mod_headers.c>
    Header set X-UA-Compatible "IE=edge"
</IfModule>

# ============================================
# Trailing Slash Handling (Canonical URLs)
# ============================================
<IfModule mod_rewrite.c>
    # Remove trailing slashes (except for root and directories)
    # This ensures canonical URL consistency
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} /$
    RewriteRule ^(.+)/$ /$1 [R=301,L]
</IfModule>

# ============================================
# CDN & Routing
# ============================================
<IfModule mod_rewrite.c>
    # Rewrite /cdn/ to /assets/cdn/
    RewriteRule ^cdn/(.*)$ assets/cdn/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/cdn/

    # Redirect all non-file/non-directory requests to index.php
    RewriteRule . index.php [L,QSA]
</IfModule>

# ============================================
# Disable directory browsing
# ============================================
Options -Indexes

# ============================================
# Block access to sensitive files
# ============================================
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(env|git|md|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
