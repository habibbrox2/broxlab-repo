# ============================================
# BroxLab Performance Optimization
# ============================================

# Enable RewriteEngine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
</IfModule>

# ============================================
# Browser Caching - Static Assets
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    
    # CSS files - cache for 1 year
    ExpiresByType text/css "access plus 1 year"
    
    # JavaScript files - cache for 1 year
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    
    # Images - cache for 1 year
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fonts - cache for 1 year
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # Audio/Video - cache for 1 year
    ExpiresByType audio/mpeg "access plus 1 year"
    ExpiresByType audio/ogg "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    
    # HTML - cache for 0 seconds (always check for updates)
    ExpiresByType text/html "access plus 0 seconds"
    
    # Default - cache for 1 hour
    ExpiresDefault "access plus 1 hour"
</IfModule>

# ============================================
# GZIP Compression
# ============================================
<IfModule mod_deflate.c>
    # Enable GZIP compression
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    
    # Exclude certain browsers
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# ============================================
# Security Headers
# ============================================
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # XSS Protection
    Header set X-XSS-Protection "1; mode=block"
    
    # MIME sniffing protection
    Header set X-Content-Type-Options "nosniff"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ============================================
# Favicon Cache
# ============================================
<IfModule mod_alias.c>
    # Cache favicon for 1 year
    <FilesMatch "favicon\.ico$">
        <IfModule mod_expires.c>
            ExpiresActive On
            ExpiresByType image/x-icon "access plus 1 year"
        </IfModule>
    </FilesMatch>
</IfModule>

# ============================================
# Disable ETags (use Cache-Control instead)
# ============================================
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# ============================================
# Force IE to use latest rendering engine
# ============================================
<IfModule mod_headers.c>
    Header set X-UA-Compatible "IE=edge"
</IfModule>

# ============================================
# Serve precompressed assets if available
# ============================================
<IfModule mod_rewrite.c>
    # Rewrite /cdn/ to /assets/cdn/
    RewriteRule ^cdn/(.*)$ assets/cdn/$1 [L]
    
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteCond %{REQUEST_URI} !^/cdn/
    
    # Redirect to index.php for routing
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?/$1 [L,QSA]
</IfModule>

# ============================================
# Disable directory browsing
# ============================================
Options -Indexes

# ============================================
# Block access to sensitive files
# =========================================>
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(env|git|md|sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>
