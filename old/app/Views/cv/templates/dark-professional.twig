<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ cv.full_name|default('CV') }} - {{ cv.job_title|default('Professional') }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                    colors: { dark: { 900: '#0F172A', 800: '#1E293B', 700: '#334155', 600: '#475569' } }
                }
            }
        }
    </script>
    <style>
        @media print {
            @page { size: A4; margin: 0; }
            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="font-sans text-gray-300 bg-gray-200 min-h-screen">

<div class="max-w-[210mm] mx-auto bg-dark-900 shadow-2xl my-4 flex" style="min-height: 297mm;">
    <!-- START MAIN CONTENT -->
    <main class="flex-1 flex flex-col">
        <!-- Header -->
        <header class="bg-dark-800 px-10 pt-10 pb-8 border-b border-dark-700 relative">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-yellow-500 via-yellow-400 to-amber-600"></div>
            <div class="flex items-start gap-6">
                <div class="w-28 h-28 rounded-full bg-dark-700 border-2 border-yellow-500/30 flex items-center justify-center flex-shrink-0 overflow-hidden">
                    {% if cv.profile_photo %}
                    <img src="{{ cv.profile_photo }}" alt="{{ cv.full_name|default('Profile') }}" class="w-full h-full object-cover">
                    {% else %}
                    <svg class="w-16 h-16 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    {% endif %}
                </div>
                <div class="flex-1">
                    <h1 class="text-3xl font-bold text-white tracking-tight">{{ cv.full_name|default('Your Name') }}</h1>
                    <p class="text-lg text-yellow-400 font-semibold mt-1">{{ cv.job_title|default('Professional Title') }}</p>
                    <div class="flex flex-wrap gap-4 mt-3 text-sm text-gray-400">
                        {% if cv.linkedin %}
                        <a href="{{ cv.linkedin }}" class="flex items-center gap-1.5 hover:text-yellow-400 transition-colors" target="_blank">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h14m-.5 15.5v-5.3a3.26 3.26 0 00-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 011.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 001.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 00-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
                            LinkedIn
                        </a>
                        {% endif %}
                        {% if cv.github %}
                        <a href="{{ cv.github }}" class="flex items-center gap-1.5 hover:text-yellow-400 transition-colors" target="_blank">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                            GitHub
                        </a>
                        {% endif %}
                        {% if cv.portfolio %}
                        <a href="{{ cv.portfolio }}" class="flex items-center gap-1.5 hover:text-yellow-400 transition-colors" target="_blank">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
                            Portfolio
                        </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </header>

        <div class="flex-1 flex">
            <!-- Center Content -->
            <div class="flex-1 p-10">
                {% for section in sections %}
                {% if section.section_type == 'summary' and section.is_visible %}
                <!-- Summary -->
                <section class="mb-8">
                    <h2 class="text-sm font-bold text-yellow-400 uppercase tracking-widest mb-3 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        Professional Summary
                    </h2>
                    {% for item in section.items %}
                    <p class="text-gray-400 leading-relaxed text-sm border-l-2 border-yellow-500/40 pl-4">{{ item.content.summary|default(item.content.text|default('')) }}</p>
                    {% endfor %}
                </section>
                {% endif %}

                {% if section.section_type == 'experience' and section.is_visible %}
                <!-- Experience -->
                <section class="mb-8">
                    <h2 class="text-sm font-bold text-yellow-400 uppercase tracking-widest mb-4 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.93 23.93 0 0112 21c-2.89 0-5.6-.936-7.74-2.55M9 6.75V3m6 3.75V3m-9 9.75h10.5a2.25 2.25 0 012.25 2.25v1.5A2.25 2.25 0 0117.25 19.5H6.75A2.25 2.25 0 014.5 17.25v-1.5a2.25 2.25 0 012.25-2.25z"/></svg>
                        Work Experience
                    </h2>
                    {% for item in section.items %}
                    <!-- START EXPERIENCE -->
                    <div class="mb-5 relative">
                        <div class="flex gap-4">
                            <div class="flex flex-col items-center">
                                <div class="w-3 h-3 bg-yellow-500 rounded-full flex-shrink-0 mt-1.5"></div>
                                {% if not loop.last %}<div class="w-0.5 h-full bg-dark-700 mt-1"></div>{% endif %}
                            </div>
                            <div class="flex-1 pb-5">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <h3 class="font-bold text-white">{{ item.content.position|default('Position') }}</h3>
                                        <p class="text-yellow-400 font-medium text-sm">{{ item.content.company|default('') }}</p>
                                    </div>
                                    <span class="text-xs text-gray-500 font-medium px-2 py-1 bg-dark-800 rounded">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                                </div>
                                <p class="text-sm text-gray-400 leading-relaxed mt-2">{{ item.content.description|default('') }}</p>
                            </div>
                        </div>
                    </div>
                    <!-- END EXPERIENCE -->
                    {% endfor %}
                </section>
                {% endif %}

                {% if section.section_type == 'education' and section.is_visible %}
                <!-- Education -->
                <section class="mb-8">
                    <h2 class="text-sm font-bold text-yellow-400 uppercase tracking-widest mb-4 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.408a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.184 12.083 12.083 0 01.665-6.479L12 14z"/></svg>
                        Education
                    </h2>
                    {% for item in section.items %}
                    <!-- START EDUCATION -->
                    <div class="bg-dark-800 rounded-lg p-4 border border-dark-700 mb-3">
                        <div class="flex justify-between items-start">
                            <div>
                                <h3 class="font-bold text-white">{{ item.content.degree|default('Degree') }}</h3>
                                <p class="text-gray-400 text-sm">{{ item.content.institution|default('') }}</p>
                            </div>
                            <span class="text-xs text-gray-500 font-medium">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                        </div>
                        {% if item.content.gpa or item.content.field %}
                        <p class="text-sm text-gray-500 mt-1">{{ item.content.field ? ('Focus: ' ~ item.content.field) : '' }}{% if item.content.gpa and item.content.field %} | {% endif %}{% if item.content.gpa %}GPA: {{ item.content.gpa }}{% endif %}</p>
                        {% endif %}
                    </div>
                    <!-- END EDUCATION -->
                    {% endfor %}
                </section>
                {% endif %}

                {% if section.section_type == 'projects' and section.is_visible %}
                <!-- Projects -->
                <section class="mb-8">
                    <h2 class="text-sm font-bold text-yellow-400 uppercase tracking-widest mb-4 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>
                        Key Projects
                    </h2>
                    <!-- START PROJECTS -->
                    <div class="grid grid-cols-2 gap-3">
                        {% for item in section.items %}
                        <div class="bg-dark-800 rounded-lg p-3 border border-dark-700">
                            <h4 class="font-bold text-sm text-white">{{ item.content.name|default('Project') }}</h4>
                            <p class="text-xs text-gray-400 mt-1">{{ item.content.description|default('') }}</p>
                            {% if item.content.technologies %}
                            <span class="text-xs text-yellow-400 font-semibold mt-2 inline-block">{{ item.content.technologies }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                    <!-- END PROJECTS -->
                </section>
                {% endif %}

                {% if section.section_type == 'certifications' and section.is_visible %}
                <!-- Certificates -->
                <section class="mb-8">
                    <h2 class="text-sm font-bold text-yellow-400 uppercase tracking-widest mb-4 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                        Certificates
                    </h2>
                    <!-- START CERTIFICATES -->
                    <div class="space-y-2">
                        {% for item in section.items %}
                        <div class="bg-dark-800 rounded-lg p-3 border border-dark-700">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h4 class="font-bold text-sm text-white">{{ item.content.name|default('Certificate') }}</h4>
                                    {% if item.content.organization %}<p class="text-xs text-gray-400">{{ item.content.organization }}{% if item.content.date %} | {{ item.content.date }}{% endif %}</p>{% endif %}
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    <!-- END CERTIFICATES -->
                </section>
                {% endif %}
                {% endfor %}
            </div>

            <!-- START SIDEBAR -->
            <aside class="w-[260px] flex-shrink-0 bg-dark-800 border-l border-dark-700 p-6">
                <!-- Contact -->
                <div class="mb-8">
                    <h3 class="text-xs font-bold text-yellow-400 uppercase tracking-widest mb-4">Contact</h3>
                    <div class="space-y-3 text-sm">
                        {% if cv.email %}
                        <div class="flex items-start gap-2.5">
                            <svg class="w-4 h-4 text-gray-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            <span class="text-gray-400 break-all text-xs">{{ cv.email }}</span>
                        </div>
                        {% endif %}
                        {% if cv.phone %}
                        <div class="flex items-start gap-2.5">
                            <svg class="w-4 h-4 text-gray-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                            <span class="text-gray-400 text-xs">{{ cv.phone }}</span>
                        </div>
                        {% endif %}
                        {% if cv.location %}
                        <div class="flex items-start gap-2.5">
                            <svg class="w-4 h-4 text-gray-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243A8 8 0 1117.657 16.657z"/><circle cx="12" cy="11" r="1.5" fill="currentColor"/></svg>
                            <span class="text-gray-400 text-xs">{{ cv.location }}</span>
                        </div>
                        {% endif %}
                        {% if cv.website %}
                        <div class="flex items-start gap-2.5">
                            <svg class="w-4 h-4 text-gray-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
                            <span class="text-gray-400 text-xs">{{ cv.website }}</span>
                        </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Technical Skills -->
                {% set techSkills = [] %}
                {% for section in sections %}
                    {% if section.section_type == 'skills' %}
                        {% for item in section.items %}
                            {% set techSkills = techSkills|merge([item.content.name]) %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}
                {% if techSkills|length > 0 %}
                <div class="mb-8">
                    <h3 class="text-xs font-bold text-yellow-400 uppercase tracking-widest mb-4">Technical Skills</h3>
                    <div class="space-y-3">
                        {% for skill in techSkills|slice(0, 6) %}
                        <div>
                            <div class="flex justify-between text-xs mb-1"><span class="text-gray-300">{{ skill }}</span><span class="text-yellow-400">{{ 100 - (loop.index0 * 6) }}%</span></div>
                            <div class="h-1.5 bg-dark-900 rounded-full"><div class="h-1.5 bg-yellow-500 rounded-full" style="width:{{ 100 - (loop.index0 * 6) }}%"></div></div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                <!-- Soft Skills -->
                {% set softSkills = [] %}
                {% for section in sections %}
                    {% if section.section_type == 'soft_skills' %}
                        {% for item in section.items %}
                            {% set softSkills = softSkills|merge([item.content.name]) %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}
                {% if softSkills|length > 0 %}
                <div class="mb-8">
                    <h3 class="text-xs font-bold text-yellow-400 uppercase tracking-widest mb-4">Soft Skills</h3>
                    <div class="flex flex-wrap gap-2">
                        {% for skill in softSkills %}
                        <span class="px-2.5 py-1 bg-dark-900 text-gray-300 rounded text-xs border border-dark-700">{{ skill }}</span>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                <!-- Languages -->
                {% set langSection = sections|filter(s => s.section_type == 'languages')|first %}
                {% if langSection and langSection.items|length > 0 %}
                <div class="mb-8">
                    <h3 class="text-xs font-bold text-yellow-400 uppercase tracking-widest mb-4">Languages</h3>
                    <div class="space-y-2 text-sm">
                        {% for item in langSection.items %}
                        <div class="flex justify-between"><span class="text-gray-300">{{ item.content.name|default('') }}</span><span class="text-gray-500 text-xs">{{ item.content.proficiency|default('Fluent') }}</span></div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </aside>
            <!-- END SIDEBAR -->
        </div>
    </main>
</div>

</body>
</html>
