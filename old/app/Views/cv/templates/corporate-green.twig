<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ cv.full_name|default('CV') }} - {{ cv.job_title|default('Professional') }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Source Sans 3', 'system-ui', 'sans-serif'], serif: ['Playfair Display', 'Georgia', 'serif'] },
                    colors: { corporate: { 500: '#059669', 600: '#047857', 700: '#065F46', 800: '#064E3B' } }
                }
            }
        }
    </script>
    <style>
        @media print { @page { size: A4; margin: 0; } body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } .no-print { display: none !important; } }
        .corporate-bg { background: linear-gradient(135deg, #059669 0%, #047857 100%); }
    </style>
</head>
<body class="font-sans text-gray-800 bg-gray-100 min-h-screen">

<div class="max-w-[210mm] mx-auto bg-white shadow-2xl my-4 flex" style="min-height: 297mm;">
    <!-- START SIDEBAR -->
    <aside class="w-[260px] flex-shrink-0 corporate-bg text-white flex flex-col">
        <div class="p-8 pt-12">
            <div class="w-28 h-28 rounded-full bg-white/20 border-2 border-white/30 flex items-center justify-center mx-auto mb-6 overflow-hidden">
                {% if cv.profile_photo %}
                <img src="{{ cv.profile_photo }}" alt="{{ cv.full_name|default('Profile') }}" class="w-full h-full object-cover">
                {% else %}
                <svg class="w-16 h-16 text-white/90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                {% endif %}
            </div>
            <h1 class="text-2xl font-serif font-bold text-center">{{ cv.full_name|default('Your Name') }}</h1>
            <p class="text-center text-white/80 text-sm mt-1">{{ cv.job_title|default('Professional Title') }}</p>
        </div>

        <div class="px-6 pb-6 flex-1">
            <h3 class="text-xs font-bold uppercase tracking-wider mb-4 opacity-80 border-b border-white/20 pb-2">Contact</h3>
            <div class="space-y-3 text-sm">
                {% if cv.email %}
                <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    <span class="break-all text-xs">{{ cv.email }}</span>
                </div>
                {% endif %}
                {% if cv.phone %}
                <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    <span class="text-xs">{{ cv.phone }}</span>
                </div>
                {% endif %}
                {% if cv.location %}
                <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243A8 8 0 1117.657 16.657z"/><circle cx="12" cy="11" r="1.5" fill="currentColor"/></svg>
                    <span class="text-xs">{{ cv.location }}</span>
                </div>
                {% endif %}
                {% if cv.website %}
                <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
                    <span class="text-xs">{{ cv.website }}</span>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Skills -->
        {% set techSkills = [] %}
        {% for section in sections %}
            {% if section.section_type == 'skills' %}
                {% for item in section.items %}
                    {% set techSkills = techSkills|merge([item.content.name]) %}
                {% endfor %}
            {% endif %}
        {% endfor %}
        {% if techSkills|length > 0 %}
        <div class="px-6 pb-6">
            <h3 class="text-xs font-bold uppercase tracking-wider mb-4 opacity-80 border-b border-white/20 pb-2">Skills</h3>
            <div class="space-y-2.5">
                {% for skill in techSkills|slice(0, 6) %}
                <div><div class="flex justify-between text-xs mb-1"><span>{{ skill }}</span><span>{{ 100 - (loop.index0 * 6) }}%</span></div><div class="h-1.5 bg-white/20 rounded-full"><div class="h-1.5 bg-white rounded-full" style="width:{{ 100 - (loop.index0 * 6) }}%"></div></div></div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <!-- Languages -->
        {% set langSection = sections|filter(s => s.section_type == 'languages')|first %}
        {% if langSection and langSection.items|length > 0 %}
        <div class="px-6 pb-6">
            <h3 class="text-xs font-bold uppercase tracking-wider mb-4 opacity-80 border-b border-white/20 pb-2">Languages</h3>
            <div class="space-y-2 text-sm">
                {% for item in langSection.items %}
                <div class="flex justify-between"><span>{{ item.content.name|default('') }}</span><span class="text-white/70">{{ item.content.proficiency|default('Fluent') }}</span></div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <!-- Interests -->
        <div class="px-6 pb-6">
            <h3 class="text-xs font-bold uppercase tracking-wider mb-4 opacity-80 border-b border-white/20 pb-2">Interests</h3>
            <div class="flex flex-wrap gap-2">
                <span class="px-2.5 py-1 bg-white/15 rounded-full text-xs">Open Source</span>
                <span class="px-2.5 py-1 bg-white/15 rounded-full text-xs">AI/ML</span>
                <span class="px-2.5 py-1 bg-white/15 rounded-full text-xs">Photography</span>
            </div>
        </div>
    </aside>
    <!-- END SIDEBAR -->

    <!-- START MAIN CONTENT -->
    <main class="flex-1 p-10">
        <header class="mb-8">
            <h1 class="text-3xl font-serif font-bold text-gray-900">{{ cv.full_name|default('Your Name') }}</h1>
            <p class="text-lg text-corporate-600 font-medium mt-1">{{ cv.job_title|default('Professional Title') }}</p>
            <div class="h-1 w-20 bg-corporate-500 mt-4"></div>
        </header>

        {% for section in sections %}
        {% if section.section_type == 'summary' and section.is_visible %}
        <section class="mb-8">
            <h2 class="text-sm font-bold text-corporate-700 uppercase tracking-wider mb-3 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                Professional Summary
            </h2>
            {% for item in section.items %}
            <p class="text-sm text-gray-600 leading-relaxed border-l-4 border-corporate-500 pl-4">{{ item.content.summary|default(item.content.text|default('')) }}</p>
            {% endfor %}
        </section>
        {% endif %}

        {% if section.section_type == 'experience' and section.is_visible %}
        <!-- Experience -->
        <section class="mb-8">
            <h2 class="text-sm font-bold text-corporate-700 uppercase tracking-wider mb-4 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.93 23.93 0 0112 21c-2.89 0-5.6-.936-7.74-2.55M9 6.75V3m6 3.75V3m-9 9.75h10.5a2.25 2.25 0 012.25 2.25v1.5A2.25 2.25 0 0117.25 19.5H6.75A2.25 2.25 0 014.5 17.25v-1.5a2.25 2.25 0 012.25-2.25z"/></svg>
                Work Experience
            </h2>
            {% for item in section.items %}
            <!-- START EXPERIENCE -->
            <div class="mb-5 relative pl-6 border-l-2 border-corporate-500/30">
                <div class="absolute -left-[7px] top-1.5 w-3.5 h-3.5 bg-corporate-500 rounded-full border-2 border-white"></div>
                <div class="flex justify-between items-start mb-1">
                    <div>
                        <h3 class="font-bold text-gray-900">{{ item.content.position|default('Position') }}</h3>
                        <p class="text-corporate-600 font-semibold text-sm">{{ item.content.company|default('') }}</p>
                    </div>
                    <span class="text-xs text-gray-500 font-medium">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                </div>
                <p class="text-sm text-gray-600 leading-relaxed mt-2">{{ item.content.description|default('') }}</p>
            </div>
            <!-- END EXPERIENCE -->
            {% endfor %}
        </section>
        {% endif %}

        {% if section.section_type == 'education' and section.is_visible %}
        <!-- Education -->
        <section class="mb-8">
            <h2 class="text-sm font-bold text-corporate-700 uppercase tracking-wider mb-4 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.408a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.184 12.083 12.083 0 01.665-6.479L12 14z"/></svg>
                Education
            </h2>
            {% for item in section.items %}
            <!-- START EDUCATION -->
            <div class="mb-4 bg-corporate-500/5 rounded-lg p-4 border-l-4 border-corporate-500">
                <div class="flex justify-between items-start">
                    <div>
                        <h3 class="font-bold text-gray-900">{{ item.content.degree|default('Degree') }}</h3>
                        <p class="text-gray-600 text-sm">{{ item.content.institution|default('') }}</p>
                    </div>
                    <span class="text-xs text-gray-500 font-medium">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                </div>
                {% if item.content.gpa or item.content.field %}
                <p class="text-sm text-gray-500 mt-1">{{ item.content.field ? ('Focus: ' ~ item.content.field) : '' }}{% if item.content.gpa and item.content.field %} | {% endif %}{% if item.content.gpa %}GPA: {{ item.content.gpa }}{% endif %}</p>
                {% endif %}
            </div>
            <!-- END EDUCATION -->
            {% endfor %}
        </section>
        {% endif %}

        {% if section.section_type == 'projects' and section.is_visible %}
        <!-- Projects -->
        <section class="mb-8">
            <h2 class="text-sm font-bold text-corporate-700 uppercase tracking-wider mb-4 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>
                Key Projects
            </h2>
            <!-- START PROJECTS -->
            <div class="grid grid-cols-2 gap-3">
                {% for item in section.items %}
                <div class="border border-corporate-500/20 rounded-lg p-3">
                    <h4 class="font-bold text-sm text-gray-900">{{ item.content.name|default('Project') }}</h4>
                    <p class="text-xs text-gray-500 mt-1">{{ item.content.description|default('') }}</p>
                    {% if item.content.technologies %}
                    <span class="text-xs text-corporate-600 font-semibold mt-2 inline-block">{{ item.content.technologies }}</span>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            <!-- END PROJECTS -->
        </section>
        {% endif %}

        {% if section.section_type == 'certifications' and section.is_visible %}
        <!-- Certificates -->
        <section class="mb-8">
            <h2 class="text-sm font-bold text-corporate-700 uppercase tracking-wider mb-4 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                Certificates
            </h2>
            <!-- START CERTIFICATES -->
            <div class="space-y-2">
                {% for item in section.items %}
                <div class="border border-corporate-500/20 rounded-lg p-3 bg-corporate-500/5">
                    <div class="flex justify-between items-start">
                        <div>
                            <h4 class="font-bold text-sm text-gray-900">{{ item.content.name|default('Certificate') }}</h4>
                            {% if item.content.organization %}<p class="text-xs text-gray-500">{{ item.content.organization }}{% if item.content.date %} | {{ item.content.date }}{% endif %}</p>{% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            <!-- END CERTIFICATES -->
        </section>
        {% endif %}
        {% endfor %}

        <footer class="mt-auto pt-6 border-t border-gray-100 text-xs text-gray-400 flex justify-between items-center no-print">
            <span>Reference available upon request</span>
            <span>{{ cv.full_name|default('Applicant') }}{% if cv.email %} | {{ cv.email }}{% endif %}</span>
        </footer>
    </main>
</div>

</body>
</html>
