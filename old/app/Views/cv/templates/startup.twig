<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ cv.full_name|default('CV') }} - {{ cv.job_title|default('Professional') }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'], display: ['Space Grotesk', 'sans-serif'] },
                    colors: { startup: { 400: '#F97316', 500: '#EA580C', 600: '#C2410C', 50: '#FFF7ED' } }
                }
            }
        }
    </script>
    <style>
        @media print { @page { size: A4; margin: 0; } body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } .no-print { display: none !important; } }
    </style>
</head>
<body class="font-sans text-gray-800 bg-gray-100 min-h-screen">

<div class="max-w-[210mm] mx-auto bg-white shadow-xl my-4" style="min-height: 297mm;">
    <!-- Startup Header -->
    <header class="bg-startup-500 text-white px-10 py-8 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -mr-16 -mt-16"></div>
        <div class="relative flex items-center justify-between">
            <div>
                <div class="inline-block px-3 py-1 bg-white/20 rounded-full text-xs font-medium mb-3 backdrop-blur-sm">Open to Opportunities</div>
                <h1 class="text-3xl font-display font-bold tracking-tight">{{ cv.full_name|default('Your Name') }}</h1>
                <p class="text-white/90 mt-1 font-medium">{{ cv.job_title|default('Professional Title') }}</p>
            </div>
            <div class="text-right text-sm text-white/80 hidden sm:block">
                {% if cv.location %}<p>{{ cv.location }}</p>{% endif %}
                {% if cv.email %}<p>{{ cv.email }}</p>{% endif %}
            </div>
        </div>
    </header>

    <div class="flex">
        <!-- START SIDEBAR -->
        <aside class="w-[240px] flex-shrink-0 bg-gray-50 p-6 border-r border-gray-100">
            <div class="text-center mb-6">
                <div class="w-20 h-20 rounded-full bg-startup-100 mx-auto mb-3 flex items-center justify-center overflow-hidden">
                    {% if cv.profile_photo %}
                    <img src="{{ cv.profile_photo }}" alt="{{ cv.full_name|default('Profile') }}" class="w-full h-full object-cover">
                    {% else %}
                    <svg class="w-12 h-12 text-startup-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    {% endif %}
                </div>
            </div>

            <div class="mb-6">
                <h3 class="text-xs font-bold text-startup-600 uppercase tracking-widest mb-3 font-display">Contact</h3>
                <div class="space-y-2.5 text-xs text-gray-600">
                    {% if cv.email %}
                    <div class="flex items-start gap-2">
                        <svg class="w-3.5 h-3.5 text-startup-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        <span class="break-all">{{ cv.email }}</span>
                    </div>
                    {% endif %}
                    {% if cv.phone %}
                    <div class="flex items-start gap-2">
                        <svg class="w-3.5 h-3.5 text-startup-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                        <span>{{ cv.phone }}</span>
                    </div>
                    {% endif %}
                    {% if cv.location %}
                    <div class="flex items-start gap-2">
                        <svg class="w-3.5 h-3.5 text-startup-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243A8 8 0 1117.657 16.657z"/><circle cx="12" cy="11" r="1.5" fill="currentColor"/></svg>
                        <span>{{ cv.location }}</span>
                    </div>
                    {% endif %}
                </div>
            </div>

            {% set techSkills = [] %}
            {% for section in sections %}
                {% if section.section_type == 'skills' %}
                    {% for item in section.items %}
                        {% set techSkills = techSkills|merge([item.content.name]) %}
                    {% endfor %}
                {% endif %}
            {% endfor %}
            {% if techSkills|length > 0 %}
            <div class="mb-6">
                <h3 class="text-xs font-bold text-startup-600 uppercase tracking-widest mb-3 font-display">Skills</h3>
                <div class="space-y-2">
                    {% for skill in techSkills|slice(0, 6) %}
                    <div class="flex items-center gap-2">
                        <div class="flex-1 h-2 bg-gray-200 rounded-full"><div class="h-2 bg-startup-500 rounded-full" style="width:{{ 100 - (loop.index0 * 6) }}%"></div></div>
                        <span class="text-xs text-gray-600 w-8">{{ 100 - (loop.index0 * 6) }}%</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% set langSection = sections|filter(s => s.section_type == 'languages')|first %}
            {% if langSection and langSection.items|length > 0 %}
            <div class="mb-6">
                <h3 class="text-xs font-bold text-startup-600 uppercase tracking-widest mb-3 font-display">Languages</h3>
                <div class="space-y-1.5 text-xs text-gray-600">
                    {% for item in langSection.items %}
                    <div class="flex justify-between"><span>{{ item.content.name|default('') }}</span><span class="text-startup-600 font-medium">{{ item.content.proficiency|default('Fluent') }}</span></div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
            <!-- END SIDEBAR -->
        </aside>

        <!-- START MAIN CONTENT -->
        <main class="flex-1 p-8">
            {% for section in sections %}
            {% if section.section_type == 'summary' and section.is_visible %}
            <section class="mb-6">
                <h2 class="text-xs font-bold text-startup-600 uppercase tracking-widest mb-2 font-display">Professional Summary</h2>
                {% for item in section.items %}
                <p class="text-sm text-gray-600 leading-relaxed">{{ item.content.summary|default(item.content.text|default('')) }}</p>
                {% endfor %}
            </section>
            {% endif %}

            {% if section.section_type == 'experience' and section.is_visible %}
            <section class="mb-6">
                <h2 class="text-xs font-bold text-startup-600 uppercase tracking-widest mb-3 font-display">Work Experience</h2>
                {% for item in section.items %}
                <!-- START EXPERIENCE -->
                <div class="mb-4 bg-startup-50 rounded-lg p-4 border border-startup-100">
                    <div class="flex justify-between items-start mb-1">
                        <div>
                            <h3 class="font-bold text-gray-900 font-display">{{ item.content.position|default('Position') }}</h3>
                            <p class="text-sm text-startup-600 font-medium">{{ item.content.company|default('') }}</p>
                        </div>
                        <span class="text-xs text-gray-500 font-medium whitespace-nowrap">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                    </div>
                    <p class="text-sm text-gray-600 mt-2 leading-relaxed">{{ item.content.description|default('') }}</p>
                </div>
                <!-- END EXPERIENCE -->
                {% endfor %}
            </section>
            {% endif %}

            {% if section.section_type == 'education' and section.is_visible %}
            <section class="mb-6">
                <h2 class="text-xs font-bold text-startup-600 uppercase tracking-widest mb-3 font-display">Education</h2>
                {% for item in section.items %}
                <!-- START EDUCATION -->
                <div class="mb-3 flex justify-between items-baseline">
                    <div>
                        <h3 class="font-bold text-gray-900 font-display">{{ item.content.degree|default('Degree') }}</h3>
                        <p class="text-sm text-gray-600">{{ item.content.institution|default('') }}</p>
                    </div>
                    <span class="text-xs text-gray-500 font-medium">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                </div>
                <!-- END EDUCATION -->
                {% endfor %}
            </section>
            {% endif %}

            {% if section.section_type == 'projects' and section.is_visible %}
            <section class="mb-6">
                <h2 class="text-xs font-bold text-startup-600 uppercase tracking-widest mb-3 font-display">Projects</h2>
                <!-- START PROJECTS -->
                <div class="grid grid-cols-2 gap-3">
                    {% for item in section.items %}
                    <div class="bg-startup-50 rounded-lg p-3 border border-startup-100">
                        <h4 class="font-bold text-sm text-gray-900 font-display">{{ item.content.name|default('Project') }}</h4>
                        <p class="text-xs text-gray-500 mt-0.5">{{ item.content.description|default('') }}</p>
                        {% if item.content.technologies %}
                        <span class="text-xs text-startup-600 font-semibold mt-1 inline-block">{{ item.content.technologies }}</span>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                <!-- END PROJECTS -->
            </section>
            {% endif %}

            {% if section.section_type == 'certifications' and section.is_visible %}
            <section class="mb-6">
                <h2 class="text-xs font-bold text-startup-600 uppercase tracking-widest mb-3 font-display">Certificates</h2>
                <!-- START CERTIFICATES -->
                <div class="space-y-2">
                    {% for item in section.items %}
                    <div class="bg-startup-50 rounded-lg p-3 border border-startup-100">
                        <div class="flex justify-between items-start">
                            <div>
                                <h4 class="font-bold text-sm text-gray-900 font-display">{{ item.content.name|default('Certificate') }}</h4>
                                {% if item.content.organization %}<p class="text-xs text-gray-500">{{ item.content.organization }}{% if item.content.date %} | {{ item.content.date }}{% endif %}</p>{% endif %}
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                <!-- END CERTIFICATES -->
            </section>
            {% endif %}
            {% endfor %}

            <footer class="mt-6 pt-4 border-t border-gray-100 text-xs text-gray-400 flex justify-between items-center no-print">
                <span>Reference available upon request</span>
                <span>{{ cv.full_name|default('Applicant') }}{% if cv.email %} | {{ cv.email }}{% endif %}</span>
            </footer>
        </main>
    </div>
</div>

</body>
</html>
