<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ cv.full_name|default('CV') }} - {{ cv.job_title|default('Professional') }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>tailwind.config={theme:{extend:{fontFamily:{sans:['Inter','system-ui','sans-serif']},colors:{nordic:{50:'#F8FAFC',100:'#F1F5F9',200:'#E2E8F0',800:'#1E293B',900:'#0F172A'}}}}}</script>
    <style>
        @media print { @page { size: A4; margin: 0; } body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } .no-print { display: none !important; } }
        .nordic-pattern { background-color: #F8FAFC; background-image: radial-gradient(#CBD5E1 1px, transparent 1px); background-size: 20px 20px; }
    </style>
</head>
<body class="font-sans text-gray-800 min-h-screen">

<div class="max-w-[210mm] mx-auto bg-white shadow-xl my-4" style="min-height: 297mm;">
    <!-- Nordic Top Banner -->
    <div class="bg-nordic-900 text-white px-10 py-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight">{{ cv.full_name|default('Your Name') }}</h1>
            <p class="text-nordic-200 text-sm mt-0.5">{{ cv.job_title|default('Professional Title') }}</p>
        </div>
        <div class="text-right text-xs text-nordic-300">
            {% if cv.location %}<p>{{ cv.location }}</p>{% endif %}
            {% if cv.email %}<p>{{ cv.email }}</p>{% endif %}
        </div>
    </div>

    <div class="flex">
        <!-- START SIDEBAR -->
        <aside class="w-[220px] flex-shrink-0 bg-nordic-50 p-6 border-r border-nordic-200">
            <div class="text-center mb-6">
                <div class="w-24 h-24 rounded-full bg-nordic-200 mx-auto mb-3 flex items-center justify-center overflow-hidden">
                    {% if cv.profile_photo %}
                    <img src="{{ cv.profile_photo }}" alt="{{ cv.full_name|default('Profile') }}" class="w-full h-full object-cover">
                    {% else %}
                    <svg class="w-14 h-14 text-nordic-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    {% endif %}
                </div>
                <div class="w-16 h-1 bg-nordic-800 mx-auto rounded-full"></div>
            </div>

            <div class="mb-6">
                <h3 class="text-xs font-bold text-nordic-800 uppercase tracking-widest mb-3 pb-1 border-b border-nordic-200">Contact</h3>
                <div class="space-y-2 text-xs text-gray-600">
                    {% if cv.email %}
                    <p class="flex items-center gap-2"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>{{ cv.email }}</p>
                    {% endif %}
                    {% if cv.phone %}
                    <p class="flex items-center gap-2"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>{{ cv.phone }}</p>
                    {% endif %}
                    {% if cv.website %}
                    <p class="flex items-center gap-2"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>{{ cv.website }}</p>
                    {% endif %}
                </div>
            </div>

            {% set techSkills = [] %}
            {% for section in sections %}
                {% if section.section_type == 'skills' %}
                    {% for item in section.items %}
                        {% set techSkills = techSkills|merge([item.content.name]) %}
                    {% endfor %}
                {% endif %}
            {% endfor %}
            {% if techSkills|length > 0 %}
            <div class="mb-6">
                <h3 class="text-xs font-bold text-nordic-800 uppercase tracking-widest mb-3 pb-1 border-b border-nordic-200">Skills</h3>
                <div class="space-y-1.5">
                    {% for skill in techSkills|slice(0, 6) %}
                    <div class="flex justify-between text-xs"><span>{{ skill }}</span><span class="text-nordic-800 font-medium">{{ 100 - (loop.index0 * 6) }}%</span></div>
                    <div class="h-1 bg-nordic-200 rounded-full"><div class="h-1 bg-nordic-800 rounded-full" style="width:{{ 100 - (loop.index0 * 6) }}%"></div></div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% set langSection = sections|filter(s => s.section_type == 'languages')|first %}
            {% if langSection and langSection.items|length > 0 %}
            <div class="mb-6">
                <h3 class="text-xs font-bold text-nordic-800 uppercase tracking-widest mb-3 pb-1 border-b border-nordic-200">Languages</h3>
                <div class="space-y-1 text-xs text-gray-600">
                    {% for item in langSection.items %}
                    <div class="flex justify-between"><span>{{ item.content.name|default('') }}</span><span class="text-nordic-700 font-medium">{{ item.content.proficiency|default('Fluent') }}</span></div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
            <!-- END SIDEBAR -->
        </aside>

        <!-- START MAIN CONTENT -->
        <main class="flex-1 p-8">
            {% for section in sections %}
            {% if section.section_type == 'summary' and section.is_visible %}
            <section class="mb-6">
                <h2 class="text-xs font-bold text-nordic-800 uppercase tracking-widest mb-2">Professional Summary</h2>
                {% for item in section.items %}
                <p class="text-sm text-gray-600 leading-relaxed">{{ item.content.summary|default(item.content.text|default('')) }}</p>
                {% endfor %}
            </section>
            {% endif %}

            {% if section.section_type == 'experience' and section.is_visible %}
            <section class="mb-6">
                <h2 class="text-xs font-bold text-nordic-800 uppercase tracking-widest mb-3">Work Experience</h2>
                {% for item in section.items %}
                <!-- START EXPERIENCE -->
                <div class="mb-4 pb-4 border-b border-nordic-100">
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="font-bold text-nordic-900">{{ item.content.position|default('Position') }}</h3>
                            <p class="text-sm text-nordic-700 font-medium">{{ item.content.company|default('') }}</p>
                        </div>
                        <span class="text-xs text-gray-500 font-medium whitespace-nowrap">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                    </div>
                    <p class="text-sm text-gray-600 mt-2 leading-relaxed">{{ item.content.description|default('') }}</p>
                </div>
                <!-- END EXPERIENCE -->
                {% endfor %}
            </section>
            {% endif %}

            {% if section.section_type == 'education' and section.is_visible %}
            <section class="mb-6">
                <h2 class="text-xs font-bold text-nordic-800 uppercase tracking-widest mb-3">Education</h2>
                {% for item in section.items %}
                <!-- START EDUCATION -->
                <div class="mb-3 flex justify-between items-baseline">
                    <div>
                        <h3 class="font-bold text-nordic-900">{{ item.content.degree|default('Degree') }}</h3>
                        <p class="text-sm text-gray-600">{{ item.content.institution|default('') }}</p>
                    </div>
                    <span class="text-xs text-gray-500 font-medium">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                </div>
                <!-- END EDUCATION -->
                {% endfor %}
            </section>
            {% endif %}

            {% if section.section_type == 'projects' and section.is_visible %}
            <section class="mb-6">
                <h2 class="text-xs font-bold text-nordic-800 uppercase tracking-widest mb-3">Projects</h2>
                <!-- START PROJECTS -->
                <div class="grid grid-cols-2 gap-3">
                    {% for item in section.items %}
                    <div class="bg-nordic-50 rounded p-3 border border-nordic-200">
                        <h4 class="font-bold text-sm text-nordic-900">{{ item.content.name|default('Project') }}</h4>
                        <p class="text-xs text-gray-500 mt-0.5">{{ item.content.description|default('') }}</p>
                        {% if item.content.technologies %}
                        <span class="text-xs text-nordic-700 font-semibold mt-1 inline-block">{{ item.content.technologies }}</span>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                <!-- END PROJECTS -->
            </section>
            {% endif %}

            {% if section.section_type == 'certifications' and section.is_visible %}
            <section class="mb-6">
                <h2 class="text-xs font-bold text-nordic-800 uppercase tracking-widest mb-3">Certificates</h2>
                <!-- START CERTIFICATES -->
                <div class="space-y-2">
                    {% for item in section.items %}
                    <div class="bg-nordic-50 rounded p-3 border border-nordic-200">
                        <div class="flex justify-between items-start">
                            <div>
                                <h4 class="font-bold text-sm text-nordic-900">{{ item.content.name|default('Certificate') }}</h4>
                                {% if item.content.organization %}<p class="text-xs text-gray-500">{{ item.content.organization }}{% if item.content.date %} | {{ item.content.date }}{% endif %}</p>{% endif %}
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                <!-- END CERTIFICATES -->
            </section>
            {% endif %}
            {% endfor %}

            <footer class="mt-6 pt-4 border-t border-nordic-100 text-xs text-gray-400 flex justify-between items-center no-print">
                <span>Reference available upon request</span>
                <span>{{ cv.full_name|default('Applicant') }}{% if cv.email %} | {{ cv.email }}{% endif %}</span>
            </footer>
        </main>
    </div>
</div>

</body>
</html>
