<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ cv.full_name|default('CV') }} - {{ cv.job_title|default('Professional') }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                    colors: { primary: '#2563EB', primaryDark: '#1D4ED8', primaryLight: '#DBEAFE' }
                }
            }
        }
    </script>
    <style>
        @media print {
            @page { size: A4; margin: 0; }
            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .no-print { display: none !important; }
        }
        .sidebar-gradient { background: linear-gradient(180deg, #2563EB 0%, #1E40AF 100%); }
    </style>
</head>
<body class="font-sans text-gray-800 bg-gray-100 min-h-screen">

<div class="max-w-[210mm] mx-auto bg-white shadow-2xl my-4 flex" style="min-height: 297mm;">
    <!-- START SIDEBAR -->
    <aside class="w-[280px] flex-shrink-0 sidebar-gradient text-white flex flex-col">
        <!-- Profile Photo -->
        <div class="pt-10 pb-6 flex justify-center">
            <div class="w-32 h-32 rounded-full bg-white/20 border-4 border-white/30 flex items-center justify-center overflow-hidden">
                {% if cv.profile_photo %}
                <img src="{{ cv.profile_photo }}" alt="{{ cv.full_name|default('Profile') }}" class="w-full h-full object-cover">
                {% else %}
                <svg class="w-20 h-20 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                {% endif %}
            </div>
        </div>

        <!-- Contact -->
        <div class="px-6 pb-6">
            <h3 class="text-xs font-bold uppercase tracking-wider mb-4 opacity-80">Contact</h3>
            <div class="space-y-3 text-sm">
                {% if cv.email %}
                <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    <span class="break-all">{{ cv.email }}</span>
                </div>
                {% endif %}
                {% if cv.phone %}
                <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    <span>{{ cv.phone }}</span>
                </div>
                {% endif %}
                {% if cv.location %}
                <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243A8 8 0 1117.657 16.657z"/><circle cx="12" cy="11" r="1.5" fill="currentColor"/></svg>
                    <span>{{ cv.location }}</span>
                </div>
                {% endif %}
                {% if cv.website %}
                <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
                    <span class="break-all">{{ cv.website }}</span>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Technical Skills -->
        {% set techSkills = [] %}
        {% for section in sections %}
            {% if section.section_type == 'skills' %}
                {% for item in section.items %}
                    {% set techSkills = techSkills|merge([item.content.name]) %}
                {% endfor %}
            {% endif %}
        {% endfor %}
        {% if techSkills|length > 0 %}
        <div class="px-6 pb-6">
            <h3 class="text-xs font-bold uppercase tracking-wider mb-4 opacity-80">Technical Skills</h3>
            <div class="space-y-2.5">
                {% for skill in techSkills|slice(0, 8) %}
                <div>
                    <div class="flex justify-between text-xs mb-1">
                        <span>{{ skill }}</span>
                        <span>{{ 100 - (loop.index0 * 5) }}%</span>
                    </div>
                    <div class="h-1.5 bg-white/20 rounded-full">
                        <div class="h-1.5 bg-white rounded-full" style="width:{{ 100 - (loop.index0 * 5) }}%"></div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <!-- Languages -->
        {% set langSection = sections|filter(s => s.section_type == 'languages')|first %}
        {% if langSection and langSection.items|length > 0 %}
        <div class="px-6 pb-6">
            <h3 class="text-xs font-bold uppercase tracking-wider mb-4 opacity-80">Languages</h3>
            <div class="space-y-2 text-sm">
                {% for item in langSection.items %}
                <div class="flex justify-between">
                    <span>{{ item.content.name|default('') }}</span>
                    <span class="text-white/70">{{ item.content.proficiency|default('Fluent') }}</span>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </aside>
    <!-- END SIDEBAR -->

    <!-- START MAIN CONTENT -->
    <main class="flex-1 p-10">
        <!-- Header -->
        <header class="mb-8">
            <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight">{{ cv.full_name|default('Your Name') }}</h1>
            <p class="text-xl text-primary font-semibold mt-1">{{ cv.job_title|default('Professional Title') }}</p>
            <div class="flex gap-4 mt-4 text-sm text-gray-600">
                {% if cv.linkedin %}
                <a href="{{ cv.linkedin }}" class="flex items-center gap-1.5 hover:text-primary transition-colors" target="_blank">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h14m-.5 15.5v-5.3a3.26 3.26 0 00-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 011.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 001.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 00-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
                    LinkedIn
                </a>
                {% endif %}
                {% if cv.github %}
                <a href="{{ cv.github }}" class="flex items-center gap-1.5 hover:text-primary transition-colors" target="_blank">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                    GitHub
                </a>
                {% endif %}
                {% if cv.portfolio %}
                <a href="{{ cv.portfolio }}" class="flex items-center gap-1.5 hover:text-primary transition-colors" target="_blank">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
                    Portfolio
                </a>
                {% endif %}
            </div>
        </header>

        {% for section in sections %}
            {% if section.section_type == 'summary' and section.is_visible %}
            {# ── Professional Summary ── #}
            <section class="mb-8">
                <h2 class="text-lg font-bold text-gray-900 uppercase tracking-wider mb-3 flex items-center gap-2">
                    <span class="w-8 h-0.5 bg-primary"></span>Professional Summary
                </h2>
                {% for item in section.items %}
                <p class="text-gray-600 leading-relaxed text-sm">{{ item.content.summary|default(item.content.text|default('')) }}</p>
                {% endfor %}
            </section>
            {% endif %}

            {% if section.section_type == 'experience' and section.is_visible %}
            {# ── Work Experience ── #}
            <section class="mb-8">
                <h2 class="text-lg font-bold text-gray-900 uppercase tracking-wider mb-4 flex items-center gap-2">
                    <span class="w-8 h-0.5 bg-primary"></span>Work Experience
                </h2>
                {% for item in section.items %}
                <!-- START EXPERIENCE -->
                <div class="mb-5 relative pl-6 border-l-2 border-primary/30">
                    <div class="absolute -left-[7px] top-1.5 w-3.5 h-3.5 bg-primary rounded-full border-2 border-white"></div>
                    <div class="flex justify-between items-start mb-1">
                        <div>
                            <h3 class="font-bold text-gray-900">{{ item.content.position|default('Position') }}</h3>
                            <p class="text-primary font-semibold text-sm">{{ item.content.company|default('') }}</p>
                        </div>
                        <span class="text-xs text-gray-500 font-medium whitespace-nowrap">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                    </div>
                    <p class="text-sm text-gray-600 leading-relaxed mt-2">{{ item.content.description|default('') }}</p>
                </div>
                <!-- END EXPERIENCE -->
                {% endfor %}
            </section>
            {% endif %}

            {% if section.section_type == 'education' and section.is_visible %}
            {# ── Education ── #}
            <section class="mb-8">
                <h2 class="text-lg font-bold text-gray-900 uppercase tracking-wider mb-4 flex items-center gap-2">
                    <span class="w-8 h-0.5 bg-primary"></span>Education
                </h2>
                {% for item in section.items %}
                <!-- START EDUCATION -->
                <div class="mb-4 {% if not loop.last %}mb-4{% endif %} bg-gray-50 rounded-lg p-4 border-l-4 border-primary">
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="font-bold text-gray-900">{{ item.content.degree|default('Degree') }}</h3>
                            <p class="text-gray-600 text-sm">{{ item.content.institution|default('') }}</p>
                        </div>
                        <span class="text-xs text-gray-500 font-medium">{{ item.content.start_date|default('') }}{% if item.content.end_date %} - {{ item.content.end_date }}{% endif %}</span>
                    </div>
                    {% if item.content.gpa or item.content.field %}
                    <p class="text-sm text-gray-500 mt-1">{{ item.content.field ? ('Focus: ' ~ item.content.field) : '' }}{% if item.content.gpa and item.content.field %} | {% endif %}{% if item.content.gpa %}GPA: {{ item.content.gpa }}{% endif %}</p>
                    {% endif %}
                </div>
                <!-- END EDUCATION -->
                {% endfor %}
            </section>
            {% endif %}

            {% if section.section_type == 'projects' and section.is_visible %}
            {# ── Projects ── #}
            <section class="mb-8">
                <h2 class="text-lg font-bold text-gray-900 uppercase tracking-wider mb-4 flex items-center gap-2">
                    <span class="w-8 h-0.5 bg-primary"></span>Key Projects
                </h2>
                <!-- START PROJECTS -->
                <div class="grid grid-cols-2 gap-3">
                    {% for item in section.items %}
                    <div class="bg-primaryLight/50 rounded-lg p-3 border border-primary/10">
                        <h4 class="font-bold text-sm text-gray-900">{{ item.content.name|default('Project') }}</h4>
                        <p class="text-xs text-gray-600 mt-1">{{ item.content.description|default('') }}</p>
                        {% if item.content.technologies %}
                        <span class="text-xs text-primary font-semibold mt-2 inline-block">{{ item.content.technologies }}</span>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                <!-- END PROJECTS -->
            </section>
            {% endif %}

            {% if section.section_type == 'certifications' and section.is_visible %}
            {# ── Certificates ── #}
            <section class="mb-8">
                <h2 class="text-lg font-bold text-gray-900 uppercase tracking-wider mb-4 flex items-center gap-2">
                    <span class="w-8 h-0.5 bg-primary"></span>Certificates
                </h2>
                <!-- START CERTIFICATES -->
                <div class="space-y-3">
                    {% for item in section.items %}
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                        </div>
                        <div>
                            <h4 class="font-bold text-sm text-gray-900">{{ item.content.name|default('Certificate') }}</h4>
                            <p class="text-xs text-gray-500">{{ item.content.organization|default('') }}{% if item.content.organization and item.content.date %} | {% endif %}{{ item.content.date|default('') }}</p>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                <!-- END CERTIFICATES -->
            </section>
            {% endif %}
        {% endfor %}

        <!-- Footer -->
        <footer class="mt-auto pt-6 border-t border-gray-100 text-xs text-gray-400 flex justify-between items-center no-print">
            <span>Reference available upon request</span>
            <span>{{ cv.full_name|default('Applicant') }}{% if cv.email %} | {{ cv.email }}{% endif %}</span>
        </footer>
    </main>
    <!-- END MAIN CONTENT -->
</div>

</body>
</html>
