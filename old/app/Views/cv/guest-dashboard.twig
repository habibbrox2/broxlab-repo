{% extends 'layout.twig' %}

{% block title %}{{ page_title|default('CV Builder - Guest Mode') }}{% endblock %}

{% block content %}
<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-indigo-50/30">
  <div class="max-w-2xl mx-auto px-4 py-8">
    
    {# Guest Mode Banner #}
    <div class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-5 mb-8 flex items-start gap-4">
      <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center flex-shrink-0">
        <i data-lucide="info" class="w-5 h-5 text-amber-600"></i>
      </div>
      <div class="flex-1">
        <h3 class="font-bold text-amber-800 text-sm mb-1">Guest Mode</h3>
        <p class="text-xs text-amber-700 leading-relaxed">
          You're using the CV Builder as a guest. 
          <a href="/login?redirect=/cv-builder/templates" class="font-semibold underline hover:text-amber-900">Log in</a> or 
          <a href="/register?redirect=/cv-builder/templates" class="font-semibold underline hover:text-amber-900">create an account</a> 
          to unlock premium templates, save your CVs permanently, and access more features.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <a href="/login?redirect=/cv-builder/templates" 
             class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-gradient-to-r from-amber-600 to-orange-600 text-white text-xs font-bold hover:from-amber-700 hover:to-orange-700 transition-all duration-200 shadow-sm">
            <i data-lucide="crown" class="w-3.5 h-3.5"></i>
            Log In to Upgrade Template
          </a>
        </div>
      </div>
    </div>

    {# Header #}
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-slate-800">CV Builder</h1>
        <p class="text-sm text-slate-500 mt-1">Create a simple CV with the Minimal template</p>
      </div>
      <a href="/cv-builder/templates" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 transition-all duration-200">
        <i data-lucide="palette" class="w-4 h-4"></i>
        Browse Templates
      </a>
    </div>

    {# Create New CV CTA #}
    <div class="bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl p-8 mb-8 text-white shadow-xl shadow-indigo-200/50 text-center">
      <div class="w-16 h-16 rounded-2xl bg-white/20 flex items-center justify-center mx-auto mb-4 backdrop-blur-sm">
        <i data-lucide="file-plus" class="w-8 h-8"></i>
      </div>
      <h2 class="text-xl font-bold mb-2">Create Your CV</h2>
      <p class="text-indigo-100 text-sm mb-6 max-w-md mx-auto">
        Build a professional CV using our Minimal template. Simple, clean, and ATS-friendly.
      </p>
      <form method="POST" action="/cv-builder/guest">
        <input type="hidden" name="csrf_token" value="{{ csrf_token|default('') }}">
        <button type="submit" class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-white text-indigo-700 font-bold text-sm hover:bg-indigo-50 hover:-translate-y-0.5 active:scale-95 transition-all duration-200 shadow-lg shadow-indigo-900/20">
          <i data-lucide="plus" class="w-5 h-5"></i>
          Start Building
        </button>
      </form>
    </div>

    {# Guest CVs List #}
    {% if cvs is defined and cvs|length > 0 %}
    <div>
      <h3 class="text-sm font-semibold text-slate-600 uppercase tracking-wide flex items-center gap-2 mb-4">
        <i data-lucide="file-text" class="w-4 h-4"></i>
        Your Guest CVs
      </h3>
      <div class="space-y-3">
        {% for cv in cvs %}
        <div class="bg-white rounded-xl p-4 border border-slate-200 hover:border-indigo-200 hover:shadow-lg transition-all duration-200">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-100 to-purple-100 flex items-center justify-center text-indigo-600 flex-shrink-0">
              <i data-lucide="file-text" class="w-5 h-5"></i>
            </div>
            <div class="flex-1 min-w-0">
              <h4 class="font-semibold text-slate-800 text-sm truncate">{{ cv.title }}</h4>
              <p class="text-xs text-slate-500 mt-0.5">
                Template: Minimal &middot; 
                {% if cv.is_active %}Active{% else %}Draft{% endif %}
              </p>
            </div>
            <div class="flex items-center gap-2">
              <a href="/cv-builder/guest/builder/{{ cv.id }}" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-indigo-50 text-indigo-700 text-xs font-semibold hover:bg-indigo-100 transition-colors">
                <i data-lucide="edit" class="w-3.5 h-3.5"></i>
                Edit
              </a>
              <a href="/cv-builder/guest/{{ cv.id }}/export/pdf" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-emerald-50 text-emerald-700 text-xs font-semibold hover:bg-emerald-100 transition-colors">
                <i data-lucide="download" class="w-3.5 h-3.5"></i>
                PDF
              </a>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</div>
{% endblock %}
