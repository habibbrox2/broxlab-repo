{# templates/services/new-application.twig #}
{% extends 'layout.twig' %}
{% block title %}Start New Application{% endblock %}
{% set breadcrumbs = [
 {"label":"My Applications","url":"/services/my-applications","icon":"clipboard-list"
 },
 {"label":"New Application","icon":"plus-lg"
 }
] %}
{% block content %}

 {# Hero Section #}
 <section class="hero-section services-new-application-hero relative py-5 mb-5 overflow-hidden bg-gradient-to-br from-indigo-600 to-violet-600">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 items-center">
 <div class="lg:col-span-8">
 <h1 class="text-4xl md:text-5xl font-bold text-white mb-3">
 <i class="lucide lucide-plus-circle mr-2"></i>Start New Application
 </h1>
 <p class="text-lg md:text-xl text-white/50">Select a service below and submit your application</p>
 </div>
 <div class="lg:col-span-4 text-center">
 <div class="flex h-24 w-24 items-center justify-center rounded-full bg-white/20 mx-auto border border-white/35 text-white shadow-lg text-4xl">
 <i class="lucide lucide-clipboard-plus" aria-hidden="true"></i>
 </div>
 </div>
 </div>
 </div>
 </section>
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5 home-feed-surface services-new-application-page">
 <div class="listing-header">
 <h2>
 <i class="lucide lucide-briefcase text-indigo-600 mr-2"></i>Available Services
 </h2>
 </div>
 {# Filter Card #}
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
 <div class="flex flex-col gap-4 md:flex-row md:items-end md:gap-3 p-4">
 {# Search #}
 <div class="flex-1 min-w-0 md:flex-[1_1_320px]">
 <form method="get" class="flex items-center gap-2">
 <input type="text"
 name="search"
 value="{{ search|default("") }}"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 placeholder="Search services...">
 <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700">
 <i class="lucide lucide-search"></i>
 </button>
 </form>
 </div>
 {# Sort #}
 <div class="flex-shrink-0">
 <label class="block text-sm font-medium text-slate-700 mb-1">Sort By</label>
 <form method="get">
 <select name="sort" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" data-action="generic">
 <option value="latest" {% if sort == 'latest' %}selected{% endif %}>Latest</option>
 <option value="name" {% if sort == 'name' %}selected{% endif %}>Name (A-Z)</option>
 <option value="popularity" {% if sort == 'popularity' %}selected{% endif %}>Popular</option>
 </select>
 </form>
 </div>
 </div>
 </div>
 {# Services Grid #}
 {% if services is not empty %}
 <div class="feed-grid" role="feed" aria-label="Available services feed">
 {% for service in services %}
 {% include 'partials/content-card.twig' with { item: {
 images: service.image_urls|default(service.images|default([])),
 image: service.featured_image_url|default(service.image_urls|first|default(service.featured_image.thumbnail_path|default(service.featured_image.image_path|default(service.image_path|default(service.thumbnail|default(null)))))),
 title: service.name,
 subtitle: service.description|default('')|striptags|slice(0, 100) ~ '...',
 rich_excerpt_html: service.description|default(''),
 categories: service.categories|default([]),
 tags: service.tags|default([]),
 created_at: service.created_at,
 url: service.slug,
 id: service.id,
 slug: service.slug,
 type: 'service',
 price: service.price,
 status: service.status|default(''),
 is_premium: service.is_premium|default(0),
 is_free: service.is_free|default(0)
 }, index: loop.index } %}
 {% endfor %}
 </div>
 {% else %}
 <div class="feed-empty-state">
 <div class="empty-state-content"
 role="status"
 aria-label="No services available for application">
 <i class="lucide lucide-briefcase"></i>
 <h3>No applications available</h3>
 <p>There are no services available for application at this time.</p>
 <a href="/services/my-applications" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-indigo-600 hover:bg-indigo-100 mt-3">
 <i class="lucide lucide-arrow-left"></i> Back
 </a>
 </div>
 </div>
 {% endif %}
 </div>
{% endblock %}






