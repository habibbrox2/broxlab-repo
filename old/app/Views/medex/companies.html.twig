{% extends 'medex/base.html.twig' %}

{% block page_content %}
{% set labelTotalCompanies = current_lang == 'bn' ? 'মোট কোম্পানি' : 'Total Companies' %}
{% set labelTotalBrands = current_lang == 'bn' ? 'মোট ব্র্যান্ড' : 'Total Brands' %}
{% set labelLastUpdated = current_lang == 'bn' ? 'শেষ আপডেট' : 'Last Updated' %}
{% set labelDatabaseStatus = current_lang == 'bn' ? 'ডেটাবেসের অবস্থা:' : 'Database Status:' %}
{% set labelSearchPlaceholder = current_lang == 'bn' ? 'কোম্পানি খুঁজুন...' : 'Search companies...' %}
{% set labelFilter = current_lang == 'bn' ? 'ফিল্টার' : 'Filter' %}
{% set labelExport = current_lang == 'bn' ? 'এক্সপোর্ট' : 'Export' %}
{% set labelDetailsPage = current_lang == 'bn' ? 'বিস্তারিত' : 'Details' %}

{# Stats Summary #}
<div class="row mb-4">
    <div class="col-md-4">
        <div class="medex-stats-card">
            <div class="medex-stats-number">{{ total_companies }}</div>
            <div class="medex-stats-label">{{ labelTotalCompanies }}</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="medex-stats-card">
            <div class="medex-stats-number" id="medexTotalBrands">{{ total_brands|number_format }}</div>
            <div class="medex-stats-label">{{ labelTotalBrands }}</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="medex-stats-card">
            <div class="medex-stats-number">{{ last_updated ? last_updated|date('M d, Y') : 'N/A' }}</div>
            <div class="medex-stats-label">{{ labelLastUpdated }}</div>
        </div>
    </div>
</div>

{# Info Banner #}
<div class="medex-info-banner" role="alert">
    <div class="d-flex align-items-center">
        <i class="bi bi-info-circle-fill me-3 fs-4"></i>
        <div>
            <strong>{{ labelDatabaseStatus }}</strong>
            {{ current_lang == 'bn' ? total_companies|number_format ~ ' টি হার্বাল ফার্মাসিউটিক্যাল কোম্পানি সূচিপত্রভুক্ত' : total_companies ~ ' herbal pharmaceutical companies indexed.' }}
            {% if last_updated %}
                <br><small class="text-muted">{{ current_lang == 'bn' ? 'শেষ আপডেট:' : 'Last updated:' }} {{ last_updated|date('M d, Y H:i') }}</small>
            {% endif %}
        </div>
    </div>
</div>

{# Filter Bar (for future search) #}
<div class="medex-filter-bar">
    <div class="input-group" style="flex: 1; min-width: 250px;">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
        <input id="medexSearchInput" type="text" class="form-control medex-filter-input border-start-0" placeholder="{{ labelSearchPlaceholder }}" aria-label="{{ labelSearchPlaceholder }}">
    </div>
    <button id="medexFilterBtn" class="btn btn-outline-secondary" type="button" title="{{ labelFilter }}" aria-label="{{ labelFilter }}">
        <i class="bi bi-funnel me-1"></i> {{ labelFilter }}
    </button>
    <button id="medexExportBtn" class="btn btn-primary medex-btn--primary" type="button" title="{{ labelExport }}" aria-label="{{ labelExport }}">
        <i class="bi bi-download me-1"></i> {{ labelExport }}
    </button>
    <a href="/medex/details" class="btn btn-outline-info ms-2" title="MedEx details page" aria-label="MedEx details page">
        <i class="bi bi-info-circle me-1"></i> {{ labelDetailsPage }}
    </a>
</div>
<div class="mt-3 mb-3">
    <div id="medexFetchStatus" class="text-muted">
        Loading latest MedEx data…
    </div>
</div>

{# Companies Card with Table #}
<div class="medex-card">
    <div class="medex-card-header">
        <i class="bi bi-building"></i>
        {{ current_lang == 'bn' ? 'হার্বাল ফার্মাসিউটিক্যাল কোম্পানি' : 'Herbal Pharmaceutical Companies' }}
        <span class="badge bg-success float-end">{{ total_companies }}</span>
    </div>
    <div class="medex-card-body p-0">
        {% if companies is not empty %}
        <div class="medex-table-wrapper">
            <table class="medex-table">
                <thead>
                    <tr>
                        <th scope="col" class="text-center" style="width: 60px;">#</th>
                        <th scope="col">Company Name</th>
                        <th scope="col" class="text-center" style="width: 100px;">Est.</th>
                        <th scope="col" class="text-end" style="width: 120px;">Generics</th>
                        <th scope="col" class="text-end" style="width: 120px;">Brands</th>
                        <th scope="col" class="text-center" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="medexCompaniesTableBody">
                    {% for company in companies %}
                    <tr class="medex-hover-lift">
                        <td class="text-center fw-semibold text-muted">
                            {{ (pagination.current_page - 1) * pagination.per_page + loop.index }}
                        </td>
                        <td>
                            <a href="/medex/company/{{ company._id }}" class="company-name text-decoration-none">
                                <strong>{{ company.name }}</strong>
                                {% if company.headquarter %}
                                    <br><small class="text-muted"><i class="bi bi-geo-alt me-1"></i>{{ company.headquarter|slice(0, 50) }}{% if company.headquarter|length > 50 %}...{% endif %}</small>
                                {% endif %}
                            </a>
                        </td>
                        <td class="text-center">
                            <span class="medex-badge medex-badge--established">
                                {{ company.established|default('N/A') }}
                            </span>
                        </td>
                        <td class="text-end">
                            <span class="medex-badge medex-badge--generics">
                                {{ company.generics|default(company.total_generics|default(0))|number_format }}
                            </span>
                        </td>
                        <td class="text-end">
                            <span class="medex-badge medex-badge--brands">
                                {{ company.brands|default(0)|number_format }}
                            </span>
                        </td>
                        <td class="text-center">
                            <a href="/medex/company/{{ company._id }}" class="medex-btn medex-btn--view">
                                <i class="bi bi-eye"></i> View
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="medex-empty-state">
            <i class="bi bi-inbox"></i>
            <h4>No Companies Found</h4>
            <p>No pharmaceutical companies are currently indexed in the database.</p>
        </div>
        {% endif %}
    </div>
</div>

{# Pagination #}
<div class="medex-pagination-wrap">
    {% include 'medex/partials/_pagination.html.twig' with { pagination: pagination } only %}
</div>

{# Back to top spacing #}
<div class="mb-5"></div>

{% block extra_scripts %}
<script>
(function() {
    const apiUrl = '/api/medex/companies';
    const searchInput = document.getElementById('medexSearchInput');
    const filterBtn = document.getElementById('medexFilterBtn');
    const exportBtn = document.getElementById('medexExportBtn');
    const statusEl = document.getElementById('medexFetchStatus');
    const totalCompaniesEl = document.getElementById('medexTotalCompanies');
    const totalBrandsEl = document.getElementById('medexTotalBrands');
    const paginationWrap = document.querySelector('.medex-pagination-wrap');
    const tableBody = document.getElementById('medexCompaniesTableBody');
    let companies = [];

    function formatNumber(value) {
        return new Intl.NumberFormat('en-US').format(value || 0);
    }

    function renderCompanies(list) {
        if (!tableBody) return;
        tableBody.innerHTML = '';
        if (!list.length) {
            tableBody.innerHTML = '<tr><td colspan="6" class="text-center py-5 text-muted">No companies match your search.</td></tr>';
            return;
        }

        const rows = list.map((company, index) => {
            const rank = index + 1;
            const established = company.established || 'N/A';
            const headquarter = company.headquarter ? company.headquarter : '';
            const headquarterText = headquarter.length > 50 ? headquarter.slice(0, 50) + '...' : headquarter;
            const generics = Number(company.generics || company.total_generics || 0);
            const brands = Number(company.brands || 0);
            const companyUrl = `/medex/company/${company._id}`;
            return `
                <tr class="medex-hover-lift">
                    <td class="text-center fw-semibold text-muted">${rank}</td>
                    <td>
                        <a href="${companyUrl}" class="company-name text-decoration-none">
                            <strong>${escapeHtml(company.name || 'Unknown')}</strong>
                            ${headquarter ? `<br><small class="text-muted"><i class="bi bi-geo-alt me-1"></i>${escapeHtml(headquarterText)}</small>` : ''}
                        </a>
                    </td>
                    <td class="text-center">
                        <span class="medex-badge medex-badge--established">${escapeHtml(established)}</span>
                    </td>
                    <td class="text-end">
                        <span class="medex-badge medex-badge--generics">${formatNumber(generics)}</span>
                    </td>
                    <td class="text-end">
                        <span class="medex-badge medex-badge--brands">${formatNumber(brands)}</span>
                    </td>
                    <td class="text-center">
                        <a href="${companyUrl}" class="medex-btn medex-btn--view"><i class="bi bi-eye"></i> View</a>
                    </td>
                </tr>`;
        });

        tableBody.innerHTML = rows.join('');
    }

    function escapeHtml(text) {
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function updateStats(list, lastUpdated) {
        if (totalCompaniesEl) {
            totalCompaniesEl.textContent = formatNumber(list.length);
        }
        if (totalBrandsEl) {
            const count = list.reduce((sum, company) => sum + Number(company.brands || 0), 0);
            totalBrandsEl.textContent = formatNumber(count);
        }
        if (statusEl) {
            statusEl.textContent = `Showing ${formatNumber(list.length)} live companies from MedEx.`;
        }
        if (lastUpdated && statusEl) {
            statusEl.textContent += ` Last updated ${new Date(lastUpdated).toLocaleString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}.`;
        }
    }

    function applyFilter() {
        const query = searchInput.value.trim().toLowerCase();
        const filtered = companies.filter(company => {
            const name = (company.name || '').toLowerCase();
            const headquarter = (company.headquarter || '').toLowerCase();
            return !query || name.includes(query) || headquarter.includes(query);
        });
        renderCompanies(filtered);
        if (statusEl) {
            statusEl.textContent = `Showing ${formatNumber(filtered.length)} of ${formatNumber(companies.length)} companies${query ? ` matching "${escapeHtml(searchInput.value)}"` : ''}.`;
        }
    }

    function debounce(fn, wait) {
        let timeout;
        return function(...args) {
            clearTimeout(timeout);
            timeout = setTimeout(() => fn.apply(this, args), wait);
        };
    }

    async function fetchLiveCompanies() {
        try {
            const response = await fetch(apiUrl, { cache: 'no-store' });
            if (!response.ok) {
                throw new Error(`API returned status ${response.status}`);
            }
            const data = await response.json();
            if (!data.success) {
                throw new Error(data.error || 'Unknown API error');
            }
            companies = Array.isArray(data.companies) ? data.companies : [];
            renderCompanies(companies);
            updateStats(companies, data.last_updated);
            if (paginationWrap) {
                paginationWrap.style.display = 'none';
            }
        } catch (error) {
            if (statusEl) {
                statusEl.innerHTML = `<span class="text-danger">Unable to load live MedEx data. ${escapeHtml(error.message)}</span>`;
            }
        }
    }

    if (searchInput) {
        searchInput.addEventListener('input', debounce(applyFilter, 200));
    }
    if (filterBtn) {
        filterBtn.addEventListener('click', applyFilter);
    }
    if (exportBtn) {
        exportBtn.addEventListener('click', async () => {
            if (!companies.length) {
                return;
            }
            const blob = new Blob([JSON.stringify(companies, null, 2)], { type: 'application/json;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'medex_companies_live.json';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        });
    }

    fetchLiveCompanies();
})();
</script>
{% endblock %}

{% endblock %}
