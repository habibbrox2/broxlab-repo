{% set item_type = item.type|default('content') %}
{% set item_title = item.title|default('Untitled') %}

{% set item_href = '' %}
{% if item_type == 'mobile' %}
  {% set item_href = '/mobiles/view/' ~ item.id %}
{% elseif item_type == 'post' %}
  {% set item_slug = item.slug|default(item.url|default(item.id)) %}
  {% set item_href = item.id ? '/posts/' ~ item.id ~ '/' ~ ('' ~ item_slug)|url_encode : '/posts/view/' ~ ('' ~ item_slug)|url_encode %}
{% elseif item_type == 'service' %}
  {% set item_href = '/services/view/' ~ item.slug|default(item.id) %}
{% elseif item_type == 'page' %}
  {% set item_href = '/pages/view/' ~ item.url|default(item.slug|default(item.id)) %}
{% else %}
  {% set item_href = '/pages/view/' ~ item.url|default(item.slug|default(item.id)) %}
{% endif %}

{% set image_src = null %}
{% if item.images is defined and item.images|length > 0 %}
  {% set image_src = item.images|first %}
{% elseif item.image is defined and item.image %}
  {% set image_src = item.image %}
{% endif %}

{% if image_src is iterable %}
  {% if image_src.url is defined %}
    {% set image_src = image_src.url %}
  {% elseif image_src.path is defined %}
    {% set image_src = image_src.path %}
  {% else %}
    {% set image_src = image_src|first %}
  {% endif %}
{% endif %}

{% set reading_time = max(((item.subtitle|default(item.description|default(''))|striptags|split(' ')|length) / 200)|round, 1) %}
{% set first_category = item.categories|default([])|first|default('') %}
{% set category_name = first_category.name|default(first_category)|default(item_type|capitalize) %}
{% set published = item.published_at|default(item.created_at)|default('') %}

<article class="discovery-card" role="article" aria-label="{{ item_title|striptags }}">
  {# Image Section #}
  <div class="discovery-card__image-wrap">
    {% if image_src %}
      <img src="{{ image_src|absolute_url }}"
           class="discovery-card__image"
           alt="{{ item_title|striptags }}"
           loading="lazy"
           decoding="async"
           width="400"
           height="250">
    {% else %}
      <div class="discovery-card__image discovery-card__image--placeholder" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#CBD5E1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
      </div>
    {% endif %}
    <div class="discovery-card__image-overlay" aria-hidden="true"></div>

    {# Category Badge #}
    <span class="discovery-card__badge">{{ category_name }}</span>

    {# Action Buttons #}
    <div class="discovery-card__actions">
      <button type="button"
              class="discovery-card__action-btn"
              data-bookmark-id="{{ item.id }}"
              data-bookmark-title="{{ item_title|striptags }}"
              data-bookmark-url="{{ item_href }}"
              aria-label="Bookmark this item"
              title="Bookmark">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
        </svg>
      </button>
      <button type="button"
              class="discovery-card__action-btn"
              data-share-url="{{ item_href }}"
              data-share-title="{{ item_title|striptags }}"
              aria-label="Share this item"
              title="Share">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="18" cy="5" r="3"/>
          <circle cx="6" cy="12" r="3"/>
          <circle cx="18" cy="19" r="3"/>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
        </svg>
      </button>
      <button type="button"
              class="discovery-card__action-btn"
              data-copy-url="{{ item_href }}"
              aria-label="Copy link"
              title="Copy link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </svg>
      </button>
    </div>
  </div>

  {# Card Body #}
  <div class="discovery-card__body">
    <div class="discovery-card__meta">
      <span class="discovery-card__category">{{ category_name }}</span>
      {% if published %}
        <span class="discovery-card__meta-sep" aria-hidden="true"></span>
        <time datetime="{{ published|date('Y-m-d') }}">{{ published|time_ago }}</time>
      {% endif %}
    </div>

    <h3 class="discovery-card__title">
      <a href="{{ item_href }}">{{ item_title }}</a>
    </h3>

    {% if item_type == 'mobile' and item.subtitle %}
      <p class="discovery-card__summary">{{ item.subtitle }}</p>
    {% elseif item.subtitle %}
      <p class="discovery-card__summary">{{ item.subtitle|striptags|trim|slice(0, 150) ~ '...' }}</p>
    {% elseif item.description %}
      <p class="discovery-card__summary">{{ item.description|striptags|trim|slice(0, 150) ~ '...' }}</p>
    {% endif %}

    {# Tags #}
    {% if item.tags is defined and item.tags|length > 0 %}
      <div class="discovery-card__tags" role="list" aria-label="Tags">
        {% for tag in item.tags|slice(0, 4) %}
          <span class="discovery-card__tag" role="listitem">{{ tag.name|default(tag) }}</span>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {# Footer #}
  <div class="discovery-card__footer">
    <div class="discovery-card__footer-left">
      <span class="discovery-card__readtime">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        {{ reading_time }} min read
      </span>
      <span class="discovery-card__stat" title="Views">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
        {% if item.views_count is defined %}{{ item.views_count }}{% else %}0{% endif %}
      </span>
    </div>

    <a href="{{ item_href }}" class="discovery-card__cta" aria-label="Read {{ item_title|striptags }}">
      {% if item_type == 'mobile' %}
        View Specs
      {% elseif item_type == 'post' %}
        Read Article
      {% elseif item_type == 'service' %}
        View Details
      {% else %}
        Explore
      {% endif %}
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </a>
  </div>
</article>
