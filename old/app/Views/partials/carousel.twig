{# ===============================
 Image Carousel (v2)
 =============================== #}

{% set cid = id|default('carousel_' ~ random()) %}
{% set imgs = images|default([]) %}
{% set count = imgs|length %}

{% set config = {
 show_indicators: show_indicators|default(true),
 show_controls: show_controls|default(true),
 height: height|default('240px'),
 interval: interval|default(5000),
 pause: pause|default('hover'),
 gradient: gradient|default(null),
 title: title|default('Gallery')
} %}

{% if count > 0 %}
<div id="{{ cid }}"
 class="carousel slide rounded-2xl overflow-hidden"
 role="region"
 aria-roledescription="carousel"
 aria-label="{{ config.title }}"
 data-brox-ride="carousel"
 data-interval="{{ config.interval }}"
 data-pause="{{ config.pause }}">

 {# Indicators #}
 {% if config.show_indicators and count > 1 %}
 <div class="carousel-indicators">
 {% for img in imgs %}
 <button type="button"
 data-brox-target="#{{ cid }}"
 data-brox-slide-to="{{ loop.index0 }}"
 class="{% if loop.first %}active{% endif %}"
 aria-label="Slide {{ loop.index }}"
 aria-current="{{ loop.first ? 'true' : 'false' }}">
 </button>
 {% endfor %}
 </div>
 {% endif %}

 {# Slides #}
 <div class="carousel-inner" style="height: {{ config.height }};">
 {% for img in imgs %}
 {% set src = img.url|default(img) %}
 {% set alt = img.alt|default(config.title ~ ' image ' ~ loop.index) %}

 <div class="carousel-item h-full {% if loop.first %}active{% endif %}">
 <div class="relative w-full h-full">

 {# Background image #}
 <img src="{{ src }}"
 class="block w-full h-full inl-c-0001"
 
 alt="{{ alt }}"
 loading="lazy"
 decoding="async">

 {# Optional Gradient Overlay #}
 {% if config.gradient %}
 <div class="absolute top-0 left-0 w-full h-full"
 style="background: {{ config.gradient }}; opacity: .35;"
 aria-hidden="true"></div>
 {% endif %}

 </div>
 </div>
 {% endfor %}
 </div>

 {# Controls #}
 {% if config.show_controls and count > 1 %}
 <button class="carousel-control-prev"
 type="button"
 data-brox-target="#{{ cid }}"
 data-brox-slide="prev">
 <span class="carousel-control-prev-icon"></span>
 <span class="sr-only">Previous</span>
 </button>

 <button class="carousel-control-next"
 type="button"
 data-brox-target="#{{ cid }}"
 data-brox-slide="next">
 <span class="carousel-control-next-icon"></span>
 <span class="sr-only">Next</span>
 </button>
 {% endif %}
</div>

{% else %}
{# Placeholder #}
<div class="bg-slate-100 rounded-2xl flex items-center justify-center"
 style="height: {{ config.height }};">
 <i class="lucide lucide-image text-slate-500 text-4xl" aria-hidden="true"></i>
 <span class="sr-only">No images available</span>
</div>
{% endif %}



