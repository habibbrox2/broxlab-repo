{% extends "layout.twig" %}
{% set suppress_layout_flash = true %}
{% block title %}Verify Your Email - {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% block content %}
<div class="relative isolate overflow-hidden bg-slate-50 py-10 sm:py-14">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-emerald-500/10 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-indigo-500/10 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-stretch gap-6 lg:grid-cols-2">
      {# ── Sidebar with info ── #}
      <aside class="relative hidden overflow-hidden rounded-[2rem] border border-slate-200 bg-gradient-to-br from-slate-950 via-emerald-950 to-teal-950 p-8 text-white shadow-2xl shadow-slate-950/20 lg:flex lg:flex-col lg:justify-between">
        <div class="absolute inset-0 opacity-20" aria-hidden="true">
          <div class="absolute -top-16 right-0 h-48 w-48 rounded-full bg-white/10 blur-3xl"></div>
          <div class="absolute bottom-0 left-0 h-48 w-48 rounded-full bg-emerald-300/10 blur-3xl"></div>
        </div>
        <div class="relative space-y-6">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.28em] text-emerald-100 backdrop-blur">
            <i class="lucide lucide-mail h-3.5 w-3.5"></i>
            Verify Email
          </div>
          <div class="space-y-3">
            <h1 class="text-4xl font-black tracking-tight text-white">Confirm your email to unlock your account.</h1>
            <p class="max-w-xl text-sm leading-6 text-slate-300">
              A verification token has been sent to your inbox. Enter it below to activate your account and start using all features.
            </p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
              <div class="mb-2 flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-emerald-200">
                <i class="lucide lucide-shield-check h-5 w-5"></i>
              </div>
              <p class="text-sm font-semibold text-white">One-time process</p>
              <p class="mt-1 text-xs leading-5 text-slate-300">Verify once and enjoy uninterrupted access forever.</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
              <div class="mb-2 flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-indigo-200">
                <i class="lucide lucide-zap h-5 w-5"></i>
              </div>
              <p class="text-sm font-semibold text-white">Instant access</p>
              <p class="mt-1 text-xs leading-5 text-slate-300">Verified emails let you log in immediately without delays.</p>
            </div>
          </div>
        </div>
        <div class="relative flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 text-emerald-200">
            <i class="lucide lucide-lock h-6 w-6"></i>
          </div>
          <div>
            <p class="text-sm font-semibold text-white">Secure verification</p>
            <p class="text-xs text-slate-300">Your email is used only for security and important notifications.</p>
          </div>
        </div>
      </aside>

      {# ── Main form card ── #}
      <section class="scroll-fade-in overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_24px_80px_-30px_rgba(15,23,42,0.25)]">
        <div class="border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-6 py-5 sm:px-8 sm:py-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.26em] text-emerald-700">
                <i class="lucide lucide-mail h-3.5 w-3.5"></i>
                Verify Email
              </div>
              <h2 class="mt-3 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">Check your inbox</h2>
              <p class="mt-2 max-w-xl text-sm leading-6 text-slate-500">
                We sent a verification code to <strong class="text-slate-800">{{ email }}</strong>
              </p>
            </div>
            <div class="hidden sm:flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-600/10 text-emerald-600">
              <i class="lucide lucide-mail-check h-6 w-6"></i>
            </div>
          </div>
        </div>

        <div class="px-6 py-6 sm:px-8 sm:py-8">
          {% if error %}
          <div class="mb-4 flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
            <i class="lucide lucide-alert-circle mt-0.5 h-4 w-4 shrink-0"></i>
            <span>{{ error }}</span>
          </div>
          {% endif %}
          {% if success %}
          <div class="mb-4 flex items-start gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700" role="alert">
            <i class="lucide lucide-check-circle mt-0.5 h-4 w-4 shrink-0"></i>
            <span>{{ success }}</span>
          </div>
          {% endif %}

          <div class="mb-4 flex items-start gap-3 rounded-2xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-700" role="alert">
            <i class="lucide lucide-info mt-0.5 h-4 w-4 shrink-0"></i>
            <div>
              <strong class="block font-semibold text-sky-800">Completing Verification</strong>
              <p class="mb-0 mt-1 text-xs text-sky-600">After verifying your email, you'll be able to log in to your account.</p>
            </div>
          </div>

          <form method="POST" action="/verify-email" id="verifyForm" novalidate>
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="email" value="{{ email }}">

            <div class="mb-5 space-y-1.5">
              <label for="verification_token" class="block text-sm font-semibold text-slate-700">Verification Token</label>
              <div class="relative">
                <i class="lucide lucide-key absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 pointer-events-none"></i>
                <input type="text"
                  class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-11 py-3.5 text-slate-900 shadow-sm transition focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-500/10 text-center tracking-widest text-lg font-bold"
                  id="verification_token"
                  name="verification_token"
                  value="{{ token }}"
                  placeholder="Enter token from email"
                  maxlength="100"
                  {% if token %}readonly{% else %}required{% endif %}>
              </div>
              <p class="text-xs text-slate-500">
                {% if token %}
                  <i class="lucide lucide-check-circle text-emerald-600 mr-1"></i>Token auto-populated from verification link
                {% else %}
                  Check your email inbox and spam folder for the verification token.
                {% endif %}
              </p>
            </div>

            <button type="submit"
              class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-emerald-600 px-4 py-3.5 text-sm font-semibold text-white shadow-lg shadow-emerald-600/20 transition-all duration-200 hover:-translate-y-0.5 hover:bg-emerald-700 focus:outline-none focus:ring-4 focus:ring-emerald-500/30 active:scale-[0.98]"
              id="submitBtn">
              <span id="btnText"><i class="lucide lucide-mail-check h-5 w-5"></i> Verify Email</span>
              <span id="spinner"
                class="hidden h-5 w-5 animate-spin rounded-full border-2 border-white border-t-transparent"
                role="status" aria-hidden="true"></span>
            </button>
          </form>

          <hr class="my-6 border-slate-200">

          <div class="text-center">
            <p class="mb-3 text-sm text-slate-500">Didn't receive the token?</p>
            <form method="POST" action="/resend-verification-email" id="resendForm">
              <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
              <input type="hidden" name="email" value="{{ email }}">
              <button type="submit"
                class="inline-flex w-full items-center justify-center gap-2 rounded-2xl border-2 border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm transition-all duration-200 hover:bg-slate-50 hover:-translate-y-0.5">
                <i class="lucide lucide-rotate-cw h-4 w-4"></i>
                Resend Verification Token
              </button>
            </form>
          </div>

          <div id="resendTimer"
            class="mt-3 hidden text-center text-sm text-red-500">
            <i class="lucide lucide-hourglass mr-2"></i>Please wait <span id="timerSeconds">60</span> seconds before resending
          </div>

          <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-center text-sm">
            <p class="text-slate-600">
              Wrong email?
              <a href="/register" class="inline-flex items-center gap-1 font-semibold text-emerald-600 hover:text-emerald-700">
                Create new account
                <i class="lucide lucide-arrow-right h-4 w-4"></i>
              </a>
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>

  {# Info cards below form on mobile #}
  <div class="mx-auto mt-6 grid max-w-6xl grid-cols-1 gap-4 px-4 sm:px-6 lg:grid-cols-3 lg:px-8">
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4" role="alert">
      <h6 class="mb-2 flex items-center gap-2 text-sm font-bold text-emerald-800">
        <i class="lucide lucide-zap h-4 w-4"></i>Next Step
      </h6>
      <p class="mb-0 text-xs leading-5 text-emerald-700">
        ✓ Once verified, you'll be redirected to <strong>login</strong> where you can access your account immediately.
      </p>
    </div>
    <div class="rounded-2xl border border-sky-200 bg-sky-50 p-4" role="alert">
      <h6 class="mb-2 flex items-center gap-2 text-sm font-bold text-sky-800">
        <i class="lucide lucide-help-circle h-4 w-4"></i>Why verify?
      </h6>
      <ul class="mb-0 pl-4 text-xs leading-5 text-sky-700">
        <li>Ensures we have your correct email address</li>
        <li>Helps secure your account</li>
        <li>Only takes a few seconds!</li>
      </ul>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4" role="alert">
      <small class="text-xs leading-5 text-slate-600">We respect your privacy. Your email is used only for account security and important notifications.</small>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('verifyForm');
  const btn = document.getElementById('submitBtn');
  const btnText = document.getElementById('btnText');
  const spinner = document.getElementById('spinner');

  if (form) {
    form.addEventListener('submit', function() {
      btn.disabled = true;
      spinner.classList.remove('hidden');
      btnText.innerHTML = 'Verifying...';
    });
  }

  // Resend timer
  const resendForm = document.getElementById('resendForm');
  const resendTimer = document.getElementById('resendTimer');
  const timerSeconds = document.getElementById('timerSeconds');

  if (resendForm) {
    resendForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const formData = new FormData(this);

      fetch('/resend-verification-email', {
        method: 'POST',
        body: formData
      })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          resendForm.style.display = 'none';
          resendTimer.classList.remove('hidden');
          let seconds = 60;
          const countdown = setInterval(() => {
            seconds--;
            timerSeconds.textContent = seconds;
            if (seconds <= 0) {
              clearInterval(countdown);
              resendTimer.classList.add('hidden');
              resendForm.style.display = 'block';
            }
          }, 1000);
        }
      })
      .catch(() => {});
    });
  }
});
</script>
{% endblock %}
