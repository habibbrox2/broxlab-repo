{# Clean Login Template - Polished with Tailwind CSS and Lucide Icons #}
{% extends "layout.twig" %}
{% set suppress_layout_flash = true %}
{% block title %}Login - {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% set page_schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  'name': app_settings.site_name|default('BroxBhai'),
  'url': url
} %}
{% block schema %}
<script type="application/ld+json">
{{ page_schema|schema_json }}
</script>
{% endblock %}
{% block content %}
<div class="relative isolate flex min-h-screen items-center justify-center overflow-hidden bg-slate-50 px-4 py-10 sm:px-6 sm:py-14">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-24 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-indigo-500/15 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 h-80 w-80 rounded-full bg-cyan-500/10 blur-3xl"></div>
    <div class="absolute left-0 top-1/3 h-64 w-64 rounded-full bg-violet-500/10 blur-3xl"></div>
  </div>

  <!-- Brand logo at top -->
  <div class="absolute left-1/2 top-6 -translate-x-1/2 sm:top-8">
    <a href="/" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/80 px-4 py-2 shadow-sm backdrop-blur transition hover:bg-white hover:shadow-md">
      <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-indigo-500 to-violet-600 text-white">
        <i class="lucide lucide-gauge h-4 w-4"></i>
      </div>
      <span class="text-sm font-bold text-slate-900">{{ app_settings.site_name|default("BroxBhai") }}</span>
    </a>
  </div>

  <section class="auth-card scroll-fade-in relative w-full max-w-[440px] overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_24px_80px_-30px_rgba(15,23,42,0.3)]">
    <!-- Decorative top accent bar -->
    <div class="absolute left-0 right-0 top-0 h-1 bg-gradient-to-r from-indigo-500 via-violet-500 to-indigo-400"></div>

    <div class="px-6 pb-2 pt-8 sm:px-8 sm:pt-10">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600 text-white shadow-lg shadow-indigo-500/20">
        <i class="lucide lucide-log-in h-6 w-6"></i>
      </div>
      <div class="text-center">
        <h1 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">Welcome back</h1>
        <p class="mt-2 text-sm leading-6 text-slate-500">Sign in to your account and continue where you left off.</p>
      </div>
    </div>

        <div class="px-6 pb-8 sm:px-8 sm:pb-10">
          {% set oauth_status_message = error|default('') %}
          {% set oauth_status_type_raw = "danger" %}
          {% if oauth_status_message == '' and flash_message %}
            {% set oauth_status_message = flash_message.text|default(flash_message.message|default('')) %}
            {% set oauth_status_type_raw = flash_message.status|default(flash_message.type|default('info')) %}
          {% endif %}
          {% set oauth_status_type = oauth_status_type_raw in ['success', 'danger', 'warning', 'info']
            ? oauth_status_type_raw
            : 'info'
          %}
          <div id="oauth-status"
            class="auth-response auth-response--{{ oauth_status_type }} auth-response-hidden"
            role="status"
            aria-live="polite"
            data-initial-message="{{ oauth_status_message }}"
            data-initial-type="{{ oauth_status_type }}"></div>

          <form method="POST"
            action="/login"
            id="loginForm"
            class="space-y-5"
            data-redirect-url="{{ oauth_redirect }}"
            data-firebase-auth="{{ enable_firebase_oauth ? '1' : '0' }}"
            novalidate>
            <input type="hidden" id="csrf_token" name="csrf_token" value="{{ csrf_token }}">
            {% if oauth_redirect %}
              <input type="hidden" id="redirect_url" name="redirect" value="{{ oauth_redirect }}">
            {% endif %}

            <div class="space-y-1.5">
              <label for="username" class="block text-sm font-semibold text-slate-700">Email or Username</label>
              <div class="relative">
                <i class="lucide lucide-user absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 pointer-events-none"></i>
                <input type="text"
                  class="auth-form-input w-full rounded-2xl border border-slate-200 bg-slate-50 px-11 py-3.5 text-slate-900 shadow-sm transition focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-500/10"
                  id="username"
                  name="username"
                  value="{{ old_username|default(old_email|default('')) }}"
                  placeholder="Enter email or username"
                  autocomplete="username"
                  required>
              </div>
              <p class="text-xs text-slate-500">Use the email or username associated with your account.</p>
            </div>

            <div class="space-y-1.5">
              <label for="password" class="block text-sm font-semibold text-slate-700">Password</label>
              <div class="relative">
                <i class="lucide lucide-lock absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-slate-400 pointer-events-none"></i>
                <input type="password"
                  class="auth-form-input--with-toggle w-full rounded-2xl border border-slate-200 bg-slate-50 px-11 py-3.5 pr-12 text-slate-900 shadow-sm transition focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-500/10"
                  id="password"
                  name="password"
                  placeholder="••••••••"
                  autocomplete="current-password"
                  required>
                <i class="lucide lucide-eye password-toggle-icon absolute right-4 top-1/2 h-5 w-5 -translate-y-1/2 cursor-pointer text-slate-400 transition hover:text-indigo-600"
                  id="passwordToggle"
                  role="button"
                  tabindex="0"
                  aria-label="Show password"
                  aria-controls="password"
                  aria-pressed="false"></i>
              </div>
            </div>

            {% if enable_remember_me %}
            <div class="flex items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
              <div class="flex items-center gap-3">
                <input type="checkbox"
                  class="auth-remember-checkbox h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
                  id="remember_me"
                  name="remember_me">
                <label class="auth-remember-label text-sm font-medium text-slate-700" for="remember_me">Remember me for 30 days</label>
              </div>
              <i class="lucide lucide-clock-3 h-4 w-4 text-slate-400"></i>
            </div>
            {% endif %}

            <button type="submit" class="login-submit-btn inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 px-4 py-3.5 text-sm font-semibold text-white shadow-lg shadow-indigo-600/25 transition-all duration-200 hover:-translate-y-0.5 hover:from-indigo-700 hover:to-violet-700 focus:outline-none focus:ring-4 focus:ring-indigo-500/30 active:scale-[0.98]">
              <i class="lucide lucide-log-in h-5 w-5"></i>
              Sign In
            </button>
          </form>

          {% if enable_firebase_oauth %}
          <div class="my-6 flex items-center gap-3">
            <div class="h-px flex-1 bg-slate-200"></div>
            <div class="inline-flex items-center gap-2 rounded-full bg-slate-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">
              <i class="lucide lucide-sparkles h-3.5 w-3.5 text-indigo-500"></i>
              Continue with
            </div>
            <div class="h-px flex-1 bg-slate-200"></div>
          </div>

          <div id="auth-buttons" class="auth-oauth-buttons grid grid-cols-3 gap-3">
            <button type="button"
              class="auth-oauth-btn group inline-flex h-14 w-full flex-col items-center justify-center gap-1 rounded-2xl border border-slate-200 bg-white text-slate-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50 hover:text-red-600 hover:shadow-md"
              id="auth-google-btn"
              title="Sign in with Google"
              aria-label="Sign in with Google">
              <svg class="h-5 w-5 transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
              <span class="text-[10px] font-semibold uppercase tracking-wide">Google</span>
            </button>
            <button type="button"
              class="auth-oauth-btn group inline-flex h-14 w-full flex-col items-center justify-center gap-1 rounded-2xl border border-slate-200 bg-white text-slate-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-blue-200 hover:bg-blue-50 hover:text-blue-600 hover:shadow-md"
              id="auth-facebook-btn"
              title="Sign in with Facebook"
              aria-label="Sign in with Facebook">
              <svg class="h-5 w-5 transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" fill="#1877F2"/>
              </svg>
              <span class="text-[10px] font-semibold uppercase tracking-wide">Facebook</span>
            </button>
            <button type="button"
              class="auth-oauth-btn group inline-flex h-14 w-full flex-col items-center justify-center gap-1 rounded-2xl border border-slate-200 bg-white text-slate-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900 hover:shadow-md"
              id="auth-guest-btn"
              title="Continue as Guest"
              aria-label="Continue as guest">
              <svg class="h-5 w-5 transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
              <span class="text-[10px] font-semibold uppercase tracking-wide">Guest</span>
            </button>
          </div>

          <div class="auth-buttons auth-buttons-hidden">
            <div id="firebaseui-auth-container"
              class="firebaseui-auth-container"
              {% if oauth_redirect %}data-redirect-url="{{ oauth_redirect }}"{% endif %}></div>
          </div>
          {% endif %}

          <div class="mt-6 space-y-3">
            <a href="/register{% if oauth_redirect %}?redirect={{ oauth_redirect|url_encode }}{% endif %}" class="group inline-flex w-full items-center justify-center gap-2 rounded-2xl border-2 border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm transition-all duration-200 hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700 active:scale-[0.98]">
              <i class="lucide lucide-user-plus h-4 w-4 text-slate-400 transition-colors group-hover:text-indigo-500"></i>
              Create a new account
            </a>
            <a href="/forgot-password" class="group inline-flex w-full items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-medium text-slate-500 transition-colors hover:text-indigo-600">
              <i class="lucide lucide-help-circle h-4 w-4"></i>
              Forgot your password?
            </a>
          </div>
        </div>
      </section>
</div>

{# Login form handler #}
<script type="module" src="{{ asset('/assets/js/dist/auth/login.js') }}"></script>

{# Account conflict resolution modal #}
{% include 'auth/account-conflict-modal.twig' %}
{% endblock %}
