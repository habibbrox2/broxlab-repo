{% extends 'layout.twig' %}

{% block title %}রমজান ক্যালেন্ডার ২০২৬ | {{ app_settings.site_name|default('BroxBhai') }}{% endblock %}

{% set breadcrumbs = [
 { label: 'রমজান ২০২৬', url: '/ramadan-2026', icon: 'calendar-event' }
] %}

{% block content %}
<section class="ramadan-2026-page py-5">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="ramadan-2026-hero text-center rounded-2xl p-4 md:p-5 mb-4">
 <span class="ramadan-2026-chip">রমজান ১৪৪৭ হিজরি</span>
 <h1 class="text-3xl font-bold mt-3 mb-2">রমজান ক্যালেন্ডার ২০২৬</h1>
 <p class="mb-0 text-white-emphasis">
 লাইভ কাউন্টডাউন, বিভাগভিত্তিক সময় সমন্বয় এবং দৈনিক আপডেটসহ সেহরি-ইফতারের পূর্ণ সময়সূচী।
 </p>
 </div>

 <div class="ramadan-2026-widget rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4"
 data-ramadan-widget
 data-ramadan-mode="full"
 data-ramadan-today="{{ 'now'|date('Y-m-d', 'Asia/Dhaka') }}">
 <div class="p-4 md:p-5">
 <div class="flex flex-wrap justify-between items-center gap-3 mb-4">
 <div>
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold ramadan-status-badge" data-ramadan-status>লোড হচ্ছে...</span>
 <h2 class="h4 font-bold mb-0 mt-2" data-ramadan-countdown-title>কাউন্টডাউন লোড হচ্ছে...</h2>
 </div>
 <div class="ramadan-division-wrap">
 <label for="ramadanDivisionSelect" class="block text-sm font-medium text-slate-700 mb-1 font-semibold mb-1">বিভাগ নির্বাচন</label>
 <select id="ramadanDivisionSelect" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 focus:border-indigo-500-sm" data-ramadan-division>
 <option value="Dhaka">ঢাকা (বেস)</option>
 <option value="Chattogram">চট্টগ্রাম (+৫ মিনিট)</option>
 <option value="Sylhet">সিলেট (+৬ মিনিট)</option>
 <option value="Rajshahi">রাজশাহী (-৭ মিনিট)</option>
 <option value="Khulna">খুলনা (-৩ মিনিট)</option>
 <option value="Barishal">বরিশাল (-১ মিনিট)</option>
 <option value="Rangpur">রংপুর (-৬ মিনিট)</option>
 <option value="Mymensingh">ময়মনসিংহ (+০ মিনিট)</option>
 </select>
 </div>
 </div>

 <div class="ramadan-2026-countdown flex items-center justify-center gap-3 gap-md-4 mb-4">
 <div class="count-box text-center">
 <div class="count-num" data-ramadan-hours>০০</div>
 <small>ঘণ্টা</small>
 </div>
 <span class="count-sep">:</span>
 <div class="count-box text-center">
 <div class="count-num" data-ramadan-minutes>০০</div>
 <small>মিনিট</small>
 </div>
 <span class="count-sep">:</span>
 <div class="count-box text-center">
 <div class="count-num" data-ramadan-seconds>০০</div>
 <small>সেকেন্ড</small>
 </div>
 </div>

 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 gap-3">
 <div class="sm:col-span-6 lg:col-span-3">
 <div class="ramadan-stat-box">
 <small>আজকের তারিখ</small>
 <div class="font-bold" data-ramadan-date>--</div>
 </div>
 </div>
 <div class="sm:col-span-6 lg:col-span-3">
 <div class="ramadan-stat-box">
 <small>রোজা</small>
 <div class="font-bold" data-ramadan-roja>--</div>
 </div>
 </div>
 <div class="sm:col-span-6 lg:col-span-3">
 <div class="ramadan-stat-box">
 <small>সেহরি</small>
 <div class="font-bold" data-ramadan-today-sehri>--</div>
 </div>
 </div>
 <div class="sm:col-span-6 lg:col-span-3">
 <div class="ramadan-stat-box">
 <small>ইফতার</small>
 <div class="font-bold" data-ramadan-today-iftar>--</div>
 </div>
 </div>
 </div>
 </div>
 </div>

 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl mb-4">
 <div class="border-b border-slate-200 px-4 py-3 bg-transparent border-0 pt-4 pb-2 flex justify-between items-center">
 <h2 class="h5 font-bold mb-0">পূর্ণাঙ্গ সময়সূচী (রমজান ২০২৬)</h2>
 <span class="text-xs text-slate-500">অফিশিয়াল সময়সূচীর ভিত্তিতে</span>
 </div>
 <div class="p-4 pt-2 px-0 pb-0">
 <div class="overflow-x-auto">
 <table class="w-full text-left text-sm ramadan-2026-table">
 <thead>
 <tr>
 <th class="ps-4">রোজা</th>
 <th>তারিখ</th>
 <th>বার</th>
 <th>সেহরি</th>
 <th class="pe-4">ইফতার</th>
 </tr>
 </thead>
 <tbody data-ramadan-table-body>
 <tr>
 <td colspan="5" class="text-center py-4 text-slate-500">সময়সূচী লোড হচ্ছে...</td>
 </tr>
 </tbody>
 </table>
 </div>
 </div>
 </div>

 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="lg:col-span-5">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl h-full">
 <div class="p-4">
 <h3 class="h5 font-bold mb-3">ডিজিটাল তাসবিহ</h3>
 <div class="ramadan-tasbih-display mb-3" data-ramadan-tasbih-value>০</div>
 <div class="flex flex-wrap gap-2">
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-emerald-600 text-white hover:bg-emerald-700 rounded-full" data-ramadan-tasbih-inc>
 গণনা +১
 </button>
 <button type="button" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition text-slate-600 hover:bg-slate-100 rounded-full" data-ramadan-tasbih-reset>
 রিসেট
 </button>
 </div>
 </div>
 </div>
 </div>
 <div class="lg:col-span-7">
 <div class="rounded-xl border border-slate-200 bg-white shadow-sm border-0 rounded-2xl h-full">
 <div class="p-4">
 <h3 class="h5 font-bold mb-3">দৈনিক দোয়া</h3>
 <div class="ramadan-dua-box mb-3">
 <h4 class="h6 font-bold mb-3">সেহরির দোয়া</h4>
 <div class="ramadan-dua-grid grid-cols-1 gap-4 md:grid-cols-12">
 <span class="ramadan-dua-meta-label">আরবি</span>
 <p class="ramadan-dua-arabic mb-2" dir="rtl" lang="ar">
 وَبِصَوْمِ غَدٍ نَوَيْتُ مِنْ شَهْرِ رَمَضَانَ
 </p>
 </div>
 <div class="ramadan-dua-grid grid-cols-1 gap-4 md:grid-cols-12">
 <span class="ramadan-dua-meta-label">বাংলা অর্থ</span>
 <p class="ramadan-dua-translation mb-2">
 আমি রমজান মাসের আগামী দিনের রোজা রাখার নিয়ত করলাম।
 </p>
 </div>
 <div class="ramadan-dua-grid grid-cols-1 gap-4 md:grid-cols-12">
 <span class="ramadan-dua-meta-label">উচ্চারণ</span>
 <p class="ramadan-dua-translit mb-0 text-xs text-slate-500">
 Nawaytu an asuma ghadam min shahri ramadana al-mubaraki fardal-laka ya Allahu fataqabbal minni.
 </p>
 </div>
 </div>
 <div class="ramadan-dua-box">
 <h4 class="h6 font-bold mb-3">ইফতারের দোয়া</h4>
 <div class="ramadan-dua-grid grid-cols-1 gap-4 md:grid-cols-12">
 <span class="ramadan-dua-meta-label">আরবি</span>
 <p class="ramadan-dua-arabic mb-2" dir="rtl" lang="ar">
 اللَّهُمَّ لَكَ صُمْتُ وَعَلَىٰ رِزْقِكَ أَفْطَرْتُ
 </p>
 </div>
 <div class="ramadan-dua-grid grid-cols-1 gap-4 md:grid-cols-12">
 <span class="ramadan-dua-meta-label">বাংলা অর্থ</span>
 <p class="ramadan-dua-translation mb-2">
 হে আল্লাহ! আমি তোমারই জন্য রোজা রেখেছি এবং তোমারই দেওয়া রিজিক দিয়ে ইফতার করলাম।
 </p>
 </div>
 <div class="ramadan-dua-grid grid-cols-1 gap-4 md:grid-cols-12">
 <span class="ramadan-dua-meta-label">উচ্চারণ</span>
 <p class="ramadan-dua-translit mb-0 text-xs text-slate-500">
 Allahumma laka sumtu wa ala rizqika aftartu.
 </p>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
</section>
{% endblock %}

{% block extra_scripts %}
 <script type="module" src="{{ asset('/assets/js/dist/ramadan-2026.js') }}"></script>
{% endblock %}






