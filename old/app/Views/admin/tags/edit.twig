{% extends "admin/layout.twig" %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block title %}Edit Tag{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4">

 {# ── Gradient Page Header ── #}
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-violet-900 via-purple-900 to-slate-900 p-6 text-white shadow-2xl shadow-violet-900/20 sm:p-8">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
   <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
   <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-purple-300/20 blur-3xl"></div>
  </div>
  <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
   <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 backdrop-blur shadow-sm ring-1 ring-white/10">
     <i class="lucide lucide-pencil text-xl"></i>
    </div>
    <div>
     <h1 class="text-xl font-black tracking-tight sm:text-2xl">Edit Tag</h1>
     <p class="mt-1 text-sm text-violet-200/80">Update tag details.</p>
    </div>
   </div>
   <a href="/admin/tags" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97] self-start sm:self-auto">     <i class="lucide lucide-arrow-left w-3.5 h-3.5"></i> Back to Tags
   </a>
  </div>
 </div>

 {# ── Form Card ── #}
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md max-w-3xl">
  <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-violet-50/50 to-fuchsia-50/50 px-5 py-4">
   <div class="flex h-7 w-7 items-center justify-center rounded-md bg-violet-100 text-violet-600">     <i class="lucide lucide-tag w-4 h-4"></i>
   </div>
   <div>
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">Tag: {{ tag.name }}</h2>
    <p class="text-xs text-slate-500">Edit the tag name and URL slug</p>
   </div>
  </div>
  <div class="p-5 sm:p-6">
   <form method="post" action="/admin/tags/edit/{{ tag.id }}" id="tagForm" class="space-y-5">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="id" value="{{ tag.id }}">

    <div class="space-y-1.5">
     <label class="block text-sm font-semibold text-slate-700">Tag Name <span class="text-red-500">*</span></label>
     <input type="text" name="name" id="tagName" value="{{ tag.name }}" required class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm bg-white text-slate-900 transition-all duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 hover:border-slate-400">
    </div>

    <div class="space-y-1.5">
     <label class="block text-sm font-semibold text-slate-700">URL Slug</label>
     <div class="flex items-center rounded-lg border border-slate-300 overflow-hidden focus-within:ring-2 focus-within:ring-indigo-500/20 focus-within:border-indigo-500 bg-white transition-all duration-200">       <span class="shrink-0 flex items-center px-3 py-2.5 bg-slate-50 border-r border-slate-300 text-slate-400"><i class="lucide lucide-link w-4 h-4"></i></span>
      <input type="text" name="slug" id="tagSlug" value="{{ tag.slug }}" class="w-full border-0 px-4 py-2.5 text-sm focus:outline-none bg-white">
     </div>
     <div id="slug-feedback" class="text-xs text-slate-500 mt-1"></div>
    </div>

    <div class="flex flex-wrap gap-3 pt-2">
     <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 ease-out hover:bg-indigo-700 hover:shadow-md active:scale-95">       <i class="lucide lucide-check w-4 h-4"></i> Update Tag
     </button>
     <a href="/admin/tags" class="inline-flex items-center justify-center gap-2 rounded-lg bg-white border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-900 transition-all duration-200 ease-out hover:bg-slate-50 hover:border-slate-400 active:scale-95">       <i class="lucide lucide-x w-4 h-4"></i> Cancel
     </a>
    </div>
   </form>
  </div>
 </div>
</div>
{% endblock %}
