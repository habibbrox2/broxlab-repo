{% extends"admin/layout.twig" %}
{% block title %}Upload Media - Admin{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
 <div class="w-full px-4 sm:px-6 py-4">
 <!-- Page Header -->
 <div class=" mb-4">
 <div>
 <i class="lucide lucide-image mr-2"></i>
 Upload Media
 </div>
 <div>Upload new media files</div>
 </div>
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
 <div class="lg:col-span-8 mx-auto">
 <!-- Header -->
 <div class="mb-5">
 <h1>
 <i class="lucide lucide-cloud-upload"></i> Upload Media
 </h1>
 <p class="text-slate-500">Upload images, videos, audio files, or documents</p>
 </div>
 <!-- Error/Success Messages -->
 <div id="alertContainer"></div>
 <!-- Upload Form -->
 <div class=" border border-slate-200 bg-white shadow-sm">
 <div class="p-4 p-5">
 <form method="POST"
 action="/admin/media/upload"
 enctype="multipart/form-data"
 id="mediaUploadForm"
 data-max-file-size="{{ max_file_size_bytes|default(52428800) }}">
 <!-- CSRF Token -->
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <!-- File Input -->
 <div class="mb-4">
 <label for="file" class="block text-sm font-medium text-slate-700 mb-1 font-bold">Select Media File</label>
 <div class="upload-area border-2 border-dashed p-5 text-center bg-slate-100 "
 id="uploadArea">
 <i class="lucide lucide-cloud-upload "></i>
 <p class="mt-3 mb-0">
 <strong>Click to browse</strong> or drag and drop files here
 </p>
 <small class="text-slate-500">Max size: {{ max_file_size }}</small>
 </div>
 <input type="file"
 id="file"
 name="file"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 hidden"
 required
 accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx">
 <div id="fileInfo" class="mt-2"></div>
 </div>
 <!-- Media Type Selection -->
 <div class="mb-4">
 <label for="media_type" class="block text-sm font-medium text-slate-700 mb-1 font-bold">Media Type</label>
 <select name="media_type" id="media_type" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
 <option value="image">📸 Image (JPG, PNG, WEBP, GIF)</option>
 <option value="video">🎥 Video (MP4, WEBM, MOV)</option>
 <option value="audio">🎵 Audio (MP3, WAV, OGG)</option>
 <option value="document">📄 Document (PDF, DOC, XLS)</option>
 </select>
 </div>
 <!-- Title -->
 <div class="mb-4">
 <label for="title" class="block text-sm font-medium text-slate-700 mb-1 font-bold">Title (Optional)</label>
 <input type="text"
 id="title"
 name="title"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 placeholder="e.g., Product Photo - Summer 2026">
 <small class="text-slate-500">If not provided, the filename will be used</small>
 </div>
 <!-- Description -->
 <div class="mb-4">
 <label for="description" class="block text-sm font-medium text-slate-700 mb-1 font-bold">Description (Optional)</label>
 <textarea id="description"
 name="description"
 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"
 rows="3"
 placeholder="Add notes about this media file..."></textarea>
 </div>
 <!-- Upload Progress -->
 <div id="uploadProgress" class="mb-4 ">
 <div class="progress ">
 <div class="progress-bar progress-bar-striped progress-bar-animated "
 id="progressBar"
 role="progressbar">
 <span id="progressText">0%</span>
 </div>
 </div>
 <small id="uploadStatus" class="block mt-2 text-slate-500">Preparing upload...</small>
 </div>
 <!-- Buttons -->
 <div class="grid gap-2">
 <button type="submit"
 id="submitBtn"
 class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-indigo-600 text-white hover:bg-indigo-700 px-3 py-1.5 text-xs">
 <i class="lucide lucide-cloud-upload"></i> Upload Media
 </button>
 <a href="/admin/media" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-900 border border-slate-300 hover:bg-slate-200">
 <i class="lucide lucide-arrow-left"></i> Back to Media Library
 </a>
 </div>
 <!-- Accepted Formats -->
 <div class="p-4 rounded-lg bg-indigo-600-50 text-indigo-600-700 border border-primary-200 mt-4 mb-0">
 <strong><i class="lucide lucide-info"></i> Accepted Formats:</strong>
 <ul class="mb-0 mt-2">
 <li>
 <strong>Images:</strong> JPG, PNG, WEBP, GIF (max 50MB)
 </li>
 <li>
 <strong>Videos:</strong> MP4, WEBM, MOV (max 50MB)
 </li>
 <li>
 <strong>Audio:</b> MP3, WAV, OGG (max 50MB)
 </li>
 <li>
 <strong>Documents:</b> PDF, DOC, DOCX, XLS, XLSX (max 50MB)
 </li>
 </ul>
 </div>
 </form>
 </div>
 </div>
 <!-- Recent Uploads (if any) -->
 <div class="mt-5">
 <h5 class="mb-3">Recently Uploaded</h5>
 <div class="p-4 rounded-lg bg-neutral-100 text-neutral-700 border border-neutral-200">
 <p class="mb-0 text-slate-500">Your recently uploaded media will appear here</p>
 </div>
 </div>
 </div>
 </div>
 </div>
 {% endblock %}




