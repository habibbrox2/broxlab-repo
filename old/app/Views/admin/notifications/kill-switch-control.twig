{% extends"admin/layout.twig" %}
{% block title %}Notifications Kill Switch{% endblock %}
{% block content %}
<div class="w-full px-4 sm:px-6 py-4 space-y-4">
    <!-- Gradient Header -->
    <div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-sky-500 via-indigo-500 to-violet-500 p-6 shadow-lg">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"></div>
        <div class="relative flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/20 backdrop-blur-sm">
                <i class="lucide lucide-toggle-right text-2xl text-white"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-white sm:text-3xl">Kill Switch Control</h1>
                <p class="mt-1 text-sm text-indigo-100">Stop or resume notifications in an emergency.</p>
            </div>
        </div>
    </div>

    <!-- Kill Switch Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden max-w-2xl">
        <div class="border-b border-slate-100 bg-gradient-to-r from-red-50/50 to-orange-50/50 px-5 py-4">
            <div class="flex items-center gap-2">
                <i class="lucide lucide-alert-triangle text-red-500" w-[18px] h-[18px]></i>
                <h2 class="text-sm font-semibold text-slate-900">Emergency Controls</h2>
            </div>
        </div>
        <div class="p-5 space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
                <div>
                    <button id="toggleBtn" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition"></button>
                </div>
            </div>
            <div>
                <label for="maintenanceMsg" class="block text-sm font-medium text-slate-700 mb-1">Maintenance message</label>
                <textarea id="maintenanceMsg" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500" rows="3"></textarea>
            </div>
            <div>
                <button id="saveBtn" class="inline-flex items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700"><i class="lucide lucide-save"></i> Save</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}
