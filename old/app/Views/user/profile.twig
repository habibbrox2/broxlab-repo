{% extends"layout.twig" %}
{% block title %}My Profile - {{ app_settings.site_name|default("BroxBhai") }}{% endblock %}
{% block content %}
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
 <!-- Page Header -->
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-900 to-violet-900 p-6 text-white shadow-2xl shadow-indigo-900/20 sm:p-8">
   <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
     <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/20 blur-3xl"></div>
     <div class="absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-violet-300/20 blur-3xl"></div>
   </div>
   <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
     <div class="flex items-center gap-4">
       <div class="relative shrink-0">
         {% if user.profile_pic %}
         <img src="{{ user.profile_pic }}" alt="Profile" class="h-16 w-16 rounded-full border-2 border-white/20 object-cover shadow-lg ring-2 ring-white/10 sm:h-20 sm:w-20">
         {% else %}
         <img src="/assets/images/default-avatar.png" alt="Default Avatar"
              width="80" height="80"
              class="h-16 w-16 rounded-full border-2 border-white/20 object-cover shadow-lg ring-2 ring-white/10 sm:h-20 sm:w-20">
         {% endif %}
         <div class="absolute -bottom-0.5 -right-0.5 flex h-5 w-5 items-center justify-center rounded-full border-2 border-slate-900 bg-emerald-500 shadow-sm" aria-label="Active">
           <i class="lucide lucide-check" style="width:0.75em;height:0.75em;color:white;"></i>
         </div>
       </div>
       <div>
         <h1 class="text-xl font-black tracking-tight sm:text-2xl">{{ user.first_name ~ ' ' ~ user.last_name }}</h1>
         <p class="mt-1 text-sm text-indigo-200/80">
           <i class="lucide lucide-at-sign" style="width:0.875em;height:0.875em;"></i> {{ user.username }}
         </p>
         {% if auth_user.roles is not empty %}
         <div class="mt-2 flex flex-wrap gap-1.5">
           {% for role in auth_user.roles %}
           <span class="inline-flex items-center gap-1 rounded-full border border-indigo-300/30 bg-white/10 px-2.5 py-0.5 text-xs font-medium text-indigo-100 backdrop-blur">
             <i class="lucide lucide-shield-check" style="width:0.75em;height:0.75em;"></i>
             {{ role|replace({"_":""}) |title }}
           </span>
           {% endfor %}
         </div>
         {% endif %}
       </div>
     </div>
     <div class="flex flex-wrap gap-2">
       <a href="/profile/edit" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
         <i class="lucide lucide-pencil" style="width:0.875em;height:0.875em;"></i> Edit Profile
       </a>
       <a href="/profile/password" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
         <i class="lucide lucide-key" style="width:0.875em;height:0.875em;"></i> Password
       </a>
       <a href="/user/security/2fa" class="inline-flex items-center gap-1.5 rounded-xl bg-white/10 px-4 py-2 text-xs font-semibold text-white shadow-sm backdrop-blur transition-all duration-200 hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.97]">
         <i class="lucide lucide-shield" style="width:0.875em;height:0.875em;"></i> 2FA
       </a>
     </div>
   </div>
 </div>
 <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
 <!-- Left Column -->
 <div class="lg:col-span-1">
 <!-- Contact Information -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-4 transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-100 text-indigo-600">
 <i class="lucide lucide-user" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">Contact Information</h5>
 </div>
 <div class="p-5">
 <div class="mb-3">
 <label class="text-neutral-500 text-xs block mb-1">Email Address</label>
 <div class="flex items-center">
 <i class="lucide lucide-mail text-indigo-600 mr-2"></i>
 <span class="text-break">{{ user.email }}</span>
 </div>
 </div>
 <div class="mb-3">
 <label class="text-neutral-500 text-xs block mb-1">Phone Number</label>
 <div class="flex items-center">
 <i class="lucide lucide-phone text-indigo-600 mr-2"></i>
 <span>{{ user.phone|default("Not provided") }}</span>
 </div>
 </div>
 <div class="mb-0">
 <label class="text-neutral-500 text-xs block mb-1">Account Status</label>
 <div class="flex items-center">
 <i class="lucide lucide-shield-check text-emerald-600 mr-2"></i>
 <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-200">{{ user.status|title }}</span>
 </div>
 </div>
 </div>
 </div>
 <!-- Social Links -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-4 transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-sky-100 text-sky-600">
 <i class="lucide lucide-share-2" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">Social Profiles</h5>
 </div>
 <div class="p-5">
 {% set social_links = [
 {name: 'Facebook', url: user.facebook_url, icon: 'facebook', color: '#1877f2'},
 {name: 'Twitter', url: user.twitter_url, icon: 'twitter-x', color: '#000000'},
 {name: 'Instagram', url: user.instagram_url, icon: 'instagram', color: '#e4405f'},
 {name: 'LinkedIn', url: user.linkedin_url, icon: 'linkedin', color: '#0a66c2'}
 ] %}
 {% for social in social_links %}
 <div class="flex items-center justify-between mb-3 pb-3 {% if not loop.last %}border-b border-slate-100{% endif %}">
 <div class="flex items-center">
 <div class="rounded-full p-2 mr-3"
 style="background-color: {{ social.color }}15">
 <i class="lucide lucide-{{ social.icon }}"
 style="color: {{ social.color }};
 font-size: 1.2rem"></i>
 </div>
 <span class="font-medium">{{ social.name }}</span>
 </div>
 {% if social.url %}
 <a href="{{ social.url }}"
 target="_blank"
 class="inline-flex items-center px-3 py-1.5 rounded-lg border border-neutral-300 text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition-colors">
 <i class="lucide lucide-external-link"></i>
 </a>
 {% else %}
 <span class="text-neutral-500 text-xs">Not linked</span>
 {% endif %}
 </div>
 {% endfor %}
 </div>
 </div>
 </div>
 <!-- Right Column -->
 <div class="lg:col-span-2">
 <!-- Personal Information -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-4 transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-100 text-indigo-600">
 <i class="lucide lucide-info" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">Personal Information</h5>
 </div>
 <div class="p-5">
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">First Name</label>
 <p class="mb-0 font-medium">{{ user.first_name|default("N/A") }}</p>
 </div>
 </div>
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">Last Name</label>
 <p class="mb-0 font-medium">{{ user.last_name|default("N/A") }}</p>
 </div>
 </div>
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">Gender</label>
 <p class="mb-0 font-medium">{{ user.gender|default("N/A") |title }}</p>
 </div>
 </div>
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">Date of Birth</label>
 <p class="mb-0 font-medium">{{ user.dob ? user.dob|date("F j, Y") : 'N/A' }}</p>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Address Information -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm mb-4 transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-100 text-amber-600">
 <i class="lucide lucide-map-pin" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">Address</h5>
 </div>
 <div class="p-5">
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
 <div class="md:col-span-2">
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">Street Address</label>
 <p class="mb-0 font-medium">{{ user.address|default("N/A") }}</p>
 </div>
 </div>
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">City</label>
 <p class="mb-0 font-medium">{{ user.city|default("N/A") }}</p>
 </div>
 </div>
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">State / Province</label>
 <p class="mb-0 font-medium">{{ user.state|default("N/A") }}</p>
 </div>
 </div>
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">Country</label>
 <p class="mb-0 font-medium">{{ user.country|default("N/A") }}</p>
 </div>
 </div>
 <div>
 <div class="info-item">
 <label class="text-neutral-500 text-xs block mb-1">Zip / Postal Code</label>
 <p class="mb-0 font-medium">{{ user.zipcode|default("N/A") }}</p>
 </div>
 </div>
 </div>
 </div>
 </div>
 <!-- Login Activity -->
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
 <i class="lucide lucide-history" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">Login Activity</h5>
 </div>
 <div class="p-5">
 <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
 <div>
 <div class="p-3 bg-neutral-50 rounded-lg">
 <div class="flex items-center mb-2">
 <i class="lucide lucide-calendar-check text-indigo-600 mr-2"></i>
 <label class="text-neutral-500 text-sm mb-0">Last Login</label>
 </div>
 <p class="mb-0 font-medium">{{ user.last_login ? user.last_login|date("M j, Y") : 'Never' }}</p>
 <small class="text-neutral-500">{{ user.last_login ? user.last_login|date("h:i A") : '' }}</small>
 </div>
 </div>
 <div>
 <div class="p-3 bg-neutral-50 rounded-lg">
 <div class="flex items-center mb-2">
 <i class="lucide lucide-router text-indigo-600 mr-2"></i>
 <label class="text-neutral-500 text-sm mb-0">IP Address</label>
 </div>
 <p class="mb-0 font-medium">{{ user.login_ip|default("N/A") }}</p>
 </div>
 </div>
 <div>
 <div class="p-3 bg-neutral-50 rounded-lg">
 <div class="flex items-center mb-2">
 <i class="lucide lucide-hard-drive text-indigo-600 mr-2"></i>
 <label class="text-neutral-500 text-sm mb-0">Device</label>
 </div>
 <p class="mb-0 font-medium">{{ user.login_device|default("N/A") }}</p>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <script>
 // Initialize tooltips
 var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-brox-toggle="tooltip"]'))
 var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
 return new broxUI.Tooltip(tooltipTriggerEl)
 })
 </script>
{% endblock %}




