{% extends"layout.twig" %}
{% block title %}Setup Two-Factor Authentication{% endblock %}
{% block content %}
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
 <!-- Page Header -->
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-emerald-500/20 via-emerald-50 to-white p-6 sm:p-8">
   <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
     <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-emerald-400/30 blur-3xl"></div>
     <div class="absolute -bottom-10 -left-10 h-32 w-32 rounded-full bg-teal-400/20 blur-3xl"></div>
   </div>
   <div class="relative">
     <nav aria-label="breadcrumb" class="mb-2">
       <ol class="flex items-center gap-2 text-sm text-slate-500 list-none p-0 m-0">
         <li><a href="/profile" class="text-indigo-600 hover:text-indigo-800 transition-colors no-underline">Profile</a></li>
         <li class="before:content-['/'] before:mx-2 before:text-slate-300"><a href="/user/security/2fa" class="text-indigo-600 hover:text-indigo-800 transition-colors no-underline">2FA Settings</a></li>
         <li class="before:content-['/'] before:mx-2 before:text-slate-300" aria-current="page">Setup</li>
       </ol>
     </nav>
     <div class="flex items-center gap-2.5">
       <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-600 text-white shadow-lg shadow-emerald-600/20">
         <i class="lucide lucide-shield" style="width:1.25em;height:1.25em;"></i>
       </div>
       <div>
         <h1 class="text-xl font-black tracking-tight text-slate-900 sm:text-2xl">2FA সেটআপ করুন</h1>
         <p class="mt-0.5 text-sm text-slate-500">নিচের ধাপগুলি অনুসরণ করে আপনার অ্যাকাউন্টে 2FA সক্ষম করুন।</p>
       </div>
     </div>
   </div>
 </div>
 <div class="max-w-2xl mx-auto">
 <div class="scroll-fade-in overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-emerald-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600">
 <i class="lucide lucide-shield" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">2FA সেটআপ করুন</h5>
 </div>
 <div class="p-5">
 <div class="p-4 rounded-lg bg-sky-50 text-sky-700 border border-sky-200" role="alert">
 <i class="lucide lucide-info"></i>
 <strong>ধাপ-দ্বি-ধাপ নির্দেশাবলী অনুসরণ করুন</strong>
 </div>
 <!-- Step 1 -->
 <div class="step mb-5">
 <h5 class="step-title">
 <span class="inline-flex items-center px-2 py-1 rounded-full bg-green-100 text-green-800 text-xs font-semibold">ধাপ ১</span> Authenticator অ্যাপ ডাউনলোড করুন
 </h5>
 <p class="mt-3">
 নিম্নোক্ত অ্যাপগুলির যেকোনো একটি ডাউনলোড করুন:
 </p>
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-3">
 <div>
 <ul>
 <li>
 <strong>Google Authenticator</strong> (সুপারিশকৃত)
 </li>
 <li>
 <strong>Microsoft Authenticator</strong>
 </li>
 <li>
 <strong>Authy</strong>
 </li>
 </ul>
 </div>
 <div>
 <ul>
 <li>
 <strong>LastPass Authenticator</strong>
 </li>
 <li>
 <strong>FreeOTP</strong>
 </li>
 <li>
 <strong>AndOTP</strong>
 </li>
 </ul>
 </div>
 </div>
 </div>
 <hr>
 <!-- Step 2 -->
 <div class="step mb-5">
 <h5 class="step-title">
 <span class="inline-flex items-center px-2 py-1 rounded-full bg-green-100 text-green-800 text-xs font-semibold">ধাপ ২</span> QR কোড স্ক্যান করুন
 </h5>
 <p class="mt-3">
 আপনার Authenticator অ্যাপে নতুন অ্যাকাউন্ট যোগ করুন এবং নিচের QR কোড স্ক্যান করুন:
 </p>
 {% if qr_image %}
 <div class="qr-container text-center mt-4 mb-4">
 <img src="{{ qr_image }}" alt="2FA QR Code" class="mx-auto max-w-xs">
 <p class="mt-2 text-neutral-500 text-sm">
 <i class="lucide lucide-camera"></i> আপনার অ্যাপ দিয়ে এই QR কোড স্ক্যান করুন
 </p>
 </div>
 {% else %}
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200">
 QR কোড জেনারেট করা যায়নি। নিচে ম্যানুয়াল এন্ট্রি ব্যবহার করুন।
 </div>
 {% endif %}
 <!-- Manual Entry Option -->
 <div class="p-4 rounded-lg bg-neutral-100 text-neutral-700 border border-neutral-200 mt-4">
 <p class="mb-2">
 <strong>QR কোড স্ক্যান করতে পারছেন না?</strong>
 নিচের সিক্রেট কী ম্যানুয়ালি যোগ করুন:
 </p>
 <div class="flex">
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm font-bold focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="secretKey"
 value="{{ secret }}"
 readonly>
 <button class="inline-flex items-center px-4 py-2 rounded-lg border border-neutral-300 text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition-colors"
 type="button"
 id="copyBtn"
 title="কপি করুন">
 <i class="lucide lucide-clipboard"></i>
 </button>
 </div>  <small class="text-xs text-neutral-400 mt-2">
   <strong>যোগ করার সময়:</strong>
   <ul class="mb-0 mt-2">
    <li>
     <strong>Account Name:</strong> {{ user.email }}
    </li>
    <li>
     <strong>Key:</strong> {{ secret }}
    </li>
    <li>
     <strong>Type:</strong> Time-based (TOTP)
    </li>
    <li>
     <strong>Algorithm:</strong> SHA-1
    </li>
   </ul>
  </small>
 </div>
 </div>
 <hr>
 <!-- Step 3 -->
 <div class="step mb-5">
 <h5 class="step-title">
 <span class="inline-flex items-center px-2 py-1 rounded-full bg-green-100 text-green-800 text-xs font-semibold">ধাপ ৩</span> যাচাইকরণ কোড প্রদান করুন
 </h5>
 <p class="mt-3">
 আপনার Authenticator অ্যাপ এ ছয়-অঙ্কের কোড দেখবেন। সেটি নিচে প্রবেশ করুন:
 </p>
 <form method="POST" action="/user/security/2fa/verify" class="mt-4">
 <div class="mb-3">
 <label for="code" class="font-semibold">6-Digit Code:</label>
 <input type="text"
 class="w-full rounded-lg border border-slate-300 px-4 py-3 text-base text-center focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary"
 id="code"
 name="code"
 maxlength="6"
 placeholder="000000"
 inputmode="numeric"
 pattern="[0-9]{6}"
 autocomplete="off"
 required
 autofocus>  <small class="text-xs text-neutral-400 mt-2">
    <i class="lucide lucide-clock"></i> কোড প্রতি ৩০ সেকেন্ডে পরিবর্তিত হয়
   </small>
 </div>
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <button type="submit" class="w-full inline-flex items-center justify-center px-5 py-3 rounded-lg bg-green-600 text-white text-base font-medium hover:bg-green-700 transition-colors mt-4">
 <i class="lucide lucide-check"></i> যাচাই করুন এবং সক্ষম করুন
 </button>
 </form>
 <a href="/user/security/2fa"
 class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-lg border border-neutral-300 text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition-colors mt-2">বাতিল করুন</a>
 </div>
 <hr>
 <!-- Important Notes -->
 <div class="p-4 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 mt-5" role="alert">
 <strong><i class="lucide lucide-alert-triangle"></i> গুরুত্বপূর্ণ:</strong>
 <ul class="mb-0 mt-2">
 <li>আপনার সিক্রেট কী নিরাপদ জায়গায় রাখুন</li>
 <li>
 সফলভাবে যাচাইয়ের পরে, ব্যাকআপ কোড সংরক্ষণ করুন
 </li>
 <li>
 আপনার ফোন হারিয়ে গেলে এই কোডগুলি অ্যাক্সেস পাবেন
 </li>
 </ul>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 <script>
// Copy সিক্রেট কী ফাংশন
document.getElementById('copyBtn').addEventListener('click', function() {
 const secretKey = document.getElementById('secretKey');
 secretKey.select();
 document.execCommand('copy');

 const btn = this;
 const originalHTML = btn.innerHTML;
 btn.innerHTML = '<i class="lucide lucide-check"></i>';
 btn.disabled = true;

 setTimeout(() => {
 btn.innerHTML = originalHTML;
 btn.disabled = false;
 }, 2000);
});

// শুধুমাত্র সংখ্যা প্রবেশ করুন
document.getElementById('code').addEventListener('input', function(e) {
 this.value = this.value.replace(/[^0-9]/g, '');
});
 </script>
{% endblock %}





