{% extends"layout.twig" %}
{% block title %}Change Password{% endblock %}
{% block content %}
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5">
 <!-- Page Header -->
 <div class="scroll-fade-in relative mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-600/10 via-indigo-50 to-white p-6 sm:p-8">
   <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
     <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-indigo-400/30 blur-3xl"></div>
     <div class="absolute -bottom-10 -left-10 h-32 w-32 rounded-full bg-violet-400/20 blur-3xl"></div>
   </div>
   <div class="relative">
     <nav aria-label="breadcrumb" class="mb-2">
       <ol class="flex items-center gap-2 text-sm text-slate-500 list-none p-0 m-0">
         <li><a href="/profile" class="text-indigo-600 hover:text-indigo-800 transition-colors">Profile</a></li>
         <li class="before:content-['/'] before:mr-2 before:text-slate-300" aria-current="page">Change Password</li>
       </ol>
     </nav>
     <div class="flex items-center gap-2.5">
       <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-white shadow-lg shadow-indigo-600/20">
         <i class="lucide lucide-key" style="width:1.25em;height:1.25em;"></i>
       </div>
       <div>
         <h1 class="text-xl font-black tracking-tight text-slate-900 sm:text-2xl">Update Password</h1>
         <p class="mt-0.5 text-sm text-slate-500">Keep your account secure by updating your password regularly.</p>
       </div>
     </div>
   </div>
 </div>
 <!-- Password Form Card -->
 <div class="scroll-fade-in mx-auto max-w-2xl">
 <div class="overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-shadow hover:shadow-md">
 <div class="flex items-center gap-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
 <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-100 text-amber-600">
 <i class="lucide lucide-lock" style="width:1.125em;height:1.125em;"></i>
 </div>
 <h5 class="text-sm font-bold text-slate-900">Change Password</h5>
 </div>
 <div class="p-6">
 <form method="POST" action="/profile/password">
 <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
 <div class="mb-4">
 <label for="current_password" class="block text-sm font-semibold text-slate-700 mb-1.5">Current Password</label>
 <div class="relative">
   <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
     <i class="lucide lucide-lock" style="width:1em;height:1em;"></i>
   </span>
   <input type="password"
     class="w-full rounded-lg border border-slate-300 pl-10 pr-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all"
     id="current_password" name="current_password" placeholder="Enter current password" required>
 </div>
 </div>
 <div class="mb-4">
 <label for="new_password" class="block text-sm font-semibold text-slate-700 mb-1.5">New Password</label>
 <div class="relative">
   <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
     <i class="lucide lucide-key" style="width:1em;height:1em;"></i>
   </span>
   <input type="password"
     class="w-full rounded-lg border border-slate-300 pl-10 pr-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all"
     id="new_password" name="new_password" placeholder="Enter new password" required>
 </div>
 </div>
 <div class="mb-6">
 <label for="confirm_password" class="block text-sm font-semibold text-slate-700 mb-1.5">Confirm New Password</label>
 <div class="relative">
   <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
     <i class="lucide lucide-key" style="width:1em;height:1em;"></i>
   </span>
   <input type="password"
     class="w-full rounded-lg border border-slate-300 pl-10 pr-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all"
     id="confirm_password" name="confirm_password" placeholder="Confirm new password" required>
 </div>
 </div>
 <div class="flex items-center gap-3">
 <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 hover:-translate-y-0.5 active:scale-[0.97]">
 <i class="lucide lucide-key" style="width:1em;height:1em;"></i> Change Password
 </button>
 <a href="/profile" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-5 py-2.5 text-sm font-medium text-slate-600 transition-all hover:bg-slate-50 hover:-translate-y-0.5">
 <i class="lucide lucide-x-circle" style="width:1em;height:1em;"></i> Cancel
 </a>
 </div>
 </form>
 </div>
 </div>
 </div>
 </div>
{% endblock %}



