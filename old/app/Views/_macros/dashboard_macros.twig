 Version: 2.0 — Modern, Compact, Accessible
 ============================ #}

{# ── Modern Status Badge ── #}
{% macro status_badge(status) %}
 {% set s = status|lower %}
 {% set badge_map = {
  'approved': 'bg-emerald-50 text-emerald-700', 'active': 'bg-emerald-50 text-emerald-700', 'success': 'bg-emerald-50 text-emerald-700',
  'pending': 'bg-amber-50 text-amber-700', 'in review': 'bg-amber-50 text-amber-700',
  'processing': 'bg-sky-50 text-sky-700',
  'rejected': 'bg-rose-50 text-rose-700', 'inactive': 'bg-rose-50 text-rose-700', 'failed': 'bg-rose-50 text-rose-700', 'banned': 'bg-rose-50 text-rose-700'
 } %}
 {% set classes = badge_map[s]|default('bg-slate-100 text-slate-600') %}
 <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold {{ classes }}">{{ status }}</span>
{% endmacro %}

