{#
 Flash Message Macro - SweetAlert2 Edition
 Global behavior:
 - JS-enabled clients: SweetAlert2 via window.__INITIAL_FLASH
 - No-JS clients: HTML fallback alert
#}

{% macro render_flash(flash_data) %}
 {% if flash_data %}
 {% set message = flash_data.text | default(flash_data.message | default('')) %}
 {% set status = flash_data.status | default(flash_data.type | default('info')) %}
 {% if status == 'error' %}{% set status = 'danger' %}{% endif %}

 {% if message %}
 <script>
 (function () {
 var flashItem = {
 text: {{ message | json_encode | raw }},
 status: {{ status | json_encode | raw }},
 duration: 5000
 };

 if (!Array.isArray(window.__INITIAL_FLASH_QUEUE)) {
 window.__INITIAL_FLASH_QUEUE = [];
 }

 window.__INITIAL_FLASH_QUEUE.push(flashItem);
 if (!window.__INITIAL_FLASH) {
 window.__INITIAL_FLASH = flashItem;
 }
 })();
 </script>

 <noscript>
 <div class="p-4 rounded-lg border mb-4 flex items-start gap-3 {% if status == 'success' %}bg-emerald-50 text-emerald-800 border-emerald-200{% elseif status == 'danger' %}bg-red-50 text-red-800 border-red-200{% elseif status == 'warning' %}bg-amber-50 text-amber-800 border-amber-200{% else %}bg-sky-50 text-sky-800 border-sky-200{% endif %}"
 role="alert"
 aria-live="polite"
 aria-atomic="true">
 <i class="lucide {% if status == 'success' %}lucide-check-circle{% elseif status == 'danger' %}lucide-alert-triangle{% elseif status == 'warning' %}lucide-alert-circle{% else %}lucide-info{% endif %} mt-0.5 flex-shrink-0" aria-hidden="true"></i>
 <span class="flex-1">{{ message }}</span>
 </div>
 </noscript>
 {% endif %}
 {% endif %}
{% endmacro %}

{% macro render_flash_html_only(flash_data) %}
 {% if flash_data %}
 {% set message = flash_data.text | default(flash_data.message | default('')) %}
 {% set status = flash_data.status | default(flash_data.type | default('info')) %}
 {% if status == 'error' %}{% set status = 'danger' %}{% endif %}

 {% if message %}
 <div class="p-4 rounded-lg border mb-4 flex items-start gap-3 {% if status == 'success' %}bg-emerald-50 text-emerald-800 border-emerald-200{% elseif status == 'danger' %}bg-red-50 text-red-800 border-red-200{% elseif status == 'warning' %}bg-amber-50 text-amber-800 border-amber-200{% else %}bg-sky-50 text-sky-800 border-sky-200{% endif %}"
 role="alert"
 aria-live="polite"
 aria-atomic="true">
 <i class="lucide {% if status == 'success' %}lucide-check-circle{% elseif status == 'danger' %}lucide-alert-triangle{% elseif status == 'warning' %}lucide-alert-circle{% else %}lucide-info{% endif %} mt-0.5 flex-shrink-0" aria-hidden="true"></i>
 <span class="flex-1">{{ message }}</span>
 <button type="button" class="inline-flex h-6 w-6 items-center justify-center rounded border-0 bg-transparent text-neutral-500 transition hover:bg-neutral-100 hover:text-neutral-800" data-brox-dismiss="alert" aria-label="Close">&times;</button>
 </div>
 {% endif %}
 {% endif %}
{% endmacro %}

