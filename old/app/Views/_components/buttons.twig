{# ============================================================================
 BUTTONS — Reusable button component macros
 Usage: {% import '_components/buttons.twig' as btns %}
 {{ btns.primary({ text: 'Save', icon: 'save', size: 'sm' }) }}
 {{ btns.secondary({ text: 'Cancel', class: 'ml-2' }) }}
 ============================================================================ #}

{# ── Base button macro (internal) ── #}
{% macro _base(opts) %}
 {%- set text = opts.text|default('Button') -%}
 {%- set icon = opts.icon|default(null) -%}
 {%- set size = opts.size|default('md') -%}
 {%- set class = opts.class|default('') -%}
 {%- set attrs = opts.attrs|default('') -%}
 {%- set type = opts.type|default('button') -%}
 {%- set disabled = opts.disabled|default(false) -%}
 {%- set loading = opts.loading|default(false) -%}
 
 {%- set sizeClass = size == 'sm' ? 'px-3 py-1.5 text-xs min-h-[36px]' 
 : size == 'lg' ? 'px-5 py-2.5 text-base min-h-[52px]' 
 : size == 'xl' ? 'px-6 py-3 text-lg min-h-[56px]'
 : 'px-4 py-2 text-sm min-h-[44px]' -%}

 {%- set baseClass = 'inline-flex items-center justify-center gap-1.5 font-semibold leading-tight rounded-lg transition-all duration-150 cursor-pointer no-underline select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 hover:-translate-y-0.5 active:translate-y-0' -%}
 {%- set disabledClass = disabled ? 'opacity-50 cursor-not-allowed pointer-events-none' : '' -%}

 <button type="{{ type }}"
	 class="{{ baseClass }} {{ sizeClass }} {{ class }} {{ disabledClass }}"
	 {% if disabled %}disabled{% endif %}
	 {{ attrs|raw }}>
 {% if icon %}<i class="lucide lucide-{{ icon }} w-4 h-4"></i>{% endif %}
 {{ loading ? '<span class="animate-spin w-4 h-4 border-2 border-current border-r-transparent rounded-full mr-1"></span>' : '' }}
 {{ text }}
 </button>
{% endmacro %}

{# ── Primary button (gradient indigo) ── #}
{% macro primary(opts) %}
 {% set _ = opts|merge({ class: (opts.class|default('') ~ ' bg-gradient-to-r from-indigo-500 to-indigo-600 text-white shadow-md hover:shadow-lg')|trim }) %}
 {{ _self._base(_) }}
{% endmacro %}

{# ── Secondary / outline button ── #}
{% macro secondary(opts) %}
 {% set _ = opts|merge({ class: (opts.class|default('') ~ ' text-indigo-600 border border-indigo-300 bg-transparent hover:bg-indigo-50 hover:border-indigo-400')|trim }) %}
 {{ _self._base(_) }}
{% endmacro %}

{# ── Ghost / subtle button ── #}
{% macro ghost(opts) %}
 {% set _ = opts|merge({ class: (opts.class|default('') ~ ' text-slate-600 bg-transparent border-transparent hover:bg-slate-100 hover:text-slate-800')|trim }) %}
 {{ _self._base(_) }}
{% endmacro %}

{# ── Success button ── #}
{% macro success(opts) %}
 {% set _ = opts|merge({ class: (opts.class|default('') ~ ' bg-emerald-600 hover:bg-emerald-700 text-white')|trim }) %}
 {{ _self._base(_) }}
{% endmacro %}

{# ── Danger button ── #}
{% macro danger(opts) %}
 {% set _ = opts|merge({ class: (opts.class|default('') ~ ' bg-red-600 hover:bg-red-700 text-white')|trim }) %}
 {{ _self._base(_) }}
{% endmacro %}

{# ── Icon-only button ── #}
{% macro icon(opts) %}
 {% set _ = opts|merge({ 
 class: (opts.class|default('') ~ ' w-11 h-11 p-0 justify-center'),
 text: '',
 size: opts.size|default('md')
 }) %}
 {{ _self._base(_) }}
{% endmacro %}

{# ── Button group wrapper ── #}
{% macro group(opts) %}
 {% set class = opts.class|default('') %}
 {% set direction = opts.direction|default('horizontal') %}
 {% set dirClass = direction == 'vertical' ? 'flex flex-col' : 'flex flex-wrap items-center' %}
 <div class="inline-flex {{ dirClass }} gap-2 {{ class }}">
 {{ opts.content|raw }}
 </div>
{% endmacro %}

{# ── Link styled as button ── #}
{% macro link(opts) %}
 {%- set href = opts.href|default('#') -%}
 {%- set text = opts.text|default('Link') -%}
 {%- set icon = opts.icon|default(null) -%}
 {%- set variant = opts.variant|default('primary') -%}
 {%- set class = opts.class|default('') -%}
 
 {% set variantClass = variant == 'primary' ? 'bg-gradient-to-r from-indigo-500 to-indigo-600 text-white shadow-md hover:shadow-lg' 
 : variant == 'secondary' ? 'text-indigo-600 border border-indigo-300 bg-transparent hover:bg-indigo-50'
 : variant == 'ghost' ? 'text-slate-600 bg-transparent border-transparent hover:bg-slate-100'
 : 'bg-gradient-to-r from-indigo-500 to-indigo-600 text-white' %}
 
 <a href="{{ href }}" 
	 class="inline-flex items-center justify-center gap-1.5 px-4 py-2 text-sm font-semibold leading-tight rounded-lg transition-all duration-150 cursor-pointer no-underline select-none hover:-translate-y-0.5 active:translate-y-0 min-h-[44px] {{ variantClass }} {{ class }}">
 {% if icon %}<i class="lucide lucide-{{ icon }} w-4 h-4"></i>{% endif %}
 {{ text }}
 </a>
{% endmacro %}



