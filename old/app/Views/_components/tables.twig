{# ============================================================================
 TABLES — Reusable table component macros
 Usage: {% import '_components/tables.twig' as table %}
 {{ table.start({ class: 'mb-4' }) }}
 {{ table.header(['Name', 'Email', 'Role', 'Actions']) }}
 {{ table.row([user.name, user.email, 'Admin', actionButtons]) }}
 {{ table.end() }}
 ============================================================================ #}

{# ── Table wrapper ── #}
{% macro start(opts) %}
 {% set class = opts.class|default('') %}
 {% set responsive = opts.responsive|default(true) %}
 {% set bordered = opts.bordered|default(true) %}
 {% set hover = opts.hover|default(true) %}

 {% set wrapClass = responsive ? 'overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm' : '' %}

 <div class="{{ wrapClass }} {{ class }}">
 <table class="w-full border-collapse text-slate-800">
 {% if opts.header %}
 <thead class="bg-slate-50 border-b-2 border-slate-200">
 <tr>
 {% for col in opts.header %}
 <th class="px-5 py-4 text-left font-semibold text-slate-800 whitespace-nowrap tracking-wide">{{ col }}</th>
 {% endfor %}
 </tr>
 </thead>
 {% endif %}
 <tbody>
{% endmacro %}

{# ── Table end ── #}
{% macro end() %}
 </tbody>
 </table>
 </div>
{% endmacro %}

{# ── Table header grid grid-cols-1 gap-4 md:grid-cols-12 ── #}
{% macro header(columns) %}
 <thead class="bg-slate-50 border-b-2 border-slate-200">
 <tr>
 {% for col in columns %}
 <th class="px-5 py-4 text-left font-semibold text-slate-800 whitespace-nowrap tracking-wide">{{ col }}</th>
 {% endfor %}
 </tr>
 </thead>
{% endmacro %}

{# ── Table body row ── #}
{% macro row(columns, opts) %}
 {% set class = opts.class|default('') %}
 <tr class="border-b border-slate-200 transition-colors duration-150 hover:bg-slate-50 {{ class }}">
 {% for col in columns %}
 <td class="px-5 py-4 text-slate-700 align-middle">{{ col }}</td>
 {% endfor %}
 </tr>
{% endmacro %}

{# ── Empty state ── #}
{% macro empty(opts) %}
 {% set colspan = opts.colspan|default(1) %}
 {% set message = opts.message|default('No data found.') %}
 {% set icon = opts.icon|default('inbox') %}
 <tr>
 <td colspan="{{ colspan }}" class="px-5 py-12 text-center">
 <div class="flex flex-col items-center gap-3 text-slate-400">
 <i class="lucide lucide-{{ icon }} w-12 h-12 opacity-30"></i>
 <p class="text-sm">{{ message }}</p>
 </div>
 </td>
 </tr>
{% endmacro %}



