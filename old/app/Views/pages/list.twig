{% extends"layout.twig" %}
{% block title %}Pages - {{ app_settings.site_name|default("Site") }}{% endblock %}
{% block meta_description %}Browse our comprehensive collection of informative pages and resources about mobile technology, services, and helpful guides.{% endblock %}
{% block og_type %}website{% endblock %}
{% set breadcrumbs = [{"label":"Pages","url":"/pages","icon":"file"}] %}
{% block content %}
 <!-- Hero Section -->
 <section class="hero-section pages-list-hero relative py-5 mb-4 overflow-hidden bg-gradient-to-br from-indigo-600 to-violet-600">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid grid-cols-1 gap-4 md:grid-cols-12 items-center">
 <div class="lg:col-span-8">
 <h1 class="text-4xl md:text-5xl font-bold text-white mb-3">
 <i class="lucide lucide-file-text mr-2"></i>Pages
 </h1>
 <p class="text-lg md:text-xl text-white/50">Browse site pages and documents</p>
 </div>
 <div class="lg:col-span-4 text-center">
 <div class="flex h-24 w-24 items-center justify-center rounded-full bg-white/20 mx-auto border border-white/35 text-white shadow-lg text-4xl">
   <i class="lucide lucide-file-text" aria-hidden="true"></i>
  </div>
 </div>
 </div>
 </div>
 </section>
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-5 pages-list-page">
 <!-- Page Header -->
 <div class="listing-header">
 <h1>
 <i class="lucide lucide-book-open text-indigo-600 mr-2"></i>{{ title|default("Pages") }}
 </h1>
 </div>
 <!-- Filter Toolbar (glassmorphism) -->
 <form method="get" class="rounded-2xl border border-slate-200/60 bg-white/85 shadow-lg backdrop-blur-xl p-5 mb-6 dark:border-slate-700/60 dark:bg-slate-900/85">
 <div class="flex flex-wrap items-center gap-3">
 <!-- Search -->
 <div class="relative flex-1 min-w-[200px]">
 <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none dark:text-slate-500" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
 <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
 </svg>
 <input type="search" name="search" value="{{ search|default("") }}" placeholder="Search pages..." class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-3 text-sm text-slate-900 placeholder-slate-400 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/15 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:placeholder-slate-500 dark:focus:border-indigo-400">
 </div>
 <!-- Per Page -->
 <select name="per_page" data-action="auto-submit" class="rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/15 appearance-none cursor-pointer dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" aria-label="Items per page">
 {% for opt in available_per_page|default([6, 12, 18, 24, 36, 60]) %}
 <option value="{{ opt }}" {% if per_page == opt %}selected{% endif %}>{{ opt }}</option>
 {% endfor %}
 </select>
 <!-- Sort -->
 <select name="sort" data-action="auto-submit" class="rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/15 appearance-none cursor-pointer dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100" aria-label="Sort pages">
 <option value="latest" {% if sort == 'latest' %}selected{% endif %}>Newest</option>
 <option value="oldest" {% if sort == 'oldest' %}selected{% endif %}>Oldest</option>
 </select>
 </div>
 </form>
 <!-- Pages Grid -->
 {% if pages is not empty %}
 <div class="listing-grid">
 {% for page in pages %}
 {% include 'partials/content-card.twig' with { item: {
 images: page.images|default([]),
 image: page.image|default(page.thumbnail|default(page.image_path|default(null))),
 title: page.title|default('Untitled'),
 subtitle: page.excerpt|default(page.content|default('')|striptags|slice(0, 120) ~ '...'),
 categories: page.categories|default([]),
 tags: page.tags|default([]),
 created_at: page.created_at|default(''),
 url: page.slug|default(page.id),
 slug: page.slug|default(page.id),
 id: page.id,
 type: 'page'
 }, index: loop.index } %}
 {% endfor %}
 </div>
 <!-- Pagination -->
 {% if total_pages > 1 %}
 <div class="pagination-container">
 <div class="pagination">
 {% if current_page > 1 %}
 <a class="pagination-link"
 href="?page={{ current_page - 1 }}&search={{ search|default("") }}&sort={{ sort|default("latest") }}&order={{ order|default("DESC") }}&per_page={{ per_page|default(12) }}"
 aria-label="Previous">
 <i class="lucide lucide-chevron-left"></i>
 </a>
 {% else %}
 <span class="pagination-link disabled"><i class="lucide lucide-chevron-left"></i></span>
 {% endif %}
 {% set start_page = max(2, current_page - 2) %}
 {% set end_page = min(total_pages - 1, current_page + 2) %}
 <a class="pagination-link {% if current_page == 1 %}active{% endif %}"
 href="?page=1&search={{ search|default("") }}&sort={{ sort|default("latest") }}&order={{ order|default("DESC") }}&per_page={{ per_page|default(12) }}">1</a>
 {% if start_page > 2 %}
 <span class="pagination-link disabled" aria-hidden="true">...</span>
 {% endif %}
 {% if start_page <= end_page %}
 {% for p in start_page..end_page %}
 <a class="pagination-link {% if p == current_page %}active{% endif %}"
 href="?page={{ p }}&search={{ search|default("") }}&sort={{ sort|default("latest") }}&order={{ order|default("DESC") }}&per_page={{ per_page|default(12) }}">{{ p }}</a>
 {% endfor %}
 {% endif %}
 {% if end_page < total_pages - 1 %}
 <span class="pagination-link disabled" aria-hidden="true">...</span>
 {% endif %}
 <a class="pagination-link {% if current_page == total_pages %}active{% endif %}"
 href="?page={{ total_pages }}&search={{ search|default("") }}&sort={{ sort|default("latest") }}&order={{ order|default("DESC") }}&per_page={{ per_page|default(12) }}">{{ total_pages }}</a>
 {% if current_page < total_pages %}
 <a class="pagination-link"
 href="?page={{ current_page + 1 }}&search={{ search|default("") }}&sort={{ sort|default("latest") }}&order={{ order|default("DESC") }}&per_page={{ per_page|default(12) }}"
 aria-label="Next">
 <i class="lucide lucide-chevron-right"></i>
 </a>
 {% else %}
 <span class="pagination-link disabled"><i class="lucide lucide-chevron-right"></i></span>
 {% endif %}
 </div>
 </div>
 {% endif %}
 {% else %}
 <div class="empty-state">
 <i class="lucide lucide-book-open"></i>
 <h3>No pages found</h3>
 <p>Try adjusting your search criteria</p>
 </div>
 {% endif %}
 </div>

<script>
document.addEventListener("click", function(e) {
  var t = e.target.closest("[data-action]");
  if (!t) return;
  var a = t.getAttribute("data-action");
  var id = t.dataset.id;
  if (a && window[a]) window[a](id, t);
});

<script>
document.addEventListener("change", function(e) {
  var t = e.target.closest("[data-action]");
  if (t && t.getAttribute("data-action") === "auto-submit" && t.form) t.form.submit();
});
</script>
</script>
{% endblock %}







