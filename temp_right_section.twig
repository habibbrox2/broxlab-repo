      {# Right section: Price only #}
      {% if item.type == 'mobile' and (item.official_price or item.unofficial_price) %}
        <div class="cc-mobile-pricing" aria-label="Mobile price">
          {% if item.official_price %}
            <span class="cc-price cc-price-official" title="Official Price">
              ৳{{ item.official_price|number_format(0, '.', ',') }}
            </span>
          {% elseif item.unofficial_price %}
            <span class="cc-price cc-price-unofficial" title="Market Price">
              ৳{{ item.unofficial_price|number_format(0, '.', ',') }}
            </span>
          {% endif %}
        </div>
      {% elseif item.type == 'service' and item.price %}
        <span class="cc-number inl-c-0002">
          💰 {{ item.price }}
        </span>
      {% endif %}
