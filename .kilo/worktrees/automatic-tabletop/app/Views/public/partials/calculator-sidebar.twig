{# app/Views/public/partials/calculator-sidebar.twig #}
<div class="calculator-sidebar bg-white rounded-4 shadow-sm border border-1 p-3">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div>
      <h5 class="mb-1 fw-bold">Calculator hub</h5>
      <p class="small text-muted mb-0">Jump between calculators and converters with one click.</p>
    </div>
  </div>

  <div class="list-group calculator-nav">
    <a href="/calculators"
       class="list-group-item list-group-item-action py-3 {% if current_type is not defined or current_type == 'all' %}active{% endif %}">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="fw-semibold">All Calculators</div>
          <small class="text-muted">Browse the full library</small>
        </div>
        <i class="bi bi-grid"></i>
      </div>
    </a>

    {% for groupKey, group in groups %}
      {% set groupIcon = {
        'calculator': 'bi-calculator',
        'converter': 'bi-arrow-left-right',
      }[groupKey] | default('bi-grid') %}
      <div class="mt-4">
        <div class="d-flex align-items-center text-uppercase text-muted small fw-semibold mb-2">
          <i class="bi {{ groupIcon }} mr-2" aria-hidden="true"></i>{{ group.label }}
        </div>
        {% for item in group.items %}
          <a href="/calculators/{{ item.type }}"
             class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-2 {% if item.type == current_type %}active{% endif %}">
            <span class="small mb-0">{{ item.label }}</span>
            {% if item.type == current_type %}
              <i class="bi bi-check-lg"></i>
            {% else %}
              <i class="bi bi-chevron-right"></i>
            {% endif %}
          </a>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>

