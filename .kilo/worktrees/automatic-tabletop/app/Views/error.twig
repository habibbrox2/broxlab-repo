{# templates/error.twig #}
{% extends 'layout.twig' %}

{% block title %}{% if code %}{{ code }}{% endif %} {{ 'Error'|trans }} - {{ app_settings.site_name|default('BroxBhai') }}{% endblock %}

{% block head %}
{{ parent() }}

{% if code == 404 %}
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
<meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
<meta name="bingbot" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
{% endif %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
{% endblock %}

{% block content %}

<style>
/* ===========================
   DESIGN TOKENS
   =========================== */
:root {
  --ink: #0a0a12;
  --ink-soft: #3d3d52;
  --ink-muted: #8585a0;
  --surface: #ffffff;
  --surface-2: #f4f3f8;
  --surface-3: #eceaf5;
  --accent: #5d4fff;
  --accent-2: #ff4f7b;
  --accent-3: #00d9c0;
  --border: rgba(93, 79, 255, 0.15);
  --border-soft: rgba(0,0,0,0.06);
  --font-display: 'Syne', sans-serif;
  --font-body: 'DM Sans', sans-serif;
  --radius-xl: 24px;
  --radius-lg: 16px;
  --radius-md: 10px;
  --radius-pill: 999px;
  --shadow-sm: 0 2px 8px rgba(0,0,0,0.06);
  --shadow-md: 0 8px 32px rgba(93, 79, 255, 0.10);
  --shadow-lg: 0 24px 64px rgba(93, 79, 255, 0.14);
}

/* ===========================
   BASE
   =========================== */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

.ep-root {
  font-family: var(--font-body);
  background: #f7f6fc;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow-x: hidden;
}

/* ===========================
   NOISE GRAIN OVERLAY
   =========================== */
.ep-root::after {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.03;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 180px;
  z-index: 0;
}

/* ===========================
   BACKGROUND ORBS
   =========================== */
.ep-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
  z-index: 0;
}
.ep-orb-1 {
  width: 600px; height: 600px;
  top: -180px; left: -140px;
  background: radial-gradient(circle, rgba(93,79,255,0.18) 0%, transparent 70%);
  animation: orb-drift 20s ease-in-out infinite;
}
.ep-orb-2 {
  width: 400px; height: 400px;
  bottom: -100px; right: -80px;
  background: radial-gradient(circle, rgba(255,79,123,0.14) 0%, transparent 70%);
  animation: orb-drift 26s ease-in-out infinite reverse;
}
.ep-orb-3 {
  width: 300px; height: 300px;
  top: 40%; left: 50%;
  transform: translateX(-50%);
  background: radial-gradient(circle, rgba(0,217,192,0.10) 0%, transparent 70%);
  animation: orb-pulse 12s ease-in-out infinite;
}

@keyframes orb-drift {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33%       { transform: translate(30px, -20px) scale(1.05); }
  66%       { transform: translate(-20px, 20px) scale(0.97); }
}
@keyframes orb-pulse {
  0%, 100% { opacity: 1; transform: translateX(-50%) scale(1); }
  50%       { opacity: 0.6; transform: translateX(-50%) scale(1.2); }
}

/* ===========================
   WRAPPER
   =========================== */
.ep-wrap {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48px 24px;
  gap: 32px;
}

/* ===========================
   HERO CARD
   =========================== */
.ep-hero {
  width: 100%;
  max-width: 820px;
  background: var(--surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--border-soft);
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 1fr;
  animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes rise {
  from { opacity: 0; transform: translateY(28px) scale(0.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* ===========================
   LEFT PANEL (VISUAL)
   =========================== */
.ep-panel-left {
  background: linear-gradient(145deg, #1a1530 0%, #0e0b1f 100%);
  padding: 52px 40px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 20px;
  position: relative;
  overflow: hidden;
}

.ep-panel-left::before {
  content: '';
  position: absolute;
  inset: 0;
  background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%235d4fff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}

.ep-code-badge {
  font-family: var(--font-display);
  font-size: clamp(80px, 14vw, 120px);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -4px;
  background: linear-gradient(135deg, #7b6fff 0%, #ff4f7b 60%, #00d9c0 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  position: relative;
  animation: code-pop 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
}

@keyframes code-pop {
  from { opacity: 0; transform: scale(0.8) translateY(10px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

.ep-icon-wrap {
  width: 64px; height: 64px;
  border-radius: var(--radius-lg);
  background: rgba(93,79,255,0.15);
  border: 1px solid rgba(93,79,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  color: #a096ff;
  animation: icon-float 5s ease-in-out infinite;
}

@keyframes icon-float {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-6px); }
}

.ep-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.4px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.5);
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: var(--radius-pill);
  padding: 5px 14px;
}

.ep-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #ff4f7b;
  box-shadow: 0 0 6px #ff4f7b;
  animation: dot-blink 1.6s ease-in-out infinite;
}

@keyframes dot-blink {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.3; }
}

/* ===========================
   RIGHT PANEL (CONTENT)
   =========================== */
.ep-panel-right {
  padding: 52px 44px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 24px;
}

.ep-title {
  font-family: var(--font-display);
  font-size: clamp(22px, 3.5vw, 32px);
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
  letter-spacing: -0.5px;
}

.ep-desc {
  font-size: 16px;
  line-height: 1.7;
  color: var(--ink-soft);
}

.ep-details-box {
  background: #fff8f0;
  border: 1px solid #ffd8a8;
  border-left: 3px solid #ff9800;
  border-radius: var(--radius-md);
  padding: 14px 18px;
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.ep-details-box i { color: #ff9800; font-size: 16px; margin-top: 2px; flex-shrink: 0; }
.ep-details-box p { font-size: 13.5px; color: #7a5400; line-height: 1.6; }
.ep-details-box strong { display: block; margin-bottom: 3px; font-weight: 600; }

.ep-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.ep-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-body);
  font-weight: 500;
  font-size: 14px;
  border-radius: var(--radius-pill);
  padding: 11px 24px;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  border: none;
}

.ep-btn-primary {
  background: var(--accent);
  color: white;
  box-shadow: 0 4px 16px rgba(93,79,255,0.35);
}
.ep-btn-primary:hover {
  background: #4a3df0;
  box-shadow: 0 6px 24px rgba(93,79,255,0.45);
  transform: translateY(-1px);
  color: white;
}

.ep-btn-ghost {
  background: var(--surface-2);
  color: var(--ink-soft);
  border: 1px solid var(--border-soft);
}
.ep-btn-ghost:hover {
  background: var(--surface-3);
  color: var(--ink);
  transform: translateY(-1px);
}

/* ===========================
   404 EXTRA SECTION
   =========================== */
.ep-extra {
  width: 100%;
  max-width: 820px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
}

.ep-section-label {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--ink-muted);
  margin-bottom: 4px;
}

/* ===== SEARCH BOX ===== */
.ep-search-card {
  background: var(--surface);
  border-radius: var(--radius-xl);
  border: 1px solid var(--border-soft);
  box-shadow: var(--shadow-sm);
  padding: 28px 32px;
}

.ep-search-wrap {
  position: relative;
  margin-top: 14px;
}

.ep-search-input {
  width: 100%;
  height: 52px;
  background: var(--surface-2);
  border: 1.5px solid transparent;
  border-radius: var(--radius-pill);
  padding: 0 130px 0 52px;
  font-family: var(--font-body);
  font-size: 15px;
  color: var(--ink);
  outline: none;
  transition: all 0.2s;
}
.ep-search-input::placeholder { color: var(--ink-muted); }
.ep-search-input:focus {
  background: var(--surface);
  border-color: var(--accent);
  box-shadow: 0 0 0 4px rgba(93,79,255,0.10);
}

.ep-search-icon {
  position: absolute;
  left: 18px; top: 50%;
  transform: translateY(-50%);
  color: var(--ink-muted);
  font-size: 18px;
  pointer-events: none;
}

.ep-search-btn {
  position: absolute;
  right: 6px; top: 6px;
  height: 40px;
  padding: 0 22px;
  background: var(--accent);
  color: white;
  border: none;
  border-radius: var(--radius-pill);
  font-family: var(--font-body);
  font-weight: 500;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s;
}
.ep-search-btn:hover { background: #4a3df0; }

/* ===== QUICK LINKS ===== */
.ep-links-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.ep-link-card {
  background: var(--surface);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius-lg);
  padding: 22px 16px;
  text-align: center;
  text-decoration: none;
  transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  box-shadow: var(--shadow-sm);
}
.ep-link-card:hover {
  border-color: var(--accent);
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
}

.ep-link-icon {
  width: 44px; height: 44px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  transition: transform 0.2s;
}
.ep-link-card:hover .ep-link-icon { transform: scale(1.1); }

.ep-link-icon-home   { background: rgba(93,79,255,0.10);  color: #5d4fff; }
.ep-link-icon-contact{ background: rgba(0,217,192,0.10);  color: #00a896; }
.ep-link-icon-about  { background: rgba(255,79,123,0.10); color: #ff4f7b; }
.ep-link-icon-sitemap{ background: rgba(255,152,0,0.10);  color: #e68900; }

.ep-link-label {
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  color: var(--ink-soft);
}

/* ===========================
   DEBUG SECTION
   =========================== */
.ep-debug {
  width: 100%;
  max-width: 820px;
  background: #0f0f18;
  border: 1px solid rgba(255,79,123,0.25);
  border-radius: var(--radius-xl);
  overflow: hidden;
  animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both;
}

.ep-debug-header {
  background: rgba(255,79,123,0.12);
  border-bottom: 1px solid rgba(255,79,123,0.20);
  padding: 14px 22px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-display);
  font-size: 13px;
  font-weight: 600;
  color: #ff4f7b;
  letter-spacing: 0.3px;
}

.ep-debug-body pre {
  margin: 0;
  padding: 22px;
  font-size: 13px;
  line-height: 1.6;
  color: #b0a8d0;
  max-height: 360px;
  overflow: auto;
  font-family: 'Menlo', 'Monaco', 'Courier New', monospace;
}

/* ===========================
   RESPONSIVE
   =========================== */
@media (max-width: 680px) {
  .ep-hero { grid-template-columns: 1fr; }
  .ep-panel-left { padding: 40px 28px; }
  .ep-panel-right { padding: 36px 28px; }
  .ep-links-grid { grid-template-columns: repeat(2, 1fr); }
  .ep-code-badge { font-size: 80px; }
}
</style>

<div class="ep-root">
  <div class="ep-orb ep-orb-1"></div>
  <div class="ep-orb ep-orb-2"></div>
  <div class="ep-orb ep-orb-3"></div>

  <div class="ep-wrap">

    {# ===== HERO CARD ===== #}
    <div class="ep-hero">

      {# LEFT â€” VISUAL #}
      <div class="ep-panel-left">
        <div class="ep-status-pill">
          <span class="ep-dot"></span>
          {{ meta.title }}
        </div>
        <div class="ep-code-badge">{{ c }}</div>
        <div class="ep-icon-wrap">
          <i class="bi bi-{{ meta.icon }}"></i>
        </div>
      </div>

      {# RIGHT â€” CONTENT #}
      <div class="ep-panel-right">
        <div>
          <h1 class="ep-title">{{ meta.title }}</h1>
          <p class="ep-desc" style="margin-top:12px;">{{ message|default(meta.desc) }}</p>
        </div>

        {% if details is defined and details %}
        <div class="ep-details-box">
          <i class="bi bi-exclamation-circle-fill"></i>
          <p><strong>{{ 'Error Details:'|trans }}</strong>{{ details }}</p>
        </div>
        {% endif %}

        <div class="ep-actions">
          <a href="{{ home_url|default('/') }}" class="ep-btn ep-btn-primary">
            <i class="bi bi-house-door-fill"></i>{{ 'Go Home'|trans }}
          </a>
          <button onclick="history.back()" class="ep-btn ep-btn-ghost">
            <i class="bi bi-arrow-left"></i>{{ 'Go Back'|trans }}
          </button>
        </div>
      </div>

    </div>

    {# ===== 404 EXTRA CONTENT ===== #}
    {% if c == 404 %}
    <div class="ep-extra">

      {# Search #}
      <div class="ep-search-card">
        <p class="ep-section-label">{{ 'Search'|trans }}</p>
        <p style="font-size:15px; color:var(--ink-soft); margin-top:4px;">{{ 'Can\'t find what you\'re looking for?'|trans }}</p>
        <div class="ep-search-wrap">
          <form action="/search" method="get" style="display:contents;">
            <i class="bi bi-search ep-search-icon"></i>
            <input type="text" name="q" class="ep-search-input"
              placeholder="{{ 'Search our website...'|trans }}"
              aria-label="{{ 'Search'|trans }}">
            <button type="submit" class="ep-search-btn">
              {{ 'Search'|trans }}
            </button>
          </form>
        </div>
      </div>

      {# Quick Links #}
      <div>
        <p class="ep-section-label" style="margin-bottom:12px;">{{ 'Explore'|trans }}</p>
        <div class="ep-links-grid">
          <a href="/" class="ep-link-card">
            <div class="ep-link-icon ep-link-icon-home"><i class="bi bi-house-door-fill"></i></div>
            <span class="ep-link-label">{{ 'Home'|trans }}</span>
          </a>
          <a href="/contact" class="ep-link-card">
            <div class="ep-link-icon ep-link-icon-contact"><i class="bi bi-envelope-fill"></i></div>
            <span class="ep-link-label">{{ 'Contact'|trans }}</span>
          </a>
          <a href="/about-us" class="ep-link-card">
            <div class="ep-link-icon ep-link-icon-about"><i class="bi bi-info-circle-fill"></i></div>
            <span class="ep-link-label">{{ 'About'|trans }}</span>
          </a>
          <a href="/sitemap" class="ep-link-card">
            <div class="ep-link-icon ep-link-icon-sitemap"><i class="bi bi-map-fill"></i></div>
            <span class="ep-link-label">{{ 'Sitemap'|trans }}</span>
          </a>
        </div>
      </div>

    </div>
    {% endif %}

    {# ===== DEBUG SECTION ===== #}
    {% if show_trace|default(false) and trace is defined and trace %}
    <div class="ep-debug">
      <div class="ep-debug-header">
        <i class="bi bi-bug-fill"></i>
        Debug Information â€” Development Mode
      </div>
      <div class="ep-debug-body">
        <pre><code>{{ trace }}</code></pre>
      </div>
    </div>
    {% endif %}

  </div>
</div>

{% endblock %}

