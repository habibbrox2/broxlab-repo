{% extends "layout.twig" %}

{% block title %}Weather Error{{ parent() ? ' | ' ~ parent() : '' }}{% endblock %}

{% block meta_description %}We could not retrieve weather data. Please try again later.{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-cloud-slash fs-1 text-danger"></i>
                    </div>
                    <h1 class="h2 text-danger mb-3">Weather Service Unavailable</h1>
                    <p class="text-muted mb-4">
                        {{ message|default('We could not retrieve weather data at this time.') }}
                    </p>
                    {% if error_code %}
                        <div class="alert alert-secondary small">
                            <code class="text-muted">Error Code: {{ error_code }}</code>
                            {% if request_id %}
                                <br><code class="text-muted">Request ID: {{ request_id }}</code>
                            {% endif %}
                        </div>
                    {% endif %}
                    <div class="d-flex gap-3 justify-content-center mt-4">
                        <a href="{{ path('weather.home') }}" class="btn btn-primary">
                            <i class="bi bi-house mr-1"></i>Weather Home
                        </a>
                        <a href="{{ url }}" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left mr-1"></i>Back to Site
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

