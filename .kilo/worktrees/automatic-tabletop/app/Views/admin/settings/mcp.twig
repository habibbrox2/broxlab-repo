<div class="mb-4">
  <h5 class="mb-3"><i class="bi bi-server mr-2"></i>MCP Server Configuration</h5>
  
  <div class="row g-3">
    <div class="col-12">
      <label class="form-label">MCP Server URL</label>
      <input type="text" 
             class="form-control" 
             name="mcp_server_url" 
             id="mcp_server_url"
             value="{{ settings.mcp_server_url|default('') }}"
             placeholder="http://localhost:3000">
      <small class="text-muted">The URL of your MCP (Model Context Protocol) server.</small>
    </div>
    
    <div class="col-12">
      <label class="form-label">MCP API Key</label>
      <input type="password" 
             class="form-control" 
             name="mcp_api_key" 
             id="mcp_api_key"
             value="{{ settings.mcp_api_key|default('') }}"
             placeholder="Enter MCP API key"
             autocomplete="off">
      <small class="text-muted">Authentication key for accessing the MCP server.</small>
    </div>
  </div>
</div>

