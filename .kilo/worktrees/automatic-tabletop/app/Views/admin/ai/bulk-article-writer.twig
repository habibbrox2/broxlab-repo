{% extends 'admin/layout.twig' %}

{% block title %}Bulk Article Generator{% endblock %}

{% block stylesheets %}
<style>
  .bulk-writer { max-width: 1400px; }
  .bulk-card {
    background: var(--bs-card-bg, #fff);
    border: 1px solid var(--bs-border-color, #dee2e6);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    transition: box-shadow .2s ease;
  }
  .bulk-card:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
  .bulk-card h5 {
    font-weight: 600;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: .5rem;
  }
  .bulk-card h5 .bi { font-size: 1.25rem; color: var(--bs-primary, #0d6efd); }

  .csv-dropzone {
    border: 2px dashed var(--bs-border-color, #adb5bd);
    border-radius: 12px;
    padding: 2.5rem 1.5rem;
    text-align: center;
    cursor: pointer;
    transition: all .25s ease;
    background: var(--bs-gray-100, #f8f9fa);
  }
  .csv-dropzone:hover, .csv-dropzone.dragover {
    border-color: var(--bs-primary, #0d6efd);
    background: rgba(var(--bs-primary-rgb,13,110,253),0.04);
    transform: scale(1.01);
  }
  .csv-dropzone-icon { font-size: 2.5rem; color: var(--bs-primary, #0d6efd); margin-bottom: .75rem; }
  .csv-dropzone-text { font-size: .95rem; color: var(--bs-secondary-color, #6c757d); margin-bottom: .5rem; }
  .csv-dropzone-hint { font-size: .8rem; color: var(--bs-secondary-color, #adb5bd); }
  .csv-preview-table { font-size: .875rem; }
  .csv-preview-table th {
    white-space: nowrap;
    background: var(--bs-gray-100, #f8f9fa);
    position: sticky;
    top: 0;
  }
  .csv-preview-wrap {
    max-height: 400px;
    overflow-y: auto;
    border: 1px solid var(--bs-border-color, #dee2e6);
    border-radius: 6px;
  }

  .step-indicator { display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .step-badge {
    display: flex; align-items: center; gap: .5rem;
    padding: .4rem .9rem; border-radius: 20px; font-size: .8rem; font-weight: 500;
    background: var(--bs-gray-200, #e9ecef);
    color: var(--bs-secondary-color, #6c757d);
    transition: all .25s ease;
  }
  .step-badge.active { background: var(--bs-primary, #0d6efd); color: #fff; }
  .step-badge.done { background: var(--bs-success, #198754); color: #fff; }
  .step-badge .step-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 20px; height: 20px; border-radius: 50%; font-size: .7rem; font-weight: 700;
    background: rgba(255,255,255,0.25);
  }

  .progress-wrapper { padding: 1rem 0; }
  .progress-status { display: flex; justify-content: space-between; align-items: center; margin-bottom: .5rem; font-size: .875rem; }
  .progress-current {
    background: var(--bs-gray-100, #f8f9fa); border-radius: 6px; padding: .75rem 1rem; margin-top: .5rem;
    display: flex; align-items: center; gap: .75rem; font-size: .875rem;
  }
  .progress-current .inline-spinner { width: 1rem; height: 1rem; }

  .article-result-card {
    border: 1px solid var(--bs-border-color, #dee2e6); border-radius: 8px;
    margin-bottom: .75rem; transition: all .2s ease; overflow: hidden;
  }
  .article-result-card:hover { border-color: var(--bs-primary, #0d6efd); }
  .article-result-card.success { border-left: 3px solid var(--bs-success, #198754); }
  .article-result-card.failed { border-left: 3px solid var(--bs-danger, #dc3545); }
  .article-result-header {
    padding: .75rem 1rem; display: flex; align-items: center;
    justify-content: space-between; gap: .75rem; cursor: pointer; user-select: none;
  }
  .article-result-header:hover { background: var(--bs-gray-50, #f8f9fa); }
  .article-result-title { font-weight: 500; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .article-result-meta { font-size: .75rem; color: var(--bs-secondary-color, #6c757d); white-space: nowrap; }
  .article-result-body { padding: .75rem 1rem 1rem; border-top: 1px solid var(--bs-border-color, #eee); display: none; }
  .article-result-body.open { display: block; }
  .article-result-body .article-preview-content {
    max-height: 300px; overflow-y: auto; font-size: .85rem; line-height: 1.6;
    background: var(--bs-gray-50, #f8f9fa); border-radius: 4px; padding: .75rem;
  }
  .article-result-body .article-preview-content h1 { font-size: 1.1rem; }
  .article-result-body .article-preview-content h2 { font-size: 1rem; }
  .article-result-body .article-preview-content h3 { font-size: .9rem; }

  .publish-article-checkbox { width: 18px; height: 18px; cursor: pointer; }

  .summary-stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem; margin-bottom: 1rem;
  }
  .stat-card {
    text-align: center; padding: 1rem .75rem; border-radius: 8px;
    background: var(--bs-gray-50, #f8f9fa); border: 1px solid var(--bs-border-color, #dee2e6);
  }
  .stat-card .stat-value { font-size: 1.5rem; font-weight: 700; line-height: 1.2; }
  .stat-card .stat-label { font-size: .75rem; color: var(--bs-secondary-color, #6c757d); margin-top: .25rem; }
  .stat-card.success .stat-value { color: var(--bs-success, #198754); }
  .stat-card.failed .stat-value { color: var(--bs-danger, #dc3545); }
  .stat-card.total .stat-value { color: var(--bs-primary, #0d6efd); }
  .stat-card.time .stat-value { color: var(--bs-warning, #ffc107); font-size: 1.2rem; }

  .sample-csv-btn { font-size: .8rem; cursor: pointer; text-decoration: none; }
  .sample-csv-btn:hover { text-decoration: underline; }

  @media (max-width: 576px) {
    .bulk-card { padding: 1rem; }
    .csv-dropzone { padding: 1.5rem 1rem; }
    .step-badge { font-size: .7rem; padding: .3rem .6rem; }
    .summary-stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>
{% endblock %}

{% block content %}
<div class="bulk-writer">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
      <h4 class="fw-bold mb-1"><i class="bi bi-boxes mr-2"></i> Bulk Article Generator</h4>
      <p class="text-muted mb-0 small">Upload a CSV of topics to generate articles in batches</p>
    </div>
    <div>
      <a href="/admin/ai/article-writer" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-pencil-square mr-1"></i> Single Article Writer
      </a>
    </div>
  </div>

  <div class="step-indicator">
    <span class="step-badge active" data-step="1">
      <span class="step-num">1</span> Upload CSV
    </span>
    <span class="step-badge" data-step="2">
      <span class="step-num">2</span> Review Topics
    </span>
    <span class="step-badge" data-step="3">
      <span class="step-num">3</span> Generate
    </span>
    <span class="step-badge" data-step="4">
      <span class="step-num">4</span> Publish
    </span>
  </div>

  {# Step 1 #}
  <div class="bulk-card" id="step1">
    <h5><i class="bi bi-upload"></i> Step 1: Upload Your Topics</h5>
    <div class="row g-3 mb-3">
      <div class="col-md-8">
        <div class="csv-dropzone" id="csvDropzone">
          <div class="csv-dropzone-icon"><i class="bi bi-file-earmark-spreadsheet"></i></div>
          <div class="csv-dropzone-text">Drop a CSV file here, or click to browse</div>
          <div class="csv-dropzone-hint">CSV must have a <strong>topic</strong> column (first column). Optional: tone, length, language, keywords, style</div>
          <input type="file" id="csvFileInput" accept=".csv,.tsv,.txt" class="d-none">
        </div>
      </div>
      <div class="col-md-4">
        <div class="bulk-card h-100" style="margin-bottom:0;">
          <h6 class="fw-semibold mb-2"><i class="bi bi-info-circle"></i> CSV Format</h6>
          <p class="small text-muted mb-2">Required: <code>topic</code>. Optional columns let you override settings per article.</p>
          <button type="button" class="btn btn-sm btn-outline-primary" id="downloadSampleCsv">
            <i class="bi bi-download mr-1"></i> Download Sample CSV
          </button>
        </div>
      </div>
    </div>
    <div id="csvUploadStatus" class="d-none"></div>
    <div id="csvPreviewSection" class="d-none">
      <hr>
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="fw-semibold mb-0"><span id="csvTopicCount">0</span> topics found</h6>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-outline-danger btn-sm" id="clearCsvBtn"><i class="bi bi-trash mr-1"></i> Clear</button>
          <button type="button" class="btn btn-primary btn-sm" id="generateAllBtn"><i class="bi bi-magic mr-1"></i> Generate All Articles</button>
        </div>
      </div>
      <div class="csv-preview-wrap">
        <table class="table table-sm table-hover csv-preview-table mb-0">
          <thead><tr>
            <th style="width:40px">#</th><th>Topic</th><th>Tone</th><th>Length</th><th>Language</th><th>Keywords</th><th>Style</th>
          </tr></thead>
          <tbody id="csvPreviewBody"></tbody>
        </table>
      </div>
    </div>
    <div id="csvEmptyState" class="text-center py-4 text-muted">
      <i class="bi bi-inbox" style="font-size:2rem;display:block;margin-bottom:.5rem;"></i>
      <span>Upload a CSV to get started</span>
    </div>
  </div>

  {# Step 3 - Progress #}
  <div class="bulk-card d-none" id="step3Card">
    <h5><i class="bi bi-magic"></i> Generation Progress</h5>
    <div class="progress-wrapper">
      <div class="progress-status">
        <span id="progressLabel">Starting...</span>
        <span id="progressCount">0 / 0</span>
      </div>
      <div class="progress" style="height:8px;">
        <div class="progress-bar progress-bar-striped progress-bar-animated" id="progressBar" style="width:0%"></div>
      </div>
      <div class="progress-current d-none" id="progressCurrentArticle">
        <div class="inline-spinner inline-spinner-sm text-primary" role="status"></div>
        <span id="progressCurrentText">Generating article...</span>
      </div>
    </div>
  </div>

  {# Step 4 - Results #}
  <div class="bulk-card d-none" id="step4Card">
    <h5><i class="bi bi-journal-check"></i> Generation Results</h5>
    <div id="resultsSummary" class="d-none">
      <div class="summary-stats" id="resultsStats"></div>
    </div>
    <div id="resultsActions" class="d-flex gap-2 flex-wrap mb-3 d-none">
      <button type="button" class="btn btn-success" id="publishSelectedBtn"><i class="bi bi-check2-circle mr-1"></i> Publish Selected</button>
      <button type="button" class="btn btn-outline-primary" id="selectAllResultsBtn"><i class="bi bi-check-all mr-1"></i> Select All</button>
      <button type="button" class="btn btn-outline-secondary" id="deselectAllResultsBtn"><i class="bi bi-x mr-1"></i> Deselect All</button>
      <button type="button" class="btn btn-outline-secondary" id="backToUploadBtn"><i class="bi bi-arrow-left mr-1"></i> New Batch</button>
    </div>
    <div id="articlesList"></div>
    <div id="publishProgress" class="d-none mt-3">
      <hr>
      <h6 class="fw-semibold mb-2"><i class="bi bi-send"></i> Publishing...</h6>
      <div class="progress" style="height:6px;">
        <div class="progress-bar bg-success" id="publishProgressBar" style="width:0%"></div>
      </div>
    </div>
    <div id="publishStatus" class="d-none mt-3"></div>
  </div>

  <div id="bulkWriterStatus" class="d-none"></div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ asset('/assets/js/admin-bulk-article-writer.js') }}"></script>
{% endblock %}

