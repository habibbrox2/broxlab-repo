{% extends "admin/layout.twig" %}

{% block title %}{{ page_title }}{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% set current_page = current_page|default('cv-templates') %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('/assets/css/cv-admin.css') }}">
  <style>
    .template-editor {
      min-height: 500px;
      font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
      font-size: 14px;
      line-height: 1.4;
    }
  </style>
{% endblock %}

{% block content %}
  <div class="container-fluid py-4 cv-admin-page">
    <div class="cv-admin-hero">
      <div>
        <div class="cv-admin-title">{{ page_title }}</div>
        <div class="cv-admin-subtitle">
          {% if mode == 'create' %}
            Create a new CV template by cloning an existing one.
          {% else %}
            Edit the template content and metadata.
          {% endif %}
        </div>
      </div>
      <div class="cv-admin-hero-actions">
        <a href="/admin/cv-templates" class="modern-btn modern-btn-outline">
          <i class="bi bi-arrow-left mr-1"></i> Back to Templates
        </a>
      </div>
    </div>

    {% if errors is defined and errors is not empty %}
      <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle mr-1"></i>
        <strong>Please fix the following errors:</strong>
        <ul class="mb-0 mt-2">
          {% for error in errors %}
            <li>{{ error }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <div class="row">
      <div class="col-lg-8">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Template Details</h5>
          </div>
          <div class="card-body">
            <form method="post" action="{% if mode == 'edit' %}/admin/cv-templates/{{ template_slug }}{% else %}/admin/cv-templates{% endif %}">
              <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

              <div class="row mb-3">
                <div class="col-md-6">
                  <label for="name" class="form-label">Name <span class="text-danger">*</span></label>
                  <input type="text"
                         class="form-control"
                         id="name"
                         name="name"
                         value="{{ form_data.name|default(template.name|default('')) }}"
                         required>
                  <div class="form-text">Display name for the template</div>
                </div>
                {% if mode == 'create' %}
                  <div class="col-md-6">
                    <label for="slug" class="form-label">Slug <span class="text-danger">*</span></label>
                    <input type="text"
                           class="form-control"
                           id="slug"
                           name="slug"
                           value="{{ form_data.slug|default('') }}"
                           pattern="[a-z0-9][a-z0-9-]*"
                           maxlength="50"
                           required>
                    <div class="form-text">URL-friendly identifier (lowercase, alphanumeric, hyphens only)</div>
                  </div>
                {% else %}
                  <div class="col-md-6">
                    <label class="form-label">Slug</label>
                    <input type="text" class="form-control" value="{{ template_slug }}" readonly>
                    <div class="form-text">Slug cannot be changed after creation</div>
                  </div>
                {% endif %}
              </div>

              <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea class="form-control"
                          id="description"
                          name="description"
                          rows="2"
                          placeholder="Optional description of the template">{{ form_data.description|default(template.description|default('')) }}</textarea>
              </div>

              {% if mode == 'create' %}
                <div class="mb-3">
                  <label for="base_template" class="form-label">Base Template <span class="text-danger">*</span></label>
                  <select class="form-select" id="base_template" name="base_template" required>
                    <option value="">Select a template to clone...</option>
                    {% for slug, baseTemplate in base_templates %}
                      <option value="{{ slug }}" {% if form_data.base_template == slug %}selected{% endif %}>
                        {{ baseTemplate.name }} ({{ slug }})
                      </option>
                    {% endfor %}
                  </select>
                  <div class="form-text">Choose an existing template as the starting point</div>
                </div>
              {% endif %}

              {% if mode == 'edit' %}
                <div class="mb-3">
                  <label for="profession" class="form-label">Default Profession</label>
                  <select class="form-select" id="profession" name="profession">
                    <option value="">Select a profession...</option>
                    <option value="software-engineer" {% if template.profession == 'software-engineer' %}selected{% endif %}>Software Engineer</option>
                    <option value="product-manager" {% if template.profession == 'product-manager' %}selected{% endif %}>Product Manager</option>
                    <option value="data-scientist" {% if template.profession == 'data-scientist' %}selected{% endif %}>Data Scientist</option>
                    <option value="marketing-manager" {% if template.profession == 'marketing-manager' %}selected{% endif %}>Marketing Manager</option>
                    <option value="sales-executive" {% if template.profession == 'sales-executive' %}selected{% endif %}>Sales Executive</option>
                    <option value="hr-manager" {% if template.profession == 'hr-manager' %}selected{% endif %}>HR Manager</option>
                    <option value="accountant" {% if template.profession == 'accountant' %}selected{% endif %}>Accountant</option>
                    <option value="teacher" {% if template.profession == 'teacher' %}selected{% endif %}>Teacher</option>
                    <option value="doctor" {% if template.profession == 'doctor' %}selected{% endif %}>Doctor</option>
                    <option value="lawyer" {% if template.profession == 'lawyer' %}selected{% endif %}>Lawyer</option>
                  </select>
                  <div class="form-text">Optional: Set a default profession for this template's professional summary</div>
                </div>

                <div class="mb-3">
                  <label for="content" class="form-label">Template Content <span class="text-danger">*</span></label>
                  {% include 'partials/editor.twig' with {
                    'editorId': 'content',
                    'editorName': 'content',
                    'editorClass': 'template-editor',
                    'initialContent': template_content,
                    'darkMode': false,
                    'rtl': false,
                    'minHeight': '400px',
                    'autoGrow': true
                  } %}
                  <div class="form-text text-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    This editor contains HTML/Twig template code. Be careful with syntax - invalid Twig code will break the template.
                  </div>
                </div>
              {% endif %}

              <div class="d-flex gap-2">
                <button type="submit" class="modern-btn modern-btn-primary">
                  <i class="bi bi-check-circle mr-1"></i>
                  {% if mode == 'create' %}Create Template{% else %}Save Changes{% endif %}
                </button>
                <a href="/admin/cv-templates" class="modern-btn modern-btn-outline">Cancel</a>
              </div>
            </form>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-0">Help & Tips</h5>
          </div>
          <div class="card-body">
            <h6>Template Structure</h6>
            <p class="small text-muted mb-3">
              Templates use Twig syntax and receive <code>cv</code> and <code>sections</code> variables.
              See existing templates for examples.
            </p>

            <h6>Available Variables</h6>
            <ul class="small mb-3">
              <li><code>cv</code> - CV metadata (id, title, dates)</li>
              <li><code>sections</code> - Array of CV sections with items</li>
              <li><code>section.items</code> - Content items for each section</li>
            </ul>

            <h6>Best Practices</h6>
            <ul class="small mb-0">
              <li>Use semantic HTML</li>
              <li>Include proper ARIA labels</li>
              <li>Test with sample data</li>
              <li>Keep responsive design in mind</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block scripts %}
  {{ parent() }}
  <script src="{{ asset('/assets/js/cv-admin.js') }}" defer></script>
{% endblock %}

