{% extends "admin/layout.twig" %}
{% block title %}All Posts{% endblock %}
{% set breadcrumbs = auto_admin_breadcrumbs() %}
{% block content %}
  <div class="container-fluid py-4">
    <div class="admin-page-header mb-4">
      <div class="admin-page-title">
        <i class="bi bi-journal-text"></i>
        Posts Management
      </div>
      <div class="admin-page-subtitle">Manage all blog posts and content</div>
    </div>

    <div class="d-flex justify-content-end mb-4">
      <a href="/admin/posts/create" class="modern-btn modern-btn-primary">
        <i class="bi bi-plus-circle mr-1"></i> Add New Post
      </a>
    </div>

    <div class="admin-panel-card mb-4">
      <div class="admin-panel-card-body">
        <form class="row g-2" method="get" action="">
          <div class="col-md-3">
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
              <input type="text"
                     name="search"
                     value="{{ search|default('') }}"
                     class="form-control"
                     placeholder="Search by title...">
            </div>
          </div>
          <div class="col-md-3">
            <select name="sort" class="form-select">
              <option value="created_at" {{ sort|default('created_at') == 'created_at' ? 'selected' : '' }}>Latest</option>
              <option value="title" {{ sort|default('created_at') == 'title' ? 'selected' : '' }}>Title</option>
            </select>
          </div>
          <div class="col-md-2">
            <select name="order" class="form-select">
              <option value="DESC" {{ order|default('DESC') == 'DESC' ? 'selected' : '' }}>Desc</option>
              <option value="ASC" {{ order|default('DESC') == 'ASC' ? 'selected' : '' }}>Asc</option>
            </select>
          </div>
          <div class="col-md-2">
            <select name="limit" class="form-select">
              <option value="10" {{ limit|default(20) == 10 ? 'selected' : '' }}>10</option>
              <option value="20" {{ limit|default(20) == 20 ? 'selected' : '' }}>20</option>
              <option value="50" {{ limit|default(20) == 50 ? 'selected' : '' }}>50</option>
              <option value="100" {{ limit|default(20) == 100 ? 'selected' : '' }}>100</option>
            </select>
          </div>
          <div class="col-md-2">
            <button type="submit" class="modern-btn modern-btn-primary w-100">
              <i class="bi bi-funnel-fill mr-1"></i> Filter
            </button>
          </div>
        </form>
      </div>
    </div>

    {% if posts is not empty %}
      <div class="admin-panel-card">
        <div class="admin-panel-card-body">
          <div class="table-responsive">
            <table class="table table-stacked">
              <thead>
                <tr>
                  <th>#</th>
                  <th><i class="bi bi-type"></i> Title</th>
                  <th><i class="bi bi-person"></i> Author</th>
                  <th><i class="bi bi-link-45deg"></i> Permalink</th>
                  <th><i class="bi bi-calendar-check"></i> Status</th>
                  <th class="text-center"><i class="bi bi-gear"></i> Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for post in posts %}
                  <tr>
                    <td class="fw-bold" data-label="#">{{ post.id }}</td>
                    <td data-label="Title">{{ post.title }}</td>
                    <td data-label="Author">
                      <i class="bi bi-person-circle text-secondary"></i> {{ post.author ?? 'N/A' }}
                    </td>
                    <td data-label="Permalink">
                      <code class="text-muted">{{ post.slug }}</code>
                    </td>
                    <td data-label="Status">
                      <span class="badge {{ post.published ? 'bg-success' : 'bg-warning text-surface-dark' }} rounded-pill">
                        <i class="bi {{ post.published ? 'bi-check2' : 'bi-pencil' }}"></i>
                        {{ post.published ? 'Published' : 'Draft' }}
                      </span>
                    </td>
                    <td class="text-center" data-label="Actions">
                      <a href="/admin/posts/view?id={{ post.id }}"
                         class="modern-btn btn-sm btn-info mr-1"
                         title="View">
                        <i class="bi bi-eye-fill"></i>
                      </a>
                      <a href="/admin/posts/edit?id={{ post.id }}"
                         class="modern-btn btn-sm btn-warning mr-1"
                         title="Edit">
                        <i class="bi bi-pencil-square"></i>
                      </a>
                      <a href="/admin/posts/delete?id={{ post.id }}"
                         class="modern-btn btn-sm btn-danger"
                         title="Delete"
                         onclick="return confirm('Are you sure you want to delete this post?');">
                        <i class="bi bi-trash3-fill"></i>
                      </a>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      {% include "admin/partials/pagination.twig" %}
    {% else %}
      <div class="alert alert-info">
        <i class="bi bi-info-circle mr-1"></i> No posts found.
      </div>
    {% endif %}
  </div>
{% endblock %}

