{% extends "admin/layout.twig" %}

{% block title %}Pipeline Run #{{ run.id }} - {{ parent() }}{% endblock %}

{% block content %}
<style>
  .detail-shell {
    --detail-ink: #0f172a;
    --detail-muted: #64748b;
    --detail-line: #e2e8f0;
    --detail-soft: #f8fafc;
    --detail-border: 1px solid var(--detail-line);
  }
  .detail-shell .hero {
    border: var(--detail-border);
    border-radius: 1rem;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .detail-shell .hero h1 {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--detail-ink);
    margin-bottom: 0.5rem;
  }
  .detail-shell .hero-meta {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .detail-shell .hero-meta-item {
    display: flex;
    flex-direction: column;
  }
  .detail-shell .hero-meta-label {
    color: var(--detail-muted);
    font-size: 0.85rem;
    margin-bottom: 0.25rem;
  }
  .detail-shell .hero-meta-value {
    color: var(--detail-ink);
    font-weight: 600;
  }
  .detail-shell .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .detail-shell .status-badge.success {
    background: #dcfce7;
    color: #16a34a;
  }
  .detail-shell .status-badge.partial {
    background: #fef3c7;
    color: #92400e;
  }
  .detail-shell .status-badge.failed {
    background: #fee2e2;
    color: #dc2626;
  }
  .detail-shell .section {
    border: var(--detail-border);
    border-radius: 1rem;
    background: #fff;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .detail-shell .section-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--detail-ink);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .detail-shell .section-title i {
    color: var(--detail-muted);
  }
  .detail-shell .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }
  .detail-shell .info-item {
    padding: 0.875rem;
    background: var(--detail-soft);
    border-radius: 0.7rem;
    border: 1px solid var(--detail-line);
  }
  .detail-shell .info-label {
    color: var(--detail-muted);
    font-size: 0.8rem;
    margin-bottom: 0.3rem;
  }
  .detail-shell .info-value {
    color: var(--detail-ink);
    font-weight: 600;
    word-break: break-word;
  }
  .detail-shell .stat-row {
    display: flex;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: var(--detail-border);
  }
  .detail-shell .stat-row:last-child {
    border-bottom: none;
  }
  .detail-shell .stat-row-label {
    color: var(--detail-muted);
    flex: 1;
  }
  .detail-shell .stat-row-value {
    color: var(--detail-ink);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .detail-shell .button-group {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .detail-shell .btn {
    padding: 0.6rem 1.2rem;
    border-radius: 0.6rem;
    border: 1px solid var(--detail-line);
    background: #fff;
    color: var(--detail-ink);
    text-decoration: none;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .detail-shell .btn:hover {
    background: var(--detail-soft);
  }
  .detail-shell .btn-primary {
    background: #3b82f6;
    color: #fff;
    border-color: #3b82f6;
  }
  .detail-shell .btn-primary:hover {
    background: #2563eb;
    border-color: #2563eb;
  }
  .detail-shell .btn-danger {
    background: #ef4444;
    color: #fff;
    border-color: #ef4444;
  }
  .detail-shell .btn-danger:hover {
    background: #dc2626;
    border-color: #dc2626;
  }
  .detail-shell .json-display {
    background: var(--detail-soft);
    border: var(--detail-border);
    border-radius: 0.7rem;
    padding: 1rem;
    font-family: 'Monaco', 'Courier New', monospace;
    font-size: 0.85rem;
    overflow-x: auto;
    color: var(--detail-ink);
    max-height: 400px;
    overflow-y: auto;
  }
  .detail-shell .timeline {
    position: relative;
    padding-left: 2rem;
  }
  .detail-shell .timeline::before {
    content: '';
    position: absolute;
    left: 0.35rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--detail-line);
  }
  .detail-shell .timeline-item {
    margin-bottom: 1.5rem;
    position: relative;
  }
  .detail-shell .timeline-item::before {
    content: '';
    position: absolute;
    left: -1.85rem;
    top: 0.2rem;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 999px;
    background: #fff;
    border: 2px solid var(--detail-line);
  }
  .detail-shell .timeline-label {
    color: var(--detail-muted);
    font-size: 0.85rem;
  }
  .detail-shell .timeline-value {
    color: var(--detail-ink);
    font-weight: 600;
    margin-top: 0.2rem;
  }
</style>

<div class="detail-shell container-fluid py-4">
  <!-- Hero Section -->
  <div class="hero">
    <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
      <h1 style="margin: 0;">Pipeline Run #{{ run.id }}</h1>
      {% set statusColor = run.status == 'success' ? 'success' : (run.status == 'partial' ? 'partial' : 'failed') %}
      <span class="status-badge {{ statusColor }}">
        <i class="bi bi-{% if run.status == 'success' %}check-circle{% elseif run.status == 'partial' %}exclamation-circle{% else %}x-circle{% endif %}"></i>
        {{ run.status|upper }}
      </span>
    </div>
    
    <div class="hero-meta">
      <div class="hero-meta-item">
        <span class="hero-meta-label">Action</span>
        <span class="hero-meta-value">{{ run.action_name }}</span>
      </div>
      <div class="hero-meta-item">
        <span class="hero-meta-label">Source</span>
        <span class="hero-meta-value">{{ run.trigger_source }}</span>
      </div>
      <div class="hero-meta-item">
        <span class="hero-meta-label">Scope</span>
        <span class="hero-meta-value">{{ run.scope_type }}</span>
      </div>
      <div class="hero-meta-item">
        <span class="hero-meta-label">Duration</span>
        <span class="hero-meta-value">{{ run.duration_ms }}ms</span>
      </div>
    </div>
  </div>

  <!-- Statistics Section -->
  <div class="row mb-4">
    <div class="col-md-3 mb-3">
      <div class="section" style="border-color: #dcfce7; background: #f0fdf4;">
        <div style="color: #16a34a; font-size: 2.5rem; font-weight: 700; line-height: 1;">{{ run.published_count }}</div>
        <div style="color: #16a34a; font-size: 0.9rem; margin-top: 0.25rem;">Published Items</div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="section" style="border-color: #fef3c7; background: #fffbeb;">
        <div style="color: #d97706; font-size: 2.5rem; font-weight: 700; line-height: 1;">{{ run.failed_count }}</div>
        <div style="color: #d97706; font-size: 0.9rem; margin-top: 0.25rem;">Failed Items</div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="section" style="border-color: #e0e7ff; background: #f0f4ff;">
        <div style="color: #4f46e5; font-size: 2.5rem; font-weight: 700; line-height: 1;">{{ run.fetched_count }}</div>
        <div style="color: #4f46e5; font-size: 0.9rem; margin-top: 0.25rem;">Total Fetched</div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="section" style="border-color: #fce7f3; background: #fdf2f8;">
        <div style="color: #be185d; font-size: 2.5rem; font-weight: 700; line-height: 1;">{{ run.ai_used_count }}</div>
        <div style="color: #be185d; font-size: 0.9rem; margin-top: 0.25rem;">AI Used</div>
      </div>
    </div>
  </div>

  <!-- Execution Details -->
  <div class="section">
    <div class="section-title">
      <i class="bi bi-clock-history"></i>
      Execution Timeline
    </div>
    <div class="timeline">
      <div class="timeline-item">
        <div class="timeline-label">Started</div>
        <div class="timeline-value">{{ run.started_at }}</div>
      </div>
      <div class="timeline-item">
        <div class="timeline-label">Finished</div>
        <div class="timeline-value">{{ run.finished_at }}</div>
      </div>
    </div>
  </div>

  <!-- Configuration Details -->
  <div class="section">
    <div class="section-title">
      <i class="bi bi-sliders"></i>
      Configuration
    </div>
    <div class="info-grid">
      <div class="info-item">
        <div class="info-label">Action Name</div>
        <div class="info-value">{{ run.action_name }}</div>
      </div>
      <div class="info-item">
        <div class="info-label">Trigger Source</div>
        <div class="info-value">{{ run.trigger_source }}</div>
      </div>
      <div class="info-item">
        <div class="info-label">Scope Type</div>
        <div class="info-value">{{ run.scope_type }}</div>
      </div>
      <div class="info-item">
        <div class="info-label">Batch Limit</div>
        <div class="info-value">{{ run.batch_limit }}</div>
      </div>
      <div class="info-item">
        <div class="info-label">Provider</div>
        <div class="info-value">{{ run.provider_name or 'N/A' }}</div>
      </div>
      <div class="info-item">
        <div class="info-label">Model</div>
        <div class="info-value">{{ run.model_name or 'N/A' }}</div>
      </div>
    </div>
  </div>

  <!-- Request Information -->
  <div class="section">
    <div class="section-title">
      <i class="bi bi-globe"></i>
      Request Information
    </div>
    <div class="info-grid">
      <div class="info-item">
        <div class="info-label">URI</div>
        <div class="info-value" style="font-size: 0.9rem;">{{ run.request_uri }}</div>
      </div>
      <div class="info-item">
        <div class="info-label">IP Address</div>
        <div class="info-value">{{ run.ip_address }}</div>
      </div>
      <div class="info-item">
        <div class="info-label">User Agent</div>
        <div class="info-value" style="font-size: 0.85rem;">{{ run.user_agent }}</div>
      </div>
    </div>
  </div>

  <!-- Status Information -->
  {% if run.error_message %}
  <div class="section" style="border-left: 4px solid #dc2626;">
    <div class="section-title" style="color: #dc2626;">
      <i class="bi bi-exclamation-triangle"></i>
      Error Message
    </div>
    <div style="background: #fee2e2; padding: 1rem; border-radius: 0.7rem; color: #7f1d1d; font-size: 0.9rem; word-break: break-word;">
      {{ run.error_message }}
    </div>
  </div>
  {% endif %}

  <!-- Summary JSON -->
  {% if run.summary_json %}
  <div class="section">
    <div class="section-title">
      <i class="bi bi-file-code"></i>
      Summary Data
    </div>
    <div class="json-display">{{ run.summary_json|json_encode(constant('JSON_PRETTY_PRINT')) }}</div>
  </div>
  {% endif %}

  <!-- Results JSON -->
  {% if run.results_json %}
  <div class="section">
    <div class="section-title">
      <i class="bi bi-file-earmark-code"></i>
      Results Data
    </div>
    <div class="json-display">{{ run.results_json|json_encode(constant('JSON_PRETTY_PRINT')) }}</div>
  </div>
  {% endif %}

  <!-- Actions -->
  <div class="section">
    <div class="section-title">
      <i class="bi bi-tools"></i>
      Actions
    </div>
    <div class="button-group">
      <a href="{{ route_base }}/pipeline-runs" class="btn">
        <i class="bi bi-arrow-left"></i>
        Back to Runs
      </a>
      {% if run.status == 'failed' %}
      <button class="btn btn-primary" onclick="retryRun({{ run.id }})">
        <i class="bi bi-arrow-clockwise"></i>
        Retry Run
      </button>
      {% endif %}
      <button class="btn btn-danger" onclick="deleteRun({{ run.id }})">
        <i class="bi bi-trash"></i>
        Delete Run
      </button>
    </div>
  </div>
</div>

<script>
  function retryRun(id) {
    if (!confirm('Are you sure you want to retry this pipeline run?')) return;
    
    const formData = new FormData();
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    
    fetch(`{{ route_base }}/pipeline-runs/${id}/retry`, {
      method: 'POST',
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
        ...(csrfToken && { 'X-CSRF-Token': csrfToken })
      },
      body: formData
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        alert('Pipeline run retry initiated');
        location.reload();
      } else {
        alert('Error: ' + (data.error || 'Unknown error'));
      }
    })
    .catch(e => alert('Error: ' + e.message));
  }
  
  function deleteRun(id) {
    if (!confirm('Are you sure you want to delete this pipeline run? This action cannot be undone.')) return;
    
    const formData = new FormData();
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    
    fetch(`{{ route_base }}/pipeline-runs/${id}/delete`, {
      method: 'POST',
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
        ...(csrfToken && { 'X-CSRF-Token': csrfToken })
      },
      body: formData
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        alert('Pipeline run deleted');
        window.location.href = '{{ route_base }}/pipeline-runs';
      } else {
        alert('Error: ' + (data.error || 'Unknown error'));
      }
    })
    .catch(e => alert('Error: ' + e.message));
  }
</script>

{% endblock %}

