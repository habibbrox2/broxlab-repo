{% extends "admin/layout.twig" %}

{% block title %}All Pipeline Logs - {{ parent() }}{% endblock %}

{% block content %}
<style>
  .pipeline-shell {
    --pipeline-ink: #0f172a;
    --pipeline-muted: #64748b;
    --pipeline-line: #e2e8f0;
    --pipeline-soft: #f8fafc;
  }
  .pipeline-shell .hero {
    border: 1px solid var(--pipeline-line);
    border-radius: 1rem;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    padding: 1.25rem 1.35rem;
    margin-bottom: 1rem;
  }
  .pipeline-shell .hero h1 {
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--pipeline-ink);
    margin-bottom: 0.35rem;
  }
  .pipeline-shell .hero p {
    color: var(--pipeline-muted);
    margin: 0;
  }
  .pipeline-shell .stat-card {
    border: 1px solid var(--pipeline-line);
    border-radius: 0.9rem;
    background: #fff;
  }
  .pipeline-shell .stat-icon {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  .pipeline-shell .stat-icon.success {
    background: #dcfce7;
    color: #16a34a;
  }
  .pipeline-shell .stat-icon.warning {
    background: #fef3c7;
    color: #d97706;
  }
  .pipeline-shell .stat-icon.error {
    background: #fee2e2;
    color: #dc2626;
  }
  .pipeline-shell .stat-value {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--pipeline-ink);
    line-height: 1.1;
  }
  .pipeline-shell .stat-label {
    color: var(--pipeline-muted);
    font-size: 0.8rem;
  }
  .pipeline-shell .filter-card {
    border: 1px solid var(--pipeline-line);
    border-radius: 0.95rem;
  }
  .pipeline-shell .filter-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--pipeline-ink);
  }
  .pipeline-shell .log-card {
    border: 1px solid var(--pipeline-line);
    border-radius: 0.95rem;
    margin-bottom: 0.75rem;
    background: #fff;
  }
  .pipeline-shell .log-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .pipeline-shell .log-status.success {
    background: #dcfce7;
    color: #16a34a;
  }
  .pipeline-shell .log-status.partial {
    background: #fef3c7;
    color: #92400e;
  }
  .pipeline-shell .log-status.failed {
    background: #fee2e2;
    color: #dc2626;
  }
  .pipeline-shell .checkbox {
    width: 20px;
    height: 20px;
    cursor: pointer;
  }
  .pipeline-shell .bulk-actions {
    background: #f0f9ff;
    border: 1px solid #0ea5e9;
    border-radius: 0.95rem;
    padding: 1rem;
    margin-bottom: 1rem;
    display: none;
  }
  .pipeline-shell .bulk-actions.show {
    display: block;
  }
</style>

<div class="pipeline-shell">
  <div class="hero">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
      <div>
        <h1>All Pipeline Logs</h1>
        <p>Complete execution history of all scraper pipeline runs.</p>
      </div>
      <a class="btn btn-outline-secondary btn-sm" href="/admin/scrap-control-center">Back to Control Center</a>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-lg-2 col-6">
      <div class="card stat-card">
        <div class="card-body">
          <div class="d-flex align-items-center gap-2">
            <span class="stat-icon success"><i class="bi bi-check-circle"></i></span>
            <div>
              <div class="stat-value">{{ stats.success|default(0) }}</div>
              <div class="stat-label">Successful</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-2 col-6">
      <div class="card stat-card">
        <div class="card-body">
          <div class="d-flex align-items-center gap-2">
            <span class="stat-icon warning"><i class="bi bi-exclamation-circle"></i></span>
            <div>
              <div class="stat-value">{{ stats.partial|default(0) }}</div>
              <div class="stat-label">Partial</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-2 col-6">
      <div class="card stat-card">
        <div class="card-body">
          <div class="d-flex align-items-center gap-2">
            <span class="stat-icon error"><i class="bi bi-x-circle"></i></span>
            <div>
              <div class="stat-value">{{ stats.failed|default(0) }}</div>
              <div class="stat-label">Failed</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-2 col-6">
      <div class="card stat-card">
        <div class="card-body">
          <div class="d-flex align-items-center gap-2">
            <span class="stat-icon"><i class="bi bi-hourglass-split"></i></span>
            <div>
              <div class="stat-value">{{ total|default(0) }}</div>
              <div class="stat-label">Total</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card" style="border: 1px solid #e2e8f0; border-radius: 0.95rem; margin-bottom: 1rem;">
    <div class="card-body">
      <div style="font-weight: 700; color: #0f172a; margin-bottom: 0.75rem;">Quick Navigation</div>
      <div class="row g-2">
        <div class="col-md-3">
          <a href="/admin/scrap-control-center/all-pipeline-logs" class="btn btn-info btn-sm w-100" style="pointer-events: none;">
            <i class="bi bi-file-text"></i> All Logs
          </a>
        </div>
        <div class="col-md-3">
          <a href="/admin/scrap-control-center/pipeline-runs" class="btn btn-outline-primary btn-sm w-100">
            <i class="bi bi-play-circle"></i> Pipeline Runs
          </a>
        </div>
        <div class="col-md-3">
          <a href="/admin/scrap-control-center/failed-pipeline-logs" class="btn btn-outline-danger btn-sm w-100">
            <i class="bi bi-exclamation-circle"></i> Failed Logs
          </a>
        </div>
        <div class="col-md-3">
          <a href="/admin/scrap-control-center/incoming" class="btn btn-outline-success btn-sm w-100">
            <i class="bi bi-inbox"></i> Incoming Items
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="card filter-card mb-4">
    <div class="card-body">
      <div class="filter-title mb-3">Filters</div>
      <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
          <label class="form-label">Action</label>
          <select name="action" class="form-control">
            <option value="">All Actions</option>
            <option value="run-pipeline" {{ action_filter == 'run-pipeline' ? 'selected' }}>Run Pipeline</option>
            <option value="auto-run-pipeline" {{ action_filter == 'auto-run-pipeline' ? 'selected' }}>Auto Run Pipeline</option>
            <option value="cron-run-pipeline" {{ action_filter == 'cron-run-pipeline' ? 'selected' }}>Cron Run Pipeline</option>
            <option value="publish-pending" {{ action_filter == 'publish-pending' ? 'selected' }}>Publish Pending</option>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">Status</label>
          <select name="status" class="form-control">
            <option value="">All Statuses</option>
            <option value="success" {{ status_filter == 'success' ? 'selected' }}>Success</option>
            <option value="partial" {{ status_filter == 'partial' ? 'selected' }}>Partial</option>
            <option value="failed" {{ status_filter == 'failed' ? 'selected' }}>Failed</option>
          </select>
        </div>
        <div class="col-md-2">
          <button class="btn btn-primary w-100" type="submit">Apply Filters</button>
        </div>
        <div class="col-md-2">
          <a class="btn btn-outline-secondary w-100" href="/admin/scrap-control-center/all-pipeline-logs">Reset</a>
        </div>
      </form>
    </div>
  </div>

  {% if logs|length > 0 %}
    <div class="bulk-actions" id="bulkActionsBar">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <label class="form-check-label">
          <input type="checkbox" id="selectAllCheckbox" class="checkbox form-check-input">
          <span><span id="selectedCount">0</span> logs selected</span>
        </label>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-sm btn-outline-danger" id="bulkDeleteBtn" disabled>
            <i class="bi bi-trash"></i> Delete Selected
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="cancelBulkBtn">
            Cancel
          </button>
        </div>
      </div>
    </div>

    {% for log in logs %}
      <div class="card log-card" data-log-id="{{ log.id }}">
        <div class="card-body">
          <div class="row align-items-start">
            <div class="col-md-1 d-flex align-items-center">
              <input type="checkbox" class="checkbox form-check-input log-checkbox" data-log-id="{{ log.id }}">
            </div>
            <div class="col-md-10">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <div class="fw-bold">
                    Run #{{ log.id }} - {{ log.action_name|default('Unknown') }}
                    <span class="log-status {{ log.status|default('failed') }}">
                      <i class="bi bi-{{ log.status == 'success' ? 'check-circle' : (log.status == 'partial' ? 'exclamation-circle' : 'x-circle') }}"></i>
                      {{ log.status|upper }}
                    </span>
                  </div>
                  <div class="text-muted small mt-1">
                    Started: {{ log.started_at|date('M d, Y H:i:s') }}
                    {% if log.finished_at %}
                      â€¢ Finished: {{ log.finished_at|date('M d, Y H:i:s') }}
                    {% endif %}
                    â€¢ Duration: {{ log.duration_ms|default(0) }}ms
                    â€¢ Trigger: {{ log.trigger_source|default('manual') }}
                  </div>
                </div>
                <a class="btn btn-sm btn-outline-primary" href="/admin/scrap-control-center/pipeline-runs/{{ log.id }}">
                  Details <i class="bi bi-arrow-right"></i>
                </a>
              </div>

              <div class="row g-3 mt-2" style="font-size: 0.85rem;">
                <div class="col-sm-2">
                  <div class="text-muted">Fetched</div>
                  <div class="fw-bold">{{ log.fetched_count|default(0) }}</div>
                </div>
                <div class="col-sm-2">
                  <div class="text-muted">Published</div>
                  <div class="fw-bold text-success">{{ log.published_count|default(0) }}</div>
                </div>
                <div class="col-sm-2">
                  <div class="text-muted">Failed</div>
                  <div class="fw-bold text-danger">{{ log.failed_count|default(0) }}</div>
                </div>
                <div class="col-sm-2">
                  <div class="text-muted">Skipped</div>
                  <div class="fw-bold">{{ log.skipped_duplicates|default(0) }}</div>
                </div>
                <div class="col-sm-2">
                  <div class="text-muted">AI Used</div>
                  <div class="fw-bold">{{ log.ai_used_count|default(0) }}</div>
                </div>
                <div class="col-sm-2">
                  <div class="text-muted">Provider</div>
                  <div class="fw-bold">{{ log.provider_name|default('N/A') }}</div>
                </div>
              </div>

              {% if log.error_message %}
                <div class="mt-3 p-2 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded small text-danger">
                  <strong>Error:</strong> {{ log.error_message }}
                </div>
              {% endif %}
            </div>
            <div class="col-md-1 d-flex justify-content-end">
              <button type="button" class="btn btn-sm btn-outline-danger delete-log-btn" data-log-id="{{ log.id }}" title="Delete this log">
                <i class="bi bi-trash"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}

    {% if total_pages > 1 %}
      <nav aria-label="pagination" class="mt-4">
        <ul class="pagination justify-content-center">
          {% if current_page_number > 1 %}
            <li class="page-item">
              <a class="page-link" href="?page={{ current_page_number - 1 }}&action={{ action_filter }}&status={{ status_filter }}">&laquo;</a>
            </li>
          {% endif %}
          {% for p in 1..total_pages %}
            {% if p == current_page_number or p == 1 or p == total_pages or (p >= current_page_number - 2 and p <= current_page_number + 2) %}
              <li class="page-item {{ p == current_page_number ? 'active' }}">
                <a class="page-link" href="?page={{ p }}&action={{ action_filter }}&status={{ status_filter }}">{{ p }}</a>
              </li>
            {% endif %}
          {% endfor %}
          {% if current_page_number < total_pages %}
            <li class="page-item">
              <a class="page-link" href="?page={{ current_page_number + 1 }}&action={{ action_filter }}&status={{ status_filter }}">&raquo;</a>
            </li>
          {% endif %}
        </ul>
      </nav>
    {% endif %}
  {% else %}
    <div class="card border-0 shadow-sm">
      <div class="card-body py-5 text-center">
        <div class="text-muted">No pipeline logs found.</div>
      </div>
    </div>
  {% endif %}
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const bulkActionsBar = document.getElementById("bulkActionsBar");
    const selectAllCheckbox = document.getElementById("selectAllCheckbox");
    const bulkDeleteBtn = document.getElementById("bulkDeleteBtn");
    const cancelBulkBtn = document.getElementById("cancelBulkBtn");
    const selectedCountSpan = document.getElementById("selectedCount");
    const logCheckboxes = document.querySelectorAll(".log-checkbox");
    const logCards = document.querySelectorAll(".log-card");
    const deleteLogBtns = document.querySelectorAll(".delete-log-btn");

    function updateBulkActionsBar() {
        const selectedLogs = Array.from(logCheckboxes).filter(cb => cb.checked);
        const selectedCount = selectedLogs.length;

        if (selectedCount > 0) {
            bulkActionsBar.classList.add("show");
            selectedCountSpan.textContent = selectedCount;
            bulkDeleteBtn.disabled = false;
        } else {
            bulkActionsBar.classList.remove("show");
            selectedCountSpan.textContent = "0";
            bulkDeleteBtn.disabled = true;
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = false;
        }

        logCards.forEach(card => {
            const checkbox = card.querySelector(".log-checkbox");
            if (checkbox && checkbox.checked) {
                card.style.backgroundColor = "#f0f9ff";
            } else {
                card.style.backgroundColor = "#fff";
            }
        });
    }

    logCheckboxes.forEach(checkbox => {
        checkbox.addEventListener("change", function() {
            updateBulkActionsBar();
            updateSelectAllCheckbox();
        });
    });

    function updateSelectAllCheckbox() {
        const totalCheckboxes = logCheckboxes.length;
        const checkedCheckboxes = Array.from(logCheckboxes).filter(cb => cb.checked).length;

        if (checkedCheckboxes === 0) {
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = false;
        } else if (checkedCheckboxes === totalCheckboxes) {
            selectAllCheckbox.checked = true;
            selectAllCheckbox.indeterminate = false;
        } else {
            selectAllCheckbox.indeterminate = true;
        }
    }

    selectAllCheckbox.addEventListener("change", function() {
        logCheckboxes.forEach(checkbox => {
            checkbox.checked = this.checked;
        });
        updateBulkActionsBar();
    });

    bulkDeleteBtn.addEventListener("click", function() {
        const selectedLogs = Array.from(logCheckboxes)
            .filter(cb => cb.checked)
            .map(cb => cb.getAttribute("data-log-id"));

        if (selectedLogs.length === 0) return;

        const logText = selectedLogs.length === 1 ? "1 log" : selectedLogs.length + " logs";
        if (!confirm(`Delete ${logText}? This action cannot be undone.`)) {
            return;
        }

        bulkDeleteBtn.disabled = true;
        bulkDeleteBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Deleting...';

        let completed = 0;
        selectedLogs.forEach(logId => {
            fetch(`/admin/api/scrap-control-center/pipeline-runs/${logId}/delete`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                }
            })
            .then(response => {
                if (response.ok) {
                    const card = document.querySelector(`.log-card[data-log-id="${logId}"]`);
                    if (card) {
                        card.style.opacity = "0";
                        card.style.transition = "opacity 0.3s ease";
                        setTimeout(() => card.remove(), 300);
                    }
                }
                completed++;
                if (completed === selectedLogs.length) {
                    bulkDeleteBtn.disabled = false;
                    bulkDeleteBtn.innerHTML = '<i class="bi bi-trash"></i> Delete Selected';
                    updateBulkActionsBar();
                    location.reload();
                }
            })
            .catch(error => {
                console.error("Error deleting log:", error);
                completed++;
                if (completed === selectedLogs.length) {
                    bulkDeleteBtn.disabled = false;
                    bulkDeleteBtn.innerHTML = '<i class="bi bi-trash"></i> Delete Selected';
                }
            });
        });
    });

    cancelBulkBtn.addEventListener("click", function() {
        logCheckboxes.forEach(checkbox => {
            checkbox.checked = false;
        });
        updateBulkActionsBar();
    });

    deleteLogBtns.forEach(btn => {
        btn.addEventListener("click", function() {
            const logId = this.getAttribute("data-log-id");
            const card = document.querySelector(`.log-card[data-log-id="${logId}"]`);

            if (!confirm("Delete this pipeline log? This action cannot be undone.")) {
                return;
            }

            const originalText = this.innerHTML;
            this.disabled = true;
            this.innerHTML = '<i class="bi bi-hourglass-split"></i>';

            fetch(`/admin/api/scrap-control-center/pipeline-runs/${logId}/delete`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                }
            })
            .then(response => {
                if (response.ok) {
                    card.style.opacity = "0";
                    card.style.transition = "opacity 0.3s ease";
                    setTimeout(() => card.remove(), 300);
                    setTimeout(() => location.reload(), 500);
                } else {
                    this.disabled = false;
                    this.innerHTML = originalText;
                    alert("Failed to delete log");
                }
            })
            .catch(error => {
                console.error("Error deleting log:", error);
                this.disabled = false;
                this.innerHTML = originalText;
                alert("Error deleting log: " + error.message);
            });
        });
    });
});
</script>
{% endblock %}

