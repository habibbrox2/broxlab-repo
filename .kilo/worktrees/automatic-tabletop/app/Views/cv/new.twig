{% extends 'layout.twig' %}

{% block title %}{{ page_title|default('Create New CV') }}{% endblock %}

{% block extra_styles %}
<style>
    :root {
        --cv-new-primary: #667eea;
        --cv-new-secondary: #764ba2;
        --cv-new-success: #059669;
        --cv-new-warning: #F59E0B;
        --cv-new-danger: #DC2626;
        --cv-new-gray-50: #F9FAFB;
        --cv-new-gray-100: #F3F4F6;
        --cv-new-gray-200: #E5E7EB;
        --cv-new-gray-300: #D1D5DB;
        --cv-new-gray-400: #9CA3AF;
        --cv-new-gray-500: #6B7280;
        --cv-new-gray-600: #4B5563;
        --cv-new-gray-700: #374151;
        --cv-new-gray-800: #1F2937;
        --cv-new-gray-900: #111827;
    }

    .cv-new-page {
        min-height: 100vh;
        background: linear-gradient(135deg, var(--cv-new-primary) 0%, var(--cv-new-secondary) 100%);
        padding: 2rem 1rem;
        position: relative;
        overflow: hidden;
    }

    .cv-new-page::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background:
            radial-gradient(circle at 20% 20%, rgba(255,255,255,0.1) 0%, transparent 50%),
            radial-gradient(circle at 80% 80%, rgba(255,255,255,0.05) 0%, transparent 50%);
        pointer-events: none;
    }

    .cv-new-container {
        max-width: 800px;
        margin: 0 auto;
        position: relative;
        z-index: 2;
    }

    .cv-new-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .cv-new-title {
        font-size: 3rem;
        font-weight: 800;
        color: white;
        margin-bottom: 1rem;
        text-shadow: 0 4px 8px rgba(0,0,0,0.2);
        background: linear-gradient(135deg, white 0%, rgba(255,255,255,0.9) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .cv-new-subtitle {
        font-size: 1.2rem;
        color: rgba(255,255,255,0.9);
        margin-bottom: 2rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.6;
    }

    .cv-creation-options {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .cv-option-card {
        background: white;
        border-radius: 24px;
        padding: 2rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid rgba(255,255,255,0.2);
        position: relative;
        overflow: hidden;
        cursor: pointer;
    }

    .cv-option-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--cv-new-primary), var(--cv-new-secondary));
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .cv-option-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 30px 80px rgba(0,0,0,0.2);
    }

    .cv-option-card:hover::before {
        opacity: 1;
    }

    .cv-option-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, var(--cv-new-primary) 0%, var(--cv-new-secondary) 100%);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        position: relative;
        box-shadow: 0 20px 60px rgba(102,126,234,0.3);
    }

    .cv-option-icon::before {
        content: '';
        position: absolute;
        inset: -4px;
        background: linear-gradient(135deg, var(--cv-new-primary) 0%, var(--cv-new-secondary) 100%);
        border-radius: 24px;
        opacity: 0.3;
        filter: blur(8px);
    }

    .cv-option-icon i {
        font-size: 2.5rem;
        color: white;
        position: relative;
        z-index: 1;
    }

    .cv-option-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--cv-new-gray-800);
        margin-bottom: 0.5rem;
        text-align: center;
    }

    .cv-option-desc {
        color: var(--cv-new-gray-600);
        text-align: center;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }

    .cv-option-features {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .cv-option-features li {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
        color: var(--cv-new-gray-600);
    }

    .cv-option-features li i {
        color: var(--cv-new-success);
        font-size: 0.8rem;
    }

    .cv-create-form {
        background: white;
        border-radius: 24px;
        padding: 3rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        border: 1px solid rgba(255,255,255,0.2);
        position: relative;
        overflow: hidden;
    }

    .cv-create-form::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(102,126,234,0.05) 0%, transparent 70%);
        animation: float 8s ease-in-out infinite;
    }

    .cv-form-header {
        text-align: center;
        margin-bottom: 2rem;
        position: relative;
        z-index: 1;
    }

    .cv-form-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--cv-new-gray-800);
        margin-bottom: 0.5rem;
    }

    .cv-form-subtitle {
        color: var(--cv-new-gray-500);
        font-size: 1rem;
    }

    .cv-form-group {
        margin-bottom: 2rem;
        position: relative;
        z-index: 1;
    }

    .cv-form-label {
        display: block;
        font-weight: 600;
        color: var(--cv-new-gray-700);
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .cv-form-input {
        width: 100%;
        padding: 1rem 1.25rem;
        border: 2px solid var(--cv-new-gray-200);
        border-radius: 12px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: var(--cv-new-gray-50);
    }

    .cv-form-input:focus {
        outline: none;
        border-color: var(--cv-new-primary);
        background: white;
        box-shadow: 0 0 0 3px rgba(102,126,234,0.1);
        transform: translateY(-1px);
    }

    .cv-form-input::placeholder {
        color: var(--cv-new-gray-400);
    }

    .cv-templates-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .cv-template-option {
        border: 2px solid var(--cv-new-gray-200);
        border-radius: 12px;
        padding: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        background: white;
        text-align: center;
    }

    .cv-template-option:hover,
    .cv-template-option.selected {
        border-color: var(--cv-new-primary);
        background: rgba(102,126,234,0.05);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(102,126,234,0.15);
    }

    .cv-template-preview {
        height: 80px;
        background: linear-gradient(135deg, var(--cv-new-gray-200) 0%, var(--cv-new-gray-300) 100%);
        border-radius: 8px;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cv-template-name {
        font-weight: 600;
        color: var(--cv-new-gray-800);
        margin-bottom: 0.25rem;
    }

    .cv-template-desc {
        font-size: 0.8rem;
        color: var(--cv-new-gray-500);
    }

    .cv-form-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .cv-btn {
        padding: 1rem 2rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1rem;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        min-width: 160px;
        justify-content: center;
    }

    .cv-btn-primary {
        background: linear-gradient(135deg, var(--cv-new-primary) 0%, var(--cv-new-secondary) 100%);
        color: white;
        box-shadow: 0 8px 30px rgba(102,126,234,0.4);
    }

    .cv-btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(102,126,234,0.5);
    }

    .cv-btn-secondary {
        background: white;
        color: var(--cv-new-gray-700);
        border: 2px solid var(--cv-new-gray-200);
    }

    .cv-btn-secondary:hover {
        background: var(--cv-new-gray-50);
        border-color: var(--cv-new-gray-300);
        transform: translateY(-2px);
    }

    .cv-quick-start {
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        padding: 2rem;
        margin-top: 2rem;
        border: 1px solid rgba(255,255,255,0.2);
    }

    .cv-quick-start h4 {
        color: white;
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
        text-align: center;
    }

    .cv-quick-templates {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
    }

    .cv-quick-template {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 12px;
        padding: 1rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .cv-quick-template:hover {
        background: rgba(255,255,255,0.2);
        transform: translateY(-2px);
    }

    .cv-quick-template i {
        font-size: 1.5rem;
        color: white;
        margin-bottom: 0.5rem;
        display: block;
    }

    .cv-quick-template span {
        color: white;
        font-size: 0.9rem;
        font-weight: 500;
    }

    @media (max-width: 768px) {
        .cv-new-page {
            padding: 1rem 0.5rem;
        }

        .cv-new-title {
            font-size: 2.5rem;
        }

        .cv-creation-options {
            grid-template-columns: 1fr;
        }

        .cv-create-form {
            padding: 2rem 1.5rem;
        }

        .cv-form-actions {
            flex-direction: column;
        }

        .cv-btn {
            width: 100%;
        }
    }

    @keyframes float {
        0%, 100% { transform: translate(-50%, -50%) rotate(0deg); }
        50% { transform: translate(-50%, -50%) rotate(180deg); }
    }
</style>
{% endblock %}

{% block content %}
<div class="cv-new-page">
    <div class="cv-new-container">
        <div class="cv-new-header">
            <h1 class="cv-new-title">Create Your Professional CV</h1>
            <p class="cv-new-subtitle">
                Choose how you'd like to start building your CV. Select a template or start from scratch with our modern editor.
            </p>
        </div>

        <div class="cv-creation-options">
            <!-- Quick Start with Template -->
            <div class="cv-option-card" onclick="showTemplateSelection()">
                <div class="cv-option-icon">
                    <i class="bi bi-palette"></i>
                </div>
                <h3 class="cv-option-title">Start with Template</h3>
                <p class="cv-option-desc">
                    Choose from professionally designed templates optimized for different industries and career levels.
                </p>
                <ul class="cv-option-features">
                    <li><i class="bi bi-check-circle"></i> ATS-friendly designs</li>
                    <li><i class="bi bi-check-circle"></i> Industry-specific layouts</li>
                    <li><i class="bi bi-check-circle"></i> Mobile-responsive</li>
                    <li><i class="bi bi-check-circle"></i> Easy customization</li>
                </ul>
            </div>

            <!-- Start from Scratch -->
            <div class="cv-option-card" onclick="showScratchForm()">
                <div class="cv-option-icon">
                    <i class="bi bi-plus-circle"></i>
                </div>
                <h3 class="cv-option-title">Start from Scratch</h3>
                <p class="cv-option-desc">
                    Build your CV completely from scratch with full control over every section and design element.
                </p>
                <ul class="cv-option-features">
                    <li><i class="bi bi-check-circle"></i> Complete customization</li>
                    <li><i class="bi bi-check-circle"></i> Add any sections</li>
                    <li><i class="bi bi-check-circle"></i> Full design control</li>
                    <li><i class="bi bi-check-circle"></i> Advanced features</li>
                </ul>
            </div>
        </div>

        <!-- Template Selection Form -->
        <div id="templateForm" class="cv-create-form" style="display: none;">
            <div class="cv-form-header">
                <h2 class="cv-form-title">Choose Your Template</h2>
                <p class="cv-form-subtitle">Select a template that best matches your career goals</p>
            </div>

            <form method="POST" action="/cv">
                <input type="hidden" name="csrf_token" value="{{ csrf_token|default('') }}">
                <input type="hidden" id="selectedTemplate" name="template" value="modern">

                <div class="cv-form-group">
                    <label for="cvTitle" class="cv-form-label">CV Title</label>
                    <input id="cvTitle" name="title" type="text" class="cv-form-input"
                           placeholder="e.g., Software Developer CV, Marketing Manager Resume"
                           value="My Professional CV">
                </div>

                <div class="cv-form-group">
                    <label for="cvProfession" class="cv-form-label">Profession (Optional)</label>
                    <select id="cvProfession" name="profession" class="cv-form-input">
                        <option value="">Select your profession...</option>
                        <option value="software-developer">Software Developer</option>
                        <option value="web-developer">Web Developer</option>
                        <option value="data-scientist">Data Scientist</option>
                        <option value="product-manager">Product Manager</option>
                        <option value="project-manager">Project Manager</option>
                        <option value="marketing-manager">Marketing Manager</option>
                        <option value="sales-manager">Sales Manager</option>
                        <option value="hr-manager">HR Manager</option>
                        <option value="accountant">Accountant</option>
                        <option value="teacher">Teacher</option>
                        <option value="nurse">Nurse</option>
                        <option value="engineer">Engineer</option>
                        <option value="designer">Designer</option>
                        <option value="consultant">Consultant</option>
                        <option value="analyst">Analyst</option>
                        <option value="other">Other</option>
                    </select>
                    <small style="color: rgba(255,255,255,0.7); font-size: 0.8rem; margin-top: 0.5rem; display: block;">
                        This helps us provide better default content for your CV sections.
                    </small>
                </div>

                <div class="cv-form-group">
                    <label class="cv-form-label">Choose Template</label>
                    <div class="cv-templates-grid">
                        <div class="cv-template-option selected" data-template="modern">
                            <div class="cv-template-preview" style="background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);">
                                <i class="bi bi-palette text-white"></i>
                            </div>
                            <div class="cv-template-name">Modern</div>
                            <div class="cv-template-desc">Clean design with colored accents</div>
                        </div>
                        <div class="cv-template-option" data-template="minimal">
                            <div class="cv-template-preview" style="background: linear-gradient(135deg, #374151 0%, #6B7280 100%);">
                                <i class="bi bi-square text-white"></i>
                            </div>
                            <div class="cv-template-name">Minimal</div>
                            <div class="cv-template-desc">Simple and elegant</div>
                        </div>
                        <div class="cv-template-option" data-template="ats">
                            <div class="cv-template-preview" style="background: linear-gradient(135deg, #059669 0%, #10B981 100%);">
                                <i class="bi bi-robot text-white"></i>
                            </div>
                            <div class="cv-template-name">ATS Friendly</div>
                            <div class="cv-template-desc">Optimized for resume scanners</div>
                        </div>
                        <div class="cv-template-option" data-template="professional">
                            <div class="cv-template-preview" style="background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);">
                                <i class="bi bi-briefcase text-white"></i>
                            </div>
                            <div class="cv-template-name">Professional</div>
                            <div class="cv-template-desc">Classic business style</div>
                        </div>
                    </div>
                </div>

                <div class="cv-form-actions">
                    <button type="button" class="cv-btn cv-btn-secondary" onclick="hideForms()">
                        <i class="bi bi-arrow-left"></i>
                        Back
                    </button>
                    <button type="submit" class="cv-btn cv-btn-primary">
                        <i class="bi bi-rocket-takeoff"></i>
                        Create CV
                    </button>
                </div>
            </form>
        </div>

        <!-- Scratch Form -->
        <div id="scratchForm" class="cv-create-form" style="display: none;">
            <div class="cv-form-header">
                <h2 class="cv-form-title">Start from Scratch</h2>
                <p class="cv-form-subtitle">Create a completely custom CV with your preferred sections</p>
            </div>

            <form method="POST" action="/cv">
                <input type="hidden" name="csrf_token" value="{{ csrf_token|default('') }}">

                <div class="cv-form-group">
                    <label for="scratchCvTitle" class="cv-form-label">CV Title</label>
                    <input id="scratchCvTitle" name="title" type="text" class="cv-form-input"
                           placeholder="Enter a title for your CV"
                           value="My Custom CV">
                </div>

                <div class="cv-form-actions">
                    <button type="button" class="cv-btn cv-btn-secondary" onclick="hideForms()">
                        <i class="bi bi-arrow-left"></i>
                        Back
                    </button>
                    <button type="submit" class="cv-btn cv-btn-primary">
                        <i class="bi bi-plus-circle"></i>
                        Create Blank CV
                    </button>
                </div>
            </form>
        </div>

        <!-- Quick Start Templates -->
        <div class="cv-quick-start">
            <h4>Quick Start Templates</h4>
            <div class="cv-quick-templates">
                <div class="cv-quick-template" onclick="quickStart('developer')">
                    <i class="bi bi-code-slash"></i>
                    <span>Developer</span>
                </div>
                <div class="cv-quick-template" onclick="quickStart('designer')">
                    <i class="bi bi-palette"></i>
                    <span>Designer</span>
                </div>
                <div class="cv-quick-template" onclick="quickStart('manager')">
                    <i class="bi bi-briefcase"></i>
                    <span>Manager</span>
                </div>
                <div class="cv-quick-template" onclick="quickStart('student')">
                    <i class="bi bi-mortarboard"></i>
                    <span>Student</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Enhanced CV Creation Functionality
document.addEventListener('DOMContentLoaded', function() {
    // Template selection
    const templateOptions = document.querySelectorAll('.cv-template-option');
    const selectedTemplateInput = document.getElementById('selectedTemplate');

    templateOptions.forEach(option => {
        option.addEventListener('click', function() {
            templateOptions.forEach(opt => opt.classList.remove('selected'));
            this.classList.add('selected');
            selectedTemplateInput.value = this.dataset.template;
        });
    });

    // Animate cards on load
    const optionCards = document.querySelectorAll('.cv-option-card');
    optionCards.forEach((card, index) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';

        setTimeout(() => {
            card.style.transition = 'all 0.6s ease';
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
        }, index * 200);
    });
});

function showTemplateSelection() {
    document.getElementById('templateForm').style.display = 'block';
    document.getElementById('scratchForm').style.display = 'none';
    document.querySelector('.cv-creation-options').style.display = 'none';

    // Animate form appearance
    const form = document.getElementById('templateForm');
    form.style.opacity = '0';
    form.style.transform = 'translateY(20px)';
    setTimeout(() => {
        form.style.transition = 'all 0.5s ease';
        form.style.opacity = '1';
        form.style.transform = 'translateY(0)';
    }, 100);
}

function showScratchForm() {
    document.getElementById('scratchForm').style.display = 'block';
    document.getElementById('templateForm').style.display = 'none';
    document.querySelector('.cv-creation-options').style.display = 'none';

    // Animate form appearance
    const form = document.getElementById('scratchForm');
    form.style.opacity = '0';
    form.style.transform = 'translateY(20px)';
    setTimeout(() => {
        form.style.transition = 'all 0.5s ease';
        form.style.opacity = '1';
        form.style.transform = 'translateY(0)';
    }, 100);
}

function hideForms() {
    document.getElementById('templateForm').style.display = 'none';
    document.getElementById('scratchForm').style.display = 'none';
    document.querySelector('.cv-creation-options').style.display = 'grid';

    // Animate options appearance
    const options = document.querySelector('.cv-creation-options');
    options.style.opacity = '0';
    setTimeout(() => {
        options.style.transition = 'all 0.5s ease';
        options.style.opacity = '1';
    }, 100);
}

function quickStart(type) {
    const templates = {
        'developer': 'modern',
        'designer': 'modern',
        'manager': 'professional',
        'student': 'minimal'
    };

    const titles = {
        'developer': 'Software Developer CV',
        'designer': 'UI/UX Designer CV',
        'manager': 'Project Manager CV',
        'student': 'Student CV'
    };

    // Set template and title
    document.getElementById('selectedTemplate').value = templates[type];
    document.getElementById('cvTitle').value = titles[type];

    // Select the template option
    document.querySelectorAll('.cv-template-option').forEach(opt => {
        opt.classList.remove('selected');
        if (opt.dataset.template === templates[type]) {
            opt.classList.add('selected');
        }
    });

    // Show template form
    showTemplateSelection();
}

// Form validation
document.addEventListener('submit', function(e) {
    if (e.target.matches('form[action="/cv"]')) {
        const titleInput = e.target.querySelector('input[name="title"]');
        if (!titleInput.value.trim()) {
            e.preventDefault();
            alert('Please enter a CV title');
            titleInput.focus();
            return false;
        }
    }
});
</script>
{% endblock %}


