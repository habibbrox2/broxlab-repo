{% for item in items %}
  {% include 'partials/content-card.twig' with {
    item: item,
    index: (start_index|default(1)) + loop.index0
  } %}
{% else %}
  <div class="feed-empty-state">
    <div class="empty-state-content" role="status" aria-label="No content available">
      <i class="bi bi-box-seam empty-icon" aria-hidden="true"></i>
      <p class="empty-text">{{ empty_text|default('No content available at the moment.') }}</p>
    </div>
  </div>
{% endfor %}

