{# Premium AI Assistant â€“ Brox AI Design Parity with Admin Copilot #}
{# IMPORTANT: Uses unique 'brox-ai-' prefix for all classes to avoid conflicts #}
{# IDs align with assistant.js (BroxAssistant class) #}

<div id="publicAssistantWrapper" class="bb-assistant-public">

    {# Floating Action Button - all base styles inline for maximum specificity #}
    <button id="publicAssistantBtn" class="brox-ai-trigger-fab" title="Chat with Assistant" aria-label="Open Chat"
      style="position: fixed !important;bottom: 80px !important;right: 20px !important;width: 48px !important;height: 48px !important;border-radius: 50% !important;background: linear-gradient(135deg, #0f172a, #1e293b) !important;color: #fff !important;border: 2px solid rgba(255,255,255,0.2) !important;box-shadow: 0 4px 12px rgba(15,23,42,0.4) !important;cursor: pointer !important;z-index: 999999 !important;display: flex !important;align-items: center !important;justify-content: center !important;font-size: 1.4rem !important;opacity: 1 !important;visibility: visible !important;pointer-events: auto !important;">
        <span class="brox-ai-fab-icon-open"><i class="bi bi-chat-dots-fill"></i></span>
        <span class="brox-ai-fab-icon-close d-none"><i class="bi bi-x-lg"></i></span>
    </button>

    {# Assistant Shell #}
    <div id="publicAssistantChat" class="brox-ai-copilot-sidebar brox-ai-hidden" role="dialog" aria-labelledby="publicAssistantTitle" aria-modal="true">

        {# Sidebar: Chat History #}
        <div id="publicAssistantSidebar" class="brox-ai-sidebar brox-ai-collapsed">
            <div class="brox-ai-sidebar-header">
                <span>Chat History</span>
                <button id="toggleAiSidebar" class="brox-ai-icon-btn-sm" aria-label="Toggle history">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </div>
            <div id="publicAssistantHistory" class="brox-ai-history-list"></div>
            <div class="brox-ai-history-empty">
                <i class="bi bi-inbox"></i>
                <p>No history yet</p>
            </div>
        </div>

        <div class="brox-ai-chat-main">
            <div class="brox-ai-header admin-theme">
                <div class="brox-ai-header-info">
                    <h3 class="brox-ai-header-title" id="publicAssistantTitle">
                        <i class="bi bi-robot"></i> Brox AI
                    </h3>
                    <div class="brox-ai-header-meta">
                        <span class="brox-ai-context-badge" id="publicAssistantModelName">
                            <i class="bi bi-award"></i> Claude 3 Haiku
                        </span>
                        <span id="publicAssistantModelStatusIndicator" class="brox-ai-status-indicator brox-ai-connecting" title="Model status"></span>
                        <span id="publicAssistantStatusIndicator" class="brox-ai-status-indicator brox-ai-online" title="Connection status"></span>
                        <span class="brox-ai-header-status" id="publicAssistantStatusText">Online</span>
                    </div>
                </div>
                <div class="brox-ai-header-actions">
                    <span class="brox-ai-lang-toggle" style="display:inline-flex;gap:0.25rem;">
                        <button id="publicAssistantLangBn" class="brox-ai-model-toggle" title="à¦¬à¦¾à¦‚à¦²à¦¾" aria-label="Switch to Bengali" style="font-size:0.75rem;font-weight:700;">à¦¬à¦¾à¦‚</button>
                        <button id="publicAssistantLangEn" class="brox-ai-model-toggle active" title="English" aria-label="Switch to English" style="font-size:0.75rem;font-weight:700;">EN</button>
                    </span>
                    <button id="publicAssistantModelToggle" class="brox-ai-icon-btn" title="Toggle Model Selector" aria-label="Toggle model selector">
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <button id="closePublicAssistant" class="brox-ai-icon-btn brox-ai-close-btn" title="Close Assistant" aria-label="Close assistant">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <div id="publicAssistantModelBar" class="brox-ai-model-bar brox-ai-collapsed">
                <div class="brox-ai-model-bar-content">
                    <label id="publicAssistantModelLabel" class="brox-ai-model-label">Select Model:</label>
                    <select id="publicAssistantProvider" class="brox-ai-model-select brox-ai-provider-select" aria-label="Select AI provider"></select>
                    <select id="publicAssistantModel" class="brox-ai-model-select" aria-label="Select AI model">
                        <option value="claude-3-haiku">Claude 3 Haiku</option>
                    </select>
                </div>
            </div>

            <div id="publicAssistantAgenticStatus" class="brox-ai-status-bar brox-ai-hidden">
                <span class="brox-ai-status-indicator brox-ai-thinking"></span>
                <span class="ai-status-detail"></span>
            </div>

            <div id="publicAssistantPreChat" class="brox-ai-body brox-ai-prechat">
                <div class="brox-ai-welcome">
                    <div class="brox-ai-welcome-icon">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <h4>How can I help you today?</h4>
                    <p>Start with a quick question or choose a shortcut below.</p>

                    <div class="brox-ai-step-name">
                        <div class="brox-ai-form-group">
                            <label id="introNameLabel" for="introName">Your Name</label>
                            <input type="text" id="introName" class="brox-ai-input" placeholder="Your name">
                        </div>
                        <div id="publicAssistantPreChatError" class="brox-ai-hidden" aria-live="polite"></div>
                        <button class="brox-ai-btn-primary" id="introNext1">Continue</button>
                    </div>

                    <div class="brox-ai-step-contact brox-ai-hidden">
                        <div class="brox-ai-form-group">
                            <label id="introEmailLabel" for="introEmail">Email (optional)</label>
                            <input type="email" id="introEmail" class="brox-ai-input" placeholder="Email (optional)">
                        </div>
                        <div class="brox-ai-form-group">
                            <label id="introMobileLabel" for="introMobile">Mobile (optional)</label>
                            <input type="text" id="introMobile" class="brox-ai-input" placeholder="Mobile (optional)">
                        </div>
                        <button class="brox-ai-btn-primary" id="introNext2">Continue</button>
                    </div>

                    <div class="brox-ai-step-topic brox-ai-hidden">
                        <div class="brox-ai-form-group">
                            <label id="introTopicLabel">What would you like to know about?</label>
                            <div class="brox-ai-topic-grid" id="introTopicOptions">
                                <label class="brox-ai-topic-chip">
                                    <input type="checkbox" value="general" checked>
                                    <span>General</span>
                                </label>
                                <label class="brox-ai-topic-chip">
                                    <input type="checkbox" value="support">
                                    <span>Support</span>
                                </label>
                                <label class="brox-ai-topic-chip">
                                    <input type="checkbox" value="billing">
                                    <span>Billing</span>
                                </label>
                                <label class="brox-ai-topic-chip">
                                    <input type="checkbox" value="feedback">
                                    <span>Feedback</span>
                                </label>
                            </div>
                        </div>
                        <button class="brox-ai-btn-primary" id="introStartChat">Start Chat</button>
                    </div>
                </div>
            </div>

            <div id="publicAssistantMessages" class="brox-ai-body custom-scrollbar brox-ai-scrollbar brox-ai-hidden" role="log" aria-live="polite">
                {# Messages injected here by assistant.js #}
            </div>

            {# Thinking indicator is rendered inline by assistant.js inside the message bubble - no separate DOM element needed #}

            <div id="publicAssistantSuggestionPanel" class="brox-ai-suggestion-panel brox-ai-hidden" role="listbox">
                <div class="brox-ai-suggestion-header">
                    <span>Suggestions</span>
                    <button class="brox-ai-suggestion-close" aria-label="Close suggestions">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
                <ul class="brox-ai-suggestion-list" id="publicAssistantSuggestions"></ul>
            </div>

            <div id="publicAssistantAttachmentPreview" class="brox-ai-attachment-preview brox-ai-hidden">
                <div class="brox-ai-attachment-info">
                    <i class="bi bi-paperclip"></i>
                    <div class="brox-ai-attachment-thumb" id="publicAssistantAttachmentThumb"></div>
                    <span class="brox-ai-attachment-name" id="publicAssistantFileName">file.pdf</span>
                    <span class="brox-ai-attachment-size" id="publicAssistantFileSize">0 KB</span>
                </div>
                <div class="brox-ai-attachment-progress brox-ai-hidden" id="publicAssistantAttachmentProgress">
                    <span class="brox-ai-attachment-progress-bar" id="publicAssistantAttachmentProgressBar"></span>
                </div>
                <button class="brox-ai-attachment-remove" id="publicAssistantRemoveAttachment" aria-label="Remove attachment">
                    <i class="bi bi-x"></i>
                </button>
            </div>

            <div id="publicAssistantQuickActions" class="brox-ai-quick-actions brox-ai-hidden" aria-label="Quick actions">
                <button type="button" class="brox-ai-action-chip" id="publicAssistantCollectData" title="Collect visible form fields">
                    <i class="bi bi-clipboard-data"></i> Collect
                </button>
                <button type="button" class="brox-ai-action-chip" id="publicAssistantAutoFill" title="Auto-fill form (uses URL in input if present)">
                    <i class="bi bi-magic"></i> Auto-fill
                </button>
                <button type="button" class="brox-ai-action-chip" id="publicAssistantQuickSummarize" title="Summarize current page">
                    <i class="bi bi-body-text"></i> Summarize
                </button>
                <button type="button" class="brox-ai-action-chip" id="publicAssistantClear" title="Clear chat history">
                    <i class="bi bi-trash3"></i> Clear
                </button>
            </div>

            <div id="publicAssistantFooter" class="brox-ai-footer brox-ai-hidden">
                <div class="brox-ai-input-wrapper">
                    <button id="publicAssistantAttach" class="brox-ai-action-btn brox-ai-action-btn-left" title="Attach file" aria-label="Attach file">
                        <i class="bi bi-paperclip"></i>
                    </button>
                    <div class="brox-ai-input-container">
                        <input type="text" id="publicAssistantInput" class="brox-ai-input" placeholder="Message Brox AI..." aria-label="Message input">
                    </div>
                    <button id="sendToPublicAssistant" class="brox-ai-send-btn" title="Send message" aria-label="Send">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
                <div class="brox-ai-input-hint">
                    <span><kbd>Enter</kbd> Send</span>
                    <span><kbd>Ctrl + Enter</kbd> Send (always)</span>
                    <span><kbd>Shift + Enter</kbd> New line</span>
                    <span><kbd>/</kbd> Commands</span>
                </div>
            </div>
        </div>

        <div id="publicAssistantGdpr" class="brox-ai-grok-modal brox-ai-hidden">
            <div class="brox-ai-grok-modal-content">
                <div class="brox-ai-grok-modal-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                </div>
                <h3>Privacy Notice</h3>
                <p id="gdprTextBn">à¦†à¦®à¦°à¦¾ à¦†à¦ªà¦¨à¦¾à¦° à¦¤à¦¥à§à¦¯ à¦¸à¦‚à¦—à§à¦°à¦¹ à¦•à¦°à¦¿ à¦¯à¦¾à¦¤à§‡ à¦†à¦ªà¦¨à¦¾à¦•à§‡ à¦­à¦¾à¦²à§‹à¦­à¦¾à¦¬à§‡ à¦¸à¦¾à¦¹à¦¾à¦¯à§à¦¯ à¦•à¦°à¦¤à§‡ à¦ªà¦¾à¦°à¦¿à¥¤</p>
                <p id="gdprTextEn" class="d-none">We collect your information to provide better assistance.</p>
                <div class="brox-ai-grok-consent-options">
                    <label class="brox-ai-grok-checkbox">
                        <input type="checkbox" id="gdprConsentData" checked>
                        <span>Data Collection</span>
                    </label>
                    <label class="brox-ai-grok-checkbox">
                        <input type="checkbox" id="gdprConsentAnalytics">
                        <span>Analytics</span>
                    </label>
                </div>
                <div class="brox-ai-grok-modal-actions">
                    <button class="brox-ai-grok-btn-secondary" id="gdprDecline">Later</button>
                    <button class="brox-ai-grok-btn-primary" id="gdprAccept">Accept</button>
                </div>
            </div>
        </div>

        <span id="publicAssistantStatusText" class="brox-ai-hidden">Online</span>
    </div>
</div>

