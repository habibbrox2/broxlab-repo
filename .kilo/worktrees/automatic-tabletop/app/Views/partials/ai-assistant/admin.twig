{# 
    BroxBhai AI Admin Copilot - Premium 2026 Redesign
    Features: CSRF refresh, input validation, file attachment, mobile responsive,
    typing indicators, auto-save feedback, enhanced history management
    
    IMPORTANT: Uses unique 'brox-ai-' prefix for all classes to avoid conflicts
    with other libraries/bundles
#}

{# Hidden file input for attachments #}
<input type="file" id="adminAiFileInput" class="brox-ai-input-file" accept="image/*,.pdf,.txt,.doc,.docx" multiple>

{# Main Copilot Sidebar #}
<div id="adminAiShell" class="brox-ai-copilot-sidebar brox-ai-hidden" role="dialog" aria-labelledby="adminAiTitle" aria-modal="true">

    {# Resizer handle for width #}
    <div class="admin-assistant-chat-resizer" data-resizer="width" aria-hidden="true"></div>

    {# Sidebar (Chat History with Tabs) #}
    <div id="adminAiSidebar" class="brox-ai-sidebar brox-ai-collapsed">
        <div class="brox-ai-sidebar-header">
            <div class="brox-ai-sidebar-header-content">
                <span>Copilot</span>
                <button id="adminAiSidebarClose" class="brox-ai-icon-btn-sm" aria-label="Close sidebar"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>

        {# Tabs Navigation #}
        <div class="brox-ai-tabs">
            <div class="brox-ai-tabs-nav">
                <button class="brox-ai-tabs-nav-item brox-ai-tabs-nav-item-active" data-tab="brox-ai-history-tab" aria-selected="true">
                    <i class="bi bi-clock-history"></i> History
                </button>
                <button class="brox-ai-tabs-nav-item" data-tab="brox-ai-settings-tab" aria-selected="false">
                    <i class="bi bi-gear"></i> Settings
                </button>
            </div>

            {# History Tab Panel #}
            <div class="brox-ai-tabs-content">
                <div id="brox-ai-history-tab" class="brox-ai-tabs-panel brox-ai-tabs-panel-active" role="tabpanel">
                    <div id="adminAiHistory" class="brox-ai-history-list"></div>
                    <div class="brox-ai-history-empty">
                        <i class="bi bi-inbox"></i>
                        <p>No history yet</p>
                    </div>
                </div>

                {# Settings Tab Panel #}
                <div id="brox-ai-settings-tab" class="brox-ai-tabs-panel" role="tabpanel">
                    <div class="brox-ai-settings-content">
                        <p class="brox-ai-settings-note">
                            Copilot manages provider, model, and tool orchestration automatically. Use these controls only when you want to adjust browsing, document parsing, or reasoning behavior.
                        </p>
                        <div class="brox-ai-setting-item">
                            <label class="brox-ai-setting-label">Dark Mode</label>
                            <button class="brox-ai-toggle-switch" id="adminAiDarkModeToggle" title="Toggle dark mode" data-feature="dark-mode">
                                <span class="brox-ai-toggle-slider"></span>
                            </button>
                        </div>
                        <div class="brox-ai-setting-item">
                            <label class="brox-ai-setting-label">Clear History</label>
                            <button id="adminAiClearHistory" class="brox-ai-btn-clear" title="Clear all history">
                                <i class="bi bi-trash3"></i> Clear
                            </button>
                        </div>
                        <div class="brox-ai-setting-item">
                            <label class="brox-ai-setting-label">Auto-Save</label>
                            <button class="brox-ai-toggle-switch" id="adminAiAutoSaveToggle" title="Toggle auto-save">
                                <span class="brox-ai-toggle-slider"></span>
                            </button>
                        </div>
                        <div class="brox-ai-setting-item">
                            <label class="brox-ai-setting-label">Web Plugin</label>
                            <div class="brox-ai-setting-inline">
                                <select id="adminAiWebMaxResults" class="brox-ai-setting-select" title="Web max results">
                                    <option value="1">1</option>
                                    <option value="2">2</option>
                                    <option value="3">3</option>
                                    <option value="5">5</option>
                                    <option value="10">10</option>
                                </select>
                                <button class="brox-ai-toggle-switch" id="adminAiWebPluginToggle" title="Enable web plugin">
                                    <span class="brox-ai-toggle-slider"></span>
                                </button>
                            </div>
                        </div>
                        <div class="brox-ai-setting-item">
                            <label class="brox-ai-setting-label">PDF Parser</label>
                            <div class="brox-ai-setting-inline">
                                <select id="adminAiPdfEngine" class="brox-ai-setting-select" title="PDF parser engine">
                                    <option value="pdf-text">pdf-text</option>
                                    <option value="mistral-ocr">mistral-ocr</option>
                                    <option value="native">native</option>
                                </select>
                                <button class="brox-ai-toggle-switch" id="adminAiPdfPluginToggle" title="Enable PDF parser plugin">
                                    <span class="brox-ai-toggle-slider"></span>
                                </button>
                            </div>
                        </div>
                        <div class="brox-ai-setting-item">
                            <label class="brox-ai-setting-label">Reasoning Effort</label>
                            <select id="adminAiReasoningEffort" class="brox-ai-setting-select" title="Model reasoning effort">
                                <option value="">Default</option>
                                <option value="none">none</option>
                                <option value="minimal">minimal</option>
                                <option value="low">low</option>
                                <option value="medium">medium</option>
                                <option value="high">high</option>
                                <option value="xhigh">xhigh</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="brox-ai-chat-main">
        {# Header: Context Aware with auto-save indicator #}
        <div class="brox-ai-header admin-theme">
            <div class="brox-ai-header-info">
                <h3 class="brox-ai-header-title" id="adminAiTitle">
                    <i class="bi bi-stars"></i> Copilot
                </h3>
                <div class="brox-ai-header-meta">
                    <span class="brox-ai-context-badge" id="adminAiContextBadge">
                        <i class="bi bi-folder2"></i> <span id="adminAiContextModule">Global</span>
                    </span>
                    <span class="brox-ai-save-indicator" id="adminAiSaveIndicator">
                        <i class="bi bi-check-circle-fill"></i> Saved
                    </span>
                    <div class="brox-ai-model-status" id="adminAiModelStatus">
                        <span class="brox-ai-status-indicator" id="adminAiModelStatusIndicator" title="Model status"></span>
                        <span class="brox-ai-model-name" id="adminAiCurrentModel">Loading...</span>
                    </div>
                    <div class="brox-ai-header-status" id="adminAiStatusText">Ready</div>
                </div>
            </div>
            <div class="brox-ai-header-actions">
                <button id="adminAiHistoryToggle" class="brox-ai-icon-btn" title="Chat history" aria-label="Chat history">
                    <i class="bi bi-clock-history"></i>
                </button>
                <button id="adminAiMinimize" class="brox-ai-icon-btn" title="Minimize" aria-label="Minimize">
                    <i class="bi bi-dash-lg"></i>
                </button>
                <button id="adminAiClose" class="brox-ai-icon-btn brox-ai-close-btn" title="Close Sidebar" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        {# Body: Chat Messages & Artifacts #}
        <div id="adminAiBody" class="brox-ai-body custom-scrollbar brox-ai-scrollbar" role="log" aria-live="polite">
            {# Welcome message #}
            <div class="brox-ai-welcome" id="adminAiWelcome">
                <div class="brox-ai-welcome-icon">
                    <i class="bi bi-stars"></i>
                </div>
                <h4>Welcome to Admin Copilot</h4>
                <p>Your AI assistant for administrative tasks. Type '/' in the input field or use one of these commands:</p>
                <div class="brox-ai-welcome-commands">
                    <button class="brox-ai-cmd-chip" data-cmd="/summarize">
                        <i class="bi bi-body-text"></i> /summarize
                    </button>
                    <button class="brox-ai-cmd-chip" data-cmd="/analyze-logs">
                        <i class="bi bi-journal-text"></i> /analyze-logs
                    </button>
                    <button class="brox-ai-cmd-chip" data-cmd="/list-tools">
                        <i class="bi bi-list-task"></i> /list-tools
                    </button>
                    <button class="brox-ai-cmd-chip" data-cmd="/help">
                        <i class="bi bi-question-circle"></i> /help
                    </button>
                </div>
            </div>

        {# Thinking Indicator #}
        <div class="thinking-indicator brox-ai-hidden" id="adminAiThinkingIndicator">
            <div class="thinking-content">
                <span class="thinking-text">Thinking...</span>
                <div class="thinking-dots">
                    <span class="thinking-dot"></span>
                    <span class="thinking-dot"></span>
                    <span class="thinking-dot"></span>
                </div>
            </div>
        </div>
    </div>

    {# Slash Command Menu #}
    <div id="adminAiSlashMenu" class="brox-ai-slash-menu brox-ai-hidden" role="menu">
        <div class="brox-ai-slash-header">
            <span>Commands</span>
            <button class="brox-ai-slash-close" aria-label="Close menu">
                <i class="bi bi-x"></i>
            </button>
        </div>
        <ul class="brox-ai-slash-list">
            <li class="brox-ai-slash-item" data-cmd="/summarize" role="menuitem">
                <div class="brox-ai-slash-icon"><i class="bi bi-body-text"></i></div>
                <div class="brox-ai-slash-info">
                    <strong>/summarize</strong>
                    <small>Summarize current page data</small>
                </div>
            </li>
            <li class="brox-ai-slash-item" data-cmd="/analyze-logs" role="menuitem">
                <div class="brox-ai-slash-icon"><i class="bi bi-journal-text"></i></div>
                <div class="brox-ai-slash-info">
                    <strong>/analyze-logs</strong>
                    <small>Analyze system error logs</small>
                </div>
            </li>
            <li class="brox-ai-slash-item" data-cmd="/clear-cache" role="menuitem">
                <div class="brox-ai-slash-icon"><i class="bi bi-trash"></i></div>
                <div class="brox-ai-slash-info">
                    <strong>/clear-cache</strong>
                    <small>Clear system cache</small>
                </div>
            </li>
            <li class="brox-ai-slash-item" data-cmd="/search-kb" role="menuitem">
                <div class="brox-ai-slash-icon"><i class="bi bi-book"></i></div>
                <div class="brox-ai-slash-info">
                    <strong>/search-kb</strong>
                    <small>Search knowledge base</small>
                </div>
            </li>
            <li class="brox-ai-slash-item" data-cmd="/web-search" role="menuitem">
                <div class="brox-ai-slash-icon"><i class="bi bi-globe"></i></div>
                <div class="brox-ai-slash-info">
                    <strong>/web-search</strong>
                    <small>Search the web</small>
                </div>
            </li>
            <li class="brox-ai-slash-item" data-cmd="/get-cache-stats" role="menuitem">
                <div class="brox-ai-slash-icon"><i class="bi bi-speedometer2"></i></div>
                <div class="brox-ai-slash-info">
                    <strong>/get-cache-stats</strong>
                    <small>View cache statistics</small>
                </div>
            </li>
            <li class="brox-ai-slash-item" data-cmd="/user-stats" role="menuitem">
                <div class="brox-ai-slash-icon"><i class="bi bi-people"></i></div>
                <div class="brox-ai-slash-info">
                    <strong>/user-stats</strong>
                    <small>View user statistics</small>
                </div>
            </li>
            <li class="brox-ai-slash-item" data-cmd="/content-stats" role="menuitem">
                <div class="brox-ai-slash-icon"><i class="bi bi-file-earmark-text"></i></div>
                <div class="brox-ai-slash-info">
                    <strong>/content-stats</strong>
                    <small>View content statistics</small>
                </div>
            </li>
            <li class="brox-ai-slash-item" data-cmd="/list-tools" role="menuitem">
                <div class="brox-ai-slash-icon"><i class="bi bi-list-task"></i></div>
                <div class="brox-ai-slash-info">
                    <strong>/list-tools</strong>
                    <small>Show available admin tools</small>
                </div>
            </li>
            <li class="brox-ai-slash-item" data-cmd="/help" role="menuitem">
                <div class="brox-ai-slash-icon"><i class="bi bi-question-circle"></i></div>
                <div class="brox-ai-slash-info">
                    <strong>/help</strong>
                    <small>Show the same tool list as /list-tools</small>
                </div>
            </li>
        </ul>
    </div>

    {# Auto Suggestion Panel #}
    <div id="adminAiSuggestionPanel" class="brox-ai-suggestion-panel brox-ai-hidden" role="listbox">
        <div class="brox-ai-suggestion-header">
            <span>Suggestions</span>
            <button class="brox-ai-suggestion-close" aria-label="Close suggestions">
                <i class="bi bi-x"></i>
            </button>
        </div>
        <ul class="brox-ai-suggestion-list" id="adminAiSuggestionList"></ul>
    </div>

    {# Attachment Preview #}
    <div class="brox-ai-attachment-preview brox-ai-hidden" id="adminAiAttachmentPreview">
        <div class="brox-ai-attachment-info">
            <i class="bi bi-paperclip"></i>
            <div class="brox-ai-attachment-thumb" id="adminAiAttachmentThumb"></div>
            <span class="brox-ai-attachment-name" id="adminAiFileName">file.pdf</span>
            <span class="brox-ai-attachment-size" id="adminAiFileSize">0 KB</span>
        </div>
        <div class="brox-ai-attachment-progress brox-ai-hidden" id="adminAiAttachmentProgress">
            <span class="brox-ai-attachment-progress-bar" id="adminAiAttachmentProgressBar"></span>
        </div>
        <button class="brox-ai-attachment-remove" id="adminAiRemoveAttachment" aria-label="Remove attachment">
            <i class="bi bi-x"></i>
        </button>
    </div>

    {# Quick Actions #}
    <div class="brox-ai-quick-actions" id="adminAiQuickActions" aria-label="Quick actions">
        <button type="button" class="brox-ai-action-chip" id="adminAiCollectData" title="Collect visible form fields">
            <i class="bi bi-clipboard-data"></i> Collect
        </button>
        <button type="button" class="brox-ai-action-chip" id="adminAiAutoFill" title="Auto-fill form (uses URL in input if present)">
            <i class="bi bi-magic"></i> Auto-fill
        </button>
        <button type="button" class="brox-ai-action-chip" id="adminAiQuickSummarize" title="Summarize current page">
            <i class="bi bi-body-text"></i> Summarize
        </button>
        <button type="button" class="brox-ai-action-chip" id="adminAiClear" title="Clear chat history">
            <i class="bi bi-trash3"></i> Clear
        </button>
    </div>

    {# Footer: Input #}
    <div id="adminAiFooter" class="brox-ai-footer">
        {# Input Area #}
        <div class="brox-ai-input-wrapper">
            <button id="adminAiAttach" class="brox-ai-action-btn brox-ai-action-btn-left" title="Attach file" aria-label="Attach file">
                <i class="bi bi-paperclip"></i>
            </button>
            <div class="brox-ai-input-container">
                <textarea 
                    id="adminAiInput" 
                    placeholder="Ask Copilot or type '/' for commands..." 
                    rows="1" 
                    class="form-control brox-ai-textarea"
                    aria-label="Message input"
                    maxlength="5000"
                ></textarea>
                <div class="brox-ai-char-count" id="adminAiCharCount">0/5000</div>
            </div>
            <button id="adminAiMic" class="brox-ai-action-btn brox-ai-mic-btn" title="Voice input" aria-label="Voice input">
                <i class="bi bi-mic-fill"></i>
            </button>
            <div class="brox-ai-input-actions">
                <button id="adminAiSend" class="brox-ai-send-btn" title="Send message" aria-label="Send">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        </div>
        
        {# Keyboard Shortcuts Hint #}
        <div class="brox-ai-input-hint">
            <span><kbd>Enter</kbd> Send</span>
            <span><kbd>Ctrl + Enter</kbd> Send (always)</span>
            <span><kbd>Shift + Enter</kbd> New line</span>
            <span><kbd>/</kbd> Commands</span>
        </div>
    </div>
  </div>
</div>

