{# AI Assistant Script Loading #}
{# Load Puter client from official CDN so we avoid importing @heyputer/puter.js source which pulls in unsupported CJS dependencies (e.g. @heyputer/kv.js) #}
<script src="https://js.puter.com/v2/"></script>
{% if assistant_variant == 'public' %}
<script type="module" src="{{ asset('/assets/ai-assistant/core/cache.js') }}"></script>
<script type="module" src="{{ asset('/assets/ai-assistant/core/cache-debug.js') }}"></script>
<script type="module" src="{{ asset('/ai/dist/assistant.js') }}"></script>
{% elseif assistant_variant == 'admin' %}
{# Legacy & Modern Integration Bridge - Load before legacy code #}
<script src="{{ asset('/assets/ai-assistant/integration/bridge.js') }}"></script>
{# Modern cache system #}
<script type="module" src="{{ asset('/assets/ai-assistant/core/cache.js') }}"></script>
<script type="module" src="{{ asset('/assets/ai-assistant/core/cache-debug.js') }}"></script>
{# Legacy admin code #}
<script type="module" src="{{ asset('/ai/dist/ai-admin.js') }}"></script>
{% endif %}

