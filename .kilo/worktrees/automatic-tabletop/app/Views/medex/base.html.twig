{% extends 'layout.twig' %}

{% block title %}
    {{ title|default('MedEx - Herbal Pharmaceuticals') }} - {{ app_settings.site_name }}
{% endblock %}

{% block extra_styles %}
<link rel="stylesheet" href="{{ asset('/assets/css/medex.css') }}">
<link rel="stylesheet" href="{{ asset('/assets/css/medex-theme.css') }}">
{% endblock %}

{% block content %}
<div class="container py-4">
    {# Page Header #}
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h2 mb-0">
                <i class="bi bi-capsule mr-2 text-primary"></i>
                {{ title|default('MedEx Database') }}
            </h1>
            <p class="text-muted mt-2 mb-0">
                Herbal Pharmaceutical Companies in Bangladesh
            </p>
        </div>
    </div>

    {# Content block #}
    {% block page_content %}{% endblock %}
</div>
{% endblock %}

