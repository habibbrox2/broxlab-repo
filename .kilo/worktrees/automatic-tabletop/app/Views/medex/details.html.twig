{% extends 'medex/base.html.twig' %}

{% block page_content %}
<div class="row mb-4">
    <div class="col-12">
        <div class="medex-card">
            <div class="medex-card-header">
                <i class="bi bi-info-circle"></i>
                MedEx Dataset Details
            </div>
            <div class="medex-card-body">
                <div class="row gy-3">
                    <div class="col-md-4">
                        <div class="medex-detail-summary">
                            <h5>Total Companies</h5>
                            <p class="display-6 mb-0">{{ total_companies|number_format }}</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="medex-detail-summary">
                            <h5>Total Brands</h5>
                            <p class="display-6 mb-0">{{ total_brands|number_format }}</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="medex-detail-summary">
                            <h5>Last Updated</h5>
                            <p class="mb-0">{{ last_updated ? last_updated|date('M d, Y H:i') : 'N/A' }}</p>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="row gy-3">
                    <div class="col-md-6">
                        <div class="medex-detail-box">
                            <h6>Cache File</h6>
                            <p class="mb-1"><strong>Path:</strong> <code>{{ cache_path }}</code></p>
                            <p class="mb-0"><strong>Age:</strong> {{ data_file_age|number_format }} seconds</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="medex-detail-box">
                            <h6>Refresh Lock</h6>
                            <p class="mb-1"><strong>Path:</strong> <code>{{ lock_path }}</code></p>
                            <p class="mb-0"><strong>Status:</strong>
                                {% if lock_exists %}
                                    <span class="text-success">Active</span>
                                {% else %}
                                    <span class="text-muted">Not present</span>
                                {% endif %}
                            </p>
                            {% if lock_exists %}
                                <p class="mb-0"><strong>Age:</strong> {{ lock_age|number_format }} seconds</p>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="alert alert-info">
                    <strong>Auto-clean behavior:</strong>
                    If a stale lock file is detected, MedEx refresh will remove it automatically and proceed.
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-center align-items-center">
                    <a href="/medex" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Companies
                    </a>
                    <button id="medex-refresh-button" type="button" class="btn btn-primary">
                        <i class="bi bi-arrow-clockwise"></i> Refresh Now
                    </button>
                    <div id="medex-refresh-feedback" class="text-muted small"></div>
                </div>
            </div>
        </div>
    </div>
</div>

{% block extra_scripts %}
<script>
    async function sendMedexRefreshRequest(button) {
        button.disabled = true;
        const originalText = button.innerHTML;
        button.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Refreshing...';

        const feedback = document.getElementById('medex-refresh-feedback');
        feedback.textContent = '';

        try {
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
            const body = new URLSearchParams({ csrf_token: csrfToken }).toString();

            const response = await fetch('/api/medex/refresh', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-CSRF-Token': csrfToken,
                },
                body,
            });

            const data = await response.json();
            if (!response.ok || !data.success) {
                throw new Error(data.error || 'Refresh failed');
            }

            feedback.textContent = 'Refresh completed successfully.';
            setTimeout(() => {
                feedback.textContent = '';
            }, 5000);
        } catch (error) {
            feedback.textContent = String(error.message || 'Refresh failed');
            console.error('MedEx refresh failed:', error);
        } finally {
            button.disabled = false;
            button.innerHTML = originalText;
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const refreshButton = document.getElementById('medex-refresh-button');
        if (refreshButton) {
            refreshButton.addEventListener('click', function () {
                sendMedexRefreshRequest(this);
            });
        }
    });
</script>
{% endblock %}

